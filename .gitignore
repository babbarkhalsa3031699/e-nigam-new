## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rms/
[Aa]rm64/
build/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
generated/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# NuGet Packages
*.nupkg
packages/
**/packages/*
!**/packages/build/

# Microsoft Azure Publish profiles and web publish settings
*.PublishSettings
*.pubxml
*.pubxml.user

# Temp and log files
*.log
*.tmp
*.bak
*.cache
*.temp
TempFile/
ExceptionDetailsFile/*.txt
backup/
backups/

# SVN version control files
.svn/

# Operating System files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# JetBrains Rider / Resharper / VSCode
.idea/
_ReSharper*/
*.resharper
*.dotCover
.vscode/
