    //////////////////////FileUploadSection//////////////////////
    function Initializefileupload() {

        $("#removeUpload").hide();

        $("#fileupload").click(function (event) {
            //$('#pdffile').text('No')
            //$('#pdffile1').text('No')
            //$('#IsPdf').val("N");

            $('#fileupload').fileupload({

                dataType: 'json',
				url: "/eFile/UploadFiles",
                async: true,
                autoUpload: true,
                done: function (e, data) {
                    //    var sim = setTimeout("hidevalue2()", 1000);

                    $('.file_name1').html(data.result.name);

                    $('.file_size1').html(data.result.size);

                }
            }).on('fileuploadprogressall', function (e, data) {

                var progress = parseInt(data.loaded / data.total * 100, 10);
                $('.progress1 .progress-bar').css('width', progress + '%');
                $('#removeUpload').css('display', 'block');
            });
        });
    }

    function removefileupload() {
        $('#pdffile').text('No')
        $('#pdffile1').text('No')
        $('#IsPdf').val("N");
        $('.file_name1').html('');
