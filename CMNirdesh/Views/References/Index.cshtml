	function GetActionView(SubMenuID, Cnt, MainMenuID) {
        //debugger;
		try {

			if (SubMenuID == "1320") {
				$("#thirdLinkMenu").html('References >> Diary');
                $("#diaryDashboard").hide();
			}
			if (SubMenuID == "1321") {
				$("#thirdLinkMenu").html('References >> Dispatch');
                $("#diaryDashboard").hide();
			}

			else if (SubMenuID == "1322") {
				$("#thirdLinkMenu").html('References >> Analytics');
                $("#diaryDashboard").hide();
			 }

			else if (SubMenuID == "1323") {
				$("#thirdLinkMenu").html('References >> Reports');
                $("#diaryDashboard").hide();
            }
            else if (SubMenuID == "1324") {
                $("#thirdLinkMenu").html('References >> Seach By Reference Id');
                $("#diaryDashboard").hide();
            }
            else if (SubMenuID == "1325") {
                $("#thirdLinkMenu").html('References >> Advance Search');
                $("#diaryDashboard").hide();
            }
            else if (SubMenuID == "1326") {
                $("#diaryDashboard").hide();
            }
            else if (SubMenuID == "1327") {
                $("#thirdLinkMenu").html('References >> Weekly Updations Diary');
                $("#diaryDashboard").hide();
            }
            else if (SubMenuID == "1328") {
                $("#thirdLinkMenu").html('References >> Weekly Updations Dispatch');
                $("#diaryDashboard").hide();
            }

			else {
				$("#thirdLinkMenu").html('References >> Dashboard');
			}

            GetDivData(SubMenuID, Cnt,MainMenuID);

			$('.widget-box').hide();
			$("#loader-wrapper").show();
		}

		catch (ex) {
			alert(ex.message);
        }
	}

        function GetDivData(SubMenuID, Cnt, MainMenuID) {
		try {
			$.ajaxSetup({ cache: false });
			var pathurl = '@Url.Action("GetDivData", "References")';
			$.ajax({
				url: pathurl,
				type: 'GET',
                async: true,
				success: function (data) {
					$("#MainDiv").html(data);
                    BindSubMenu(SubMenuID, Cnt, MainMenuID);
				}
			});
		}

		catch (ex) {
			alert(ex.message);
        }
	}

    function BindSubMenu(SubMenuID, Cnt, MainMenuID) {
            //$("#MainDiv").html("");

		try {
            $("#loader-wrapper").show();
			$.ajaxSetup({ cache: false });
			var pathurl = '@Url.Action("GetActionView", "References")';
			$.ajax({
				url: pathurl,
				type: 'GET',
                async: true,
				data: {
					SubMenuID: SubMenuID,
					AssemId: '0',
					SessId: '0',
					MainMenuID: MainMenuID,
					Count: Cnt
				},
				success: function (data) {
                    $("#loader-wrapper").hide();
					if (SubMenuID == "215") {
                        $("#MainDiv").html(data);
                        $("#loader-wrapper").hide();
					}
					else {
						$("#outerDiv").html("");
                        $("#outerDiv").html(data);
                        $("#loader-wrapper").hide();
					}
					ClearControls();
				}
			});
		}

		catch (ex) {
			alert(ex.message);
        }

	}

    function ClearControls() {
        $("#RightSidebar").html("");
    }

	function HideMessageDiv() {
		document.getElementById("SuccessDiv").style.color = "#3c763d"
		document.getElementById("SuccessDiv").style.display = "none"

	}

	function resizeClick(isLeft) {
		var parentWidth = $('#resize-left').parent().outerWidth();
		if (isLeft) { // click on left rezise button
			if ($('#resize-left').width() > (parentWidth * 0.52)) { resizeLeftPanel(50); }
			else { resizeLeftPanel(0); }
		} else {
			if ($('#resize-right').width() > (parentWidth * 0.52)) { resizeLeftPanel(50); }
			else { resizeLeftPanel(100); }
		}
	}

	function resizeLeftPanel(sizeRatio) {

		var parentWidth = $('#resize-left').parent().width();
		$('#resize-left').animate({ width: +(sizeRatio) + '%' }, 500);
		$('#resize-right').animate({ width: +(100 - sizeRatio) + '%' }, 500);
	}

	function openDilog() {
		var dlg = bootbox.alert("Update Successfully", function (e) {

			$(dlg).modal('hide');

		});

	}

