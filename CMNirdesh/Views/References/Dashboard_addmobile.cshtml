        function checkInAgendaD(idd) {
            var refid = idd.id;

            if ($(idd).prop("checked") == true) {
            var mainRefid = $('#ddlagenda').val();

            if (mainRefid == '') {
                alert("Please select Meeting File.");
                return false;
            }
            if (refid == '') {
                alert("Some Error Occured .");
                return false;

            }

            var formData = new FormData();
            formData.append("refid", refid);
            formData.append("mainRefid", mainRefid);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckInFile", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {
                        alert("Already Added")
                    }
                    if (response == "0") {
                        SendToAgendaD(refid)
                    }
                }
            });
        }
     }

