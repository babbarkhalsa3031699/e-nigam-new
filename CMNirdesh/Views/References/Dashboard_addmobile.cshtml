        /* General Styles */



        .zoom-in {
            animation: zoomIn 0.5s ease-in-out;
        }

        .zoom-out {
            animation: zoomOut 0.5s ease-in-out;
        }

        @@keyframes zoomIn {
            0% {
                transform: scale(0);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes zoomOut {
            0% {
                transform: scale(1);
            }

            100% {
                transform: scale(0);
            }
        }

        div.dataTables_scrollBody > table > tbody > tr > td {
            vertical-align: top !important;
        }

