                $("#dashtab").val('Reference');
                GetDataDashboardStatIndivisual();
            }
            var contentDivs = document.querySelectorAll('.content');
            contentDivs.forEach(function (div) {
                div.classList.add('hidden');
            });


            var tabs = document.querySelectorAll('.tab');
