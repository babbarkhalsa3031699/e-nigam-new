        function GetDiaryDasdhboardDataChangeDepartment(obj) {
            $("#DashBoardStatsDepartment").hide();
            $('#dData').remove();
            $('#dToggle').remove();
            $("#loader-wrapper").show();

            var deptId = $(obj).attr('deptid');
            var docid = $(obj).attr('DocTypeId');
            var officeid = $(obj).attr('officeid');
            var FromDeptId = $(obj).attr('FromDeptId');
            var id = $(obj).attr('Mainid');
                var Department = $(obj).attr('DeptName');
                var FileMenuType = '@Model.FileMenuType';
                var RefMenuType = '@Model.RefMenutype';
                var menuname = '@Model.RefMenuName';



                if (docid == "111") {
                    $("#meetingdiv").hide();
                } else {
                    $("#meetingdiv").show();
                }
            $.ajax({
                type: "GET",
                url: '@Url.Action("GetDataForDiaryDashboardListDepartment", "References")',
                datatype: "Json",
                contentType: "application/json; charset=utf-8",
                data: { deptid: deptId, FromDeptId: FromDeptId, officeid: officeid, documentype: docid, DepartmentName: Department, FileType: FileMenuType, RefType: RefMenuType, MenuName: menuname },
                success: function (response) {

                    if (response.length > 0) {
                        $("#showinner1").show();
                        $("#showinner1").html('');
                        $("#showinner1").html(response);
                        $('#DashBoardStatsDepartment').hide();
                        $("#loader-wrapper").hide();


                        //$('#innerDepartment').DataTable({

                         var table = $('#innerDepartment').DataTable({
                    paging: true,
                    pageLength: 50,
                    searching: true,
                    bInfo: true,
                    dom: 'Bfrtip',
                    buttons: [
                        'excel', 'pdf'
                    ],
                    aaSorting: [[0, 'desc']],
                    aoColumnDefs: [{ "bVisible": false, "aTargets": [1] }]
                });



                    }
                    else {
                        $("#noDataFoundD").css("display", "block");
                        $("#loader-wrapper").hide();
                        $("#Modeldasboardlist").css("display", "none");

                    }
                },
                error: function (error) {
                    alert('Occur');
                }
            });
        }



