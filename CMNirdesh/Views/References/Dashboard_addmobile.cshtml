            }

        .minifabIcon {
            height: 24px;
            width: 24px;
            margin-top: 12px;
        }



        .partfileicon {
            font-size: 30px;
        }



        .status-panel {
            position: fixed; /* To make it hoverable */
            right: 0; /* Stick to the right side */
            width: 100px; /* Adjust as needed */
            background-color: #f4f4f4; /* Neutral background */
            border-left: 2px solid #d5e9ff;
            border-top: 2px solid #000;
            border-bottom: 2px solid #d5e9ff;
            z-index: 999;
            margin-top: 10px;
            box-shadow: -2px 0 5px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease-in-out;

        }

        .status-item {
            padding: 10px;
            font-size: 14px;
            display: flex;
            height: 120px;
            font-size: 14px;
            color: black;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #000;
