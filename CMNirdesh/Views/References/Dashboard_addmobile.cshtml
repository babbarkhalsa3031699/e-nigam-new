        function populateFinancialYears(fyear) {
            var currentYear = new Date().getFullYear();
            var dropdown = $('#fYear');

            // Clear the dropdown before appending new options
            dropdown.empty();
            var option = $('<option>', {
                value: '',
                text: 'All'
            });
            dropdown.append(option);
            // Populate the dropdown with the last five years
            for (var i = 0; i < 5; i++) {
                var year = currentYear - i;
                var option = $('<option>', {
                    value: year,
                    text: year
                });

                // Ensure the correct year is selected
                if (year === parseInt(fyear) && fyear !== 0) {
                    option.prop('selected', true);  // Use .prop instead of .attr to set the selected option
                }

                dropdown.append(option);
            }
        }



   function GetDataStatDepartmentType(fyear = '') {
   $('#showOuterMemoData').html('');
   $('#showOuterMemoData').show();
   $('#showInnerMemoData').hide();
   $("#loader-wrapper").show();

   $.ajax({
       type: "GET",
       url: '@Url.Action("GetDataDashboardStatType", "References")', // Ensure this is rendered by Razor
       data: { financialYear: fyear },
       datatype: "json",
       contentType: "application/json; charset=utf-8",
       success: function (result) {
            if (result.length > 0) {
                $("#showOuterMemoData").html(result);
                $("#loader-wrapper").hide();

                // Initialize DataTable
                const dataTable = $('#MemoType').DataTable({
                    initComplete: function () {
                        const filterDiv = $(".dataTables_filter");
