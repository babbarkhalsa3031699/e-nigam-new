            width: 23px;
            height: 130px;
            background-image: linear-gradient(45deg, rgba(0,0,0,0.6), rgb(156,206,255));
            background-size: cover; /* Ensure the image covers the button */
            border: none;
            outline: none;
            writing-mode: vertical-lr; /* Rotate text vertically */
            text-orientation: upright; /* Ensure upright characters */
            transform-origin: center;
            text-align: center;
            padding: 5px;
            font-size: 12px;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
        }



            /* Button state when open */
