
@model  CMNirdesh.Models.LstDashboard

<input type="hidden" id="diarydispatchval" name="diarydispatchval" value="" />



<head>

    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />

    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jszip.min.js"></script>
    <script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
    <script src="~/Scripts/datatables/vfs-fonts.js"></script>
    <script src="~/Scripts/datatables/buttons.print.min.js"></script>
    <script src="~/Scripts/datatables/buttons.html5.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
    <script src="~/Scripts/jquery-3.4.1.js"></script>

    <script>

        $(document).ready(function () {

            $("#Diary").click(function () {
                var diarydispatchvalue = "diary";
                $("#diarydispatchval").val(diarydispatchvalue);
                $("#Dispatchlistdiv").html('');
                $("#Diarylistdiv").html('');
                $("#advanceparam").val('');
            });

            $("#Dispatch").click(function () {
                var diarydispatchvalue = "dispatch";
                $("#diarydispatchval").val(diarydispatchvalue);
                $("#Dispatchlistdiv").html('');
                $("#Diarylistdiv").html('');
                $("#advanceparam").val('');
            });
            $("#thirdLinkMenu").html('References >> Advance Search');

        });

        function GetSearchdata() {
            var diarydispatchvalue = $("#diarydispatchval").val();
            if (diarydispatchvalue == "diary") {
                GetDiaryAdvanceSearch();
            }
            else {
                GetDispatchAdvanceSearch();
            }
        }

        function clrtext() {
            $("#Dispatchlistdiv").html('');
            $("#advanceparam").val('');
            $("#Diarylistdiv").html('');

        }

        function GetDiaryAdvanceSearch() {
            $("#loader-wrapper").show();
            var advanceParam = $("#advanceparam").val();

            if (advanceParam == null || advanceParam == "" || advanceParam == undefined) {
                alert("Please Enter Any Text To Search");
                $("#loader-wrapper").hide();
                return false;
            }
            var pathurl = '/References/AdvancesearchForDiary'
            $.ajax({
                url: pathurl,
                type: 'GET',
                async: true,
                data: {
                    advanceparam: advanceParam
                },
                success: function (data) {
                    $("#loader-wrapper").hide();
                    $("#Diarylistdiv").html('');
                    $("#Dispatchlistdiv").html('');
                    $("#Diarylistdiv").html(data);
                }
            });

        }

        function GetDispatchAdvanceSearch() {
            $("#loader-wrapper").show();
            var advanceParam = $("#advanceparam").val();

            if (advanceParam == null || advanceParam == "" || advanceParam == undefined) {
                alert("Please Enter Any Text To Search");
                $("#loader-wrapper").hide();
                return false;
            }

            var pathurl = '/References/AdvancesearchForDispatch'
            $.ajax({
                url: pathurl,
                type: 'GET',
                async: true,
                data: {
                    advanceparam: advanceParam
                },
                success: function (data) {
                    $("#loader-wrapper").hide();
                    $("#Dispatchlistdiv").html('');
                    $("#Diarylistdiv").html('');
                    $("#Dispatchlistdiv").html(data);
                }
            });
        }

    </script>

</head>


<style>

    .cus-search-div {
        background: white;
        padding: 20px 15px;
        border: 1px solid #e5e5e5;
        box-shadow: 0px 2px 4px 1px #b5b5b5;
        margin-top: 60px;
    }
</style>

<body>
    <div class="c_box">
        <h3 class="h3">Search by Text</h3>
        <div class="sraech_form_box">
            <div class="row">
                <div class="col-md-12 col-lg-12">
                    <input type="radio" id="Diary" value="Diary" name="group" checked="checked"> <span>Diary</span>
                    <input type="radio" id="Dispatch" value="Dispatch" name="group"> <span>Dispatch</span>
                </div>
                <div class="col-md-12 col-lg-12 mt-2">
                    <div class="srch_txt">
                        <input id="advanceparam" name="advanceparam" placeholder="Enter Text For Search" type="text" class="form-control txt_value">
                    </div>
                </div>
            </div>
            <button class="btn srch_btn" type="submit" onclick="GetSearchdata()">Search </button>
            <button class="btn clr_btn" id="clr" onclick="clrtext()" type="button">Clear</button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 col-md-12" style=" margin-top:20px;">
            <div id="Diarylistdiv" class=""></div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12 col-md-12" style=" margin-top:20px;">
            <div id="Dispatchlistdiv" class=""></div>
        </div>
    </div>
</body>

