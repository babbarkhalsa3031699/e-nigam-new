                            var html = $('#lnkSubjectDetails').val();
                            tinymce.activeEditor.setContent(html);
                            $('#TxtLetterNo').val($('#lnkTxtLetterNo').val());

                            var isletter = $('#lnkisLetter').val();
                            if (isletter = 'Letter') {
                               // $("#lettertype").is(":checked")
                               // $(document.getElementById("lettertype").checked == true)
                               $('#lettertype').prop('checked', true);
                            }
                            else {
                                $('#filetype').prop('checked', true);
                            }

                            if ($('#lnkApplicantName').val() != "") {
                                $('#TxtApplicantName').val($('#lnkApplicantName').val());
                                $('#chkApplicant').prop('checked', true);
                                $("#divApplicantDetails").show();
                            }
                            if ($('#lnkApplicantAddress').val() != "") {
                                $('#TxtApplicantAddress').val($('#lnkApplicantAddress').val());
                                $('#chkApplicant').prop('checked', true);
