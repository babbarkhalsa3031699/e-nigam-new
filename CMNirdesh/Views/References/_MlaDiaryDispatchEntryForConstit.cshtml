        var filenum = $("#ToDept").find(':selected').attr('data-num');
        var depsec = $("#ToDept").find(':selected').attr('data-sec');
        var name = $("#TxtApplicantName").val();

        var body = tinyMCE.activeEditor.getContent();

            body = body.replace("$$Secretary$$", depsec);
            body = body.replace("$$ecretary$$", depsec);
            body = body.replace("$$Department$$", deppbi);
            body = body.replace("$$Department$$", deppbi);
            body = body.replace("FileNo", filenum);
            body = body.replace("FileNo", filenum);

        if (name != "") {
            body = body.replace("$$Name_and_Address$$", name);
        }

        body = body.replace("$$Date$$", filedate);
        tinyMCE.get('SubjectDetails').setContent(body);

    }





