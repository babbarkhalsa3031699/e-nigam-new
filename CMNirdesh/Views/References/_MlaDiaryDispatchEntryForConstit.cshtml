    function SearchRefNo(isShow) {
        $('#linkModalRefbody').html('');
        var RefId = $('#txtRefSerach').val();
        if (RefId == 0 || RefId == "") {
            alert("Please enter referenceId first")
        }
        else {
           // var pathurl = '/References/SearchRefLink';
            $.ajax({
                type: "GET",
               url: '@Url.Action("SearchRefLink", "References")',
                data: { RefId: RefId },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {
                    $("#loader-wrapper").hide();

                    if (data) {
                        $('#LinkRefID').val(RefId);
                        if (isShow == "1") {
                            $("#linkModalRef").css("display", "block");
                            $('#linkModalRefbody').html(data);

