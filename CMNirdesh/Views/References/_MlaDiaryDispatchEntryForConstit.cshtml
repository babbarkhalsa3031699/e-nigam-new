        tinyMCE.init({
            selector: "#SubjectDetails",
            branding: false,
            content_style: "body { font-size: 14pt; font-family: inherit; }",
            plugins: 'table',
            
            toolbar: 'undo redo | bold italic fontfamily fontsize | alignleft aligncenter alignright alignjustify | table tabledelete | tableprops tablerowprops tablecellprops | tableinsertrowbefore tableinsertrowafter tabledeleterow | tableinsertcolbefore tableinsertcolafter',
            table_default_styles: {
                width: '50%'
            },
            formats: {
                alignleft: { selector: 'table', classes: 'left' },
                //bold: { inline: 'table', styles: { 'margin-left': '0px !important' } }
            },

            setup: function (editor) {
                const storageKey = editor.id + "_draft"; // unique per editor
                //alert(storageKey);

                // 🔹 Block disallowed fonts
                editor.on('BeforeSetContent', function (e) {
                    e.content = e.content.replace(/font-family:\s*([^;]*);/g, function (match, fontFamily) {
                        if (fontFamily.toLowerCase() === 'asees' || fontFamily.toLowerCase() === 'joy') {
                            //alert("Content contains Asees or Joy Font. Please use only Raavi Unicode Font.");
                            return ''; // Remove this font-family
                        }
                        return match;
                    });
                });

                // Auto  Save content to localStorage whenever changed
                editor.on('change keyup paste', function () {
                    localStorage.setItem(storageKey, editor.getContent());
                });

                // Auto save Restore draft (if available) OR fallback to SDPreText
                editor.on('init', function () {
                    let savedDraft = localStorage.getItem(storageKey);
                    if (savedDraft && savedDraft.trim() !== "") {
                        editor.setContent(savedDraft);
                    } else {
                        editor.setContent(SDPreText || ""); // fallback initial value
                    }
                });


            }
        });




