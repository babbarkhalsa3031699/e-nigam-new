    function changeAssembly() {
        $('#Session').empty();
        $('#Date').empty();
        var assmblycode = $('#Assembly :selected').val();



        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetSessionByAssemblyId", "References")',
            dataType: 'json',
            data: { AssemblyCode: assmblycode },
            success: function (data) {
                var items = '';
                $.each(data, function (i, item) {
                    var rows = "<option value='" + item.SessionCode + "'>" + item.SessionName + "</option>";
                    $('#Session').append(rows);
                });
            },
            error: function (ex) {

            }
        });
        return false;
    }
