    function AddToFile(pdfname, path, size, pdfuniquename, i) {
        var isPdf = (pdfname || '').toLowerCase().indexOf('.pdf') > -1;
        var iconClass = isPdf ? 'fa fa-file-pdf-o' : 'fa fa-file-text-o';
        var iconStyle = isPdf ? 'background: #fee2e2; color: #dc2626; border: 1px solid #fecaca;' : 'background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe;';

        var FileString = "<div id='afile_" + i + "' class='annexure-file-chip'>" +
            "<div class='file-chip-icon' style='" + iconStyle + "'><i class='" + iconClass + "'></i></div>" +
            "<div class='file-chip-info'>" +
                "<a href='" + path + "' id='afileUrl_" + i + "' target='_blank' class='file-chip-name' title='" + pdfname + "'>" +
                    "<span id='afileName_" + i + "' class='file_nameEn'>" + pdfname + "</span>" +
                "</a>" +
                "<span id='afileSize_" + i + "' class='file-chip-size file_sizeEn'>" + size + "</span>" +
            "</div>" +
            "<button type='button' id='afileRemove_" + i + "' class='file-chip-remove removeUploadEnclosure' onclick='removefileupload(" + i + ")' title='Remove file'>" +
                "<i class='fa fa-times'></i>" +
            "</button>" +
