                "body { width: 100% !important; max-width: 794px !important; min-height: 1123px !important; margin: 24px auto !important; padding: 25mm 20mm !important; box-sizing: border-box !important; background-color: #ffffff !important; border: 1px solid #cbd5e1 !important; border-radius: 2px !important; box-shadow: 0 4px 18px rgba(15, 23, 42, 0.08), 0 1px 3px rgba(15, 23, 42, 0.04) !important; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Raavi, Arial, sans-serif !important; font-size: 13pt !important; line-height: 1.6 !important; color: #1e293b !important; text-align: justify !important; }" +
                "p { margin-top: 0 !important; margin-bottom: 12px !important; text-align: inherit; line-height: 1.6 !important; }" +
                "h1, h2, h3, h4, h5, h6 { color: #0f172a !important; font-weight: 700 !important; margin-top: 18px !important; margin-bottom: 8px !important; line-height: 1.3 !important; }" +
                "table { width: 100% !important; max-width: 100% !important; table-layout: fixed !important; border-collapse: collapse !important; margin: 14px 0 !important; background-color: #ffffff !important; box-sizing: border-box !important; }" +
                "table, th, td { border: 1px solid #94a3b8 !important; }" +
                "th, td { padding: 8px 10px !important; word-break: break-word !important; overflow-wrap: anywhere !important; white-space: normal !important; vertical-align: top !important; font-size: 12pt !important; line-height: 1.45 !important; box-sizing: border-box !important; }" +
                "th { background-color: #f8fafc !important; font-weight: 600 !important; color: #0f172a !important; text-align: left !important; }" +
                "ul, ol { margin: 8px 0 14px 24px !important; padding: 0 !important; }" +
                "li { margin-bottom: 4px !important; line-height: 1.55 !important; }" +
                "blockquote { border-left: 3px solid #3b82f6 !important; margin: 12px 0 !important; padding: 6px 16px !important; background: #f8fafc !important; color: #475569 !important; }" +
                "@@media print { html { background-color: #ffffff !important; } body { width: 100% !important; max-width: 100% !important; margin: 0 !important; padding: 0 !important; border: none !important; box-shadow: none !important; min-height: auto !important; } }",

            setup: function (editor) {
                const storageKey = editor.id + "_draft"; // unique per editor

                // 🔹 Clean pasted HTML string before insertion
                editor.on('PastePreProcess', function (e) {
                    if (e.content) {
                        e.content = e.content.replace(/<!--\[if[\s\S]*?<!\[endif\]-->/gi, '');
                        e.content = e.content.replace(/<style[\s\S]*?<\/style>/gi, '');
                        e.content = e.content.replace(/mso-[\w\-]+:[^;"]+;?/gi, '');
                        e.content = e.content.replace(/font-family:\s*([^;]*);/gi, function (match, fontFamily) {
                            if (fontFamily.toLowerCase().indexOf('asees') !== -1 || fontFamily.toLowerCase().indexOf('joy') !== -1) {
                                return '';
                            }
                            return match;
                        });
                    }
                });

                // 🔹 Clean pasted DOM elements (DOM-level table & text alignment to A4 page)
                editor.on('PastePostProcess', function (e) {
                    if (e.node) {
                        sanitizeA4ContentNode(e.node);
                    }
                });

                // 🔹 Block disallowed fonts on programmatic content set
                editor.on('BeforeSetContent', function (e) {
                    if (e.content) {
                        e.content = e.content.replace(/<!--\[if[\s\S]*?<!\[endif\]-->/gi, '');
                        e.content = e.content.replace(/font-family:\s*([^;]*);/g, function (match, fontFamily) {
                            if (fontFamily.toLowerCase().indexOf('asees') !== -1 || fontFamily.toLowerCase().indexOf('joy') !== -1) {
                                return '';
                            }
                            return match;
                        });
                    }
                });

                // 🔹 When content is set or draft restored, ensure all tables & text fit A4 page
                editor.on('SetContent', function (e) {
                    try {
                        var doc = editor.getDoc();
                        if (doc && doc.body) {
                            sanitizeA4ContentNode(doc.body);
                        }
                    } catch (err) { }
                });

                // Auto Save content to localStorage whenever changed
                editor.on('change keyup paste', function () {
                    localStorage.setItem(storageKey, editor.getContent());
                });

                // Auto save Restore draft (if available) OR fallback to SDPreText
                editor.on('init', function () {
                    let savedDraft = localStorage.getItem(storageKey);
                    if (savedDraft && savedDraft.trim() !== "") {
                        editor.setContent(savedDraft);
                    } else {
                        editor.setContent(SDPreText || ""); // fallback initial value
                    }
                });
            }
        });

