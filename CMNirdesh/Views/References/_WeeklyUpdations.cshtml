        function DiaryRefWise() {
            try {
                $("#Diarylistdiv").html('');
                $("#loader-wrapper").show();
                $("#tbodyDiaryWeekly").html('');
                var pathurl = '/References/DiaryRefWise';
                $.ajax({
                    url: pathurl,
                    type: 'GET',
                    async: true,
                    data: { status: 0 },
                    success: function (result) {
                        var html = "";

                        if (result.length > 0) {
                            html = html + "<tr><td class='center'>" + result[0].Text + "</td>";
                            html = html + "<td class='center'>" + result[1].Text + "</td>";
                            html = html + "<td class='center'>" + result[2].Text + "</td>";
