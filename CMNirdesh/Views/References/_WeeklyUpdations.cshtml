        function GetDiaryDataByDate(obj) {
            $("#loader-wrapper").show();
            $("#Diarylistdiv").html('');
            var Agency = 0;
            var DiaryDate = $(obj).attr('diaryDate');
            var pathurl = '/References/GetDiaryDataByDate'
            $.ajax({
                url: pathurl,
                type: 'GET',
                async: true,
                data: { DiaryDate: DiaryDate },
                success: function (data) {
                    $("#loader-wrapper").hide();
                    $("#Diarylistdiv").html('');
                    $("#Diarylistdiv").show();
                    $("#Diarylistdiv").html(data);
                    $("#DiaryTableDiv").css("display", "none");
