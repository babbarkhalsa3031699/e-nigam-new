        var count = 0;
        function PreviousSevenDays() {
            if (count >= 1) {
                count = count - 1;
                $("#intval").val(count);
            }
            NextPreviuosWeekData(count);

        }

        function NextSevenDays() {
            count = count + 1;
            $("#intval").val(count);
            NextPreviuosWeekData(count);
        }

        function NextPreviuosWeekData(count)
        {
            var diarydispatchValue = $("#diarydispatchValueW").val();
            if (diarydispatchValue == "Act") {
                DiaryRefActionWiseArrow(count);
            }
            else {
                DiaryRefWiseArrow(count);
            }
        }

        function EditMlaDairy(IDD) {
            var ID = IDD.id;
            $('#loginModaldiarybody').html('');
            $('#loginModalBody').html('');
            $('#loginModalDispatchbody').html('');
            var pathurl = '/References/EditMlaDairyForm';
            $.ajax({
                type: "GET",
                url: pathurl,
                async: true,
                data: { ID: ID },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {
                    // //debugger;
                    var options = {
                        "backdrop": "static",
                        keyboard: true
                    };
                    $("#loader-wrapper").hide();

                    if (data) {
                        $("#loginModaldiary").css("display", "block");
                        $('#loginModaldiarybody').html(data);


                    } else { alert("error"); }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();

                }
            });
