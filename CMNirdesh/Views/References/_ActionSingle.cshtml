    function updatesubject() {

        var refid = @Model.RefId;
        var subject = $("#subjectforedit_"+refid).val();
        var subjectold = $("#subjectold_" + refid).val();
        if (subject == "") {
            alert("Kindly fill the subject first");
            return false;
        }
        var formData = new FormData();
        formData.append("refid", refid);
        formData.append("subject", subject);
        formData.append("subjectold", subjectold);
            $.ajax({
                type: "POST",
                url: '@Url.Action("updatesubject", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {

                        $("#Subject").val(subject);
                        $("#SpanSubject_"+refid).html(subject);
                       // alert("Subject Updated Succesfully");
                    }
                    if (response == "0") {
                        alert("Subject Updation Failed.");
                    }
                }
            });

    }


