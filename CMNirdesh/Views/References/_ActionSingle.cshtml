    function updatesubject() {

        var refid = @Model.RefId;
        var subject = $("#subjectforedit_"+refid).val();
        var subjectold = $("#subjectold_" + refid).val();
        if (subject == "") {
            alert("Kindly fill the subject first");
            return false;
        }
        var formData = new FormData();
        formData.append("refid", refid);
        formData.append("subject", subject);
        formData.append("subjectold", subjectold);
            $.ajax({
                type: "POST",
                url: '@Url.Action("updatesubject", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {

                        $("#Subject").val(subject);
                        $("#SpanSubject_"+refid).html(subject);
                       // alert("Subject Updated Succesfully");
                    }
                    if (response == "0") {
                        alert("Subject Updation Failed.");
                    }
                }
            });

    }


    function updatesubjectdetail() {

        var refid = @Model.RefId;

        var subjectdetail = tinymce.get('subjectdetailforedit_'+refid).getContent();
        var subject = $("#subjectforedit_" + refid).val();
        if (subjectdetail == "" || subjectdetail == null) {
            alert("Kindly fill the subject detail first");
            return false;
        }
        var formData = new FormData();
        formData.append("refid", refid);
        //formData.append("subject", subject);
        formData.append("subjectdetail", subjectdetail);
            $.ajax({
                type: "POST",
                url: '@Url.Action("updatesubjectdetails", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {
                       // alert("Details Updated Succesfully");
                        //$("#SubjectDetails").val(subjectdetail);
                        $("#divSubjectDetails_"+refid).html(subjectdetail);

                    }
                    if (response == "0") {
                        alert("Details Updation Failed.");
                    }
                }
            });

    }

      function UpdateOffice() {
      var refid = @Model.RefId;
       var officeId = $('#ddlOfficeChange').val();

      if (officeId == null || officeId == "" || officeId == undefined) {
          alert("Please select Office.");
          return false;
      }
      if (refid == null || refid == "" || refid == undefined) {
          alert("Some Error Occured Try Again");
          return false;
      }

      var formData = new FormData();
      formData.append("refid", refid);
      formData.append("ToOfficeId", officeId);
