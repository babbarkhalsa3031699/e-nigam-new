        function getsubjectandsubjectDetails() {
            var refid = @Model.RefId;



            $.ajax({
                type: "GET",
                url: '@Url.Action("getsubjectandsubjectDetails", "References")',
                datatype: "Json",
                contentType: "application/json; charset=utf-8",
                data: {refid:refid},
                success: function (response) {
                    if (response != null) {
                        $("#subjectforedit_"+refid).val(response[0].subject);
                         $("#subjectold_"+refid).val(response[0].subject);
                        $("#subjectdetailforedit_"+refid).val(response[0].SubjectDetails);
                        $("#subjectdetailold_"+refid).val(response[0].SubjectDetails);
                        tinymce.get('subjectdetailforedit_'+refid).setContent(response[0].SubjectDetails);
                    }
                    else {
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (error) {
                }
            });
    }

