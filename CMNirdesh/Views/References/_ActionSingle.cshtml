    function initPanelSplitter() {
        var $divider = $("#panelDivider");
        var $container = $("#panelContainer");
        var $panelOne = $(".panel.one");
        var $panelTwo = $(".panel.two");

        $panelOne.add($panelTwo).css({ "display": "", "height": "", "flex": "" });
        $divider.off("mousedown.panelSplitter touchstart.panelSplitter mousedown touchstart");
        $container.off("mousemove touchmove");

        $divider.on("mousedown.panelSplitter touchstart.panelSplitter", function (e) {
            if ($(e.target).closest(".sliderLeft, .sliderRight").length > 0) {
                return;
            }

            e.preventDefault();
            var isDragging = true;

            $container.addClass("is-resizing");
            $divider.addClass("is-resizing");
            $("iframe").css("pointer-events", "none");
            $("body").css({ "user-select": "none", "cursor": "col-resize" });

            var containerOffset = $container.offset().left;
            var containerWidth = $container.width();

            function onMove(evt) {
                if (!isDragging) return;

                var clientX = evt.pageX;
                if (typeof clientX === "undefined" && evt.originalEvent && evt.originalEvent.touches && evt.originalEvent.touches.length > 0) {
                    clientX = evt.originalEvent.touches[0].pageX;
                }
                if (typeof clientX === "undefined" || isNaN(clientX)) return;

                var relativeX = clientX - containerOffset;
                var pct = (relativeX / containerWidth) * 100;

                var minLeftPct = Math.max(18, (250 / containerWidth) * 100);
                var maxLeftPct = Math.min(80, ((containerWidth - 280) / containerWidth) * 100);

                if (pct < minLeftPct) pct = minLeftPct;
                if (pct > maxLeftPct) pct = maxLeftPct;

                $panelOne.css({
                    "width": pct + "%",
                    "flex-basis": pct + "%",
                    "display": "",
                    "height": "",
                    "flex": ""
                });
                $panelTwo.css({
                    "width": (100 - pct) + "%",
                    "flex-basis": (100 - pct) + "%",
                    "display": "",
                    "height": "",
                    "flex": ""
                });

                lastPanelOneWidth = pct;
                $("#PannelId").val(2);
            }

            function onEnd() {
                if (!isDragging) return;
                isDragging = false;

                $container.removeClass("is-resizing");
                $divider.removeClass("is-resizing");
                $("iframe").css("pointer-events", "");
                $("body").css({ "user-select": "", "cursor": "" });

                $(document).off("mousemove.panelSplitter touchmove.panelSplitter", onMove);
                $(document).off("mouseup.panelSplitter touchend.panelSplitter", onEnd);
            }

            $(document).on("mousemove.panelSplitter touchmove.panelSplitter", onMove);
            $(document).on("mouseup.panelSplitter touchend.panelSplitter", onEnd);
        });
    }

