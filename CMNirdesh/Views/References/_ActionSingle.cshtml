    function printActionAndReferenceDetails() {
        try {
            var $actionsClone = $('#divDetails, #view_' + ('@Model.RefId') + ' #divDetails').first().clone();
            if ($actionsClone.length === 0 || $actionsClone.find('li').length === 0) {
                $actionsClone = $('#ulnoting').clone();
            }
            $actionsClone.find('button, input, select, .fa-unlock, .fa-lock, .fa-pencil, .ace-icon, script').remove();
            $actionsClone.find('a[href*="BlobStorage"], a#actionlink').each(function () {
                var href = $(this).attr('href');
                var filename = href ? href.split('/').pop() : 'Attachment';
                $(this).replaceWith('<span class="note-enclosure"><strong>Enclosure:</strong> ' + filename + '</span>');
            });
            var notesHtml = '';
            if ($actionsClone.length > 0 && $actionsClone.find('li').length > 0) {
                notesHtml = $actionsClone.html();
            } else {
                notesHtml = '<div style="color: #64748b; font-style: italic; padding: 6px 0;">No actions taken recorded.</div>';
            }

            var subjectContent = ($('#SpanSubject_' + '@Model.RefId').text() || $('#SpanSubject').text() || '').trim();
            if (!subjectContent) {
                subjectContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Subject ?? Model.SubjectPB ?? ""))'.trim();
            }
            if (!subjectContent) {
                subjectContent = ($('#subjectforedit_' + '@Model.RefId').val() || $('#subjectforedit').val() || '').trim();
            }
            if (!subjectContent) {
                subjectContent = '<span style="color:#64748b; font-style:italic;">No subject specified</span>';
            }

            var detailsContent = ($('#divSubjectDetails_' + '@Model.RefId').html() || $('#divSubjectDetails').html() || '').trim();
            if (!detailsContent) {
                detailsContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.SubjectDetails ?? Model.SubjectDetailsPB ?? ""))'.trim();
            }
            if (!detailsContent) {
                detailsContent = '<span style="color:#64748b; font-style:italic;">No details recorded</span>';
            }

            var instructionContent = '';
            var ddlActVal = ($('#ddlact option:selected').text() || '').trim();
            if (ddlActVal && ddlActVal !== 'Select' && ddlActVal !== '--Select--') {
                instructionContent = ddlActVal;
            }
            if (!instructionContent) {
                instructionContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ActName ?? ""))'.trim();
            }

            var headerSub = 'ID: #' + ('@Model.RefId' || '');
            var fromOfficeDisplay = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.FromDept ?? ""))'.trim();
            if (!fromOfficeDisplay) {
                fromOfficeDisplay = ($('#divMember .txt_value').first().text() || '').trim();
            }

            var now = new Date();
            var day = String(now.getDate()).padStart(2, '0');
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var year = now.getFullYear();
            var hours = now.getHours();
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            var strHours = String(hours).padStart(2, '0');
            var genDateStr = day + '-' + month + '-' + year + ' ' + strHours + ':' + minutes + ' ' + ampm;

            var printDoc = `
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="utf-8" />
                    <title>${headerSub}</title>
                    <style>
                        @@page { size: A4 portrait; margin: 10mm 12mm 10mm 12mm; }
                        * { box-sizing: border-box !important; }
                        body {
                            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
                            color: #0f172a; background: #fff; margin: 0; padding: 0; font-size: 12.5px; line-height: 1.55;
                            -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;
                        }
                        .print-header { border-bottom: 2px solid #0284c7; padding-bottom: 6px; margin-bottom: 12px; }
                        .print-title { font-size: 16px; font-weight: 700; color: #0284c7; margin: 0; }
                        .section-title { background: #f1f5f9; border-left: 4px solid #0284c7; padding: 4px 10px; font-size: 12px; font-weight: 700; margin: 12px 0 6px 0; text-transform: uppercase; }
                        .section-body { padding: 4px 6px; font-size: 12.5px; }
                        ul.note-list, ul.yellow-list { list-style: none; padding: 0; margin: 0; }
                        li.voting-list { border-bottom: 1px dashed #cbd5e1; padding: 6px 0; margin-bottom: 6px; }
                    </style>
                </head>
                <body>
                    <div class="print-header">
                        <div class="print-title">${headerSub}</div>
                        ${fromOfficeDisplay ? '<div>Office: ' + fromOfficeDisplay + '</div>' : ''}
                    </div>
                    <div class="section-title">Subject</div>
                    <div class="section-body">${subjectContent}</div>
                    <div class="section-title">Details</div>
                    <div class="section-body">${detailsContent}</div>
                    ${instructionContent ? '<div class="section-title">Point of Instruction</div><div class="section-body">' + instructionContent + '</div>' : ''}
                    <div class="section-title">Actions Taken</div>
                    <div class="section-body"><ul class="note-list">${notesHtml}</ul></div>
                    <div style="margin-top: 15px; font-size: 10px; color: #64748b; text-align: right; border-top: 1px solid #e2e8f0; padding-top: 4px;">Generated on: ${genDateStr}</div>
                </body>
                </html>
            `;

            var iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            document.body.appendChild(iframe);

            var frameDoc = iframe.contentWindow || iframe.contentDocument;
            if (frameDoc.document) frameDoc = frameDoc.document;
            frameDoc.open();
            frameDoc.write(printDoc);
            frameDoc.close();

            setTimeout(function () {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
                setTimeout(function () {
                    document.body.removeChild(iframe);
                }, 1000);
            }, 400);

        } catch (ex) {
            console.error("Print error:", ex);
            window.print();
        }
    }
</script>




