            color: #ffffff !important;
            box-shadow: 0 1px 3px rgba(239, 68, 68, 0.25) !important;
        }

        .dt-obs-pdf:hover {
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%) !important;
            transform: translateY(-1px);
            color: #ffffff !important;
        }

        .dataTables_filter input {
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            padding: 6px 12px !important;
            font-size: 12.5px !important;
            outline: none !important;
            min-width: 250px !important;
            transition: border-color 0.2s ease !important;
        }

        .dataTables_filter input:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15) !important;
        }

        .dataTables_info {
            font-size: 12px !important;
            color: #64748b !important;
        }

        .dataTables_paginate .paginate_button {
            border-radius: 6px !important;
            font-size: 12px !important;
            padding: 5px 12px !important;
            margin: 0 2px !important;
        }

        .dataTables_paginate .paginate_button.current {
            background: #2563eb !important;
            color: #ffffff !important;
            border-color: #2563eb !important;
        }

        /* 6. Modal Isolation (Prevents overlapping header/sidebar) */
        #InboxModel,
        #SingleModelEdit {
            z-index: 1070 !important;
        }

        .modal-backdrop {
            z-index: 1065 !important;
        }

        .obs-modal-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
            color: #ffffff;
            padding: 14px 20px;
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .obs-modal-title {
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .obs-modal-close {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: #ffffff;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 16px;
        }

        .obs-modal-close:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: rotate(90deg);
        }

        /* Responsive Viewport Optimizations */
        .table-responsive {
            width: 100% !important;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
            margin-bottom: 0 !important;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #ffffff;
        }

        .table-responsive::-webkit-scrollbar {
            height: 7px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        #ObservationReplySearch {
            width: 100% !important;
            min-width: 860px !important;
            margin: 0 !important;
            border: none !important;
        }

        @@media (max-width: 991px) {
            .obs-root-wrapper {
                padding: 0 10px !important;
            }
            .obs-card-container {
                border-radius: 8px !important;
                margin-bottom: 20px !important;
            }
            .obs-card-header {
                padding: 14px 16px !important;
            }
        }

        @@media (max-width: 768px) {
            .obs-card-header {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 12px !important;
                padding: 12px 14px !important;
            }

            .obs-card-header-left {
                width: 100% !important;
            }

            .obs-card-header-right {
                width: 100% !important;
                display: flex !important;
                justify-content: space-between !important;
                align-items: center !important;
                gap: 8px !important;
            }

            .obs-dt-top {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 10px !important;
            }

            .obs-dt-left {
                display: flex !important;
                flex-wrap: wrap !important;
                gap: 8px !important;
                width: 100% !important;
            }

            .dt-obs-btn {
                flex: 1 1 auto !important;
                text-align: center !important;
                justify-content: center !important;
            }

            .obs-dt-right {
                width: 100% !important;
            }

            .dataTables_filter {
                width: 100% !important;
                text-align: left !important;
            }

            .dataTables_filter label {
                width: 100% !important;
                display: block !important;
                margin-bottom: 0 !important;
            }

            .dataTables_filter input {
                width: 100% !important;
                min-width: 0 !important;
                box-sizing: border-box !important;
            }

            .obs-dt-bottom {
                flex-direction: column !important;
                align-items: center !important;
                gap: 10px !important;
                text-align: center !important;
            }

            .dataTables_paginate {
                display: flex !important;
                flex-wrap: wrap !important;
                justify-content: center !important;
            }
        }

        @@media (max-width: 576px) {
            .obs-card-icon {
                width: 34px !important;
                height: 34px !important;
                font-size: 15px !important;
            }

            .obs-card-title {
                font-size: 14px !important;
            }

            .obs-card-meta {
                font-size: 11px !important;
            }

            .obs-btn-refresh {
                padding: 5px 10px !important;
                font-size: 11.5px !important;
            }

            .obs-live-indicator {
                font-size: 11px !important;
                padding: 3px 9px !important;
            }
        }

        /* Legacy alert styling override in case direct alert is injected */
        #showOuterSearchResolutionData .alert-warning {
            display: none !important; /* replaced by modern empty state */
        }
    </style>
</head>

<div id="main-content" style="margin-top: 15px;">
    <div class="col-md-12 col-lg-12 col-xl-12 obs-root-wrapper">

        <!-- ================= BREADCRUMB (Matches Proceedings >> Proceeding Resolutions) ================= -->
        <div class="col-12 p-0 mb-2">
            <h4 id="lblmenuname" class="compact-breadcrumb-bar">Observation Replies <span class="crumb-sep text-muted mx-1">&gt;&gt;</span> Observation Reply List</h4>
        </div>

        <!-- ================= EXECUTIVE CARD ================= -->
        <div class="obs-card-container">
            <div class="obs-card-header">
                <div class="obs-card-header-left">
                    <div class="obs-card-icon">
                        <i class="fa fa-list-alt"></i>
                    </div>
                    <div>
                        <h4 class="obs-card-title">List of Observation Replies</h4>
                        <div class="obs-card-meta">Recorded observation replies and remarks under your departmental jurisdiction</div>
                    </div>
                </div>
                <div class="obs-card-header-right d-flex align-items-center gap-2">
                    <button type="button" class="obs-btn-refresh" onclick="OservationReply()" title="Reload observations list"
                            style="background: #1e3a8a !important; color: #ffffff !important; border: 1px solid #1e3a8a !important; border-radius: 6px !important; padding: 6px 14px !important; font-size: 12px !important; font-weight: 600 !important; display: inline-flex !important; align-items: center !important; gap: 6px !important; box-shadow: 0 1px 3px rgba(30, 58, 138, 0.25) !important; text-decoration: none !important; cursor: pointer !important;">
                        <i class="fa fa-refresh" style="color: #ffffff !important; font-size: 12px !important; margin-right: 4px !important;"></i> Refresh
                    </button>
                    <span class="obs-live-indicator"><span class="obs-pulse-dot"></span> Live Sync</span>
                </div>
            </div>

            <div class="obs-card-body">
                <div id="showOuterSearchResolution">
                    <div id="showOuterSearchResolutionData">
                        <div class="obs-loading-box">
                            <div class="obs-spinner"></div>
                            <div class="obs-loading-text">Fetching Observation Replies...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= INBOX MODAL ================= -->
        <div class="modal inr_modal coman_modal edit_modal" tabindex="-1" id="InboxModel"
             data-keyboard="false" data-backdrop="static" style="z-index: 1070 !important;">
            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg modal_design" id="Scroll2">
                <div class="modal-content" style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                    <div class="obs-modal-header">
                        <h4 id="InboxHeader1" class="obs-modal-title">
                            <i class="fa fa-comments-o"></i> Observation Reply Details
                        </h4>
                        <button type="button" class="obs-modal-close" onclick="closeInboxEdit()" data-bs-dismiss="modal" aria-label="Close">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body" id="InboxModelbody" style="padding: 20px;">
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= SINGLE EDIT MODAL ================= -->
        <div class="modal inr_modal coman_modal edit_modal" tabindex="-1" id="SingleModelEdit"
             data-keyboard="false" data-backdrop="static" style="z-index: 1070 !important;">
            <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg modal_design" id="ScrollSingle">
                <div class="modal-content" style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.15);">
                    <div class="obs-modal-header">
                        <h4 class="obs-modal-title">
                            <i class="fa fa-edit"></i> Single Observation Entry
                        </h4>
                        <button type="button" class="obs-modal-close" onclick="closeSingleEdit()" data-bs-dismiss="modal" aria-label="Close">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                    <div class="modal-body" id="SingleModelEditbody" style="padding: 20px;">
                    </div>
                </div>
            </div>
        </div>

        <input type="hidden" id="RefId" name="RefId" />
     
    </div>
</div>

<script>
    $(document).ready(function () {
       OservationReply();
    });

    function OservationReply() {
        // Show modern loading state
        $("#showOuterSearchResolutionData").html(
            '<div class="obs-loading-box">' +
            '    <div class="obs-spinner"></div>' +
            '    <div class="obs-loading-text">Fetching Observation Replies...</div>' +
            '</div>'
        ).show();

        $.ajax({
            url: '@Url.Action("ObservationReplySearch", "References")',
            type: 'GET',
            data: {},
            success: function (res) {
                // Check if no records found
                if (!res || res.indexOf("No Records Found") !== -1 || res.indexOf("alert-warning") !== -1) {
                    var emptyHtml = 
                        '<div class="obs-empty-card">' +
                        '    <div class="obs-empty-icon-wrap">' +
                        '        <i class="fa fa-folder-open-o"></i>' +
                        '    </div>' +
                        '    <h3 class="obs-empty-title">No Observation Replies Found</h3>' +
                        '    <p class="obs-empty-desc">' +
                        '        There are currently no observation replies recorded for your assigned role or department jurisdiction. ' +
                        '        Replies submitted by executive officers or clerks will appear here automatically.' +
                        '    </p>' +
                        '    <button type="button" class="btn-obs-action" onclick="OservationReply()">' +
                        '        <i class="fa fa-refresh"></i> Check for Updates' +
                        '    </button>' +
                        '</div>';
                    $("#showOuterSearchResolutionData").html(emptyHtml).show();
                    return;
                }

                // Load table HTML
                $("#showOuterSearchResolutionData").html(res).show();

                // Initialize DataTable if table exists
                if ($.fn.DataTable.isDataTable('#ObservationReplySearch')) {
                    $('#ObservationReplySearch').DataTable().destroy();
                }

                var dt = $('#ObservationReplySearch').DataTable({
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                    responsive: false,
                    ordering: true,
                    dom: '<"obs-dt-top"<"obs-dt-left"B><"obs-dt-right"f>>rt<"obs-dt-bottom"<"obs-dt-info"i><"obs-dt-pager"p>>',
                    buttons: [
                        {
                            extend: 'excelHtml5',
                            className: 'dt-obs-btn dt-obs-excel',
                            text: '<i class="fa fa-file-excel-o me-1"></i> Export Excel',
                            title: 'Observation_Replies_' + new Date().toISOString().slice(0, 10),
                            exportOptions: {
                                columns: ':visible'
                            }
                        },
                        {
                            extend: 'pdfHtml5',
                            className: 'dt-obs-btn dt-obs-pdf',
                            text: '<i class="fa fa-file-pdf-o me-1"></i> Export PDF',
                            orientation: 'landscape',
                            pageSize: 'A4',
                            title: null,
                            filename: 'Observation_Replies_' + new Date().toISOString().slice(0, 10),
                            exportOptions: {
                                columns: ':visible',
                                format: {
                                    header: function (data, colIdx) {
                                        if (!data) return '';
                                        return $('<div>').html(data.toString().replace(/<br\s*[\/]?>/gi, ' ')).text().trim();
                                    },
                                    body: function (data, rowIdx, colIdx) {
                                        if (!data) return '-';
                                        var text = data.toString()
                                            .replace(/<br\s*[\/]?>/gi, '\n')
                                            .replace(/<\/div>/gi, '\n')
                                            .replace(/<\/p>/gi, '\n');
                                        var clean = $('<div>').html(text).text().trim();
                                        return clean || '-';
                                    }
                                }
                            },
                            customize: function (doc) {
                                try {
                                    // Register Punjabi font Raavi from vfs-fonts-punjabi.js
                                    var selectedFont = null;
                                    var pdfObj = window.pdfMake || (typeof pdfMake !== 'undefined' ? pdfMake : null);
                                    if (pdfObj && pdfObj.vfs && pdfObj.vfs['Raavi-Regular.ttf']) {
                                        pdfObj.fonts = pdfObj.fonts || {};
                                        pdfObj.fonts.Raavi = {
                                            normal: 'Raavi-Regular.ttf',
                                            bold: pdfObj.vfs['Raavi-Bold.ttf'] ? 'Raavi-Bold.ttf' : 'Raavi-Regular.ttf',
                                            italics: 'Raavi-Regular.ttf',
                                            bolditalics: pdfObj.vfs['Raavi-Bold.ttf'] ? 'Raavi-Bold.ttf' : 'Raavi-Regular.ttf'
                                        };
                                        selectedFont = 'Raavi';
                                    }

                                    doc.defaultStyle = doc.defaultStyle || {};
                                    doc.styles = doc.styles || {};
                                    if (selectedFont) {
                                        doc.defaultStyle.font = selectedFont;
                                        for (var key in doc.styles) {
                                            if (doc.styles.hasOwnProperty(key)) {
                                                doc.styles[key].font = selectedFont;
                                            }
                                        }
                                    }
                                    doc.defaultStyle.fontSize = 8;
                                    doc.pageMargins = [14, 16, 14, 16];

                                    // Add styled heading above the table
                                    doc.content = doc.content || [];
                                    doc.content.unshift({
                                        text: 'Observation Replies >> Observation Reply List',
                                        fontSize: 13,
                                        bold: true,
                                        color: '#1e3a8a',
                                        margin: [0, 0, 0, 10],
                                        font: selectedFont || undefined
                                    });

                                    // Find table node in doc.content
                                    var tableNode = null;
                                    for (var i = 0; i < doc.content.length; i++) {
                                        if (doc.content[i] && doc.content[i].table) {
                                            tableNode = doc.content[i];
                                            break;
                                        }
                                    }

                                    if (tableNode && tableNode.table && tableNode.table.body && tableNode.table.body.length > 0) {
                                        var table = tableNode.table;
                                        table.headerRows = 1;
                                        table.dontBreakRows = true;

                                        var colCount = table.body[0].length;
                                        if (colCount === 7) {
                                            table.widths = [75, 55, 75, '*', 65, 115, 70];
                                        } else {
                                            var widths = [];
                                            for (var j = 0; j < colCount; j++) {
                                                var hName = (table.body[0][j].text || '').toLowerCase();
                                                if (hName.indexOf('subject') !== -1) {
                                                    widths.push('*');
                                                } else if (hName.indexOf('unique') !== -1 || hName.indexOf('res') !== -1) {
                                                    widths.push(75);
                                                } else if (hName.indexOf('number') !== -1) {
                                                    widths.push(55);
                                                } else if (hName.indexOf('file') !== -1) {
                                                    widths.push(75);
                                                } else if (hName.indexOf('date') !== -1) {
                                                    widths.push(65);
                                                } else if (hName.indexOf('comment') !== -1) {
                                                    widths.push(115);
                                                } else if (hName.indexOf('type') !== -1) {
                                                    widths.push(70);
                                                } else {
                                                    widths.push('auto');
                                                }
                                            }
                                            table.widths = widths;
                                        }

                                        for (var r = 0; r < table.body.length; r++) {
                                            var row = table.body[r];
                                            for (var c = 0; c < row.length; c++) {
                                                var cell = row[c];
                                                if (typeof cell !== 'object' || cell === null) {
                                                    cell = { text: String(cell || '') };
                                                    row[c] = cell;
                                                }
                                                if (selectedFont) {
                                                    cell.font = selectedFont;
                                                }

                                                if (r === 0) {
                                                    cell.fillColor = '#1e3a8a';
                                                    cell.color = '#ffffff';
                                                    cell.bold = true;
                                                    cell.fontSize = 8.5;
                                                    cell.alignment = 'center';
                                                } else {
                                                    cell.fontSize = 7.5;
                                                    cell.color = '#1e293b';
                                                    cell.fillColor = (r % 2 === 0) ? '#f8fafc' : '#ffffff';

                                                    var colTitle = (table.body[0][c].text || '').toLowerCase();
                                                    if (colTitle.indexOf('subject') !== -1 || colTitle.indexOf('comment') !== -1) {
                                                        cell.alignment = 'left';
                                                    } else {
                                                        cell.alignment = 'center';
                                                    }
                                                }
                                            }
                                        }

                                        tableNode.layout = {
                                            hLineWidth: function (idx, node) {
                                                return (idx === 0 || idx === 1 || idx === node.table.body.length) ? 0.8 : 0.4;
                                            },
                                            vLineWidth: function () { return 0.4; },
                                            hLineColor: function (idx, node) {
                                                return (idx === 0 || idx === 1 || idx === node.table.body.length) ? '#1e3a8a' : '#cbd5e1';
                                            },
                                            vLineColor: function () { return '#cbd5e1'; },
                                            paddingLeft: function () { return 5; },
                                            paddingRight: function () { return 5; },
                                            paddingTop: function (idx) { return idx === 0 ? 5 : 4; },
                                            paddingBottom: function (idx) { return idx === 0 ? 5 : 4; }
                                        };
                                    }

                                    doc.footer = function (currentPage, pageCount) {
                                        return {
                                            columns: [
                                                {
                                                    text: 'Observation Replies Report - Printed on: ' + new Date().toLocaleDateString('en-GB') + ' ' + new Date().toLocaleTimeString(),
                                                    alignment: 'left',
                                                    fontSize: 7.5,
                                                    color: '#64748b',
                                                    margin: [14, 0, 0, 0]
                                                },
                                                {
                                                    text: 'Page ' + currentPage.toString() + ' of ' + pageCount,
                                                    alignment: 'right',
                                                    fontSize: 7.5,
                                                    color: '#64748b',
                                                    margin: [0, 0, 14, 0]
                                                }
                                            ],
                                            font: selectedFont || undefined
                                        };
                                    };
                                } catch (ex) {
                                    console.error('Error in PDF export customization:', ex);
                                }
                            }
                        }
                    ],
                    language: {
                        search: "",
                        searchPlaceholder: "Search replies...",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries",
                        infoEmpty: "Showing 0 to 0 of 0 entries",
                        emptyTable: "No observation replies available"
                    }
                });
            },
            error: function (xhr) {
                var errorHtml = 
                    '<div class="obs-empty-card" style="border-color:#fca5a5; background:#fef2f2;">' +
                    '    <div class="obs-empty-icon-wrap" style="color:#ef4444; border-color:#fecaca;">' +
                    '        <i class="fa fa-exclamation-triangle"></i>' +
                    '    </div>' +
                    '    <h3 class="obs-empty-title" style="color:#991b1b;">Error Loading Observations</h3>' +
                    '    <p class="obs-empty-desc" style="color:#b91c1c;">' +
                    '        Unable to fetch observation reply data at this time. Please try refreshing or re-login.' +
                    '    </p>' +
                    '    <button type="button" class="btn-obs-action" onclick="OservationReply()">' +
                    '        <i class="fa fa-refresh"></i> Try Again' +
                    '    </button>' +
                    '</div>';
                $("#showOuterSearchResolutionData").html(errorHtml);
            }
        });
    }

