   function OservationReply() {

        $.ajax({
        url: '@Url.Action("ObservationReplySearch", "References")',
        type: 'GET',
        data: {

        },
        success: function (res) {

            // Load table HTML
            $("#showOuterSearchResolutionData").html(res).show();

            // Initialize DataTable after HTML is added
            if ($.fn.DataTable.isDataTable('#ObservationReplySearch')) {
                $('#ObservationReplySearch').DataTable().destroy();
            }

            $('#ObservationReplySearch').DataTable({
                pageLength: 100,
                responsive: true,
                ordering: false,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Export Excel'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: 'Export PDF'
                    }
                ]
            });
        },
        error: function (xhr) {
            alert(xhr.responseText);
        }
    });
}

