  function ShowSDPopUp(id, refid) {

    var agendaDate = $('#agendaDate').val();
    var popup = document.getElementById("SubjectDetailModal");

    // Remove previous position classes
    popup.classList.remove("pdf-popup-left", "pdf-popup-right", "active");

    // Decide popup position based on click
    if (event.clientX > window.innerWidth / 2) {
        // Clicked on right side -> open on left
        popup.classList.add("pdf-popup-left");
    } else {
        // Clicked on left side -> open on right
        popup.classList.add("pdf-popup-right");
    }

    $("#loader-wrapper").show();
    $('#SubjectDetailbody').html('');

    $.ajax({
        type: "GET",
        url: '@Url.Action("getsubjectandsubjectDetails", "References")',
        dataType: "json",
        contentType: "application/json; charset=utf-8",
        data: { refid: refid },

        success: function (response) {

            $("#loader-wrapper").hide();

            if (response && response.length > 0 && response[0].SubjectDetails != null) {

                var html = "";

                html += "<tr>";
                html += "<td>1</td>";
                html += "<td>"
                    + "<div style='font-weight:600; margin-bottom:6px;'>"
                    + (response[0].LetterNo || "")
                    + "</div>"
                    + "<div style='font-size:12px; color:#666;'>"
                    + (agendaDate || "")
                    + "</div>"
                    + "</td>";


                html += "<td style='max-width:700px; white-space:normal; word-break:break-word; overflow-wrap:anywhere; vertical-align:top; overflow:hidden;'>"
                    + "<div style='width:100%; max-width:700px; word-break:break-word; overflow-wrap:anywhere; white-space:normal;'>"

                    + (response[0].SubjectDetails || "")

                    + (response[0].HouseDecision
                        ? "<br/><br/><b>House Decision :</b><br/>" + response[0].HouseDecision
                        : "")

                    + (response[0].ActName
                        ? "<br/><br/><b>Covered under Act/Rules :</b><br/>" + response[0].ActName
                        : "")

                    + (response[0].commissioner
                        ? "<br/><br/><b>Comr./EO Comments :</b><br/>" + stripHtml(response[0].commissioner)
                        : "")

                    + (response[0].ADCComment
                        ? "<br/><br/><b>ADC Comments :</b><br/>" + stripHtml(response[0].ADCComment)
                        : "")

                    + "</div></td>";

                html += "</tr>";
                //html += "<td>" + (response[0].HouseDecision || "") + "</td>";
                //html += "<td>" + (response[0].ActName || "") + "</td>";
                //html += "<td>" + stripHtml(response[0].commissioner || "") + "</td>";
                //html += "</tr>";

                $('#SubjectDetailbody').html(html);

                // Reset drag position
                popup.style.left = "";
                popup.style.right = "";
                popup.style.top = "";

                // Show popup
                popup.classList.add("active");
            }
            else {
                $('#SubjectDetailbody').html(
                    '<tr><td colspan="6" class="text-center">No data found.</td></tr>'
                );
            }
        },

        error: function () {

            $("#loader-wrapper").hide();

            $('#SubjectDetailbody').html(
                '<tr><td colspan="6" class="text-center text-danger">An error occurred while loading data.</td></tr>'
            );
        }
    });
}

