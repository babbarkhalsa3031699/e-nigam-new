  $(document).ready(function () {

    $("#txtMCName").keyup(function () {

    var term = $(this).val();

    if (term.length < 1) {
    $("#mcSuggestions").hide();
    return;
    }



    $.getJSON('@Url.Action("GetMCNames","References")',
    { term: term },
    function (data) {

    var html = "";

    $.each(data, function (i, item) {

        $.each(data, function (i, item) {

            html += "<div class='mc-item' " +
                "data-id='" + item.deptId + "' " +
                "style='padding:8px;cursor:pointer;border-bottom:1px solid #eee;'>" +
                item.deptname +
                "</div>";
        });
    });

    if (html !== "") {

    var rect = $("#txtMCName")[0].getBoundingClientRect();

    $("#mcSuggestions")
    .html(html)
    .css({
    top: rect.bottom + "px",
    left: rect.left + "px",
    width: rect.width + "px",
    position: "fixed",
    zIndex: 2147483647
    })
    .show();
    }
    else {
    $("#mcSuggestions").hide();
    }
    });
    });
    // Select MC
    $(document).on("click", ".mc-item", function () {

    $("#txtMCName").val($(this).text());
    $("#MCID").val($(this).data("id"));

    $("#mcSuggestions").hide();
    });

    // Hide suggestions when clicking outside
    $(document).click(function (e) {

    if (!$(e.target).closest("#txtMCName, #mcSuggestions").length) {
    $("#mcSuggestions").hide();
    }
    });

    // Clear MCID when user edits text manually
    $("#txtMCName").on("input", function () {
    $("#MCID").val("");
    });

    });

