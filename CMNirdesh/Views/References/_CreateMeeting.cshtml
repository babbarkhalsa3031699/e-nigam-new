@*<link href="~/Content/flatpickr.min.css" rel="stylesheet" />
<script src="~/Scripts/flatpickr.js"></script>*@




<script>
   
    var startPicker = null;

    function generateHeader() {

        var ulb   = '@Model.deptnamelocal';
        var type  = $("#MeetingTypeId option:selected").text();
        var date = $("#txtallocationdate").val();
        if (date) {
            var parts = date.split("-");
            var formattedDate = parts[2] + "-" + parts[1] + "-" + parts[0];
            
        }
        var time  = $("#StartTime").val();
        var chair = $("#ChairPerson").val();
        var desig = $("#ChairDesignation").val();

        var Type = '';
        var headerText = `${ulb} ਦੀ ${type} ਜੋ ਕਿ ਮਿਤੀ: ${formattedDate} ਨੂੰ ਸਮਾਂ: ${time} ਵਜੇ ${chair}, ${desig} ਦੀ ਪ੍ਰਧਾਨਗੀ ਹੇਠ, ${ulb} ਦੇ ਮੀਟਿੰਗ ਹਾਲ ਵਿੱਚ ਆਯੋਜਿਤ ਕੀਤੀ ਜਾਣੀ ਨਿਸ਼ਚਿਤ ਕੀਤੀ ਗਈ ਹੈ।`;


        $("#CreateMeetingHeader").val(headerText);
        $("#HeaderPreview").text(headerText);
    }

    $(document).ready(function () {
         // Close picker on scroll (prevents floating issues)
        document.addEventListener("scroll", function () {
            if (startPicker && startPicker.isOpen) {
                startPicker.close();
            }
        }, true);

        // Header generation events
        $(document).on(
            "keyup change",
            "#txtallocationdate,#MeetingTypeId,#ChairPerson,#ChairDesignation, #StartTime",
            generateHeader
        );

        $(document).on(
            "keyup change",
            "#Proceedingfirstpageheader, #meetingname,#meetingdate,#tChairPerson,#tChairpersonDesignation",
            // generateHeaderUpdate

        );


    });



    $('#HeaderPreview').on('input blur', function () {
        $('#CreateMeetingHeader').val($(this).text().trim());
    });

    // SAVE (Your existing logic – untouched)
    function SaveMeeting() {

        if ($("#txtAgendaName").val().trim() === "") {
            alert("Please enter meeting name");
            return;
        }
        if ($("#txtallocationdate").val().trim() == "") {
            alert("Please select Meeting Date");
            $("#txtallocationdate").focus();
            return false;
        }

        if ($("#StartTime").val().trim() == "") {
            alert("Please select Start Time");
            $("#StartTime").focus();
            return false;
        }

        if ($("#txtAgendaName").val().trim() == "") {
            alert("Please enter Meeting Name");
            $("#txtAgendaName").focus();
            return false;
        }

        if ($("#MeetingTypeId").val() == "" || $("#MeetingTypeId").val() == null) {
            alert("Please select Meeting Type");
            $("#MeetingTypeId").focus();
            return false;
        }

        if ($("#ChairPerson").val().trim() == "") {
            alert("Please enter Chair Person");
            $("#ChairPerson").focus();
            return false;
        }

        if ($("#ChairDesignation").val().trim() == "") {
            alert("Please enter Chair Person Designation");
            $("#ChairDesignation").focus();
            return false;
        }

        var dataString = new FormData($("#formActionDispatch")[0]);

        $.ajax({
            type: "POST",
            url: '@Url.Action("SaveAgenda", "References")',
            data: dataString,
            contentType: false,
            processData: false,
            success: function (data) {
                if (data) {
                    $("#CreateMeeting").html(data);
                    alert("Meeting added successfully.");
                } else {
                    alert("Error occurred.");
                }
            }
        });
    }


    $('#editHeaderPreview').on('click', function () {

        if (!confirm('Do you want to edit the Agenda header?')) {
            return;
        }

        const $preview = $('#HeaderPreview');

        $preview
            .attr('contenteditable', 'true')
            .focus();

        // Move cursor to end
        document.getSelection().selectAllChildren($preview[0]);
        document.getSelection().collapseToEnd();
    });

</script>
<div id="CreateMeeting">

    <form id="formActionDispatch" method="post" enctype="multipart/form-data">

