                                    @*<input type="text"
                                        id="ChairDesignation"
                                        class="form-control"
                                        placeholder="ਚੇਅਰਪਰਸਨ ਅਹੁਦਾ"
                                        required />*@

                                    @Html.TextBoxFor(m => m.CreateMeeting.ChairPersonDesignation,
                                      new
                                          {
                                          id = "ChairDesignation",
                                          @class = "form-control",
                                          required = "required"
                                      })
                                </div>

                            </div>

                            <!-- HEADER PREVIEW -->
                            <div class="mt-4">
                                <div class="fw-bold mb-2">
                                    Auto-Generated Agenda Header
                                    <i class="fas fa-pen text-primary"
                                       id="editHeaderPreview"
                                       style="cursor:pointer;"
                                       title="Edit"></i>
                                </div>
                                <div id="HeaderPreview"
                                     class="p-3 bg-light"
