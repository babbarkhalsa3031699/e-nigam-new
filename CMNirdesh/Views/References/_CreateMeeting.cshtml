                                     style="min-height: 4.5em;border: 2px dotted #6c757d;border-radius: 0.5rem;">
                                </div>
                            </div>

                            <!-- BUTTON -->
                            <div class="text-end mt-4">
                                <button type="button"
                                        class="btn btn-primary px-4"
                                        onclick="SaveMeeting()">
                                    Create Meeting
                                </button>
                            </div>

                        </div>

                    </div>

                </div>
            </div>
        }
        <div class="tooltip-modal dispatch_modal modal" id="myModal2" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="max-width: 400px; margin: 0 auto;">
