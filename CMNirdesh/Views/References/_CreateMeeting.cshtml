<script>
    function GetById(UserId) {
    userid = UserId;
    $.ajax({
        type: "GET",
        url: '@Url.Action("Edit", "Agenda")' + '?id=' + UserId,
        contentType: "application/json;charset=utf-8",
        dataType: "json",
        success: function (data) {
        $('#DisplayModal').show();

        var agendaData = JSON.parse([data]); // Parse the JSON string into an object
        var now = new Date(agendaData[0].AgendaDate);

        var day = ("0" + now.getDate()).slice(-2);
        var month = ("0" + (now.getMonth() + 1)).slice(-2);
        var today = now.getFullYear() + "-" + (month) + "-" + (day);
        $("#meetingdate").val(today);

        $("#meetingname").val(agendaData[0].AgendaName);
        $("#Proceedingfirstpageheader").val(agendaData[0].Header);
        $("#proceedinglastpageheader").val(agendaData[0].Footer);

        $("#tChairPerson").val(agendaData[0].ChairPerson);
        $("#tChairpersonDesignation").val(agendaData[0].ChairPersonDesignation);

        $("#starttime").val(agendaData[0].StartTime);
        $("#starttime").val(agendaData[0].StartTime);
        $("#lasttime").val(agendaData[0].EndTime);
        $("#agendatype").val(agendaData[0].Agendatype);
        $("#agendaStatus").val(agendaData[0].Status);
        const footerElement = document.getElementById('footer');
        footerElement.innerText = agendaData[0].Footer;

        }


        });
        }

        function validateForm() {

        var meetingname = document.getElementById('meetingname');
        var meetingdate = document.getElementById('meetingdate');

        var header = document.getElementById('Proceedingfirstpageheader');
        //var footer = document.getElementById('proceedinglastpageheader');
        var ChairPerson = document.getElementById('tChairPerson');
        var ChairPersonDesignation = document.getElementById('tChairpersonDesignation');
        var starttime = document.getElementById('starttime');
        var lasttime = document.getElementById('lasttime');
        //var agendatype = document.getElementById('agendatype');

        // Check if any of the required inputs are empty
            if (meetingname.value === '' || meetingdate.value === '' || header.value === '' || ChairPersonDesignation.value === '' || starttime.value === '' || ChairPerson.value === '') {
        alert('Please fill in all the required fields.');
        return;
        }
        Update();

        }

        function Update() {

        var empObj = {
        AgendaId: userid,
        AgendaDate: $('#meetingdate').val(),
        AgendaName: $('#meetingname').val(),
        Header: $('#Proceedingfirstpageheader').val(),
        Footer: $('#proceedinglastpageheader').val(),
        StartTime: $('#starttime').val(),
        EndTime: $('#lasttime').val(),
        ChairPerson: $('#tChairPerson').val(),
        ChairPersonDesignation: $('#tChairpersonDesignation').val(),
        Agendatype: "Diary",
        Status: "1"
        };

        $.ajax({
        type: "POST",
        data: JSON.stringify(empObj),
        url: "@Url.Action("UpdateAgenda", "References")",
        contentType: "application/json"
        }).done(function (result) {
        alert("Updated Successfully");
        $('#myModal').modal('hide');
        $("#CreateMeeting").html(result);

        });

