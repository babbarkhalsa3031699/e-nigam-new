                    html = html + "<input type='radio' onclick='ActionStatusCheck(this)' id='chk' value='10' name='group2' checked='checked' style='width:3%;'>";
                    html = html + "<span style='width:5% cursor:pointer;'>All(</span><span style='cursor:pointer;' id='TotalDispatchnew'></span>)";
                    for (var i = 0; i < result.length; i++) {
                        var item = result[i];
                        //if (item.Text == "Pending") {
                        //    html = html + "<input type='radio' onclick='ActionStatusCheck(this)' id='chk'" + item.Text + "' value='" + item.Value + "' name='group2'   style='width:3%;'>";
                        //}
                        //else {
                            html = html + "<input type='radio' onclick='ActionStatusCheck(this)' id='chk'" + item.Text + "' value='" + item.Value + "' name='group2'style='width:3%;'>";
                       // }
                        html = html + "<span style='width:5%'>" + item.Text + "</span>";
                        html = html + "<span  onclick='DispatchCountClick(" + item.Value + ")'    style='width:5%; cursor:pointer; margin-left:5px;" + item.background + "; '>" + '(' + item.count + ')' + "</span>";
                    }

                    $("#StatusList").html(html);
                    $("#loader-wrapper").hide();
                }

                else {
                    $("#StatusList").html("No Data Found");
                    $("#loader-wrapper").hide();

                }
            }
            ,
            error: function (result) {
                $("#loader-wrapper").hide();
            }

        });

    }

