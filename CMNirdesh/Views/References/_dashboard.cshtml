    function GetDepartment() {

        var deptt = $("#deptt");
        var id = $("#deptt").val();
       // deptt.empty().append('<option  value="">Please select</option>');
       // $('#deptt').empty().append('<option  value="">Please select</option>');
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetDepartmentsNav", "References")',
            datatype: "Json",
            data: {},
            success: function (data) {
                var deptnameee = '@Session["deptnameee"]';
                if (deptnameee != "") {
                    deptt.append($("<option></option>").val(id).html(deptnameee));
                }
                else {
                   // deptt.empty().append('<option value=""> -- select --</option>');
                }
                $.each(data, function () {
                    deptt.append($("<option></option>").val(this['id']).html(this['name']));
                });
                $("#deptt").val('@CurrentSession.DeptID');//OfficeName
               
                GetOffice('@CurrentSession.DeptID','@CurrentSession.OfficeId');



            }
        });
    }



    function GetOffice(deptttid, officeid) {
       
        //$('#offId').empty().append('<option value="">Please select</option>');
        $('#offId').empty();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetOfficebyDepartmentIdNav", "References")',
            datatype: "Json",
            data: { deptid: deptttid },
            success: function (data) {
                $.each(data, function (index, value) {
                    var selected = '';
                    if (value.id == officeid) {
                        selected = 'selected';

                    } else {
                        selected = '';
                    }
                    $('#offId').append('<option value="' + value.id + '" ' + selected +'>' + value.name + '</option>');
                    $("#deptNameShow").hide();
                    $("#OfficeNameShow").hide();
                });

            }

        });

    }

    $("#deptt").change(function () {
        var depid = $("#deptt").val();
        GetOffice(depid,'');
    })

    $("#offId").change(function () {
        var depid = $("#deptt").val();
        var officeid = $("#offId").val();
          $.ajax({
            type: "GET",
            url: '@Url.Action("SetOffice", "References")',
            datatype: "Json",
              data: { deptid:depid,officeid: officeid },
            success: function (data) {
                window.location.reload();
            }

        });
    })

    function ResetSince() {

        var dropDown = document.getElementById("sincefilter");
        dropDown.selectedIndex = 0;
        $("#sincefilter").val('');

