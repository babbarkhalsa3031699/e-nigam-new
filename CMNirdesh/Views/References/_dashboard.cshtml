    function GetAllDiaryCount() {
        var diarydispatchvalue = "diary";
        $("#diarydispatchval").val(diarydispatchvalue);
        var startDt = $("#txtFrom").val();
        var endDt = $("#txtTo").val();
        var since = $("#sincefilter").val();
        $("#loader-wrapper").show();
        if (since != "" && (startDt != "" || endDt !== "")) {
            alert("Please select either ReferenecFrom - ReferenceTo  or since filter!!");
            $("#loader-wrapper").hide();
            return false;
        }
           $.ajax({
            type: "GET",
              url: '@Url.Action("GetAllDiaryCount", "References")',
            datatype: "Json",
                contentType: "application/json; charset=utf-8",
               data: { startDt: startDt, endDt: endDt, since: since },
                success: function (response) {
                    if (response != null) {
                        TotalDiary = new Intl.NumberFormat('en-IN').format(response[0].TotalDiary);
                        TotalDiarynew = new Intl.NumberFormat('en-IN').format(response[0].TotalDiary);
                        TotalDiaryR = new Intl.NumberFormat('en-IN').format(response[0].TotalDiary);
                        $("#TotalDiary").append().html(TotalDiary);
                        $("#TotalDiarynew").append().html(TotalDiarynew);
                        $("#TotalDiarynewR").append().html(TotalDiaryR);

                        $("#loader-wrapper").hide();
                        $("#dispatchcounttr").hide();
                        $("#diarycounttr").show();
                    }
                    else {
                        $("#dispatchcounttr").hide();
                        $("#diarycounttr").hide();
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (error) {
                }
              });



    }

    function GetAllDispatchCount() {

        var diarydispatchvalue = "dispatch";
        $("#diarydispatchval").val(diarydispatchvalue);
        var startDt = $("#txtFrom").val();
        var endDt = $("#txtTo").val();
        var since = $("#sincefilter").val();
        $("#loader-wrapper").show();
        if (since != "" && (startDt != "" || endDt !== "")) {
            alert("Please select either ReferenecFrom - ReferenceTo  or since filter!!");
            $("#loader-wrapper").hide();
            return false;
        }
           $.ajax({
            type: "GET",
              url: '@Url.Action("GetAllDispatchCount", "References")',
              datatype: "Json",
                contentType: "application/json; charset=utf-8",
               data: { startDt: startDt, endDt: endDt, since: since },
                success: function (response) {
                    if (response != null) {
                        TotalDispatch = new Intl.NumberFormat('en-IN').format(response[0].TotalDispatch);
                        TotalDispatchnew = new Intl.NumberFormat('en-IN').format(response[0].TotalDispatch);
                         TotalDispatchR = new Intl.NumberFormat('en-IN').format(response[0].TotalDispatch);
                        $("#TotalDispatch").append().html(TotalDispatch);
                        $("#TotalDispatchnew").append().html(TotalDispatchnew);
                        $("#TotalDispatchnewR").append().html(TotalDispatchR);

                        $("#loader-wrapper").hide();
                        $("#dispatchcounttr").show();
                        $("#diarycounttr").hide();
                    }
                    else {
                        $("#dispatchcounttr").hide();
                        $("#diarycounttr").hide();
                        $("#loader-wrapper").hide();
                    }
               },
                error: function (error) {
                }
              });



    }

    function DiaryCountClick(dd) {
        var param = dd;
        var since = $("#sincefilter").val();
        GetAllDiaryCount();
        var startDt = $("#txtFrom").val();
        var endDt = $("#txtTo").val();

        $.ajax({
            url: '@Url.Action("GetAllDiaryDataByStatus", "References")',
            type: 'GET',
            data: {
                status: param,
                startDt: startDt,
                endDt: endDt,
                since: since
            },
            success: function (data) {
                var pos = $("#listdiv").offset().top;
                $('body, html').animate({ scrollTop: pos });
                $("#listdiv").html(data);
                $("#loader-wrapper").hide();
            },
            error: function (result) {
                $("#loader-wrapper").hide();
            }
        });
    }

    function DispatchCountClick(dd) {
        var param = dd;
        var since = $("#sincefilter").val();
        var startDt = $("#txtFrom").val();
        var endDt = $("#txtTo").val();
        GetAllDispatchCount();
        $.ajax({
            url: '@Url.Action("GetAllDispatchDataByStatus", "References")',
            type: 'GET',
            data: {
                status: param,
                startDt: startDt,
                endDt: endDt,
                since: since
            },
            success: function (data) {
                var pos = $("#listdiv").offset().top;
                $('body, html').animate({ scrollTop: pos });
                $("#listdiv").html(data);
                $("#loader-wrapper").hide();
            },
            error: function (result) {
                $("#loader-wrapper").hide();
            }
        });
    }

    $("#sincefilter").change(function () {
        var sinceparam = $(this).val();
        $("#sincefilterhdn").val(sinceparam);
        var diarydispatchvalue = $("#diarydispatchval").val();

        if ($("#chkDiary").prop("checked")) {
            var diarydispatchvalue = "diary";
            $("#diarydispatchval").val(diarydispatchvalue);
            DashboardBind();
            GetAllDiaryCount();
            BindActionStatus();
        }
        else {
            var diarydispatchvalue = "dispatch";
            $("#diarydispatchval").val(diarydispatchvalue);
            DashDispatchboardBind();
            GetAllDispatchCount();
            BindActionStatusDispatch();

        }
    });

    function ActionStatusCheck(obj) {
        if ($("#chkDiary").prop("checked")) {
            var diarydispatchvalue = "diary";
            $("#diarydispatchval").val(diarydispatchvalue);

            GetAllDiaryCount();
            DashboardBind();
        }
        else {
            var diarydispatchvalue = "dispatch";
            $("#diarydispatchval").val(diarydispatchvalue);
            DashDispatchboardBind();
            GetAllDispatchCount();
        }
    }

    function expand(obj) {
        var tdid = $(obj).attr("id");
        var className = $(obj).attr('class');

        if (className == 'plus') {
            $("#" + tdid).removeClass("plus");
            $("#" + tdid).addClass("minus");
        } else {
            $("#" + tdid).removeClass("minus");
            $("#" + tdid).addClass("plus");
            var expid = '.trofc' + tdid;
            $(expid).remove();
            return false;
        }

        GetDiaryDataByDept($("#" + tdid).attr('deptid'), tdid);

    }

    function expandD(obj) {
        var tdid = $(obj).attr("id");
        var className = $(obj).attr('class');

        if (className == 'plus') {
            $("#" + tdid).removeClass("plus");
            $("#" + tdid).addClass("minus");
        } else {
            $("#" + tdid).removeClass("minus");
            $("#" + tdid).addClass("plus");
            var expid = '.trDofc' + tdid;
            $(expid).remove();
            return false;
        }
        GetDispatchDataByDept($("#" + tdid).attr('deptid'), tdid);

    }




    function GetDiaryDataByDept(deptId, tdid) {
        alert(deptId);
        alert(tdid);
        var since = $("#sincefilter").val();
        var html = "";
        var status = 10;
        var startDt = $("#txtFrom").val();
        var endDt = $("#txtTo").val();
        status = GetActionStatusValue();
        var pathurl = '/References/GetDiaryDataByDepartment';
        $.ajax({
            url: pathurl,
            type: 'GET',
          //  data: { deptId: deptId, status: status, startDt: startDt, endDt: endDt, since: since },
            data: { tdid: tdid },
            success: function (result) {
                alert(result.length);
                if (result.length > 0) {
                    $("#secondtablediv").html(result);

                    var expid = '#expand' + tdid;
                    $(expid).remove();
                    $(html).insertAfter($('#tr' + tdid));

                    $("#loader-wrapper").hide();
                }

                else {

                    $("#loader-wrapper").hide();
                }
            }
            ,
            error: function (result) {
                $("#loader-wrapper").hide();
            }
        });
    }



