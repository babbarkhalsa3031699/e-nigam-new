    <script>
      function ResolutionSearch() {

    $.ajax({
        url: '@Url.Action("ResolutionSearch", "References")',
        type: 'GET',
        data: {
            RefId: $('#txtRefId').val(),
            MCID: $('#MCID').val(),
            ResolutionNo: $('#txtResolutionNo').val(),
            MeetingDate: $('#txtMeetingDate').val()
        },
        success: function (res) {

            // Load table HTML
            $("#showOuterSearchResolutionData").html(res).show();

            // Initialize DataTable after HTML is added
            if ($.fn.DataTable.isDataTable('#StatsResSearch')) {
                $('#StatsResSearch').DataTable().destroy();
            }

            $('#StatsResSearch').DataTable({
                pageLength: 100,
                responsive: true,
                ordering: false,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Export Excel'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: 'Export PDF'
                    }
                ]
            });
        },
        error: function (xhr) {
            alert(xhr.responseText);
        }
    });
}

