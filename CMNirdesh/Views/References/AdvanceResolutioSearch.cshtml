    <style>
        .select-box {
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .dropdown {
            cursor: pointer;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            background: #fff;
        }

        .dropdown-options {
            display: none;
            border: 1px solid #ccc;
            background: #fff;
            position: absolute;
            width: 100%;
            max-height: 300px;
            overflow-y: auto;
            z-index: 1000;
            padding: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .dropdown-options label {
                display: block;
                padding: 5px;
                cursor: pointer;
            }

            .dropdown-options input {
                margin-right: 5px;
            }

        .search-box {
            margin-bottom: 10px;
            padding: 5px;
            width: 100%;
            box-sizing: border-box;
        }

        .selected-items {
            display: flex;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }

        .selected-item {
            background: #007bff;
            color: #fff;
            padding: 5px 10px;
            margin: 2px;
            border-radius: 15px;
            display: flex;
            align-items: center;
        }

            .selected-item span {
                margin-left: 5px;
                cursor: pointer;
                font-weight: bold;
            }

                .selected-item span:hover {
                    color: #ff4d4d;
                }


        .compact-filter {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px 15px;
            font-size: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            overflow: visible !important;
        }
        #showOuterSearchResolution,
        #filterLG,
        #filterLG .row,
        #filterLG .col-md-2,
        #filterLG .position-relative {
            overflow: visible !important;
        }

        #mcSuggestions {
            display: none;
            position: fixed !important;
            background: #fff;
            font-size: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-shadow: 0 4px 10px rgba(0,0,0,.15);
            max-height: 300px;
            overflow-y: auto;
            z-index: 2147483647 !important;
        }

        .mc-item {
            padding: 8px 10px;
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }

            .mc-item:hover {
                background: #f5f5f5;
            }


        /* Labels */
        .compact-filter label {
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 4px;
            color: #555;
            display: block;
        }

        /* Compact Dropdowns (Bootstrap 3 safe) */
        .compact-filter select.form-control {
            height: 30px !important;
            font-size: 12px;
            padding: 2px 6px;
            border-radius: 6px;
        }

        .compact-filter input.form-control {
            height: 30px !important;
            font-size: 12px;
            padding: 2px 6px;
            border-radius: 6px !important;
        }
    </style>
