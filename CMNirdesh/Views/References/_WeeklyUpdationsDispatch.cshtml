    var count = 0;
    function PreviousSevenDaysDispatch() {
        if (count >= 1) {
            count = count - 1;
            $("#intval").val(count);
        }
        NextPreviuosWeekDataDispatch(count);

    }

    function NextSevenDaysDispatch() {
        count = count + 1;
        $("#intval").val(count);
        NextPreviuosWeekDataDispatch(count);
    }

    function NextPreviuosWeekDataDispatch(count) {
        var diarydispatchValue = $("#diarydispatchValueWD").val();
        if (diarydispatchValue == "Act") {
            DispatchActionRefWiseArrow(count);
        }
        else {
            DispatchRefWiseArrow(count);
        }
    }

    function EditMlaDispatch(IDD) {
        var ID = IDD.id;
        $('#loginModaldiarybody').html('');
        $('#loginModalBody').html('');
        $('#loginModalDispatchbody').html('');
        var pathurl = '/References/EditMlaDispatchForm';
        $.ajax({
            type: "GET",
            url: pathurl,

            data: { ID: ID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                $('#loginModalDispatchbody').html('');
                //debugger;
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();
                if (data) {
                    $("#loginModalDispatch").css("display", "block");
                    $('#loginModalDispatchbody').html(data);
                    //$('#myModalContent').html(data);
                    //  $('#loginModalDispatch').modal(options);

                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            },
            complete: function (results) {
                $('#loader-wrapper').hide();
            }
        });
    }

