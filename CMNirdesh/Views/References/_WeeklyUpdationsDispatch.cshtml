    function getofcrDataAgency() {
        $("#loader-wrapper").show();
        var DocumentType = $("#maintype").val();
        var Office = $("#Office").val();
        var Office = $("#Office option:selected").val();
        var DocumentType = $("#maintype").val();
        var pathurl = '/References/FilteredMLADiaryListForAgencyDispatch'
        $.ajax({
            url: pathurl,
            type: 'GET',
            async: true,
            data: {
                Office: Office,
                DocumentType: DocumentType
            },
            success: function (data) {
                $("#loader-wrapper").hide();
                $("#Dispatchlistdiv").html('');
                $("#Dispatchlistdiv").html(data);
            }
        });
    }

    function GetDispatchDataByDate(obj) {
        $("#loader-wrapper").show();
        $("#Dispatchlistdiv").html('');
        var Agency = 0;
        var DispatchDate = $(obj).attr('dispatchDate');
        var pathurl = '/References/GetDispatchDataByDate'

        $.ajax({
            url: pathurl,
            type: 'GET',
            async: true,
            data: {
                DispatchDate: DispatchDate
            },
            success: function (data) {
                $("#loader-wrapper").hide();
                $("#Dispatchlistdiv").html('');
                $("#Dispatchlistdiv").show();
                $("#Dispatchlistdiv").css("display", "block");
                $("#Dispatchlistdiv").html(data);
                $("#DispatchTableDiv").css("display", "none");
                $("#DispatchTableDiv").hide();
            }
            ,
            error: function (result) {
                $("#loader-wrapper").hide();
            }
        });


    }

