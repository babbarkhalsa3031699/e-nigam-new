    function ObservationRaised() {

        $.ajax({

            url: '@Url.Action("ObservationRaisedSearch", "References")',

            type: 'GET',

            data: {},

            beforeSend: function () {
                $('#loader-wrapper').show();
            },

            success: function (res) {

                // Load table HTML
                $("#showOuterSearchResolutionData")
                    .html(res)
                    .show();

                // Initialize DataTable
                if ($.fn.DataTable.isDataTable('#ObservationRaisedSearch')) {

                    $('#ObservationRaisedSearch')
                        .DataTable()
                        .destroy();
                }

                $('#ObservationRaisedSearch').DataTable({

                    pageLength: 100,

                    responsive: true,

                    ordering: false,

                    dom: 'Bfrtip',

                    buttons: [

                        {
                            extend: 'excelHtml5',
                            text: 'Export Excel'
                        },

                        {
                            extend: 'pdfHtml5',
                            text: 'Export PDF'
                        }
                    ]

                });

            },

            error: function (xhr) {

                alert(xhr.responseText);

            },

            complete: function () {

                $('#loader-wrapper').hide();

            }

        });

    }


