    }

    #btnaddref {
        float: right;
    }

    #includedivbutton {
        float: right;
    }

    .voteyes {
        color: green;
        font-size: 28px !important
    }

    .voteno {
        color: red;
        font-size: 28px !important;
        margin-left: 10px
    }

    .generate {
        color: green !important;
        cursor: pointer;
    }

    .noadded {
        background-color: #b5b5b5 !important;
    }

    #tableRef {
        width: 100% !important;
    }

    .dataTables_length {
        display: none !important;
    }

    .dataTables_filter {
