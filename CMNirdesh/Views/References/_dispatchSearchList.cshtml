@model CMNirdesh.Models.DiaryViewModel
@using CMNirdesh.Models

@{
    var FileSettings =
       CMNirdesh.Models.FileSetting.GetSecureFileSettingLocation();

int count = 0;
if (ViewBag.CurrentPage > 1)
{

    count = (ViewBag.PageSize * (ViewBag.CurrentPage - 1));
}
}


<div class="widget-box widget-color-blue">

    <div class="widget-header widget-header-flat Red">
        @if (Model.lstDiaryViewModel != null && Model.lstDiaryViewModel.Count > 0)
        {

            @Model.Header;
        }


        <div class="widget-toolbar">

            <span class="badge badge-danger">Count @Model.lstDiaryViewModel.Count() </span>


        </div>
    </div>

    <div class="widget-body">
        <div class="pass-table">

            @if (Model.lstDiaryViewModel != null)
            {
                if (Model.lstDiaryViewModel.Count() > 0)
                {


                    <div class="table-responsive">
                        <table class="table table-bordered  dataTable" id="dispatchSearch" aria-describedby="dispatchSearch_info" style="width: 100%; overflow: scroll;">
                            <thead>
                                <tr role="row">
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width:25%">Subject</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width: 6%">Release Date</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width: 15%">Department</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width: 25%">Brief of Last Action Taken</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width: 10%">Status</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width: 6%">Ref.Id /<br />Date</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width: 6%">Priority</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center; width: 6%">Term</th>
                                    <th class="center" role="columnheader" rowspan="1" colspan="1" style="text-align: center;"></th>
                                </tr>
                            </thead>
                            <tbody role="alert" aria-live="polite" aria-relevant="all">
                                @foreach (var item in Model.lstDiaryViewModel)
                                {
                                    count = count + 1;

                                    <tr>
                                        <td style="text-align: center;">
                                            @item.Subject
                                        </td>
                                        <td style="text-align: center;">
                                            @Convert.ToDateTime(item.LetterDate).ToString("dd/MM/yyyy")
                                        </td>
                                        <td style="text-align: center;">
                                            @("["+item.ToDept+"] - " + item.ToOffice)
                                        </td>
                                        <td style="text-align: center;">
                                            @item.BriefLastAction
                                        </td>
                                        <td style="text-align: center;">

                                            @if (item.ActionTakenDate != null)
                                            {
                                                <br />
                                                @("ActionDate: " + Convert.ToDateTime(item.ActionTakenDate).ToString("dd/MM/yyyy"))
                                            }
                                            @if (item.StatusName != null)
                                            {
                                                @("Status: " + Convert.ToString(item.StatusName))

                                            }
                                            @if (!string.IsNullOrEmpty(item.ActionTakenFile))
                                            {
                                                string Actionpath1 = "https://cmnirdesh.punjab.gov.in" + item.ActionTakenFile;

                                                <a href="@Actionpath1" target="_blank">
                                                    <img src="~/Assets/Home_Images/PDF.png" alt="Download" title="Download Pdf" width="24" height="24" />
                                                </a>
                                            }

                                            else
                                            {

                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            @item.RefId  <br /> @Convert.ToDateTime(item.CreatedDate).ToString("dd/MM/yyyy")
                                        </td>

                                        <td style="text-align: center;">
                                            @if (item.ReferencePriorityType == 1)
                                            {
                                                <span>
                                                    High
                                                </span>
                                            }
                                            @if (item.ReferencePriorityType == 2)
                                            {
                                                <span>
                                                    Normal
                                                </span>
                                            }
                                            @if (item.ReferencePriorityType == 3)
                                            {
                                                <span>
                                                    Low
                                                </span>
                                            }

                                        </td>
                                        <td style="text-align: center;">
                                            @if (item.ReferenceTerm == 1)
                                            {
                                                <span>
                                                    Short
                                                </span>
                                            }
                                            @if (item.ReferenceTerm == 2)
                                            {
                                                <span>
                                                    Medium
                                                </span>
                                            }
                                            @if (item.ReferenceTerm == 3)
                                            {
                                                <span>
                                                    Long
                                                </span>
                                            }

                                        </td>
                                        <td>
                                            @*@if (item.EditPermission == 1)
                                                {*@
                                            <a data-rel="tooltip" class="green tooltip-success" title="Edit" href="#" onclick="EditMlaDairy('@item.RefId')">
                                                <i class="ace-icon fa fa-pencil bigger-160"></i>
                                            </a>
                                            @*}*@

                                            <a target="_blank" data-rel="tooltip" class="green tooltip-success" title="Print" href="@Url.Action("GetDiaryPrint", "References", new { RefId = item.RefId }) ">
                                                <i class="ace-icon fa fa-print bigger-160"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-12">
                            <div class="alert alert-info">
                                <strong>No Data Found !!!</strong><br />
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="modal inr_modal coman_modal edit_modal" tabindex="-1" id="loginModaldispatchSearchEdit"
         data-keyboard="false" data-backdrop="static">
        <div class="modal-dialog modal-xl modal_design" id="Scroll2">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close close_btn" onclick="closedispatchEdit()" data-dismiss="modal">x</button>
                    <h4 class="widget-title modal_heading">Dispatch</h4>
                </div>
                <div class="modal-body" id="loginModaldispatchSearchEditbody">

                </div>
                <div class="modal-footer">

                </div>
            </div>
        </div>
    </div>


</div>

<script>

    $(document).ready(function () {
        var table = $('#dispatchSearch').DataTable({
            searching: true, paging: true, info: false,
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i style="font-size: 27px; color:green;" class="fa fa-file-excel-o"></i>',
                    titleAttr: 'Excel'
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i style="font-size: 27px;color:red; background:white;" class="fa fa-file-pdf-o "></i>',
                    titleAttr: 'PDF'
                }
            ]
        });
    });




    function GeneratePdfByOfficeid(type) {
        bootbox.prompt({
            title: "Generate Pdf of MLA Diary Status Report.",
            value: [''],
            inputType: 'checkbox',
            inputOptions: [{
                text: 'With Details',
                value: '1',
            }],
            callback: function (result) {
                var WithDetails = false;
                if (result == null) {

                }

                else if (result == "1") {
                    //with Details Column
                    $("#loader-wrapper").show();

                    WithDetails = true;
                    var DocumenttypeSelected = $("#maintype").val();
                    var Constituency = $("#Constituency  option:selected").val();
                    var ddOfficeId = $("#Office option:selected").val();
                    var OfficeName = $("#Office option:selected").text();
                    var actioncode = $("#favouriteMLA option:selected").val();
                    if (actioncode == 10) {
                        actioncode = "";
                    }
                    if (ddOfficeId == 0) {
                        ddOfficeId = "";
                        OfficeName = "";
                    }

                    $.ajax({
                        url: "/Notices/OnlineMemberQuestions/GeneratePdfByOfficeid",
                        type: 'GET',

                        data: {
                            ActionTypeCode: actioncode,
                            Officeid: ddOfficeId,
                            OfficeName: OfficeName,
                            DocumenttypeSelected: DocumenttypeSelected,
                            ConstituencyId: Constituency,
                            WithDetails: WithDetails
                        },
                        success: function (data) {
                            if (data) {
                                var value = "PdfbyOfficeId.pdf";
                                window.open("/Notices/OnlineMemberQuestions/DownloadPDF?parameter=" + value, "_blank");
                                $("#loader-wrapper").hide();
                            } else { alert("error"); }
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            alert(xhr.responseText);
                            alert(thrownError);
                        }
                    });

                }
                else {
                    //Without Details Column
                    $("#loader-wrapper").show();
                    var DocumenttypeSelected = $("#maintype").val();
                    var Constituency = $("#Constituency  option:selected").val();
                    var ddOfficeId = $("#Office option:selected").val();
                    var OfficeName = $("#Office option:selected").text();
                    var actioncode = $("#favouriteMLA option:selected").val();
                    if (actioncode == 10) {
                        actioncode = "";
                    }
                    if (ddOfficeId == 0) {
                        ddOfficeId = "";
                        OfficeName = "";
                    }

                    $.ajax({
                        url: "/Notices/OnlineMemberQuestions/GeneratePdfByOfficeid",
                        type: 'GET',

                        data: {
                            ActionTypeCode: actioncode,
                            Officeid: ddOfficeId,
                            OfficeName: OfficeName,
                            DocumenttypeSelected: DocumenttypeSelected,
                            ConstituencyId: Constituency,
                            WithDetails: WithDetails
                        },
                        success: function (data) {
                            if (data) {
                                var value = "PdfbyOfficeId.pdf";
                                window.open("/Notices/OnlineMemberQuestions/DownloadPDF?parameter=" + value, "_blank");
                                $("#loader-wrapper").hide();
                            } else { alert("error"); }
                        },
                        error: function (xhr, ajaxOptions, thrownError) {
                            alert(xhr.responseText);
                            alert(thrownError);
                        }
                    });
                }

            }
        });
    }

    function EditMlaDairy(ID) {
        $('#loginModaldispatchSearchEditbody').html('');
        var pathurl = '/References/EditMlaDispatchForm';
        $.ajax({
            type: "GET",
            url: pathurl,
            data: { ID: ID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                $("#loader-wrapper").hide();
                if (data) {
                    $("#loginModaldispatchSearchEdit").css("display","block");
                    $('#loginModaldispatchSearchEditbody').html(data);
                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            },
            complete: function (results) {
                $('#loader-wrapper').hide();
            }
        });
    }


    function closedispatchEdit() {
        $("#loginModaldispatchSearchEdit").css("display", "none");
        $('#loginModaldispatchSearchEditbody').html('');
    }


</script>