<head>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/responsive.bootstrap.min.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.4.1.js"></script>
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jszip.min.js"></script>
    <script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
    <script src="~/Scripts/datatables/vfs-fonts.js"></script>
    <script src="~/Scripts/datatables/buttons.print.min.js"></script>
    <script src="~/Scripts/datatables/buttons.html5.min.js"></script>

    <script>


    $(document).ready(function () {

       // $("#listdiv").css("display", "block");
      //  GetAgendaDate();
        showdepartment();

        DiaryDocument();
        BindActionStatusMladiary();
        ShowButton();
        var Text = "Files Total Diary: " + "@Totaldiary";
        $('#selected').text(Text);



        $("#Pendency").hide();
        $('#SinceLabel').hide();

        $("#chkDiaryRef").click(function () {
            var diaryvalue = "Ref";
            $("#diarydispatchValue").val(diaryvalue);
        });

        $("#chkDiaryAction").click(function () {
            var diaryvalue = "Act";
            $("#diarydispatchValue").val(diaryvalue);

        });

    });

        function lisfunction() {
         
            var reffiletype = $("#reffiletype").val();
            if (reffiletype == "R") { reffiletype = "Letter"; }
            else { reffiletype = "File"; }
            var radiovalue = document.querySelector('input[name="radio_list"]:checked').value;
        if (radiovalue == "List") {
            var deptid = $("#DiaryDepartment").val();
            if (deptid != '') {
                GetDataForDiaryN();
            } else {
                GetDataForDiary();
            }

                $("#listdiv").css("display", "block");
                $("#statusdiv").css("display", "none");
                $("#typediv").css("display", "none");
                $("#officediv").css("display", "none");
            }
            else if (radiovalue == "Status") {
            var deptid = $("#DiaryDepartment").val();
            if (deptid != '') {
                GetDataForDiaryStatusN();
            } else {
                GetDataForDiaryStatus(reffiletype);
            }
               // GetDataForDiaryStatus();
                $("#statusdiv").css("display", "block");
                $("#listdiv").css("display", "none");
                $("#typediv").css("display", "none");
                $("#officediv").css("display", "none");
            }
            else if (radiovalue == "Office") {
                var deptid = $("#DiaryDepartment").val();
                 if (deptid != '') {
                    GetDataForDiaryOfficeN();
                    $("#statusdiv").css("display", "none");
                    $("#listdiv").css("display", "none");
                    $("#typediv").css("display", "none");
                    $("#officediv").css("display", "block");
                } else {
                    alert("Select Department.");
                    $("input[name=radio_list][value='Status']").prop('checked', true);
                }


            }
            else if (radiovalue == "Type") {
            var deptid = $("#DiaryDepartment").val();
            if (deptid != '') {
                GetDataForDiaryTypeN();
            } else {
                GetDataForDiaryType();
            }

                $("#typediv").css("display", "block");
                $("#statusdiv").css("display", "none");
                $("#listdiv").css("display", "none");
                $("#officediv").css("display", "none");
            }
        }

        function showdepartment() {

            var Deptid = "";
             var sitename = '@SiteName';
        var isapex = "@Session["isApex"]";
            $('#DiaryDepartment').empty().append('<option selected="selected" value="">-- select --</option>');
            if (sitename == 'MC') {
                 if (isapex == "1") {

                 } else {
                     $('#DiaryDepartment').empty();
                     var sessdept = '@CurrentSession.DeptID';
                     Deptid = sessdept;

                     $("#DiaryDepartment").prop("disabled", true);
                    setTimeout(() => {
                        getoffices();
                        GetDataForDiaryOfficeN();
                        $("#loader-wrapper").hide();
                    }, 2000);

                }
            }


                var type = 'Diary';
                      var DiaryDepartment = $("#DiaryDepartment");
                      //DiaryDepartment.empty().append('<option selected="selected" value="">-- select --</option>');

                            $.ajax({
                            type: "GET",
                                url: '@Url.Action("GetDairyDispatchDepartments", "References")', //  GetDocumentType
                            datatype: "Json",
                                data: { type: type, deptid: Deptid },
                                success: function (data) {

                            $.each(data, function () {
                                DiaryDepartment.append($("<option></option>").val(this['deptId']).html(this['deptname']));
                            });
                                }

                            });




        }

        function getoffices() {

        var id = $("#DiaryDepartment").val();
        var DiaryoffId = $("#DiaryoffId");
        DiaryoffId.empty().append('<option selected="selected" value="">-- select --</option>');
        $('#DiaryoffId').empty().append('<option selected="selected" value="">-- select --</option>');
            $.ajax({
                type: "GET",
                url: '@Url.Action("GetOfficebyDepartmentId", "References")',
                datatype: "Json",
                data: { deptid: id },
                success: function (data) {
                    DiaryoffId.empty().append('<option selected="selected" value="">-- select --</option>');

                    $.each(data, function (index, value) {
                        $('#DiaryoffId').append('<option value="' + value.id + '">' + value.name + '</option>');

                    });
                }
            });
        }

    function DiaryDocument() {
            var DiaryDocument = $("#DiaryDocument");
            DiaryDocument.empty().append('<option selected="selected" value="">-- select --</option>');
        $('#DiaryDocument').empty().append('<option selected="selected" value="">-- select --</option>');
                    $.ajax({
                    type: "GET",
                        url: '@Url.Action("GetDiaryDocumentTypeList", "References")', //  GetDocumentType
                    datatype: "Json",
                        data: { reftype: "F" },
                        success: function (data) {

                            DiaryDocument.empty().append('<option selected="selected" value="">-- select --</option>');
                    $.each(data, function () {
                        DiaryDocument.append($("<option></option>").val(this['DocmentType']).html(this['DocumentTypeName']));
                    });
                        }

                    });
        }

    function statusvalue() {
            var status = '10';
        var statusn = $("#StatusListMla").val();
            if (statusn != '') {
                status = statusn
            }
            else {
                status = '10'
        }
            return status;
        }

        function change() {
            var reffiletype = $("#reffiletype").val();
            if (reffiletype == "R") { reffiletype = "Letter"; }
            else { reffiletype = "File"; }
