                        e.content = e.content.replace(/font-family:\s*([^;]*);/g, function (match, fontFamily) {
                            if (fontFamily.toLowerCase().indexOf('asees') !== -1 || fontFamily.toLowerCase().indexOf('joy') !== -1) {
                                return '';
                            }
                            return match;
                        });
                    }
                });

                editor.on('SetContent', function (e) {
                    try {
                        var doc = editor.getDoc();
                        if (doc && doc.body) {
