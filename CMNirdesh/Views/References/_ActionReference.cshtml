<script>
    function printActionAndReferenceDetails() {
        try {
            // 1. Prepare Block 1: Actions Taken (cloned directly from DOM)
            var $actionsClone = $('#divDetails, #view_' + ('@Model.RefId') + ' #divDetails').first().clone();
            if ($actionsClone.length === 0 || $actionsClone.find('li').length === 0) {
                $actionsClone = $('#ulnoting').clone();
            }
            $actionsClone.find('button, input, select, .fa-unlock, .fa-lock, .fa-pencil, .ace-icon, script').remove();
            $actionsClone.find('a[href*="BlobStorage"], a#actionlink').each(function () {
                var href = $(this).attr('href');
                var filename = href ? href.split('/').pop() : 'Attachment';
                $(this).replaceWith('<span class="note-enclosure"><strong>Enclosure:</strong> ' + filename + '</span>');
            });
            var notesHtml = '';
            if ($actionsClone.length > 0 && $actionsClone.find('li').length > 0) {
                notesHtml = $actionsClone.html();
            } else {
                notesHtml = '<div style="color: #64748b; font-style: italic; padding: 6px 0;">No actions taken recorded.</div>';
            }

            // 2. Extract Block 1: Subject
            var subjectContent = ($('#SpanSubject').text() || '').trim();
            if (!subjectContent) {
                subjectContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Subject ?? Model.SubjectPB ?? ""))'.trim();
            }
            if (!subjectContent) {
                subjectContent = ($('#subjectforedit').val() || '').trim();
            }
            if (!subjectContent) {
                subjectContent = '<span style="color:#64748b; font-style:italic;">No subject specified</span>';
            }

            // 3. Extract Block 2: Details
            var detailsContent = ($('#divSubjectDetails').html() || '').trim();
            if (!detailsContent) {
                detailsContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.SubjectDetails ?? Model.SubjectDetailsPB ?? ""))'.trim();
            }
            if (!detailsContent) {
                detailsContent = '<span style="color:#64748b; font-style:italic;">No details recorded</span>';
            }

            // 4. Extract Block 3: Point Of Instruction
            var instructionContent = '';
            var ddlActVal = ($('#ddlactpb option:selected').text() || '').trim();
            if (ddlActVal && ddlActVal !== 'Select' && ddlActVal !== '--Select--') {
                instructionContent = ddlActVal;
            }
            if (!instructionContent) {
                var actTxt = ($('#divLetterNo .txt_value').first().text() || '').trim();
                if (actTxt) {
                    instructionContent = actTxt;
                }
            }
            if (!instructionContent) {
                instructionContent = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ActName ?? ""))'.trim();
            }
            if (!instructionContent) {
                instructionContent = '<span style="color:#64748b; font-style:italic;">Not Specified</span>';
            }

            @{
                string printFromDept = Model.FromDept ?? "";
                string printMeetingDate = "";
                if (!string.IsNullOrEmpty(Model.agendaDate))
                {
                    DateTime mDate;
                    string[] mDateFormats = new string[] { "dd/MM/yyyy", "dd-MM-yyyy", "yyyy-MM-dd", "MM/dd/yyyy", "yyyy/MM/dd", "d/M/yyyy", "d-M-yyyy" };
                    if (DateTime.TryParseExact(Model.agendaDate, mDateFormats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out mDate) ||
                        DateTime.TryParse(Model.agendaDate, out mDate))
                    {
                        printMeetingDate = mDate.ToString("dd-MM-yyyy");
                    }
                    else
                    {
                        printMeetingDate = Model.agendaDate;
                    }
                }
            }

            // Header title from the top bar
            var headerSub = ($('.top-tools h4.form_heading').first().text() || '').trim() || ('ID: #' + ('@Model.RefId' || ''));
            headerSub = headerSub.replace(/\s+/g, ' ');

            // From Office name extraction
            var fromOfficeRaw = '@Html.Raw(HttpUtility.JavaScriptStringEncode(printFromDept))'.trim();
            if (!fromOfficeRaw) {
                fromOfficeRaw = ($('#divMember .txt_value').first().clone().children().remove().end().text() || $('#divMember .txt_value').first().text() || '').trim();
            }
            var fromOfficeDisplay = fromOfficeRaw;

            // Meeting Date extraction
            var meetingDateVal = ($('#meetingDate').val() || '').trim();
            if (!meetingDateVal) {
                meetingDateVal = '@Html.Raw(HttpUtility.JavaScriptStringEncode(printMeetingDate))'.trim();
            }
            if (!meetingDateVal) {
                var domMeeting = $('#hdnMeetingDate').val() || $('#txtMeetingDate').val() || '';
                if (domMeeting) {
                    meetingDateVal = domMeeting.trim();
                }
            }
            if (meetingDateVal) {
                if (meetingDateVal.indexOf('/Date(') !== -1) {
                    var timestamp = parseInt(meetingDateVal.replace(/\/Date\((-?\d+)\)\//, '$1'));
                    if (!isNaN(timestamp)) {
                        var d = new Date(timestamp);
                        meetingDateVal = String(d.getDate()).padStart(2, '0') + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + d.getFullYear();
                    }
                } else if (/^\d{4}-\d{2}-\d{2}/.test(meetingDateVal)) {
                    var parts = meetingDateVal.split('T')[0].split('-');
                    meetingDateVal = parts[2] + '-' + parts[1] + '-' + parts[0];
                }
            }

            // Generated on date formatting for footer
            var now = new Date();
            var day = String(now.getDate()).padStart(2, '0');
            var month = String(now.getMonth() + 1).padStart(2, '0');
            var year = now.getFullYear();
            var hours = now.getHours();
            var minutes = String(now.getMinutes()).padStart(2, '0');
            var ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            var strHours = String(hours).padStart(2, '0');
            var genDateStr = day + '-' + month + '-' + year + ' ' + strHours + ':' + minutes + ' ' + ampm;

            var printDoc = `
                <!DOCTYPE html>
                <html lang="en">
                <head>
                    <meta charset="utf-8" />
                    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
