    }

    .action-attachment-controls:has(.file_name12:not(:empty)) #actionFileChip12 {
        display: inline-flex !important;
    }

    .action-attachment-controls:has(.file_name12:not(:empty)) #actionNoFile12 {
        display: none !important;
    }

    /* Preserve Utility Classes & Helpers */
    .hand {
        cursor: pointer;
    }

    .nodelete {
        display: none;
    }

    .refhide {
        display: none;
    }

    .refshow {
        display: block;
    }

    .ColorAdd {
        background-color: #fdeefd !important;
    }

    .table-bordered > :not(caption) > * > * {
