    function openHistoryPopup() {
        $("#HistoryModel").modal('show');

    if ($.fn.DataTable.isDataTable("#tableRefHistory")) {
        $('#tableRefHistory').DataTable().destroy();
    }
    $('#tableRefHistory').html('');
    $('#tbodyRefHistory').html('');

    var refId = $("#RefId").val();

           html = "<thead id='theadPrzt'><tr class='table-heading'><th style ='padding:10px !important; border: 1px solid black;border - collapse: collapse;'>Proposal Description" +
               "</th ></tr ></thead > " +
               "<tbody id='tbodyRefHistory'></tbody>";
           $('#tableRefHistory').append(html);
    $.ajax({
        type: 'GET',
        url: '@Url.Action("getRefHistory", "References")',
        data: { refId: refId },
        //data: { Id: '0', useraction: useraction },
        success: function (data) {
            $('#tbodyRefHistory').html('');
            if (data.length > 0) {
                console.log(data);
                var s_string = ""; var sd_string = "";
                $.each(data, function (i, item) {
                    if (item.Subject != "") {
                        s_string = "<b>Subject:</b> " + item.Subject + "</br>";
                    } else {
                        s_string = "";
                    }

                    if (item.SubjectDetails != "") {
                        sd_string = "<b>Subject Details: </b>" + item.SubjectDetails + "</br>";
                    } else {
                        sd_string = "";
                    }

                    html = "<tr role='row'><td style ='padding:10px !important; border: 1px solid black;border - collapse: collapse;'>" + s_string + sd_string +"</br></br>";
                    html += "<span style='text-align:right;float:right'> Updated On: " + item.ActionTakenDate + "</br> Updated By: " + item.ActionBy + "</span></td>";
                    html += "</tr>";
                    $('#tbodyRefHistory').append(html);
                });
                $('#tableRefHistory').DataTable({
                    paging: true,
                    searching: true,
                    "pageLength": 10,
                    "ordering": false

                });
            }
            else {
                html = "<tr role='row'><td colspan='5'>" +
                    "Data Not available" +
                    "</td>'</tr > ";
                $('#tbodyRefHistory').append(html);
            }
            $("#loader-wrapper").hide();
        },
        error: function () {
            html = "<tr role='row'><td colspan='5'>" +
                "Data Not available" +
                "</td>'</tr > ";
            $('#tbodyRefHistory').append(html);
            $("#loader-wrapper").hide();
        }
    });
}

         function GetIncludedRef() {
             var mainRefid = $("#RefId").val();

        $.ajax({
