        #formActionDiary .remove-btn i,
        .file-chip-remove i {
            font-size: 12px !important;
            line-height: 1 !important;
        }

    /* Progress bar styling */
    .action-upload-progress {
        height: 3px !important;
        margin-top: 3px !important;
        border-radius: 2px !important;
        overflow: hidden !important;
        background-color: #e2e8f0 !important;
        display: none;
    }

    /* CSS :has dynamic toggles */
    .action-attachment-controls:has(.file_name1:not(:empty)) #actionFileChip1 {
        display: inline-flex !important;
    }

    .action-attachment-controls:has(.file_name1:not(:empty)) #actionNoFile1 {
