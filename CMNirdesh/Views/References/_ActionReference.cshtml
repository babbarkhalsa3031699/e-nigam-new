    function decode(value) {
        return String(value)
            .replace(/&amp;quot;/g, '"')
            .replace(/&amp;#39;/g, "'")
            .replace(/&amp;lt;/g, '<')
            .replace(/&amp;gt;/g, '>')
            .replace(/&amp;/g, '&');
    }
    if (typeof str !== 'undefined' && str && $('#code').length) {
        $('#code').text(decode(str));
    }
    


    function BindInclueRef(tableData) {
        $("#IncludeRefTable").DataTable().destroy();
        $("#IncludeRefTable tbody").html('');
        var a = 1;
        var actioncode = '@Model.HideUpdate';

        if (actioncode == "Yes") {
            hideclass = "nodelete";

        } else {
            hideclass = "yesdelete";

        }

        //LG Comments

        var doctype1 = '@Model.DocmentType';

        $.each(tableData, function (index, response) {
            if (doctype1 == '25') { res = response.ResolutionNo } else { res = response.ResolutionNo };

            var LGarray = response.LGComments.split("~");
            var LgString = '';


            var j = 1;
            for (var i = 0; i < LGarray.length; i++) {
                if (LGarray[i] != "") {
                    var ActionBy = LGarray[i].split("::");
                    console.log(LGarray[i])
                    var Desg = ActionBy[1].split(",");

