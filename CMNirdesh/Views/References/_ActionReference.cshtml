                    </style>
                </head>
                <body>
                    <table class="print-layout-table">
                        <thead>
                            <tr>
                                <th>
                                    <div class="print-header">
                                        <div class="print-header-left">
                                            ${headerSub}
                                        </div>
                                        <div class="print-header-center">
                                            ${fromOfficeDisplay}
                                        </div>
                                        <div class="print-header-right">
                                            <strong>Meeting Date:</strong> ${meetingDateVal || 'N/A'}
                                        </div>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>
                                    <div class="print-footer">
                                        <div class="print-footer-left">Digital MC House</div>
                                        <div class="print-footer-right">Generated on ${genDateStr}</div>
                                    </div>
                                </th>
                            </tr>
                        </tfoot>
                        <tbody>
                            <tr>
                                <td>
                                    <!-- 1. Subject -->
                                    <div class="section-card">
                                        <div class="section-header">Subject</div>
                                        <div class="section-body subject-content">
                                            ${subjectContent}
                                        </div>
                                    </div>

                                    <!-- 2. Details -->
                                    <div class="section-card">
                                        <div class="section-header">Details</div>
                                        <div class="section-body details-content">
                                            ${detailsContent}
                                        </div>
                                    </div>

                                    <!-- 3. Point Of Instruction -->
                                    <div class="section-card">
                                        <div class="section-header">Point Of Instruction</div>
                                        <div class="section-body instruction-content">
                                            ${instructionContent}
                                        </div>
                                    </div>

                                    <!-- 4. Noting History -->
                                    <div class="section-card">
                                        <div class="section-header">Comment History</div>
                                        <div class="section-body notes-content">
                                            ${notesHtml}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </body>
                </html>
            `;

            var iframe = document.createElement('iframe');
            iframe.style.position = 'fixed';
            iframe.style.right = '0';
            iframe.style.bottom = '0';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = '0';
            document.body.appendChild(iframe);

            function setupAndPrint(frame) {
                try {
                    var doc = frame.contentWindow.document;
                    var allTables = doc.querySelectorAll('table');
                    for (var t = 0; t < allTables.length; t++) {
                        var tbl = allTables[t];
                        if (tbl.classList.contains('print-layout-table')) {
                            continue;
                        }
                        tbl.removeAttribute('width');
                        tbl.style.width = '100%';
                        tbl.style.maxWidth = '100%';
                        tbl.style.tableLayout = 'fixed';
                        tbl.style.borderCollapse = 'collapse';
                        tbl.style.boxSizing = 'border-box';

                        // Remove colgroups with rigid pixel widths
                        var colgroups = tbl.querySelectorAll('colgroup, col');
                        for (var k = 0; k < colgroups.length; k++) {
                            if (colgroups[k].parentNode) {
                                colgroups[k].parentNode.removeChild(colgroups[k]);
                            }
                        }

                        // Reset negative indents, margins, and inline positioning on ALL inner elements inside the table
                        var inners = tbl.querySelectorAll('p, div, span, pre, li, ol, ul');
                        for (var i = 0; i < inners.length; i++) {
                            var el = inners[i];
                            el.style.maxWidth = '100%';
                            el.style.wordBreak = 'break-word';
                            el.style.overflowWrap = 'anywhere';
                            el.style.whiteSpace = 'normal';
                            el.style.textIndent = '0';
                            el.style.marginLeft = '0';
                            el.style.paddingLeft = '0';
                            if (el.tagName === 'OL' || el.tagName === 'UL') {
                                el.style.listStylePosition = 'inside';
                            }
                            if (el.style.width && parseInt(el.style.width) > 200) {
                                el.style.width = 'auto';
                            }
                        }

                        // Clean all cells
                        var cells = tbl.querySelectorAll('th, td');
                        for (var c = 0; c < cells.length; c++) {
                            var cell = cells[c];
                            cell.removeAttribute('width');
                            if (cell.style.width && parseInt(cell.style.width) > 150) {
                                cell.style.width = '';
                            }
                            cell.style.wordBreak = 'break-word';
                            cell.style.overflowWrap = 'anywhere';
                            cell.style.whiteSpace = 'normal';
                            cell.style.verticalAlign = 'top';
                            cell.style.boxSizing = 'border-box';
                        }

                        // Clean empty spacing tags/paragraphs inside cells that blow up row height
                        var emptyInners = tbl.querySelectorAll('p, div');
                        for (var ep = 0; ep < emptyInners.length; ep++) {
                            var elEmpty = emptyInners[ep];
                            var cleanText = (elEmpty.innerHTML || '').replace(/&nbsp;|<br\s*\/?>|\s/gi, '');
                            if (cleanText === '' && elEmpty.children.length === 0) {
                                elEmpty.style.display = 'none';
                            }
                        }

                        // Identify numbering/serial column and column count
                        var allRows = tbl.querySelectorAll('tr');
                        if (allRows.length > 0) {
                            var firstRow = allRows[0];
                            var firstRowCells = firstRow.children;
                            var colCount = firstRowCells.length;

                            // Check if first column is a numbering/serial column
                            var isNumCol = false;
                            var firstCellTxt = (firstRowCells[0] ? firstRowCells[0].textContent : '').trim();
                            if (/^(no|sr|s\.no|sno|ਲੜੀ|ਸ਼ਰਤ|ਸਰਤ|#|number|sl)/i.test(firstCellTxt) || firstCellTxt.length <= 8) {
                                isNumCol = true;
                            }

                            // Also check sample rows in column 0 to see if they contain digits/numbering
                            var digitCount = 0;
                            var checkRows = Math.min(allRows.length, 6);
                            for (var r = 0; r < checkRows; r++) {
                                var rowCell = allRows[r].children[0];
                                if (rowCell && /^\s*\d+[\.\)]?\s*$/.test(rowCell.textContent.trim())) {
                                    digitCount++;
                                }
                            }
                            if (digitCount >= 2) {
                                isNumCol = true;
                            }

                            // Apply width to columns
                            if (colCount === 2) {
                                if (isNumCol) {
                                    if (firstRowCells[0]) firstRowCells[0].style.width = '12%';
                                    if (firstRowCells[1]) firstRowCells[1].style.width = '88%';
                                } else {
                                    if (firstRowCells[0]) firstRowCells[0].style.width = '50%';
                                    if (firstRowCells[1]) firstRowCells[1].style.width = '50%';
                                }
                            } else if (colCount === 3) {
                                if (isNumCol) {
                                    if (firstRowCells[0]) firstRowCells[0].style.width = '10%';
                                    if (firstRowCells[1]) firstRowCells[1].style.width = '45%';
                                    if (firstRowCells[2]) firstRowCells[2].style.width = '45%';
                                } else {
                                    for (var ci = 0; ci < 3; ci++) {
                                        if (firstRowCells[ci]) firstRowCells[ci].style.width = '33.33%';
                                    }
                                }
                            } else if (colCount === 4) {
                                if (isNumCol) {
                                    if (firstRowCells[0]) firstRowCells[0].style.width = '8%';
                                    if (firstRowCells[1]) firstRowCells[1].style.width = '30%';
                                    if (firstRowCells[2]) firstRowCells[2].style.width = '31%';
                                    if (firstRowCells[3]) firstRowCells[3].style.width = '31%';
                                }
                            } else if (colCount === 5) {
                                if (isNumCol) {
                                    if (firstRowCells[0]) firstRowCells[0].style.width = '8%';
                                    if (firstRowCells[1]) firstRowCells[1].style.width = '24%';
                                    if (firstRowCells[2]) firstRowCells[2].style.width = '20%';
                                    if (firstRowCells[3]) firstRowCells[3].style.width = '18%';
                                    if (firstRowCells[4]) firstRowCells[4].style.width = '30%';
                                }
                            }

                            // For all cells in the numbering column, enforce center alignment, padding, and zero indent
                            if (isNumCol) {
                                for (var rIdx = 0; rIdx < allRows.length; rIdx++) {
                                    var c0 = allRows[rIdx].children[0];
                                    if (c0) {
                                        c0.style.textAlign = 'center';
                                        c0.style.verticalAlign = 'top';
                                        var c0Children = c0.querySelectorAll('*');
                                        for (var ch = 0; ch < c0Children.length; ch++) {
                                            c0Children[ch].style.textAlign = 'center';
                                            c0Children[ch].style.textIndent = '0';
                                            c0Children[ch].style.marginLeft = '0';
                                            c0Children[ch].style.paddingLeft = '0';
                                        }
                                    }
                                }
                            }
                        }
                    }
                } catch (tblEx) {
                    console.warn("Table cleanup error:", tblEx);
                }

                frame.contentWindow.focus();
                setTimeout(function () {
                    frame.contentWindow.print();
                    setTimeout(function () {
                        if (frame.parentNode) {
                            frame.parentNode.removeChild(frame);
                        }
                    }, 1000);
                }, 300);
            }

            var printed = false;
            iframe.onload = function () {
                if (!printed) {
                    printed = true;
                    setupAndPrint(iframe);
                }
            };

            if ('srcdoc' in iframe) {
                iframe.srcdoc = printDoc;
                setTimeout(function () {
                    if (!printed) {
                        printed = true;
                        setupAndPrint(iframe);
                    }
                }, 500);
            } else {
                var doc = iframe.contentWindow.document;
                doc.open('text/html', 'replace');
                doc.charset = 'UTF-8';
                doc.write(printDoc);
                doc.close();
                setTimeout(function () {
                    if (!printed) {
                        printed = true;
                        setupAndPrint(iframe);
                    }
                }, 300);
            }

        } catch (ex) {
            console.error("Print error:", ex);
            alert("Unable to print: " + ex.message);
        }
    }

    function convertNumberToWordsIndian(numStr) {
        if (!numStr || numStr.toString().trim() === "") return "";
        numStr = numStr.toString().trim();
        if (isNaN(numStr)) return "";

        var parts = numStr.split('.');
        var integerPart = parts[0];
        var decimalPart = parts.length > 1 ? parts[1].substring(0, 2) : "";

        integerPart = integerPart.replace(/^0+/, "");
        if (integerPart === "" && (decimalPart === "" || decimalPart === "00" || decimalPart === "0")) {
            return "Zero Rupees Only";
        }

        var a = ['', 'One ', 'Two ', 'Three ', 'Four ', 'Five ', 'Six ', 'Seven ', 'Eight ', 'Nine ', 'Ten ', 'Eleven ', 'Twelve ', 'Thirteen ', 'Fourteen ', 'Fifteen ', 'Sixteen ', 'Seventeen ', 'Eighteen ', 'Nineteen '];
        var b = ['', '', 'Twenty ', 'Thirty ', 'Forty ', 'Fifty ', 'Sixty ', 'Seventy ', 'Eighty ', 'Ninety '];

        function convertGroupOfTwo(n) {
            n = parseInt(n, 10);
            if (n === 0) return '';
            if (n < 20) return a[n];
            return b[Math.floor(n / 10)] + a[n % 10];
        }

        function convertGroupOfThree(n) {
            var str = '';
            var num = parseInt(n, 10);
            if (num === 0) return '';
            var hundreds = Math.floor(num / 100);
            var rest = num % 100;
            if (hundreds > 0) {
                str += a[hundreds] + 'Hundred ';
            }
            if (rest > 0) {
                str += convertGroupOfTwo(rest);
            }
            return str;
        }

        var words = '';

        if (integerPart !== "") {
            var len = integerPart.length;
            if (len > 15) {
                return "Amount is too large";
            }

            var lastThree = integerPart.substring(Math.max(0, len - 3));
            var remaining = integerPart.substring(0, Math.max(0, len - 3));
            var hundredsStr = convertGroupOfThree(lastThree);

            var units = ['Thousand ', 'Lakh ', 'Crore ', 'Arab ', 'Kharab '];
            var unitIndex = 0;
            var partsArr = [];

            while (remaining.length > 0) {
                var chunk = remaining.substring(Math.max(0, remaining.length - 2));
                remaining = remaining.substring(0, Math.max(0, remaining.length - 2));
                var chunkNum = parseInt(chunk, 10);
                if (chunkNum > 0) {
                    var chunkWords = convertGroupOfTwo(chunkNum) + units[unitIndex];
                    partsArr.unshift(chunkWords);
                }
                unitIndex++;
            }

            words = partsArr.join('') + hundredsStr;
            words = words.trim();
            if (words !== "") {
                words = words + " Rupees";
            }
        }

        if (decimalPart !== "") {
            if (decimalPart.length === 1) decimalPart += "0";
            var paiseNum = parseInt(decimalPart, 10);
            if (paiseNum > 0) {
                var paiseWords = convertGroupOfTwo(paiseNum).trim() + " Paise";
                if (words !== "") {
                    words += " and " + paiseWords;
                } else {
                    words = paiseWords;
                }
            }
        }

        if (words === "") return "";
        return words.trim() + " Only";
    }

    function updateDisplayAmountWords() {
        var text = $("#spamProposalAmount").text();
        if (text && text.trim() !== "") {
            var words = convertNumberToWordsIndian(text.trim());
            if (words) {
                $("#spamProposalAmountWords").text("(" + words + ")");
            } else {
                $("#spamProposalAmountWords").text("");
            }
        } else {
            $("#spamProposalAmountWords").text("");
        }
    }

    function updateEditAmountWords() {
        var val = $("#amountforedit").val();
        var container = $("#amountforeditWords");
        var textSpan = $("#amountforeditWordsText");

        if (!val || val.toString().trim() === "") {
            container.hide();
            textSpan.text("");
            return;
        }

        var inWords = convertNumberToWordsIndian(val);
        if (inWords) {
            textSpan.text(inWords);
            container.show();
        } else {
            container.hide();
            textSpan.text("");
        }
    }

    try {
        updateDisplayAmountWords();
        if ($.fn.multipleSelect && $('#ddlWardAction').length) {
            $('#ddlWardAction').multipleSelect({
                placeholder: 'Wards',
                width: '100%'
            });
            $('#ddlWardAction').multipleSelect('disable');
        }
    } catch (e) {
        console.warn("Ward/Amount init:", e);
    }
</script>