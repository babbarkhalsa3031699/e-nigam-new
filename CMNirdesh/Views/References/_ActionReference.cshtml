                            color: #0f172a;
                            background: #fff;
                            margin: 0;
                            padding: 0;
                            font-size: 12.5px;
                            line-height: 1.55;
                            width: 100% !important;
                            max-width: 100% !important;
                            -webkit-print-color-adjust: exact !important;
                            print-color-adjust: exact !important;
                        }

                        /* Outer print layout table to repeat header and footer on EVERY page natively */
                        table.print-layout-table {
                            width: 100% !important;
                            max-width: 100% !important;
                            table-layout: fixed !important;
                            border: none !important;
                            border-collapse: collapse !important;
                            border-spacing: 0 !important;
                            margin: 0 !important;
                            padding: 0 !important;
                            background: transparent !important;
                        }
                        table.print-layout-table > thead {
                            display: table-header-group !important;
                        }
                        table.print-layout-table > tbody {
                            display: table-row-group !important;
                        }
                        table.print-layout-table > tfoot {
                            display: table-footer-group !important;
                        }
                        table.print-layout-table > thead > tr,
                        table.print-layout-table > tbody > tr,
                        table.print-layout-table > tfoot > tr {
                            border: none !important;
                            background: transparent !important;
                            background-color: transparent !important;
                        }
                        table.print-layout-table > thead > tr > th {
                            border: none !important;
                            background: transparent !important;
                            background-color: transparent !important;
                            padding: 0 0 10px 0 !important;
                            margin: 0 !important;
                            font-weight: normal !important;
                            text-align: left !important;
                        }
                        table.print-layout-table > tbody > tr > td {
                            border: none !important;
                            background: transparent !important;
                            background-color: transparent !important;
                            padding: 0 !important;
                            margin: 0 !important;
                        }
                        table.print-layout-table > tfoot > tr > th {
                            border: none !important;
                            background: transparent !important;
                            background-color: transparent !important;
                            padding: 10px 0 0 0 !important;
                            margin: 0 !important;
                            font-weight: normal !important;
                            text-align: left !important;
                        }

                        .print-header {
                            border-bottom: 2px solid #0284c7;
                            padding-bottom: 5px;
                            margin-bottom: 0;
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            font-size: 12px;
                            width: 100% !important;
                            box-sizing: border-box !important;
                        }
                        .print-header-left {
                            flex: 1;
                            text-align: left;
                            font-size: 12.5px;
                            font-weight: 600;
                            color: #0284c7;
                            word-break: break-word;
                        }
                        .print-header-center {
                            flex: 1.2;
                            text-align: center;
                            font-size: 12px;
                            font-weight: 600;
                            color: #0f172a;
                            word-break: break-word;
                            padding: 0 8px;
                        }
                        .print-header-right {
                            flex: 1;
                            text-align: right;
                            font-size: 11.5px;
                            color: #475569;
                            white-space: nowrap;
                        }

                        /* Footer inside tfoot - natively placed on every page, mathematically impossible to overlap */
                        .print-footer {
                            border-top: 1px solid #cbd5e1;
                            padding-top: 5px;
                            padding-bottom: 2px;
                            display: flex;
                            justify-content: space-between;
                            align-items: center;
                            font-size: 11px;
                            color: #64748b;
                            background: #ffffff;
                            width: 100% !important;
                            box-sizing: border-box !important;
                        }
                        .print-footer-left {
                            font-weight: 700;
                            color: #0f172a;
                        }
                        .print-footer-right {
                            font-weight: 500;
                            color: #64748b;
                        }

                        .section-card {
                            margin-bottom: 8px;
                            background: #fff;
