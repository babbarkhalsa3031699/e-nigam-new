                                        @Html.DropDownListFor(m => m.ActionCodeMulti, Model.ActionTypeList_Ref, "Select Action", new { @id = "DdlActionType_Multi", @tabindex = "2", @class = "DdlClass" })

                                    </div>
                                </div>

                                <div id="divRemrks" class="remark_desig" style="margin-top:5px;">
                                    <div class="fotm_lbl">Action Remark: </div>
                                    <div class="txt_editor">
                                        <div class="Yellow-editor">
                                            @Html.TextAreaFor(m => m.ActionDescriptionMulti, new { @id = "ActionDescription_Multi", @tabindex = "4", @Class = "form-control" })
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-8 col-lg-8 col-xl-8 mb-2 row" style="margin-top:10px;">
                                    <div class="col-md-12 col-lg-12 col-xl-12">
                                        <div class="fotm_lbl div_inline">Action Attachment:</div>

                                    </div>
                                    <div class="input-group col-md-2 col-lg-2 col-xl-2 pull-left">
                                        <label class="lbl_file">
                                            <span>
                                                <input id="fileupload12" type="file" tittle=" " name="fileupload12" accept=".pdf" onclick="fileupload()">
                                            </span>
                                        </label>
                                    </div>

                                    <div class="col-md-6 col-lg-6 col-xl-6">
                                        <div class="d-flex align-items-center gap-5">
                                            <div>
                                                <a href="#" id="afile_nameEn12" target="_blank">
                                                    <span id="file_name12" class="file_name12"></span>
                                                </a>
                                            </div>
                                            <div>
                                                <span id="removefileupload12" class="remove-btn" style="display: none; color: red; width:28px;" onclick="removefileupload2()"><i class="far fa-times"></i></span>
                                            </div>
                                        </div>

                                        <span class="file_size12"></span> &nbsp;

                                    </div>

                                </div>
                                <div class="col-md-4">
                                    <div class="profile-info-row">


                                        <button class="btn btn-primary mt-3" type="button" id="btnSave_Multi" title="Send" onclick="return SaveMulti()" tabindex="4">
                                            <i class="ace-icon fa fa-floppy-o align-top bigger-140"></i>
                                            Submit
                                        </button>

                                        @Html.HiddenFor(m => m.BtnCaption)
                                        @Html.HiddenFor(m => m.PaperEntryType)
                                        @Html.HiddenFor(m => m.IsEnclosureFile)
                                        @Html.HiddenFor(m => m.IsFile)
                                        @Html.HiddenFor(m => m.MultiUpdate)
                                        @Html.HiddenFor(m => m.Remarks)

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

