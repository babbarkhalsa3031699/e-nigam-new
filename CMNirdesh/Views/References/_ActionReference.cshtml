        } else {
            // Quick-expand / restore Left panel
            var restoreWidth = lastPanelOneWidth || 42;
            if (restoreWidth < 20) restoreWidth = 42;
            if (restoreWidth > 78) restoreWidth = 42;
            $panelOne.css({
                "width": restoreWidth + "%",
                "flex-basis": restoreWidth + "%",
                "min-width": "",
                "max-width": "",
                "padding-left": "",
                "padding-right": "",
                "overflow": "",
                "border": "",
                "display": "",
                "height": "",
                "flex": ""
            });
            $panelTwo.css({
                "width": (100 - restoreWidth) + "%",
                "flex-basis": (100 - restoreWidth) + "%",
                "display": "",
                "height": "",
                "flex": ""
            });
            $("#floatButton").css("left", restoreWidth + "%");
            $("#PannelId").val(2);
        }
    }

    function initPanelSplitter() {
        var $divider = $("#panelDivider");
        var $container = $("#panelContainer");
        var $panelOne = $(".panel.one");
        var $panelTwo = $(".panel.two");

        // Clean any leftover inline display, height, or flex from panels
        $panelOne.add($panelTwo).css({ "display": "", "height": "", "flex": "" });

        // Unbind any legacy handlers attached by jquery.slider.js or previous inits
        $divider.off("mousedown.panelSplitter touchstart.panelSplitter mousedown touchstart");
        $container.off("mousemove touchmove");

        $divider.on("mousedown.panelSplitter touchstart.panelSplitter", function (e) {
            // If user clicked directly on quick-collapse arrow buttons, do not drag
            if ($(e.target).closest(".sliderLeft, .sliderRight").length > 0) {
                return;
            }

            e.preventDefault();
            var isDragging = true;

            $container.addClass("is-resizing");
            $divider.addClass("is-resizing");
            $("iframe").css("pointer-events", "none");
            $("body").css({ "user-select": "none", "cursor": "col-resize" });

            var containerOffset = $container.offset().left;
            var containerWidth = $container.width();

            function onMove(evt) {
                if (!isDragging) return;

                var clientX = evt.pageX;
                if (typeof clientX === "undefined" && evt.originalEvent && evt.originalEvent.touches && evt.originalEvent.touches.length > 0) {
                    clientX = evt.originalEvent.touches[0].pageX;
                }
                if (typeof clientX === "undefined" || isNaN(clientX)) return;

                var relativeX = clientX - containerOffset;
                var pct = (relativeX / containerWidth) * 100;

                // Enforce reasonable min-width boundaries (min 250px left, min 280px right)
                var minLeftPct = Math.max(18, (250 / containerWidth) * 100);
                var maxLeftPct = Math.min(80, ((containerWidth - 280) / containerWidth) * 100);

                if (pct < minLeftPct) pct = minLeftPct;
                if (pct > maxLeftPct) pct = maxLeftPct;

                // Strictly update width and flex-basis as percentages.
                // Never write display, height, or flex: 0 0 auto inline.
                $panelOne.css({
                    "width": pct + "%",
                    "flex-basis": pct + "%",
                    "display": "",
                    "height": "",
                    "flex": ""
                });
                $panelTwo.css({
                    "width": (100 - pct) + "%",
                    "flex-basis": (100 - pct) + "%",
                    "display": "",
                    "height": "",
                    "flex": ""
                });

                $("#floatButton").css("left", pct + "%");
                lastPanelOneWidth = pct;
                $("#PannelId").val(2);
            }

            function onEnd() {
                if (!isDragging) return;
                isDragging = false;

                $container.removeClass("is-resizing");
                $divider.removeClass("is-resizing");
                $("iframe").css("pointer-events", "");
                $("body").css({ "user-select": "", "cursor": "" });

                $(document).off("mousemove.panelSplitter touchmove.panelSplitter", onMove);
                $(document).off("mouseup.panelSplitter touchend.panelSplitter", onEnd);
            }

            $(document).on("mousemove.panelSplitter touchmove.panelSplitter", onMove);
            $(document).on("mouseup.panelSplitter touchend.panelSplitter", onEnd);
        });
    }

    function initActionAttachmentSync() {
        function syncUI(nameId, chipId, noFileId, removeId) {
            var $name = $('#' + nameId);
            var $chip = $('#' + chipId);
            var $noFile = $('#' + noFileId);
            var hasText = ($name.text() || '').trim().length > 0;
            if (hasText) {
                $chip.css('display', 'inline-flex');
                $noFile.hide();
            } else {
                $chip.hide();
                $noFile.show();
            }
        }

        function bindObserver(nameId, chipId, noFileId, removeId) {
            syncUI(nameId, chipId, noFileId, removeId);
            var el = document.getElementById(nameId);
            if (el && window.MutationObserver) {
                var obs = new MutationObserver(function () {
                    syncUI(nameId, chipId, noFileId, removeId);
                });
                obs.observe(el, { childList: true, characterData: true, subtree: true });
            }
            var remEl = document.getElementById(removeId);
            if (remEl && window.MutationObserver) {
                var obsRem = new MutationObserver(function () {
                    syncUI(nameId, chipId, noFileId, removeId);
                });
                obsRem.observe(remEl, { attributes: true, attributeFilter: ['style', 'class'] });
            }
        }

        bindObserver('file_name1', 'actionFileChip1', 'actionNoFile1', 'removefileupload1');
        bindObserver('file_name12', 'actionFileChip12', 'actionNoFile12', 'removefileupload12');
    }


