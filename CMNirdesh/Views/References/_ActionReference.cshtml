        // Helper function to sanitize pasted text and tables for clean A4 alignment
        function sanitizeA4ContentNodeAction(node) {
            if (!node) return;

            // 1. Sanitize all tables: enforce strict A4 width containment and clean borders
            var tables = node.querySelectorAll('table');
            for (var i = 0; i < tables.length; i++) {
                var tbl = tables[i];
                tbl.removeAttribute('width');
                tbl.removeAttribute('height');

                tbl.style.width = '100%';
                tbl.style.maxWidth = '100%';
                tbl.style.tableLayout = 'fixed';
                tbl.style.borderCollapse = 'collapse';
                tbl.style.boxSizing = 'border-box';
                tbl.style.margin = '14px 0';
                tbl.style.marginLeft = 'auto';
                tbl.style.marginRight = 'auto';

                if (!tbl.getAttribute('border')) {
                    tbl.setAttribute('border', '1');
                }

                var colElements = tbl.querySelectorAll('col, colgroup');
                for (var c = 0; c < colElements.length; c++) {
                    colElements[c].removeAttribute('width');
                    colElements[c].style.width = '';
                    colElements[c].style.minWidth = '';
                    colElements[c].style.maxWidth = '';
                }

                var rowElements = tbl.querySelectorAll('tr');
                for (var r = 0; r < rowElements.length; r++) {
                    rowElements[r].removeAttribute('height');
                    rowElements[r].style.height = '';
                }

                var cells = tbl.querySelectorAll('th, td');
                for (var j = 0; j < cells.length; j++) {
                    var cell = cells[j];
                    cell.removeAttribute('width');
                    cell.removeAttribute('height');
                    cell.style.width = '';
                    cell.style.minWidth = '';
                    cell.style.maxWidth = '';
                    cell.style.height = '';

                    cell.style.border = '1px solid #94a3b8';
                    cell.style.padding = '8px 10px';
                    cell.style.wordBreak = 'break-word';
                    cell.style.overflowWrap = 'anywhere';
                    cell.style.whiteSpace = 'normal';
                    cell.style.verticalAlign = 'top';
                    cell.style.boxSizing = 'border-box';

                    if (cell.tagName.toLowerCase() === 'th') {
                        cell.style.backgroundColor = '#f8fafc';
                        cell.style.fontWeight = '600';
                    }
                }
            }

            // 2. Sanitize all text elements: clean typography, strip messy styles & align
            var allEls = node.querySelectorAll('*');
            for (var k = 0; k < allEls.length; k++) {
                var el = allEls[k];
                var tag = el.tagName.toLowerCase();

                // Clean Microsoft Word class names
                if (el.className && typeof el.className === 'string') {
                    var cleanClass = el.className.replace(/\bMso\w+\b/g, '').trim();
                    if (cleanClass) {
                        el.className = cleanClass;
                    } else {
                        el.removeAttribute('class');
                    }
                }

                // Disallow Asees/Joy fonts; normalize other non-Unicode fonts to document font
                if (el.style.fontFamily) {
                    var ff = el.style.fontFamily.toLowerCase();
                    if (ff.indexOf('asees') !== -1 || ff.indexOf('joy') !== -1) {
                        el.style.fontFamily = '';
                    } else if (ff.indexOf('raavi') !== -1) {
                        el.style.fontFamily = 'Raavi, "Segoe UI", sans-serif';
                    } else {
                        el.style.fontFamily = '';
                    }
                }

                // Strip fixed font-size and line-height so standard A4 styling applies
                if (tag !== 'h1' && tag !== 'h2' && tag !== 'h3' && tag !== 'h4') {
                    el.style.fontSize = '';
                }
                el.style.lineHeight = '';

                // Strip unwanted background highlights (preserve table headers)
                if (tag !== 'th') {
                    el.style.backgroundColor = '';
                    el.style.background = '';
                }

                // Clean paragraph/block margins and alignments
                if (tag === 'p' || tag === 'div') {
                    el.style.marginTop = '';
                    el.style.marginBottom = '';
                    if (el.style.textAlign === 'left' || el.style.textAlign === 'justify') {
                        el.style.textAlign = '';
                    }
                }
            }
        }

