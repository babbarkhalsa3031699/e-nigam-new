    function ShowSD(id) {
        $("#SD_" + id).toggle();
        $(".LG_" + id).toggle();
        var IC = $("#Icon_" + id).attr('class');

        if (IC == 'fa fa-plus-square') {
            $("#Icon_" + id).removeClass("fa fa-plus-square");
            $("#Icon_" + id).addClass("fa fa-minus-square");
        } else {
            $("#Icon_" + id).removeClass("fa fa-minus-square");
            $("#Icon_" + id).addClass("fa fa-plus-square");
        }


    }


    function ShowAllSD() {


        var IC = $("#IconShowAll").attr('class');
        if (IC == 'fa fa-plus-square bigger-120 hand') {
            $("#IconShowAll").removeClass("fa fa-plus-square bigger-120 hand");
            $("#IconShowAll").addClass("fa fa-minus-square bigger-120 hand");

            $('[id^=Icon_]').removeClass("fa fa-plus-square");
            $('[id^=Icon_]').addClass("fa fa-minus-square");
            $(".SDHide").show();
            $(".LGShow").hide();

        } else {
            $("#IconShowAll").removeClass("fa fa-minus-square bigger-120 hand");
            $("#IconShowAll").addClass("fa fa-plus-square bigger-120 hand");
            $('[id^=Icon_]').removeClass("fa fa-minus-square");
            $('[id^=Icon_]').addClass("fa fa-plus-square");
            $(".SDHide").hide();
            $(".LGShow").show();

        }

    }


