    function lisfunction() {

        var radiovalue = document.querySelector('input[name="SentType"]:checked').value;  var radiovalue = document.querySelector('input[name="SentType"]:checked').value;

        if (radiovalue == "FromOffice") {
            $("#ddlfromOffice").show();
            $("#ddlToOffice").hide();
            $("#ddlfromUser").show();
            $("#ddlmlaOffice").hide();

            $('#ddlMlaUser').multipleSelect('destroy');
            $("#ddlMlaUser").hide();

            $("#ddlfromUser").multipleSelect({
                columns: 1,
                filter: true,
                maxHeight: 200,
                placeholder: 'Select User',
            });
            //$('#ddldep').multipleSelect('refresh');
            $('#ddlToUser').multipleSelect('destroy');
            $("#ddlToUser").hide();
        }
        else if (radiovalue == "ToOffice") {
            $("#ddlfromOffice").hide();
            $("#ddlToOffice").show();

            $('#ddlfromUser').multipleSelect('destroy');
            $("#ddlfromUser").hide();

            $("#ddlmlaOffice").hide();
            $('#ddlMlaUser').multipleSelect('destroy');
            $("#ddlMlaUser").hide();

            $("#ddlToUser").show();
            $("#ddlToUser").multipleSelect({
                columns: 1,
                filter: true,
                maxHeight: 200,

                placeholder: 'Select User',
            });
        }
        else if (radiovalue == "MLAOffice") {
            $("#ddlfromOffice").hide();
            $("#ddlToOffice").hide();
            $('#ddlfromUser').multipleSelect('destroy');
            $("#ddlfromUser").hide();

           $("#ddlmlaOffice").show();
