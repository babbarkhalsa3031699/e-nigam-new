    function decode(value) {
        return String(value)
            .replace(/&amp;quot;/g, '"')
            .replace(/&amp;#39;/g, "'")
            .replace(/&amp;lt;/g, '<')
            .replace(/&amp;gt;/g, '>')
            .replace(/&amp;/g, '&');
    }
    if (typeof str !== 'undefined' && str && $('#code').length) {
        $('#code').text(decode(str));
    }


