    function UpdatedocumentType() {
        var refid = @Model.RefId;
         var documentid = $('#DocumentTypeNameChange').val();

        if (documentid == null || documentid == "" || documentid == undefined) {
            alert("Please select Document Type First");
            return false;
        }
        if (refid == null || refid == "" || refid == undefined) {
            alert("Some Error Occured Try Again");
            return false;
        }

        var formData = new FormData();
        formData.append("refid", refid);
        formData.append("documentid", documentid);
        if (confirm("Are you sure you want to update?")) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateDiaryDocument", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {
                        $("#DocumentTypeName").text($("#doctype option:selected").text());
                        $("#editDoctypebox").css("display", "none");

                    }
                    if (response == "0") {
                        alert("Data Updation Failed.");
                                   $('#DocumentTypeNameChange').val( @Model.DocmentType);

                    }
                }
            });
        }
        else {
           $('#DocumentTypeNameChange').val(@Model.DocmentType);
        }
    }


