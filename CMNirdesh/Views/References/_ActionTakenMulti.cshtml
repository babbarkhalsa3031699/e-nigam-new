    function Swipe(val) {
        if (val == 1) {
            $(".one").css("width", "0%");
            $(".two").css("width", "100%");
            $(".one").hide();
            $("#floatButton").css("left", "2%");

        } else {
            $(".one").css("width", "35%");
            $(".two").css("width", "65%");
            $(".one").show();
            $("#floatButton").css("left", "35%");
        }
        $("#PannelId").val(val);
    }


    function OpenCheckPopUp() {

        var val = $("#MultiUpdate").val();
        if (val == "") {
            alert("Please Select Checkbox.")
        } else {
            $("#EditHeading").html("Update Action");
            $("#CheckBoxModal").css("display", "block");
        }



    }


    function OpenSingleEdit(IDD) {

            var mainRefid= $('#RefId').val();
        var ID = IDD.id;
        $("#MultiUpdate").val(ID);
        $("#EditHeading").html("Update Action");
        $("#CheckBoxModal").css("display", "block");
        var length = $('#DdlActionType_Multi').children('option').length;
        if (length == 2) {
            $('#DdlActionType_Multi option:eq(2)').attr('selected', 'selected');
        }
    }

    function closeCheckEdit() {
        $("#CheckBoxModal").css("display", "none");
        $("#MultiUpdate").val("");
        $('input:checkbox').prop('checked', false);
        mlarr = [];
        $("#floatButton").hide();
        tinyMCE.get('ActionDescription_Multi').setContent('');

    }

    function CheckAll(val) {

        if ($("#checkall").prop("checked") == true) {
            $('.RefCheckBox').prop('checked', true);
            $('input:checkbox.RefCheckBox').each(function () {
                var sThisVal = (this.checked ? $(this).val() : "");
                mlarr.push(sThisVal);
            });
            $("#MultiUpdate").val(mlarr);
            $("#floatButton").show();
        }
        else if ($("#checkall").prop("checked") == false) {
            $('.RefCheckBox').prop('checked', false);
            mlarr = [];
            $("#MultiUpdate").val("");
            $("#floatButton").hide();
        }

    }
</script>



