

<link href="~/css/Chart.css" rel="stylesheet" />
<script src="~/Scripts/Chart.js"></script>
<input type="hidden" id="diarydispatchval" name="diarydispatchval" value="" />
<input type="hidden" id="sincefilterhdn" name="sincefilterhdn" value="" />

@using CMNirdesh.Models;

<style>
    .card-title {
        float: left;
        font-size: 24px;
        font-weight: 400;
        margin: 0;
    }
</style>

<head>
    <script>

        function getRandomColor() {
            var letters = '0123456789ABCDEF'.split('');
            var color = '#';
            for (var i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }
        var StackedBarDatajson = [];
        var pieChartCanvas = [];

        $(document).ready(function () {
           
            var diarydispatchvalue = "diary";
            $("#diarydispatchval").val(diarydispatchvalue);
            $("#thirdLinkMenu").html('References >> Analytics');
            $("#loader-wrapper").hide();

            GetDepartmentAnalytics();
            getAnalyticsBarChart();
            getAnalyticsPieChart();
            getAnalyticsBarChartData1();
            BindActionStatusAnalytics();
            GetAllDiaryCountAnalytics();

            $("#checkDiary").click(function () {
                var diarydispatchvalue = "diary";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
                BindActionStatusAnalytics();
                GetAllDiaryCountAnalytics();

            });

            $("#checkDispatch").click(function () {
                var diarydispatchvalue = "dispatch";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
                BindActionStatusAnalyticsDispatch();
                GetAllDispatchCountAnalytics();

            });

            $("#btnSearchAnalytics").click(function () {
                if ($("#checkDiary").prop("checked")) {
                    getAnalyticsBarChart();
                    getAnalyticsPieChart();
                    getAnalyticsBarChartData1();
                    BindActionStatusAnalytics();
                    GetAllDiaryCountAnalytics();
                }
                else {
                    getAnalyticsBarChart();
                    getAnalyticsPieChart();
                    getAnalyticsBarChartData1();
                    BindActionStatusAnalyticsDispatch();
                    GetAllDispatchCountAnalytics();
                }
            });
        })

        function ResetSinceAnalytics() {

            var dropDown = document.getElementById("sincefilterAnalytics");
            dropDown.selectedIndex = 0;
            $("#sincefilterAnalytics").val('');
            if ($("#checkDiary").prop("checked")) {
                var diarydispatchvalue = "diary";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
                BindActionStatusAnalytics();
                GetAllDiaryCountAnalytics();
            }
            else {
                var diarydispatchvalue = "dispatch";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
                BindActionStatusAnalyticsDispatch();
                GetAllDispatchCountAnalytics();
            }
        }

        function GetDepartmentAnalytics() {

            var depttAnalytics = $("#depttAnalytics");
            depttAnalytics.empty().append('<option selected="selected" value="">Please select</option>');
        $('#depttAnalytics').empty().append('<option selected="selected" value="">Please select</option>');
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetDepartments", "References")',
            datatype: "Json",
            data: {},
            success: function (data) {
                depttAnalytics.empty().append('<option selected="selected" value="@CurrentSession.DeptID">@CurrentSession.DeptName</option>');
                $.each(data, function () {
                    depttAnalytics.append($("<option></option>").val(this['id']).html(this['name']));
                });


            }
        });
    }

        $("#depttAnalytics").change(function () {
        var id = $("#depttAnalytics").val();

        $('#offIdAnalytics').empty().append('<option selected="selected" value=""> -- Select -- </option>');
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetOfficebyDepartmentId", "References")',
            datatype: "Json",
            data: { deptid: id },
            success: function (data) {
                $.each(data, function (index, value) {
                    $('#offIdAnalytics').append('<option value="' + value.id + '">' + value.name + '</option>');

                });
            }
        });
    })

        $("#offIdAnalytics").change(function () {
        var diarydispatchvalue = $("#diarydispatchval").val();
        if (diarydispatchvalue =="dispatch") {
            getAnalyticsBarChart();
            getAnalyticsPieChart();
            getAnalyticsBarChartData1();
            BindActionStatusAnalytics();
            GetAllDiaryCountAnalytics();
            document.getElementById("checkDispatch").checked = true;

        } else {
            getAnalyticsBarChart();
            getAnalyticsPieChart();
            getAnalyticsBarChartData1();
            BindActionStatusAnalyticsDispatch();
            GetAllDispatchCountAnalytics();
            document.getElementById("checkDiary").checked = true;

        }
    })

        $("#sincefilterAnalytics").change(function () {
            var sinceparam = $(this).val();
            $("#sincefilterhdn").val(sinceparam);
            var diarydispatchvalue = $("#diarydispatchval").val();

            if ($("#checkDiary").prop("checked")) {
                var diarydispatchvalue = "diary";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
                BindActionStatusAnalytics();
                GetAllDiaryCountAnalytics();
            }
            else {
                var diarydispatchvalue = "dispatch";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
                BindActionStatusAnalyticsDispatch();
                GetAllDispatchCountAnalytics();
            }
        });

        function GetActionStatusValueAnalytics() {
            var StatusVal = 0;
            $.each($("input[name='groupAnalytics']:checked"), function () {
                StatusVal = $(this).val();
            });
            return StatusVal;
        }

        //Weekly Chart Start
        function getAnalyticsBarChartData1() {
            var offid = $("#offIdAnalytics").val();
           // var since = $("#sincefilterAnalytics").val();
            var cnt = [], dt = [], bgcolor = [];
            var pathurl = '/References/DiaryRefWiseChart';
            var status = 0;
            status = GetActionStatusValueAnalytics();
            var diarydispatchvalue = $("#diarydispatchval").val();
            $.ajax({
                url: pathurl,
                type: 'GET',
                async: true,
                data: { status: status, diarydispatchvalue: diarydispatchvalue, offid: offid },
                success: function (result) {

                    if (result.length > 0) {
                        for (var i = 0; i < result.length; i++) {
                            cnt.push(result[i].Text);
                            dt.push(result[i].Value);
                            bgcolor.push(getRandomColor());
                        }

                        BarDatajson = {
                            labels: cnt,
                            datasets: [
                                {
                                    label: "Refernces",
                                    backgroundColor: bgcolor,
                                    data: dt
                                }
                            ]
                        }
                        var barChartCanvas = $('#barChart').get(0).getContext('2d')
                        var barChartData = $.extend(true, {}, BarDatajson)
                        var temp1 = BarDatajson.datasets[0]
                        barChartData.datasets[0] = temp1

                        var barChartOptions = {
                            responsive: true,
                            maintainAspectRatio: false,
                            datasetFill: false,
                            scales: {
                                xAxes: [{
                                    display: true,
                                    scaleLabel: {
                                        display: true,
                                        labelString: 'Date'
                                    },
                                }],
                                yAxes: [{
                                    display: true,
                                    scaleLabel: {
                                        display: true,
                                        labelString: 'No. of References'
                                    },
                                    ticks: {
                                        precision: 0,
                                        beginAtZero: true,
                                    }
                                }]
                            }

                        }
                        new Chart(barChartCanvas, {
                            type: 'bar',
                            data: barChartData,
                            options: barChartOptions
                        })

                        $("#loader-wrapper").hide();
                    }

                    else {
                        $("#loader-wrapper").hide();
                    }
                },

                error: function (result) {
                    $("#loader-wrapper").hide();
                }

            });
        }
        //Weekly Chart End

        //Stacked Bar chart start
        var StackedbarChartCanvas = $('#StackedbarChart').get(0).getContext('2d');
        var StackbarChartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            datasetFill: false,
            scales: {
                xAxes: [{
                    stacked: true,
                    display: true,
                    scaleLabel: {
                        display: true,
                        labelString: 'Document Type'
                    },
                }],
                yAxes: [{
                    stacked: true,
                    display: true,
                    scaleLabel: {
                        display: true,
                        labelString: 'No. of References'
                    },
                    ticks: {
                        precision: 0,
                        beginAtZero: true,
                    }
                }]
            }

        }

        function getAnalyticsBarChart() {
            var offid = $("#offIdAnalytics").val();
            var since = $("#sincefilterAnalytics").val();
            var startDt = $("#txtFromAnalytics").val();
            var endDt = $("#txtToAnalytics").val();
            var status = 0;
            status = GetActionStatusValueAnalytics();
            var diarydispatchvalue = $("#diarydispatchval").val();
            bgcolor = [];
            var pathurl = '/References/GetDocumentsbyOfficeIdAnalyticsBarChart';
            var DocumentTypeId = 0, DocumentTypeName = [], total = [];
            
            $.ajax({
                url: pathurl,
                type: 'GET',
                data: { DocumentTypeId: DocumentTypeId, DocumentTypeName: DocumentTypeName, total: total, status: status, diarydispatchvalue: diarydispatchvalue, offid: offid, since: since, startDt: startDt, endDt: endDt },
                success: function (result) {

                    if (result.length > 0) {

                        for (var i = 0; i < result.length; i++) {
                            DocumentTypeName.push(result[i].DocumentTypeName);
                            total.push(result[i].total);
                            bgcolor.push(getRandomColor());
                        }
                        StackedBarDatajson = {
                            labels: DocumentTypeName,
                            datasets: [
                                {
                                    label: 'Refrences',
                                    backgroundColor: bgcolor,
                                    data: total
                                }
                            ]
                        }
                        new Chart(StackedbarChartCanvas, {
                            type: 'bar',
                            data: StackedBarDatajson,
                            options: StackbarChartOptions
                        })
                        $("#loader-wrapper").hide();

                        $("#StackedbarChartNoData").hide();
                    }

                    else {
                        $("#StackedbarChartNoData").show();
                        $("#loader-wrapper").hide();
                    }
                },

                error: function (result) {
                    $("#StackedbarChartNoData").show();

                    $("#loader-wrapper").hide();
                }

            });
        }
        //Stacked Bar chart End

        //PieChart Start
        var pieChartCanvas = $('#pieChart').get(0).getContext('2d')
        var pieOptions = {
            maintainAspectRatio: false,
            responsive: true,
            legend:
            {
                position: 'bottom'
            }
        }

        function getAnalyticsPieChart() {
            var since = $("#sincefilterAnalytics").val();
            var offid = $("#offIdAnalytics").val();
            var diarydispatchvalue = $("#diarydispatchval").val();
            var startDt = $("#txtFromAnalytics").val();
            var endDt = $("#txtToAnalytics").val();
            var pathurl = '/References/GetDocumentsbyOfficeIdAnalyticsBarChart';
            var DocumentTypeId = 0, DocumentTypeName = [], total = [], bgcolor = [];
            var status = 0;
            status = GetActionStatusValueAnalytics();
            $.ajax({
                url: pathurl,
                type: 'GET',
                data: { DocumentTypeId: DocumentTypeId, DocumentTypeName: DocumentTypeName, total: total, status: status, diarydispatchvalue: diarydispatchvalue, offid: offid, since: since, startDt: startDt, endDt: endDt },
                success: function (result) {
                    if (result.length > 0) {
                        for (var i = 0; i < result.length; i++) {

                            DocumentTypeName.push(result[i].DocumentTypeName);
                            total.push(result[i].total);
                            bgcolor.push(getRandomColor());
                        }
                        var donutData = {
                            labels: DocumentTypeName,
                            datasets: [
                                {
                                    data: total,
                                    backgroundColor: bgcolor,
                                }
                            ],
                        }
                        new Chart(pieChartCanvas, {
                            type: 'pie',
                            options: pieOptions,
                            data: donutData,
                        })
                        $("#loader-wrapper").hide();
                    }
                    else {
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (result) {
                    $("#loader-wrapper").hide();
                }
            });
        }
        // PieChart End

        function BindActionStatusAnalytics() {
            var startDt = $("#txtFromAnalytics").val();
            var endDt = $("#txtToAnalytics").val();
            var since = $("#sincefilterAnalytics").val();
            var offid = $("#offIdAnalytics").val();
            var pathurl = '/References/BindActionStatusAnalytics';
            $("#loader-wrapper").show();
            $("#StatusListAnalytics").empty();
            $.ajax({
                url: pathurl,
                type: 'GET',
                data: { startDt: startDt, endDt: endDt, since: since, OfficeId: offid },
                async: true,
                success: function (result) {
                    var html = "";
                    if (result.length > 0) {
                        for (var i = 0; i < result.length; i++) {
                            var item = result[i];
                            if (item.Text == "Pending") {
                                html = html + "<input type='radio' onclick='ActionStatusCheckAnalytics(this)' id='check'" + item.Text + "' value='" + item.Value + "' name='groupAnalytics' checked='checked'  style='width:3%;'>";
                            }
                            else {
                                html = html + "<input type='radio' onclick='ActionStatusCheckAnalytics(this)' id='check'" + item.Text + "' value='" + item.Value + "' name='groupAnalytics'style='width:3%;'>";
                            }
                            html = html + "<span style='width:5%'>" + item.Text + "</span>";
                            html = html + "<span  style='width:5%; cursor:pointer; margin-left:5px; " + item.background + "; '>" + '(' + item.count + ')' + "</span>";

                        }
                        $("#StatusListAnalytics").html(html);
                        $("#loader-wrapper").hide();
                    }

                    else {
                        $("#StatusList").html("No Data Found");
                        $("#loader-wrapper").hide();
                    }
                }
                ,
                error: function (result) {
                    $("#loader-wrapper").hide();
                }
            });
        }

        function BindActionStatusAnalyticsDispatch() {
            var startDt = $("#txtFromAnalytics").val();
            var endDt = $("#txtToAnalytics").val();
            var since = $("#sincefilterAnalytics").val();
            var offid = $("#offIdAnalytics").val();
            var pathurl = '/References/BindActionStatusAnalyticsDispatch';
            $("#loader-wrapper").show();
            $("#StatusListAnalytics").empty();
            $.ajax({
                url: pathurl,
                type: 'GET',
                data: { startDt: startDt, endDt: endDt, since: since, OfficeId: offid },
                async: true,
                success: function (result) {
                    var html = "";
                    if (result.length > 0) {
                        for (var i = 0; i < result.length; i++) {
                            var item = result[i];
                            if (item.Text == "Pending") {
                                html = html + "<input type='radio' onclick='ActionStatusCheckAnalytics(this)' id='check'" + item.Text + "' value='" + item.Value + "' name='groupAnalytics' checked='checked'  style='width:3%;'>";
                            }
                            else {
                                html = html + "<input type='radio' onclick='ActionStatusCheckAnalytics(this)' id='check'" + item.Text + "' value='" + item.Value + "' name='groupAnalytics'style='width:3%;'>";
                            }
                            html = html + "<span style='width:5%'>" + item.Text + "</span>";
                            html = html + "<span  style='width:5%; cursor:pointer; margin-left:5px; " + item.background + "; '>" + '(' + item.count + ')' + "</span>";

                        }
                        $("#StatusListAnalytics").html(html);
                        $("#loader-wrapper").hide();
                    }

                    else {
                        $("#StatusList").html("No Data Found");
                        $("#loader-wrapper").hide();
                    }
                }
                ,
                error: function (result) {
                    $("#loader-wrapper").hide();
                }
            });
        }

        function ActionStatusCheckAnalytics(obj) {

            if ($("#checkDiary").prop("checked")) {
                var diarydispatchvalue = "diary";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
            }
            else {
                var diarydispatchvalue = "dispatch";
                $("#diarydispatchval").val(diarydispatchvalue);
                getAnalyticsBarChart();
                getAnalyticsPieChart();
                getAnalyticsBarChartData1();
            }
        }

        function GetAllDiaryCountAnalytics() {
        var diarydispatchvalue = "diary";
        $("#diarydispatchval").val(diarydispatchvalue);
        var startDt = $("#txtFromAnalytics").val();
        var endDt = $("#txtToAnalytics").val();
        var since = $("#sincefilterAnalytics").val();
        $("#loader-wrapper").show();
        if (since != "" && (startDt != "" || endDt !== "")) {
            alert("Please select either ReferenecFrom - ReferenceTo  or since filter!!");
            $("#loader-wrapper").hide();
            return false;
        }
           $.ajax({
            type: "GET",
              url: '@Url.Action("GetAllDiaryCount", "References")',
            datatype: "Json",
                contentType: "application/json; charset=utf-8",
               data: { startDt: startDt, endDt: endDt, since: since },
                success: function (response) {
                    if (response != null) {
                        var TotalDiary = new Intl.NumberFormat('en-IN').format(response[0].TotalDiary);
                        $("#TotalDiaryAnalytics").append().html(TotalDiary);

                        $("#loader-wrapper").hide();
                        $("#dispatchcounttrAnalytics").hide();
                        $("#diarycounttrAnalytics").show();
                    }
                    else {
                        $("#dispatchcounttrAnalytics").hide();
                        $("#diarycounttrAnalytics").hide();
                        $("#loader-wrapperAnalytics").hide();
                    }
                },
                error: function (error) {
                }
              });
    }

        function GetAllDispatchCountAnalytics() {
        var diarydispatchvalue = "dispatch";
        $("#diarydispatchval").val(diarydispatchvalue);
        var startDt = $("#txtFromAnalytics").val();
        var endDt = $("#txtToAnalytics").val();
        var since = $("#sincefilterAnalytics").val();
        $("#loader-wrapper").show();
        if (since != "" && (startDt != "" || endDt !== "")) {
            alert("Please select either ReferenecFrom - ReferenceTo  or since filter!!");
            $("#loader-wrapper").hide();
            return false;
        }
           $.ajax({
            type: "GET",
              url: '@Url.Action("GetAllDispatchCount", "References")',
              datatype: "Json",
                contentType: "application/json; charset=utf-8",
               data: { startDt: startDt, endDt: endDt, since: since },
                success: function (response) {
                    if (response != null) {
                        var TotalDispatch = new Intl.NumberFormat('en-IN').format(response[0].TotalDispatch);
                        $("#TotalDispatchAnalytics").append().html(TotalDispatch);

                        $("#loader-wrapper").hide();
                        $("#dispatchcounttrAnalytics").show();
                        $("#diarycounttrAnalytics").hide();
                    }
                    else {
                        $("#dispatchcounttrAnalytics").hide();
                        $("#diarycounttrAnalytics").hide();
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (error) {
                }
              });



    }

    </script>
</head>

<body>

    <div class="row col-md-10 col-sm-10 col-xs-10 col-lg-12 col-xl-10 table-responsive">

        <table class="table table-bordered  dataTable" id="myConstituency" aria-describedby="sample-table-3_info" style="width: 100%; overflow: scroll;">

            <thead>
                <tr>
                    <th colspan="8" width="50%" style="color: black; border-bottom: 0px;">
                        <div class="col-md-12 col-xl-12 col-xs-12 col-lg-12 col-sm-12 row">
                            <div class="col-md-1 col-xl-1 col-xs-1 col-lg-1 col-sm-1 ">

                                <label style="color:blue; margin-top:7px; text-align:right;" class="pull-right">Office &nbsp;</label>
                            </div>
                            <div class="col-md-5 col-xl-5 col-xs-5 col-lg-5 col-sm-5 ">

                                <select class="form-control" id="depttAnalytics" name="depttAnalytics" required></select>
                            </div>
                            <div class="col-md-5 col-xl-5 col-xs-5 col-lg-5 col-sm-5">

                                <select class="form-control" name="offIdAnalytics" id="offIdAnalytics" required>
                                    <option selected="selected" value="" disabled> @CurrentSession.OfficeName</option>
                                </select>
                            </div>

                        </div>
                    </th>
                    <th colspan="9" width="50%" style="color:black;">
                        <span style="margin-left:2%;">Reference From: </span>   <input type="date" id="txtFromAnalytics" style="margin-left:1%; height:27px;" />
                        <span style="margin-left:2%;">Reference To: </span>    <input type="date" id="txtToAnalytics" style="margin-left: 1%; height: 27px;" />
                        <input style="margin-left: 1%;" type="button" id="btnSearchAnalytics" value="Search" />

                        @*<button class="TopButtons"> Filter</button>*@
                    </th>
                </tr>
                <tr>
                    <th colspan="3" width="20%" style="color: black; border-bottom: 0px;">

                        <input type="radio" id="checkDiary" value="Diary" name="group" checked="checked" style="margin-left:2%">
                        <span style="margin-left:5px;">Diary</span>
                        <span id="diarycounttrAnalytics" style="display: none;">
                            <span style="color: darkred">(</span>
                            <span style="color: darkred" id="TotalDiaryAnalytics"></span>
                            <span style="color: darkred">)</span>
                        </span>

                        <input type="radio" id="checkDispatch" value="Dispatch" name="group" style="margin-left:2%">
                        <span style="margin-left:5px;">Dispatch</span>
                        <span id="dispatchcounttrAnalytics" style="display:none;">
                            <span style=" color: darkred">(</span>
                            <span style="color:darkred" id="TotalDispatchAnalytics"></span>
                            <span style="color: darkred">)</span>
                        </span>

                    </th>

                    <th colspan="11" width="60%" style="color: black; border-bottom:0px;">
                        <div id="StatusListAnalytics">

                        </div>

                    </th>

                    <th colspan="3" width="20%" style="color: black; border-bottom:0px;">

                        <div class="col-md-9">
                            <label class="form"> <b>Since</b></label>
                            <select name="since" id="sincefilterAnalytics">
                                <option value="" onclick="ResetSinceAnalytics();" selected>--Select--</option>
                                <option value="1week">1 Week</option>
                                <option value="2week">2 Week</option>
                                <option value="1month">1 Months</option>
                                <option value="3month">3 Months</option>
                                <option value="6month">6 Months</option>
                                <option value="year">1 Year</option>
                                <option value="morethanyear">1 Year +</option>
                            </select>
                        </div>
                       


                    </th>
                </tr>



            </thead>
            <tbody role="alert" aria-live="polite" aria-relevant="all" id="tbodyDaschboard">
            </tbody>

        </table>
        <br />
    </div>


   
    <br />




    <div class="row col-md-12 col-sm-12 col-xs-12 col-lg-12 col-xl-12" style="margin-top:20px;">
        <div class="col-lg-5  col-md-5  col-xl-5  col-sm-5">
            <div class="card card-success">
                <div class="card-header">
                    <h3 class="card-title" style="margin-left:30px;">Document Type & Reference Wise</h3>

                </div>
                <div class="card-body">
                    <div class="chart">
                        <canvas id="StackedbarChart" style="min-height: 450px; height: 450px; max-height: 450px; max-width: 100%;"></canvas>
                        <h3 id="StackedbarChartNoData" style="display:none;">
                        </h3>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-5 col-lg-offset-1 col-md-5 col-md-offset-1 col-xl-5 col-xl-offset-1 col-sm-5 col-sm-offset-1">
            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title">Reference Type Wise</h3>

                </div>
                <div class="card-body">
                    <canvas id="pieChart" style="min-height: 430px; height: 430px; max-height: 430px; max-width: 100%;"></canvas>
                </div>
            </div>
        </div>

    </div>
    <br />    <br />


    <div class="row">
        <div class="col-lg-8 col-lg-offset-2 col-md-8 col-md-offset-2 col-xl-8 col-xl-offset-2 col-sm-8 col-sm-offset-2">
            <div class="card-header">
                <h3 class="card-title">Weekly Diary</h3>
            </div>
            <div class="card-body">
                <div class="chart">
                    <canvas id="barChart" style="min-height: 300px; height: 300px; max-height: 300px; max-width: 100%;"></canvas>
                </div>
            </div>

        </div>
    </div>

</body>