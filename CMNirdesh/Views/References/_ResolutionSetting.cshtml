@model CMNirdesh.Models.Diaries.MlaDiaryData
@using CMNirdesh.Models

@{
    var FileSettings = CMNirdesh.Models.FileSetting.GetSecureFileSettingLocation();
    System.Globalization.CultureInfo Indian = new System.Globalization.CultureInfo("hi-IN");
    string SiteName = System.Web.Configuration.WebConfigurationManager.AppSettings["serviceName"];
    string path = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"] + "/MlaDiary/TempFile/";
}



<script>
    function refresh() {
        var agendid = $("#ddlagenda").val();
        if (agendid != "") {
            var categories = [];
            $('#tableRef').DataTable().rows().every(function (rowIdx, tableLoop, rowLoop) {
                // categories.push(this.data().at(1));
                //console.log(rowIdx);
                //console.log(this.data().at(1));

                var rowid = this.data().at(1);
                var index = $('#ser_' + rowid).val();

                categories.push({
                    AgendaRecordId: rowid,
                    Index: index
                });



            });


            var fd = JSON.stringify(categories)
            console.log(fd);
            $("#hdnAgendaDetails").val(fd);
            $("#hdnrefresh").val(1);
            $("#btnrefresh").click();

        }



    }

    function generateindexRes() {
        var i = 1;
        $("#tableRefRes").DataTable().rows().every(function () {
            var data = this.data();
            console.log(data);
            console.log(data[1]);
            if (i == 1) {
                var firstindex = $("#Resser_" + data[1]).val();
                if (firstindex != "") {
                    i = firstindex;
                }
            }
            var val = $("#Resser_" + data[1]).val(i);
            i++;
        });
    }


     function freeze() {
     var result = confirm("Are you sure you want to Freeze Agenda?");
     if (result) {
         var agendid = $("#ddlagenda").val();
         if (agendid != "") {
             var categories = [];


             $('#tableRef').DataTable().rows().every(function (rowIdx, tableLoop, rowLoop) {

                 //categories.push(this.data().at(1));
                 //console.log(rowIdx);
                 //console.log(this.data().at(1));
                 var rowid = this.data().at(1);
                 var index = $('#ser_' + rowid).val();

                 categories.push({
                     AgendaRecordId: rowid,
                     Index: index
                 });



             });


             var fd = JSON.stringify(categories)
             $("#hdnAgendaDetails").val(fd);
             $("#hdnfreezed").val(1);
         }

     }

 }

 function approve() {
     var result = confirm("Are you sure you want to Save?");
     if (result) {
         var agendid = '@Model.agendaId';
         if (agendid != "") {
             var categories = [];


             $('#tableRef').DataTable().rows().every(function (rowIdx, tableLoop, rowLoop) {

                 //categories.push(this.data().at(1));
                 //console.log(rowIdx);
                 //console.log(this.data().at(1));
                 var rowid = this.data().at(1);
                 var index = $('#ser_' + rowid).val();

                 categories.push({
                     AgendaRecordId: rowid,
                     Index: index,
                     AgendaId: agendid
                 });



             });


             var fd = JSON.stringify(categories)

              $.ajax({
                 type: "POST",
                  data: fd,
                 url: "@Url.Action("SaveIndex", "References")",
                 contentType: "application/json"
                    }).done(function (result) {
                 alert("Updated Successfully");
                 $('#myModal').modal('hide');
                 $("#CreateMeeting").html(result);

                    });



             $("#hdnAgendaDetails").val(fd);
             $("#hdnfreezed").val(1);
         }
     } else {
         return false;
     }


 }

    function PassalertRes(meedingend) {
        if (meedingend) {
            alert("Please Update the Action Passed Or Cancel to all the references to Proceed Further.");
        } else {
            alert("Please Update End time of meeting , Proceedings header & Attandance");
        }

    }

    function passedRes() {
        var result = confirm("Are you sure you want to Save?");
        if (result) {
            var agendid = '@Model.agendaId';
            if (agendid != "") {
                var categories = [];


                $('#tableRefRes').DataTable().rows().every(function (rowIdx, tableLoop, rowLoop) {

                    //categories.push(this.data().at(1));
                    //console.log(rowIdx);
                    //console.log(this.data().at(1));
                    var rowid = this.data().at(1);
                    var index = $('#Resser_' + rowid).val();

                    categories.push({
                        AgendaRecordId: rowid,
                        Index: index,
                        AgendaId: agendid
                    });



                });


                var fd = JSON.stringify(categories);

                   $.ajax({
                      type: "POST",
                       data: fd,
                      url: "@Url.Action("SaveResolution", "References")",
                      contentType: "application/json"
                         }).done(function (result) {
                             alert(result.Alert);
                             //alert(result.result);
                             if (result.result == "1") {
                                 $('#btnPass').hide();

                             }
                             GetIncludedRef();
                      //$("#ResolutionSetting").html(result);

                         });
                               // $("#hdnAgendaDetails").val(fd);
                               // $("#hdnfreezed").val(1);
                            }
                        } else {
                            return false;
                        }


    }

    function showdiv() {

        $('#NewAgendaModal').modal('show');
        $('#refdiv').show();
        var aid ='@Model.agendaId';
        $('#hdnAgendaId').val(aid);
        return false;
    }



     function addTableItem() {
     var result = confirm("Are you sure you want to Save?");
         if (result) {
             $('#loader-wrapper').show();
         var agendaid = '@Model.agendaId';
         var subject = $('#txtsubject').val();
         var subjectdetails = tinymce.get("MeetingSetting_NewSubjectDetails").getContent();
         if (agendaid != "") {
             var formData = new FormData();
             formData.append("agendaid", agendaid);
             formData.append("subject", subject);
             formData.append("subjectdetails", subjectdetails);
            
              $.ajax({
                 type: "POST",
                  data: formData,
                  url: "@Url.Action("AddTableItem", "References")",
                  processData: false,
                  //contentType: "application/json"
                  contentType: false,
              }).done(function (result) {
                 alert("Updated Successfully");
                  $('#NewAgendaModal').modal('hide');
                  $("#loader-wrapper").hide();
                  //$('#tableRefRes').DataTable().clear().destroy();
                  $("#ResolutionSetting").html(result);
                  
                  //$('#tableRefRes').DataTable({
                  //    rowReorder: true,
                  //    paging: false,
                  //});
                });

             //$("#hdnAgendaDetails").val(fd);
             //$("#hdnfreezed").val(1);
         }
     } else {
         return false;
     }


 }
</script>

<body>
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-xs btn-primary bigger" id="btnaddref" onclick="return showdiv()">
            <i class="ace-icon fa fa-pencil-square-o"></i>
            New
        </button>
    </div>
    <div class="AgendaRefDetail" id="sortdiv">
        <div class="count-header p-0 row">
            <div class="row align-items-center justify-content-between">
                <div class="col-lg-6 p-sm-2 p-2">
                    <span style="font-size: 18px;" id="DocumentTypename"></span>
                </div>

                <div class="col-lg-4 p-2">
                    <span class="badge badge-danger pull-right count-font ml-2">Count:  <span class="" id="DiaryCount"> @Model.MeetingSetting.Count</span></span>
                    @if (Model.MeetingSetting.FileRefId != "")
                    {
                        <span class="badge badge-danger pull-right count-font">File RefId: &nbsp; <span class="" id="FileCount"> @Model.MeetingSetting.FileRefId</span></span>
                    }
                </div>
                <div class="col-lg-2">
                    @{int rb1 = 0;}
                    @if (Model.AgendaApprove == "1" && Model.ProceedingApprove == "0")
                    {
                    <div class="">
                        @if (@Model.ResButton)
                        {
                        <input id="btnPass" type="button" name="btnPass" value="Save" class="btn btn-primary" onclick="return passedRes()" />
                        }
                        else
                        {
                            <input id="btnSaveRes" type="button" value="Save" class="btn btn-primary" onclick="PassalertRes('@Model.MeeingEnd')" />
                        }


                    </div>

                    }
                </div>
            </div>

        </div>

        <div class="table-responsive" style="margin-top: 10px;">
            <table class="table table-bordered" id="tableRefRes">
                <thead>
                    <tr class="table-heading">
                        <th class="hideshow td-heading" style="width:3%;"><span class="font-weight-bold"></span></th>
                        <th class="hideshow td-heading hide" style="width:3%;"><span class="font-weight-bold"></span></th>
                        <!--<th class="hideshow td-heading" style="width:3%;"><span class="font-weight-bold"><i class="ace-icon fa fa-pencil bigger-120 hand yesdelete " onclick="OpenCheckPopUp()"></i>    </span> <input type="checkbox" id="checkall" name="checkall" onchange="CheckAll(1)"><br />--> @*
                        <i id="IconShowAll" class="fa fa-plus-square bigger-120 hand" onclick="ShowAllSD()" />*@<!--</th>-->
                        <th class="td-heading" style=" width:25%;"><span class="font-weight-bold">No.</span> <span class="font-weight-bold generate" onclick="generateindexRes();">Generate</span></th>
                        <th class="td-heading" style=" width:25%;"><span class="font-weight-bold">Sr No.</span></th>
                        <th class="td-heading" style=" width:25%;"><span class="font-weight-bold">Subject</span></th>
                        <th class="td-heading" style=" width: 6%;"><span class="font-weight-bold ">Release Date </span></th>
                        <th class="td-heading" style=" width: 15%;"><span class="font-weight-bold">Department </span></th>
                        @*
                        <th class="td-heading" style=" width: 25%;"><span class="font-weight-bold">Brief of Last Action Taken</span></th>*@
                        <th class="td-heading" style=" width: 10%;"><span class="font-weight-bold">Status </span></th>
                        @if (SiteName == "CMNirdesh")
                        {
                        <th class="td-heading" style=" width: 6%;"><span class="font-weight-bold">Ref.Id <br />Date </span></th>
                        <th class="td-heading" style=" width: 6%;"><span class="font-weight-bold">Priority </span></th>
                        <th class="td-heading" style=" width: 6%;"><span class="font-weight-bold">Term </span></th>
                        }
                        <th class="td-heading" style=" width: 6%; display:none"><span class="font-weight-bold">Subject Details </span></th>

                        @if (SiteName == "MC")
                        {
                        <th class="td-heading"><span class="font-weight-bold">Voting</span></th>
                        <th class="td-heading"><span class="font-weight-bold">Point Of Instructions</span></th>
                        }
                        @*
                        <th class="td-heading"><span class="font-weight-bold"></span></th>*@
                    </tr>
                </thead>
                <tbody>
                    @{int b = 1; int rb = 0;}
                    @foreach (var mdl in Model._LstReferences)
                    {

                    <tr id="tr_@mdl.Id" class="@mdl.Color">
                        <td class="grab td-data">
                            <span style="display:none">@b</span>  <i class="fa fa-arrow-up"></i><i class="fa fa-arrow-down"></i>
                            <input type="hidden" id="hdnMeetingDate" value="@mdl.meetingDate">
                        </td>
                        <td class="td-data hide">@mdl.Id</td>
                        @*
                        <td class="td-data"> <i class='fa fa-plus-square' id='Icon_@mdl.Id' onclick='ShowSD(@mdl.Id)'></i> <input type='checkbox' class="RefCheckBox" id='chk_@mdl.Id' value='@mdl.RefId' onclick='UpdateRefStatus(this,@mdl.RefId)'> </td>*@
                        @if (@mdl.ResolutionNo != "")
                        {
                        rb++;
                        <td class="serial td-data">@mdl.ResolutionNo</td>
                        }
                        else
                        {
                        <td class="serial td-data"><input type="text" id="Resser_@mdl.Id" max="8" class="form-control " style="width:70px" onkeypress="return isNumberKey(this,event)" /></td>

                        }
                        <td class="td-data serial" id="srno_@mdl.Id">@mdl.SerialIndex  </td>
                        <td class="td-data" id="sub_@mdl.Id">
                            @mdl.Subject
                            @*<br />
                            <div class='SDHide grey grey-extra-notes' id="SD_@mdl.Id">
                                <textarea id="IncludeSB_@mdl.Id">
                                            @Html.Raw(@mdl.SubjectDetails)
                                    </textarea>

                            </div>*@

                        </td>
                        <td class="td-data">@mdl.LetterDate</td>
                            @if (SiteName == "MC")
                            {
                            <td class="td-data">@mdl.ToOffice</td>
                            }
                            else
                            {
                            <td class="td-data">@mdl.FromOffice</td>
                            }
                        @*
                        <td class="td-data">
                            @mdl.ActionDescription

                        </td>*@
                        <td class="td-data">
                            @mdl.StatusName  <br> @mdl.ActionTakenDate  <br>

                            @{

                            string Enpath1 = @mdl.attachedfile; }
                            @if (!string.IsNullOrEmpty(@mdl.attachedfile))
                            {
                            <a href="@Enpath1" target="_blank">
                                <img src="~/Assets/Home_Images/PDF.png" alt="Download" title="Download Enclosure" width="24" height="24" />
                            </a>
                            }
                            else
                            {
                            }
                        </td>
                        @if (SiteName == "CMNirdesh")
                        {
                        <td class="td-data">
                            @if (@mdl.RefId != "0")
                            {
                            <a data-rel='tooltip' class='tooltip-success' href='#' id='@mdl.RefId' onclick=EditMlaDispatchAgenda(@mdl.RefId,'@Model.PdfButtons') style="color:blue">
                                @mdl.RefId
                            </a>


                            } <br> @mdl.CreatedDate
                        </td>

                        <td class="td-data">
                            @if (@mdl.ReferencePriorityType != "0")
                            {
                            @mdl.ReferencePriorityType
                            }

                        </td>
                        <td class="td-data">
                            @if (@mdl.ReferenceTerm != "0")
                            {
                            @mdl.ReferenceTerm
                            }
                        </td>
                        }
                        <td class="td-data" style="display:none">
                            <a onclick="ViewSB('@mdl.Id')">View</a>

                            @*<textarea id="sb_@mdl.Id" style="display:none">@mdl.SubjectDetails</textarea>*@<textarea id="sb_@mdl.Id" style="display:none">@mdl.SubjectDetails</textarea><textarea id="sb_@mdl.Id" style="display:none">@mdl.SubjectDetails</textarea><textarea id="sb_@mdl.Id" style="display:none">@mdl.SubjectDetails</textarea>

                        </td>

                        @if (SiteName == "MC")
                        {
                        <td>

                            <i class="ace-icon fa fa-thumbs-up bigger-130 voteyes" style="@(@mdl.Voting == 1 ? " ": " display:none")"></i>
                            <i class="ace-icon fa fa-thumbs-down bigger-130 voteno" style="@(@mdl.Voting == 1 ? " display:none" : "" )"></i>


                        </td>
                        <td class="td-data">
                            @if (@mdl.Act != "0")
                            {
                            @mdl.Act

                            }
                            else
                            {
                            @Html.DropDownListFor(m => m.ActId, Model.ActList, "Select", new { @id = "ddlact", @class = "txt_design", @Onchange = "updateAct(" + @mdl.Id + ",this);" })

                            }


                        </td>
                        }
                        @*
                        <td>
                            <i class='ace-icon fa fa-pencil bigger-120 hand left' style='color: green' id='@mdl.RefId' onclick='SingleEdit(@mdl.RefId)'></i>
                            <a data-rel='tooltip' class='tooltip-success' href='#' id='@mdl.RefId' onclick=EditMlaDispatchAgenda(@mdl.RefId,'@Model.PdfButtons') style="color:blue">
                                <i class='ace-icon fa fa-eye bigger-120 hand' style="color: black;"></i>
                            </a>
                        </td>*@




                        @*@Html.Raw(mdl.SubjectDetails)*@
                    </tr>
                        b++;
                    }
                </tbody>
            </table>
        </div>



        

    </div>

    <div class="modal bd-example-modal-lg" id="NewAgendaModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg" role="document">
            <div class="modal-content card">
                <div class="modal-header card-header">
                    <h3 class="card-title">New Detail</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                    @if (true)
                    {
                        @Html.HiddenFor(m => m.MeetingSetting.AgendaType)
                        <div class="modal-body">
                            <div id="refdiv" style="display:none">
                                @*<div class="row">
                                        <div class="form-group col-sm-12 col-md-12 col-lg-12">
                                            <label for="inputEmail4" class="txt_label">Letter Number:</label>
                                            @Html.TextBoxFor(m => m.NewLetterNo, new { @id = "txtletterno", @tabindex = "1", @class = "form-control txt_design", @required = "required" })
                                        </div>
                                    </div>*@

                                <div class="row">
                                    <div class="form-group col-sm-12 col-md-12 col-lg-12">
                                        <label for="inputEmail4" class="txt_label">Subject:</label>
                                        @Html.TextAreaFor(m => m.MeetingSetting.NewSubject, new { @id = "txtsubject", @tabindex = "1", @class = "form-control txt_design", @required = "required" })
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="form-group col-sm-12 col-md-12 col-lg-12">
                                        @Html.EditorFor(m => m.MeetingSetting.NewSubjectDetails, new { @ID = "txtTableSubjectDetails", @tabindex = "7" })
                                        @*@Html.Raw(Model.NewSubjectDetails)*@
                                        @Html.HiddenFor(m => m.MeetingSetting.HdnAgendaId, new { @id = "hdnAgendaId" })

                                    </div>
                                </div>


                            </div>
                        </div>

                        <div class="modal-footer">
                            <button id="btnadd" type="button" class="btn btn-primary" onclick="addTableItem()">Add</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    }
                
            </div>
        </div>
    </div>
</body>

