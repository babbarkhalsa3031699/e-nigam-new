    function SelectCheckboxes() {

        var input = document.getElementById("txtSelectNos").value;

        if (!input) return;

        input = input.trim().toLowerCase();

        var checkboxes = document.querySelectorAll(".RefCheckBox");

        // ✅ Case 1: ALL / Select All
        if (input === "all" || input === "select all") {
            $("#MultiUpdate").val("");
            $('input:checkbox').prop('checked', false);
            mlarr = [];
            checkboxes.forEach(function (chk) {
                if (!chk.checked) {
                    chk.checked = true;
                    UpdateRefStatus(chk);
                }
            });

            return;
        }

        // ✅ Case 2: Comma separated numbers
        var numbers = input.split(',').map(x => x.trim());
        $("#MultiUpdate").val("");
        $('input:checkbox').prop('checked', false);
        mlarr = [];
        checkboxes.forEach(function (chk) {

            var no = chk.getAttribute("data-no");

            if (numbers.includes(no)) {

                if (!chk.checked) {
                    chk.checked = true;
                    UpdateRefStatus(chk);
                }

            } else {
                // optional: uncheck others
                chk.checked = false;
            }
        });
    }

    function AddtoFileNoting(isRequired = false, ids = "", editor = null) {
        var ids = isRequired ? ids : $("#MultiUpdate").val();
        var refid = '@Model.RefId';
        $.ajax({
            url: '@Url.Action("GetResAndRemarksbyId", "References")' ,
            type: 'POST',
            data: { ids: ids, FileRefid: refid, IsCombinedRequired: isRequired },
            success: function (res) {
                let table = `
                <table border="1" style="width:100%;border-collapse:collapse">
                    <thead>
                        <tr>
                            <th>\u0a2e\u0a24\u0a3e \u0a28\u0a70:</th>
                            <th>\u0a26\u0a2b\u0a3c\u0a24\u0a30 \u0a26\u0a3e \u0a38\u0a41\u0a1d\u0a3e\u0a35</th>
                        </tr>
                    </thead>
                    <tbody>`;

                let grouped = {};

                res.forEach(el => {
                    let remarks = el.Remakes;
                    if (!grouped[remarks]) {
                        grouped[remarks] = {
                            RefIds: [],
                            ResNos: [],
                            Remarks: remarks
                        }
                    }
                    grouped[remarks].RefIds.push(el.RefId);
                    grouped[remarks].ResNos.push(el.ResNo);
                });

                Object.entries(grouped).forEach(([key, x]) => {
                    table += `
                                <tr>
                                    <td contenteditable="false" style="width: 15%;">`;
                    var refspans = [];

                    for (var i = 0; i < x.RefIds.length; ++i)
                    {
                        refspans.push(`<span style="color:blue;cursor:pointer; display: inline-flex;"
                                         id="${x.RefIds[i]}"
                                         onclick="parent.ShowSDPopUp(0, ${x.RefIds[i]})">
                                     <u>${x.ResNos[i]}</u>
                                 </span>`);
                    }

                    table += refspans.join(",");


                    table += `</td >
                        <td contenteditable="false" style="width: 85%;">${x.Remarks}</td>
                    </tr >`;
                });

                table += `
                    </tbody>
                </table>`;
                if (editor) {
                    editor.setContent(table);
                }
                else {
                    tinymce.get("ActionDescription").insertContent(table);
                }                
            }
        });
    }

