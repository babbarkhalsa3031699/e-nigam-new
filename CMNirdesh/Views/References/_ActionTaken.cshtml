    $("#pdfLoader").css("display", "flex");

    $("#pdfFrame")
        .css("visibility", "hidden")
        .removeClass("loaded")
        .off("load")
        .on("load", function () {

            var frame = $(this);

            setTimeout(function () {

                frame.css("visibility", "visible");
                frame.addClass("loaded");

                $("#pdfLoader").fadeOut(300);

            }, 1500);

        })
