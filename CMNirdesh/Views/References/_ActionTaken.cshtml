<script>

$(document).ready(function () {
    // Show confirmation box
      $('#generateApproval').click(function (e) {
          e.preventDefault();
        $('#overlay').show();
        $('#confirmBox').show();
    });

    // "Yes" button
    $(document).on('click', '#yesButton', function (e) {
    e.preventDefault();

    $('#confirmBox').hide();
    $('#overlay').hide();

    var refId = '@Model.RefId';
    var agendaId = '@Model.agendaId';
    var actionCode = $("#hdnactionApprovalid").val();

    var generateUrl = '@Url.Action("GenerateApproval", "References")';

    $('#loader-wrapper').show();

    // 🔹 FIRST AJAX: Generate Approval
    $.ajax({
        type: "POST",
        url: generateUrl,
        data: JSON.stringify({
            RefId: refId,
            agendaId: agendaId,
            actionCode: actionCode,
            FileType: "pdf"
        }),
        contentType: "application/json; charset=utf-8",
        dataType: "json",

        success: function (result) {

            alert('Order Approved Successfully!');

            // 🔹 SECOND AJAX: Encrypt ALL parameters & get Sign URL
            $.ajax({
                type: "POST",
                url: "@Url.Action("GetEncryptedSignUrl", "References")",
                data: {
                    AgendaId: result.AgendaId,
                    ApprovalId: result.ApprovalId,
                    TypeofDocument: "Approval"
                },
                success: function (encryptedUrl) {

                    // ✅ encryptedUrl is COMPLETE
                    $("#lnkSignPdf").attr("href", encryptedUrl);
                    $("#digitalSignatureGroup").removeClass("d-none");

                    console.log("Encrypted Sign URL:", encryptedUrl);
                },
                error: function () {
                    alert("Failed to generate encrypted sign URL");
                }
            });

            // 🔹 UI Updates
            $("#generateApproval, #previewDraftOrder").addClass("d-none");
            $("#approvalOrder").removeClass("d-none");

            $('#approvalOrder, #dSignOrder, #eSignOrder').each(function () {
                $(this)
                    .attr('data-pdf-path', result.pdfPath)
                    .data('agendaId', result.AgendaId)
                    .data('approvalId', result.ApprovalId);
            });

            $('#loader-wrapper').hide();
        },

        error: function (xhr, status, error) {
            $('#loader-wrapper').hide();
            alert("An error occurred: " + error);
        }
    });
});


    // "No" button
      $('#noButton').click(function (e) {
          e.preventDefault();
        $('#confirmBox, #overlay').hide();
    });
});

 $("#dSignOrder").on("click", function () {
        var agendaid = '@Model.agendaId';
        alert(agendaid);
