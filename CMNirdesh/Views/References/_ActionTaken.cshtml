    const baseUrl = '@Url.Action("GenerateNotingPdf", "References")';

    let url = baseUrl + '?RefId=' + encodeURIComponent(mainRefid);

    if (from && to) {
        url += '&from=' + encodeURIComponent(from) +
               '&to=' + encodeURIComponent(to);
    }

    window.open(url, '_blank');
    return false;
}
</script>
