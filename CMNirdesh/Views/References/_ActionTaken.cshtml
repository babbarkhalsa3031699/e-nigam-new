    function OpenPreviewPdf() {

    var refId = '@Model.RefId';
    var agendaId = '@Model.agendaId';
    var actionCode = '0';
    var fileType = 'pdf';
    var selected = $("#MultiUpdate").val();

    var url = '@Url.Action("PreviewApproval", "References")'
        + '?RefId=' + encodeURIComponent(refId)
        + '&Refs=' + encodeURIComponent(selected)
        + '&agendaId=' + encodeURIComponent(agendaId)
        + '&actionCode=' + encodeURIComponent(actionCode)
        + '&FileType=' + encodeURIComponent(fileType);

