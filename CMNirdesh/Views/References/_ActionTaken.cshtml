<script>
    $(document).ready(function () {
        CheckApprovalStatus();
        if ('@Model.HideUpdate' == 'Yes') {
            $("#chkCreateApproval").hide();
            $("#EditDraftOrder").hide();
            $("#EndorsementArea").hide();
            $("#generateApproval").hide();
            $("#approvalOrder").hide();
            $("#digitalSignatureGroup").hide();
            $("#previewDraftOrder").show();
        }

        $("#chkCreateApproval").change(function () {

            var isChecked = $(this).is(":checked");
            var agendaId = '@Model.agendaId';

            $.ajax({
                url: '@Url.Action("SaveCreateApproval", "Approval")',
                type: 'POST',
                data: {
                    AgendaId: agendaId,
                    IsCreateApproval: isChecked
                },
                success: function (response) {

                    if (response.Status == true) {

                        if (isChecked) {

                            $("#EditDraftOrder").show();
                            $("#previewDraftOrder").show();
                            $("#EndorsementArea").show();
                            $("#generateApproval").show();



                        }
                        else {

                            $("#EditDraftOrder").hide();
                            $("#previewDraftOrder").hide();
                            $("#EndorsementArea").hide();
                            $("#generateApproval").hide();

                        }

                    }

                }
            });

        });

    });

    function CheckApprovalStatus() {
        var agendaId = '@Model.agendaId';
        var isHideUpdate = '@Model.HideUpdate';

        if (isHideUpdate == "Yes") {
            $("#chkCreateApproval").hide();
            $("#EditDraftOrder").hide();
            $("#EndorsementArea").hide();
            $("#generateApproval").hide();
            $("#approvalOrder").hide();
            $("#digitalSignatureGroup").hide();
            $("#previewDraftOrder").show();
            return;
        }

        $.ajax({
            url: '@Url.Action("GetCreateApprovalStatus", "Approval")',
            type: 'GET',
            data: {
                AgendaId: agendaId
            },
            success: function (response) {

                if (response.IsCreateApproval == true) {
                    $("#chkCreateApproval").prop("checked", true);
                    $("#EditDraftOrder").show();
                    $("#previewDraftOrder").show();
                    $("#EndorsementArea").show();
                    $("#generateApproval").show();


                }
                else {
                    $("#chkCreateApproval").prop("checked", false);
                    $("#EditDraftOrder").hide();
                    $("#previewDraftOrder").hide();
                    $("#EndorsementArea").hide();
                    $("#generateApproval").hide();


                }

            }
        });

    }
</script>


