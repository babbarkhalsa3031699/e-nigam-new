        $("#mainheader").hide();
        EnableSubjectPopupResizeAndDrag();
    });


    var itemsRef = []; var SwipeId = 0; var uploadCount = 0; var mlfiles = new Array();
   $(document).ready(function () {
       $.noConflict();
       var menutype = $("#lblmenuname").html();
       var heading = $("#inboxlabel").html();

       $("#InboxHeader1").html(heading);
       $("#FileDraft").prop('checked', false);
       $(".filedraft").hide();

       var filetype = '@Model.filetype'; // 2 for Part File

       if (filetype == "2") {

       } else {
           $(".draftchk").hide();
       }

        let isDragging = false;

        // Main panel column resizer (horizontal split)
        $(document).off("mousedown.horizSplit", "#panelContainer > .slider, #resizer-handle, #panelContainer > .slider .resizer").on("mousedown.horizSplit", "#panelContainer > .slider, #resizer-handle, #panelContainer > .slider .resizer", function (e) {
            isDragging = true;
            $("body").addClass("is-resizing is-resizing-h");
            e.preventDefault();
            e.stopPropagation();
        });

        $(document).off("mousemove.horizSplit").on("mousemove.horizSplit", function (e) {
            if (!isDragging) return;

            let container = $("#panelContainer");
            if (!container.length) return;
            let containerLeft = container.offset().left;
            let containerWidth = container.width();

            let mouseX = e.pageX - containerLeft;
            let panelOnePercent = (mouseX / containerWidth) * 100;

            if (panelOnePercent < 15) panelOnePercent = 15;
            if (panelOnePercent > 85) panelOnePercent = 85;

            let panelTwoPercent = 100 - panelOnePercent;

            $(".panelone").css({ "width": panelOnePercent + "%", "max-width": panelOnePercent + "%", "flex": "0 0 " + panelOnePercent + "%" }).show();
            $(".paneltwo").css({ "width": panelTwoPercent + "%", "max-width": panelTwoPercent + "%", "flex": "0 0 " + panelTwoPercent + "%" }).show();

            adjustAllResponsiveElements();
        });

        $(document).off("mouseup.horizSplit").on("mouseup.horizSplit", function () {
            if (isDragging) {
                isDragging = false;
                $("body").removeClass("is-resizing is-resizing-h");
                adjustAllResponsiveElements();
            }
        });

        // Vertical Add Noting / Edit Action section drag handle (#dragBar)
        let isDragBarDragging = false;
        let startDragY, startTopHeight, startBottomHeight;
        let $activeTop, $activeBottom;

        $(document).off("mousedown.dragBar", "#dragBar").on("mousedown.dragBar", "#dragBar", function (e) {
            isDragBarDragging = true;
            startDragY = e.pageY;
            $activeTop = $("#notingList:visible, .note-list:visible").first();
            $activeBottom = $("#EditActionSection:visible, #addNotingSection:visible, .edit-action-section:visible, .left-bottom:visible").first();
            startTopHeight = $activeTop.length ? $activeTop.outerHeight() : 250;
            startBottomHeight = $activeBottom.length ? $activeBottom.outerHeight() : 350;
            $("body").addClass("is-resizing is-resizing-v");
            e.preventDefault();
            e.stopPropagation();
        });

        $(document).off("mousemove.dragBar").on("mousemove.dragBar", function (e) {
            if (!isDragBarDragging || !$activeTop || !$activeBottom || !$activeTop.length || !$activeBottom.length) return;
            let deltaY = e.pageY - startDragY;
            let newTopHeight = startTopHeight + deltaY;
            let newBottomHeight = startBottomHeight - deltaY;

            let minTop = 60;
