<script>
    var SDPreText = "";
   function EnableSubjectPopupResizeAndDrag() {

        const popup = document.getElementById("SubjectDetailModal");

        if (!popup) return;

        // Header Dragging
        $(document).off("mousedown.subjectDrag", "#SubjectDetailModal .pdf-header").on("mousedown.subjectDrag", "#SubjectDetailModal .pdf-header", function (e) {
            if ($(e.target).closest("button, a, input, select, textarea, .pdf-actions, i").length) return;
            e.preventDefault();

            let isDragging = true;
            const rect = popup.getBoundingClientRect();
            const offsetX = e.clientX - rect.left;
            const offsetY = e.clientY - rect.top;

            popup.style.transition = "none";
            popup.style.left = rect.left + "px";
            popup.style.top = rect.top + "px";
            popup.style.right = "auto";

            function onMouseMove(e) {
                if (!isDragging) return;
                let newLeft = e.clientX - offsetX;
                let newTop = e.clientY - offsetY;

                newLeft = Math.max(0, Math.min(window.innerWidth - popup.offsetWidth, newLeft));
                newTop = Math.max(0, Math.min(window.innerHeight - popup.offsetHeight, newTop));

                popup.style.left = newLeft + "px";
                popup.style.top = newTop + "px";
            }

            function onMouseUp() {
                isDragging = false;
                $(document).off("mousemove.subjectDrag", onMouseMove);
                $(document).off("mouseup.subjectDrag", onMouseUp);
            }

            $(document).on("mousemove.subjectDrag", onMouseMove);
            $(document).on("mouseup.subjectDrag", onMouseUp);
        });

        // Resizing (Width and Height without shifting top/upper/lower position)
        $(document).off("mousedown.subjectResize", "#SubjectDetailModal .popup-resizer").on("mousedown.subjectResize", "#SubjectDetailModal .popup-resizer", function (e) {
            e.preventDefault();
            e.stopPropagation();

            const resizer = this;
            let isResizing = true;
            const startX = e.clientX;
            const startY = e.clientY;
            const startWidth = popup.offsetWidth;
            const startHeight = popup.offsetHeight;
            const startLeft = popup.offsetLeft;

            popup.style.transition = "none";

            function onMouseMove(e) {
                if (!isResizing) return;

                const deltaX = e.clientX - startX;
                const deltaY = e.clientY - startY;

                // Adjust width (length) - right side or corner
                if (resizer.classList.contains("resizer-r") || resizer.classList.contains("resizer-corner") || resizer.classList.contains("resizer-br")) {
                    const newWidth = startWidth + deltaX;
                    if (newWidth >= 250 && newWidth <= window.innerWidth) {
                        popup.style.width = newWidth + "px";
                    }
                }

                // Adjust width (length) - left side
                if (resizer.classList.contains("resizer-l")) {
                    const newWidth = startWidth - deltaX;
                    if (newWidth >= 250) {
                        popup.style.width = newWidth + "px";
                        popup.style.left = (startLeft + deltaX) + "px";
                    }
                }

                // Adjust height (vertical) - bottom side or corner (anchored at top, grows downwards)
                if (resizer.classList.contains("resizer-b") || resizer.classList.contains("resizer-corner") || resizer.classList.contains("resizer-br")) {
                    const newHeight = startHeight + deltaY;
                    if (newHeight >= 150 && newHeight <= window.innerHeight) {
                        popup.style.height = newHeight + "px";
                    }
                }
            }

            function onMouseUp() {
                isResizing = false;
                $(document).off("mousemove.subjectResize", onMouseMove);
                $(document).off("mouseup.subjectResize", onMouseUp);
            }

            $(document).on("mousemove.subjectResize", onMouseMove);
            $(document).on("mouseup.subjectResize", onMouseUp);
        });
    }

