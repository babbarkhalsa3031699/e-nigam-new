    function ShowAllActions(filerefid) {

    $("#loader-wrapper").show();

    $.ajax({
        type: "GET",
        url: '@Url.Action("GetIncludedAllActions", "References")',
        data: {refid: filerefid },

        success: function (response) {

            if (!response || response.length === 0) {
                $("#loader-wrapper").hide();
                return;
            }

            let grouped = {};

            // ✅ group by RefId
            response.forEach(function (item) {
                if (!grouped[item.RefId]) {
                    grouped[item.RefId] = [];
                }
                grouped[item.RefId].push(item);
            });

            // ✅ loop each RefId and bind
            Object.keys(grouped).forEach(function (refid) {

                let j = 1;
                let LgString = "";

                grouped[refid].forEach(function (item) {

                    let Desg = item.ActionBy ? item.ActionBy.split(",") : ["", "", ""];
                    let watermark = item.isDraft == "1" ? "Draft-list" : "";
                    let drhide = item.ActionName == "Draft Reply" ? "drhide" : "";

                    LgString += `
                        <div class="lg-comment ${watermark}">

                            <p class="actionname">${item.ActionName}</p>

                            <p class="comno">${j}.</p>

                            <p class="comment-text ${drhide}">
                                ${(item.ActionDescription || '').replace(/&#x0D;/g, "<br>")}
                            </p>

                            <div class="meta">
                                <span class="dt">${item.CreatedDate}</span>
                                <span class="actionby">
                                    ${Desg[0] || ''}<br>${Desg[1] || ''}, ${Desg[2] || ''}
                                </span>
                            </div>

                            <hr class="dotted">
                        </div>
                    `;

                    j++;
                });

                // 🔥 bind to each row
                $('.LG_' + refid).html(LgString).show();
            });

            $("#loader-wrapper").hide();

            // 🔥 adjust datatable after dynamic content
            if ($.fn.DataTable.isDataTable('#IncludeRefTableNew')) {
                $('#IncludeRefTableNew').DataTable().columns.adjust().draw(false);
            }
        },

        error: function () {
            $("#loader-wrapper").hide();
        }
    });
    }

    function ToggleActions(refid,a) {

        let container = $('.LGShow');

        if (container.length === 0) return;

        // 🔁 If already expanded → collapse
        if (container.hasClass('loaded')) {

            let original = container.data('original');
            if (original) {
                container.html(original);
            }

            container.removeClass('loaded');
            return;
        }

        // 🔥 First time → save original + load data
        if (!container.data('original')) {
            container.data('original', container.html());
        }

        // call your ajax
        ShowAllActions(refid);

        container.addClass('loaded');
    }



