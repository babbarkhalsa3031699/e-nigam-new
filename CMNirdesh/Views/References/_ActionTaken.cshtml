    function UpdateOffice() {
        var refid = @Model.RefId;
         var officeId = $('#ddlOfficeChange').val();

        if (officeId == null || officeId == "" || officeId == undefined) {
            alert("Please select Office.");
            return false;
        }
        if (refid == null || refid == "" || refid == undefined) {
            alert("Some Error Occured Try Again");
            return false;
        }

        var formData = new FormData();
        formData.append("refid", refid);
        formData.append("ToOfficeId", officeId);
        if (confirm("Are you sure you want to update?")) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateToOffice", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {
                        alert("Office Updated Successfully. ")
                       // $("#DocumentTypeName").text($("#doctype option:selected").text());
                        $("#editDoctypebox").css("display", "none");

                    }
                    if (response == "0") {
                        alert("Data Updation Failed.");
                                   $('#ddlOfficeChange').val( @Model.ToOfficeId);

                    }
                }
            });
        }
        else {
           $('#ddlOfficeChange').val( @Model.ToOfficeId);
        }
    }


