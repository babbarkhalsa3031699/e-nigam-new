    function convertHtmlToPlainText(htmlString) {
        if (!htmlString) return "";
        var $tempDiv = $("<div>").html(htmlString);

        // Format tables: join cells with tabs and rows with newlines
        $tempDiv.find("table").each(function () {
            var $table = $(this);
            var tableText = "";
            $table.find("tr").each(function () {
                var rowText = [];
                $(this).find("td, th").each(function () {
                    rowText.push($.trim($(this).text()));
                });
                tableText += rowText.join("\t") + "\n";
            });
            $table.replaceWith("\n" + tableText + "\n");
        });
        return $tempDiv.text();
    }

    window.CopySubjectDetail = function (refId) {
        var resolution = $("#hdnRefId_" + refId).val() || "";
        var subject = $("#hdnSubject_" + refId).val() || "";
        var rawHtmlDetail = $("#hdnDetail_" + refId).val() || "";

        // 1. Plain Text Format (tab-aligned tables)
        var plainTextDetail = convertHtmlToPlainText(rawHtmlDetail);
        var plainText =
            "No. :- " + resolution +
            "\n\nSubject :- " + subject +
            "\n\nSubject Detail :-\n" + plainTextDetail;

        // 2. Rich HTML Format (for Word/Excel/Outlook pasting)
        var richHtml =
            "<html><head><meta charset='utf-8'></head><body>" +
            "<strong>No. :-</strong> " + $("<div>").text(resolution).html() + "<br><br>" +
            "<strong>Subject :-</strong> " + $("<div>").text(subject).html() + "<br><br>" +
            "<strong>Subject Detail :-</strong><br>" + rawHtmlDetail +
            "</body></html>";

        // Attempt rich copy using modern Clipboard API
        if (navigator.clipboard && window.ClipboardItem) {
            var plainBlob = new Blob([plainText], { type: "text/plain" });
            var htmlBlob = new Blob([richHtml], { type: "text/html" });
            var clipboardItem = new ClipboardItem({
                "text/plain": plainBlob,
                "text/html": htmlBlob
            });
            navigator.clipboard.write([clipboardItem]).then(function () {
                showCopyToast();
            }).catch(function () {
                fallbackCopy(plainText);
            });
        } else {
            fallbackCopy(plainText);
        }

        function fallbackCopy(textVal) {
            var textarea = document.createElement("textarea");
            textarea.value = textVal;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand("copy");
            document.body.removeChild(textarea);
            showCopyToast();
        }

        function showCopyToast() {
            var $toast = $("<div style='position:fixed; top:20px; right:20px; background-color:#28a745; color:white; padding:15px 25px; border-radius:4px; font-weight:bold; box-shadow:0 4px 6px rgba(0,0,0,0.1); z-index:9999; font-family:sans-serif;'>Copied successfully.</div>");
            $("body").append($toast);
            setTimeout(function () {
                $toast.fadeOut(500, function () {
                    $toast.remove();
                });
            }, 2000);
        }
    };
