    function OpenEditApproval(agendaId, actionIds, fileType, refs) {

    $('#loader-wrapper').show();

    $.ajax({
        url: '@Url.Action("EditApproval", "References")',
        type: 'GET',

        data: {
            AgendaId: agendaId,
            ActionIds: actionIds,
            FileType: fileType,
            Refs: refs
        },

        success: function (data) {
            var editors = tinymce.EditorManager.get();
            editors.forEach(function (editor) {
                var element = editor.getElement();

                if (element && element.closest('#EditApprovalBody')) {
                    editor.remove();
                }
            });

            $('#EditApprovalBody').html('');
            $('#EditApprovalBody').html(data);

            setTimeout(function () {
                $('#loader-wrapper').hide();
                $('#EditApprovalModal').show();
                $("#EditApprovalModal").addClass("show");
            }, 100)
        },

        error: function () {

            $('#loader-wrapper').hide();

            alert('Error loading Edit Approval');
        }
    });
    }


    function OpenEditApprovalSection(agendaId, actionIds, fileType, refs) {
        if (!agendaId || agendaId === '0' || agendaId === '') {
            OpenCheckPopUp();
            return;
        }
        $('#loader-wrapper').show();
        $("#addNotingSection").removeClass("active");
        $("#addnotingbottom").hide();
        //$("#notingList").hide();
        $.ajax({
            url: '@Url.Action("EditApprovalNewNoting", "References")',
            type: 'GET',
            data: {
                AgendaId: agendaId,
                ActionIds: actionIds,
                FileType: fileType,
                Refs: refs
            },
            success: function (data) {
                if (typeof data === 'object' && data.redirect) {
                    $('#loader-wrapper').hide();
                    window.location.href = data.redirect;
                    
                    return;
                }
                var editors = tinymce.EditorManager.get();
                editors.forEach(function (editor) {
                    var element = editor.getElement();

                    if (element && element.closest('#EditActionSectionBody')) {
                        editor.remove();
                    }
                });
                
                $('#EditActionSectionBody').html('');
                $('#EditActionSectionBody').html(data);
                
                setTimeout(function () {
                    $('#loader-wrapper').hide();
                    $('#EditActionSection').show();
                    $("#dragBar").addClass("active").show();
                }, 100)
                
                // Remove previous editors if any
                //tinymce.remove('.tiny-editor');

                // Initialize editors in the loaded HTML
                //tinymce.init({
                //    selector: '#EditActionSectionBody .tiny-editor',
                //    height: 550,
                //    menubar: false,
                //    plugins: 'lists link table code advlist fullscreen',
                //    toolbar: 'fullscreen anxbutton undo redo | bold italic | alignjustify alignleft aligncenter alignright'
                //}).then(function() 
                //    {
                        
                //    }
                //);
            },
            error: function (xhr, status, error) {
                $('#loader-wrapper').hide();
                console.error("EditApprovalNewNoting Error:", xhr, status, error);
                alert('Error loading Edit Approval: ' + (xhr.statusText || error || 'Unknown Error'));
            },
            complete: function () {
                $('#loader-wrapper').hide();
            }
        });
    }

