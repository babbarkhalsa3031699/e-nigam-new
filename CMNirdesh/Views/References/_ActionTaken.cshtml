function printContents() {
    var table = document.getElementById("popuptable");

    // Clone table
    var printTable = table.cloneNode(true);

    // Create print container
    var printContainer = document.createElement("div");
    printContainer.id = "print-container";

    printContainer.appendChild(printTable);

    // Add directly to body
    document.body.appendChild(printContainer);

    window.print();

    // Remove after printing
    setTimeout(function () {
        printContainer.remove();
    }, 500);
};

function OpenPartFileRef(refId) {
    if (!refId) return;
    $('#loader-wrapper').show();
    $.ajax({
        type: "GET",
        url: '@Url.Action("EditMlaDairyForm", "References")',
        data: { ID: refId, MoveId: 0, forceShowUpdate: 'No' },
        success: function (data) {
            $('#loader-wrapper').hide();
            if ($("#InboxModelbody").length > 0) {
                $("#InboxModel").css("display", "block");
                $('#InboxModelbody').html(data);
            } else if ($('#EditApprovalBody').length > 0) {
                $('#EditApprovalBody').html(data);
                $('#EditApprovalModal').modal('show');
            } else if ($('#loginModalDispatchbody').length > 0) {
                $('#loginModalDispatchbody').html(data);
                $("#loginModalDispatch").css("display", "block");
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            $('#loader-wrapper').hide();
            console.error("Error opening Part File reference:", thrownError);
        }
    });
}

function LoadPartFilesData(refid) {
    if (!refid) return;

    var $pane = $("#partfiles_" + refid);
    var $body = $pane.find("tbody");
    if ($body.length === 0) {
        $body = $("#tblPartFilesBody");
    }

    var $loader = $pane.find("#partFilesLoader");
    if ($loader.length === 0) {
        $loader = $("#partFilesLoader");
    }

    $loader.show();

    $.ajax({
        type: "GET",
        url: '@Url.Action("GetPartFileResolution", "References")',
        data: { refid: refid, isLetter: "File" },
        dataType: "json",
        success: function (response) {
            $loader.hide();
            //console.log("GetPartFileResolution Response:", response);
            var html = "";
            var dataList = [];

            if (Array.isArray(response)) {
                dataList = response;
            } else if (response && Array.isArray(response.Data)) {
                dataList = response.Data;
            } else if (response && Array.isArray(response.data)) {
                dataList = response.data;
            } else if (response && typeof response === "string") {
                try {
                    var parsed = JSON.parse(response);
                    dataList = Array.isArray(parsed) ? parsed : (parsed.Data || parsed.data || []);
                } catch (e) {
                    console.error("JSON parse error:", e);
                }
            }

            if (dataList && dataList.length > 0) {
                $.each(dataList, function (i, item) {
                    var refId = item.RefId || item.refId || item.id || item.ID || "";
                    var subject = item.Subject || item.subject || "";
                    var status = item.StatusName || item.statusName || item.Status || "";
                    var createdDate = item.CreatedDate || item.createdDate || item.Date || "";
                    var currentlyWith = item.CurrentlyWith || item.currentlyWith || item.Currently_With || item.currently_with || item.Currently || item.currently || "";

                    html += "<tr role='row' class='" + (i % 2 === 0 ? "odd" : "even") + "'>";
                    html += "<td><a href='javascript:void(0);' class='text-primary font-weight-bold' onclick='OpenPartFileRef(\"" + refId + "\")'>#" + refId + "</a><br/><small class='text-muted'>Date: " + (createdDate ? createdDate : "-") + "</small></td>";
                    html += "<td>" + subject + "<br/><span class='badge bg-info text-dark' style='background-color:#0dcaf0; color:#000; margin-top:4px;'>" + (status ? status : "N/A") + "</span></td>";
                    html += "<td>" + (currentlyWith ? currentlyWith : "-") + "</td>";
                    html += "</tr>";
                });
                $body.html(html);
            } else {
                $body.html("<tr><td colspan='3' class='text-center text-muted'>No Part Files found.</td></tr>");
            }
        },
        error: function (xhr, status, error) {
            $loader.hide();
            console.error("Error loading Part Files:", error, xhr.responseText);
            $body.html("<tr><td colspan='3' class='text-center text-danger'>Error loading Part Files data.</td></tr>");
        }
    });
    }

