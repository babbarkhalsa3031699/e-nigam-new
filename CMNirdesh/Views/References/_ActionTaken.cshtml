    function Save() {

        var radiovalue = document.querySelector('input[name="SentType"]:checked').value;
        var sentto = "";
        if (radiovalue == "FromOffice") {
            sentto = $("#ddlfromUser").val();
       }
        else if (radiovalue == "ToOffice") {
            sentto = $("#ddlToUser").val();
        } else if (radiovalue == "MLAOffice") {
            sentto = $("#ddlMlaUser").val();
        }

        try {
            if (typeof window.tinymce != 'undefined' && $(window.tinymce.editors).length > 0) {
                $(window.tinymce.editors).each(function (idx) {
                    try {
                        tinymce.remove(idx);
                    } catch (e) { }
                });
            }
            tinyMCE.triggerSave(true, true); // very importent for get data of editior

            if (sentto == "") {
                alert("Please Select User");
                return false;
            }

            if ($("#TxtActionTakenDate").val() == "") {
                alert("Please Enter Action Taken Date ?");
                return false;
            }
            else if ($("#DdlActionType").val() == "") {
                alert("Please Select Action Type ?");
                return false;
            }

            else if ($("#hdnisfund").val() == "1" && $("#txtSanctionDate").val() == "" && $("#DdlActionType").val()=="6") {
                alert("Please enter Sanction date");
                return false;
            }
            else if ($("#hdnisfund").val() == "1" && $("#txtApproveDate").val() == "" && $("#DdlActionType").val() == "2") {
                alert("Please enter Approve date");
                return false;
            }
            else {
                if (confirm("Are you sure to save ?")) {
                    $("#loader-wrapper").show();
                    var EnclosureFiletxt = $("#EnclosureFiletxt").text();
                    var ActionFile = $("#Actionfile").text();
                    if (EnclosureFiletxt == "Yes") {
                        $("#IsEnclosureFile").val("Y");
                    }
                    else {
                        $("#IsEnclosureFile").val("N");
                    }
                    if (ActionFile == "Yes") {
                        $("#IsFile").val("Y");
                    }
                    else {
                        $("#IsFile").val("N");
                    }
                    var TxtEnclosureTakenDate = $("#fileupload1").val();
                    var file_nameEn = $("#file_nameEn").html();
                    var ActionTaken_name = $("#file_name1").html();
                    var actionlink = $("#actionlink").text();
                    var action = $("#formActionDiary").attr("action");
                    if ($("#formActionDiary").attr("enctype") == "multipart/form-data") {
                        var dataString = new FormData($("#formActionDiary").get(0));
                        processData = false;
                    }
                    $.ajax({
                        type: "POST",
                        url: action,
                        async: true,
                        data: dataString,
                        dataType: "json", //change to your own, else read my note above on enabling the JsonValueProviderFactory in MVC
                        contentType: false,
                        processData: false,
                        success: function (data) {
                            $("#loader-wrapper").hide();
                            if (data == "U" && data != "E") {
                                var refid = $('#RefId').val();
                                //BindDiaryAction(refid);
                                alert("Action taken has been updated successfully");
                                $("#loginModaldiaryEdit").css("display", "none");
                                $("#loginModaldiary").css("display", "none");
                                window.location.reload(true);
                            }
                            else if (data != "U" && data != "E") {
                               // debugger;
                                //$("#sprefno").text(data);
                                var refid = $('#RefId').val();
                                //BindDiaryAction(refid);
                                alert("Action taken has been updated successfully");
                                $("#loginModaldiaryEdit").css("display", "none");
                                $("#loginModaldiary").css("display", "none");
                                window.location.reload(true);
                            }
                            else {
                                alert("Some error occurred,please try again");
                                window.location.reload(true);
                            }
                        },
                        error: function (jqXHR, textStatus, errorThrown) {
                            $("#loader-wrapper").hide();
                            alert("Some error occurred,please try again");
                            window.location.reload(true);
                        },
                    });

                }
            }
        }
        catch(ex)
        {
            alert("Some error occurred,please try again");
            window.location.reload(true);
        }
    }



