    function GetDispatchDataByDeptType(deptId, tdidType) {
            var html = "";            
            $("#loader-wrapper").show();
            var status = 99;
            var since = $("#sincefilterType").val();                    
            var startDt = $("#Fromdashboardtype").val();
            var endDt = $("#Todashboardtype").val();
            status = GetActionStatusValueType();
            $("#listdiv").html('');
            $("#listdivType").html('');
            var pathurl = '/References/GetDispatchDataByDeptType';
            $.ajax({
                url: pathurl,
                type: 'GET',
                data: { deptId: deptId, status: status, startDt: startDt, endDt: endDt, since: since },
                success: function (result) {
                    if (result.length > 0) {

                        if (@CurrentSession.isApex == 1) {
                            for (var i = 0; i < result.length; i++) {

                                if (result[i].NotImplemented == null || result[i].NotImplemented == "null" || result[i].NotImplemented
                                    == "") {
                                    result[i].NotImplemented = 0;
                                }

                                if (result[i].UnderImplementation == null || result[i].UnderImplementation == "null" || result[i].UnderImplementation
                                    == "") {
                                    result[i].UnderImplementation = 0;
                                }
                                if (result[i].Implemented == null || result[i].Implemented == "null" || result[i].Implemented == "") {
                                    result[i].Implemented = 0;
                                }

                                var Total = result[i].NotImplemented + result[i].UnderImplementation + result[i].Implemented;

                                html = html + "<tr class='trofcType" + tdidType + "'>";
                                html = html + "<td class='center'>  </td> ";
                                html = html + "<td  class='center'>" + result[i].officename + "</td > ";
                                html = html + "<td  class='center'><a onclick='GetDasdhboardDataByOfficeType(this)' DeptId='" + deptId + "' OfcId='" + result[i].officeid + "' StatusId='4'>" + result[i].NotImplemented + "</a> </td > ";
                                html = html + "<td  class='center'><a onclick='GetDasdhboardDataByOfficeType(this)' DeptId='" + deptId + "' OfcId='" + result[i].officeid + "' StatusId='5'>" + result[i].UnderImplementation + "</a> </td > ";
                                html = html + "<td  class='center'><a onclick='GetDasdhboardDataByOfficeType(this)' DeptId='" + deptId + "' OfcId='" + result[i].officeid + "' StatusId='6'>" + result[i].Implemented + "</a> </td > ";
                                html = html + "<td  class='center'><a onclick='GetDasdhboardDataByOfficeType(this)' DeptId='" + deptId + "' OfcId='" + result[i].officeid + "' StatusId='99'>" + Total + "</a> </td > ";
                                "</tr>";
                            }
                        }
                        else {
                           

                            for (var i = 0; i < result.length; i++) {
                                if (result[i].ForApproval == null || result[i].ForApproval == "null" || result[i].ForApproval == "" || result[i].ForApproval == undefined) {
                                    result.ForApproval = 0;
                                }

                                if (result[i].Approved == null || result[i].Approved == "null" || result[i].Approved == "" || result[i].Approved == undefined) {
                                    result[i].Approved = 0;
                                }

                                if (result[i].Rejected == null || result[i].Rejected == "null" || result.Rejected == "" || result[i].Rejected == undefined) {
                                    result[i].Rejected = 0;
                                }

                                if (result[i].Sanctioned == null || result[i].Sanctioned == "null" || result[i].Sanctioned == "" || result[i].Sanctioned == undefined) {
                                    result[i].Sanctioned = 0;
                                }

                                var Total = result[i].ForApproval + result[i].Approved + result[i].Rejected + result[i].Sanctioned;

                                html = html + "<tr class='trofcType" + tdidType + "'>";
                                html = html + "<td class='center'>  </td> ";
                                html = html + "<td  class='center'>" + result[i].officename + "</td > ";
                                html = html + "<td  class='center'>" + result[i].ForApproval + "</td > ";
                                html = html + "<td  class='center'>" + result[i].Approved + "</td > ";
                                html = html + "<td  class='center'>" + result[i].Rejected + "</td > ";
                                html = html + "<td  class='center'>" + result[i].Sanctioned + "</td > ";
                                html = html + "<td  class='center'>" + Total + "</td > ";
                                html = html + "</tr>";
                            }
                        }
                        
                        var expid = '#tr' + tdidType;
                        $(expid).remove();
                        $(html).insertAfter($('#tr' + tdidType));
                        $("#loader-wrapper").hide();
                    }
                    else {
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (result) {
                    $("#loader-wrapper").hide();
                }
            });
        }





    </script>
</head>


