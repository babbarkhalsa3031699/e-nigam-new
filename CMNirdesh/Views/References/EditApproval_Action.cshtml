            padding: 0 !important;
        }

            #MeetingTableApproval .tox .tox-tbtn svg {
                transform: scale(0.85);
            }

        #MeetingTableApproval .tox .tox-tbtn--select {
            height: 22px !important;
            min-height: 22px !important;
