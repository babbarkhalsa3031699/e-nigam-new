            border-right: 1px solid #cbd5e1 !important;
            height: 45px !important;
        }

            /* Responsive Resolution Badge inside TinyMCE Toolbar */
            #MeetingTableApproval .custom-header-group .rsln-header-badge {
                display: flex !important;
                align-items: center !important;
                flex: 2 1 0 !important;
                flex-wrap: wrap !important;
                min-width: 0 !important;
                font-size: 12px !important;
                background-color: #e9ecef;
                padding: 1px 6px !important;
                border-radius: 3px;
                border: 1px solid #ced4da;
                height: 40px !important;
                overflow-x: auto;
                white-space: nowrap;
            }

                #MeetingTableApproval .custom-header-group .rsln-header-badge span,
                #MeetingTableApproval .custom-header-group .rsln-header-badge a {
                    font-size: 14px !important;
                }

                #MeetingTableApproval .custom-header-group .rsln-header-badge::-webkit-scrollbar {
                    height: 3px;
                }

                #MeetingTableApproval .custom-header-group .rsln-header-badge::-webkit-scrollbar-thumb {
                    background: #adb5bd;
                    border-radius: 2px;
                }

            #MeetingTableApproval .custom-header-group select.action-ddl {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                height: 40px !important;
                padding: 1px 4px !important;
                font-size: 12px !important;
                border-radius: 3px !important;
                border: 1px solid #cbd5e1 !important;
                background-color: #ffffff !important;
                color: #333 !important;
            }

            #MeetingTableApproval .custom-header-group .action-save {
                flex: 0 0 40px !important;
                width: 40px !important;
                height: 40px !important;
                padding: 0 !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                text-align: center;
            }

                #MeetingTableApproval .custom-header-group .action-save i {
                    font-size: 20px !important;
