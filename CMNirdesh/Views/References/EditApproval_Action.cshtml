@model CMNirdesh.Models.AgendaDetailModel
@using CMNirdesh.Models;
@{
    Layout = null;
    string BlobPath = CMNirdesh.Models.BlobStorage.GetStorageAcessingPath();
}

@{
    int Sr = 1;
}

<head>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jszip.min.js"></script>
    <script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
    <script src="~/Scripts/datatables/vfs-fonts.js"></script>
    <script src="~/Scripts/datatables/buttons.print.min.js"></script>
    <script src="~/Scripts/datatables/buttons.html5.min.js"></script>
    @*<script src="~/Scripts/tinymce/tinymce.min.js"></script>*@

    <style>
        /* Header Toolbar Combined Group Styling */
        #MeetingTableApproval .custom-header-group {
            display: flex !important;
            align-items: center !important;
            flex: 1 1 auto !important;
            min-width: 0 !important;
            gap: 5px !important;
            padding: 0 6px 0 2px !important;
            margin: 0 !important;
            border-right: 1px solid #cbd5e1 !important;
            height: 45px !important;
        }

            /* Responsive Resolution Badge inside TinyMCE Toolbar */
            #MeetingTableApproval .custom-header-group .rsln-header-badge {
                display: flex !important;
                align-items: center !important;
                flex: 2 1 0 !important;
                flex-wrap: wrap !important;
                min-width: 0 !important;
                font-size: 12px !important;
                background-color: #e9ecef;
                padding: 1px 6px !important;
                border-radius: 3px;
                border: 1px solid #ced4da;
                height: 40px !important;
                overflow-x: auto;
                white-space: nowrap;
            }

                #MeetingTableApproval .custom-header-group .rsln-header-badge span,
                #MeetingTableApproval .custom-header-group .rsln-header-badge a {
                    font-size: 14px !important;
                }

                #MeetingTableApproval .custom-header-group .rsln-header-badge::-webkit-scrollbar {
                    height: 3px;
                }

                #MeetingTableApproval .custom-header-group .rsln-header-badge::-webkit-scrollbar-thumb {
                    background: #adb5bd;
                    border-radius: 2px;
                }

            #MeetingTableApproval .custom-header-group select.action-ddl {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                height: 40px !important;
                padding: 1px 4px !important;
                font-size: 12px !important;
                border-radius: 3px !important;
                border: 1px solid #cbd5e1 !important;
                background-color: #ffffff !important;
                color: #333 !important;
            }

            #MeetingTableApproval .custom-header-group .action-save {
                flex: 0 0 40px !important;
                width: 40px !important;
                height: 40px !important;
                padding: 0 !important;
                display: inline-flex !important;
                align-items: center !important;
                justify-content: center !important;
                text-align: center;
            }

                #MeetingTableApproval .custom-header-group .action-save i {
                    font-size: 20px !important;
                }

        #MeetingTableApproval .tox-tinymce {
            min-height: 400px !important;
            width: 100% !important;
        }

        /* Compact TinyMCE Toolbar */
        #MeetingTableApproval .tox .tox-editor-header {
            background-color: #f8f9fa !important;
            border-bottom: 1px solid #e2e8f0 !important;
            padding: 3px 4px !important;
            margin: 0 !important;
        }

        #MeetingTableApproval .tox .tox-toolbar-overlord {
            background-color: transparent !important;
            padding: 0 !important;
        }

        #MeetingTableApproval .tox .tox-toolbar,
        #MeetingTableApproval .tox .tox-toolbar__overflow,
        #MeetingTableApproval .tox .tox-toolbar__primary {
            background: transparent !important;
            padding: 0 !important;
            margin: 0 !important;
            border: none !important;
            gap: 0 !important;
            row-gap: 10px !important;
            display: flex !important;
            align-items: center !important;
        }

        #MeetingTableApproval .tox .tox-toolbar__group {
            padding: 0 1px !important;
            margin: 0 !important;
            border-right: 1px solid #e2e8f0 !important;
            height: 40px !important;
            display: flex !important;
            align-items: center !important;
        }

            #MeetingTableApproval .tox .tox-toolbar__group:last-child {
                border-right: none !important;
            }

        #MeetingTableApproval .tox .tox-tbtn {
            height: 22px !important;
            min-height: 22px !important;
            width: 22px !important;
            border-radius: 2px !important;
            margin: 0 1px !important;
            padding: 0 !important;
        }

            #MeetingTableApproval .tox .tox-tbtn svg {
                transform: scale(0.85);
            }

        #MeetingTableApproval .tox .tox-tbtn--select {
            height: 22px !important;
            min-height: 22px !important;
            width: auto !important;
            padding: 0 4px !important;
        }

        #MeetingTableApproval .tox .tox-tbtn__select-label {
            font-size: 11px !important;
            line-height: 22px !important;
        }

        #MeetingTableApproval .custom-header-group .drpdwn-container {
            display: flex !important;
            align-items: center !important;
            width: 100% !important;
            flex: 1 1 auto !important;
            min-width: 0 !important;
            gap: 5px !important;
        }

            #MeetingTableApproval .custom-header-group .drpdwn-container > div:nth-child(2) {
                flex: 1 1 0 !important;
                min-width: 0 !important;
            }

        #MeetingTableApproval .tox .tox-toolbar__group.custom-header-group {
            flex: 1 1 100% !important;
            width: 100% !important;
            max-width: none !important;
            border: none !important;
        }

        #MeetingTableApproval .rsln {
            padding: 4px;
            display: flex;
            align-items: flex-start;
            justify-content: center;
        }

        #MeetingTableApproval .drpdwn .dataTables_wrapper input,
        #MeetingTableApproval .drpdwn .dataTables_wrapper select {
            margin-bottom: 0 !important;
            margin: 0px 0px;
        }

        #MeetingTableApproval .tox-statusbar__path {
            display: none !important;
        }

        #MeetingTableApproval td {
            word-wrap: anywhere;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            flex-direction: row;
            padding: 2px 2px 2px 2px !important;
        }

            #MeetingTableApproval td .actionNotingCheckbox {
                margin: 10px 3px 3px 1px;
            }
    </style>

    <script>
        function adjustTinyMceHeights() {
            setTimeout(function () {
                $('#tbodyTypeApproval tr').each(function () {
                    var $row = $(this);
                    var leftTd = $row.find('td:first-child');
                    if (leftTd.length > 0) {
                        var leftHeight = leftTd.outerHeight();
                        var editorTextArea = $row.find('textarea.tiny-editor');
                        if (editorTextArea.length > 0) {
                            var id = editorTextArea.attr('id');
                            var ed = tinymce.get(id);
                            if (ed) {
                                var targetH = Math.max(400, leftHeight - 15);
                                if (ed.theme && ed.theme.resizeTo) {
                                    ed.theme.resizeTo(null, targetH);
                                }
                                var container = ed.getContainer();
                                if (container) {
                                    $(container).css('height', targetH + 'px');
                                    var iframe = $(container).find('iframe');
                                    if (iframe.length) {
                                        var headerH = $(container).find('.tox-editor-header').outerHeight() || 70;
                                        var statusH = $(container).find('.tox-statusbar').outerHeight() || 25;
                                        iframe.css('height', Math.max(250, targetH - headerH - statusH) + 'px');
                                    }
                                }
                            }
                        }
                    }
                });
            }, 300);
        }

        $(window).on('resize', adjustTinyMceHeights);

        var agendaId = @Model.AgendaId;
        var tinyMceDataStoreApproval = {};
        var storageKey = "ActionDescriptionNoting_" + agendaId;

        $(document).ready(function () {

            $('#MeetingTableApproval').DataTable({
                "bLengthChange": false,
                "autoWidth": false,
                pageLength: 100,
                order: [],
                dom: 'Bfrtip',
                buttons: ['excelHtml5', 'csvHtml5', 'pdfHtml5'],

                // ✅ SAVE content before paging / redraw
                preDrawCallback: function () {
                    $('#MeetingTableApproval .tiny-editor').each(function () {
                        var refIds = $(this).data('refid');
                        if (!refIds) return;

                        var safeId = refIds.toString().replace(/,/g, '_');
                        var editor = tinymce.get('MeetingTableApproval_txt_' + safeId);
                        if (editor && editor.getContent()) {

                            var status = $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();
                            var resolutionNo = $(this).data('resolution');
                            tinyMceDataStoreApproval[safeId] = {
                                RefId: safeId,
                                Comments: editor.getContent(),
                                Status: status || '',
                                resolutionNo: resolutionNo
                            };
                        }
                    });
                },

                // ✅ RELOAD + RESTORE after paging
                drawCallback: function () {
                    $('#MeetingTableApproval .tiny-editor').each(function () {
                        var refIds = $(this).data('refid');
                        if (!refIds) return;

                        var safeId = refIds.toString().replace(/,/g, '_');
                        var selector = '#MeetingTableApproval_txt_' + safeId;

                        // 🔥 Destroy old instance if exists
                        if (tinymce.get('MeetingTableApproval_txt_' + safeId)) {
                            tinymce.get('MeetingTableApproval_txt_' + safeId).remove();
                        }

                        // 🔥 Re-init TinyMCE for current page rows
                        tinymce.init({
                            selector: selector,
                            min_height: 400,
                            height: 400,
                            menubar: false,
                            plugins: 'lists link table code',
                            toolbar: 'anxbutton undo redo | bold italic | alignjustify alignleft aligncenter alignright | bullist numlist',
                            toolbar_mode: 'wrap',
                            content_style: `
                                body {
                                    text-align: justify;
                                }
                            `,
                            setup: function (editor) {
                                editor.ui.registry.addSplitButton('anxbutton', {
                                    text: 'Annexure',
                                    onAction: function () { },
                                    onItemAction: function (api, value) {
                                        var file = JSON.parse(value);
                                        var link =
                                            "<a class='hand' href='@BlobPath" + file.FileName + "' " +
                                            "target='_blank' " +
                                            "style='color:blue;text-decoration:underline;cursor: pointer;'>" +
                                            "" + file.isDeleted.replace(".pdf", "") +
                                            "</a>&nbsp;";
                                        editor.insertContent(link);
                                    },
                                    fetch: function (callback) {
                                        var files = (typeof multiFiles !== 'undefined') ? multiFiles : [];
                                        var items = files.map(function (file) {
                                            return {
                                                type: 'choiceitem',
                                                text: file.isDeleted.replace(".pdf",""),
                                                value: JSON.stringify(file)
                                            };
                                        });
                                        callback(items);
                                    }
                                });

                                editor.on('init', async function () {
                                    var refIds = $('#MeetingTableApproval #' + editor.id).data('refid');
                                    var firstId = refIds.toString().replace(/,/g, '_');

                                    // 🔥 MOVE Branch Comments Dropdown & Save Button into TinyMCE Header Toolbar
                                    var $container = $(editor.getContainer());
                                    var $toolbar = $container.find('.tox-toolbar__primary, .tox-toolbar');
                                    var $drpdwn = $('#MeetingTableApproval #drpdwn_' + firstId);

                                    if ($toolbar.length && $drpdwn.length) {

                                        // Remove an existing custom group for this editor
                                        $toolbar.find('.custom-header-group').remove();

                                        // Clone instead of moving the original
                                        var $group = $('<div class="tox-toolbar__group custom-header-group"></div>');

                                        var $clone = $drpdwn.clone(true, true)
                                            .removeAttr('id')
                                            .css('display', '');

                                        // Keep the original inside the DataTables row
                                        // and put only the clone inside TinyMCE
                                        $group.append($clone);

                                        $toolbar.prepend($group);
                                    }

                                    // 🔥 Safe Content Restoration
                                    if (tinyMceDataStoreApproval[firstId]) {
                                        var content = typeof tinyMceDataStoreApproval[firstId] === 'object'
                                            ? tinyMceDataStoreApproval[firstId].Comments
                                            : tinyMceDataStoreApproval[firstId];
                                        editor.setContent(content || '');
                                    }

                                    adjustTinyMceHeights();

                                    let savedDraft = localStorage.getItem(storageKey);
                                    if (savedDraft && savedDraft.trim() !== "") {
                                        fillDraftData(editor, savedDraft, firstId);
                                    } else {
                                        savedDraft = await GetDraftNoting();
                                        if (savedDraft) {
                                            fillDraftData(editor, savedDraft, firstId);
                                        }
                                    }
                                });

                                editor.on('change keyup paste', function () {
                                    saveEditorData(editor, false);
                                });
                                editor.on('blur Undo Redo', function () {
                                    saveEditorData(editor, true);
                                });
                            }
                        });
                    });
                    adjustTinyMceHeights();
                },

                initComplete: function () {
                    $('#MeetingTableApproval_filter').append(`
                        <button type="button" class="btn btn-warning btn-sm ml-2" id="btnRestoreActionApproval" style="display:none;">
                            <i class="fa fa-compress"></i>
                        </button>
                        <button type="button" class="btn btn-success btn-sm ml-2" id="btnSubmitActionApproval" onclick="return saveAllData(event);">
                            Submit
                        </button>
                    `);
                }
            });
        });

        function addTinyMceApprovalHeader(editor, firstId) {

            var $container = $(editor.getContainer());
            var $toolbar = $container.find('.tox-toolbar__primary, .tox-toolbar');

            var $source = $('#MeetingTableApproval #drpdwn_' + firstId);

            if (!$toolbar.length || !$source.length) {
                return;
            }

            // Remove header previously created for this editor
            $toolbar.find('.custom-header-group').remove();

            var $group = $('<div class="tox-toolbar__group custom-header-group"></div>');

            // Clone the complete header
            var $clone = $source.clone(true, true);

            // IDs must be unique
            $clone.removeAttr('id');

            // Make it visible
            $clone.show();

            $group.append($clone);

            $toolbar.prepend($group);
        }

        function fillDraftData(editor, savedDraft, firstId) {
            try {
                var ls = JSON.parse(savedDraft);
                if (ls != null && ls != "" && firstId) {

                    var firstIds = new Set(
                        firstId.split('_').map(function (x) {
                            return x.trim();
                        })
                    );

                    for (const [key, value] of Object.entries(ls)) {
                        const keyIds = key.split("_");
                        let matched = false;

                        for (const el of keyIds) {
                            if (firstIds.has(el)) {
                                editor.setContent(ls[key].Comments || '');
                                tinyMceDataStoreApproval[firstId] = {
                                    RefId: firstId,
                                    Comments: value.Comments || '',
                                    Status: value.Status,
                                    resolutionNo: value.resolutionNo
                                };
                                matched = true;
                                break;
                            }
                        }

                        if (matched) {
                            break;
                        }
                    }
                }
            } catch (e) {
                console.error("Error parsing draft data:", e);
            }
        }

        function saveEditorData(editor, toSave) {
            var $element = $('#' + editor.id);
            var refIds = $element.data('refid');
            var resolutionNo = $element.data('resolution');

            if (!refIds) return;

            var status = $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();
            var comments = editor.getContent();
            var refId = refIds.toString().replace(/,/g, '_');

            tinyMceDataStoreApproval[refId] = {
                RefId: refId,
                Comments: comments,
                Status: status || '',
                resolutionNo: resolutionNo
            };

            localStorage.setItem(storageKey, JSON.stringify(tinyMceDataStoreApproval));

            if (toSave) {
                SaveDraftNoting(storageKey);
            }
        }

        function SaveDraftNoting(storageKey) {
            $.ajax({
                url: '@Url.Action("SaveDraft", "References")',
                type: 'POST',
                data: {
                    UserId: '@CurrentSession.UserID',
                    DraftKey: "Agenda" + agendaId + "_ActionDescriptionNoting_Action" + "@CurrentSession.UserID",
                    DraftContent: localStorage.getItem(storageKey)
                },
                success: function (res) { localStorage.removeItem(storageKey); },
                error: function (xhr, status, error) {
                    console.log("Status:", xhr.status);
                    console.log("Error:", error);
                    console.log("Response:", xhr.responseText);
                }
            });
        }

        async function GetDraftNoting() {
            try {
                var res = await $.ajax({
                    url: '@Url.Action("GetDraft", "References")',
                    type: 'POST',
                    data: {
                        DraftKey: "Agenda" + agendaId + "_ActionDescriptionNoting_Action" + "@CurrentSession.UserID"
                    }
                });
                return res ? res.DraftContent : "";
            }
            catch (xhr) {
                console.log("Status:", xhr.status);
                console.log("Error:", xhr.statusText);
                console.log("Response:", xhr.responseText);
                return "";
            }
        }

        function saveAllData(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            var dataList = [];
            var dataListAll = [];
            const btn = event ? event.target : null;
            if (btn) {
                btn.disabled = true;
                btn.innerText = "Saving...";
            }

            let hasError = false;

            $('#MeetingTableApproval .tiny-editor').each(function () {
                var refIds = $(this).data('refid');
                var resolutionNos = $(this).data('resolution');
                if (!refIds) return;

                var safeId = refIds.toString().replace(/,/g, '_');
                var editor = tinymce.get('MeetingTableApproval_txt_' + safeId);
                var comments = editor ? editor.getContent() : '';
                var status = $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();

                var editorCheckbox = $(this).closest('td').find('#actionSubmitCheckbox');
                var isChecked = $(editorCheckbox).is(':checked');

                if (!comments || comments.trim() === "") {
                    alert("Comment cannot be empty for Resolution No(s): " + resolutionNos);
                    hasError = true;
                    return false; // break loop
                }

                if (!status) {
                    alert("Please select status for Resolution No(s): " + resolutionNos);
                    hasError = true;
                    return false;
                }

                // split multiple ids
                var refIdArray = refIds.toString().split(',');

                refIdArray.forEach(function (id) {

                    if (id.trim() !== '') {
                        dataListAll.push({
                            RefId: id.trim(),
                            Comments: comments,
                            Status: status
                        });
                    }
                });

                if (isChecked && $('#MeetingTableApproval .tiny-editor').length > 1) {

                    refIdArray.forEach(function (id) {

                        if (id.trim() !== '') {
                            dataList.push({
                                RefId: id.trim(),
                                Comments: comments,
                                Status: status
                            });
                        }
                    });
                    // count++;  // 🔥 increment only per row
                }
            });

            if (hasError) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = "Submit";
                }
                return;
            }

            // 🔄 show loader (if exists)
            $('#loader-wrapper').show();
            $.ajax({
                url:'@Url.Action("UpdateBulkData", "References")' ,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(dataList.length > 0 ? dataList : dataListAll),

                success: function () {
                    // ✅ success UI
                    btn.disabled = true;
                    btn.innerText = "Submitted";
                    alert("All data saved successfully");       
                },
                error: function () {
                    alert("Error saving data");
                },
                complete: function () {
                    $('#loader-wrapper').hide();
                    if (btn) {
                        btn.disabled = false;
                        btn.innerText = "Submit";
                    }
                }
            });

            return false;
        }

        function saveRowDraft(btn, refIds) {
            var row = $(btn).closest('tr');
            var safeId = refIds.toString().replace(/,/g, '_');
            var editor = tinymce.get('MeetingTableApproval_txt_' + safeId);
            var comments = editor ? editor.getContent() : '';
            var status = $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();

            if (!status || status === "") {
                alert("Please select status");
                return;
            }

            if (!comments || comments.trim() === '') {
                alert('Please enter comments');
                return;
            }

            btn.disabled = true;
            //btn.innerText = 'Saving...';
            if (refIds.trim() === '') return;

            $.ajax({
                url: '@Url.Action("SaveDraftRow", "References")',
                type: 'POST',
                data: {
                    RefId: refIds.toString().trim(),
                    Comments: comments,
                    Status: status
                },
                success: function (res) {
                    if (res.Status == 1 || res.Status == "1") {
                        row.css('background', '#fff3cd');
                        $(btn).html('<i class="fa fa-check-square-o"></i>');
                        setTimeout(function () {
                            $(btn).html('<i class="fa fa-floppy-o"></i>');
                            btn.disabled = false;
                            row.css('background', 'none');
                        }, 2000);
                    } else {
                        alert(res.Message || 'Failed to save draft');
                        btn.disabled = false;
                        row.css('background', 'none');
                        $(btn).html('<i class="fa fa-floppy-o"></i>');
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Status:", xhr.status);
                    console.log("Error:", error);
                    console.log("Response:", xhr.responseText);
                    //alert('Error saving draft');
                    btn.disabled = false;
                    row.css('background', 'none');
                    $(btn).html('<i class="fa fa-floppy-o"></i>');
                }
            });
        }

    </script>
</head>

<div>
    <div class="main-content">
        <div class="col-md-12 col-lg-12 col-xl-12 table-responsive" id="statusdivApproval" style="margin-top: 15px;">
            <table class="table table-bordered" id="MeetingTableApproval" aria-describedby="sample-table-3_info" style="border-collapse: collapse;">
                <thead>
                    <tr style="color: white; font-size:16px; font-weight:bold;">
                        @*<th class="center" style="width:10% !important; font-size:16px;" id="tdFrom" rowspan="1" colspan="1">Resolution No.</th>*@
                        <th class="center" style="width:90% !important; font-size:16px;" id="tdFromApproval" rowspan="1" colspan="1">Add Action</th>
                    </tr>
                </thead>

                <tbody class="bordered" role="alert" aria-live="polite" aria-relevant="all" id="tbodyTypeApproval">
                    @foreach (var items in Model._LstResolutionActions)
                    {
                        <tr role="row" style="font-size: 16px; color: black; border: 1px solid #D3D3D3;">
                            @*<td style="font-size:16px; border:1px solid #D3D3D3; width:10% !important; vertical-align:top; padding:10px; text-align:center; display: none;">
                                    <div class="rsln">
                                        @{
                                            var resolutionList = items.ResolutionNo.Split(',');
                                            var refIdList = items.RefId.Split(',');
                                        }

                                        @for (int i = 0; i < resolutionList.Length; i++)
                                        {
                                            var resolution = resolutionList[i].Trim();
                                            var currentRefId = (i < refIdList.Length) ? refIdList[i].Trim() : "";

                                            <a href="javascript:void(0);"
                                               onclick="ShowSDPopUp(0,'@currentRefId')"
                                               title="Open Resolution"
                                               style="color:#007bff;cursor:pointer;font-weight:bold;font-size:16px;">
                                                @resolution
                                            </a>

                                            if (i < resolutionList.Length - 1)
                                            {
                                                @:,
                                            }
                                        }
                                    </div>
                                </td>*@
                            <td style="font-size: 16px; border: 1px solid #D3D3D3;">
                                <div class="drpdwn-container" id="drpdwn_@items.RefId.Replace(",", "_")" style="display:none;">
                                    <!-- 🔥 Resolution No. Badge inside TinyMCE Header -->
                                    <div class="rsln-header-badge" title="Resolution No(s)">
                                        <span style="font-weight:700; color:#495057; margin-right: 5px;">Resolution No:</span>
                                        @{
                                            var resolutionListHeader = items.ResolutionNo.Split(',');
                                            var refIdListHeader = items.RefId.Split(',');
                                        }
                                        @for (int i = 0; i < resolutionListHeader.Length; i++)
                                        {
                                            var resolution = resolutionListHeader[i].Trim();
                                            var currentRefId = (i < refIdListHeader.Length) ? refIdListHeader[i].Trim() : "";

                                            <a href="javascript:void(0);"
                                               onclick="ShowSDPopUp(0,'@currentRefId')"
                                               title="Open Resolution @resolution"
                                               style="color:#007bff; cursor:pointer; font-weight:bold; text-decoration:underline;">
                                                @resolution
                                            </a>

                                            if (i < resolutionListHeader.Length - 1)
                                            {
                                                <span style="color:#6c757d; margin-right: 2px;">,</span>
                                            }
                                        }
                                    </div>
                                    <div>
                                        <!-- 🔥 Branch Comments Dropdown -->
                                        @{
                                            var actionList = Model.ActionTypeList_Ref.ToList();
                                        }

                                        @if (actionList.Count == 1)
                                        {
                                            @Html.DropDownList(
                                                "ActionCode_" + items.RefId,
                                                new SelectList(actionList, "Value", "Text", actionList[0].Value),
                                                new
                                                {
                                                    @class = "action-ddl",
                                                    data_refid = items.RefId
                                                })
                                        }
                                        else
                                        {
                                            @Html.DropDownList(
                                                "ActionCode_" + items.RefId,
                                                new SelectList(actionList, "Value", "Text", items.StatusName),
                                                "Select",
                                                new
                                                {
                                                    @class = "action-ddl",
                                                    data_refid = items.RefId
                                                })
                                        }
                                    </div>
                                    <div>
                                        <button type="button"
                                                class="action-save btn btn-warning btn-sm"
                                                onclick="saveRowDraft(this,'@items.RefId')"
                                                title="Save Draft">
                                            <i class="fa fa-floppy-o"></i>
                                        </button>
                                    </div>

                                </div>
                                @if (Model._LstResolutionActions.Count > 1)
                                {
                                    <div class="actionNotingCheckbox">
                                        <input type="checkbox" id="actionSubmitCheckboxApproval" />
                                    </div>
                                }
                                <textarea class="tiny-editor"
                                          id="MeetingTableApproval_txt_@items.RefId.Replace(",", "_")"
                                          data-refid="@items.RefId"
                                          data-resolution="@items.ResolutionNo">@(string.IsNullOrEmpty(items.LGComments) ? items.ActionDescription : items.LGComments)</textarea>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:15px; text-align:right;">
                <button type="button"
                        class="btn btn-success"
                        onclick="return saveAllData(event);">
                    Submit
                </button>
            </div>
        </div>
    </div>
</div>