        }

        #MeetingTableApproval .tox .tox-toolbar-overlord {
            background-color: transparent !important;
            padding: 0 !important;
        }

        #MeetingTableApproval .tox .tox-toolbar,
        #MeetingTableApproval .tox .tox-toolbar__overflow,
        #MeetingTableApproval .tox .tox-toolbar__primary {
            background: transparent !important;
            padding: 0 !important;
            margin: 0 !important;
            border: none !important;
            gap: 0 !important;
            row-gap: 10px !important;
            display: flex !important;
            align-items: center !important;
        }

        #MeetingTableApproval .tox .tox-toolbar__group {
            padding: 0 1px !important;
            margin: 0 !important;
            border-right: 1px solid #e2e8f0 !important;
            height: 40px !important;
            display: flex !important;
            align-items: center !important;
        }

            #MeetingTableApproval .tox .tox-toolbar__group:last-child {
                border-right: none !important;
            }

        #MeetingTableApproval .tox .tox-tbtn {
            height: 22px !important;
            min-height: 22px !important;
            width: 22px !important;
            border-radius: 2px !important;
