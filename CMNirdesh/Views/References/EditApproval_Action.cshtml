        }

            #MeetingTableApproval td .actionNotingCheckboxApproval {
                margin: 10px 3px 3px 1px;
            }

        #MeetingTableApproval .split-btn {
            padding: 4px 8px;
            margin-left: 10px;
            font-weight: 600;
        }
    </style>

    <script>
        function adjustTinyMceHeights() {
            setTimeout(function () {
                $('#tbodyTypeApproval tr').each(function () {
                    var $row = $(this);
                    var leftTd = $row.find('td:first-child');
                    if (leftTd.length > 0) {
                        var leftHeight = leftTd.outerHeight();
                        var editorTextArea = $row.find('textarea.tiny-editor');
                        if (editorTextArea.length > 0) {
                            var id = editorTextArea.attr('id');
                            var ed = tinymce.get(id);
                            if (ed) {
                                var targetH = Math.max(400, leftHeight - 15);
                                if (ed.theme && ed.theme.resizeTo) {
                                    ed.theme.resizeTo(null, targetH);
                                }
                                var container = ed.getContainer();
                                if (container) {
                                    $(container).css('height', targetH + 'px');
                                    var iframe = $(container).find('iframe');
                                    if (iframe.length) {
                                        var headerH = $(container).find('.tox-editor-header').outerHeight() || 70;
                                        var statusH = $(container).find('.tox-statusbar').outerHeight() || 25;
                                        iframe.css('height', Math.max(250, targetH - headerH - statusH) + 'px');
                                    }
                                }
                            }
                        }
                    }
                });
            }, 300);
        }

        $(window).on('resize', adjustTinyMceHeights);

        var agendaId = @Model.AgendaId;
        var tinyMceDataStoreApproval = {};
        var storageKey = "ActionDescriptionNoting_" + agendaId;

        function initTinyMceForSelector(selector) {
            var $el = $(selector);
            if (!$el.length) return;

            var safeId = selector.replace('#MeetingTableApproval_txt_', '');

            // 🔥 Destroy old instance if exists
            if (tinymce.get('MeetingTableApproval_txt_' + safeId)) {
                tinymce.get('MeetingTableApproval_txt_' + safeId).remove();
            }

            // 🔥 Re-init TinyMCE for selector
            tinymce.init({
                selector: selector,
                min_height: 400,
                height: 400,
                menubar: false,
                plugins: 'lists link table code',
                toolbar: 'anxbutton undo redo | bold italic | alignjustify alignleft aligncenter alignright | bullist numlist',
                toolbar_mode: 'wrap',
                content_style: `
                    body {
                        text-align: justify;
                    }
                `,
                setup: function (editor) {
                    function getAnnexureFiles() {
                        var files = [];
                        if (typeof window.multiFiles !== 'undefined' && Array.isArray(window.multiFiles) && window.multiFiles.length > 0) {
                            files = window.multiFiles.slice();
                        } else if (typeof multiFiles !== 'undefined' && Array.isArray(multiFiles) && multiFiles.length > 0) {
                            files = multiFiles.slice();
                        } else if (window.parent && typeof window.parent.multiFiles !== 'undefined' && Array.isArray(window.parent.multiFiles) && window.parent.multiFiles.length > 0) {
                            files = window.parent.multiFiles.slice();
                        }

                        var extraFiles = [];
                        if (typeof window.mlfiles !== 'undefined' && Array.isArray(window.mlfiles)) {
                            extraFiles = window.mlfiles;
                        } else if (typeof mlfiles !== 'undefined' && Array.isArray(mlfiles)) {
                            extraFiles = mlfiles;
                        } else if (window.parent && typeof window.parent.mlfiles !== 'undefined' && Array.isArray(window.parent.mlfiles)) {
                            extraFiles = window.parent.mlfiles;
                        }
                        if (extraFiles && extraFiles.length > 0) {
                            files = files.concat(extraFiles);
                        }

                        // Fallback: If still empty, scrape from DOM elements of _ActionTaken
                        if (!files || files.length === 0) {
                            $('.abc a[href], #divEnfile a[href], #MultipleFile a[href]').each(function () {
                                var $a = $(this);
                                var href = $a.attr('href') || '';
                                var text = $a.text().trim();
                                if (href && href !== '#' && href.indexOf('javascript') === -1 && text) {
                                    var fileName = href.replace('@BlobPath', '');
                                    files.push({
                                        FileName: fileName,
                                        isDeleted: text,
                                        name: text
                                    });
                                }
                            });
                        }

                        // Deduplicate
                        var seen = {};
                        var uniqueFiles = [];
                        for (var i = 0; i < files.length; i++) {
                            var f = files[i];
                            if (!f) continue;
                            var key = (f.FileName || f.name || '') + '_' + (f.isDeleted || '');
                            if (!seen[key]) {
                                seen[key] = true;
                                uniqueFiles.push(f);
                            }
                        }
                        return uniqueFiles;
                    }

                    function insertAnnexureLink(file) {
                        if (!file) return;
                        var displayName = (file.isDeleted || file.name || file.FileName || "Annexure").toString().replace(/\.pdf$/i, "").trim();
                        var fileName = file.FileName || file.name || "";
                        var fullUrl = '@BlobPath' + fileName;
                        var link = "<a class='hand' href='" + fullUrl + "' target='_blank' style='color:blue;text-decoration:underline;cursor: pointer;'>" + displayName + "</a>&nbsp;";
                        editor.insertContent(link);
                    }

                    editor.ui.registry.addSplitButton('anxbutton', {
                        text: 'Annexure',
                        onAction: function () {
                            var files = getAnnexureFiles();
                            if (files && files.length > 0) {
                                insertAnnexureLink(files[0]);
                            }
                        },
                        onItemAction: function (api, value) {
                            if (!value) return;
                            try {
                                var file = JSON.parse(value);
                                insertAnnexureLink(file);
                            } catch (e) {
                                console.error("Error inserting annexure link:", e);
                            }
                        },
                        fetch: function (callback) {
                            var files = getAnnexureFiles();
                            if (!files || files.length === 0) {
                                callback([{
                                    type: 'choiceitem',
                                    text: 'No Annexures Found',
                                    value: ''
                                }]);
                                return;
                            }
                            var items = files.map(function (file) {
                                var displayName = (file.isDeleted || file.name || file.FileName || "Document").toString().replace(/\.pdf$/i, "").trim();
                                return {
                                    type: 'choiceitem',
                                    text: displayName,
                                    value: JSON.stringify(file)
                                };
                            });
                            callback(items);
                        }
                    });

                    editor.on('click', function (e) {
                        var anchor = e.target.closest ? e.target.closest('a') : (e.target.nodeName === 'A' ? e.target : null);
                        if (anchor && anchor.href) {
                            var href = anchor.getAttribute('href') || anchor.href;
                            if (href && href !== '#' && href.indexOf('javascript:') !== 0) {
                                e.preventDefault();
                                window.open(anchor.href, '_blank');
                            }
                        }
                    });

                    editor.on('init', async function () {
                        var refIds = $('#MeetingTableApproval #' + editor.id).data('refid');
                        var firstId = refIds ? refIds.toString().replace(/,/g, '_') : safeId;

                        // 🔥 MOVE Branch Comments Dropdown & Save Button into TinyMCE Header Toolbar
                        var $container = $(editor.getContainer());
                        var $toolbar = $container.find('.tox-toolbar__primary, .tox-toolbar');
                        var $drpdwn = $('#MeetingTableApproval #drpdwn_' + firstId);

                        if ($toolbar.length && $drpdwn.length) {

                            // Remove an existing custom group for this editor
                            $toolbar.find('.custom-header-group').remove();

                            // Clone instead of moving the original
                            var $group = $('<div class="tox-toolbar__group custom-header-group"></div>');

                            var $clone = $drpdwn.clone(true, true)
                                .removeAttr('id')
                                .css('display', '');

                            var $origSelect = $drpdwn.find('.action-ddl');
                            var $cloneSelect = $clone.find('.action-ddl');

                            // Sync initial value (or from tinyMceDataStoreApproval if restored)
                            var initialStatus = $origSelect.val();

                            if (initialStatus) {
                                $origSelect.val(initialStatus);
                                $cloneSelect.val(initialStatus);
                            }

                            // Sync clone -> original on change
                            $cloneSelect.off('change.syncStatus').on('change.syncStatus', function () {
                                var val = $(this).val();
                                $origSelect.val(val);
                                saveEditorData(editor, false);
                            });

                            // Sync original -> clone on change
                            $origSelect.off('change.syncStatus').on('change.syncStatus', function () {
                                var val = $(this).val();
                                $cloneSelect.val(val);
                            });

                            // Keep the original inside the DataTables row
                            // and put only the clone inside TinyMCE
                            $group.append($clone);

                            $toolbar.prepend($group);
                        }

                        // 🔥 Safe Content Restoration
                        if (tinyMceDataStoreApproval[firstId]) {
                            var content = typeof tinyMceDataStoreApproval[firstId] === 'object'
                                ? tinyMceDataStoreApproval[firstId].Comments
                                : tinyMceDataStoreApproval[firstId];
                            if (content) {
                                editor.setContent(content || '');
                            }
                        }

                        adjustTinyMceHeights();

                        let savedDraft = localStorage.getItem(storageKey);
                        if (savedDraft && savedDraft.trim() !== "") {
                            fillDraftData(editor, savedDraft, firstId);
                        } else {
                            savedDraft = await GetDraftNoting();
                            if (savedDraft) {
                                fillDraftData(editor, savedDraft, firstId);
                            }
                        }
                    });

                    editor.on('change keyup paste', function () {
                        saveEditorData(editor, false);
                    });
                    editor.on('blur Undo Redo', function () {
                        saveEditorData(editor, true);
                    });
                }
            });
        }

        function createSplitRowHtml(rId, rNo, selectOptionsHtml, content) {
            return `
                <tr role="row" style="font-size: 16px; color: black; border: 1px solid #D3D3D3;">
                    <td style="font-size: 16px; border: 1px solid #D3D3D3;">
                        <div class="drpdwn-container" id="drpdwn_${rId}" style="display:none;">
                            <div class="rsln-header-badge" title="Resolution No">
                                <span style="font-weight:700; color:#495057; margin-right: 5px;">Resolution No:</span>
                                <a href="javascript:void(0);"
                                   onclick="ShowSDPopUp(0,'${rId}')"
                                   title="Open Resolution ${rNo}"
                                   style="color:#007bff; cursor:pointer; font-weight:bold; text-decoration:underline;">
                                    ${rNo}
                                </a>
                            </div>
                            <div>
                                <select class="action-ddl" name="ActionCode_${rId}" data-refid="${rId}">
                                    ${selectOptionsHtml}
                                </select>
                            </div>
                            <div>
                                <button type="button"
                                        class="action-save btn btn-warning btn-sm"
                                        onclick="saveRowDraft(this,'${rId}')"
                                        title="Save Draft">
                                    <i class="fa fa-floppy-o"></i>
                                </button>
                            </div>
                        </div>
                        <div class="actionNotingCheckboxApproval">
                            <input type="checkbox" id="actionSubmitCheckboxApproval" />
                        </div>
                        <textarea class="tiny-editor"
                                  id="MeetingTableApproval_txt_${rId}"
                                  data-refid="${rId}"
                                  data-resolution="${rNo}">${content || ''}</textarea>
                    </td>
                </tr>
            `;
        }

        function splitRowsFromDraft(draftObj) {
            if (!draftObj || typeof draftObj !== 'object') return false;
            var wasAnyRowSplit = false;

            $('#tbodyTypeApproval tr').each(function () {
                var $row = $(this);
                var $textarea = $row.find('textarea.tiny-editor');
                if (!$textarea.length) return;

                var refIds = $textarea.data('refid');
                if (!refIds) return;

                var refIdList = refIds.toString().split(',').map(function (x) { return x.trim(); }).filter(Boolean);
                if (refIdList.length <= 1) return;

                var safeId = refIds.toString().replace(/,/g, '_');

                // Check if draftObj has individual keys for this row
                var hasIndividualInDraft = refIdList.some(function (id) {
                    return draftObj[id] !== undefined && draftObj[id] !== null;
                });

                if (hasIndividualInDraft) {
                    var $origDropdown = $('#drpdwn_' + safeId);
                    var $select = $origDropdown.find('select.action-ddl');
                    if (!$select.length) {
                        $select = $row.find('select.action-ddl');
                    }
                    var selectOptionsHtml = $select.length ? $select.html() : '';
                    var resAttr = $textarea.data('resolution') || '';
                    var resNoList = resAttr.toString().split(',').map(function (x) { return x.trim(); }).filter(Boolean);
                    var defaultContent = $textarea.val();

                    var totalItems = Math.max(refIdList.length, resNoList.length);
                    var newRowsHtml = '';

                    for (var i = 0; i < totalItems; i++) {
                        var rId = (i < refIdList.length) ? refIdList[i] : resNoList[i];
                        var rNo = (i < resNoList.length) ? resNoList[i] : (draftObj[rId] && draftObj[rId].resolutionNo ? draftObj[rId].resolutionNo : rId);
                        var itemContent = (draftObj[rId] && draftObj[rId].Comments)
                            ? draftObj[rId].Comments
                            : defaultContent;

                        newRowsHtml += createSplitRowHtml(rId, rNo, selectOptionsHtml, itemContent);
                    }

                    var $newRows = $(newRowsHtml);
                    $row.replaceWith($newRows);

                    // Set tinyMceDataStoreApproval for each split item
                    for (var j = 0; j < totalItems; j++) {
                        var newId = (j < refIdList.length) ? refIdList[j] : resNoList[j];
                        var newRes = (j < resNoList.length) ? resNoList[j] : (draftObj[newId] && draftObj[newId].resolutionNo ? draftObj[newId].resolutionNo : newId);
                        //var itemStatus = draftObj[newId] && draftObj[newId].Status ? draftObj[newId].Status : '';
                        //if (itemStatus) {
                        //    $('#MeetingTableApproval #drpdwn_' + newId + ' select.action-ddl').val(itemStatus);
                        //}

                        tinyMceDataStoreApproval[newId] = {
                            RefId: newId,
                            Comments: (draftObj[newId] && draftObj[newId].Comments) ? draftObj[newId].Comments : defaultContent,
                            //Status: itemStatus,
                            resolutionNo: newRes
                        };
                    }

                    delete tinyMceDataStoreApproval[safeId];
                    wasAnyRowSplit = true;
                }
            });

            if (wasAnyRowSplit || $('#MeetingTableApproval tbody tr').length > 1) {
                $('#MeetingTableApproval tbody tr').each(function () {
                    if ($(this).find('.actionNotingCheckboxApproval').length === 0) {
                        $(this).find('td').prepend('<div class="actionNotingCheckboxApproval"><input type="checkbox" id="actionSubmitCheckboxApproval"/></div>');
                    }
                });
            }

            return wasAnyRowSplit;
        }

        $(document).ready(async function () {
            // 1. Fetch saved draft first
            let savedDraft = localStorage.getItem(storageKey);
            if (!savedDraft || savedDraft.trim() === "") {
                savedDraft = await GetDraftNoting();
                if (savedDraft && savedDraft.trim() !== "") {
                    localStorage.setItem(storageKey, savedDraft);
                }
            }

            var draftObj = null;
            if (savedDraft && savedDraft.trim() !== "") {
                try {
                    draftObj = JSON.parse(savedDraft);
                    if (draftObj && typeof draftObj === 'object') {
                        tinyMceDataStoreApproval = Object.assign({}, draftObj);
                    }
                } catch (e) {
                    console.error("Error parsing draft data:", e);
                }
            }

            // 2. If draft has split refIds, split rows in DOM before DataTable initializes
            if (draftObj) {
                splitRowsFromDraft(draftObj);
            }

            // 3. Initialize DataTable
            $('#MeetingTableApproval').DataTable({
                "bLengthChange": false,
                "autoWidth": false,
                pageLength: 100,
                order: [],
                dom: 'Bfrtip',
                buttons: ['excelHtml5', 'csvHtml5', 'pdfHtml5'],
                // ✅ SAVE content before paging / redraw
                preDrawCallback: function () {
                    $('#MeetingTableApproval .tiny-editor').each(function () {
                        var refIds = $(this).data('refid');
                        if (!refIds) return;

                        var safeId = refIds.toString().replace(/,/g, '_');
                        var $editorElement = $('#MeetingTableApproval')
                            .find('#MeetingTableApproval_txt_' + safeId);
                        var editor = tinymce.get($editorElement.attr('id'));
                        if (editor && editor.getContent()) {

                            var $editorContainer = $(editor.getContainer());
                            var status = ($editorContainer.length ? $editorContainer.find('select.action-ddl').val() : null)
                                || $('#MeetingTableApproval select.action-ddl[data-refid="' + refIds + '"]:visible').val()
                                || $('#MeetingTableApproval #drpdwn_' + safeId + ' select.action-ddl').val()
                                || $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();

                            var resolutionNo = $(this).data('resolution');
                            tinyMceDataStoreApproval[safeId] = {
                                RefId: safeId,
                                Comments: editor.getContent(),
                                //Status: status || '',
                                resolutionNo: resolutionNo
                            };
                        }
                    });
                },

                // ✅ RELOAD + RESTORE after paging
                drawCallback: function () {
                    $('#MeetingTableApproval .tiny-editor').each(function () {
                        var refIds = $(this).data('refid');
                        if (!refIds) return;

                        var safeId = refIds.toString().replace(/,/g, '_');
                        var selector = '#MeetingTableApproval_txt_' + safeId;
                        initTinyMceForSelector(selector);
                    });
                    adjustTinyMceHeights();
                },

                initComplete: function () {
                    $('#MeetingTableApproval_filter').append(`
                        <button type="button" class="btn btn-warning btn-sm ml-2" id="btnRestoreActionApproval" style="display:none;">
                            <i class="fa fa-compress"></i>
                        </button>
                        <button type="button" class="btn btn-success btn-sm ml-2" id="btnSubmitActionApproval" onclick="return saveAllData(event);">
                            Submit
                        </button>
                    `);
                }
            });
        });

        function fillDraftData(editor, savedDraft, firstId) {
            try {
                var ls = typeof savedDraft === 'string' ? JSON.parse(savedDraft) : savedDraft;
                if (!ls || !firstId) return;

                // 1. Direct match by firstId
                if (ls[firstId] && ls[firstId].Comments) {
                    editor.setContent(ls[firstId].Comments || '');
                    //var draftStatus = ls[firstId].Status;
                    //if (draftStatus) {
                    //    var $editorContainer = $(editor.getContainer());
                    //    if ($editorContainer.length) {
                    //        $editorContainer.find('.action-ddl').val(draftStatus);
                    //    }
                    //    $('#MeetingTableApproval #drpdwn_' + firstId + ' select.action-ddl').val(draftStatus);
                    //}
                    tinyMceDataStoreApproval[firstId] = {
                        RefId: firstId,
                        Comments: ls[firstId].Comments || '',
                        //Status: draftStatus,
                        resolutionNo: ls[firstId].resolutionNo
                    };
                    return;
                }

                // 2. Fallback matching for multi-id sets
                var firstIds = new Set(
                    firstId.split('_').map(function (x) {
                        return x.trim();
                    })
                );

                for (const [key, value] of Object.entries(ls)) {
                    const keyIds = key.split("_");
                    let matched = false;

                    for (const el of keyIds) {
                        if (firstIds.has(el) && value.Comments) {
                            editor.setContent(value.Comments || '');
                            //var draftStatus = value.Status;
                            //if (draftStatus) {
                            //    var $editorContainer = $(editor.getContainer());
                            //    if ($editorContainer.length) {
                            //        $editorContainer.find('.action-ddl').val(draftStatus);
                            //    }
                            //    $('#MeetingTableApproval #drpdwn_' + firstId + ' select.action-ddl').val(draftStatus);
                            //}
                            tinyMceDataStoreApproval[firstId] = {
                                RefId: firstId,
                                Comments: value.Comments || '',
                                //Status: draftStatus,
                                resolutionNo: value.resolutionNo
                            };
                            matched = true;
                            break;
                        }
                    }

                    if (matched) {
                        break;
                    }
                }
            } catch (e) {
                console.error("Error parsing draft data:", e);
            }
        }

        function saveEditorData(editor, toSave) {
            var $element = $('#' + editor.id);
            var refIds = $element.data('refid');
            var resolutionNo = $element.data('resolution');

            if (!refIds) return;

            var $editorContainer = $(editor.getContainer());
            var safeRefId = refIds.toString().replace(/,/g, '_');
            var status = ($editorContainer.length ? $editorContainer.find('select.action-ddl').val() : null)
                || $('#MeetingTableApproval select.action-ddl[data-refid="' + refIds + '"]:visible').val()
                || $('#MeetingTableApproval #drpdwn_' + safeRefId + ' select.action-ddl').val()
                || $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();

            var comments = editor.getContent();
            var refId = refIds.toString().replace(/,/g, '_');

            tinyMceDataStoreApproval[refId] = {
                RefId: refId,
                Comments: comments ? comments : (Object.entries(tinyMceDataStoreApproval).length && tinyMceDataStoreApproval[refId] && tinyMceDataStoreApproval[refId].Comments
                    ? tinyMceDataStoreApproval[refId].Comments : ""),
                //Status: status || '',
                resolutionNo: resolutionNo
            };

            localStorage.setItem(storageKey, JSON.stringify(tinyMceDataStoreApproval));

            if (toSave) {
                SaveDraftNoting(storageKey);
            }
        }

        function SaveDraftNoting(storageKey) {
            $.ajax({
                url: '@Url.Action("SaveDraft", "References")',
                type: 'POST',
                data: {
                    UserId: '@CurrentSession.UserID',
                    DraftKey: "Agenda" + agendaId + "_ActionDescriptionNoting_Action" + "@CurrentSession.UserID",
                    DraftContent: localStorage.getItem(storageKey)
                },
                success: function (res) { localStorage.removeItem(storageKey); },
                error: function (xhr, status, error) {
                    console.log("Status:", xhr.status);
                    console.log("Error:", error);
                    console.log("Response:", xhr.responseText);
                }
            });
        }

        async function GetDraftNoting() {
            try {
                var res = await $.ajax({
                    url: '@Url.Action("GetDraft", "References")',
                    type: 'POST',
                    data: {
                        DraftKey: "Agenda" + agendaId + "_ActionDescriptionNoting_Action" + "@CurrentSession.UserID"
                    }
                });
                return res ? res.DraftContent : "";
            }
            catch (xhr) {
                console.log("Status:", xhr.status);
                console.log("Error:", xhr.statusText);
                console.log("Response:", xhr.responseText);
                return "";
            }
        }

        function DeleteDraftNoting(data) {
             try {
                 var res = $.ajax({
                     url: '@Url.Action("DeleteDraftDirect", "References")',
                     type: 'POST',
                     data: {
                         DraftKey: "Agenda" + agendaId + "_ActionDescriptionNoting_Action" + "@CurrentSession.UserID",
                         Data: data
                     }
                 });
                 return res ? res.DraftContent : "";
             }
             catch (xhr) {
                 console.log("Status:", xhr.status);
                 console.log("Error:", xhr.statusText);
                 console.log("Response:", xhr.responseText);
                 return "";
             }
         }

        function saveAllData(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            var dataList = [];
            var dataListAll = [];
            const btn = event ? event.target : null;
            if (btn) {
                btn.disabled = true;
                btn.innerText = "Saving...";
            }

            let hasError = false;

            let commentError = false;
            let commentErrorResolutions = '';

            let statusError = false;
            let statusErrorResolutions = '';

            $('#MeetingTableApproval .tiny-editor').each(function () {
                var refIds = $(this).data('refid');
                var resolutionNos = $(this).data('resolution');
                if (!refIds) return;

                var safeId = refIds.toString().replace(/,/g, '_');
                var editor = tinymce.get('MeetingTableApproval_txt_' + safeId);
                var comments = editor ? editor.getContent() : '';
                var $editorContainer = editor ? $(editor.getContainer()) : null;
                var status = ($editorContainer && $editorContainer.length ? $editorContainer.find('select.action-ddl').val() : null)
                    || $('#MeetingTableApproval select.action-ddl[data-refid="' + refIds + '"]:visible').val()
                    || $('#MeetingTableApproval #drpdwn_' + safeId + ' select.action-ddl').val()
                    || $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();

                var editorCheckbox = $(this).closest('td').find('#actionSubmitCheckboxApproval');
                var isChecked = $(editorCheckbox).is(':checked');

                if (isChecked) { // if any checked
                    hasError = false;
                    commentError = false;
                    commentErrorResolutions = '';
                    statusError = false;
                    statusErrorResolutions = '';

                    if (!comments || comments.trim() === "") { // check current comments
                        commentError = true;
                        commentErrorResolutions = resolutionNos;
                        //alert("Comment cannot be empty for Resolution No(s): " + resolutionNos);
                        hasError = true;
                        return false;
                    }
                    if (!status) { // check current status
                        statusError = true;
                        statusErrorResolutions = resolutionNos;
                        //alert("Please select status for Resolution No(s): " + resolutionNos);
                        hasError = true;
                        return false;
                    }
                }
                else if (!commentError) {
                    if ((!comments || comments.trim() === "") && !dataList.length) { // check current comments
                        commentError = true;
                        commentErrorResolutions = resolutionNos;
                        hasError = true;
                    }
                }
                else if (!statusError) {
                    if (!status && !dataList.length) { // check current status
                        statusError = true;
                        statusErrorResolutions = resolutionNos;
                        hasError = true;
                    }
                }

                //if (!comments || comments.trim() === "") {
                //    alert("Comment cannot be empty for Resolution No(s): " + resolutionNos);
                //    hasError = true;
                //    return false; // break loop
                //}

                //if (!status) {
                //    alert("Please select status for Resolution No(s): " + resolutionNos);
                //    hasError = true;
                //    return false;
                //}

                // split multiple ids
                var refIdArray = refIds.toString().split(',');

                refIdArray.forEach(function (id) {

                    if (id.trim() !== '') {
                        dataListAll.push({
                            RefId: id.trim(),
                            Comments: comments,
                            Status: status
                        });
                    }
                });

                if (isChecked && $('#MeetingTableApproval .tiny-editor').length > 1) {

                    refIdArray.forEach(function (id) {

                        if (id.trim() !== '') {
                            dataList.push({
                                RefId: id.trim(),
                                Comments: comments,
                                Status: status
                            });
                        }
                    });
                    // count++;  // 🔥 increment only per row
                }
            });

            if (hasError) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerText = "Submit";
                }
                if (commentError) {
                    alert("Comment cannot be empty for Resolution No(s): " + commentErrorResolutions);
                    return;
                }

                if (statusError) {
                    alert("Please select status for Resolution No(s): " + statusErrorResolutions);
                    return;
                }
                return;
            }

            // 🔄 show loader (if exists)
            $('#loader-wrapper').show();
            $.ajax({
                url:'@Url.Action("UpdateBulkData", "References")' ,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(dataList.length > 0 ? dataList : dataListAll),

                success: function () {
                    // ✅ success UI
                    localStorage.removeItem(storageKey);
                    DeleteDraftNoting((dataList.length > 0 ? dataList : dataListAll).map(el => el.RefId));
                    btn.disabled = true;
                    btn.innerText = "Submitted";
                    alert("All data saved successfully");
                    PopUpRefresh();
                },
                error: function () {
                    alert("Error saving data");
                },
                complete: function () {
                    $('#loader-wrapper').hide();
                    if (btn) {
                        btn.disabled = false;
                        btn.innerText = "Submit";
                    }
                }
            });

            return false;
        }

        function saveRowDraft(btn, refIds) {
            var row = $(btn).closest('tr');
            var safeId = refIds.toString().replace(/,/g, '_');
            var editor = tinymce.get('MeetingTableApproval_txt_' + safeId);
            var comments = editor ? editor.getContent() : '';
            var status = $(btn).closest('.drpdwn-container').find('.action-ddl').val()
                || (editor ? $(editor.getContainer()).find('.action-ddl').val() : null)
                || $('#MeetingTableApproval select.action-ddl[data-refid="' + refIds + '"]:visible').val()
                || $('#MeetingTableApproval #drpdwn_' + safeId + ' select.action-ddl').val()
                || $('#MeetingTableApproval select[data-refid="' + refIds + '"]').val();

            if (!status || status === "") {
                alert("Please select status");
                return;
            }

            if (!comments || comments.trim() === '') {
                alert('Please enter comments');
                return;
            }

            btn.disabled = true;
            if (refIds.trim() === '') return;

            // Also keep local draft store in sync
            tinyMceDataStoreApproval[safeId] = {
                RefId: safeId,
                Comments: comments,
                //Status: status || '',
                resolutionNo: $('#MeetingTableApproval_txt_' + safeId).data('resolution')
            };
            localStorage.setItem(storageKey, JSON.stringify(tinyMceDataStoreApproval));
            SaveDraftNoting(storageKey);

            $.ajax({
                url: '@Url.Action("SaveDraftRow", "References")',
                type: 'POST',
                data: {
                    RefId: refIds.toString().trim(),
                    Comments: comments,
                    Status: status
                },
                success: function (res) {
                    if (res.Status == 1 || res.Status == "1") {
                        row.css('background', '#fff3cd');
                        $(btn).html('<i class="fa fa-check-square-o"></i>');
                        setTimeout(function () {
                            $(btn).html('<i class="fa fa-floppy-o"></i>');
                            btn.disabled = false;
                            row.css('background', 'none');
                        }, 2000);
                    } else {
                        alert(res.Message || 'Failed to save draft');
                        btn.disabled = false;
                        row.css('background', 'none');
                        $(btn).html('<i class="fa fa-floppy-o"></i>');
                    }
                },
                error: function (xhr, status, error) {
                    console.log("Status:", xhr.status);
                    console.log("Error:", error);
                    console.log("Response:", xhr.responseText);
                    btn.disabled = false;
                    row.css('background', 'none');
                    $(btn).html('<i class="fa fa-floppy-o"></i>');
                }
            });
        }

        function splitResolution(btn, refIds) {
            if (!refIds) return;

            var safeId = refIds.toString().replace(/,/g, '_');
            var $textarea = $('#MeetingTableApproval_txt_' + safeId);
            var $row = $(btn).closest('tr');
            if (!$row.length) {
                $row = $textarea.closest('tr');
            }

            var editor = tinymce.get('MeetingTableApproval_txt_' + safeId);
            var currentContent = editor ? editor.getContent() : $textarea.val();

            // Get current selected status
            var $origDropdown = $('#MeetingTableApproval #drpdwn_' + safeId);
            var currentStatus = $(btn).closest('.custom-header-group').find('select.action-ddl').val()
                || $(btn).closest('.drpdwn-container').find('select.action-ddl').val()
                || $origDropdown.find('select.action-ddl').val()
                || $row.find('select.action-ddl').val();

            var $select = $origDropdown.find('select.action-ddl');
            if (!$select.length) {
                $select = $row.find('select.action-ddl');
            }
            var selectOptionsHtml = $select.length ? $select.html() : '';

            var refIdList = refIds.toString().split(',').map(function (x) { return x.trim(); }).filter(Boolean);
            var resAttr = $textarea.data('resolution') || '';
            var resNoList = resAttr.toString().split(',').map(function (x) { return x.trim(); }).filter(Boolean);

            var totalItems = Math.max(refIdList.length, resNoList.length);
            if (totalItems <= 1) {
                alert("This row has only one resolution and cannot be split.");
                return;
            }

            // 🔥 Remove old TinyMCE instance
            if (editor) {
                editor.remove();
            }
            delete tinyMceDataStoreApproval[safeId];

            // Build separated rows
            var newRowsHtml = '';
            for (var i = 0; i < totalItems; i++) {
                var rId = (i < refIdList.length) ? refIdList[i] : resNoList[i];
                var rNo = (i < resNoList.length) ? resNoList[i] : rId;
                newRowsHtml += createSplitRowHtml(rId, rNo, selectOptionsHtml, currentContent);
            }

            // Replace combined row in DOM
            var $newRows = $(newRowsHtml);
            $row.replaceWith($newRows);

            // Ensure all rows in table have a checkbox now that multiple rows exist
            $('#MeetingTableApproval tbody tr').each(function () {
                if ($(this).find('.actionNotingCheckboxApproval').length === 0) {
                    $(this).find('td').prepend('<div class="actionNotingCheckboxApproval"><input type="checkbox" id="actionSubmitCheckboxApproval"/></div>');
                }
            });

            // Set dropdown values, update data store and init each editor
            for (var j = 0; j < totalItems; j++) {
                var newId = (j < refIdList.length) ? refIdList[j] : resNoList[j];
                var newRes = (j < resNoList.length) ? resNoList[j] : newId;

                // Set selected status in the new dropdown before init so clone picks it up
                if (currentStatus) {
                    $('#MeetingTableApproval #drpdwn_' + newId + ' select.action-ddl').val(currentStatus);
                }

                tinyMceDataStoreApproval[newId] = {
                    RefId: newId,
                    Comments: currentContent,
                    //Status: currentStatus || '',
                    resolutionNo: newRes
                };

                initTinyMceForSelector('#MeetingTableApproval_txt_' + newId);
            }

            localStorage.setItem(storageKey, JSON.stringify(tinyMceDataStoreApproval));
            SaveDraftNoting(storageKey);
            adjustTinyMceHeights();
        }

        function NotifyLocalGovtMutiple(refId, isChecked) {
            alert(refId);
            $.ajax({
                type: "POST",
            // url: Action.url("NotifyLocalGovt", "References"),
                url: '@Url.Action("NotifyLocalGovtMutiple", "References")',
                data: {
                    RefId: refId,
                    NotifyTo: isChecked ? 1 : 2
                },
                success: function (response) {
                    alert(response.message);
                },
                error: function (xhr) {
                    console.log("Error: " + xhr.responseText);
                }
            });
        }
    </script>
</head>

<div>
    <div class="main-content">
        <div class="col-md-12 col-lg-12 col-xl-12 table-responsive" id="statusdivApproval" style="margin-top: 15px;">
            <table class="table table-bordered" id="MeetingTableApproval" aria-describedby="sample-table-3_info" style="border-collapse: collapse;">
                <thead>
                    <tr style="color: white; font-size:16px; font-weight:bold;">
                        <th class="center" style="width:90% !important; font-size:16px;" id="tdFromApproval" rowspan="1" colspan="1">Add Action</th>
                    </tr>
                </thead>

                <tbody class="bordered" role="alert" aria-live="polite" aria-relevant="all" id="tbodyTypeApproval">
                    @foreach (var items in Model._LstResolutionActions)
                    {
                        <tr role="row" style="font-size: 16px; color: black; border: 1px solid #D3D3D3;">
                            <td style="font-size: 16px; border: 1px solid #D3D3D3;">
                                <div class="drpdwn-container" id="drpdwn_@items.RefId.Replace(",", "_")" style="display:none;">
                                    <!-- 🔥 Resolution No. Badge inside TinyMCE Header -->
                                    <div class="rsln-header-badge"
                                         title="Resolution No(s)"
                                         style="display:flex; align-items:center; justify-content:space-between; width:100%;white-space: normal; overflow-wrap: break-word;word-break: break-word;">
                                        <div>
                                            <span style="font-weight:700; color:#495057; margin-right: 5px;">Resolution No:</span>
                                            @{
                                                var resolutionListHeader = items.ResolutionNo.Split(',');
                                                var refIdListHeader = items.RefId.Split(',');
                                            }
                                            @for (int i = 0; i < resolutionListHeader.Length; i++)
                                            {
                                                var resolution = resolutionListHeader[i].Trim();
                                                var currentRefId = (i < refIdListHeader.Length) ? refIdListHeader[i].Trim() : "";

                                                <a href="javascript:void(0);"
                                                   onclick="ShowSDPopUp(0,'@currentRefId')"
                                                   title="Open Resolution @resolution"
                                                   style="color:#007bff; cursor:pointer; font-weight:bold; text-decoration:underline;">
                                                    @resolution
                                                </a>

                                                if (i < resolutionListHeader.Length - 1)
                                                {
                                                    <span style="color:#6c757d; margin-right: 2px;">,</span>
                                                }
                                            }
                                            @if (resolutionListHeader.Length > 1)
                                            {
                                                <button type="button"
                                                        class="btn btn-primary split-btn"
                                                        onclick="splitResolution(this,'@items.RefId')"
                                                        title="Split Resolution">
                                                    Split
                                                </button>
                                            }
                                        </div>
                                        @if (CurrentSession.DeptID == "UDD0001" && items.StatusName == "5")
                                        {
                                            <div style="text-align:right; white-space:nowrap;">
                                                <label style="margin:0; cursor:pointer;">
                                                    <input type="checkbox"
                                                           class="notifyLocalGovt"
                                                           data-refid="@items.RefId"
                                                           onchange="NotifyLocalGovtMutiple('@items.RefId', this.checked)">
                                                    Notify LG
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <!-- 🔥 Branch Comments Dropdown -->
                                        @{
                                            var actionList = Model.ActionTypeList_Ref.ToList();
                                        }

                                        @if (actionList.Count == 1)
                                        {
                                            @Html.DropDownList(
                                                "ActionCode_" + items.RefId,
                                                new SelectList(actionList, "Value", "Text", actionList[0].Value),
                                                new
                                                {
                                                    @class = "action-ddl",
                                                    data_refid = items.RefId
                                                })
                                        }
                                        else
                                        {
                                            @Html.DropDownList(
                                                "ActionCode_" + items.RefId,
                                                new SelectList(actionList, "Value", "Text", items.StatusName),
                                                "Select",
                                                new
                                                {
                                                    @class = "action-ddl",
                                                    data_refid = items.RefId
                                                })
                                        }
                                    </div>
                                    <div>
                                        <button type="button"
                                                class="action-save btn btn-warning btn-sm"
                                                onclick="saveRowDraft(this,'@items.RefId')"
                                                title="Save Draft">
                                            <i class="fa fa-floppy-o"></i>
                                        </button>
                                    </div>

                                </div>
                                @if (Model._LstResolutionActions.Count > 1)
                                {
                                    <div class="actionNotingCheckboxApproval">
                                        <input type="checkbox" id="actionSubmitCheckboxApproval" />
                                    </div>
                                }
                                <textarea class="tiny-editor"
                                          id="MeetingTableApproval_txt_@items.RefId.Replace(",", "_")"
                                          data-refid="@items.RefId"
                                          data-resolution="@items.ResolutionNo">@(string.IsNullOrEmpty(items.LGComments) ? items.ActionDescription : items.LGComments)</textarea>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="margin-top:15px; text-align:right;">
                <button type="button"
                        class="btn btn-success"
                        onclick="return saveAllData(event);">
                    Submit
                </button>
            </div>
        </div>
    </div>
</div>