            gap: 5px !important;
        }

            #MeetingTableApproval .custom-header-group .drpdwn-container > div:nth-child(2) {
                flex: 1 1 0 !important;
                min-width: 0 !important;
            }

        #MeetingTableApproval .tox .tox-toolbar__group.custom-header-group {
            flex: 1 1 100% !important;
