    function GetLinkedReferenceId(param) {
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetLinkedReferenceId", "References")',
            datatype: "Json",
            contentType: "application/json; charset=utf-8",
            data: {refid:param},
            success: function (response) {
                var html = "";
                if (response.length > 0) {
                    var classname = "";
                    for (var i = 0; i < response.length; i++) {
                        var item = response[i];
                        if (item.linkedRefId == param) {
                            classname = 'samename';
                        }
                        else {
                            classname = 'differentname'
                        }

                        html = html + "<span class='refidbox "+ classname+" ' onclick='SearchRefNo(" + item.linkedRefId +")' >" + item.linkedRefId + "</span> &nbsp;";
                    }
                    $("#linkedrefidlist").html(html);

                }
                else {

                }
            },
            error: function (error) {
            }
        });
    }
