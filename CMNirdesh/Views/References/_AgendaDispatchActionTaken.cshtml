        function BindDispatchAction(ID) {
            $('#loginModaldiarybody').html('');
            $('#loginModalBody').html('');
            $('#loginModalDispatchbody').html('');
            var pathurl = '/References/EditMlaDispatchForm';
            $.ajax({
                type: "GET",
                url: pathurl,
                data: { ID: ID, EditType: "Agenda" },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {
                    $('#loginModalDispatchbody').html('');
                    var options = {
                        "backdrop": "static",
                        keyboard: true
                    };
                    $("#loader-wrapper").hide();
                    if (data) {
                        $("#loginModalDispatch").css("display","block");
                        $('#loginModalDispatchbody').html(data);

                    } else { alert("error"); }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();
                }
            });
        }

        function MinistryChanged() {
        //var cl = new CanvasLoader('canvasloader-container1');
        var ministryID = $('#DdlEntryMinister').val();
        if (ministryID == "0") {
            $('#MinistryId').val(ministryID);
            var select = $("#DdlDept");
            select.empty();
            var pathurl = '@Url.Action("GetDepartmentByMinistery", "NoticeDetails", new { Area = "OnlineMemberQuestions" })';
            $.ajax({
                url: pathurl,
                type: 'GET',
                data: { MinistryId: ministryID },
                success: function (data) {
                    var opt = document.createElement("option");

                    document.getElementById("DdlDept").options.add(opt);

                    opt.text = 'Select Department';
                    opt.value = 0;
                }, error: function (data) {
                    alert("Something wrong...")
                }
            })
        }

        if (ministryID != "" && ministryID != null) {
            $('#MinistryId').val(ministryID);
            var select = $("#DdlDept");
            select.empty();
            var pathurl = '@Url.Action("GetDepartmentByMinistery", "NoticeDetails", new { Area = "OnlineMemberQuestions" })';
            $.ajax({
                url: pathurl,
                type: 'GET',
                data: { MinistryId: ministryID },
                success: function (data) {
                    $.each(data, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.DepartmentId,
                            text: itemData.DepartmentName
                        }));
                    });
                }, error: function (data) {
                    alert("Something wrong...")
                }
            })
        }
    }




