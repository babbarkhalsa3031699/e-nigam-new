    function SearchRefNo(RefId) {
        $('#linkModalRefSearchbody').html('');
        if (RefId == 0 || RefId == "") {

            //  alert('Please enter the the Ref No');
        }
        else {

            var pathurl = '/References/LinkSearchRefLink';
            $.ajax({
                type: "GET",

                url: pathurl,
                data: { RefId: RefId },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {
                    $("#loader-wrapper").hide();
                    if (data) {
                        $("#linkModalSearchRef").css("dispaly","block")
                        $('#linkModalRefSearchbody').html(data);
                    }
                    else {

                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();
                }
            });
        }

    }

