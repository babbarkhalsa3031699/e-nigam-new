@model CMNirdesh.Models.AgendaDetailModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>eSign PDF</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <script src="~/resources/js/jquery.min.js"></script>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        .header {
            text-align: center;
            padding: 15px;
            background: #fff;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
    </style>
</head>

<body>

    <div class="container-fluid">

        <!-- Header -->
        <div class="header rounded shadow-sm mb-2">
            <p class="text-muted small mb-2">
                <strong>Sign Document</strong> – Please review the document carefully.
                Once signed, the action <strong>cannot be undone</strong>.
            </p>

            <button class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#confirmSignModal">
                Proceed to eSign
            </button>
        </div>

        <!-- PDF Preview -->
        <object type="application/pdf"
                data="data:application/pdf;base64,@Model.agendadetails"
                style="width:100%; height:85vh; border:1px solid #ccc;">
            <div class="text-center p-3">
                <p>Your browser does not support embedded PDF.</p>
                <a href="data:application/pdf;base64,@Model.agendadetails"
                   download="Document.pdf"
                   class="btn btn-primary btn-sm">
                    Download PDF
                </a>
            </div>
        </object>

    </div>

    <!-- Confirmation Modal -->
    <div class="modal fade" id="confirmSignModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content rounded-4">

                <div class="modal-header">
                    <h6 class="modal-title">Confirm eSign</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body small">
                    <p>Please confirm you have reviewed the document.</p>
                    <div class="alert alert-warning py-2">
                        Once signed, this action cannot be undone.
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <a href="@Url.Action(
                        "SignPdfCommissioner",
                        "PdfSign",
                        new {
                            AgendaId = Model.AgendaId,
                            Type = Model.AgendaType,
                            ApprovalID= Model.ApprovalId
                        })"
                       class="btn btn-primary btn-sm">
                        Confirm & Sign
                    </a>
                </div>

            </div>
        </div>
    </div>

</body>
</html>
