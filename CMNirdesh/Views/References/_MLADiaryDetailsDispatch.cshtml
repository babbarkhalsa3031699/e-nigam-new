<script>

    $(document).ready(function () {
          var offNamenew = '@Session["offNamenew"]';
        var deptnameee = '@Session["deptnameee"]';
        $("#offNamehdndispatch").append(offNamenew);
        $("#deptNamehdndispatch").append(deptnameee);
        BindActionStatusMladispatch();
        var countinitial = 0;

        var Text = "References Total Dispatch: " + "@Totaldiary";
        $('#selectednew').text(Text);
        $('#selected').text(Text);

        $("#Pendency").hide();
        $('#SinceLabel').hide();

        DispatchRefWise();
        ShowButton();
        $("#chkDisPatchRef").click(function () {
            var dispatchvalue = "Ref";
            $("#DispatchTableDiv").css("display", "none");
            $("#DispatchTableDiv").hide();
            $("#Dispatchlistdiv").hide();
            $("#diarydispatchValue").val(dispatchvalue);
          //  $("#Dispatchlistdiv").css("display", "none");
            DispatchRefWise();

        });

        $("#chkDispatchAction").click(function () {
            var dispatchvalue = "Act";
            $("#DispatchTableDiv").css("display", "none");
            $("#DispatchTableDiv").hide();
            $("#Dispatchlistdiv").hide();
            $("#diarydispatchValue").val(dispatchvalue);
            DispatchActionRefWise();
        });

    });

    function ShowButton() {
        var type = 4;
        $.ajax({
            type: "GET",
            url: '@Url.Action("ShowButton", "References")',
            datatype: "Json",
            contentType: "application/json; charset=utf-8",
            data: {type:type},
            success: function (response) {
                if (response[0].isupdate == 1) {
                    $("#btnNewD").css("display", "block");
                    $("#loader-wrapper").hide();
                }
                else {
                    $("#btnNewD").css("display", "none");
                    $("#loader-wrapper").hide();
                }
            },
            error: function (error) {
            }
        });
    }

    function ResetSinceDispatch() {
        var dropDown = document.getElementById("sincefilterdispatch");
        dropDown.selectedIndex = 0;
        $("#sincefilterdispatch").val('');
        GetDataForDispatch($('#DocumentTypeIdHdn').val());
    }
    $("#sincefilterdispatch").change(function () {
        var sinceparam = $(this).val();
        $("#sincefilterdispatch").val(sinceparam);
        var type = $('#DocumentTypeDIdHdn').val();
        GetDataForDispatch(type);
    });

    function DispatchRefWise() {
        try {
           $("#loader-wrapper").show();
            $("#tbodyDispatchWeekly").html('');
            var pathurl = '/References/DispatchRefWise';
            $.ajax({
                url: pathurl,
                type: 'GET',
                async: true,
                data: { status: 0 },
                success: function (result) {
                    //debugger;
                    var html = "";

                    if (result.length > 0) {
                        //debugger;
                        html = html + "<tr><td class='center'>" + result[0].Text + "</td>";
                        html = html + "<td class='center'>" + result[1].Text + "</td>";
                        html = html + "<td class='center'>" + result[2].Text + "</td>";
                        html = html + "<td class='center'>" + result[3].Text + "</td>";
                        html = html + "<td class='center'>" + result[4].Text + "</td>";
                        html = html + "<td class='center'>" + result[5].Text + "</td>";
                        html = html + "<td class='center'>" + result[6].Text + "</td></tr>";
                        html = html + "<tr><td class='center'> <a onclick='GetDispatchDataByDate(this)' dispatchDate='" + result[0].Text + "'>" + result[0].Value + "</a></td>";
                        html = html + "<td class='center'> <a onclick='GetDispatchDataByDate(this)' dispatchDate='" + result[1].Text + "'>" + result[1].Value + "</a></td>";
                        html = html + "<td class='center'> <a onclick='GetDispatchDataByDate(this)' dispatchDate='" + result[2].Text + "'>" + result[2].Value + "</a></td>";
                        html = html + "<td class='center'> <a onclick='GetDispatchDataByDate(this)' dispatchDate='" + result[3].Text + "'>" + result[3].Value + "</a></td>";
                        html = html + "<td class='center'> <a onclick='GetDispatchDataByDate(this)' dispatchDate='" + result[4].Text + "'>" + result[4].Value + "</a></td>";
                        html = html + "<td class='center'> <a onclick='GetDispatchDataByDate(this)' dispatchDate='" + result[5].Text + "'>" + result[5].Value + "</a></td>";
                        html = html + "<td class='center'> <a onclick='GetDispatchDataByDate(this)' dispatchDate='" + result[6].Text + "'>" + result[6].Value + "</a></td></tr>";
                        $("#tbodyDispatchWeekly").html(html);
                        $("#loader-wrapper").hide();
                    }

                    else {
                        $("#tbodyDispatchWeekly").html("No Data Found");
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (result) {
                    $("#loader-wrapper").hide();
                }
            });
        }
        catch (e) {
            //debugger;
            alert('error occured' + e);
        }
    }

