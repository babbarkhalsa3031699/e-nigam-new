    function SaveMeetingIndexNew() {
    var result = confirm("Are you sure you want to Save?");
    if (result) {
        var agendid = '@Model.agendaId';
        if (agendid != "") {
            var categories = [];
            var isValid = true;

            $('#IncludeRefTable').DataTable().rows().every(function (rowIdx, tableLoop, rowLoop) {

                var rowid = this.data().at(1);

                var index = $('#ser_' + rowid).val();
                var indexTwo = $('#serTwo_' + rowid).val();

                // Check required field
                if ($.trim(index) == '') {
                    alert('No. is required.');

                    $('#ser_' + rowid).focus();

                    isValid = false;
                    return false; // stop loop
                }

                categories.push({
                    AgendaRecordId: rowid,
                    Index: index,
                    IndexTwo: indexTwo,
                    AgendaId: agendid
                });

            });

            // stop further execution
            if (!isValid) {
                return false;
            }



            var fd = JSON.stringify(categories)
            console.log(fd);
            //$('#tableRef').DataTable().clear().destroy();
             $.ajax({
                type: "POST",
                 data: fd,
                url: "@Url.Action("SaveIndex", "References")",
                contentType: "application/json"
                   }).done(function (result) {
                alert("Updated Successfully");
               //$("#MeetingSetting").html(result);
                       GetIncludedRef();
                   });



            $("#hdnAgendaDetails").val(fd);
            $("#hdnfreezed").val(1);
        }
    } else {
        return false;
    }


}

    function generateComPdf() {

      const agendaid = '@Model.agendaId';
      const refid = '@Model.RefId';

      $('#pdf-loader').show();

      // Disable the button
      $('#btnPass').prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1"></i> Generating...');

      $.ajax({
          url: '@Url.Action("GetProceedingCoveringLetterCommisioner", "Agenda")',
          method: 'POST',
          data: { AgendaId: agendaid, refid: refid},
          success: function (response) {
              if (response.success) {
                  $('#ProceedingCommCommentPdf').attr('href', response.pdfPath);
                  window.open(response.pdfPath, '_blank');
              } else {
                  alert("PDF generation failed: " + response.message);
              }
          },
          error: function () {
              alert("An error occurred during PDF generation.");
          },
          complete: function () {
              $('#pdf-loader').hide();
              $('#btnPass').prop('disabled', false).html('<i class="fa fa-file-pdf me-1"></i> Generate');
          }
      });
  }





 function validateAndOpenProceeding(agendaId, refId) {

    validateAct(agendaId)
        .done(function (actResult) {

            if (actResult != true) {
                alert("Approval not allowed. Each linked Resolution must have Act/Point of Instruction Selected.");
                return;
            }

            $.ajax({
                url: '@Url.Action("CheckAllLinkedActionCode13", "Agenda")',
                type: 'GET',
                data: { agendaId: agendaId },

                success: function (result) {
                    if (result != true) {
                        alert("Approval not allowed. Each linked reference must have EO/Commissioner Comment.");
                        return;
                    }

                    var url = '@Url.Action("GetProceedingCoveringLetterCommisioner", "Agenda")'
                        + '?AgendaId=' + encodeURIComponent(agendaId)
                        + '&Refid=' + encodeURIComponent(refId);

                    window.open(url, '_blank');

                    setTimeout(function () {
                        PopUpRefresh();
                    }, 1000);
                },

                error: function (xhr, status, error) {

                    console.log("STATUS:", status);
                    console.log("ERROR:", error);
                    console.log("RESPONSE:", xhr.responseText);

                    alert(
                        "CheckAllLinkedActionCode13 Error\n\n" +
                        "Status: " + status +
                        "\nError: " + error +
                        "\nResponse: " + xhr.responseText
                    );
                }
            });

        })
        .fail(function (xhr, status, error) {

            console.log("validateAct STATUS:", status);
            console.log("validateAct ERROR:", error);
            console.log("validateAct RESPONSE:", xhr.responseText);

            alert(
                "CheckAllActLinked Error\n\n" +
                "Status: " + status +
                "\nError: " + error +
                "\nResponse: " + xhr.responseText
            );
        });
}


function validateAct(agendaId) {

    return $.ajax({
        url: '@Url.Action("CheckAllActLinked", "Agenda")',
        type: 'GET',
        data: { agendaId: agendaId }
    });
}

