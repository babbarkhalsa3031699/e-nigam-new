    function checkInAgendaD(idd) {
        var result = confirm("Are you sure you want to Add in Agenda?");
        if (result) {

            var refid = idd.id;

            var mainRefid = $("#RefId").val();
            if (mainRefid == '') {
                alert("RefId empty");
                return false;
            }
            if (refid == '') {
                alert("Some Error Occured .");
                return false;

            }
            var formData = new FormData();
            formData.append("refid", refid);
            formData.append("mainRefid", mainRefid);

            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckInFile", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {
                        alert("Already Added")
                    }
                    if (response == "0") {
                        SendToAgendaD(refid)
                    }
                }
            });
        } else {
            $(idd).prop('checked', false);

        }
    }

