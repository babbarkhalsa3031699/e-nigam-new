<style>
    /* Two-Column Split Workspace (Panel Container) - Strict Side-by-Side Horizontal Layout */
    div#panelContainer,
    #panelContainer {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        align-items: stretch !important;
        position: relative !important;
        width: 100% !important;
        max-width: 100% !important;
        min-height: calc(100vh - 160px) !important;
        background: transparent !important;
        margin: 0 !important;
        overflow-x: hidden !important;
        gap: 0 !important;
        box-sizing: border-box !important;
    }

    #panelContainer.is-resizing {
        cursor: col-resize !important;
        user-select: none !important;
    }

    #panelContainer > .panel.panelone,
    #panelContainer > .panelone {
        width: 40%;
        min-width: 250px;
        box-sizing: border-box;
        overflow-y: auto;
        overflow-x: hidden;
        transition: none !important;
    }

    #panelContainer > .panel.paneltwo,
    #panelContainer > .paneltwo {
        width: 60%;
        min-width: 280px;
        box-sizing: border-box;
        overflow-y: auto;
        overflow-x: hidden;
        transition: none !important;
    }

    /* Draggable Splitter Divider - Explicit Visible Line with Extended Hit-Catch Area */
    #panelContainer > .slider,
    #panelContainer > #panelDivider,
    #panelDivider {
        z-index: 100 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        position: relative !important;
        flex: 0 0 5px !important;
        width: 5px !important;
        min-width: 5px !important;
        max-width: 5px !important;
        align-self: stretch !important;
        height: auto !important;
        min-height: 100% !important;
        background-color: #cbd5e1 !important;
        border-left: 1px solid #94a3b8 !important;
        border-right: 1px solid #94a3b8 !important;
        cursor: col-resize !important;
        user-select: none !important;
        padding: 0 !important;
        margin: 0 !important;
        box-sizing: border-box !important;
        opacity: 1 !important;
        visibility: visible !important;
        transition: background-color 0.2s ease, border-color 0.2s ease, width 0.2s ease;
    }

    /* Extended 19px Hit-Catch Area around the 5px visible line (eliminates pixel-hunting) */
    #panelContainer > .slider::after,
    #panelContainer > #panelDivider::after,
    #panelDivider::after {
        content: "" !important;
        position: absolute !important;
        top: 0 !important;
        bottom: 0 !important;
        left: -7px !important;
        right: -7px !important;
        cursor: col-resize !important;
        z-index: 101 !important;
        pointer-events: auto !important;
        background: transparent !important;
    }

    /* Highlight visible line on hover or during active resize drag */
    #panelContainer > .slider:hover,
    #panelContainer > #panelDivider:hover,
    #panelDivider:hover,
    #panelContainer.is-resizing #panelDivider,
    #panelContainer.is-resizing .slider {
        background-color: #3b82f6 !important;
        border-color: #2563eb !important;
    }

    /* Modern Pill-Shaped Drag Handle (Centered Vertically & Horizontally Over the 5px Line) */
    #panelDivider .slider-handle,
    .slider .slider-handle {
        position: absolute !important;
        top: 50% !important;
        left: 50% !important;
        transform: translate(-50%, -50%) !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 22px !important;
        height: 44px !important;
        background: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 9999px !important;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.06) !important;
        cursor: col-resize !important;
        z-index: 102 !important;
        transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease !important;
    }

    #panelDivider:hover .slider-handle,
    .slider:hover .slider-handle,
    #panelContainer.is-resizing .slider-handle {
        border-color: #3b82f6 !important;
        background-color: #eff6ff !important;
        box-shadow: 0 3px 10px rgba(37, 99, 235, 0.28) !important;
        transform: translate(-50%, -50%) scale(1.08) !important;
    }

    .slider-handle .grip-icon {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 3px !important;
        color: #64748b !important;
        pointer-events: none !important;
        transition: color 0.15s ease !important;
    }

    .slider-handle .grip-icon i {
        font-size: 8.5px !important;
        transform: scaleY(1.3) !important;
    }

    #panelDivider:hover .slider-handle .grip-icon,
    .slider:hover .slider-handle .grip-icon,
    #panelContainer.is-resizing .slider-handle .grip-icon {
        color: #2563eb !important;
    }
</style>

