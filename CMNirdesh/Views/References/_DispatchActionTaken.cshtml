    function initDispatchPanelSplitter() {
        var $divider = $("#panelDivider");
        var $container = $("#panelContainer");
        var $panelOne = $container.find(".panel.panelone, .panelone");
        var $panelTwo = $container.find(".panel.paneltwo, .paneltwo");

        if (!$divider.length || !$container.length) {
            return;
        }

        // Clean any leftover inline display, height, or flex from panels
        $panelOne.add($panelTwo).css({ "display": "", "height": "" });

        // Double-click to reset to default 40% / 60% split
        $divider.off("dblclick.panelSplitter").on("dblclick.panelSplitter", function (e) {
            e.preventDefault();
            $panelOne.css({ "width": "40%", "flex-basis": "40%", "max-width": "40%" }).show();
            $panelTwo.css({ "width": "60%", "flex-basis": "60%", "max-width": "60%" }).show();
            $("#floatButton").css("left", "40%");
            $("#PannelId").val(2);
        });

        // Unbind any legacy or previous drag handlers
        $divider.off("mousedown.panelSplitter touchstart.panelSplitter");

        $divider.on("mousedown.panelSplitter touchstart.panelSplitter", function (e) {
            e.preventDefault();
            var isDragging = true;

            $container.addClass("is-resizing");
            $divider.addClass("is-resizing");
            $("iframe").css("pointer-events", "none");
            $("body").css({ "user-select": "none", "cursor": "col-resize" });

            var containerOffset = $container.offset().left;
            var containerWidth = $container.width();

            function onMove(evt) {
                if (!isDragging) return;

                var clientX = evt.pageX;
                if (typeof clientX === "undefined" && evt.originalEvent && evt.originalEvent.touches && evt.originalEvent.touches.length > 0) {
                    clientX = evt.originalEvent.touches[0].pageX;
                }
                if (typeof clientX === "undefined" || isNaN(clientX)) return;

                var currentOffset = $container.offset().left;
                var currentWidth = $container.outerWidth() || containerWidth;
                var relativeX = clientX - currentOffset;
                var pct = (relativeX / currentWidth) * 100;

                // Enforce reasonable min-width boundaries (min 18% / 250px left, min 22% / 280px right)
                var minLeftPct = Math.max(18, (250 / currentWidth) * 100);
                var maxLeftPct = Math.min(80, ((currentWidth - 280) / currentWidth) * 100);

                if (pct < minLeftPct) pct = minLeftPct;
                if (pct > maxLeftPct) pct = maxLeftPct;

                // Real-time smooth updates to width and flex-basis
                $panelOne.css({
                    "width": pct + "%",
                    "flex-basis": pct + "%",
                    "max-width": pct + "%"
                }).show();

                $panelTwo.css({
                    "width": (100 - pct) + "%",
                    "flex-basis": (100 - pct) + "%",
                    "max-width": (100 - pct) + "%"
                }).show();

                $("#floatButton").css("left", pct + "%");
                $("#PannelId").val(2);
            }

            function onEnd() {
                if (!isDragging) return;
                isDragging = false;

                $container.removeClass("is-resizing");
                $divider.removeClass("is-resizing");
                $("iframe").css("pointer-events", "");
                $("body").css({ "user-select": "", "cursor": "" });

                $(document).off("mousemove.dispatchSplitter touchmove.dispatchSplitter", onMove);
                $(document).off("mouseup.dispatchSplitter touchend.dispatchSplitter", onEnd);
            }

            $(document).on("mousemove.dispatchSplitter touchmove.dispatchSplitter", onMove);
            $(document).on("mouseup.dispatchSplitter touchend.dispatchSplitter", onEnd);
        });
    }

    $(document).ready(function () {
        initDispatchPanelSplitter();
    });
    // Also initialize immediately and after short delay in case partial view is loaded dynamically via AJAX
    initDispatchPanelSplitter();
    setTimeout(function () {
