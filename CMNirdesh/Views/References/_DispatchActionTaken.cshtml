        if (valid=="True") {
             if (confirm("Are you sure to save ?")) {
            //console.log(categories);
            var fd = JSON.stringify(categories)
            $("#hdnadddetails").val(fd);
            var action = $("#formActionDispatch").attr("action");
            if ($("#formActionDispatch").attr("enctype") == "multipart/form-data") {
                //this only works in some browsers.
                //purpose? to submit files over ajax. because screw iframes.
                //also, we need to call .get(0) on the jQuery element to turn it into a regular DOM element so that FormData can use it.
                var dataString = new FormData($("#formActionDispatch").get(0));
                //  contentType = false;
                processData = false;
            }
            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveNewReference", "References")',
                data: dataString,

                dataType: "html", //change to your own, else read my note above on enabling the JsonValueProviderFactory in MVC
                contentType: false,
                processData: false,
                success: function (data) {
                    $("#loader-wrapper").hide();

                    if (data == "U" && data != "E") {

                    }
                    else if (data != "U" && data != "E") {
                        GetIncludedRef();
                        alert("New References Added Successfully.");
                        closemeeting();
                        jQuery.each(rowarr, function (index, item) {
                            $("#txtletterno" + item).val("");
                            $("#txtletterdate" + item).val("");
                            $("#txtSubject" + item).val("");
                            if (item != 0) {
                                $("#field" + item).remove();
                            }
                        });
                        $("#AddDetails").val("");
                        categories = [];
                        rowarr = [];
                        rowarr.push(0);

                    }
                    else {

                        alert("Some error occurred,please try again");
                        window.location.reload(true);

                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    debugger;
                    //do your own thing
                    $("#loader-wrapper").hide();
                    alert("Some error occurred,please try again");
                    window.location.reload(true);
                },
            });

        }
        }
    }


