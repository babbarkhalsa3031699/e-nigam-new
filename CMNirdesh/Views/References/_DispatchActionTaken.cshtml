                return false;
            } else if (letterdate == "") {
                alert("Please Enter Letter Date.");
                valid = "False";
                return false;
            } else {
                categories.push({
                    letterno: letterno,
                    letterdate: letterdate,
                    subject: Subject
                });
                valid = "True";
            }

