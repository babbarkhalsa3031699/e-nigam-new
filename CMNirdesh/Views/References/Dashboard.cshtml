 function getDispatchTableButtons() {
    var commonExportOptions = {
        columns: function (idx, data, node) {
            // Always include first column (ID, which has class="hide" in DOM)
            if (idx === 0) {
                return true;
            }
            var dt = $('#DispatchTable').DataTable();
            var colCount = dt ? dt.columns().count() : 13;
            // Always exclude last column (action / checkbox column)
            if (idx >= colCount - 1) {
                return false;
            }
            if (node) {
                var $th = $(node);
                if ($th.is(':last-child') || $th.find('input[type="checkbox"]').length > 0) {
                    return false;
                }
                if ($th.text().trim() === '') {
                    return false;
                }
            }
            // Check DataTable visibility for other columns (respects bVisible: false)
            if (dt && dt.column) {
                return dt.column(idx).visible();
            }
            return $(node).is(':visible');
        },
        modifier: {
            page: 'all',
            search: 'applied'
        },
        format: {
            header: function (data, columnIdx) {
                var text = $('<div>').html(data || '').text().trim().replace(/\s+/g, ' ');
                if (columnIdx === 0 || text === '') {
                    if (columnIdx === 0) {
                        return 'ID';
                    }
                }
                return text;
            },
            body: function (data, row, column, node) {
                if (node) {
                    var $clone = $(node).clone();
                    $clone.find('.check-read, .read-more-btn, input, script, style').remove();
                    return $clone.text().trim().replace(/\s+/g, ' ');
                }
                return data;
            }
        }
    };

    return [
        {
            extend: 'excelHtml5',
            text: 'Excel',
            className: 'buttons-excel',
            title: '',
            filename: 'Dispatch_Report',
            exportOptions: commonExportOptions
        },
        {
            extend: 'pdfHtml5',
            text: 'PDF',
            className: 'buttons-pdf',
            title: '',
            filename: 'Dispatch_Report',
            orientation: 'landscape',
            pageSize: 'A4',
            exportOptions: commonExportOptions,
            customize: function (doc) {
                // Remove title heading nodes from doc.content
                if (doc.content && doc.content.length) {
                    for (var i = doc.content.length - 1; i >= 0; i--) {
                        if (doc.content[i].style === 'title' || (typeof doc.content[i].text === 'string' && doc.content[i].text.toLowerCase().indexOf('dispatch report') !== -1)) {
                            doc.content.splice(i, 1);
                        }
                    }
                }

                if (window.pdfMake && window.pdfMake.vfs && window.pdfMake.vfs['Raavi-Regular.ttf']) {
                    window.pdfMake.fonts = window.pdfMake.fonts || {};
                    window.pdfMake.fonts.Raavi = {
                        normal: 'Raavi-Regular.ttf',
                        bold: 'Raavi-Bold.ttf',
                        italics: 'Raavi-Regular.ttf',
                        bolditalics: 'Raavi-Bold.ttf'
                    };
                    doc.defaultStyle.font = 'Raavi';
                    if (doc.styles) {
                        for (var s in doc.styles) {
                            if (doc.styles.hasOwnProperty(s)) {
                                doc.styles[s].font = 'Raavi';
                            }
                        }
                    }
                }

                doc.defaultStyle.fontSize = 7;
                doc.styles.tableHeader = {
                    bold: true,
                    fontSize: 7.5,
                    alignment: 'center',
                    fillColor: '#1e3a8a',
                    color: '#ffffff'
                };
                if (window.pdfMake && window.pdfMake.vfs && window.pdfMake.vfs['Raavi-Regular.ttf']) {
                    doc.styles.tableHeader.font = 'Raavi';
                }
                doc.pageMargins = [8, 10, 8, 12];

                var tableNode = null;
                if (doc.content && doc.content.length) {
                    for (var i = 0; i < doc.content.length; i++) {
                        if (doc.content[i].table) {
                            tableNode = doc.content[i];
                            break;
                        }
                    }
                }

                if (tableNode && tableNode.table && tableNode.table.body && tableNode.table.body.length > 0) {
                    var table = tableNode.table;
                    var colCount = table.body[0].length;

                    // Clean header text to remove any HTML tags and label first column 'ID' if blank
                    for (var h = 0; h < colCount; h++) {
                        var hCell = table.body[0][h];
                        var rawHText = (typeof hCell === 'object' && hCell !== null ? (hCell.text || '') : String(hCell || '')).trim();
                        if (rawHText.indexOf('<') !== -1) {
                            rawHText = $('<div>').html(rawHText).text().trim();
                        }
                        if (h === 0 && (!rawHText || rawHText === '')) {
                            rawHText = 'ID';
                        }
                        if (typeof hCell === 'object' && hCell !== null) {
                            hCell.text = rawHText;
                        } else {
                            table.body[0][h] = rawHText;
                        }
                    }

                    var widths = [];
                    for (var j = 0; j < colCount; j++) {
                        var cell = table.body[0][j];
                        var headerText = (typeof cell === 'object' && cell !== null ? (cell.text || '') : String(cell || '')).toLowerCase().trim();
                        if (headerText.indexOf('subject') !== -1) {
                            widths.push('26%');
                        } else if (headerText.indexOf('ulb') !== -1) {
                            widths.push('14%');
                        } else if (headerText.indexOf('sent by') !== -1 || headerText.indexOf('currently') !== -1) {
                            widths.push('14%');
                        } else if (headerText === 'id') {
                            widths.push('6%');
                        } else if (headerText.indexOf('update') !== -1 || headerText === '') {
                            widths.push('5%');
                        } else {
                            widths.push('*');
                        }
                    }
                    table.widths = widths;

                    tableNode.layout = {
                        hLineWidth: function () { return 0.5; },
                        vLineWidth: function () { return 0.5; },
                        hLineColor: function () { return '#cbd5e1'; },
                        vLineColor: function () { return '#cbd5e1'; },
                        paddingLeft: function () { return 3; },
                        paddingRight: function () { return 3; },
                        paddingTop: function () { return 3; },
                        paddingBottom: function () { return 3; }
                    };
                }

                doc.footer = function (currentPage, pageCount) {
                    return {
                        text: 'Page ' + currentPage.toString() + ' of ' + pageCount,
                        alignment: 'right',
                        fontSize: 7,
                        font: (window.pdfMake && window.pdfMake.vfs && window.pdfMake.vfs['Raavi-Regular.ttf']) ? 'Raavi' : undefined,
                        margin: [0, 0, 10, 0]
                    };
                };
            }
        }
    ];
}

    </script>



