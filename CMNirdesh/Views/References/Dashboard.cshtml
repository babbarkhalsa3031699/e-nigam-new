    function GetDataForDispatchOutbox(value) {
            //alert(@Model.Type);
             var menutype = "";
             if (value == "Letter") {
                 menutype = '@Model.RefMenutype';

             } else {
                 menutype =  '@Model.FileMenuType';

             }
        var since = '';
        var status = '10';
        var deptid = '';
        var officeid = '';
        var term = '';
        var priority = '';
        var type = @Model.Type;
        var notchecked = '0';

        var month = selectedMonth;
        var year = selectedYear;

        if (month == null || year == null) {
            console.error("Invalid month/year", month, year);
            return;
        }

        var fromDate = null;
        var toDate = null;

        // Specific Month + Year
        if (month > 0 && year > 0) {
            fromDate = new Date(year, month - 1, 1);
            toDate = new Date(year, month, 1);
        }
        // All Months of selected Year
        else if (month === 0 && year > 0) {
            fromDate = new Date(year, 0, 1);
            toDate = new Date(year + 1, 0, 1);
        }
        // All Data OR Month across all years
        else {
            fromDate = null;
            toDate = null;
        }

        if (fromDate && toDate) {
            if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) {
                console.error("Invalid Date object");
                return;
            }
        }


        var sinceVal = fromDate ? fromDate.toISOString() : '';
        var tillVal = toDate ? toDate.toISOString() : '';

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetDataForDispatchOutbox", "References")',
            datatype: "Json",
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            contentType: "application/json; charset=utf-8",
            data: {
                DocumentType: menutype,
                status: status,
                since: sinceVal,
                till: tillVal,
                deptid: deptid,
                officeid: officeid,
                term: term,
                priority: priority,
                notchecked: notchecked,
                isLetter: value
            },
            success: function (response) {
                if (response && response.length > 0) {
                    getTableListDispatchOutbox(response);
                    $("#loader-wrapper").hide();
                }
                else {
                    clearDispatchTable(value);
                }
            },
            error: function (error) {
                clearDispatchTable(value);
            }
        });
    }

    function clearDispatchTable(isLetter) {
        if ($.fn.DataTable.isDataTable('#DispatchTable')) {
            $('#DispatchTable').DataTable().destroy();
        }
        $('#DispatchTable tbody').empty();

        var targetCols = (isLetter === "File") ? [2, 4, 6, 8] : [8];
        $('#DispatchTable').DataTable({
            paging: true,
            pageLength: 50,
            searching: true,
            bInfo: true,
            dom: 'Bfrtip',
            buttons: getDispatchTableButtons(),
            aaSorting: [[0, 'desc']],
            aoColumnDefs: [{ "bVisible": false, "aTargets": targetCols }]
        });
        $('#loader-wrapper').hide();
        if (typeof syncDashboardToolbar === 'function') {
            syncDashboardToolbar();
        }
    }

