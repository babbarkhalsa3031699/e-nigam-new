    function GetDataDashboardStatIndivisual(fyear = '', selectedType = '') {
    $('#OpenMemoData').show();
    $('#showOuterMemo').show();
    $('#showOuterMemoData').show();
    $('#showInnerMemoData').hide();
    $("#loader-wrapper").show();

    var MeetingType = $("#meetingType").val();

    var FileMenuType = '@Model.FileMenuType';
    var RefMenuType = '@Model.RefMenutype';
    var menuname =    '@Model.RefMenuName';

    $.ajax({
        type: "GET",
        url: '@Url.Action("GetDataForDiaryIndivisualReferences", "References")',
        datatype: "json",
        contentType: "application/json; charset=utf-8",
        data: {
            financialyear: fyear,
            RefType: RefMenuType,
            MenuName: menuname,
            MeetingType: MeetingType,
            selectedType: selectedType
        },
        success: function (result) {
            if (result.length > 0) {
                $("#showOuterMemoData").html(result);
                $("#MemoType tbody tr#trtd0 td:not(:first-child), #MemoType tbody tr:last-child td:not(:first-child)").each(function () {
                    if ($(this).find('a, .total-badge').length === 0 && $(this).text().trim() !== '') {
                        $(this).html('<span class="total-badge">' + $(this).text().trim() + '</span>');
                    }
                });
                $("#loader-wrapper").hide();

                const restoreSelectedType = selectedType;
                const restoreFYear = fyear;

                const dataTable = $('#MemoType').DataTable({
                    initComplete: function () {
                        const filterDiv = $('#MemoType').closest(".dataTables_wrapper").find(".dataTables_filter");
                        const isApex = @CurrentSession.isApex == "1";

                        const deptRadio = isApex ? `
                            <label for="deptWise" class="seg-btn">
                                <input type="radio" id="deptWise" name="filterTypeMemo" value="Dept" checked>
                                <span><i class="fa fa-building-o me-1"></i> Dept wise</span>
                            </label>
                        ` : '';

                        const officeChecked = !isApex ? 'checked' : '';

                        const controlsHtml = `
                        <div class="analytics-filter-toolbar">
                            <div id="fType" class="analytics-segmented-group">
                                ${deptRadio}
                                <label for="officeWise" class="seg-btn">
                                    <input type="radio" id="officeWise" name="filterTypeMemo" value="Office" ${officeChecked}>
                                    <span><i class="fa fa-briefcase me-1"></i> Office wise</span>
                                </label>
                                <label for="userWise" class="seg-btn">
                                    <input type="radio" id="userWise" name="filterTypeMemo" value="User">
                                    <span><i class="fa fa-user-circle-o me-1"></i> User wise</span>
                                </label>
                            </div>

                            <div id="fYearlbl" class="analytics-year-box">
                                <span class="year-label-text"><i class="fa fa-calendar-o text-primary me-1"></i> Year (last 5 years):</span>
                                <select id="fYear" name='fYearMemo' class="fyear-dropdown select" aria-label="Select Financial Year">
                                    <option value="">All</option>
                                </select>
                            </div>

                            <div class='pro-search analytics-search-box'>
                                ${filterDiv.html()}
                            </div>
                        </div>`;

                        filterDiv.html(controlsHtml);

                        populateFinancialYears(restoreFYear);

                        // Restore selected radio button
                        setTimeout(() => {
                            if (restoreSelectedType) {
                                $(`input[name="filterTypeMemo"][value="${restoreSelectedType}"]`).prop('checked', true);
                            }
                            if (restoreFYear) {
                                $('#fYear').val(restoreFYear);
                            }
                        }, 100);

                        //Event: Financial Year change
                        $('#fYear').on('change', function () {
                            const selectedYear = $(this).val();
                            const selectedType = $('input[name="filterTypeMemo"]:checked').val();
                            GetDataDashboardStatIndivisual(selectedYear, selectedType);
                        });

                        // Event: Filter type change
                        $('input[name="filterTypeMemo"]').on('change', function () {
                            const selectedType = $(this).val();
                            const selectedYear = $('#fYear').val();
                            GetDataDashboardStatIndivisual(selectedYear, selectedType);
                        });
                    },
                    paging: true,
                    searching: true,
                    ordering: true,
                    autoWidth: false,
                    responsive: true,
                    info: true,
                    lengthChange: true,
                    pageLength: 50,
                    language: {
                        emptyTable: "No Memorandums found for the selected year(s)",
                        infoEmpty: "Showing 0 to 0 of 0 entries",
                    }
                });

                if (dataTable.rows().count() === 0) {
                    $("#fYearlbl").show();
                }

            } else {
                $("#showOuterMemoData").html("<p>No Data Found</p>");
                $("#loader-wrapper").hide();
            }
        },
        error: function () {
            $("#loader-wrapper").hide();
            $("#showOuterMemoData").html("<p>Error occurred while fetching data.</p>");
        }
    });
}

