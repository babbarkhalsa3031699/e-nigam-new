<body>

    <div class="main-content" id="main-content">
        @if (Model.RMenuName == null)
        {
            <h4 id="lblmenuname" style="
        /* padding-left: 15px;*/
        text-align: center;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        color: #1974d2;
        text-transform: uppercase;
        letter-spacing: 1px;
        background: linear-gradient(90deg, #1974d2, #5e92f3);
        -webkit-background-clip: text;
        color: transparent;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        /*margin-top: 10px;*/
        padding-bottom: 1px;
        ">
                Dashboard
            </h4>

            @*<h4 id="lblmenuname" class="gradient-heading">Welcome Dashboard</h4>*@

            <div class="row">
                @{
                    // Determine tab visibility
                    bool showMeetingFilter = CurrentSession.DeptID != "LG00001";
                }
                @if (showMeetingFilter)
                {
                    <div class="row justify-content-center">
                        <div class="col-md-6 d-flex align-items-center">
                            <label for="MeetingId" class="me-3 mb-0"> House/Committee</label>
                            @Html.DropDownList(
                                                    "MeetingId",
                                                    new List<SelectListItem>
                                                    {
                                                        new SelectListItem { Text = "House", Value = "1" },
                                                        new SelectListItem { Text = "F&CC", Value = "2" },
                                                        new SelectListItem { Text = "RC", Value = "3" }
                                                    },
                                                    //"-- Select Meeting Type --",
                                                    new { @id = "meetingType", @class = "form-control", @style = "width: 60%;", onchange = "onMeetingChange()" }
                                                )
                        </div>
                    </div>
                }
                <!-- Tabs and Dropdown Section -->
                <div class="col-12 py-5">
                    <input type="hidden" id="dashtab" value="files" />
                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between" style="padding-left:15px;">
                        @{
                            // Determine tab visibility
                            bool showMemoTab = CurrentSession.DeptID != "LG00001" && CurrentSession.DeptID != "UDD0001";
                            bool showFilter = CurrentSession.DeptID == "LG00001";
                            bool showFilesTab = CurrentSession.isDeptApex == "1" || CurrentSession.DeptID == "LG00001" || CurrentSession.DeptID == "UDD0001";
                            bool showFilesTabPend = CurrentSession.DeptID == "LG00001" || CurrentSession.DeptID == "UDD0001";
                            bool showFilesTabOffice = CurrentSession.DeptID == "LG00001";

                            // Logic to activate one tab only
                            bool memoActive = showMemoTab; // If Memo tab shows, it's active by default
                            bool filesActive = !memoActive && showFilesTab;
                            bool filesActivePend = !memoActive && showFilesTabPend;

                         }

                        <ul class="nav nav-pills custom-tabs dashboard-tab tabs flex-column flex-sm-row mb-3 mb-sm-0 w-100">
                            @if (showMemoTab)
                            {
                                <li class="nav-item" style="flex: 1 1 20%; max-width: 20%;">
                                    <a class="nav-link custom-tab @(memoActive ? "active" : "")"
                                       id="memoTab"
                                       onclick="GetDataDashboardStatIndivisual()"
                                       data-bs-toggle="pill"
                                       href="#OpenMemoData"
                                       aria-selected="@(memoActive.ToString().ToLower())">
                                        <i class="bi bi-file-earmark-text me-2"> </i> Proposals
                                    </a>
                                </li>
                            }
                            @if (showFilesTab)
                            {
                                <li class="nav-item" style="flex: 1 1 20%; max-width: 20%;">
                                    <a class="nav-link custom-tab @(filesActive ? "active" : "")"
                                       data-tabtype="open"
                                       onclick="setActiveTab(this)"
                                       data-bs-toggle="pill"
                                       aria-selected="@(filesActive.ToString().ToLower())"
                                       href="#OpenFileData">
                                        Meeting Files
                                    </a>
                                </li>
                            }

                            @if (showFilesTabPend)
                            {
                                <li class="nav-item" style="flex: 1 1 20%; max-width: 20%;">
                                    <a class="nav-link custom-tab"
                                       data-tabtype="pending"
                                       onclick="setActiveTab(this)"
                                       data-bs-toggle="pill"
                                       aria-selected="@(filesActive.ToString().ToLower())"
                                       href="#OpenFileData">
                                        Pendency (More Than 10 Days)
                                    </a>
                                </li>
                            }
                            @if (showFilesTabOffice && @CurrentSession.RoleID == "5")
                            {
                                <li class="nav-item" style="flex: 1 1 20%; max-width: 20%;">
                                    <a class="nav-link custom-tab"
                                       data-tabtype="pending"
                                       onclick="loadBranchReport(this)"
                                       data-bs-toggle="pill"
                                       href="#OpenFileData">
                                        Office Wise
                                    </a>
                                </li>
                            }

                            @if (showFilesTabOffice && @CurrentSession.RoleID == "5")
                            {

                                <li class="nav-item" style="flex: 1 1 20%; max-width: 20%;">
                                    <a class="nav-link custom-tab"
                                       data-tabtype="pendingADC"
                                       onclick="setActiveTab(this)"
                                       data-bs-toggle="pill"
                                       aria-selected="@(filesActive.ToString().ToLower())"
                                       href="#OpenFileData">
                                        ADC Wise
                                    </a>
                                </li>
                            }

                            @*@if (showFilesTabOffice && @CurrentSession.RoleID == "5")
                            {
                                <li class="nav-item" style="flex: 1 1 20%; max-width: 20%;">
                                    <a class="nav-link custom-tab"
                                       data-tabtype="pending"
                                       onclick="ResolutionSearchShow(this)"
                                       data-bs-toggle="pill"
                                       href="#OpenFileData">
                                        Search Resolution
                                    </a>
                                </li>
                            }*@


                        </ul>
                    </div>
                    <!-- Tab Content -->
                    <div class="tab-content mt-4">
                        <!-- Memorandum Content -->
                        <div class="tab-pane fade @(memoActive ? "show active" : "")" id="OpenMemoData">
                            <div class="table-responsive p-0">
                                <div id="showOuterMemo" class="content-box border rounded-3 p-4 shadow-sm">
                                    <div id="showOuterMemoData">



                                    </div>
                                    <div id="showInnerMemoData"></div>
                                </div>
                            </div>
                        </div>
                        <!-- Meeting Files Content -->
                        <div class="tab-pane fade @(filesActive || filesActivePend ? "show active" : "")" id="OpenFileData">
                            <div class="table-responsive p-0">
                                <div id="showOuterFile" class="content-box border rounded-3 p-4 shadow-sm">
                                    <style>
                                        .filter-panel {
                                            border: 1px solid #dcdcdc;
                                            padding: 10px 12px;
                                            border-radius: 6px;
                                            background-color: #fafafa;
                                        }

                                            .filter-panel label {
                                                font-size: 12px;
                                                margin-bottom: 2px;
                                            }

                                            .filter-panel .form-control {
                                                height: 30px;
                                                font-size: 12px;
                                                padding: 2px 6px;
                                            }
                                    </style>
                                    @if (showFilter)
                                    {
                                        <div class="compact-filter mb-3" id="filterLG">
                                            <div class="row align-items-end">

                                                <!-- ULB Type -->
                                                <div class="col-md-2 col-sm-6">
                                                    <label>ULB Type</label>
                                                    <select id="ddlBodyType"
                                                            onchange="filterOuterMemo();"
                                                            class="form-control">
                                                        <option value="1">Municipal Corporation</option>
                                                        <option value="2">Municipal Council</option>
                                                        <option value="3">Nagar Panchayat</option>
                                                        <option value="4">Improvement Trust</option>
                                                    </select>
                                                </div>

                                                <!-- MC Class -->
                                                <div class="col-md-2 col-sm-6">
                                                    <label>MC Class</label>
