   function loadBranchReport(tab) {

    // 🔹 Active tab handling
    $('.custom-tab').removeClass('active');
    $(tab).addClass('active');

    $.ajax({
        url: '@Url.Action("GetDashboardBranchReport","References")',
        type: 'GET',
        cache: false,
        success: function (res) {

            $('#loader-wrapper').hide();
            $("#OpenMemoData").hide();
            $("#showOuterFile").hide();
            $("#showOuterFileData").hide();
            $("#showOuterOfficeFileData").html(res).show();
            $("#showOuterOfficeFileData").show();
            $("#detailContainer").hide();

            $('#showInnerFileData').hide();
            $('#showOuterMemoData').hide();

            if ($.fn.DataTable.isDataTable('#StatsDepartmentOffice')) {
                $('#StatsDepartmentOffice').DataTable().destroy();
            }

            // ✅ Initialize DataTable
            $('#StatsDepartmentOffice').DataTable({
                paging: true,
                searching: true,
                ordering: false,
                autoWidth: false,
                responsive: true,
                info: true,
                lengthChange: true,
                pageLength: 100,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fa fa-file-excel-o"></i> Export Excel',
                        title: 'Office Wise Report',
                        className: 'btn btn-export-excel'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="fa fa-file-pdf-o"></i> Export PDF',
                        title: 'Office Wise Report',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        className: 'btn btn-export-pdf',

                        exportOptions: {
                            columns: ':visible'
                        },

                        customize: function (doc) {

                            // Font size
                            doc.defaultStyle.fontSize = 7;

                            // Header style
                            doc.styles.tableHeader.fontSize = 7;
                            doc.styles.tableHeader.bold = true;
                            doc.styles.tableHeader.alignment = 'center';

                            // Narrow margins
                            doc.pageMargins = [5, 20, 5, 20];

                            // Fit table width
                            var columnCount = doc.content[1].table.body[0].length;
                            doc.content[1].table.widths = Array(columnCount).fill('*');

                            // Center alignment
                            doc.styles.tableBodyEven.alignment = 'center';
                            doc.styles.tableBodyOdd.alignment = 'center';

                            // Prevent overflow
                            doc.content[1].layout = {
                                hLineWidth: function () { return 0.5; },
                                vLineWidth: function () { return 0.5; },
                                hLineColor: function () { return '#aaa'; },
                                vLineColor: function () { return '#aaa'; },
                                paddingLeft: function () { return 2; },
                                paddingRight: function () { return 2; }
                            };
                        }
                    }
                ],
            });
        },
        error: function (err) {
            $('#branchReportContainer').html(
                "<div style='color:red;text-align:center;'>Error loading data</div>"
            );
            console.log(err);
        }
    });
                }


