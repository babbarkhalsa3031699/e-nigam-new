// Function to populate the financial years dynamically (e.g., from database or predefined list)
        function populateFinancialYears(fyear) {
            // Example: Populate last 5 years as options in the dropdown
            const years = [];
            const currentYear = new Date().getFullYear();
            for (let i = currentYear; i >= currentYear - 5; i--) {
                years.push(i);
            }

            const fYearDropdown = $('#fYear');
            //fYearDropdown.empty(); // Clear existing options
            years.forEach(year => {
                const isSelected = (fyear && fyear === year.toString()) ? 'selected' : '';
                fYearDropdown.append(`<option value="${year}" ${isSelected}>${year}</option>`);
            });
        }

        function populateFinancialYearsFile(fyear = '') {
            // Debugging: Log the passed fyear
            console.log(`fyear received: ${fyear}`);

            const currentYear = new Date().getFullYear(); // Get current year
            const years = [];

            // Generate last 5 years including the current year
            for (let i = currentYear; i >= currentYear - 4; i--) {
                years.push(i.toString()); // Convert to string for uniform comparison
            }

            const fYearDropdown = $('#fYear1');

            // Ensure the dropdown exists
            if (fYearDropdown.length === 0) {
                console.error("Dropdown with ID 'fYear1' not found.");
                return;
            }

            // Clear existing options to avoid duplication
            //fYearDropdown.empty();

            // Add "All" option first
            //fYearDropdown.append(`<option value="All" ${fyear === 'All' ? 'selected' : ''}>All</option>`);

            // Populate year options
            years.forEach(year => {
                const isSelected = (fyear && fyear === year) ? 'selected' : '';
                fYearDropdown.append(`<option value="${year}" ${isSelected}>${year}</option>`);
            });

            // Debugging: Log the final dropdown HTML
            console.log(fYearDropdown.html());
        }





 function GetParameterValues(param) {

            // window.location.href.slice(0, -1);
            var url = window.location.href.slice(window.location.href.indexOf('?') + 1).split('&');

            for (var i = 0; i < url.length; i++) {
