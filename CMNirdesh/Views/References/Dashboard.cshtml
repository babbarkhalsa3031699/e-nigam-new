        /* Segmented Dashboard Toggle */
        .dashboard-toggle {
            display: inline-flex;
            border: 1px solid #d1d5db;
            border-radius: 30px;
            overflow: hidden;
            background: #f3f4f6;
            margin-top: 2px;
        }

            /* Hide radio */
            .dashboard-toggle input {
                display: none;
            }

            /* Toggle buttons */
            .dashboard-toggle label {
                padding: 6px 16px;
