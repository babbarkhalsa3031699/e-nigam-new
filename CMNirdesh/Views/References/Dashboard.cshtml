            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        .year-label-text {
            font-size: 10.5px;
            font-weight: 600;
            color: #475569;
            white-space: nowrap;
        }
        .analytics-year-box select.fyear-dropdown {
            height: 26px !important;
            font-size: 11px !important;
            font-weight: 600 !important;
            padding: 1px 6px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 5px !important;
            background-color: #ffffff !important;
            color: #1e293b !important;
            cursor: pointer;
        }
        .analytics-year-box select.fyear-dropdown:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15) !important;
            outline: none !important;
        }

        /* Search input modern styling - Compact */
        .analytics-search-box label,
        .dataTables_wrapper .dataTables_filter label {
            font-size: 10.5px !important;
            font-weight: 600 !important;
            color: #475569 !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
            margin: 0 !important;
        }
        .analytics-search-box input,
        .dataTables_wrapper .dataTables_filter input {
            height: 26px !important;
            font-size: 11px !important;
            padding: 2px 10px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 16px !important;
            outline: none !important;
            background: #ffffff !important;
            color: #1e293b !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04) !important;
        }
        .analytics-search-box input:focus,
        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: #2563eb !important;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15) !important;
        }

        /* Show entries (length) - Compact */
        .dataTables_wrapper .dataTables_length {
            margin-bottom: 6px;
        }
        .dataTables_wrapper .dataTables_length label {
            font-size: 11px !important;
            font-weight: 600 !important;
            color: #475569 !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
            margin: 0 !important;
        }
        .dataTables_wrapper .dataTables_length select {
            height: 26px !important;
            font-size: 11px !important;
            font-weight: 600 !important;
            padding: 1px 6px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 5px !important;
            background-color: #ffffff !important;
            color: #1e293b !important;
            cursor: pointer;
        }

        /* ==========================================================================
           EXECUTIVE DATA TABLES - COMPACT & SPACE EFFICIENT
           ========================================================================== */
        #MemoType,
        #StatsDepartment,
        #StatsDepartmentOffice,
        #Ind111 {
            width: 100% !important;
            border-collapse: separate !important;
            border-spacing: 0 !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 6px !important;
            font-size: 11px !important;
            background: #ffffff !important;
            overflow: hidden !important;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02) !important;
            margin-top: 4px !important;
            margin-bottom: 6px !important;
        }

        /* Top Hero Header Row (e.g. "House Resolutions" in MemoType) - Compact */
        #MemoType thead tr:first-child td,
        #MemoType thead tr:first-child th {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
            color: #ffffff !important;
            font-size: 11.5px !important;
            font-weight: 700 !important;
            letter-spacing: 0.5px !important;
            text-transform: uppercase !important;
            text-align: center !important;
            padding: 5px 8px !important;
            height: 26px !important;
            border: none !important;
        }
        #MemoType thead tr:first-child td:first-child:empty {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%) !important;
        }

        /* Column Sub-Headers ("Department", "Total Proposal" in MemoType) - Compact */
        #MemoType thead tr:nth-child(2) td,
        #MemoType thead tr:nth-child(2) th {
            background: #f8fafc !important;
            color: #334155 !important;
            font-size: 10.5px !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.3px !important;
            border-top: 1px solid #cbd5e1 !important;
            border-bottom: 1px solid #cbd5e1 !important;
            border-left: 1px solid #e2e8f0 !important;
            border-right: 1px solid #e2e8f0 !important;
            padding: 4px 8px !important;
            height: 24px !important;
            vertical-align: middle !important;
            text-align: center !important;
        }
        #MemoType thead tr:nth-child(2) td:first-child,
        #MemoType thead tr:nth-child(2) th:first-child {
            text-align: left !important;
            padding-left: 10px !important;
        }

        /* StatsDepartment & StatsDepartmentOffice Headers (Preserves Distinct Category Theming) */
        #StatsDepartment thead th,
        #StatsDepartmentOffice thead th {
            font-size: 11px !important;
            padding: 5px 6px !important;
            vertical-align: middle !important;
            text-align: center !important;
            line-height: 1.25 !important;
            box-sizing: border-box !important;
        }
        #StatsDepartment thead th span,
        #StatsDepartmentOffice thead th span {
            font-size: 9.5px !important;
            line-height: 1.2 !important;
        }

        /* Optional Row 3 Header when empty */
        #MemoType thead tr:nth-child(3) td:empty {
            display: none !important;
        }

        /* Table Body Rows & Hover - Compact */
        #MemoType tbody tr,
        #StatsDepartment tbody tr,
        #StatsDepartmentOffice tbody tr,
        #Ind111 tbody tr {
            transition: background-color 0.12s ease !important;
            background-color: #ffffff;
        }
        #MemoType tbody tr:nth-child(even),
        #StatsDepartment tbody tr:nth-child(even),
        #StatsDepartmentOffice tbody tr:nth-child(even),
        #Ind111 tbody tr:nth-child(even) {
            background-color: #f8fafc !important;
        }
        #MemoType tbody tr:hover,
        #StatsDepartment tbody tr:hover,
        #StatsDepartmentOffice tbody tr:hover,
        #Ind111 tbody tr:hover {
            background-color: #eff6ff !important;
        }
        #MemoType tbody td,
        #StatsDepartment tbody td,
        #StatsDepartmentOffice tbody td,
        #Ind111 tbody td {
            padding: 3px 8px !important;
            font-size: 11px !important;
            border: 1px solid #f1f5f9 !important;
            vertical-align: middle !important;
            text-align: center !important;
            color: #334155 !important;
            line-height: 1.25 !important;
        }

        /* Department Column (First Column) - Compact */
        #MemoType tbody td:first-child,
        #StatsDepartment tbody td:first-child,
        #StatsDepartmentOffice tbody td:first-child {
            font-weight: 600 !important;
            color: #0f172a !important;
            text-align: left !important;
            padding-left: 10px !important;
            white-space: nowrap !important;
            cursor: pointer !important;
        }
        #MemoType tbody td:first-child a,
        #StatsDepartment tbody td:first-child a {
            color: #0f172a !important;
            text-decoration: none !important;
            font-weight: 600 !important;
        }
        #MemoType tbody td:first-child:hover,
        #MemoType tbody td:first-child a:hover,
        #StatsDepartment tbody td:first-child:hover,
        #StatsDepartmentOffice tbody td:first-child:hover {
            color: #2563eb !important;
        }

        /* Metric Count Pill Badges - Compact */
        #MemoType tbody td a:not([actionCode]),
        #StatsDepartment tbody td a,
        #StatsDepartmentOffice tbody td a {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-width: 24px !important;
            height: 20px !important;
            padding: 1px 6px !important;
            border-radius: 10px !important;
            background: #eff6ff !important;
            color: #1d4ed8 !important;
            border: 1px solid #bfdbfe !important;
            font-weight: 700 !important;
            font-size: 10.5px !important;
            text-decoration: none !important;
            box-shadow: 0 1px 2px rgba(37, 99, 235, 0.06) !important;
            transition: all 0.15s ease !important;
        }
        #MemoType tbody td a:not([actionCode]):hover,
        #StatsDepartment tbody td a:hover,
        #StatsDepartmentOffice tbody td a:hover {
            background: #2563eb !important;
            color: #ffffff !important;
            border-color: #2563eb !important;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3) !important;
            transform: scale(1.06) !important;
        }

        /* Total Summary Row (Bottom Row) - Compact */
        #MemoType tbody tr#trtd0,
        #MemoType tbody tr:last-child,
        #StatsDepartment tbody tr:last-child,
        #StatsDepartmentOffice tbody tr:last-child {
            background: #0f172a !important;
            border-top: 2px solid #2563eb !important;
        }
        #MemoType tbody tr#trtd0 td,
        #MemoType tbody tr:last-child td,
        #StatsDepartment tbody tr:last-child td,
        #StatsDepartmentOffice tbody tr:last-child td {
            background: #0f172a !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            font-size: 11px !important;
            padding: 4px 8px !important;
            border-top: 2px solid #2563eb !important;
            border-bottom: 1px solid #0f172a !important;
            border-left: 1px solid rgba(255, 255, 255, 0.06) !important;
            border-right: 1px solid rgba(255, 255, 255, 0.06) !important;
            text-align: center !important;
            vertical-align: middle !important;
            display: table-cell !important;
        }
        #MemoType tbody tr#trtd0 td:first-child,
        #MemoType tbody tr:last-child td:first-child,
        #StatsDepartment tbody tr:last-child td:first-child,
        #StatsDepartmentOffice tbody tr:last-child td:first-child {
            color: #ffffff !important;
            text-transform: uppercase !important;
            letter-spacing: 0.5px !important;
            font-weight: 800 !important;
            text-align: left !important;
            padding-left: 10px !important;
        }

        /* Total Count Pill Badge in Total Row - Compact & Centered */
        #MemoType tbody tr#trtd0 td a,
        #MemoType tbody tr:last-child td a,
        #MemoType tbody tr#trtd0 td.total a,
        #MemoType tbody tr:last-child td.total a,
        #MemoType tbody tr#trtd0 td .total-badge,
        #MemoType tbody tr:last-child td .total-badge,
        #StatsDepartment tbody tr:last-child td a,
        #StatsDepartmentOffice tbody tr:last-child td a,
        .total-badge {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
            color: #ffffff !important;
            border: 1px solid #34d399 !important;
            font-weight: 800 !important;
            font-size: 11px !important;
            padding: 2px 8px !important;
            height: 20px !important;
            min-width: 28px !important;
            border-radius: 10px !important;
            box-shadow: 0 1px 5px rgba(16, 185, 129, 0.4) !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            text-decoration: none !important;
            margin: 0 auto !important;
        }
        #MemoType tbody tr#trtd0 td a:hover,
        #MemoType tbody tr:last-child td a:hover,
        #MemoType tbody tr#trtd0 td .total-badge:hover,
        #MemoType tbody tr:last-child td .total-badge:hover,
        .total-badge:hover {
            transform: scale(1.06) !important;
            box-shadow: 0 3px 8px rgba(16, 185, 129, 0.55) !important;
        }

        /* DataTables Information & Pagination - Compact */
        .dataTables_wrapper .dataTables_info {
            color: #64748b !important;
            font-size: 11px !important;
            font-weight: 500 !important;
            padding-top: 6px !important;
        }
        .dataTables_wrapper .dataTables_paginate {
            padding-top: 4px !important;
        }
        .dataTables_wrapper .paginate_button {
            border-radius: 4px !important;
            border: 1px solid #cbd5e1 !important;
            background: #ffffff !important;
            color: #475569 !important;
            font-weight: 600 !important;
            font-size: 11px !important;
            padding: 2px 8px !important;
            margin: 0 1px !important;
            transition: all 0.15s ease !important;
            cursor: pointer !important;
        }
        .dataTables_wrapper .paginate_button.current,
        .dataTables_wrapper .paginate_button.current:hover {
            background: #2563eb !important;
            border-color: #2563eb !important;
            color: #ffffff !important;
            box-shadow: 0 1px 4px rgba(37, 99, 235, 0.25) !important;
        }
        .dataTables_wrapper .paginate_button:hover {
            background: #f1f5f9 !important;
            color: #0f172a !important;
            border-color: #94a3b8 !important;
        }
        .dataTables_wrapper .paginate_button.disabled,
        .dataTables_wrapper .paginate_button.disabled:hover {
            background: #f8fafc !important;
            color: #cbd5e1 !important;
            border-color: #e2e8f0 !important;
            cursor: not-allowed !important;
        }
    </style>

</head>

<body>

    <div class="main-content" id="main-content">
        @if (Model.RMenuName == null)
        {
            <div class="analytics-hero-bar mb-3">
                <div class="analytics-hero-title">
                    <div class="hero-icon-badge">
                        <i class="fa fa-dashboard text-white"></i>
                    </div>
                    <div>
                        <div class="hero-main-title">Analytics Dashboard</div>
                    </div>
                </div>
                <div class="analytics-hero-badge">
                    <span class="live-pulse-dot"></span> Live Summary
                </div>
            </div>

            <div class="row">
                @{
                    // Determine tab visibility
                    bool showMeetingFilter = CurrentSession.DeptID != "LG00001";
                    bool showMemoTab = CurrentSession.DeptID != "LG00001" && CurrentSession.DeptID != "UDD0001";
                    bool showFilter = CurrentSession.DeptID == "LG00001";
                    bool showFilesTab = CurrentSession.isDeptApex == "1" || CurrentSession.DeptID == "LG00001" || CurrentSession.DeptID == "UDD0001";
                    bool showFilesTabPend = CurrentSession.DeptID == "LG00001" || CurrentSession.DeptID == "UDD0001";
                    bool showFilesTabOffice = CurrentSession.DeptID == "LG00001";

                    // Logic to activate one tab only
                    bool memoActive = showMemoTab; // If Memo tab shows, it's active by default
                    bool filesActive = !memoActive && showFilesTab;
                    bool filesActivePend = !memoActive && showFilesTabPend;
                }

                <!-- Unified Single-Row: Tabs on Left, Filter on Right -->
                <div class="col-12 mb-1">
                    <input type="hidden" id="dashtab" value="files" />
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <!-- Navigation Tabs (Left) -->
                        <ul class="nav nav-pills custom-tabs analytics-tabs-nav mb-0">
                            @if (showMemoTab)
                            {
                                <li class="nav-item">
                                    <a class="nav-link custom-tab @(memoActive ? "active" : "")"
                                       id="memoTab"
                                       onclick="GetDataDashboardStatIndivisual()"
                                       data-bs-toggle="pill"
                                       href="#OpenMemoData"
                                       aria-selected="@(memoActive.ToString().ToLower())">
                                        <i class="fa fa-file-text-o"></i> Proposals
                                    </a>
                                </li>
                            }
                            @if (showFilesTab)
                            {
                                <li class="nav-item">
                                    <a class="nav-link custom-tab @(filesActive ? "active" : "")"
                                       data-tabtype="open"
                                       onclick="setActiveTab(this)"
                                       data-bs-toggle="pill"
                                       aria-selected="@(filesActive.ToString().ToLower())"
                                       href="#OpenFileData">
                                        <i class="fa fa-folder-open-o"></i> Meeting Files
                                    </a>
                                </li>
                            }

                            @if (showFilesTabPend)
                            {
                                <li class="nav-item">
                                    <a class="nav-link custom-tab"
                                       data-tabtype="pending"
                                       onclick="setActiveTab(this)"
                                       data-bs-toggle="pill"
                                       aria-selected="@(filesActive.ToString().ToLower())"
                                       href="#OpenFileData">
                                        <i class="fa fa-clock-o"></i> Pendency (&gt; 10 Days)
                                    </a>
                                </li>
                            }
                            @if (showFilesTabOffice && @CurrentSession.RoleID == "5")
                            {
                                <li class="nav-item">
                                    <a class="nav-link custom-tab"
                                       data-tabtype="pending"
                                       onclick="loadBranchReport(this)"
                                       data-bs-toggle="pill"
                                       href="#OpenFileData">
                                        <i class="fa fa-building-o"></i> Office Wise
                                    </a>
                                </li>
                            }

                            @if (showFilesTabOffice && @CurrentSession.RoleID == "5")
                            {
                                <li class="nav-item">
                                    <a class="nav-link custom-tab"
                                       data-tabtype="pendingADC"
                                       onclick="setActiveTab(this)"
                                       data-bs-toggle="pill"
                                       aria-selected="@(filesActive.ToString().ToLower())"
                                       href="#OpenFileData">
                                        <i class="fa fa-user-circle-o"></i> ADC Wise
                                    </a>
                                </li>
                            }
                        </ul>

                        <!-- House/Committee Filter (Right) -->
                        @if (showMeetingFilter)
                        {
                            <div class="analytics-filter-card">
                                <div class="analytics-filter-icon">
                                    <i class="fa fa-university"></i>
                                </div>
                                <div class="analytics-filter-content">
                                    <label for="meetingType" class="analytics-filter-label">House / Committee</label>
                                    @Html.DropDownList(
                                        "MeetingId",
                                        new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "House", Value = "1" },
                                            new SelectListItem { Text = "F&CC", Value = "2" },
                                            new SelectListItem { Text = "RC", Value = "3" }
                                        },
                                        new { @id = "meetingType", @class = "form-select form-select-sm analytics-select", onchange = "onMeetingChange()" }
                                    )
                                </div>
                            </div>
                        }
                    </div>
                    <!-- Tab Content -->
                    <div class="tab-content mt-1">
                        <!-- Memorandum Content -->
                        <div class="tab-pane fade @(memoActive ? "show active" : "")" id="OpenMemoData">
                            <div class="table-responsive p-0">
                                <div id="showOuterMemo" class="analytics-card">
                                    <div id="showOuterMemoData">



                                    </div>
                                    <div id="showInnerMemoData"></div>
                                </div>
                            </div>
                        </div>
                        <!-- Meeting Files Content -->
                        <div class="tab-pane fade @(filesActive || filesActivePend ? "show active" : "")" id="OpenFileData">
                            <div class="table-responsive p-0">
                                <div id="showOuterFile" class="analytics-card">
                                    @if (showFilter)
                                    {
                                        <div class="compact-filter-card mb-2" id="filterLG">
                                            <div class="row align-items-end g-2">

                                                <!-- ULB Type -->
                                                <div class="col-md-3 col-sm-6">
                                                    <label><i class="fa fa-university text-primary me-1"></i> ULB Type</label>
                                                    <select id="ddlBodyType"
                                                            onchange="filterOuterMemo();"
                                                            class="form-control">
                                                        <option value="1">Municipal Corporation</option>
                                                        <option value="2">Municipal Council</option>
                                                        <option value="3">Nagar Panchayat</option>
                                                        <option value="4">Improvement Trust</option>
                                                    </select>
                                                </div>

                                                <!-- MC Class -->
                                                <div class="col-md-2 col-sm-6">
                                                    <label><i class="fa fa-tags text-primary me-1"></i> MC Class</label>
                                                    <select id="ddlMCClass"
                                                            onchange="filterOuterMemo()"
                                                            class="form-control"
                                                            disabled>
                                                        <option value="">-- Select --</option>
                                                        <option value="C1">MC Class I</option>
                                                        <option value="C2">MC Class II</option>
                                                        <option value="C3">MC Class III</option>
                                                    </select>
                                                </div>

                                                <!-- Pending Days -->
                                                <div class="col-md-3 col-sm-6" id="pendingDaysWrapper">
                                                    <label><i class="fa fa-hourglass-half text-primary me-1"></i> Pending Since</label>
                                                    <select id="pendingDays"
                                                            onchange="filterOuterMemo()"
                                                            class="form-control">
                                                        <option value="">All</option>
                                                        <option value="15">15 + Days</option>
                                                        <option value="30">30 + Days</option>
                                                        <option value="60">60 + Days</option>
                                                        <option value="90">90 + Days</option>
                                                        <option value="180">180 + Days</option>
                                                        <option value="365">1 Year +</option>
                                                    </select>
                                                </div>

                                                <!-- Dashboard View -->
                                                <div class="col-md-4 col-sm-12">
                                                    <label><i class="fa fa-th-large text-primary me-1"></i> View Mode</label>

                                                    <div class="dashboard-toggle">
                                                        @{
                                                            int userType = Convert.ToInt32(CurrentSession.SubUserTypeID);

                                                            var deptUsers = new[] { 5, 3, 16, 1, 14 };
                                                            var branchUsers = new[] { 21, 20 };

                                                            bool showDept = deptUsers.Contains(userType);
                                                            bool showOffice = showDept || branchUsers.Contains(userType);
                                                            //bool showUser = true;

                                                            string selectedView = showDept ? "Dept"
                                                                                  : showOffice ? "Office"
                                                                                  : "User";
                                                        }

                                                        @if (showDept)
                                                        {
                                                            <input type="radio" id="dept" name="dashboardView"
                                                                   value="Dept"
                                                                   @(selectedView == "Dept" ? "checked" : "")
                                                                   onchange="filterOuterMemo()" />
                                                            <label for="dept">Department</label>
                                                        }

                                                        @if (showOffice)
                                                        {
                                                            <input type="radio" id="office" name="dashboardView"
                                                                   value="Office"
                                                                   @(selectedView == "Office" ? "checked" : "")
                                                                   onchange="filterOuterMemo()" />
                                                            <label for="office">Branch</label>
                                                        }

                                                        <input type="radio" id="user" name="dashboardView"
                                                               value="User"
                                                               @(selectedView == "User" ? "checked" : "")
                                                               onchange="filterOuterMemo()" />
                                                        <label for="user">User</label>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>



                                    }


                                    <div id="showOuterFileData"></div>
                                    <div id="showInnerFileData"></div>
                                    <div id="showInnerFlipFileData"></div>
                                </div>
                                <div id="showOuterOfficeFileData" class="content-box border rounded-3 p-4 shadow-sm"></div>
                                @*<div id="showOuterSearchResolution" style="display:none;">
                                    <div class="compact-filter mb-3" id="filterLG">
                                        <div class="row align-items-end">

                                            <div class="col-md-2 col-sm-6">
                                                <label>Unique/Ref ID</label>
                                                <input type="text" id="txtRefId" class="form-control" style="border-radius: 6px !important;" />
                                            </div>

                                            <div class="col-md-2 position-relative">
                                                <label>MC Name</label>
                                                <input type="text"
                                                       id="txtMCName"
                                                       class="form-control"
                                                       placeholder="Free Text Search" />

                                                <input type="hidden" id="MCID" />
                                            </div>



                                            <div class="col-md-2">
                                                <label>Resolution No</label>
                                                <input type="text"
                                                       id="txtResolutionNo"
                                                       class="form-control" />
                                            </div>

                                            <div class="col-md-2">
                                                <label>Meeting Date</label>
                                                <input type="date"
                                                       id="txtMeetingDate"
                                                       class="form-control" />
                                            </div>

                                            <div class="col-md-3">
                                                <label>&nbsp;</label><br />
                                                <button type="button"
                                                        onclick="ResolutionSearch();"
                                                        class="btn btn-primary">
                                                    Search
