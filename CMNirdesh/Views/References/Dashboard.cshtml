            var bodyType = $(this).val();

            if (bodyType === '2') {
                // Municipal Council → Enable MC Class
                $('#ddlMCClass').prop('disabled', false);
            }
            else {
                // Municipal Corporation or empty → Disable & clear
                $('#ddlMCClass').val('').prop('disabled', true);
            }
        });

