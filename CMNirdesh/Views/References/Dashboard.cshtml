@model CMNirdesh.Models.LstDashboard

@using CMNirdesh.Models

@{
    // int Totaldispatch = Model._LstDashboard.Sum(x => x.Count);
    string SiteName = System.Web.Configuration.WebConfigurationManager.AppSettings["serviceName"];
    string URL = System.Web.Configuration.WebConfigurationManager.AppSettings["URL"];
    string BlobPath = CMNirdesh.Models.BlobStorage.GetStorageAcessingPath();
}

<input type="hidden" id="intval" name="intval" value="" />
<input type="hidden" id="diarydispatchValue" name="diarydispatchValue" value="" />
<input type="hidden" id="DocumentTypeDIdHdn" name="DocumentTypeDIdHdn" value="" />
<input type="hidden" id="sincefilterhdndispatch" name="sincefilterhdndispatch" value="" />
<input type="hidden" id="radiovaluehdn" name="radiovaluehdn" value="" />
@Html.HiddenFor(m => m.RefMenutype)
@Html.HiddenFor(m => m.FileMenuType)
@Html.HiddenFor(m => m.RefMenuName)
@Html.HiddenFor(m => m.dashboardtype)


<head>

    <style>
        /* ==========================================================================
           DIGITAL-MC HOUSE - COMPACT EXECUTIVE DASHBOARD DESIGN SYSTEM
           Optimized for space utilization, clean metrics, and high-density data tables
           ========================================================================== */

        /* ----- Compact Breadcrumbs ----- */
        h4#lblmenuname,
        .compact-breadcrumb-bar {
            font-size: 14.5px !important;
            font-weight: 600 !important;
            color: #334155 !important;
            margin: 0 0 8px 0 !important;
            padding: 0 !important;
            line-height: 1.4 !important;
            display: flex !important;
            align-items: center !important;
            font-family: 'Poppins', sans-serif !important;
        }

        h4#lblmenuname span,
        .compact-breadcrumb-bar span {
            color: #94a3b8 !important;
            margin: 0 5px !important;
            font-weight: normal !important;
        }

        /* ----- Hide Redundant "User Folders" Title/Tab ----- */
        .pcss3t-theme-1 > label,
        label[for="tab1"],
        #tab1,
        #selectednew {
            display: none !important;
        }

        /* ----- Main Container Optimization ----- */
        #maindashdiv {
            margin: 0 !important;
            padding: 0 !important;
            display: block;
        }

        .pcss3t {
            position: relative;
            background: transparent;
            margin: 0 !important;
        }

        .pcss3t > ul {
            background: #ffffff !important;
            border-radius: 8px !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: none !important;
            overflow: hidden !important;
            margin: 0 !important;
        }

        .pcss3t > ul > li {
            padding: 0 !important;
            overflow: visible !important;
        }

        .pcss3t > ul > li:after {
            display: none !important;
        }

        #usercontent {
            padding: 8px 14px !important;
        }

        /* ----- Fully Responsive Folder Metric Strip (Inbox, Sent, Archive) ----- */
        #inner_value {
            margin-bottom: 12px !important;
            width: 100% !important;
        }

        #inner_value div#nav-tab,
        .message-tab {
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            gap: 12px !important;
            border-bottom: none !important;
            padding: 0 !important;
            margin: 0 !important;
            width: 100% !important;
        }

        #inner_value .nav-tabs .nav-link,
        .message-tab .nav-link {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            padding: 8px 14px !important;
            min-height: 48px !important;
            height: auto !important;
            border-radius: 8px !important;
            border: 1.5px solid #e2e8f0 !important;
            background: #ffffff !important;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03) !important;
            transition: all 0.15s ease !important;
            margin: 0 !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        .message-tab .nav-link:hover {
            border-color: #93c5fd !important;
            background: #f8fafc !important;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06) !important;
            transform: none !important;
        }

        .message-tab .nav-link.active {
            background: #f0f7ff !important;
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 1.5px rgba(59, 130, 246, 0.25) !important;
        }

        .message-tab .nav-link.active::before {
            display: none !important;
        }

        @@media (max-width: 991px) {
            #inner_value div#nav-tab,
            .message-tab {
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;
                gap: 10px !important;
            }
            #inner_value .nav-tabs .nav-link,
            .message-tab .nav-link {
                padding: 6px 10px !important;
            }
            .inbox-tabber .text-left span.ml-2 {
                font-size: 13px !important;
            }
            .click-tab h3 {
                font-size: 15px !important;
            }
        }

        @@media (max-width: 640px) {
            #inner_value div#nav-tab,
            .message-tab {
                grid-template-columns: 1fr !important;
                gap: 8px !important;
            }
            #inner_value .nav-tabs .nav-link,
            .message-tab .nav-link {
                width: 100% !important;
            }
        }

        /* Folder Header & Icon Inside Horizontal Card */
        .inbox-tabber {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            width: 100% !important;
            margin: 0 !important;
            gap: 8px !important;
            font-family: 'Poppins', sans-serif !important;
        }

        .inbox-tabber .text-left {
            display: inline-flex !important;
            align-items: center !important;
            gap: 8px !important;
            margin-bottom: 0 !important;
            font-size: 14.5px !important;
            font-weight: 700 !important;
            color: #0f172a !important;
            white-space: nowrap !important;
        }

        .inbox-tabber .text-left span:first-child {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 32px !important;
            height: 32px !important;
            border-radius: 6px !important;
            flex-shrink: 0 !important;
        }

        #nav-home-tab .text-left span:first-child {
            background: #eff6ff !important;
        }

        #nav-home-tab .text-left span:first-child svg {
            width: 18px !important;
            height: 18px !important;
        }

        #nav-home-tab .text-left span:first-child svg path {
            fill: #2563eb !important;
        }

        #nav-profile-tab .text-left span:first-child {
            background: #ecfdf5 !important;
            color: #059669 !important;
        }

        #nav-profile-tab .text-left span:first-child i {
            font-size: 15px !important;
            color: #059669 !important;
        }

        #nav-archieve-tab .text-left span:first-child {
            background: #fffbeb !important;
            color: #d97706 !important;
        }

        #nav-archieve-tab .text-left span:first-child i {
            font-size: 15px !important;
            color: #d97706 !important;
        }

        .inbox-tabber .text-left span.ml-2 {
            font-size: 14.5px !important;
            font-weight: 700 !important;
            color: #0f172a !important;
        }

        .inbox-tabber > div:last-child {
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
            flex-shrink: 0 !important;
        }

        /* Compact Metric Pill (.click-tab) */
        .click-tab {
            background: #f1f5f9 !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            padding: 4px 10px !important;
            min-width: auto !important;
            text-decoration: none !important;
            display: inline-flex !important;
            flex-direction: row !important;
            align-items: baseline !important;
            gap: 4px !important;
            cursor: pointer !important;
            box-shadow: none !important;
            transition: all 0.15s ease !important;
        }

        .click-tab:hover {
            background: #ffffff !important;
            border-color: #94a3b8 !important;
            transform: none !important;
            box-shadow: none !important;
            text-decoration: none !important;
        }

        .click-tab h3 {
            font-size: 18px !important;
            font-weight: 800 !important;
            color: #0f172a !important;
            margin: 0 !important;
            line-height: 1 !important;
            letter-spacing: -0.01em !important;
            font-family: 'Poppins', sans-serif !important;
        }

        .click-tab p {
            font-size: 11px !important;
            font-weight: 600 !important;
            color: #64748b !important;
            margin: 0 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.04em !important;
        }

        /* Active Folder Metric Highlight */
        .click-tab.active,
        #InboxFile.active,
        #OutboxFile.active,
        #ArchFile.active,
        .message-tab .nav-link.active .click-tab {
            background: #dbeafe !important;
            border-color: #3b82f6 !important;
        }

        .click-tab.active h3,
        #InboxFile.active h3,
        #OutboxFile.active h3,
        #ArchFile.active h3,
        .message-tab .nav-link.active .click-tab h3 {
            color: #1d4ed8 !important;
        }

        .click-tab.active p,
        #InboxFile.active p,
        #OutboxFile.active p,
        #ArchFile.active p,
        .message-tab .nav-link.active .click-tab p {
            color: #1e40af !important;
            font-weight: 700 !important;
        }

        /* Create Button (+) */
        .new-message-btn {
            background: #2563eb !important;
            border-color: #1d4ed8 !important;
            color: #ffffff !important;
            padding: 4px 10px !important;
            gap: 4px !important;
        }

        .new-message-btn h3 {
            font-size: 14px !important;
            color: #ffffff !important;
        }

        .new-message-btn h3 i {
            color: #1e40af !important !important;
            font-size: 12px !important;
        }

        .new-message-btn p {
            color: #ffffff !important;
            font-size: 11px !important;
        }

        .new-message-btn:hover {
            background: #1d4ed8 !important;
            color: #ffffff !important;
            transform: none !important;
        }

        /* ----- Compact Section Header ("Inbox (Files)") ----- */
        .data-content-table {
            background: #ffffff !important;
            border: none !important;
            box-shadow: none !important;
            overflow: visible !important;
            margin-top: 4px !important;
        }

        .container-padding {
            padding: 4px 0 !important;
            border: none !important;
        }

        .source-heading {
            display: flex !important;
            align-items: center !important;
            margin-bottom: 6px !important;
            padding-bottom: 4px !important;
            border-bottom: 1px solid #e2e8f0 !important;
        }

        .source-heading h4 {
            font-size: 14.5px !important;
            font-weight: 700 !important;
            color: #0f172a !important;
            margin: 0 !important;
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
            font-family: 'Poppins', sans-serif !important;
            border-bottom: none !important;
            padding-bottom: 0 !important;
        }

        .source-heading h4::before {
            content: '' !important;
            display: inline-block !important;
            width: 3px !important;
            height: 14px !important;
            background: #2563eb !important;
            border-radius: 2px !important;
        }

        /* ----- Unified Single-Line Responsive Toolbar ----- */
        #unifiedTableToolbar,
        .unified-table-toolbar {
            background: #f8fafc !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 6px !important;
            padding: 5px 10px !important;
            margin-bottom: 8px !important;
            display: flex !important;
            flex-wrap: wrap !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 6px 10px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        /* 1. Left Slot: Export Buttons (Excel, PDF) */
        .toolbar-export-slot {
            display: inline-flex !important;
            align-items: center !important;
            flex-shrink: 0 !important;
        }

        .toolbar-export-slot .dt-buttons {
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
            margin: 0 !important;
            float: none !important;
        }

        .dt-buttons .btn,
        .dt-buttons .buttons-excel,
        .dt-buttons a.btn-excel {
            background: #ecfdf5 !important;
            border: 1px solid #a7f3d0 !important;
            color: #047857 !important;
            font-weight: 600 !important;
            font-size: 11.5px !important;
            border-radius: 5px !important;
            padding: 0 11px !important;
            height: 30px !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            box-shadow: none !important;
            transition: background 0.15s ease !important;
            margin: 0 !important;
            white-space: nowrap !important;
        }

        .dt-buttons .buttons-excel:hover {
            background: #d1fae5 !important;
            color: #065f46 !important;
        }

        .dt-buttons .buttons-pdf,
        .dt-buttons a.btn-pdf {
            background: #fef2f2 !important;
            border: 1px solid #fecaca !important;
            color: #b91c1c !important;
            font-weight: 600 !important;
            font-size: 11.5px !important;
            border-radius: 5px !important;
            padding: 0 11px !important;
            height: 30px !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            box-shadow: none !important;
            transition: background 0.15s ease !important;
            margin: 0 !important;
            white-space: nowrap !important;
        }

        .dt-buttons .buttons-pdf:hover {
            background: #fee2e2 !important;
            color: #991b1b !important;
        }

        /* 2. Middle Slot: Advanced Search Filters (MC Name, Resolution No, Date, Buttons) */
        #customFiltersInbox.toolbar-filters-slot,
        .toolbar-filters-slot {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
            flex: 1 1 auto;
            margin: 0 !important;
            padding: 0 !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        /* 2b. Outbox Month & Year Filters in single unified toolbar row */
        #customFilterBar.toolbar-outbox-filter-slot,
        .toolbar-outbox-filter-slot {
            display: inline-flex !important;
            align-items: center !important;
            gap: 10px !important;
            margin: 0 15px !important;
            padding: 0 !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

        .toolbar-outbox-filter-slot select.custom-dd {
            height: 30px !important;
            font-size: 12px !important;
            padding: 2px 8px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 5px !important;
            background-color: #ffffff !important;
            color: #334155 !important;
            line-height: normal !important;
        }

        #customFiltersInbox .input-group.input-group-sm {
            height: 30px !important;
            margin: 0 !important;
        }

        #customFiltersInbox .input-group-text {
            background: #f1f5f9 !important;
            border: 1px solid #cbd5e1 !important;
            border-right: none !important;
            color: #64748b !important;
            padding: 0 8px !important;
            font-size: 11px !important;
            height: 30px !important;
            display: inline-flex !important;
            align-items: center !important;
            border-radius: 5px 0 0 5px !important;
        }

        #customFiltersInbox .form-control {
            height: 30px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 0 5px 5px 0 !important;
            font-size: 12px !important;
            padding: 2px 8px !important;
            color: #1e293b !important;
            background: #ffffff !important;
        }

        #customFiltersInbox .form-control:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15) !important;
            outline: none !important;
        }

        .filter-item-mc {
            flex: 1 1 150px;
            max-width: 220px;
            min-width: 130px;
            position: relative;
        }

        .filter-item-res {
            flex: 1 1 120px;
            max-width: 150px;
            min-width: 105px;
        }

        .filter-item-date {
            flex: 1 1 130px;
            max-width: 155px;
            min-width: 125px;
        }

        .filter-item-btns {
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            flex-shrink: 0 !important;
        }

        #customFiltersInbox button[onclick="AdvanceInboxSearch()"] {
            background: #2563eb !important;
            border: none !important;
            color: #ffffff !important;
            font-weight: 600 !important;
            font-size: 12px !important;
            padding: 0 12px !important;
            height: 30px !important;
            border-radius: 5px !important;
            box-shadow: none !important;
            transition: all 0.15s ease !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            white-space: nowrap !important;
        }

        #customFiltersInbox button[onclick="AdvanceInboxSearch()"]:hover {
            background: #1d4ed8 !important;
        }

        #customFiltersInbox button[onclick="clearSearch()"] {
            background: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            color: #475569 !important;
            font-weight: 600 !important;
            font-size: 12px !important;
            padding: 0 10px !important;
            height: 30px !important;
            border-radius: 5px !important;
            transition: all 0.15s ease !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 4px !important;
            white-space: nowrap !important;
        }

        #customFiltersInbox button[onclick="clearSearch()"]:hover {
            background: #f1f5f9 !important;
            border-color: #94a3b8 !important;
            color: #0f172a !important;
        }

        /* 3. Right Slot: DataTables Quick Search */
        .toolbar-search-slot {
            display: inline-flex !important;
            align-items: center !important;
            flex-shrink: 0 !important;
            margin-left: auto !important;
        }

        .toolbar-search-slot .dataTables_filter {
            float: none !important;
            display: inline-flex !important;
            align-items: center !important;
            margin: 0 !important;
        }

        .toolbar-search-slot .dataTables_filter label {
            font-weight: 600 !important;
            font-size: 12px !important;
            color: #475569 !important;
            margin-bottom: 0 !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 6px !important;
            white-space: nowrap !important;
        }

        .toolbar-search-slot .dataTables_filter input {
            height: 30px !important;
            border-radius: 5px !important;
            border: 1px solid #cbd5e1 !important;
            padding: 2px 8px !important;
            font-size: 12px !important;
            background: #ffffff !important;
            width: 150px !important;
            min-width: 110px !important;
            margin: 0 !important;
        }

        .toolbar-search-slot .dataTables_filter input:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15) !important;
            outline: none !important;
        }

        /* Suggestions Autocomplete Box */
        #mcSuggestions1, #mcSuggestions {
            position: absolute !important;
            width: 100% !important;
            z-index: 1060 !important;
            background: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12) !important;
            max-height: 220px !important;
            overflow-y: auto !important;
            top: 32px !important;
            left: 0 !important;
        }

        /* Prevent unplaced elements in dataTables_wrapper from displaying redundant rows */
        #DispatchTable_wrapper > .dt-buttons,
        #DispatchTable_wrapper > .dataTables_filter {
            display: none !important;
        }

        .dataTables_wrapper {
            width: 100% !important;
            margin: 0 auto !important;
            clear: both !important;
        }

        /* Responsive rules */
        @@media (max-width: 1199.98px) {
            #unifiedTableToolbar {
                gap: 8px !important;
            }
            .toolbar-filters-slot {
                order: 3;
                width: 100% !important;
                padding-top: 4px !important;
                border-top: 1px dashed #e2e8f0 !important;
            }
            .toolbar-search-slot {
                margin-left: auto !important;
            }
        }

        @@media (max-width: 767.98px) {
            .filter-item-mc, .filter-item-res, .filter-item-date {
                flex: 1 1 100% !important;
                max-width: 100% !important;
            }
            .filter-item-btns {
                width: 100% !important;
                justify-content: flex-start !important;
            }
            .toolbar-export-slot, .toolbar-search-slot {
                width: 100% !important;
                justify-content: space-between !important;
            }
            .toolbar-search-slot .dataTables_filter,
            .toolbar-search-slot .dataTables_filter label,
            .toolbar-search-slot .dataTables_filter input {
                width: 100% !important;
            }
        }

        /* ----- High-Density Responsive Table with Light Row & Column Borders ----- */
        .table-outer {
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            background: #ffffff !important;
            overflow: hidden !important;
            box-shadow: none !important;
            width: 100% !important;
            padding: 8px 10px !important;
        }

        .table-responsive.table-cus {
            margin-top: 4px !important;
            width: 100% !important;
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }

        /* Slim modern scrollbar */
        .table-responsive::-webkit-scrollbar {
            height: 7px !important;
            width: 7px !important;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f1f5f9 !important;
            border-radius: 4px !important;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #94a3b8 !important;
            border-radius: 4px !important;
        }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #64748b !important;
        }

        #DispatchTable {
            width: 100% !important;
            border-collapse: collapse !important;
            border: 1px solid #cbd5e1 !important;
            margin: 0 !important;
        }

        /* Table Header - Aligned Single Header */
        #DispatchTable thead th,
        table.dataTable thead th.td-heading,
        table.dataTable thead th {
            background: #1e40af !important;
            color: #ffffff !important;
            font-size: 12px !important;
            font-weight: 700 !important;
            text-transform: capitalize !important;
            letter-spacing: 0.01em !important;
            padding: 8px 10px !important;
            border-top: none !important;
            border-left: none !important;
            border-right: 1px solid rgba(255, 255, 255, 0.25) !important; /* Column-wise header divider */
            border-bottom: 2px solid #1e3a8a !important;                   /* Header bottom divider */
            vertical-align: middle !important;
            white-space: nowrap !important;
        }

        #DispatchTable thead th:last-child,
        table.dataTable thead th:last-child {
            border-right: none !important;
        }

        #DispatchTable thead th span,
        table.dataTable thead th span {
            color: #ffffff !important;
            font-weight: 700 !important;
            font-size: 12px !important;
        }

        /* Row & Column Wise Light Border for Body Cells */
        #DispatchTable tbody tr td {
            font-size: 12px !important;
            line-height: 1.35 !important;
            color: #1e293b !important;
            border-top: none !important;
            border-left: none !important;
            border-right: 1px solid #e2e8f0 !important;  /* Column-wise light border */
            vertical-align: middle !important;
            background: #ffffff;
            transition: background 0.1s ease !important;
