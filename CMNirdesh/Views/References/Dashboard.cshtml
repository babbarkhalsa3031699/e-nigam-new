        /* Labels */
        .compact-filter label {
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 4px;
            color: #555;
            display: block;
        }

        /* Compact Dropdowns (Bootstrap 3 safe) */
        .compact-filter select.form-control {
            height: 30px !important;
