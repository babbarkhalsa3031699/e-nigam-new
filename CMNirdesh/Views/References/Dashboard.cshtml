                    var selectedtab = $("#dashtab").val();
                    if (selectedtab == "files") {
                        $("#showinner").hide();
                        GetDataDashboardStat();
                    } else {
                        GetDataDashboardStatIndivisual();
                    }


                });
            }
        });



        function openFileHistory(obj) {
            var id = $(obj).attr('id');
            $("#fileHistoryModal").modal("show");
            $("#fileHistoryBody").html("<tr><td colspan='4'></td></tr>");

            $.ajax({
                url: '@Url.Action("GetFileMovementHistory","References")',
                type: 'GET',
                data: { refId: id },
                success: function (data) {
                    $("#fileHistoryBody").html(data);
                 }
            });
        }


