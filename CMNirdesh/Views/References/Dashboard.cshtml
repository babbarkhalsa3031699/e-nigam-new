                    //alert("rd clicked");
                    // Remove active from all
                    $('.dashboard-card').removeClass('active');
                    $('.dashboardChk').prop('checked', false);

                    // Add active to clicked
                    $(this).addClass('active');
                    $(this).find('.dashboardChk').prop('checked', true);

                    var selectedValue = $(this).data('value');
                     var deptId = '@CurrentSession.DeptID';
                    if (deptId === "LG00001") {
                        GetDataDashboardStatDepartmentOpen('', '', '1', '');
                    }
                    else if (deptId === "UDD0001") {
                        GetDataDashboardStatDepartmentOpen('', '', '2', '');
                    }
                });

                var dashtype = '@Model.dashboardtype';
                if (dashtype == 1) {
                    GotoInbox("Letter");
                } else if (dashtype == 2) {
                    GotoInbox("File");
                }


                tinymce.init({
                    selector: '#txtBody',
                    height: 350,
                    menubar: false,
                    plugins: 'lists link table code fullscreen',
                    toolbar: 'undo redo | bold italic underline | bullist numlist | alignleft aligncenter alignright | table | fullscreen code',

                    content_style: "body { font-family:Segoe UI; font-size:14px }",

                    branding: false
                });
            });




        $(document).ready(function () {

            if (@Model.RefMenutype == 0) {
                $("#maindashdiv").hide();

                GetofficeType('@CurrentSession.DeptID','');

               var deptId = '@CurrentSession.DeptID';

                    if (deptId === "LG00001") {
                        GetDataDashboardStatDepartmentOpen('', '', '1', '');
                    }
                    else if (deptId === "UDD0001") {
                        GetDataDashboardStatDepartmentOpen('', '', '2', '');
                    }
                    else {
                        GetDataDashboardStatIndivisual();
                    }



            }
             else {

                 if ('@CurrentSession.DeviceName' == "mobile") {

                     alert("12132");
                     $("#maindashdiv").show();
                     $("#nav-home-tab").hide();
                     $("#nav-profile-tab").hide();
                     $("#nav-archieve-tab").hide();
                     $("#selectednew").hide();
                      GotoInbox('Letter')
                     $("#Dash1").show();
                     $("#Dash2").hide();
