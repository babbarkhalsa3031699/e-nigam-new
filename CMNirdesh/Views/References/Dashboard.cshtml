        function GetTemplate() {

            let selected = [];

            $('.chkRef:checked').each(function () {
                selected.push({
                    refId: $(this).data('refid'),
                    resolution: $(this).data('resolution')
                });
            });

            if (selected.length === 0) {
                alert("Please select at least one record");
                return;
            }

            $.ajax({
                url: '@Url.Action("GenerateReminderEmail", "References")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ items: selected }),
                success: function (res) {
                    $('#txtTo').val(res.to);
                    $('#txtCC').val(res.cc);
                    $('#txtSubject').val(res.subject);
                    tinymce.get('txtBody').setContent(res.body);

                    $('#emailModal').modal('show');
                }
            });
        }

        $('#btnSendMail').click(function () {
            var body = tinymce.get('txtBody').getContent(); // ✅ correct

            $.ajax({
                url: '@Url.Action("SendReminderEmail", "References")',
                type: 'POST',
                data: {
                    to: $('#txtTo').val(),
                    cc: $('#txtCC').val(),
                    subject: $('#txtSubject').val(),
                    body: body
                },
                success: function () {
                    alert("Reminder Sent Successfully");
                    $('#emailModal').modal('hide');
                }
            });

        });

                $('#btnCancelMail').click(function (e) {

                    var editor = tinymce.get('txtBody');
                    var currentContent = editor ? editor.getContent() : '';

                    // compare with original
                    if (window.emailBody && currentContent !== window.emailBody) {
                        if (!confirm("You have unsaved changes. Do you want to cancel?")) {
                            e.preventDefault(); // stop closing
                            return false;
                        }
                    }

                    $('#emailModal').modal('hide');
                });






