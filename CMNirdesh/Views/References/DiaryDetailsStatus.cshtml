            return false;

        }
        var formData = new FormData();
        formData.append("refid", refid);
        formData.append("agendaid", agendaid);
            $.ajax({
                type: "POST",
                url: '@Url.Action("CheckInAgenda", "References")',
                data: formData,
                processData: false,
