    function EditMlaDairy(IDD) {
        var ID = IDD.id;
        $('#loginModaldiaryEditbody').html('');
         var pathurl = '@Url.Action("EditMlaDairyForm", "References")';
       // var pathurl = '/References/EditMlaDairyForm';
        $.ajax({
            type: "GET",
            url: pathurl,
            async: true,
            data: { ID: ID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                // //debugger;
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();

                if (data) {
                    $("#loginModaldiaryEdit").css("display", "block");
                    $('#loginModaldiaryEditbody').html(data);


                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            },
            complete: function (results) {
                $('#loader-wrapper').hide();

            }
        });
    }

