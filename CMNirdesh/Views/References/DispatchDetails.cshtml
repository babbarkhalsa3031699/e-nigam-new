<body>
    

    <div class="main-content">
        <div class="widget-box" id="divAction">
            <div class="widget-header widget-header-flat">
                <h4>  <span id="selectednew" class=""></span></h4>
                <div class="widget-toolbar no-border">

                    <button class="btn btn-xs btn-primary bigger" id="btnNewD" style="display:none;" onclick="CreateNewDispatch()">
                        <i class="ace-icon fa fa-pencil-square-o"></i>
                        New
                    </button>

                </div>
            </div>
        </div>

        <div class="col-md-12 content-pad-0" id="MainDispatchBox">
            @Html.Hidden("maintype", "0")
            <input type="hidden" id="DepartmentId" value="@ViewBag.DeptID" />

            <div class="row w">

                @foreach (var mdl in Model._LstDashboard)
                {
                    <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 p-2" title="Click to See Detail List"  >
                        <div class="small-box @mdl.CssClass" id="@mdl.DocumentTypeId" onclick="setvalueDispatch(this.id);">
                            <div class="inner">
                                <h3 class="">@mdl.Count</h3>
                                <p style="color:white;">@mdl.DocumentTypeName <br /></p>
                            </div>
                            @*<div class="icon">
                                    <i class="fa fa-road"></i>
                                </div>*@
                            <div class="icon">
                                <div class="dash_coman @mdl.documentId">

                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>

        <div class="row" id="DispatchTableDiv" style="display: none;">

            <div class="col-md-12 col-lg-12 col-xl-12 row" style="background: #175d91; margin-top: 10px; margin-left: 5px; height: 57px; ">

                <div class="col-md-3 col-lg-3 col-xl-3" style="margin-top: 8px;">
                    <span style="color: white; font-size: 25px;" id="DocumentTypename"></span>
                </div>

                <div class="col-md-4 col-lg-4 col-xl-4" id="StatusListMlaD" style="margin-top: 5px;">

                </div>

                <div class="col-md-3 col-lg-3 col-xl-3">
                    <div class="tbl_sinc-ddl pull-right">
                        <label class="form text-white"> <b>Agenda</b></label>
                        <select style="margin-top:10px;" onchange="hideshowcheckboxD();" id="AgendaDateD" name="AgendaDateD"></select>
                    </div>
                </div>

                <div class="col-md-2 col-lg-2">
                    <div class="tbl_sinc-ddl " style="margin-top:10px;">
                        <label class="form text-white"> <b>Last Action Since</b></label>
                        <select name="since" id="sincefilterdispatch">
                            <option value="" selected onclick="ResetSinceDispatch();">Select</option>
                            <option value="1week">1 Week</option>
                            <option value="2week">2 Week</option>
                            <option value="1month">1 Months</option>
                            <option value="3month">3 Months</option>
