        }

    function GetDispatchDasdhboardDataStatusType(obj) {

        var deptId = $(obj).attr('deptid');
        var docid = $(obj).attr('DocTypeId');
        //alert(docid);
            var officeid = $("#DispatchoffId").val();
        var status = statusvalueD();
        var statusnew = "";
        if (status == '10') {
            statusnew = docid;
        }
        else {
            statusnew = status;
        }
            var term = $("#DispatchTerm").val();
            var priority = $("#DispatchPriority").val();
        var since = $("#sincefilterhdndispatch").val();
        var notchecked = $("#notcheckD").val();
            //$("#loginModalDispatchCount").css("display", "block");
            $("#loader-wrapper").show();

             $.ajax({
            type: "GET",
            url: '@Url.Action("GetDashboardDataForDispatchStatusTypeCount", "References")',
            datatype: "Json",
                contentType: "application/json; charset=utf-8",
                 data: { status: statusnew, since: since, deptid: deptId, officeid: officeid, term: term, priority: priority, notchecked: notchecked },
                success: function (response) {
                    if (response.length > 0) {
                        getTableListDispatchCount(response);
                        $("#loginModalDispatchCount").css("display", "block");
                        $("#loader-wrapper").hide();

                    }
                    else {
                        $("#noDataFoundD").css("display", "block");
                        $("#loader-wrapper").hide();
                        $("#loginModalDispatchCount").css("display", "none");

                    }
                },
                error: function (error) {
                }
             });
        }

    function getTableListDispatchCount(tableData) {
            $("#DispatchTableCount").DataTable().destroy();
            $("#DispatchTableCount tbody").html('');
            $.each(tableData, function (index, response) {
                if (response.ReferencePriorityType == 1) {
                    //var img = '<img src="Assets/Home_Images/highPriority.png" alt="High Priority" width="70" height="45" />';
                    var img = 'High';
                }
                else if (response.ReferencePriorityType == 2) {
                    var img = 'Normal';
                }
                else if (response.ReferencePriorityType == 3) {
                    var img = 'Low';
                }
                if (response.ReferenceTerm == 1) {
                    var Term = 'Short';
                }
                else if (response.ReferenceTerm == 2) {
                    var Term = 'Medium';
                }
                else if (response.ReferenceTerm == 3) {
                    var Term = 'Long';

                }

                var editclass = ""
                var edit = response.Editpermission;
                if (edit == "1") {
                    editclass = "edit";
                }
                else {
                    editclass = "nonedit";
                }

                if (response.ActionTakenDate != "" || response.ActionTakenDate != null | response.ActionTakenDate != "null") {
                    response.ActionTakenDate = response.ActionTakenDate;
                }
                else {
                    response.ActionTakenDate = "";
                }

                if (response.ActionTakenFile != "") {
                    var Actionpath1 = "https://cmnirdesh.punjab.gov.in" + response.ActionTakenFile;
                    var link = '<a href=' + Actionpath1 + ' target="_blank"><img src="/Assets/Home_Images/PDF.png" alt="Download" title="Download Pdf" width="24" height="24" /></a>'
                }
                else {
                    var link = '';
                }

                $("#DispatchTableCount tbody").append(
                    "<tr role='row' class='odd'>" +
                    "<td class='td-data'>" + response.Subject + "</td>" +
                    "<td class='td-data'><span >" + response.LetterDate + "</span></td>" +
                    "<td class='td-data'><span>" + response.ToDept + "-" + response.ToOffice + "</span></td>" +
                    "<td class='td-data'>" + response.ad + "</td>" +
                    "<td class='td-data'>" + response.DocumentTypeName + "</td>" +
                    "<td class='td-data'>" + response.StatusName + "<br/>" + response.ActionTakenDate + "<br/>" + link + "</td>" +
                    "<td class='td-data'><span >" + response.RefId + "</br>" + response.CreatedDate + "</span></td>" +
