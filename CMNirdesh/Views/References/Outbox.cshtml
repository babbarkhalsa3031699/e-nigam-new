                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {
                    $('#loginModalDispatchbody').html('');
                    //debugger;
                    var options = {
                        "backdrop": "static",
                        keyboard: true
                    };
                    $("#loader-wrapper").hide();
                    if (data) {
                        $("#loginModalDispatch").css("display", "block");
                        $('#loginModalDispatchbody').html(data);


                    } else { alert("error"); }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();
                }
            });
        }

        }

    function closedispatch() {
            $("#loginModalDispatch").css("display", "none");
            $('#loginModalDispatchbody').html('');
            window.location.reload();
        }

    function closedispatchCount() {
            $("#loginModalDispatchCount").css("display", "none");
        }

    function closedispatchEdit() {
            $("#loginModalDispatchEdit").css("display", "none");
            $('#loginModalDispatchbodyEdit').html('');

        }



         function ViewFile(IDD,AgendaId) {
            var ID = IDD.id;

              $.ajax({
            type: "GET",
            url: '@Url.Action("GetInboxMeetingFiles", "References")',
            datatype: "Json",
                contentType: "application/json; charset=utf-8",
                 data: { refid:ID,MeetingId:AgendaId },
                success: function (response) {
                    if (response.length > 0) {

                        getTableListDispatchCount(response);
                        $("#loginModalDispatchCount").css("display", "block");
                        $("#loader-wrapper").hide();

                    }
                    else {
                        $("#noDataFoundD").css("display", "block");
                        $("#loader-wrapper").hide();
                        $("#loginModalDispatchCount").css("display", "none");

                    }
                },
                error: function (error) {
                }
             });
        }


    </script>

