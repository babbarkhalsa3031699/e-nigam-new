    function ShowButtonDD() {
        var type = '3034';
        $.ajax({
            type: "GET",
            url: '@Url.Action("ShowButton", "References")',
            datatype: "Json",
            contentType: "application/json; charset=utf-8",
            data: {type:type},
            success: function (response) {
                if (response[0].isupdate == 1) {
                    $("#btnNewD").css("display", "block");
                    //$("#loader-wrapper").hide();
                }
                else {
                    $("#btnNewD").css("display", "none");
                   // $("#loader-wrapper").hide();
                }
