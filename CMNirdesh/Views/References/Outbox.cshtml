            }
        });






    }

// -------------Department-Status code ---------------------

    function GetDataForDispatchStatus() {
        var status = '10';
        var deptid = '';
        var officeid = '';
        var term = '';
        var priority = '';
        var type = '';
        var since = '';
        var notchecked = '0';
        $.ajax({
            type: "GET",
              url: '@Url.Action("GetDataForDispatchDashboardStatus", "References")',
            datatype: "Json",
                contentType: "application/json; charset=utf-8",
            data: { DocumentType: type, status: status, deptid: deptid,since:since, officeid: officeid, term: term, priority: priority, notchecked: notchecked },
            success: function (result) {
                if (result.length > 0) {
                    $("#tbodyType").html(result);
                    $("#loader-wrapper").hide();
                }
                else {
                    $("#tbodyType").html("No Data Found");
                    $("#loader-wrapper").hide();
                }
            },
            error: function (result) {
                $("#loader-wrapper").hide();
            }
        });

    }

