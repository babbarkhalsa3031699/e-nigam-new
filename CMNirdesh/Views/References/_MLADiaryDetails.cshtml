    function GetActionStatusValueDiary() {
        var StatusVal = 10;
        $.each($("input[name='group2Mla']:checked"), function () {
            StatusVal = $(this).val();
        });
        return StatusVal;
    }

    function ActionStatusCheckDiary() {
        var type = $('#DocumentTypeIdHdn').val();
        GetDataForDiary(type);

    }

    function GetDataForDiary(type) {
        $('#DocumentTypeIdHdn').val(type);
        $('#AgendaDate').val('');
        var since = $("#sincefilterdiary").val();
        var status = 10;
        status = GetActionStatusValueDiary();
        $.ajax({
            type: "GET",
              url: '@Url.Action("GetDataForDiary", "References")',
            datatype: "Json",
                contentType: "application/json; charset=utf-8",
            data: { DocumentType: type, status:status ,since:since},
                success: function (response) {
                    if (response.length > 0) {

                 var DocumentTypename = response[0].DocumentTypeName;
                 if (DocumentTypename != "" || DocumentTypename != null) {
                      $('#DocumentTypename').empty();
                      $('#DocumentTypename').append(DocumentTypename);
                 }
                else {
                     $('#DocumentTypename').empty();
                     }
                        $("#DiaryCount").empty();
                        var count = response.length;
                        $("#DiaryCount").append(count);
                        getTableListDairy(response);

                        $('table#DiaryTable th.hideshow,table#DiaryTable td.hideshow').hide();

                        $("#DiaryTableDiv").css("display", "block");
                        $("#DiaryTable").css("display", "block");
                        $("#Diarylistdiv").hide();
                        $("#loader-wrapper").hide();

                        $("#noDataFound").hide();
                        $("#noDataFound").css("display", "none");
                    }
                    else {
                        $("#noDataFound").show();
                        $("#noDataFound").css("display", "block");
                        $("#DiaryTable").css("display", "none");
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (error) {
                }
              });
    }

    function getTableListDairy(tableData) {
        $("#DiaryTable").DataTable().destroy();
        $("#DiaryTable tbody").html('');
        $.each(tableData, function (index, response) {

            if (response.ReferencePriorityType == 1) {
                //var img = '<img src="Assets/Home_Images/highPriority.png" alt="High Priority" width="70" height="45" />';
                var img = 'High';
            }
            else if (response.ReferencePriorityType == 2) {
                var img = 'Medium';
            }
            else if (response.ReferencePriorityType == 3) {
                var img = 'Low';
            }

            if (response.ReferenceTerm == 1) {
                var Term = 'Short';
            }
            else if (response.ReferenceTerm == 2) {
                var Term = 'Medium';
            }
            else if (response.ReferenceTerm == 3) {
                var Term = 'Long';

            }



            if (response.ActionTakenFile != "") {
                var Actionpath1 = "http://10.44.250.80/MCSecure/" + response.ActionTakenFile;
                var link = '<a href=' + Actionpath1 + ' target="_blank"><img src="Assets/Home_Images/PDF.png" alt="Download" title="Download Pdf" width="24" height="24" /></a>'
            }
            else {
                var link = '';
            }

            if (response.ActionTakenDate != "" || response.ActionTakenDate != null | response.ActionTakenDate != "null") {
                response.ActionTakenDate = response.ActionTakenDate;
            }
            else {
                response.ActionTakenDate = "";
            }
            var idd = 'abc' + response.RefId;

            $("#DiaryTable tbody").append(
                "<tr role='row' class='odd'>" +
                //"<td id='checkboxgrid' style='font-size: 12px; display:none; text-align:center; width: 3%;'> <input type='checkbox'  id='" + response.RefId + "' onclick = SendToAgenda(this)></td>" +
                "<td class='hideshow' style='font-size: 12px; text-align:center; width: 3%;'> <input type='checkbox'  id='" + response.RefId + "' onclick = SendToAgenda(this)></td>" +

                "<td style='font-size: 12px; text-align:center; width: 25%;'>" + response.Subject + "</td>" +
                "<td style='font-size: 12px; text-align:center; width: 6%;'><span >" + response.LetterDate + "</span></td>" +
                "<td style='font-size: 12px; text-align:center; width: 15%;'><span >" + response.FromDept + "-" + response.FromOffice + "</span></td>" +
                "<td style='font-size: 12px; text-align:center; width: 25%;'>" + response.ad + "</td>" +
                "<td style='font-size: 12px; text-align:center; width: 10%;'>" + response.ActionTakenDate + "<br/>" + response.StatusName + "<br/>" + link + "</td>" +
                "<td style='font-size: 12px; text-align:center; width: 6%;'><span >" + response.RefId + "</br>" + response.CreatedDate + "</span></td>" +
                "<td style='font-size: 12px; text-align:center; width: 6%;'>" + img + "</td>" +
                "<td style='font-size: 12px; text-align:center; width: 6%;'>" + Term + "</td>" +
                "<td id='permissionbox' ><a data-rel='tooltip' class='green tooltip-success' href='#' id='" + response.RefId + "' onclick = EditMlaDairy(this) ><i class='ace-icon fa fa-pencil bigger-120'></i> </a ></td>"
                + "</tr>"
            );
        });
        $('#DiaryTable').DataTable({
            paging: true,
            searching: true,
            bInfo: false,
            dom: 'Bfrtip',
            buttons: [
                'excel', 'pdf'
            ]

        });
    }

