    function SendToAgenda(idd) {
        var refid = idd.id;

        var agendaid = $('#AgendaDate').val();
        if (agendaid == '') {
            alert("Please select Agenda First..");
            return false;
        }
        if (refid == '') {
            alert("Some Error Occured .");
            return false;

        }
        var formData = new FormData();
        formData.append("refid", refid);
        formData.append("agendaid", agendaid);
            $.ajax({
                type: "POST",
                url: '@Url.Action("AddToAgenda", "References")',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response == "1") {
                        
                    }
                    if (response == "0") {
                        alert("Term Updation Failed.");
                    }
                }
            });
    }

    function EditMlaDairy(IDD) {
        var ID = IDD.id;
        $('#loginModaldiarybody').html('');
        $('#loginModalBody').html('');
        $('#loginModalDispatchbody').html('');
        var pathurl = '/References/EditMlaDairyForm';
        $.ajax({
            type: "GET",
            url: pathurl,
            async: true,
            data: { ID: ID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                // //debugger;
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();

                if (data) {
                    $("#loginModaldiary").css("display", "block");
                    $('#loginModaldiarybody').html(data);


                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            },
            complete: function (results) {
                $('#loader-wrapper').hide();

            }
        });
    }

    function BindActionStatusMladiary() {
        var since = $("#sincefilter").val();
        var pathurl = '/References/BindActionStatusMla';
        $("#StatusListMla").empty();
        var T = "T";
        $.ajax({
            url: pathurl,
            type: 'GET',
            data: { since: since },

            async: true,
            success: function (result) {
                var html = "";
                if (result.length > 0) {
                    html = html + "<input type='radio' onclick='ActionStatusCheckDiary()'  id='chk' value='10' name='group2Mla' style='font-size:18px; margin-top:15px; margin-left:3px;' checked='checked'>";
                    html = html + "<span style='cursor:pointer;font-size:18px;margin-top:15px; margin-left:2px; color:white; margin-right:3px;'>All</span>";
                    for (var i = 0; i < result.length; i++) {
                        var item = result[i];
                        html = html + "<input type='radio' onclick='ActionStatusCheckDiary()' id='chk'" + item.Text + "' value='" + item.Value + "' style='margin-left:3px;margin-top:15px;font-size:18px;' name='group2Mla'>";
                        html = html + "<span style='margin-left:2px;margin-right:3px;margin-top:15px; color:white;font-size:18px;'>" + item.Text + "</span>";
                    }
                    $("#StatusListMla").html(html);
                    $("#loader-wrapper").hide();
                }
                else {
                    $("#StatusListMla").html("No Data Found");
                    $("#loader-wrapper").hide();

                }
            }
            ,
            error: function (result) {
                $("#loader-wrapper").hide();
            }

        });

    }

    function ResetSinceDiary() {
        var dropDown = document.getElementById("sincefilterdiary");
        dropDown.selectedIndex = 0;
        $("#sincefilterdiary").val('');
        GetDataForDiary($('#DocumentTypeIdHdn').val());
    }

    </script>
