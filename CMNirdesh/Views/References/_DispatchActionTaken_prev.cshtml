    function ShowRefTab(val) {



        if (val == 1) {
            $('#NotingTab').addClass("refhide");
            $('#SendTab').addClass("refhide");
            $('#ViewTab').addClass("refhide");
            $('#NotingTab').removeClass("refshow");
            $('#SendTab').removeClass("refshow");
            $('#ViewTab').removeClass("refshow");

            $('#RefTab').removeClass("refhide");
            $('#RefTab').addClass("refshow");

            $('#UpdateTab li:eq(2) a').tab('show');
            $('#UpdateTab li:eq(2) a').click();
        } else {
            $('#NotingTab').removeClass("refhide");
            $('#SendTab').removeClass("refhide");
            $('#ViewTab').removeClass("refhide");
            $('#NotingTab').addClass("refshow");
            $('#SendTab').addClass("refshow");
            $('#ViewTab').addClass("refshow");

            $('#RefTab').removeClass("refshow");
            $('#RefTab').addClass("refhide");
            $('#UpdateTab li:eq(0) a').tab('show');
            $('#UpdateTab li:eq(0) a').click();
        }
    }

    var mlarr = new Array();
    function UpdateRefStatus(RefId) {

        if ($(RefId).prop("checked") == true) {
            mlarr.push(RefId.id);
            //var val = $("#MultiUpdate").val();
            //$("#MultiUpdate").val(val + RefId.id + ',');
        }
        else if ($(RefId).prop("checked") == false) {
            //console.log("Checkbox is unchecked.");
            mlarr = jQuery.grep(mlarr, function (value) {
                return value != RefId.id;
            });
        }


        $("#MultiUpdate").val(mlarr);
        console.log($("#MultiUpdate").val());

        var val = $("#MultiUpdate").val();
        if (val == "") {
            $("#floatButton").hide();
            // $('[id^="UpdateRef_"]').show();
        } else {
            $("#floatButton").show();
           // $('#UpdateTab li:eq(2) a').tab('show');
            //$('#UpdateTab li:eq(2) a').click();
            // SelectTab(2);
            //ShowInitialTabContent();

        }
    }

    $('#downloadreply').click(function (e) {

    e.preventDefault();
    window.open('@Url.Action("LGProceddings", "Agenda", new { RefId = Model.RefId })', '_blank');
});

    function Swipe(val) {
        if (val == 1) {
            $(".one").css("width", "0%");
            $(".two").css("width", "100%");
            $(".one").hide();
            $("#floatButton").css("left", "2%");

        } else {
            $(".one").css("width", "35%");
            $(".two").css("width", "65%");
            $(".one").show();
            $("#floatButton").css("left", "35%");
        }
        $("#PannelId").val(val);
    }


    function OpenCheckPopUp() {

        var val = $("#MultiUpdate").val();
        if (val == "") {
            alert("Please Select Checkbox.")
        } else {
            $("#EditHeading").html("Update Action on Multiple Resolutions");
            $("#CheckBoxModal").css("display", "block");
        }



    }


    function OpenSingleEdit(IDD) {

        var mainRefid = $('#RefId').val();
        var ID = IDD.id;
        $("#MultiUpdate").val(ID);
        $("#EditHeading").html("Update Action on Single Resolutions");
        $("#CheckBoxModal").css("display", "block");
        var length = $('#DdlActionType_Multi').children('option').length;
        if (length == 2) {
            $('#DdlActionType_Multi option:eq(2)').attr('selected', 'selected');
        }
    }

    function closeCheckEdit() {
        $("#CheckBoxModal").css("display", "none");
        $("#MultiUpdate").val("");
        $('input:checkbox').prop('checked', false);
        mlarr = [];
        $("#floatButton").hide();
        tinyMCE.get('ActionDescription_Multi').setContent('');
    }


    function CheckAll(val) {

        if ($("#checkall").prop("checked") == true) {
            $('.RefCheckBox').prop('checked', true);
            $('input:checkbox.RefCheckBox').each(function () {
                var sThisVal = (this.checked ? $(this).val() : "");
                mlarr.push(sThisVal);
            });
            $("#MultiUpdate").val(mlarr);
            $("#floatButton").show();
        }
        else if ($("#checkall").prop("checked") == false) {
            $('.RefCheckBox').prop('checked', false);
            mlarr = [];
            $("#MultiUpdate").val("");
            $("#floatButton").hide();
        }

    }

    function ScrollToTop() {

        $("#InboxModelbody").animate({ scrollTop: 0 });
    }
</script>

