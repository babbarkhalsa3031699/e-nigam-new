<style>

    a:focus, a:not([href]):not([tabindex]):hover, a:not([href]):not([tabindex]):focus {
        cursor: pointer;
        text-decoration: none !important;
    }

    .ui-datepicker {
        width: 25em;
        /*padding: .2em .2em 0;*/
        display: none;
        border: 1px solid;
        font-weight: bolder;
    }

    #myTab .nav-item .active {
        padding: 8px 16px;
        border-top-left-radius: 6px !important;
        border-top-right-radius: 6px !important;
    }

    .Mytextarea {
        font-size: 10px;
        height: 14px !important;
        color: #333 !important;
        font-family: inherit;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

        /* Hide default HTML checkbox */
        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    /* The slider */
    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        -webkit-transition: .4s;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            -webkit-transition: .4s;
            transition: .4s;
        }

    input:checked + .slider {
        background-color: #2196F3;
    }

    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(26px);
        -ms-transform: translateX(26px);
        transform: translateX(26px);
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }

    .samename {
        display: none;
    }

    .differentname {
        display: initial;
    }

    .hand {
        cursor: pointer;
    }

    .nodelete {
        display: none;
    }

    .refhide {
        display: none;
    }

    .refshow {
        display: block;
    }

    .ColorAdd {
        background-color: #fdeefd !important;
    }

    .table-bordered > :not(caption) > * > * {
        border-width: 1px !important;
    }

    .SDHide {
        display: none;
    }

    .far.fa-comment-dots {
        font-size: 21px;
        cursor: pointer;
    }

    .dt {
        margin-top: 10px;
    }

    .dataTables_wrapper .row:last-child {
        background-color: transparent !important;
    }

    .SDHide .tox-edit-area__iframe {
        background-color: transparent;
    }

    .SDHide .tox-editor-header {
        display: none;
    }

    .SDHide .tox-statusbar {
        display: none;
    }

    .checkbox {
        margin-left: 2px;
        display: block ruby;
    }

    #myBtn {
        position: fixed; /* Fixed/sticky position */
        bottom: 7%;
        right: 3%; /* Place the button 30px from the right */
        z-index: 99; /* Make sure it does not overlap */
        border: none; /* Remove borders */
        outline: none; /* Remove outline */
        background-color: var(--top-heading-bg); /* Set a background color */
        color: black; /* Text color */
        cursor: pointer; /* Add a mouse pointer on hover */
        padding: 15px; /* Some padding */
        border-radius: 10px; /* Rounded corners */
        font-size: 18px; /* Increase font size */
    }

        #myBtn:hover {
            background-color: #555; /* Add a dark-grey background on hover */
            color: white;
        }
</style>

