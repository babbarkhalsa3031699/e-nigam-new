    function GetMeetingData() {
        $("#loader-wrapper").show();
        $("#addall").prop('checked', false);
        var meetingId = $("#ddlmeeting").val();
        if (meetingId == '') {
            alert("Select Meeting");
            return false;
        }

        $.ajax({
            type: "GET",
              url: '@Url.Action("GetDataForMeeting", "References")',
            datatype: "Json",
            contentType: "application/json; charset=utf-8",
            data: { MeetingId: meetingId},
                success: function (response) {
                    if (response.length > 0) {
                        BindMeetingTable(response);
                        $("#loader-wrapper").hide();
                        $("#MeetingDiv").css("display", "block");
                        $("#MeetingTable").show();
                       // showdepartment();
                    }
                    else {
                        BindMeetingTable(response);
                        $("#MeetingDiv").css("display", "block");
                        $("#MeetingTable").show();
                       // showdepartment();
                        $("#loader-wrapper").hide();
                    }
                },
                error: function (error) {
                }
        });
    }

    function BindMeetingTable(tableData) {
        $("#MeetingTable").DataTable().destroy();
        $("#MeetingTable tbody").html('');
        $.each(tableData, function (index, response) {
            if (response.ReferencePriorityType == 1) {
                //var img = '<img src="Assets/Home_Images/highPriority.png" alt="High Priority" width="70" height="45" />';
                var img = 'High';
            }
            else if (response.ReferencePriorityType == 2) {
                var img = 'Normal';
            }
            else if (response.ReferencePriorityType == 3) {
                var img = 'Low';
            }
            if (response.ReferenceTerm == 1) {
                var Term = 'Short';
            }
            else if (response.ReferenceTerm == 2) {
                var Term = 'Medium';
            }
            else if (response.ReferenceTerm == 3) {
                var Term = 'Long';

            }

            var Res = '';
            if (response.SubResolutionNo != "0") {
                Res = response.ResolutionNo + "." +response.SubResolutionNo;;
            } else {
                Res = response.ResolutionNo;
            }

            $("#MeetingTable tbody").append(
                "<tr role='row' class='odd'>" +
                "<td style='' > <input class='MeetingCheck' onclick=checkInAgendaD(this) type='checkbox' id='" + response.RefId + "' ></td > " +
                "<td style=''>" + Res + "</td>" +
                "<td style=''>" + response.Subject + "</td>" +
                "<td style=''><span >" + response.LetterDate + "</span></td>" +
                "<td style=''><span>" + response.ToDept + "-" + response.ToOffice + "</span></td>" +
                "<td style=''>" + response.ad + "</td>" +
                "<td style=''>" + response.StatusName + "<br/>" + response.ActionTakenDate + "</td>" +
                "<td style=''><span >" + response.RefId + "</br>" + response.CreatedDate + "</span></td>" +
                "<td style=''>" + img + "</td>" +
                "<td style=''>" + Term + "</td>"
                + "</tr>"

            );
        });
        $('#MeetingTable').DataTable({
            paging: true,
            searching: true,
            bInfo: false,
            pageLength: 100,
            dom: 'Bfrtip',
            buttons: [
                'excel', 'pdf'
            ]

        });
    }

