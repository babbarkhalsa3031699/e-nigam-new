    function MinistryChanged() {
        var ministryID = $('#DdlEntryMinister').val();

        if (ministryID == "0") {
            $('#MinistryId').val(ministryID);
            var select = $("#DdlDept");
            select.empty();
            var pathurl = '@Url.Action("GetDepartmentByMinistery", "NoticeDetails", new { Area = "OnlineMemberQuestions" })';
            $.ajax({
                url: pathurl,
                type: 'GET',
                async: true,
                data: { MinistryId: ministryID },
                success: function (data) {
                    var opt = document.createElement("option");

                    document.getElementById("DdlDept").options.add(opt);

                    opt.text = 'Select Department';
                    opt.value = 0;
                }, error: function (data) {
                    alert("Something wrong...")
                }
            })
        }

        if (ministryID != "" && ministryID != null) {
            //cl.show();
            $('#MinistryId').val(ministryID);
            var select = $("#DdlDept");
            select.empty();
            var pathurl = '@Url.Action("GetDepartmentByMinistery", "NoticeDetails", new { Area = "OnlineMemberQuestions" })';
            $.ajax({
                url: pathurl,
                type: 'GET',
                async: true,
                data: { MinistryId: ministryID },
                success: function (data) {
                    $.each(data, function (index, itemData) {
                        select.append($('<option/>', {
                            value: itemData.DepartmentId,
                            text: itemData.DepartmentName
                        }));
                    });
                    //cl.hide();
                }, error: function (data) {
                    alert("Something wrong...")
                }
            })
        }
    }

    $("#fileuploadEnclosure").click(function (event) {
        $('#EnclosureFile').text('No');
        $('#IsEnclosureFile').val("N");
        $('#fileuploadEnclosure').fileupload({
            dataType: 'json',
              url: '@Url.Action("UploadMlaEnclosureFiles", "eFile")',
            //url: "/eFile/UploadMlaEnclosureFiles",
            autoUpload: true,
            async: true,
            done: function (e, data) {
                var sim = setTimeout("hidevalueActionEnclosure()", 1000);
                $('.file_nameEn').html(data.result.pdfname);
                $('#afile_nameEn').attr("href","@path" + data.result.name)
                $('#enclosure').val(data.result.name);
                $('.file_sizeEn').html(data.result.size);
                $("#removeUploadEnclosure").css("display","block");
            }
        }).on('fileuploadprogressall', function (e, data) {

            var progress = parseInt(data.loaded / data.total * 100, 10);
            $('.progressEnclosure .progress-bar').css('width', progress + '%');
           // $('#removeUploadEnclosure').css('display', 'block');
        });
        //  $("#removeUploadEnclosure").hide(true);
    });

