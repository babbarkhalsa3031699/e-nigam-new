            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3">
                <span class="fotm_lbl" id="myref"> No.:</span>
                <div>
                    @Html.TextBoxFor(m => m.LetterNo, new { @id = "TxtLetterNo", @tabindex = "4", @autocomplete = "off" })
                    @Html.HiddenFor(m => m.LetterNo, new { id = "hdLetterNo" })
                </div>
            </div>

            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3">
                <span class="fotm_lbl">  Date:</span>
                <div>
                    @Html.TextBoxFor(m => m.LetterDate, new { @type = "Date", @id = "txtLetterDate", @tabindex = "5", @autocomplete = "off" })
                    @Html.HiddenFor(m => m.LetterDate, new { id = "hdLetterDt" })
                </div>
            </div>

        </div>

        <div class="row col-md-12 col-lg-12 col-xl-12">
            <div class="col-md-6 col-lg-6" id="divsubject">
                <span class="fotm_lbl">Subject:</span>
                <span id="spnTitle" class="">
                    @Html.TextAreaFor(m => m.Subject, new { @id = "TxtSubject", @tabindex = "6" })
                </span>
            </div>
            <div class="col-sm-6 col-md-6 col-lg-6 col-xl-6">
                </div>

            </div>

        <div id="divitem" class="row col-md-12 col-lg-12">

                <div class="col-md-12 col-lg-12">
                    <span class="fotm_lbl">Details:</span>
                    <div class="larg_txt_1">
                        <div>
                            @if (Model.PaperEntryType == "EditEntry")
                            {
                                @*<div><strong><a href="@Url.Action("PrintDiaryPdf", "Grievances", new { DiaryId = Model.RefId })" target="_blank">Print Details</a></strong></div>*@
                                @Html.Raw(Model.SubjectDetails)
                            }
                        </div>
                        @if (Model.PaperEntryType != "EditEntry")
                        {
                            <div>
                                @Html.TextAreaFor(m => m.SubjectDetails, new { @tabindex = "7", @Class = "form-control" })
                            </div>
                        }

                        else
                        {
                            <div>
                                @Html.HiddenFor(m => m.SubjectDetails)
                            </div>
                        }
                    </div>
                </div>
            </div>

        <div class="row col-sm-12 col-md-12 col-lg-12 col-xl-12">

            <div class="col-sm-12 col-md-12 col-lg-12" id="divEnfile">

                <div class="profile-info-name fotm_lbl div_inline" style="vertical-align: top;">Enclosure:</div>


                <div class="row gap-3 mb-5">
                    <div class="col-auto">
                        <input style="font-size: 15px;" type="file" id="fileuploadEnclosure" name="fileuploadEnclosure">
                    </div>
                   @* <div class="uploadnew-section">
                        <label class="btn-upload">
                            <input type="file" id="fileuploadEnclosure" name="fileuploadEnclosure" >
                            <button class="btn apply_now_btn upload_picture">Upload</button>
                        </label>
                    </div>*@

                    <div class="col-xl-auto col-lg-10 col-md-6 col-sm-12 col-12 ">
                       <div class="d-flex align-items-center gap-5 ">
                            <div >
                                <a href="#" id="afile_nameEn" target="_blank">
                                    <span id="file_nameEn" class="file_nameEn"></span>
                                </a>
                                <div class="file_sizeEn"></div>
                            </div>
                            <div>
                                <span id="removeUploadEnclosure" class="removeUploadEnclosure" onclick="removefileupload()"><i class="far fa-times"></i></span>
                            </div>
                        </div>
                    </div>
                   
                </div>


            </div>








            @if (!string.IsNullOrEmpty(Model.EnclosureFile))
            {
                <a href="@FileSettings.SettingValue@Model.EnclosureFile" target="_blank" id="wreqeqwe">Attached Enclosure (File)</a>
                <span id="EnclosureFiletxt" style="display: none;">Yes</span>

            }
            else
            {
                <span id="EnclosureFiletxt" style="display: none;">No</span>
            }

            @Html.HiddenFor(m => m.EnclosureFile, new { id = "enclosure" })



        </div>

        <div class=" row col-sm-12 col-md-12 col-lg-2" id="divApplicant">
                    <div class="chk_diry">
                        <span id="spnTitle" class="">
                            <input type="checkbox" id="chkApplicant" class="DdlClass" />
                        </span>
                        <div class="profile-info-name">
                            Applicant Details:
                        </div>
                    </div>
        </div>

        <div style="display:none;" class="row col-sm-12 col-md-12 col-lg-12 col-xl-12" id="divApplicantDetails">
                   
            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3">
                        <span class="fotm_lbl">Applicant Name:</span>
                        <span>
                            @Html.TextBoxFor(m => m.ApplicantName, new { @id = "TxtApplicantName", @autocomplete = "off", @tabindex = "9", @class = "DdlClass" })
                        </span>
             </div>

            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3">
                        <div class="profile-info-name fotm_lbl">Applicant Address:</div>
                        <div class="profile-info-value">
                            @Html.TextAreaFor(m => m.ApplicantAddress, new { @id = "TxtApplicantAddress", @tabindex = "10", @class = "DdlClass" })
                        </div>
                    </div>

            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3">
                        <span class="fotm_lbl">Applicant Mobile:</span>
                        <span>
                            @Html.TextBoxFor(m => m.ApplicantMobile, new { @id = "TxtApplicantMobile", @tabindex = "11", @autocomplete = "off", @class = "DdlClass", @maxlength = "10", @onkeypress = "return allowOnlyNumber(event);" })
                        </span>
                    </div>

            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3">
                        <span class="fotm_lbl">Applicant Email:</span>
                        <span>
                            @Html.TextBoxFor(m => m.ApplicantEmail, new { @id = "txtemail", @tabindex = "12", @autocomplete = "off", @class = "DdlClass" })
                        </span>
                    </div>
      
        </div>

        <div class="profile-info-row">

            @*<div class="profile-info-value">
            <button class="btn btn-primary mt-2" type="button" id="btnSave" title="Send" onclick="Save()" tabindex="13">
                <i class="ace-icon fa fa-floppy-o align-top bigger-140"></i>
                Submit
            </button>
        </div>*@

            <div class=" col-md-12 col-lg-12 col-xl-12">
                <div class="profile-info-value">
                    <button class="btn btn-danger" type="button" id="btnDraft" title="Draft" onclick="Save(0)" tabindex="13">
                        <i class="ace-icon fa fa-floppy-o align-top bigger-140"></i>
                        Save
                    </button>
                </div>

                <div class="profile-info-value">
                    <button class="btn btn-primary" type="button" id="btnSave" title="Send" onclick="Save(1)" tabindex="14" style="display:none">
                        <i class="ace-icon fa fa-send align-top bigger-140"></i>
                        Submit
                    </button>
                </div>
            </div>

            @Html.HiddenFor(m => m.BtnCaption)
            @Html.HiddenFor(m => m.PaperEntryType)
            @Html.HiddenFor(m => m.IsEnclosureFile)
            @Html.HiddenFor(m => m.IsFile)
            @Html.HiddenFor(m => m.DeptId, new { id = "spdeptid" })
            @Html.HiddenFor(m => m.OfficeId, new { id = "spofcid" })

            @Html.HiddenFor(m => m.LinkRefID)

        </div>
     
    </div>
               
    }

</body>