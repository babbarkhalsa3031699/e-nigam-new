    function bindOfficeDrpList(DeptID) {
        $("#loader-wrapper").show();
        $.ajaxSetup({ cache: false });
        $.ajax({
             url: '@Url.Action("OfficeDrpList", "References")',
            type: 'GET',
            async: true,
            data: { deptid: DeptID },
            success: function (data) {
                if (data) {
                    $("#divOfficeList").html(data);
                    var office = $("#OfficeId").val();
                    if (office != "") {
                        $("#ddlFromOffice option[value=" + office + "]").prop("selected", "selected");
                        $("#loader-wrapper").hide();
                    }
                    else {
                        $("#ddlFromOffice option[value=0]").prop("selected", "selected");
                        $("#loader-wrapper").hide();
                    }
                }
                else {
                    $("#loader-wrapper").hide();
            }   },
                error: function (xhr, ajaxOptions, thrownError) {
                   $("#loader-wrapper").hide();
                   alert(xhr.responseText);
                   alert(thrownError);
                }
        });
    }

    function bindToOfficeDrpList(DeptID) {
        $.ajaxSetup({ cache: false });
        $.ajax({
             url: '@Url.Action("ToOfficeDrpList", "References")',
            type: 'GET',
            async: true,
            data: { deptid: DeptID },
            success: function (data) {
                if (data) {
                    $("#divToOfficeList").html(data);
                    var office = $("#OfficeId").val();
                    if (office != "") {
                        $("#ddlToOffice").prepend("<option value='0'>Select</option>");
                        $("#ddlToOffice option[value=" + office + "]").prop("selected", "selected");
                        var utype = $('#DdlUserType').val();
                        if (utype == 4) {
                            $('#ddlToOffice option:not(:selected)').attr('disabled', true);
                        }
                    }
                    else {
                        $("#ddlToOffice").prepend("<option value='0'>Select</option>");
                        $("#ddlToOffice option[value=0]").prop("selected", "selected");
                    }
                }
                else {
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            }
        });
    }

