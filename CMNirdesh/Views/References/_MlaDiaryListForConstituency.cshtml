<script>
    function CreateNew() {
        $('#loginModaldiarybody').html('');
        $('#loginModalBody').html('');
        $('#loginModalDispatchbody').html(''); 
        var options = {
            "backdrop": "static",
            keyboard: true
        };
        $("#loader-wrapper").show();
        $.ajax({
            url: "/References/NewMlaEntryForm",
            type: 'GET',
            async: true,
            contentType: "application/json; charset=utf-8",
            datatype: "json",
            data: {
              
            },
            success: function (data) {
                $('#loginModalBody').html('');
                $("#loader-wrapper").hide();
                if (data) {
                    $("#loginModal").modal('show');
                    $('#loginModalBody').html(data);
                   
                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            }
        });

    }
    </script>

<script>
    $(document).ready(function () {
       $('#sample-table-3').dataTable({
         "pagingType": "full_numbers",
        });
    });
    
    function ListMla() {
        $('.widget-box').show();

        $("#loader-wrapper").show();

        $.ajax({
            url: "/References/GetList_MlaForConstituency",
            type: 'GET',
            async: true,
            data: {           

            },
            success: function (data) {
                if (data) {
                    $('#MainDiv').empty();
                    $('#MainDiv').html(data);
                    $("#MainDiv").css("display", "block");
                    $("#loader-wrapper").hide();

                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            }
        });
    }

    function EditMlaDairy(ID) {
        $('#loginModaldiarybody').html('');
        $('#loginModalBody').html('');
        $('#loginModalDispatchbody').html(''); 
        var pathurl = '/References/EditMlaDairyForm';
        $.ajax({
            type: "GET",
            async: true,
            url: pathurl,
            data: { ID: ID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
             
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();
                if (data) {
                    $("#loginModal").modal('show');
                    $('#loginModalBody').html(data);
                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
            },
            complete: function (results) {
                $('#loader-wrapper').hide();
            }
        });
    }
   
</script>


