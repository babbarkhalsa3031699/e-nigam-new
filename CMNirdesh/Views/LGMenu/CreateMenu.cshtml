@model CMNirdesh.Models.LGMenuDataList

@{
    ViewBag.Title = "Manage Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Scripts {
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#MenuType').on('change', function () {
                const type = $(this).val();
                $('.internal-option, .external-option').addClass('d-none');
                if (type === 'internal') {
                    $('.internal-option').removeClass('d-none');
                } else if (type === 'external') {
                    $('.external-option').removeClass('d-none');
                }
            });

            $('#MenuType').trigger('change');

            $('.table').DataTable(); // Initialize DataTables if needed
        });

        function clearTextBox() {
            $('#savebtn').show();
            $('#updatebtn').hide();
            $("#myModalLabel").html("Add New Menu");

            $('#MenuTitle').val('');
            $('#MenuType').val('');
            $('#ControllerName').val('');
            $('#ActionName').val('');
            $('#ExternalUrl').val('');
            $('.internal-option, .external-option').addClass('d-none');
        }

        function AddMenu() {
            let menuTitle = $('#MenuTitle').val().trim();
            let menuType = $('#MenuType').val();

            if (menuTitle === '' || menuType === '') {
                alert("Please fill all required fields.");
                return;
            }

            let formData = new FormData();
            formData.append("MenuTitle", menuTitle);
            formData.append("MenuType", menuType);
            formData.append("ControllerName", $('#ControllerName').val().trim());
            formData.append("ActionName", $('#ActionName').val().trim());
            formData.append("ExternalUrl", $('#ExternalUrl').val().trim());

            $.ajax({
                url: '@Url.Action("CreateMenu", "LGMenu")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    alert("Menu added successfully!");
                    location.reload();
                },
                error: function () {
                    alert("Error while saving menu.");
                }
            });
        }

                function EditMenu(menuId) {
                    const item = @Html.Raw(Json.Encode(Model._LstLGMenu));
                    const menu = item.find(x => x.MenuId === menuId);
                    if (!menu) return alert("Menu not found!");

                    $('#MenuId').val(menu.MenuId);
                    $('#MenuTitle').val(menu.MenuTitle);
                    $('#MenuType').val(menu.MenuType);
                    $('#ControllerName').val(menu.ControllerName || '');
                    $('#ActionName').val(menu.ActionName || '');
                    $('#ExternalUrl').val(menu.ExternalUrl || '');
                    $('#MenuType').trigger('change');
                    $('#myModalLabel').text("Update Menu");
                    $('#savebtn').hide();
                    $('#updatebtn').show();

                    $('#myModal').modal('show');
        }


             function Update() {
                    let menuId = $('#MenuId').val();
                    let menuTitle = $('#MenuTitle').val().trim();
                    let menuType = $('#MenuType').val();

                    if (menuTitle === '' || menuType === '') {
                        alert("Please fill all required fields.");
                        return;
                    }

                    let formData = new FormData();
                    formData.append("MenuId", menuId);
                    formData.append("MenuTitle", menuTitle);
                    formData.append("MenuType", menuType);
                    formData.append("ControllerName", $('#ControllerName').val().trim());
                    formData.append("ActionName", $('#ActionName').val().trim());
                    formData.append("ExternalUrl", $('#ExternalUrl').val().trim());

                    $.ajax({
                        url: '@Url.Action("UpdateMenu", "LGMenu")',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (response) {
                            if (response.success) {
                                alert("Menu updated successfully!");
                                location.reload();
                            } else {
                                alert(response.message || "Update failed.");
                            }
                        },
                        error: function () {
                            alert("Error while updating menu.");
                        }
                    });
             }

           function deleteMenu(menuId) {
                    if (!confirm("Are you sure you want to delete this menu?")) return false; // prevent any further action

                    $.ajax({
                        url: '@Url.Action("DeleteMenu", "LGMenu")',
                        type: 'POST',
                        data: { id: menuId },
                        success: function (result) {
                            if (result.success) {
                                alert("Menu deleted successfully.");
                                location.reload(); // Refresh list
                            } else {
                                alert(result.message || "Deletion failed.");
                            }
                        },
                        error: function () {
                            alert("An error occurred while deleting the menu.");
                        }
                    });

                    return false; 
                }

    </script>
     }

<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box" id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0 d-flex justify-content-between align-items-center p-2">
                            <h4>Local Govt. Menu's Management</h4>
                            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();">
                                <i class="ace-icon fa fa-plus"></i> Add New Menu
                            </button>
                        </div>
                    </div>

                    @if (Model._LstLGMenu != null && Model._LstLGMenu.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-bordered table-striped table-hover" style="font-size: 14px;">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Title</th>
                                        <th>Type</th>
                                        <th>Controller</th>
                                        <th>Action</th>
                                        <th>External URL</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model._LstLGMenu.Count; i++)
                                    {
                                        var item = Model._LstLGMenu[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>@item.MenuTitle</td>
                                            <td>@item.MenuType</td>
                                            <td>@item.ControllerName</td>
                                            <td>@item.ActionName</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.ExternalUrl))
                                                {
                                                    <a href="@item.ExternalUrl" target="_blank">Visit</a>
                                                }
                                            </td>
                                            <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                         

                                            <td class="center td-data" style="padding: 14px 4px !important">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="hidden-sm hidden-xs action-buttons">

                                                        <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="EditMenu(@item.MenuId)">
                                                            <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                        </a>

                                                    </div>
                                                    <div class="hidden-sm hidden-xs action-buttons">

                                                        <a data-rel="tooltip" class="tooltip-primary"  onclick="deleteMenu(@item.MenuId)">
                                                            <i class="ace-icon fa fa-trash bigger-130"></i>
                                                        </a>

                                                    </div>
                                                </div>

                                            </td>



                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3">No menus available.</div>
                    }

                    <!-- Modal Start -->
                <div class="modal fade"
                     id="myModal"
                     data-bs-backdrop="static"
                     data-bs-keyboard="false"
                     tabindex="-1"
                     aria-labelledby="myModalLabel"
                     aria-hidden="true">

                    <div class="modal-dialog modal-dialog-centered" style="margin: auto; width: 50%;">
                      
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title" id="myModalLabel">Add New Menu</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>

                                <div class="modal-body">
                                    <input type="hidden" id="MenuId" name="MenuId" />
                                    <div class="form-group">
                                        <label>Menu Title</label>
                                        <input type="text" id="MenuTitle" class="form-control" required />
                                    </div>

                                    <div class="form-group mt-2">
                                        <label>Menu Type</label>
                                        <select id="MenuType" class="form-control" required>
                                            <option value="">-- Select Type --</option>
                                            <option value="internal">Internal Page</option>
                                            <option value="external">External Link</option>
                                        </select>
                                    </div>

                                    <div class="form-group internal-option d-none mt-2">
                                        <label>Controller Name</label>
                                        <input type="text" id="ControllerName" class="form-control" />
                                    </div>

                                    <div class="form-group internal-option d-none mt-2">
                                        <label>Action Name</label>
                                        <input type="text" id="ActionName" class="form-control" />
                                    </div>

                                    <div class="form-group external-option d-none mt-2">
                                        <label>External URL</label>
                                        <input type="url" id="ExternalUrl" class="form-control" />
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" id="savebtn" class="btn btn-primary" onclick="AddMenu();">Save</button>
                                    <button type="button" id="updatebtn" onclick="Update();" style="display:none;" class="btn btn-primary">Update</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Modal End -->

                </div>
            </div>
        </section>
    </div>
</div>
