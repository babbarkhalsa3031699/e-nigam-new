@model CMNirdesh.Models.MeetingAttendanceMC


<script>

    $(document).ready(function () {
        //$('#example').DataTable({
        //    order: [[2, 'desc'], [1, 'asc']],
        //    searching: false, paging: false, info: false

        //});
    });

    function updateStatus(MemberCode, checkbox, statusElement) {
        if (checkbox.checked) {
            statusElement.value = "Present";
            var MDate = '@Model.AgendaId';
            $.ajax({
                type: "Post",
                url: '@Url.Action("MarkAttendenceMember", "Attendance")' + '?Id=' + MDate + '&MemberCode=' + MemberCode,
                success: function (result) {
                    if (result == 1) {
                        alert("Present Marked for Selected Member Successfully");
                        GetAttendancedata1();
                    }
                    else {
                        alert("Some error occures during this process, Please Try again");
                    }
                }
            });

        }
        else {
            statusElement.value = "Absent";
            var MeDate = '@Model.AgendaId';
            $.ajax({
                type: "Post",
                url: '@Url.Action("ClearAttendenceMember", "Attendance")' + '?Id=' + MeDate + '&MemberCode=' + MemberCode,
                success: function (result) {
                    if (result == 1) {
                        alert("Absent Marked for Selected Member Successfully");
                        GetAttendancedata1();
                    }
                    else {
                        alert("Some error occures during this process, Please Try again");
                    }
                }
            });
        }
    }


    function updateStatusAll(checkbox, statusElement) {
        if (checkbox.checked) {
            statusElement.value = "Present";
            $('#Type').val("Present");
        } else {
            statusElement.value = "Absent";
            $('#Type').val("Absent");
        }
    }

    function updateStatusFNCC(UserId, checkbox, statusElement) {
    if (checkbox.checked) {
        statusElement.value = "Present";
        var MDate = '@Model.AgendaId';
        $.ajax({
            type: "Post",
            url: '@Url.Action("MarkAttendenceFNCC", "Attendance")' + '?Id=' + MDate + '&Userid=' + UserId,
            success: function (result) {
                if (result == 1) { alert("Present Marked for Selected Member Successfully"); }
                else {
                    alert("Some error occures during this process, Please Try again");
                }
            }
        });

    }
    else {
        statusElement.value = "Absent";
        var MeDate = '@Model.AgendaId';
        $.ajax({
            type: "Post",
            url: '@Url.Action("ClearAttendenceFNCC", "Attendance")' + '?Id=' + MeDate + '&Userid=' + UserId,
            success: function (result) {
                if (result == 1) { alert("Absent Marked for Selected Member Successfully"); }
                else {
                    alert("Some error occures during this process, Please Try again");
                }
            }
        });
    }
}





    function selectAllCheckboxes(source) {
        var MDate = '@Model.AgendaId';
        const checkboxes = document.querySelectorAll('#example input[type="checkbox"]');
        console.log(checkboxes);
        if (MDate == '') {
            alert('Please select Meeting Date !');
            $('#select-all').prop('checked', false);
        }
        else {
            checkboxes.forEach(checkbox => {
                if (checkbox !== source) {
                    checkbox.checked = source.checked;
                    updateStatusAll(checkbox, checkbox.parentNode.nextElementSibling.firstChild);
                }
            });
            var Present = $('#Type').val();
            if (Present == 'Present') {
                $.ajax({
                    type: "Post",
                    url: '@Url.Action("MarkAttendenceAll", "Attendance")' + '?Id=' + MDate,
                    success: function (result) {
                        if (result == 1) {
                            alert("Present Marked for All Members Successfully");
                            GetAttendancedata1();

                        }
                        else {
                            alert("Some error occures during this process, Please Try again");
                        }
                    }

                });
            }
            if (Present == 'Absent') {
                $.ajax({
                    type: "Post",
                    url: '@Url.Action("ClearAttendenceAll", "Attendance")' + '?Id=' + MDate,
                    success: function (result) {
                        if (result == 1) {
                            alert("Absent Marked for All Members Successfully");
                            GetAttendancedata1();

                        }
                        else {
                            alert("Some error occures during this process, Please Try again");
                        }
                    }

                });
            }
        }
    }


       function GetAttendancedata1() {
        var date = '@Model.AgendaId';
        $.ajax({
           type: "Post",
           url: '@Url.Action("GetData", "Attendance")' + '?Id=' + date,
            success: function (result) {
               $('#Attendance').html(result);
           }

        });
}
</script>

<div class="form_lyot">
    @Html.Hidden("Type")
    @if (Model != null)
    {

        if (Model.HouseCode == "FNCC")
        {

            if (Model.AddedFNCCMembers == null || !Model.AddedFNCCMembers.Any())
            {
                <div class="alert alert-warning">
                    <strong>Add FNCC Members From Add Note Tab</strong>
                </div>
            }

            else
            {
                string fnccMembers = string.Join(",", Model.AddedFNCCMembers.Select(x => Convert.ToString(x.NoteText)));

                <div class="alert alert-info">
                    <p>@Html.Raw(fnccMembers)</p>
                </div>
            }
        }

        else
        {
            if (Model.MembersList.Count() > 0)
            {


                int total = Model.MembersList.Count();
                int presentCount = Model.MembersList.Count(m => m.IsAlive == "Present");
                int absentCount = Model.MembersList.Count(m => m.IsAlive == "Absent");

                <div style="margin: 20px 0; padding: 15px; border: 1px solid #ccc; border-radius: 8px; background-color: #f9f9f9; width: fit-content;">
                    @*<h5 style="margin-bottom: 10px; color: #333;">Member Attendance Summary</h5>*@
                    <p style="margin: 0; font-size: 14px; color: #555;">
                        <strong> Total Members:</strong> @total &nbsp; &nbsp;
                        <strong> Present:</strong > @presentCount &nbsp; &nbsp;
                        <strong> Absent:</strong > @absentCount
                    </p>
                </div>


                <div class=" table-responsive">
                    <table id="example" class="table table-hover table-bordered " style="font-size:18px;">
                        <thead>
                            <tr>
                                <th class="td-heading" style="width: 10% !important">Ward. No.</th>
                                <th class="td-heading" style="width:20%;">Name</th>
                                <th class="td-heading" style="width:20%;">Designation</th>
                                @*<th class="td-heading" style="width:15%;">Ward Name</th>*@


                                <th class="td-heading" style="width:15%;">
                                    Mark Attendance

                                    <div class="form-check">
                                        <label class="form-check-label" style="font-size:16px;">
                                            <input type="checkbox" class="form-check-input" id="select-all" onchange="selectAllCheckboxes(this)" value="">Select All
                                        </label>
                                    </div>


                                </th>
                                <th class="td-heading" style="width:15%;">Status</th>

                            </tr>
                        </thead>
                        <tbody>
                            @{int i = 1;}


                            @foreach (var items in Model.MembersList)
                            {
                                <tr>
                                    <td class="center td-data" style="text-align:center; padding: 14px 4px !important">@items.WardName</td>

                                    <td>@items.Name</td>
                                    <td>@items.Designation</td>
                                    @*<td>@items.WardName</td>*@

                                    <td class="center td-data" style="text-align:center; padding: 14px 4px !important">
                                        @if (items.MemberID == 1)
                                        {
                                            <input type="checkbox" checked="checked" name="attendance[]" value="John Doe" onchange="updateStatus(@items.MemberCode, this, this.parentNode.nextElementSibling.firstChild)">
                                        }
                                        else
                                        {
                                            <input type="checkbox" name="attendance[]" value="John Doe" onchange="updateStatus(@items.MemberCode, this, this.parentNode.nextElementSibling.firstChild)">
                                        }
                                    </td>


                                    <td><input type="text" name="status[]" value='@items.IsAlive' readonly></td>
                                </tr>
                                i++;
                            }

                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <strong>No Data Found</strong>
            }

        }
    }

</div>
