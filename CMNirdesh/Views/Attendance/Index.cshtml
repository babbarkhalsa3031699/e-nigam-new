@model CMNirdesh.Models.MeetingAttendanceMC
@{
    ViewBag.Title = "Index";
}

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Mark Attendance</title>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jszip.min.js"></script>
    <script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
    <script src="~/Scripts/datatables/vfs-fonts.js"></script>
    <script src="~/Scripts/datatables/buttons.print.min.js"></script>
    <script src="~/Scripts/datatables/buttons.html5.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
</head>

<script>
    function Getdata() {
       $('#select-all').prop('checked', false);
       var date = $("#attendance_date").val();
       $.ajax({
       type: "Post",
       url: '@Url.Action("GetData", "Attendance")' + '?Id=' + date,
           success: function (result) {
               $('#AttendanceData').html(result);
           }
                    
       });
    }
</script>

<div id="main-content">
    <div class="main-content">

        <div class="container-fluid p-0">
            <div class="inr_frm_dsgn">

                <div class="widget-box " id="divAction">
                    <div class="widget-header widget-header-flat rounded-top rounded-0">
                        <h4 class="">
                            Mark Attendance Ministers (Cabinet Meetings)
                        </h4>
                        <div class="widget-toolbar no-border" style="font-size:16px;">
                            <label for="attendance_date" style="font-size:16px; font-weight:bold">Select Proceeding Date:</label>
                            @Html.DropDownListFor(m => m.AgendaId, Model.AgendaList, "Select", new { @id = "attendance_date", @name = "attendance_date", @tabindex = "1", @required = "required", @Onchange = "Getdata();" })

                        </div>
                        @*<div class="form-check">
                            <label class="form-check-label" style="font-size:16px;">
                                <input type="checkbox" class="form-check-input" id="select-all" onchange="selectAllCheckboxes(this)" value="">Select All
                            </label>
                       </div>*@
                    </div>
                    <div id="AttendanceData">
                        <h3>
                            <label style="color:mediumvioletred; font-size:16px;">
                                Select Meeting date to Update the Attendence of Members
                            </label>
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>