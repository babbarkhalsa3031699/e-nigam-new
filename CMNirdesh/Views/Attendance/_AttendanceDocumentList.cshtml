@model CMNirdesh.Models.UploadAttendanceViewModel


    @Html.Hidden("meetingId", Model.MeetingId)

   

            @if (Model.Documents != null && Model.Documents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered dataTable no-footer">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>Uploaded By</th>
                                <th>Uploaded On</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.Documents)
                            {
                                <tr>
                                    <td>Uploaded Member's Attendance Document for Current Agenda</td>
                                    <td>@doc.UploadedBy</td>
                                    <td>@doc.UploadedOn.ToString("dd-MM-yyyy hh:mm tt")</td>
                                    <td>
                                        <a href="@Url.Content("~/" + doc.FilePath + "/" + doc.FileName)" target="_blank">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3">
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-1"></i> No attendance documents uploaded yet.
                    </div>
                </div>
            }
  




