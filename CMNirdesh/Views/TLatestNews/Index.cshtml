    function Add() {

        var res = validate();
        if (res === false) {
            return false;
        }
        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#newsimage").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }
            debugger
            const courseDto = {

                NewsTitle: $('#newstitle').val(),
                NewsTitle_local: $('#newstitlelocal').val(),
                NewsDescription: $('#newsdescription').val(),
                NewsDescription_local: $('#newsdescriptionlocal').val(),
                Ordering: $("#order").val(),
                FileName: $('#newsimage').val(),
                MCId: $('#StateDropDown').val()
            };
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            // Adding one more key to FormData object
            $.ajax({
                url: '@Url.Action("Create", "TLatestNews")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    if (result === 0) {
                        alert("Updated Successfully");
                        $('#myModal').hide();
                        location.reload();
                    }
                    else if (result == 1) {
                        alert("Order Id already existing");

                    }
                    else {
                        alert("Not Updated");
                    }
                }
            });
        }
    }





