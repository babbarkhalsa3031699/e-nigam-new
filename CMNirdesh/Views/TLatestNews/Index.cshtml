                    <i class="fa fa-newspaper-o fa-3x mb-2 text-muted"></i>
                    <div class="analytics-empty-title">No latest news records found</div>
                    <div class="analytics-empty-desc">Click "Add New News" above to publish a news update.</div>
                </div>
            }
        }
