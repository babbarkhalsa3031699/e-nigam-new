    function validate() {
        var isValid = true;
        var firstInvalid = null;

        // 1. State Name
        var stateVal = $('#StateDropDown').val();
        if (!stateVal || stateVal.toString().trim() === "0" || stateVal.toString().trim() === "select" || stateVal.toString().trim() === "") {
            $('#StateDropDown').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#StateDropDownError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#StateDropDown');
        } else {
            $('#StateDropDown').removeClass('is-invalid').css('background-color', 'white');
            $('#StateDropDownError').removeClass('show');
        }

        // 2. News Title
        var titleVal = $('#newstitle').val();
        if (!titleVal || titleVal.trim() === "") {
            $('#newstitle').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#newstitleError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#newstitle');
        } else {
            $('#newstitle').removeClass('is-invalid').css('background-color', 'white');
            $('#newstitleError').removeClass('show');
        }

        // 3. News Title (Punjabi)
        var titleLocalVal = $('#newstitlelocal').val();
        if (!titleLocalVal || titleLocalVal.trim() === "") {
            $('#newstitlelocal').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#newstitlelocalError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#newstitlelocal');
        } else {
            $('#newstitlelocal').removeClass('is-invalid').css('background-color', 'white');
            $('#newstitlelocalError').removeClass('show');
        }

        // 4. News Description
        var descVal = $('#newsdescription').val();
        if (!descVal || descVal.trim() === "") {
            $('#newsdescription').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#newsdescriptionError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#newsdescription');
        } else {
            $('#newsdescription').removeClass('is-invalid').css('background-color', 'white');
            $('#newsdescriptionError').removeClass('show');
        }

        // 5. News Description (Punjabi)
        var descLocalVal = $('#newsdescriptionlocal').val();
        if (!descLocalVal || descLocalVal.trim() === "") {
            $('#newsdescriptionlocal').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#newsdescriptionlocalError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#newsdescriptionlocal');
        } else {
            $('#newsdescriptionlocal').removeClass('is-invalid').css('background-color', 'white');
            $('#newsdescriptionlocalError').removeClass('show');
        }

        // 6. News Image (required on Add; on Edit required only if no existing image and no file uploaded)
        var hasImage = false;
        var currentSrc = $("#imgPreview").attr('src') || '';
        var fileUpload = $("#newsimage").get(0);
        var files = fileUpload ? fileUpload.files : null;

        if (files && files.length > 0) {
            hasImage = true;
        } else if (currentSrc && currentSrc !== defaultNewsImgSrc && !currentSrc.startsWith("data:image/svg+xml") && currentSrc.indexOf("placehold.jp") === -1) {
            hasImage = true;
        }

        if (!hasImage) {
            $('#uploadCard').addClass('is-invalid');
            $('#newsimageError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#newsimage');
        } else {
            $('#uploadCard').removeClass('is-invalid');
            $('#newsimageError').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }

    function clearTextBox() {
        $('#myModal').data({ backdrop: 'static', keyboard: false });
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#uploadCard').removeClass('is-invalid');

        $('#newsid').val("");
        $('#StateDropDown').css('background-color', 'white').val(0);
        $('#newstitle').css('background-color', 'white').val("");
        $('#newstitlelocal').css('background-color', 'white').val("");
        $('#newsdescription').css('background-color', 'white').val("");
        $('#newsdescriptionlocal').css('background-color', 'white').val("");
        $('#order').css('background-color', 'white').val("");
        $('#newsimage').val("");
        $('#imgPreview').attr('src', defaultNewsImgSrc);

        $('#btnUpdate').hide();
        $("#myModalLabel").html("Add News Record");
        $('#btnSave').show();
