<style>

    /* ==========================================================================
       LATEST NEWS RECORD MODAL - SAAS DESIGN SYSTEM
       Scoped strictly under .latestnews-record-modal
       ========================================================================== */

    /* 1. Reset Global Distortion & Base Typography */
