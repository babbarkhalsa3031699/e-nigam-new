        <div id="unifiedTableToolbar" class="unified-table-toolbar">
            <div></div>
            <div id="toolbarSearchSlot" class="toolbar-search-slot"></div>
        </div>
                        @if (Model != null)
                        {
                            if (Model._LstTLatestNews.Count() > 0)
                            {
                                <div class="table-responsive table-cus">
                                    <table id="example" class="table-bordered" style="width:100%;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th style="width:8%;">ID</th>
                                                <th style="width:20%;">News Title</th>
                                                <th style="width:20%;">News Title (Punjabi)</th>
                                                <th style="width:23%;">News Description</th>
                                                <th style="width:23%;">News Description (Punjabi)</th>
                                                <th style="width:6%; text-align: center;">Image</th>
                                                <th style="width:8%; text-align: center;">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._LstTLatestNews)
                                            {

                                                <tr class="">
                                                    <td>@Html.DisplayFor(modelItem => items.LatestNewsID)</td>
                                                    <td>@Html.DisplayFor(modelItem => items.NewsTitle)</td>
                                                    <td>@Html.DisplayFor(modelItem => items.NewsTitle_local)</td>
                                                    <td>@Html.DisplayFor(modelItem => items.NewsDescription)</td>
                                                    <td>@Html.DisplayFor(modelItem => items.NewsDescription_local)</td>
                                                    <td class="text-center">
                                                        @if (!string.IsNullOrEmpty(items.Images))
                                                        {
                                                            <div class="logo-thumb-frame" title="@items.NewsTitle">
                                                                <a href="@Url.Content(@Model.fileacessingUrl + "/" + items.Images)" target="_blank">
                                                                    <img src="@Url.Content(@Model.fileacessingUrl +"/"+ items.Images)" class="logo-thumb-img" alt="News Image" onerror="this.onerror=null; this.src='/Assets/Home_Images/punjab-logo.png';" />
                                                                </a>
                                                            </div>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="action-cell-wrap">
                                                            <input type="hidden" id="imageurl" value="@Url.Content(@Model.fileacessingUrl +"/"+ items.Images)" />
                                                            <a data-rel="tooltip" class="btn-action-edit" title="Edit Latest News" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.LatestNewsID')">
                                                                <i class="fa fa-pencil"></i>
                                                            </a>
                                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.LatestNewsID')" value="@items.LatestNewsID" />
                                                            <label class="toggle mb-0" title="Toggle Active / DeActive">
                                                                <input type="checkbox" onclick="DeleteDepartmentRecord('@items.LatestNewsID')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                                                                <span class="slider"></span>
                                                                <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
            else
            {
