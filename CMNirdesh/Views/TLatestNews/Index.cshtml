@model CMNirdesh.Models.MCHouse.TLatestNews
@using CMNirdesh;

@{
    ViewBag.Title = "Index";

}


@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

<div id="main-content">

    <div class="main-content">

        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Latest News </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" style="font-size:14px;" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New News</button>
                            </div>
                        </div>
                    </div>


                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model._LstTLatestNews.Count() > 0)
                            {
                                <div class="table-responsive">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">

                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">ID</span></th>
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">News Title</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">News Title(Punjabi)</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">News Description</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">News Description(Punjabi)</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">News Image</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._LstTLatestNews)
                                            {

                                                <tr class="">
                                                    <td class="center td-data border" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.LatestNewsID)</td>
                                                    <td class="center td-data border" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.NewsTitle)</td>
                                                    <td class="center td-data border" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.NewsTitle_local)</td>
                                                    <td class="center td-data border" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.NewsDescription)</td>
                                                    <td class="center td-data border" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.NewsDescription_local)</td>


                                                    <td class="center td-data border" style="font-size:14px; padding: 14px 4px !important"><a href="@Url.Content(@Model.fileacessingUrl + "/" + items.Images)" target="_blank"><img src="@Url.Content(@Model.fileacessingUrl +"/"+ items.Images)" height="25" width="25" /> </a></td>
                                                    <td class="center td-data border" style="font-size:14px; padding: 14px 4px !important">
                                                        <div class="edit-1">

                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="imageurl" value="@Url.Content(@Model.fileacessingUrl +"/"+ items.Images)" />

                                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.LatestNewsID')">

                                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                </a>
                                                                @*<a data-rel="tooltip" class="red tooltip-error" onclick="DeleteDepartmentRecord('@items.DocumentTypeId')">

                        <i class="ace-icon fa fa-trash-o bigger-130"></i>
                    </a>*@

                                                            </div>
                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.LatestNewsID')" value="@items.LatestNewsID" />
                                                                <label class="toggle mb-0">
                                                                    <input type="checkbox" onclick="DeleteDepartmentRecord('@items.LatestNewsID')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>

                </div>

                
            </div>

            <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Latest News</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="fileUpload" enctype="multipart/form-data">
                                <div class="form-group" id="StateName">
                                    <div class="profile-info-name fotm_lbl">State Name:</div>
                                    <select id="StateDropDown">
                                        <option value="select" class="form-control txt_design" id="SelectId" placeholder="State Name"></option>
                                    </select>

                                </div>


                                <div class="form-group" id="DocumentTypeId1">

                                    <div class="profile-info-name fotm_lbl">News Title:</div>
                                    <input type="text" class="form-control" id="newstitle" placeholder="News Title" />
                                    <input type="hidden" class="form-control" id="newsid" placeholder="News Title" />
                                </div>
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">
                                        News Title(Punjabi):
                                    </div>
                                    <input type="text" class="form-control" id="newstitlelocal" placeholder="News Title Punjabi" />
                                </div>
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">News Description:</div>
                                    <input type="text" class="form-control" id="newsdescription" placeholder="News Description" />

                                </div>
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">News Description(Punjabi):</div>
                                    <input type="text" class="form-control" id="newsdescriptionlocal" placeholder="News Description(Punjabi)" />

                                @*</div><div class="form-group">
                                    <div class="profile-info-name fotm_lbl">Order:</div>
                                    <input type="number" class="form-control" id="order" placeholder="Order" />

                                </div>*@
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">
                                        News Image:
                                    </div>
                                    <input type="file" name="file" class="form-control" id="newsimage" placeholder="Document Icon" accept=".jpg,.jpeg,.bmp,.png,.gif" />
                                    <img src="https://placehold.jp/100x100.png" id="imgPreview" class="form-control" style="width:100px; height:100px !important; border:1px solid red;" alt="Load Image" />
                                    <input type="hidden" id="DocumentIconName" />
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer" style="background-color:white;">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

        </section>

    </div>

</div>
<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
    <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
</a>

<script src="~/Scripts/tinymce/tinymce.min.js"></script>
<script src="~/Scripts/jquery.ui.widget.js"></script>
