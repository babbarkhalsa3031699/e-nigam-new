   function loadAgendaData(mcid) {
       var swiperWrapper = $('#houseresolutions');

    $.ajax({
        url: '/Home/GetAgendaMeetingsOfMCHouse?id=' + mcid,
        type: 'GET',
        dataType: 'json',
        contentType: "application/json; charset=utf-8",
        success: function (result) {
            for (var i = 0; i < result.length; i++) {
                var pivotColumnsHtml = '';
                for (var j = 0; j < 1; j++) {
                    for (var key in result[j]) {
                        if (key != "AgendaDate" && key != "AgendaId" && key !== "deptname" && key !== "AgendaDate" && key !== "Total" && key !== "AgendaName") {
                            pivotColumnsHtml += `
                                <li class="resolution-state">
                                    <div class="d-flex gap-1">
                                        <span class="meeting-card-icon">
                                            <img class="" src="/Assets/Images/SVG/codicon_pass.svg" />
                                        </span>
                                        <span>${key}</span>
                                    </div>
                                    <span class="numb-count">${result[i][key]}</span>
                                </li>`;
                        }
                    }
                    
                }
                var agendaDate = result[i]["AgendaDate"] || "Unknown Date";
                swiperWrapper.append(`
                    <div class="swiper-slide col-lg-3 col-md-3 col-sm-6 col-12">
                        <div class="meetingcard w-100 p-3">
                        <div class="text-end mb-3">
                            <span> <img class="calender-icon" src="/Assets/Images/SVG/calender.svg" /> </span> <span>${agendaDate}</span>
                        </div>
                                               
                                        
                            <div class="resolutions-detail resolution-detail-mc p-3">
                                <h5 class="total-resolution">Total Resolutions Passed: <span>${result[i]['Total']}</span></h5>
                                <hr class="divider" />
                                <ul class="list-unstyled mb-0">
                                    ${pivotColumnsHtml}
                                </ul>
                            </div>
                        </div>
                    </div>
                `);
            }
        },
        error: function (error) {
            console.log('An error occurred:', error);
        }
    });
   }
   function loadAgendaDataFCCResolutions(mcid) {
