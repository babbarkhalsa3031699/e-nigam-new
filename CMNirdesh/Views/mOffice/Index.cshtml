        $('#ch_user1').on('change', function () {
            var val = $(this).val();
            if (val && val.toString().trim() !== "0" && val.toString().trim() !== "select" && val.toString().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#ch_user1Error').removeClass('show');
            }
        });
        $('#OfficeName').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#OfficeNameError').removeClass('show');
            }
        });
        $('#OfficeAddress').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#OfficeAddressError').removeClass('show');
            }
        });

        var s = $("#ch_user1");
        s.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
        $.ajax({
            type: "POST",
            url: "@Url.Action("DepartmentDropDown", "mOffice")",
            //url: "/mOffice/DepartmentDropDown",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                s.empty().append('<option selected="selected" value="0">Please select</option>');
                $.each(response, function () {
                    s.append($("<option></option>").val(this['Value']).html(this['Text']));
                });
            },
            failure: function (response) {
                alert(response.responseText);
            },
            error: function (response) {
                alert(response.responseText);
            }
        });
    });
