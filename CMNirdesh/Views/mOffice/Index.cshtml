    //Function for clearing the textboxes

    //Validation using jquery
    function validate() {
        var isValid = true;
        var firstInvalid = null;

        // Validate Department Name
        var deptVal = $('#ch_user1').val();
        if (!deptVal || deptVal.toString().trim() === "0" || deptVal.toString().trim() === "select" || deptVal.toString().trim() === "") {
            $('#ch_user1').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#ch_user1Error').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#ch_user1');
        } else {
            $('#ch_user1').removeClass('is-invalid').css('background-color', 'white');
            $('#ch_user1Error').removeClass('show');
        }

        // Validate Office Name
        var officeNameVal = $('#OfficeName').val();
        if (!officeNameVal || officeNameVal.trim() === "") {
            $('#OfficeName').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#OfficeNameError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#OfficeName');
        } else {
            $('#OfficeName').removeClass('is-invalid').css('background-color', 'white');
            $('#OfficeNameError').removeClass('show');
        }

        // Validate Office Address
        var addrVal = $('#OfficeAddress').val();
        if (!addrVal || addrVal.trim() === "") {
            $('#OfficeAddress').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#OfficeAddressError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#OfficeAddress');
        } else {
            $('#OfficeAddress').removeClass('is-invalid').css('background-color', 'white');
            $('#OfficeAddressError').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }


    function clearTextBox() {
        $('#myModal').data({ backdrop: 'static', keyboard: false });
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#ch_user1').css('background-color', 'white').val(0);
        $('#OfficeName').css('background-color', 'white').val("");
        $('#OfficeNameLocal').css('background-color', 'white').val("");
        $('#OfficeAddress').css('background-color', 'white').val("");
        $('#OfficeId').val("");
        $("#OfficeIdLabel").hide();
        $('#btnUpdate').hide();
        $("#OfficeId").removeAttr("disabled", "disabled");
        $("#myModalLabel").html("Add Office Record");
        $('#btnSave').show();
        $("#IsApex").prop("checked", false);
        $("#IsApex").val("");

    }
