@model CMNirdesh.Models.LstofficeModel
@using CMNirdesh;

@{
    ViewBag.Title = "Index";
}

@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

<head>
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/owl_item.carousel.min.js"></script>
</head>


<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Office List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New Office</button>
                            </div>
                        </div>
                    </div>


                    <div class="form_lyot">

                        @if (Model != null)
                        {
                            if (Model._ListofficeModel.Count() > 0)
                            {
                                <div class="tab_parent table-responsive table_rsponsv">
                                    <table id="example" class="table table-hover table-bordered ">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Office Id</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Department Name</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Office Name</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Office Address</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Is Apex</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold"></span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._ListofficeModel)
                                            {
                                                <tr>
                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.OfficeId)</td>
                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.deptName)</td>
                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.officename)</td>
                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.officeaddr)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        <input type="checkbox" @(Convert.ToBoolean(items.IsApex) ? "checked" : "") readonly onclick="return false;" />
                                                        @Html.HiddenFor(modelItem => items.IsApex)
                                                    </td>
                                                    <td class="center td-data edit-1" style="padding: 14px 4px !important">
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.OfficeId')">
                                                                <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                            </a>
                                                            @*<a data-rel="tooltip" id="DeleteCheck" class="red tooltip-error" onclick="DeleteOfficeRecord('@items.OfficeId')" value="@items.OfficeId">
                                                                    <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                                    <input type="hidden" id="DeleteConfirmFinal" value='@items.OfficeId' class="DeleteConfirm" />
                                                                </a>*@
                                                        </div>
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.OfficeId')" value="@items.OfficeId" />
                                                            <label class="toggle mb-0">
                                                                <input type="checkbox" onclick="DeleteOfficeRecord('@items.OfficeId')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                                                                <span class="slider"></span>
                                                                <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                            </label>
                                                        </div>


                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>


            <div class="coman_modal dispatch_modal addnew_modal modal office-record-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Office Record</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="frmOfficeRecord">
                                <!-- Section 1: Department & Office Information -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-building-o"></i> Office Information &amp; Department</div>
                                    <div class="form-card-grid">
                                        <div class="form-group col-full" id="departmentsDropdown">
                                            <label for="ch_user1" class="profile-info-name fotm_lbl">Department Name:</label>
                                            <select id="ch_user1" class="form-control">
                                                <option value="select" class="form-control txt_design" id="SelectId" placeholder="Select Department Id">Please select</option>
                                            </select>
                                            <span id="ch_user1Error" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Please select Department Name</span>
                                        </div>

                                        <div class="form-group col-full" id="OfficeIdLabel" style="display:none;">
                                            <label for="OfficeId" class="profile-info-name fotm_lbl">Office ID:</label>
                                            <input type="text" class="form-control" id="OfficeId" placeholder="Office Id" />
                                        </div>

                                        <div class="form-group">
                                            <label for="OfficeName" class="profile-info-name fotm_lbl">Office Name:</label>
                                            <input type="text" class="form-control" id="OfficeName" placeholder="Enter Office Name" />
                                            <span id="OfficeNameError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Office Name is required</span>
                                        </div>

                                        <div class="form-group">
                                            <label for="OfficeNameLocal" class="profile-info-name fotm_lbl">Office Name Local:</label>
                                            <input type="text" class="form-control" id="OfficeNameLocal" placeholder="ਦਫ਼ਤਰ ਦਾ ਨਾਮ (ਸਥਾਨਕ)" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 2: Location & Configuration -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-map-marker"></i> Location &amp; Configuration</div>
                                    <div class="form-card-grid">
                                        <div class="form-group col-full">
                                            <label for="OfficeAddress" class="profile-info-name fotm_lbl">Office Address:</label>
                                            <input type="text" class="form-control" id="OfficeAddress" placeholder="Enter Office Address" />
                                            <span id="OfficeAddressError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Office Address is required</span>
                                        </div>

                                        <div class="form-group col-full">
                                            <div class="office-apex-toggle">
                                                <label for="IsApex" class="office-checkbox-label">
                                                    <input type="checkbox" class="checkbox styled-checkbox" id="IsApex" />
                                                    <span class="office-checkbox-text">Is Apex Office</span>
                                                </label>
                                                <span class="office-checkbox-hint">Designates this office as the apex (primary) governing branch</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();"><i class="fa fa-check"></i> Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();" style="display:none;"><i class="fa fa-pencil-square-o"></i> Update</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>


    <a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
        <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
    </a>

</div>





<link rel="stylesheet" href="~/assets/css/jquery.dataTables.min.css" />
<script src="~/assets/js/jquery-3.7.0.js"></script>
<script src="~/assets/js/jquery.dataTables.min.js"></script>
