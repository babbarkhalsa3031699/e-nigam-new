
@model CMNirdesh.Models.RecruitmentNotification
@{ 
    string blobpath = CMNirdesh.Models.BlobStorage.GetStorageAcessingPath();
}



<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
</head>

<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Recruitment Notification  List</h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add Recruitment Notification</button>
                            </div>
                        </div>
                    </div>

                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model.RecruitmentNotificationList.Count() > 0)
                            {
                                <div class=" table-responsive">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Title</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Title (Local)</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Details</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Details (Local)</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Notification Document</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Apply Offline Document</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Apply Online URL</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model.RecruitmentNotificationList)
                                            {
                                                <tr>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@items.Title</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@items.Title_Local</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Details)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Details_Local)</td>

                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        @if (!string.IsNullOrEmpty(items.NotificationFile))
                                                        {
                                                           @*<span>@blobpath/@items.NotificationFile</span>*@ 

                                                        <a href="@Url.Content(blobpath + "/" + items.NotificationFile)" target="_blank">
                                                            Notification Document
                                                        </a>
                                                        }
                                                    </td>

                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        @if (!string.IsNullOrEmpty(items.ApplyOfflineFile))
                                                        {
                                                            <a href="@Url.Content(blobpath + "/" + items.ApplyOfflineFile)" target="_blank">
                                                                Apply Offline Document
                                                            </a>
                                                        }
                                                    </td>

                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        @if (!string.IsNullOrEmpty(items.ApplyOnlineURL))
                                                        {
                                                         
                                                            <a href = "@items.ApplyOnlineURL" target = "_blank" >
                                                            Apply Online URL
                                                            </a>
                                                        }
                                                    </td>

                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyConstituencyCode('@items.Id')">
                                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                </a>

                                                                <label class="toggle mb-0">
                                                                    <input type="checkbox" onclick="DeleteDepartmentRecord('@items.Id')" @(Convert.ToBoolean(items.IsActive) ? "checked='checked'" : "")>
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>


                </div>
            </div>
            <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">

                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Recruitment Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            @using (Html.BeginForm("Create", "Recuitment", FormMethod.Post, new { enctype = "multipart/form-data", @id = "recruitmentForm" }))
                            {
                                @Html.AntiForgeryToken()

                                @Html.HiddenFor(model => model.Id, new { @id = "Id" })
                                @Html.HiddenFor(model => model.Mode, new { id = "mode" })

                                @Html.HiddenFor(model => model.NotificationFile, new { id = "NotificationFile" })
                                @Html.HiddenFor(model => model.ApplyOfflineFile, new { id = "ApplyOfflineFile" })


                                <div class="form-group">
                                    @Html.Label("Title")
                                    @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", @id = "Title" } })
                                    @Html.ValidationMessageFor(model => model.Title)
                                </div>

                                <div class="form-group">
                                    @Html.Label("Title (Local)")
                                    @Html.EditorFor(model => model.Title_Local, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Title_Local)
                                </div>

                                <div class="form-group">
                                    @Html.Label("Details")
                                    @Html.TextAreaFor(model => model.Details, new { @class = "form-control", rows = 4 })
                                    @Html.ValidationMessageFor(model => model.Details)
                                </div>

                                <div class="form-group">
                                    @Html.Label("Details (Local)")
                                    @Html.TextAreaFor(model => model.Details_Local, new { @class = "form-control", rows = 4 })
                                    @Html.ValidationMessageFor(model => model.Details_Local)
                                </div>

                                <div class="form-group">
                                    @Html.Label("Start Date")
                                    @Html.TextBoxFor(model => model.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", @id = "StartDate" })
                                    @Html.ValidationMessageFor(model => model.StartDate)
                                </div>

                                <div class="form-group">
                                    @Html.Label("End Date")
                                    @Html.TextBoxFor(model => model.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", @id = "EndDate" })
                                    @Html.ValidationMessageFor(model => model.EndDate)
                                </div>

                                <div class="form-group">
                                    @Html.Label("Apply Online URL")
                                    @Html.TextBoxFor(model => model.ApplyOnlineURL, new { @class = "form-control", @id = "ApplyOnlineLinkId" })
                                    @Html.ValidationMessageFor(model => model.ApplyOnlineURL)
                                </div>

                                <div class="form-group">
                                    @Html.Label("Notification Document")
                                    <input type="file" name="NotificationFile" class="form-control" />
                                </div>

                                <div class="form-group">
                                    @Html.Label("Apply Offline Document")
                                    <input type="file" name="ApplyOfflineFile" class="form-control" />
                                </div>

                                <div class="form-group">
                                    @Html.Label("Is Active")
                                    @Html.CheckBoxFor(model => model.IsActive)
                                    @Html.ValidationMessageFor(model => model.IsActive)
                                </div>

                                <div class="modal-footer" style="background-color:white;">
                                    <button type="submit" class="btn btn-primary" id="btnSave">Save</button>
                                    <button type="submit" class="btn btn-primary" id="btnUpdate">Update</button>
                                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                                </div>
                            }
                        </div>

                        <div id="validationErrors" style="color:red"></div>

                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>


    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<script>


    $(document).ready(function () {
        $('#myModal').modal('hide');
        $("#myModalLabel").html("Save Recuitment Record");
        $("#btnUpdate").hide();
        //$("#btnSave").hide();
        $('#example').DataTable({
        });
    });

    function AddNew() {
        clearTextBox();
        $('#myModal').modal('show');
        $("#myModalLabel").html("Add Recuitment Record");
        $("#mode").val('Add');
    }




    function handleSuccess(response) {
        if (response.success) {
            alert("Form submitted successfully!");
             window.location.href =  "@Url.Action("Index", "Recuitment")";
        } else {

            var errorsHtml = "<ul>";
            $.each(response.errors, function (index, error) {
                errorsHtml += "<li>" + error + "</li>";
            });
            errorsHtml += "</ul>";
            $("#validationErrors").html(errorsHtml);
        }
    }

    function handleFailure(response) {
        $("#validationErrors").html("An error occurred while processing your request.");
    }

    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {
        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("UpdateStatusRecruitment", "Recuitment")' + '?Id=' + i,
            success: function (result) {
                alert("Updated Successfully");
               
            }
        });
    }


    function getbyConstituencyCode(ConstituencyCode) {
        clearTextBox()
        $("#myModalLabel").html("Save Recruitment Record");
        $("#btnUpdate").show();
        $("#btnSave").hide();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditRecutmentNotification", "Recuitment")' + '?id=' + ConstituencyCode,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
              
                var obj = JSON.parse(data);
                var data = obj.RecruitmentNotificationList[0];
                $('#myModal').modal('show');
                $("#mode").val('Edit');
                $("#Id").val(data.Id);
                $("#Title").val(data.Title);
                $("#Title_Local").val(data.Title_Local);
                $("#Details").val(data.Details);
                $('#Details_Local').val(data.Details_Local);
                var formattedDate = new Date(data.StartDate).toISOString().split('T')[0];
                $("#StartDate").val(formattedDate);
                var formattedEndDate = new Date(data.EndDate).toISOString().split('T')[0];
                $("#EndDate").val(formattedEndDate);
                $("#ApplyOnlineLinkId").val(data.ApplyOnlineURL); NotificationFile
                $("#NotificationFile").val(data.NotificationFile)
                $("#ApplyOfflineFile").val(data.ApplyOfflineFile)
                $("#btnSave").hide();
             }
        });
    }


    function clearTextBox() {
        $('#AssemblyID').val("");
        $('#ConstituencyCode').val("");
        $('#ConstituencyName').val("");
        $('#ConstituencyName_Local').val("");
        $("#btnSave").show();
        $("#btnUpdate").hide();
        $("#btnSave").show();
    }

</script>



