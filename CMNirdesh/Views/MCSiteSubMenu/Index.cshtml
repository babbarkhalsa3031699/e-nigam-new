@model CMNirdesh.Models.MCHouse.MCSiteSubMenu
@using CMNirdesh;

@{
    ViewBag.Title = "Index";
    var roleid = CMNirdesh.Models.CurrentSession.RoleID;
}

@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@
<div class="main-office-container">
    <div class="compact-breadcrumb-bar">
        <span class="crumb-root">Office Administration</span>
        <span class="crumb-sep">&gt;&gt;</span>
        <span class="crumb-current">MCHomeSubMenu</span>
    </div>

    <div class="source-heading">
        <h4>MC Site SubMenu List</h4>
        <button type="button" class="btn-toolbar-add" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();">
            <i class="fa fa-plus"></i> Add New MCSite SubMenu
        </button>
    </div>

    <div class="table-outer">
        <div class="unified-table-toolbar">
            <div style="font-size: 12px; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 6px;">
                <i class="fa fa-list text-primary"></i>
                <span>SubMenu Records</span>
            </div>
            <div class="toolbar-search-slot" id="toolbarSearchSlot"></div>
        </div>

        @if (Model != null)
        {
            if (Model._LstSubMenu.Count() > 0)
            {
                <div class="table-responsive table-cus">
                    <table id="example" class="table table-bordered dataTable">
                        <thead>
                            <tr class="table-heading">
                                <th style="width:12%;">SubMenu Id</th>
                                <th>MC Name</th>
                                <th style="width:20%;">Menu Name</th>
                                <th style="width:20%;">SubMenu Name</th>
                                <th style="width:16%;">Linked File</th>
                                <th style="width:8%; text-align: center;">SrNo</th>
                                <th style="width:14%; text-align: center;">Action</th>
                            </tr>
                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._LstSubMenu)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => items.SubMenuId)</td>
                                                    <td>@Html.DisplayFor(modelItem => items.MCName)</td>
                                                    <td>@Html.DisplayFor(modelItem => items.MenuName)</td>
                                                    <td>@Html.DisplayFor(modelItem => items.SubMenuName)</td>
                                                    @if ((!string.IsNullOrEmpty(items.linkurl)) && (items.isLink == 2))
                                                    {
                                                        <td>
                                                            <a href="@Url.Content(Model.fileacessingUrl + "/" + items.linkurl)" target="_blank" class="pdf-download-btn" title="Download Proceeding File">
                                                                <img src="/Assets/Home_Images/PDF.png" alt="Download" width="18" height="18" style="vertical-align: middle;">
                                                                <span style="font-size: 11.5px; font-weight: 600; color: #dc2626;">PDF</span>
                                                            </a>
                                                        </td>
                                                    }
                                                    else if ((!string.IsNullOrEmpty(items.linkurl)) && (items.isLink == 1))
                                                    {
                                                        <td>
                                                            <a href="@Url.Content(items.linkurl)" target="_blank" style="font-size: 12px; font-weight: 600; color: #2563eb; text-decoration: underline;">
                                                                Web URL
                                                            </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td style="color: #94a3b8; font-style: italic;">No Link</td>
                                                    }

                                                    <td style="text-align: center;">
                                                        <div class="action-cell-wrap">
                                                            <a class="btn-action-edit" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.SubMenuId')" title="Edit">
                                                                <i class="fa fa-pencil"></i>
                                                            </a>
                                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.SubMenuId')" value="@items.SubMenuId" />
                                                            <label class="toggle mb-0">
                                                                <input type="checkbox" onclick="DeleteDepartmentRecord('@items.SubMenuId')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                                                                <span class="slider"></span>
                                                                <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="analytics-empty-state">
                                    <i class="fa fa-folder-open-o" style="font-size: 32px; color: #94a3b8; margin-bottom: 8px;"></i>
                                    <div class="analytics-empty-title">No SubMenu Records Found</div>
                                    <div class="analytics-empty-desc">Click "Add New MCSite SubMenu" to create the first entry.</div>
                                </div>
                            }
                        }
    </div>
</div>

<div class="coman_modal dispatch_modal modal site-submenu-record-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-5" id="myModalLabel">Add Sub Menu Items</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="row">
                    <div class="form-section-card">
                        <div class="form-section-title"><i class="fa fa-info-circle"></i> SubMenu Configuration</div>
                        <div class="form-card-grid">
                            <div class="form-group" id="MCId">
                                <label for="MCIDDropDown" class="profile-info-name fotm_lbl">MC Name:</label>
                                <select id="MCIDDropDown" class="form-control" onchange="GetMenuDropdown(this.value)">
                                    <option value="0" id="SelectId" placeholder="MC Type">Please select</option>
                                </select>
                            </div>
                            <div class="form-group" id="MenuDropdown">
                                <label for="ch_user1" class="profile-info-name fotm_lbl">Menu Name:</label>
                                <select id="ch_user1" class="form-control" onchange="GetMaxSerial(this.value)">
                                    <option value="select" id="SelectId" placeholder="Controller Name"></option>
                                </select>
                            </div>
                            <div class="form-group" id="SubMenuIdLabel" style="display:none;">
                                <label for="SubMenuId" class="profile-info-name fotm_lbl">SubMenuId:</label>
                                <input type="text" class="form-control" id="SubMenuId" placeholder="SubMenu ID" />
                            </div>
                            <div class="form-group">
                                <label for="SubMenuName" class="profile-info-name fotm_lbl">SubMenu Name:</label>
                                <input type="text" class="form-control" id="SubMenuName" placeholder="SubMenu Name" />
                            </div>
                            <div class="form-group">
                                <label for="SubMenuNameLocal" class="profile-info-name fotm_lbl">SubMenu Name (Punjabi):</label>
                                <input type="text" class="form-control" id="SubMenuNameLocal" placeholder="ਸਬ-ਮੇਨੂ ਨਾਮ (ਪੰਜਾਬੀ)" />
                            </div>
                            <div class="form-group">
                                <label for="SrNo" class="profile-info-name fotm_lbl">Serial Number (SrNo):</label>
                                <input type="number" class="form-control" id="SrNo" placeholder="Enter SrNo" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section-card">
                        <div class="form-section-title"><i class="fa fa-link"></i> Link Destination &amp; Attachment</div>
                        <div style="margin-bottom: 12px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                            <span style="font-size: 12px; font-weight: 600; color: #475569;">Destination Type:</span>
                            @if (CMNirdesh.Models.CurrentSession.RoleID == "18")
                            {
                                <label class="radio-inline" style="font-size: 12px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                    <input type="radio" id="isPage" name="linkOrPage" value="page" onchange="showInput()"> Web Module
                                </label>
                            }
                            <label class="radio-inline" style="font-size: 12px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                <input type="radio" id="isLink" name="linkOrPage" value="link" onchange="showInput()"> Web URL
                            </label>
                            <label class="radio-inline" style="font-size: 12px; font-weight: 500; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                                <input type="radio" id="isPDF" name="linkOrPage" value="pdf" onchange="showInput()"> Attach PDF
                            </label>
                        </div>

                        <div class="form-group" id="inputContainer" style="display: none; margin-bottom: 10px;">
                            <label for="Url" class="profile-info-name fotm_lbl">Enter URL / Route:</label>
                            <input type="text" class="form-control" id="Url" name="Url" placeholder="Enter URL" />
                        </div>
                        <div class="form-group" id="pdfContainer" style="display: none;">
                            <label for="uploadpdfFile" class="profile-info-name fotm_lbl">Upload PDF File:</label>
                            <input type="file" name="file" class="form-control" id="uploadpdfFile" accept=".pdf" />
                            <a class="btn-link text-danger mt-1 d-inline-block" href="~/SecureFileStructure/Local Government/head.png" target="_blank" id="pdfFile" style="display:none;font-size:10pt"><i class="fa fa-file-pdf-o"></i> View PDF</a>
                            <input type="hidden" id="pdfFileName" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();"><i class="fa fa-check"></i> Save</button>
                <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();" style="display:none;"><i class="fa fa-pencil-square-o"></i> Update</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</button>
            </div>
        </div>
    </div>
</div>
<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
    <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
</a>








