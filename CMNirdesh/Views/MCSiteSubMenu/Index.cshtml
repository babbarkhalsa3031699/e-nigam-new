        }
    });
    var menuorder = $('#hdnMenuOrder').val(); //alert(menuorder);

});
    $('#example').DataTable({
    });
    function getbyID(EmpID) {

        clearTextBox();

        var url = '@Url.Action("Edit", "MCSiteSubMenu")' + '?id=' + EmpID;
        $("#myModalLabel").html("Update Sub-Menu Items");
        //$("#SubMenuIcon2").empty();
        $("#btnUpdate").show();
        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {

                var obj = JSON.parse(data);

                var data = obj._LstSubMenu[0];
                var src = data.icon;
                var fileaccessUrl = '@Model.fileacessingUrl' + '/' + data.pdf;
                $("#SubMenuId").attr("disabled", "disabled");
                $('#myModal').modal();
                $("#SubMenuId").val(data.SubMenuId);
                $("#MCIDDropDown").val(data.MCId).change();
                //alert(data.MenuId);
                setTimeout(function () {
                    // Set the value of dropdown2 after a delay
                    $('#ch_user1').val(data.MenuId); // Adjust this value and delay as needed
                }, 500); // Delay in milliseconds (1000ms = 1 second)

                $("#ch_user1 option[value=" + data.MenuId + "]").prop("selected", "selected");
                //$("#ch_user1").val(data.MenuId);
                $("#SubMenuName").val(data.SubMenuName);
                $("#SubMenuNameLocal").val(data.SubMenuNameLocal);
                $("#SrNo").val(data.SrNo);
                $("#btnSave").hide();
                $("#imgPreview").attr('src','/'+data.icon);
                $("#Url").val(data.linkurl);

                if (data.linktype == 1) {
                    $("#isLink").prop("checked", true);
                    $('#inputContainer').css("display", "block");
                    $('#pdfContainer').css("display", "none");
                }
                else if (data.linktype == 2) {
                    $("#isPage").prop("checked", true);
                    $('#inputContainer').css("display", "block");
                    $('#pdfContainer').css("display", "none");
                }
                else if (data.linktype == 3) {
                    $("#isPDF").prop("checked", true);
                    $('#inputContainer').css("display", "none");
                    $('#pdfContainer').css("display", "block");
                    $("#pdfFile").attr('href', '/' + fileaccessUrl);
                    $("#pdfFile").css('display', 'block');
                    $("#pdfFileName").val(data.pdfYN);
                }
            }

        });

    }

    //Function for clearing the textboxes

    //Valdidation using jquery
    function validate() {

        var isValid = true;
        $('#OfficeIdLabel').hide();

        if ($('#MCIDDropDown').val().trim() === "") {
            $('#MCIDDropDown').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#MCIDDropDown').css('background-color', 'white');
        }
        if ($('#ch_user1').val().trim() === "0") {
            $('#ch_user1').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#ch_user1').css('background-color', 'white');
        }
        if ($('#SubMenuName').val().trim() === "") {
            $('#SubMenuName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#SubMenuName').css('background-color', 'white');
        }
        if ($('#SubMenuNameLocal').val().trim() === "") {
            $('#SubMenuNameLocal').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#SubMenuNameLocal').css('background-color', 'white');
        }
        if ($('#SrNo').val().trim() === "") {
            $('#SrNo').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#SrNo').css('background-color', 'white');
        }
        var s = getSelectedValue();
        if (s == 'pdf') {

            var fileInput = $('#uploadpdfFile');
            var file = fileInput[0].files[0];
            $('#uploadpdfFile').css('background-color', 'white');

            if (file) {
                //var fileSize = file.size; // in bytes
                //var maxSize = 1024 * 2 * 1024; // 1MB

                //if (fileSize > maxSize) {
                //    alert('File size exceeds the maximum limit (2MB).');
                //    $('#uploadpdfFile').css('background-color', '#ff56564d');
                //    isValid = false;
                //    return false;
                //}

                var allowedExtensions = /(\.pdf)$/i;
                if (!allowedExtensions.exec(fileInput.val())) {
                    alert('Only PDF files are allowed.');
                    $('#uploadpdfFile').css('background-color', '#ff56564d');
                    isValid = false;
                    return false;
                }
            }
            else {
                alert($("#pdfFileName").val());
                if ($("#pdfFileName").val() == 'N') {
                    alert('Please select a PDF file to upload.');
                    $('#uploadpdfFile').css('background-color', '#ff56564d');
                    isValid = false;
                    return false;
                }
            }
        }
        return isValid;
    }
