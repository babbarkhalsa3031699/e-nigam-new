@model CMNirdesh.Models.MCHouse.MCSiteSubMenu
@using CMNirdesh;

@{
    ViewBag.Title = "Index";
    var roleid = CMNirdesh.Models.CurrentSession.RoleID;
}

@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@
<div id="main-content">
    <div class="main-content">
        <!-- #section:basics/content.breadcrumbs -->
        <section class="form_dsign">
            <div class="container-fluid p-0">

                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> MC Site SubMenu List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" style="font-size:14px;" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New MCSite SubMenu</button>
                            </div>
                        </div>
                    </div>


                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model._LstSubMenu.Count() > 0)
                            {
                                <div class="table-responsive ">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">SubMenu Id</span></th>
                                                <th class="td-heading"><span class="font-weight-bold">MC Name</span></th>
                                                <th class="td-heading" style="width:22%;"><span class="font-weight-bold">Menu Name</span></th>
                                                <th class="td-heading" style="width:22%;"><span class="font-weight-bold">SubMenu Name</span></th>
                                                <th class="td-heading" style="width:22%;"><span class="font-weight-bold">Linked file</span></th>

                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">SrNo</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._LstSubMenu)
                                            {
                                                <tr>
                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.SubMenuId)</td>
                                                    <td class="center" style="font-size:18px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.MCName)</td>
                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.MenuName)</td>
                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.SubMenuName)</td>
                                                    @if ((!string.IsNullOrEmpty(items.linkurl)) && (items.isLink == 2))
                                                    {
                                                        <td class="center td-data" style="padding: 14px 4px !important">
                                                            <a href="@Url.Content(Model.fileacessingUrl + "/" + items.linkurl)" target="_blank">
                                                                <img src="/Assets/Home_Images/PDF.png" alt="Download" title="Download Proceeding File" width="24" height="24">
                                                            </a>
                                                        </td>
                                                    }
                                                    else if ((!string.IsNullOrEmpty(items.linkurl)) && (items.isLink == 1))
                                                    {
                                                        <td class="center td-data" style="padding: 14px 4px !important">
                                                            <a href="@Url.Content(items.linkurl)" target="_blank">
                                                               Web URL
                                                            </a>
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td class="center td-data" style="padding: 14px 4px !important">No Link</td>
                                                    }

                                                    <td class="center td-data" style=" padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.SrNo)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.SubMenuId')">
                                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                </a>
                                                                @*<a data-rel="tooltip" id="DeleteCheck" class="red tooltip-error" onclick="DeleteOfficeRecord('@items.SubMenuId')" value="@items.SubMenuId">
                        <i class="ace-icon fa fa-trash-o bigger-130"></i>
                        <input type="hidden" id="DeleteConfirmFinal" value='@items.SubMenuId' class="DeleteConfirm" />
                    </a>*@
                                                            </div>
                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.SubMenuId')" value="@items.SubMenuId" />
                                                                <label class="toggle mb-0">
                                                                    <input type="checkbox" onclick="DeleteDepartmentRecord('@items.SubMenuId')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>
                                                        </div>


                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>

            <div class="coman_modal dispatch_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Sub Menu Items</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form class="row ">
                                <div class="col-md-6 col-sm-12 col-12 form-group" id="MCId">
                                    <div class="profile-info-name fotm_lbl">MC Name:</div>
                                    <select id="MCIDDropDown" onchange="GetMenuDropdown(this.value)">
                                        <option value="0" class="form-control txt_design" id="SelectId" placeholder="MC Type">Please select</option>
                                    </select>
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group" id="MenuDropdown">
                                    <div class="profile-info-name fotm_lbl">Menu Name:</div>
                                    <select id="ch_user1" onchange="GetMaxSerial(this.value)">
                                        <option value="select" class="form-control txt_design" id="SelectId" placeholder="Controller Name"></option>
                                    </select>
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group" id="SubMenuIdLabel">

                                    <div class="profile-info-name fotm_lbl">SubMenuId:</div>
                                    <input type="text" class="form-control txt_design" id="SubMenuId" placeholder="SubMenu Name" />
                                </div>

                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <div class="profile-info-name fotm_lbl">SubMenuName:</div>
                                    <input type="text" class="form-control txt_design" id="SubMenuName" placeholder="SubMenu Name" />
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <div class="profile-info-name fotm_lbl">SubMenuName (Punjabi):</div>
                                    <input type="text" class="form-control txt_design" id="SubMenuNameLocal" placeholder="SubMenu Name Local" />
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <div class="profile-info-name fotm_lbl">SrNo:</div>
                                    <input type="number" class="form-control txt_design" id="SrNo" placeholder="SrNo" />
                                </div>
                                <div class="form-group">
                                    <h5>Select Link or Page:</h5>
                                    @if (CMNirdesh.Models.CurrentSession.RoleID == "18")
                                    {
                                        <input type="radio" id="isPage" name="linkOrPage" value="page" onchange="showInput()"> <label for="isPage">Web Module</label>
                                    }
                                    <input type="radio" id="isLink" name="linkOrPage" value="link" onchange="showInput()"> <label for="isLink">Web URL</label>
                                    <input type="radio" id="isPDF" name="linkOrPage" value="pdf" onchange="showInput()"> <label for="isPDF">Attach PDF</label>
                                    <br>
                                </div>
                                <div class="form-group" id="inputContainer" style="display: none;">
                                    <label for="Url">Enter URL:</label><br>
                                    <input type="text" class="form-control txt_design" id="Url" name="Url"><br>
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group" id="pdfContainer" style="display: none;">
                                    <label for="Url">
                                        Upload PDF File:
                                    </label><br>
                                    <input type="file" name="file" class="form-control" id="uploadpdfFile" placeholder="PDF File" accept=".pdf" />
                                    <a class="btn-link text-danger" href="~/SecureFileStructure/Local Government/head.png" target="_blank" id="pdfFile" style="display:none;font-size:10pt">View PDF</a>
                                    <input type="hidden" id="pdfFileName" />
                                </div>
                                @*<div class="form-group">
                                        <div class="profile-info-name fotm_lbl">
                                            SubMenu Icon:
                                        </div>
                                        <input type="file" name="file" class="form-control" id="SubMenuIcon" placeholder="SubMenu Icon" accept=".jpg,.jpeg,.bmp,.png,.gif" />

                                    </div>

                                    <div class="col-md-6 col-sm-12 col-12 form-group">
                                        <img src="https://placehold.jp/100x100.png" id="imgPreview" class="" style="width:100px; height:100px; border:1px solid red;" alt="Load Icon" />
                                        <input type="hidden" id="SubMenuIconName" />
                                    </div>*@
                            </form>
                        </div>
                        <div class="modal-footer" style="background-color:white;">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
</div>
