    function Add() {
        var res = validate();
        if (res == false) {
            return false;
        }

        if (window.FormData !== undefined) {
            var s = getSelectedValue();
            var linktype;
            if (s == 'link') {
                linktype = 1;
            }
            else if (s == 'pdf') {
                linktype = 3;
            }
            else if (s == 'page') {
                linktype = 2;
            }
            var MCName = $('#MCIDDropDown option:selected').text();
           
           
            var fileUpload = $("#uploadpdfFile").get(0);
            //var fileUpload1 = $("#SubMenuIcon").get(0);
            var files = fileUpload.files;
            //var files2 = fileUpload1.files;
            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object


            for (var i = 0; i < (files.length) ; i++)  {
                fileData.append(files.name, files[i]);
                //fileData.append(files2.name, files2[i]);
            }
                const courseDto = {
                MenuId: $('#ch_user1').val(),
                SubMenuName: $('#SubMenuName').val(),
                SubMenuNameLocal: $('#SubMenuNameLocal').val(),
                    MCName: MCName,
                   
                //icon: $('#SubMenuIcon').val(),
                    SrNo: $('#SrNo').val(),
                    linktype: linktype,
                    linkurl: $('#Url').val(),
            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            $.ajax({
                url: '@Url.Action("Create", "MCSiteSubMenu")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    {
                        if (result != 0) {
                            alert("Updated Successfully");
                            $('#myModal').hide();
                            location.reload();
                        }
                        else {
                            alert("Error Occurred " + result);
                        }
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
    function getSelectedValue() {
        var selectedValue;
        var radios = document.getElementsByName('linkOrPage');

        for (var i = 0; i < radios.length; i++) {
            if (radios[i].checked) {
                selectedValue = radios[i].value;
                break;
            }
        }

        return selectedValue;
    }
    function Update() {
        var res = validate();
        if (res == false) {
            return false;
        }
        $("#SubMenuId").removeAttr("disabled", "disabled");
        var MCName = $('#MCIDDropDown option:selected').text();
        if (window.FormData !== undefined) {
            var s = getSelectedValue();
            var linktype;
            if (s == 'link') {
                linktype = 1;
            }
            else if (s == 'pdf') {
                linktype = 3;
            }
            else if (s == 'page') {
                linktype = 2;
            }

            var fileUpload = $("#uploadpdfFile").get(0);
            //var fileUpload1 = $("#SubMenuIcon").get(0);
            var files = fileUpload.files;
            //var files2 = fileUpload1.files;
            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files.name, files[i]);
                //fileData.append(files2.name, files2[i]);
            }


            const courseDto = {
                SubMenuId: $('#SubMenuId').val(),
                SubMenuName: $('#SubMenuName').val(),
                SubMenuNameLocal: $('#SubMenuNameLocal').val(),
                MCName: MCName,
                MenuId: $('#ch_user1').val(),
                //icon: $('#SubMenuIcon').val(),
                SrNo: $('#SrNo').val(),
                linktype: linktype,
                linkurl: $('#Url').val(),

            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            $.ajax({
                url: '@Url.Action("Update", "MCSiteSubMenu")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    {
                        debugger
                        if (result != 0) {
                            alert("Updated Successfully");
                            $('#myModal').hide();
                            location.reload();
                        }
                        else {
                            alert("Not Updated SrNo Already Existing");
                        }
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
