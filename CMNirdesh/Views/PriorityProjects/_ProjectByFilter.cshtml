@model CMNirdesh.DTO.PriorityProjectList
@foreach (var priorty in Model)
{


    <tr role="row">

        <td class="center">
            <a href="#" onclick="BindocImage(@priorty.ProjectId, '@priorty.ProjectName', '@priorty.Remark')">
                @priorty.ProjectName
            </a>

        </td>
        <td class="center">
            @priorty.FirmName

        </td>
        <td class="center">
            @priorty.CategoryName

        </td>
        <td class="center">
            @priorty.EstimatedAmount

        </td>
        <td class="center">
            @priorty.FundReleased

        </td>
        <td class="center">
            @priorty.Expenditure

        </td>
        <td class="center">
            @priorty.PhysicalProgress


        </td>
        <td class="center">
            @priorty.StartDate

        </td>
        <td class="center">
            @priorty.EndDate

        </td>
        <td class="center">
            @priorty.ProjectStatusName

        </td>
    </tr>


}

