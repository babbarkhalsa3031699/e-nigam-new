@model CMNirdesh.Models.PriorityProject

@{
    ViewBag.Title = "PriorityProjects";
    var url = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"];
    var servicename = CMNirdesh.Models.CurrentSession.serviceName;
    var isapex = CMNirdesh.Models.CurrentSession.isApex;
    int totalProjects = Model != null && Model.PromiseTypeList != null ? Model.PromiseTypeList.Count() : 0;
    int totalDepts = Model != null ? (Model.mDepartmentList != null ? Model.mDepartmentList.Count() : (Model.mOfficeList != null ? Model.mOfficeList.Count() : 0)) : 0;
}

<!DOCTYPE html>
<html>
<head>
    <link href="~/Content/style_ms.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/responsive_ms.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/common.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <script src="~/Scripts/datatables/vfs-fonts-punjabi.js"></script>

    <style>
        /* === EXECUTIVE DESIGN SYSTEM: PRIORITY PROJECTS === */
        body,
        .form_dsign,
        #main-content {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            color: #1e293b;
        }

        /* 1. Compact Breadcrumb & Executive Header Bar */
        .adc-header-row {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            flex-wrap: nowrap !important;
            gap: 12px !important;
        }

        h4#lblmenuname,
        .compact-breadcrumb-bar {
            font-size: 15px !important;
            font-weight: 700 !important;
            color: #1e3a8a !important;
            margin: 0 !important;
            padding: 0 !important;
            line-height: 1.35 !important;
            display: inline-flex !important;
            align-items: center !important;
            letter-spacing: -0.01em !important;
            font-family: 'Poppins', sans-serif !important;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        h4#lblmenuname .crumb-sep,
        .compact-breadcrumb-bar .crumb-sep {
            color: #94a3b8 !important;
            margin: 0 7px !important;
            font-weight: 400 !important;
            font-size: 14px !important;
        }

        /* Header Actions & Metric Badges */
        .adc-header-actions {
            display: flex !important;
            align-items: center !important;
            flex-wrap: nowrap !important;
            gap: 10px !important;
            flex-shrink: 0 !important;
        }

        .adc-metrics-strip {
            display: inline-flex !important;
            align-items: center !important;
            flex-wrap: nowrap !important;
            gap: 8px !important;
            flex-shrink: 0 !important;
        }

        .adc-metric-badge {
            display: inline-flex !important;
            align-items: center !important;
            padding: 4px 10px !important;
            border-radius: 6px !important;
            font-size: 11.5px !important;
            font-weight: 600 !important;
            border: 1px solid #e2e8f0 !important;
            background: #ffffff !important;
            color: #334155 !important;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04) !important;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        /* New Project Action Button */
        .btn-action-new-project {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
            border: none !important;
            color: #ffffff !important;
            font-size: 12.5px !important;
            font-weight: 600 !important;
            padding: 5px 14px !important;
            border-radius: 6px !important;
            height: 32px !important;
            display: inline-flex !important;
            align-items: center !important;
            box-shadow: 0 1px 3px rgba(16, 185, 129, 0.25) !important;
            transition: all 0.15s ease !important;
            text-decoration: none !important;
            white-space: nowrap !important;
            flex-shrink: 0 !important;
        }

        .btn-action-new-project:hover {
            background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(16, 185, 129, 0.35) !important;
            color: #ffffff !important;
        }

        /* 2. Compact Filter Toolbar */
        .agenda-filter-bar {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            margin-bottom: 10px;
        }

        .filter-label-compact {
            font-size: 12px;
            font-weight: 600;
            color: #475569;
        }

        .custom-select-compact {
            height: 32px !important;
            padding: 3px 26px 3px 10px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 6px !important;
            font-size: 12px !important;
            color: #1e293b !important;
            background-color: #ffffff !important;
            transition: all 0.2s ease;
        }

        .custom-select-compact:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15) !important;
            outline: none !important;
        }

        .btn-stat-count-icon {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            border: 1px solid #cbd5e1;
            background: #f1f5f9;
            color: #475569;
            font-size: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            cursor: pointer;
            transition: all 0.15s ease;
        }

        .btn-stat-count-icon:hover {
            background: #3b82f6;
            color: #ffffff;
            border-color: #3b82f6;
            transform: scale(1.08);
        }

        .btn-compact-search {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
            border: none !important;
            color: #ffffff !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            padding: 4px 14px !important;
            border-radius: 6px !important;
            height: 32px !important;
            display: inline-flex !important;
            align-items: center !important;
            box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25) !important;
            transition: all 0.15s ease !important;
        }

        .btn-compact-search:hover {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%) !important;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(37, 99, 235, 0.35) !important;
            color: #ffffff !important;
        }

        .btn-compact-reset {
            background: #f1f5f9 !important;
            border: 1px solid #cbd5e1 !important;
            color: #334155 !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            padding: 4px 12px !important;
            border-radius: 6px !important;
            height: 32px !important;
            display: inline-flex !important;
            align-items: center !important;
            transition: all 0.15s ease !important;
        }

        .btn-compact-reset:hover {
            background: #e2e8f0 !important;
            color: #0f172a !important;
        }

        .btn-compact-back {
            background: #fff1f2 !important;
            border: 1px solid #fecdd3 !important;
            color: #e11d48 !important;
            font-size: 11.5px !important;
            font-weight: 600 !important;
            padding: 3px 10px !important;
            border-radius: 5px !important;
            height: 28px !important;
            display: inline-flex !important;
            align-items: center !important;
            transition: all 0.15s ease !important;
            text-decoration: none !important;
        }

        .btn-compact-back:hover {
            background: #e11d48 !important;
            color: #ffffff !important;
        }

        /* 3. Segmented Table-Switch Bar */
        .table-switch-container {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 5px 8px;
            margin-bottom: 12px;
        }

        .table-switch {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin: 0;
        }

        .table-switch .switch-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 5px 12px;
            cursor: pointer;
            transition: all 0.15s ease;
            user-select: none;
        }

        .table-switch .switch-item:hover {
            border-color: #cbd5e1;
            background: #f1f5f9;
        }

        .table-switch .switch-item:has(input[type="radio"]:checked),
        .table-switch .switch-item.active {
            background: #eff6ff;
            border-color: #3b82f6;
            box-shadow: 0 1px 2px rgba(59, 130, 246, 0.12);
        }

        .table-switch .switch-item input[type="radio"] {
            accent-color: #2563eb;
            margin: 0;
            cursor: pointer;
            width: 14px;
            height: 14px;
        }

        .table-switch .switch-item label {
            margin: 0;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            color: #475569;
        }

        .table-switch .switch-item:has(input[type="radio"]:checked) label,
        .table-switch .switch-item.active label {
            color: #1e40af;
            font-weight: 700;
        }

        /* 4. Executive Table Card */
        .agenda-table-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 10px 12px;
            box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
        }

        .table-responsive {
            overflow-x: auto !important;
            -webkit-overflow-scrolling: touch;
            width: 100%;
        }

        #tableProjects,
        #tableProjectWorksList {
            min-width: 600px;
        }

        #tableProjectList {
            min-width: 950px;
        }

        #tableProjects,
        #tableProjectWorksList,
        #tableProjectList {
            width: 100% !important;
            border-collapse: separate !important;
            border-spacing: 0 !important;
            border: 1px solid #e2e8f0 !important;
            border-radius: 6px !important;
            overflow: hidden !important;
            margin-top: 4px !important;
        }

        #tableProjects thead tr.table-heading th,
        #tableProjects thead tr.table-heading td,
        #tableProjectWorksList thead tr.table-heading th,
        #tableProjectWorksList thead tr.table-heading td,
        #tableProjectList thead tr.table-heading th,
        #tableProjectList thead tr.table-heading td {
            background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%) !important;
            color: #ffffff !important;
            font-size: 12px !important;
            font-weight: 600 !important;
            text-transform: capitalize !important;
            letter-spacing: 0.01em !important;
            padding: 8px 10px !important;
            border: none !important;
            border-right: 1px solid rgba(255, 255, 255, 0.2) !important;
            vertical-align: middle !important;
            white-space: nowrap !important;
        }

        #tableProjects thead tr.table-heading td:last-child,
        #tableProjectWorksList thead tr.table-heading td:last-child,
        #tableProjectList thead tr.table-heading td:last-child {
            border-right: none !important;
        }

        #tableProjects tbody tr td,
        #tableProjectWorksList tbody tr td,
        #tableProjectList tbody tr td {
            font-size: 12px !important;
            line-height: 1.4 !important;
            color: #1e293b !important;
            padding: 7px 10px !important;
            border: none !important;
            border-bottom: 1px solid #f1f5f9 !important;
            border-right: 1px solid #f1f5f9 !important;
            vertical-align: middle !important;
            background: #ffffff;
            transition: background 0.1s ease !important;
        }

        #tableProjects tbody tr:nth-child(even) td,
        #tableProjectWorksList tbody tr:nth-child(even) td,
        #tableProjectList tbody tr:nth-child(even) td {
            background-color: #f8fafc !important;
        }

        #tableProjects tbody tr:hover td,
        #tableProjectWorksList tbody tr:hover td,
        #tableProjectList tbody tr:hover td {
            background-color: #eff6ff !important;
        }

        /* Badges & Pills */
        .project-id-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 5px;
            font-weight: 700;
            font-size: 11.5px;
            background: #f1f5f9;
            color: #0f172a;
            border: 1px solid #e2e8f0;
            letter-spacing: 0.02em;
        }

        #tableProjects tbody tr td a.loader,
        #tableProjectWorksList tbody tr td a.loader,
        .badge-count-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 28px;
            height: 24px;
            padding: 2px 10px;
            border-radius: 12px;
            background: #eff6ff;
            color: #1d4ed8 !important;
            font-weight: 700;
            font-size: 11.5px;
            border: 1px solid #bfdbfe;
            text-decoration: none !important;
            transition: all 0.15s ease;
        }

        #tableProjects tbody tr td a.loader:hover,
        #tableProjectWorksList tbody tr td a.loader:hover,
        .badge-count-pill:hover {
            background: #2563eb;
            color: #ffffff !important;
            border-color: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 2px 5px rgba(37, 99, 235, 0.25);
        }

        .btnLinks {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            padding: 2px 7px !important;
            font-size: 11px !important;
            font-weight: 700 !important;
            border-radius: 4px !important;
            height: 24px !important;
            min-width: 24px !important;
            transition: all 0.15s ease !important;
        }

        /* Gurmukhi text styling */
        .gurmukhi-text {
            font-family: 'Raavi', 'Noto Sans Gurmukhi', 'Mukta Mahee', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            font-size: 12.5px !important;
            line-height: 1.4 !important;
        }

        /* 5. DataTables Toolbar & Controls */
        .dt-buttons .dt-button,
        .dt-btn-action {
            background: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 5px !important;
            padding: 3px 10px !important;
            font-size: 11.5px !important;
            height: 28px !important;
            font-weight: 600 !important;
            color: #334155 !important;
            margin-right: 5px !important;
            box-shadow: none !important;
            transition: all 0.15s ease !important;
            display: inline-flex !important;
            align-items: center !important;
        }

        .dt-buttons .dt-button:hover,
        .dt-btn-action:hover {
            background: #f8fafc !important;
            border-color: #94a3b8 !important;
            transform: translateY(-1px);
        }

        .dt-buttons .buttons-excel:hover,
        .dt-btn-excel:hover {
            border-color: #10b981 !important;
            color: #059669 !important;
        }

        .dt-buttons .buttons-csv:hover,
        .dt-btn-csv:hover {
            border-color: #0284c7 !important;
            color: #0284c7 !important;
        }

        .dt-buttons .buttons-pdf:hover,
        .dt-btn-pdf:hover {
            border-color: #e11d48 !important;
            color: #e11d48 !important;
        }

        .dataTables_length label,
        .dataTables_filter label {
            font-size: 11.5px !important;
            font-weight: 600 !important;
            color: #475569 !important;
            margin: 0 !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
        }

        .dataTables_length select,
        .dataTables_filter input {
            height: 28px !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 5px !important;
            padding: 2px 8px !important;
            font-size: 11.5px !important;
            color: #1e293b !important;
            background: #ffffff !important;
            transition: all 0.15s ease !important;
        }

        .dataTables_filter input:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15) !important;
            outline: none !important;
        }

        .dataTables_info {
            font-size: 11.5px !important;
            color: #64748b !important;
            font-weight: 500 !important;
            padding-top: 6px !important;
        }

        .dataTables_paginate .paginate_button {
            border-radius: 5px !important;
            font-size: 11.5px !important;
            padding: 2px 8px !important;
            border: 1px solid #e2e8f0 !important;
            background: #ffffff !important;
            color: #334155 !important;
            margin: 0 2px !important;
        }

        .dataTables_paginate .paginate_button.current,
        .dataTables_paginate .paginate_button.current:hover {
            background: #2563eb !important;
            color: #ffffff !important;
            border-color: #2563eb !important;
        }

        /* 6. Polished Modals */
        .modal {
            z-index: 1070 !important;
        }

        .modal-backdrop {
            z-index: 1065 !important;
        }

        #mpProjectList {
            z-index: 1075 !important;
        }

        #modalWorks,
        #modalImages,
        #modalAddDocument,
        #modalAddConstituency {
            z-index: 1085 !important;
        }

        .modal-dialog .modal-content {
            border: none !important;
            border-radius: 10px !important;
            overflow: hidden !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2), 0 8px 10px -6px rgba(0, 0, 0, 0.2) !important;
        }

        .modal-dialog .modal-header {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%) !important;
            color: #ffffff !important;
            padding: 10px 16px !important;
            border-bottom: none !important;
        }

        .modal-dialog .modal-header .modal-title,
        .modal-dialog .modal-header h4,
        .modal-dialog .modal-header h5 {
            color: #ffffff !important;
            font-size: 14px !important;
            font-weight: 700 !important;
            margin: 0 !important;
        }

        .modal-dialog .modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: 0.85;
        }

        .modal-dialog .modal-header .btn-close:hover {
            opacity: 1;
        }

        .modal-dialog .modal-header .btn-close-modal {
            background: rgba(255, 255, 255, 0.15) !important;
            border: none !important;
            color: #ffffff !important;
            width: 28px !important;
            height: 28px !important;
            border-radius: 50% !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            font-size: 16px !important;
            line-height: 1 !important;
            transition: all 0.15s ease !important;
            padding: 0 !important;
        }

        .modal-dialog .modal-header .btn-close-modal:hover {
            background: rgba(255, 255, 255, 0.3) !important;
            color: #ffffff !important;
            transform: scale(1.08);
        }

        /* 7. Comprehensive Responsive Layout */
        @@media (max-width: 1199.98px) {
            .filter-item-group {
                min-width: 180px;
            }
        }

        @@media (max-width: 991.98px) {
            .adc-header-row {
                flex-wrap: wrap !important;
                gap: 10px !important;
            }
            .adc-header-actions {
                width: 100% !important;
                justify-content: space-between !important;
                margin-left: 0 !important;
            }
            .filter-item-group {
                min-width: calc(50% - 10px) !important;
                flex: 1 1 calc(50% - 10px) !important;
            }
            .filter-action-group {
                width: 100% !important;
                display: flex !important;
                justify-content: flex-end !important;
                margin-top: 4px !important;
            }
        }

        @@media (max-width: 767.98px) {
            .priority-projects-container {
                padding: 0 4px;
            }
            h4#lblmenuname,
            .compact-breadcrumb-bar {
                font-size: 14px !important;
                white-space: normal !important;
            }
            .adc-metrics-strip {
                gap: 5px !important;
            }
            .adc-metric-badge {
                padding: 3px 8px !important;
                font-size: 11px !important;
            }
            .agenda-filter-bar {
                padding: 4px 0 !important;
            }
            .agenda-table-card {
                padding: 8px !important;
            }
            .table-switch-container {
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch;
                padding: 4px 6px !important;
            }
            .table-switch {
                flex-wrap: nowrap !important;
                gap: 6px !important;
                white-space: nowrap !important;
            }
            .table-switch .switch-item {
                flex-shrink: 0 !important;
                padding: 4px 10px !important;
            }
            .table-switch .switch-item label {
                font-size: 11.5px !important;
            }
            /* DataTables mobile layout */
            .dataTables_wrapper .dt-buttons {
                float: none !important;
                display: flex !important;
                flex-wrap: wrap !important;
                gap: 4px !important;
                margin-bottom: 8px !important;
            }
            .dataTables_wrapper .dataTables_length {
                float: left !important;
                margin-bottom: 8px !important;
            }
            .dataTables_wrapper .dataTables_filter {
                float: right !important;
                margin-bottom: 8px !important;
            }
            .dataTables_wrapper .dataTables_filter input {
                width: 120px !important;
            }
            .dataTables_wrapper .dataTables_info {
                float: none !important;
                text-align: center !important;
                margin-bottom: 6px !important;
            }
            .dataTables_wrapper .dataTables_paginate {
                float: none !important;
                display: flex !important;
                justify-content: center !important;
                flex-wrap: wrap !important;
            }
            /* Modal responsiveness */
            #mpProjectList .modal-dialog {
                margin: 0 !important;
                max-width: 100% !important;
                height: 100% !important;
            }
            #mpProjectList .modal-content {
                height: 100% !important;
                border-radius: 0 !important;
            }
            #mpProjectList .modal-header {
                padding: 8px 12px !important;
            }
            #mpProjectList .modal-header .modal-title {
                font-size: 13px !important;
            }
            #mpProjectList .modal-body {
                padding: 8px !important;
            }
            #mpProjectList .modal-footer {
                padding: 6px 12px !important;
            }
        }

        @@media (max-width: 575.98px) {
            .adc-header-actions {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 8px !important;
            }
            .adc-metrics-strip {
                display: flex !important;
                justify-content: space-between !important;
                width: 100% !important;
            }
            .adc-metric-badge {
                flex: 1 !important;
                justify-content: center !important;
            }
            .btn-action-new-project {
                width: 100% !important;
                justify-content: center !important;
            }
            .filter-item-group {
                min-width: 100% !important;
                flex: 1 1 100% !important;
            }
            .filter-action-group {
                width: 100% !important;
                display: flex !important;
                gap: 8px !important;
            }
            .filter-action-group .btn-compact-search,
            .filter-action-group .btn-compact-reset {
                flex: 1 !important;
                justify-content: center !important;
            }
            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_filter {
                float: none !important;
                display: block !important;
                width: 100% !important;
                text-align: left !important;
                margin-bottom: 6px !important;
            }
            .dataTables_wrapper .dataTables_filter label,
            .dataTables_wrapper .dataTables_length label {
                width: 100% !important;
                justify-content: space-between !important;
            }
            .dataTables_wrapper .dataTables_filter input {
                flex: 1 !important;
                width: auto !important;
            }
        }
    </style>

    @if (TempData["Message"] != null)
    {
        <script>
            $(document).ready(function () {
                var msg = '@TempData["Message"]';
                alert(msg);
            });
        </script>

    }
    @if (TempData["ErrMsgPromise"] != null)
    {
        <script>
            $(document).ready(function () {
                $("#modalPromise").modal('show');
            });
        </script>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <script>
            $(document).ready(function () {
                alert('@Html.Raw(ViewBag.ErrorMessage)')
            });
        </script>
    }
    <text>
        @{
            TempData["Message"] = null;
        }
    </text>
</head>
