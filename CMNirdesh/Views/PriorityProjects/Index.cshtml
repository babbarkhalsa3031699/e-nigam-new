@model CMNirdesh.Models.PriorityProject

@{
    ViewBag.Title = "PriorityProjects";
    var url = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"];
    var servicename = CMNirdesh.Models.CurrentSession.serviceName;
    var isapex = CMNirdesh.Models.CurrentSession.isApex;
}

<!DOCTYPE html>
<html>
<head>
    <link href="~/Content/style_ms.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/responsive_ms.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/common.css" rel="stylesheet" />    
    @if (TempData["Message"] != null)
    {
        <script>
            $(document).ready(function () {
                var msg = '@TempData["Message"]';
                alert(msg);
            });
        </script>

    }
    @if (TempData["ErrMsgPromise"] != null)
    {
        <script>
            $(document).ready(function () {
                $("#modalPromise").modal('show');
        </script>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <script>
            $(document).ready(function () {
                alert('@Html.Raw(ViewBag.ErrorMessage)')
            });
        </script>
    }
    <text>
        @{
            TempData["Message"] = null;
        }
    </text>
</head>
<body>

    <input type="hidden" name="hidden" value="2" id="hdnMCorLeg" />
    <div id="main-content">
        <section class="form_dsign">
            <div class="">
                <div class="widget-box" id="divAction">
                    <div class="widget-header widget-header-flat">
                        @if (servicename == "CMNirdesh" || isapex == "1")
                        {

                            if (Model.useractiontype == "Edit")
                            {
                                <h4>
                                    <span id="selectednew" class="">
                                        Project-Departments
                                    </span>
                                </h4>
                            }
                            else
                            {
                                <h4>
                                    <span id="selectednew" class="">
                                        Department-Works
                                    </span>
                                </h4>
                            }
                        }
                        else
                        {

                            if (Model.useractiontype == "Edit")
                            {
                                <h4>
                                    <span id="selectednew" class="">
                                        Project-Offices
                                    </span>
                                </h4>
                            }
                            else
                            {
                                <h4>
                                    <span id="selectednew" class="">
                                        Office-Works
                                    </span>
                                </h4>
                            }
                        }
                        <div class="widget-toolbar no-border">
                            @if ((isapex == "1" || Model.projectedityn == "Y") && Model.useractiontype == "Edit")
                            {
                                <button class="loader btn btn-sm btn-success" style="font-size:14px !important;" onclick="AddProjects('0');">
                                    <i class="ace-icon fa fa-pencil-square-o"></i>
                                    <span class="bigger-110">New Project</span>
                                </button>
                            }
                        </div>
                    </div>
                    @Html.Hidden("maintype", "0")
                    <input type="hidden" id="DepartmentId" value="@ViewBag.DeptID" />
                </div>
                <div class="col-md-12 col-xl-12 col-lg-12 no-right-margin filter-part position-relative ">
                    <div class="row">
                        @if (Model.useractiontype == "All")
                        {
                            <div class="col-lg-10">
                                <div class="row">
                                    <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 p-3 ">
                                        <div>
                                            <div class="form fc align-items-center gap-1">
                                                <span class="label-text">
                                                    <b> Project</b>
                                                </span>
                                                <div class="btn-group dropup">

                                                    <button onclick="ProjectCountD();" type="button" class=" dropdown-toggle link-option icon-refrence" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="far fa-briefcase"></i>
                                                    </button>

                                                    <div class="dropdown-menu popup-box p-0">

                                                        <div class="filter-popup" id="DispatchProjectCount">
                                                            <div class="table-responsive">
                                                                <table class="table " id="DispatchProjectTableCount" style="width:100%">
                                                                    <thead>
                                                                        <tr class="table-heading ">
                                                                            <th class='td-heading'>
                                                                                <b>Project </b>
                                                                            </th>
                                                                            <th class='td-heading'>Works</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody></tbody>
                                                                </table>


                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.DropDownListFor(model => model.PromiseId, Model.PromiseTypeList, "--Select--", new { @id = "ddlProject", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "2", @disabled = "true" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 p-3">
                                        <div>
                                            <div class="form fc align-items-center gap-1">
                                                <span class="label-text">
                                                    @if (servicename == "CMNirdesh")
                                                    {
                                                        <b>Department </b>
                                                    }
                                                    else
                                                    {
                                                        <b>Department/Office</b>
                                                    }
                                                </span>
                                                <div class="btn-group dropup">

                                                    <button onclick="DepartmentCountD();" type="button" class=" dropdown-toggle link-option icon-department" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="fas fa-building"></i>

                                                    </button>

                                                    <div class="dropdown-menu popup-box p-0">

                                                        <div class="filter-popup" id="DispatchOfficeCount">
                                                            <div class="table-responsive">
                                                                <table class="table " id="DispatchOfficeTableCount" style="width:100%">
                                                                    <thead>
                                                                        <tr class="table-heading ">
                                                                            <th class='td-heading'>
                                                                                <b>Department </b>
                                                                            </th>
                                                                            <th class='td-heading'>Works</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody></tbody>
                                                                </table>


                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.DropDownListFor(model => model.DeptId, Model.mDepartmentList, "--Select--", new { @id = "ddlDepartment", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "2" })
                                                @Html.DropDownListFor(model => model.OfficeId, Model.mOfficeList, "--Select--", new { @id = "ddlOffice", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "2", @style = "display:none" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 p-3">
                                        <div>
                                            <div class="form fc align-items-center gap-1">
                                                @if (servicename == "CMNirdesh")
                                                {
                                                    <span class="label-text">
                                                        <b>Constituency </b>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="label-text">
                                                        <b>MC Wards </b>
                                                    </span>
                                                }
                                                <div class="btn-group dropup">

                                                    <button onclick="WardCountD();" type="button" class=" dropdown-toggle link-option icon-office" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="fas fa-poll-people"></i>

                                                    </button>

                                                    <div class="dropdown-menu popup-box p-0">

                                                        <div class="filter-popup" id="DispatchWardCount">
                                                            <div class="table-responsive">
                                                                <table class="table " id="DispatchWardTableCount" style="width:100%">
                                                                    <thead>
                                                                        <tr class="table-heading ">
                                                                            <th class='td-heading'>
                                                                                @if (servicename == "CMNirdesh")
                                                                                {
                                                                                    <b>
                                                                                        Constituency
                                                                                    </b>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <b>
                                                                                        Ward
                                                                                    </b>
                                                                                }
                                                                            </th>
                                                                            <th class='td-heading'>Works</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody></tbody>
                                                                </table>


                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.DropDownListFor(model => model.ConstituencyId, Model.mProjectConstituencyList, "--Select--", new { @id = "ddlConstituency", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "2", @disabled = "true" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 p-3">
                                        <div>
                                            <div class="form fc align-items-center gap-1">
                                                <span class="label-text">
                                                    <b>Status </b>
                                                </span>
                                                <div class="btn-group dropup">

                                                    <button onclick="StatusCountD();" type="button" class=" dropdown-toggle link-option icon-status" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="fas fa-chart-line"></i>
                                                    </button>

                                                    <div class="dropdown-menu popup-box p-0">

                                                        <div class="filter-popup" id="DispatchStatusCount">
                                                            <div class="table-responsive">
                                                                <table class="table " id="DispatchStatusTableCount" style="width:100%">
                                                                    <thead>
                                                                        <tr class="table-heading ">
                                                                            <th class='td-heading'>Status</th>
                                                                            <th class='td-heading'>Works</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody></tbody>
                                                                </table>


                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                @Html.DropDownListFor(model => model.ProjectStatusId, Model.ProjectStatusTypeList, new { @id = "ddlStatus", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "11", @disabled = "true" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2">
                                <div class="row">
                                    <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 mt-3 pt-4">
                                        <div class="text-start d-flex gap-3 pt-4">
                                            <button class="loader btn btn-primary" id="searchbutton" onclick="searchData();"> Search</button>
                                            <button class="loader btn btn-success" id="resetbutton" style="display:block;" onclick="ResetD();"> Reset</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 p-3 ">
                                <div>
                                    <div class="form fc align-items-center gap-1">
                                        <span class="label-text">
                                            <b> Project</b>
                                        </span>
                                        <div class="btn-group dropup">

                                            <button onclick="ProjectOfcCountD();" type="button" class="inline dropdown-toggle link-option icon-refrence" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="far fa-briefcase"></i>

                                            </button>

                                            <div class="dropdown-menu popup-box p-0">

                                                <div class="filter-popup" id="DispatchProjectCount">
                                                    <div class="table-responsive">
                                                        <table class="table " id="DispatchProjectTableCount" style="width:100%">
                                                            <thead>
                                                                <tr class="table-heading ">
                                                                    <th class='td-heading'>
                                                                        <b>Project </b>
                                                                    </th>
                                                                    <th class='td-heading'>
                                                                        @if (isapex == "0" && servicename == "MC")
                                                                        {
                                                                            <b>Office</b>
                                                                        }
                                                                        else
                                                                        {
                                                                            <b>Department</b>
                                                                        }

                                                                    </th>
                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>


                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.DropDownListFor(model => model.PromiseId, Model.PromiseTypeList, "--Select--", new { @id = "ddlProject", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "2" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 p-3">
                                <div>
                                    <div class="form fc align-items-center gap-1 pt-1">
                                        <span class="label-text">
                                            @if (servicename == "CMNirdesh" || isapex == "1")
                                            {
                                                <b>Department </b>
                                            }
                                            else
                                            {
                                                <b>Office</b>
                                            }
                                        </span>
                                        <div class="btn-group dropup">

                                            <button onclick="OfficeCountD();" type="button" class=" dropdown-toggle link-option icon-department" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-building"></i>

                                            </button>

                                            <div class="dropdown-menu popup-box p-0">

                                                <div class="filter-popup" id="DispatchOfficeCount">
                                                    <div class="table-responsive">
                                                        <table class="table " id="DispatchOfficeTableCount" style="width:100%">
                                                            <thead>
                                                                <tr class="table-heading ">
                                                                    <th class='td-heading'>
                                                                        @if (servicename == "CMNirdesh" || isapex == "1")
                                                                        {
                                                                            <b>Department </b>
                                                                        }
                                                                        else
                                                                        {
                                                                            <b>Office</b>
                                                                        }
                                                                    </th>
                                                                    <th class='td-heading'>Projects</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>


                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.DropDownListFor(model => model.DeptId, Model.mDepartmentList, "--Select--", new { @id = "ddlDepartment", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "2" })
                                        @Html.DropDownListFor(model => model.OfficeId, Model.mOfficeList, "--Select--", new { @id = "ddlOffice", @class = "mt-1 width-100 form-control drop_txt", @tabindex = "2", @style = "display:none" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-lg-4 col-xl-3 col-sm-12 col-12 mt-4 pt-4">
                                <div class="text-start d-flex gap-3 pt-3">
                                    <button class="loader btn btn-primary" id="searchbutton" onclick="searchData();"> Search</button>
                                    <button class="loader btn btn-success" id="resetbutton" style="display:block;" onclick="ResetD();"> Reset</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-md-12 col-xl-12 cl-lg-12">
                    <div class="row">
                        <div class="col-md-12 col-xl-12 col-lg-12 mt-3" id="divOffficeSummaryBtn">
                            <div class="table-switch">
                                @if (Model.useractiontype == "Edit")
                                {
                                    if (servicename == "CMNirdesh" || isapex == "1")
                                    {
                                        <div>
                                            <input type="radio" id="rbtnProjectDeptStatus" name="radiobutton" value="rbtnProjectDeptStatus" checked="checked" onclick="loadProjectWiseDepartmentStatus();">
                                            <label for="status"><b>Project-Department Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                        <div>
                                            <input type="radio" id="rbtnDeptProjectStatus" name="radiobutton" value="rbtnDeptProjectStatus" onclick="loadDepartmentWiseProjectStatus();">
                                            <label for="status"><b>Department-Project Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <input type="radio" id="rbtnProjectDeptStatus" name="radiobutton" value="rbtnProjectDeptStatus" checked="checked" onclick="loadProjectWiseDepartmentStatus();">
                                            <label for="status"><b>Project-Office Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                        <div>
                                            <input type="radio" id="rbtnDeptProjectStatus" name="radiobutton" value="rbtnDeptProjectStatus" onclick="loadDepartmentWiseProjectStatus();">
                                            <label for="status"><b>Office-Project Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                    }
                                }
                                @if (Model.useractiontype == "All")
                                {
                                    if (servicename == "CMNirdesh" || isapex == "1")
                                    {
                                        <div>
                                            <input type="radio" id="rbtnDeptWiseProjectWorkStatus" name="radiobutton" checked="checked" value="rbtnDeptWiseProjectWorkStatus" onclick="loadDeptWiseProjectWorkStatus(0);">
                                            <label for="status"><b>Department-Project-Work Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                        <div>
                                            <input type="radio" id="rbtnProjectWiseDeptWorkStatus" name="radiobutton" value="rbtnProjectWiseDeptWorkStatus" onclick="loadProjectDeptWiseWorkStatus();">
                                            <label for="status"><b>Project-Department-Work Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <input type="radio" id="rbtnDeptWiseProjectWorkStatus" name="radiobutton" checked="checked" value="rbtnDeptWiseProjectWorkStatus" onclick="loadDeptWiseProjectWorkStatus(0);">
                                            <label for="status"><b>Office-Project-Work Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                        <div>
                                            <input type="radio" id="rbtnProjectWiseDeptWorkStatus" name="radiobutton" value="rbtnProjectWiseDeptWorkStatus" onclick="loadProjectDeptWiseWorkStatus();">
                                            <label for="status"><b>Project-Office-Work Status Summary</b></label>&nbsp;&nbsp;
                                        </div>
                                    }
                                }
                                <div>
                                    <input type="radio" id="rbtnList" name="radiobutton" value="rbtnList" onclick="loadProjects();">
                                    <label for="list"><b>List (View/Update)</b></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form_lyot table-responsive">
                    @if (Model != null)
                    {
                        <div id="divProjectDeptName" style="display:none">
                            <label for="inputinfo" class="control-label lbl_txt width-100" style="font-size: 13pt;">
                                <b>Department: </b><span id="ddlProjectDeptName"></span>
                                <a id="btnBackStatus" onclick="loadlist();" class="loader btn btn-sm btn-danger float-right"><i class="fa fa-arrow-left"></i> Back</a>
                            </label>
                        </div>
                        <div id="divtableProjects">
                            <table id="tableProjects" class="table table-hover table-bordered width-100" style="vertical-align:top">
                            </table>
                        </div>
                        <div id="divProjectWorksStatus" class="mt-2">
                        </div>
                        <input type="hidden" id="hdnSelectedDeptID" />
                        <input type="hidden" id="hdnSelectedCurrDeptID" />
                        <input type="hidden" id="hdnStepNo" />
                        <input type="hidden" id="hdnSelectedProjectid" />
                        <input type="hidden" id="hdnSelectedStatusid" />
                    }

                </div>
            </div>


            <div id="modalPromise" class="modal" style="background: rgb(54 55 56 / 63%);" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="projectSaveHead">New Project</h5>
                            <button type="button" class="btn-close" onclick="closePopup();" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="modalPromiseBody">

                        </div>
                    </div>
                </div>
            </div>
            <div id="modalDepartment" class="modal" style="background: rgb(54 55 56 / 63%);" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog modal-xxl">
                    <div class="modal-content" id="modalDepartmentBody">


                    </div>
                </div>

            </div>
            <div id="modalWorks" class="modal pr-0" style="background: rgb(54 55 56 / 63%);" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog modal-fullscreen modal-dialog-centered modal-xxl">
                    <div class="modal-content" id="modalWorksBody">
                    </div>
                </div>
            </div>
            <!-- The Modal -->
            <div id="myImgModal" class="modalnew">
                <span class="close closenew" onclick="closeImgPopup();">&times;</span>

                <img class="modalnew-content" id="img01">
                <div id="caption"></div>
            </div>
            <div id="modalImages" class="modal pr-0" style="background: rgb(54 55 56 / 63%);" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog modal-dialog-centered modal-xxl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Upload Image</h5>
                            <button type="button" class="btn-close" onclick="closePopup();" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="modalImagesbody" style="overflow:auto;">

                        </div>
                    </div>
                </div>
            </div>
            <div id="modalAddDocument" class="modal pr-0" data-keyboard="false" data-backdrop="static" style="background: rgb(54 55 56 / 63%);">
                <div class="modal-dialog modal-dialog-centered modal-xxl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Upload Document</h5>

                            <button type="button" class="btn-close" onclick="closePopup();" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="modalAddDocumentBody">

                        </div>
                    </div>
                </div>
            </div>
            <div id="modalAddConstituency" class="modal pr-0" style="background: rgb(54 55 56 / 63%);" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog modal-dialog-centered modal-xxl">
                    <div class="modal-content">

                        <div class="modal-header">
                            @if (servicename == "CMNirdesh")
                            {
                                <h5 class="modal-title">Update Constituency</h5>
                            }
                            else
                            {
                                <h5 class="modal-title">Update Ward</h5>
                            }

                            <button type="button" class="btn-close" onclick="closePopup();" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="modalAddConstituencyBody">

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal" id="modalsuccess">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <!-- Modal body -->
                        <div class="modal-body mt-4">
                            <span id="successmsg"></span>
                            <div class="row text-right float-right mt-3 p-3">
                                <button type="button" class="loader btn btn-danger" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div id="mpProjectList" class="modal pr-0" style="background: rgb(54 55 56 / 63%);z-index:111" data-keyboard="false" data-backdrop="static">
                <div class="modal-dialog modal-fullscreen modal-dialog-centered modal-xxl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="widget-title modal_heading">Projects List</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeImgPopup();"></button>

                        </div>
                        <div class="modal-body modal-dialog-scrollable">
                            <div class="table-responsive" style="margin-top: 20px; height:auto;">
                                <table id="tableProjectList" class="table table-hover table-bordered w-100 width-100" style="vertical-align:top">
                                    <thead>
                                        <tr class="table-heading">
                                            <td class="td-heading" style="width:70px">Project ID</td>
                                            <td class="td-heading">Project Name</td>
                                            @if (servicename == "CMNirdesh")
                                            {
                                                <td class="center td-heading">
                                                    Department
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="center td-heading">
                                                    Office
                                                </td>
                                            }
                                            <td class="td-heading">Work ID</td>
                                            <td class="td-heading">
                                                Works Name<br />
                                                (Components)
                                            </td>
                                            @if (servicename == "CMNirdesh")
                                            {
                                                <td class="center td-heading">Constituency</td>
                                            }
                                            else
                                            {
                                                <td class="center td-heading">MC Wards</td>
                                            }
