    function getProjectConstituency() {
        var pathurl = '/PriorityProjects/GetProjectConstituency';
        $("#ConstituencyList").empty();
        $.ajax({
            url: pathurl,
            type: 'GET',
            data: {},
            async: true,
            success: function (result) {
                var html = "";
                if (result.length > 0) {
                    for (var i = 0; i < result.length; i++) {
                        var item = result[i];

                        html = html + "<li><a value='" + item.ConstituencyId + "'> " + item.ConstituencyName + "</a></li>";

                    }
                    $("#ConstituencyList").html(html);
                    $("#loader-wrapper").hide();
                }

                else {
                    $("#ConstituencyList").html("No Data Found");
                    $("#loader-wrapper").hide();
                }
            },
            error: function (result) {
                $("#loader-wrapper").hide();
            }
        });
    }

    function skip() {
        $('#PPpopup').css('display', 'none');

    }
</script>

