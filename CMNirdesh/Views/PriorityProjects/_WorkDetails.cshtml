@model CMNirdesh.Models.PriorityProject

@{
    ViewBag.Title = "PriorityProjects";
    var url = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"];
}
<div class="modal-header">
    <h5 class="modal-title">
        <b>Project: </b>@Model.PromiseName <br />
        @if (CMNirdesh.Models.CurrentSession.serviceName == "CMNirdesh")
        {
            <b>Department: </b>
        }
        else
        {
            <b>Office: </b>
        }
        @Model.DeptName
    </h5>
    <button type="button" class="btn-close" id="closework" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body" style="overflow: auto; height: 600px ">
    <div class="row" id="divWorkDetails">
        <div class="col-md-9">
            <div class="row mrgn_tp mt-2">
                <div class="col-md-12">
                    <label for="inputinfo" class="control-label lbl_txt" style="font-size: 11pt;">
                        <b>Work Name:</b> @Model.worksdatalist.ProjectName
                    </label>
                </div>
                <div class="col-md-12">
                    <label for="inputinfo" class="control-label lbl_txt" style="font-size: 11pt;">
                        <b>Work Description:</b> @Html.Raw(Model.worksdatalist.Remark)
                    </label>
                </div>
                <div class="col-md-12">
                    <label for="inputinfo" class="control-label lbl_txt" style="font-size: 11pt;">
                        <b>Resolution No:</b> @Html.Raw(Model.worksdatalist.Resolution)
                    </label>
                </div>
                @Html.Hidden("hdnCurrentModule", CMNirdesh.Models.CurrentSession.CurrentModule)
            </div>
            @if (Model.worksdatalist.ProjectName == null)
            {
                <div class="row mrgn_tp mt-2">
                    <div class="col-md-12 mt-5 pt-5 text-center">
                        <h4 style="font-size: 30pt; color: #dbd7d7; font-weight: bolder;">
                            Work Details Not Added For This Project<br />
                            Click On Add New Work Button To Add Work Details
                        </h4>
                    </div>
                </div>
            }
            else
            {
                <div class="row mrgn_tp mt-2">
                    <div class="col-md-12">
                        <label for="inputinfo" class="control-label lbl_txt" style="font-size: 11pt;">
                            <b>Details:</b>
                        </label>
                        <table class="table table-bordered table-responsive">
                            <thead>
                                <tr>
                                    <td>Implementing Agency/Firm</td>
                                    <td>Category</td>
                                    <td>Estimated Amount <br />(In Lakh)</td>
                                    <td>Revised Estimated Amount <br />(In Lakh)</td>
                                    <td>Funds Released Till Date <br />(In Lakh)</td>
                                    <td>Expenditure Till Date <br />(In Lakh)</td>
                                    <td>Physical Progress(%)</td>
                                    <td>Start Date</td>
                                    <td>End Date</td>
                                    <td>Status</td>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@Model.worksdatalist.FirmName</td>
                                    <td>@Model.worksdatalist.CategoryName</td>
                                    <td>@Model.worksdatalist.EstimatedAmount</td>
                                    <td>@Model.worksdatalist.RevisedEstimatedAmount</td>
                                    <td>@Model.worksdatalist.FundReleased</td>
                                    <td>@Model.worksdatalist.Expenditure</td>
                                    <td>@Model.worksdatalist.PhysicalProgress</td>
                                    <td>@Model.worksdatalist.SStartDate</td>
                                    <td>@Model.worksdatalist.SEndDate</td>
                                    <td>@Model.worksdatalist.ProjectStatusName</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-lg-12">
                        <label for="inputinfo" class="control-label lbl_txt" style="font-size: 11pt;">
                            <b>Work Related Images</b>
                            @Html.HiddenFor(model => model.worksdatalist.ProjectId, new { @Id = "hdnWorkId" })
                            @Html.HiddenFor(model => model.worksdatalist.PromiseId, new { @Id = "hdnWorkProjectId" })
                            @Html.HiddenFor(model => model.worksdatalist.DeptId, new { @Id = "hdnWorkDeptId" })
                            @if ((Model.workedityn == "Y" || CMNirdesh.Models.CurrentSession.isApex == "0") && CMNirdesh.Models.CurrentSession.CurrentModule != "View")
                            {
                                <a id="btnUploadImages2" class="loader blue tooltip-primary" onclick="loadImagesPopup();">
                                    <i class="fa fa-plus-square"></i>
                                </a>
                            }
                        </label>
                        <div id="imgcarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner" role="listbox" id="imgcarouselBody"></div>
                        </div>
                        <div id="imgcarouselBtn">

                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-3">
            <div class="row">
                <div class="col-lg-12" id="divButtons">
                    @*<a class="no-print loader btn btn-sm btn-danger" onclick="printPage()" style="font-size:14px !important;float:right;" title="Print Page"><i class="fas fa-print"></i></a>*@
                    @if ((Model.workedityn == "Y" || CMNirdesh.Models.CurrentSession.isApex == "0") && CMNirdesh.Models.CurrentSession.CurrentModule != "View")
                    {
                        if (@Model.worksdatalist.ProjectName != null)
                        {
                            <a class="loader btn btn-sm btn-primary mr-2 no-print" style=" font-size:14px !important;float:right" onclick="editProjectWork(@Model.PromiseId,'@Model.DeptId',@Model.ProjectId);">
                                <i class="ace-icon fa fa-pencil-square-o"></i>
                                <span class="bigger-110">Edit Work</span>
                            </a>
                        }
                        <a class="loader btn btn-sm btn-success mr-2 no-print" style=" font-size: 14px !important; float: right;display:none" onclick="AddWorkDetails(@Model.PromiseId,'@Model.DeptId');">
                            <i class="fa fa-plus"></i>
                            <span class="bigger-110">Add New Work</span>
                        </a>
                    }
                </div>
                <div class="col-lg-12">
                    <div class="card inr_frm_dsgn">
                        <div class="card-header p-2">
                            <h4 style="font-size: 12pt;display:inline" class="mb-0">Documents</h4>
                            @Html.HiddenFor(model => model.worksdatalist.ProjectId, new { @Id = "hdnDocWorkId" })
                            @if ((Model.workedityn == "Y" || CMNirdesh.Models.CurrentSession.isApex == "0") && CMNirdesh.Models.CurrentSession.CurrentModule != "View" && @Model.worksdatalist.ProjectName != null)
                            {
                                <a class="loader blue tooltip-primary" id="btnUploadDocument" onclick="loadWorkDocuments(@Model.PromiseId,'@Model.DeptId',@Model.worksdatalist.ProjectId);">
                                    <i class="fa fa-plus-square"></i>
                                </a>
                            }
                        </div>
                        <div class="card-body" style="height: 250px; overflow-y: auto;">
                            <ul id="documentsList">
                            </ul>
                        </div>
                    </div>
                    <div class="card inr_frm_dsgn mt-2">
                        <div class="card-header p-2">
                            @if (CMNirdesh.Models.CurrentSession.serviceName == "CMNirdesh")
                            {
                                <h4 style="font-size: 12pt;display:inline" class="mb-0">Constituencies</h4>
                            }
                            else
                            {
                                <h4 style="font-size: 12pt;display:inline" class="mb-0">MC Wards</h4>
                            }
                            @Html.HiddenFor(model => model.worksdatalist.ProjectId, new { @Id = "hdnConstWorkId" })
                            @Html.HiddenFor(model => model.worksdatalist.PromiseId, new { @Id = "hdnConstProjectId" })
                            @Html.HiddenFor(model => model.worksdatalist.DeptId, new { @Id = "hdnConstDeptId" })
                            @if ((Model.workedityn == "Y" || CMNirdesh.Models.CurrentSession.isApex == "0") && CMNirdesh.Models.CurrentSession.CurrentModule != "View" && @Model.worksdatalist.ProjectName != null)
                            {
                                <a class="loader blue tooltip-primary" id="btnAddConstituency" onclick="loadWorkConstituencies(@Model.PromiseId,'@Model.DeptId',@Model.worksdatalist.ProjectId);">
                                    <i class="fa fa-plus-square"></i>
                                </a>
                            }
                        </div>
                        <div class="card-body" style="height: 250px; overflow-y: auto;">
                            <ul id="constituencyList">
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if ((Model.workedityn == "Y" || CMNirdesh.Models.CurrentSession.isApex == "0") && CMNirdesh.Models.CurrentSession.CurrentModule != "View")
    {
        <div class="row" id="divAddWork" style="display:none">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-6">
                        <h5 id="headAddWork" class="modal-category pb-2">Add Work Basic Details</h5>
                    </div>
                    <div class="col-6 float-right" style="display:none">
                        <a class="loader btn btn-sm btn-danger no-print" style="font-size:14px;float:right" href="@Url.Action("ViewProjectWorks", "PriorityProjects", new { ProjectId = CMNirdesh.Models.EncryptionUtility.Encrypt(Model.PromiseId.ToString()), deptID = CMNirdesh.Models.EncryptionUtility.Encrypt(Model.DeptId.ToString()), workID = Model.ProjectId.ToString() })">
                            <i class="ace-icon fa fa-pencil-square-o bigger-150"></i>
                            <span class="bigger-110">View Work Details</span>
                        </a>

                        <a class="loader btn btn-sm btn-success mr-2 no-print" style="font-size:14px;float:right" onclick="AddWorkDetails(@Model.PromiseId,'@Model.DeptId');">
                            <i class="fa fa-plus bigger-150"></i>
                            <span class="bigger-110">Add New Work</span>
                        </a>
                    </div>
                    <div class="col-12">
                        @using (Html.BeginForm("SavePriorityProjectWork", "PriorityProjects", FormMethod.Post, new { @class = "form-horizontal", @role = "form", @id = "PriorityProjectWorks", enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken() @Html.HiddenFor(model => model.PromiseId) @Html.HiddenFor(model => model.DeptId) @Html.HiddenFor(model => model.worksdatalist.PromiseId) @Html.HiddenFor(model => model.worksdatalist.ProjectId) @Html.HiddenFor(model => model.worksdatalist.mode) @Html.HiddenFor(model => model.worksdatalist.DeptId) <div>
                                <div class="row">
                                    <div class="col-md-3">
                                        <label for="inputinfo" class="control-label lbl_txt">Resolution Type </label>
                                        @Html.DropDownListFor(model => model.worksdatalist.ResolutionOfcType, Model.ResolutionOfcTypeList, new { @id = "ddlResolutionType", @class = "txt_design", @tabindex = "0" })
                                    </div>
                                    <div class="col-md-6">
                                        <label for="inputinfo" class="control-label lbl_txt">Resolution No. </label>
                                        <select class="txt_design" id="ddlResolutionNo" name="ResolutionNo"></select>
                                        @Html.HiddenFor(model => model.worksdatalist.ResolutioNo, new { @id = "resolutionNo" })
                                        @*@Html.DropDownListFor(model => model.worksdatalist.ResolutioNo, Model.ResolutionList, "Select", new { @id = "ddlResolutionNo", @class = "txt_design", @tabindex = "0" })*@
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <label for="inputinfo" class="control-label lbl_txt">Work Name:  </label>

                                        @Html.TextAreaFor(model => model.worksdatalist.ProjectName, new { @id = "txtWorkName", @placeholder = "Enter Work Name", @autocomplete = "off", @class = "width-100 form-control txt_with", @tabindex = "1", @rows = 3 })

                                        @Html.ValidationMessageFor(model => model.worksdatalist.ProjectName)
                                    </div>
                                </div>
                                <div class="row mrgn_tp mt-2">
                                    <div class="col-md-6">
                                        <label for="inputinfo" class="control-label lbl_txt"> Category </label>

                                        @Html.DropDownListFor(model => model.worksdatalist.CategoryId, Model.CategoryTypeList, new { @id = "ddlworkCategory", @class = "width-100 form-control drop_txt", @tabindex = "2" })
                                    </div>
                                    <div class="col-md-6">
                                        <label for="inputinfo" class="control-label lbl_txt">Firm Name </label>

                                        @Html.TextBoxFor(model => model.worksdatalist.FirmName, new { @id = "txtFirmName", @placeholder = "Enter Firm Name", @autocomplete = "off", @class = "width-100 form-control txt_with", @tabindex = "3" })

                                        @Html.ValidationMessageFor(model => model.worksdatalist.FirmName)
                                    </div>
                                </div>
                                <div class="row mrgn_tp mt-2">
                                    <div class="col-md-3">
                                        <label for="inputinfo" class="control-label lbl_txt">Estimated Amount<b style="color:red">  &nbsp; (in lakhs)</b> </label>

                                        @Html.TextBoxFor(model => model.worksdatalist.EstimatedAmount, new { @id = "txtEstimatedAmount", @placeholder = "Enter Estimated Amount", @autocomplete = "off", @class = "width-100 form-control txt_with", @tabindex = "4" })

                                        @Html.ValidationMessageFor(model => model.worksdatalist.EstimatedAmount)
                                    </div>
                                    <div class="col-md-3">
                                        <label for="inputinfo" class="control-label lbl_txt">Revised Estimated Amount<b style="color:red">  &nbsp; (in lakhs)</b></label>

                                        @Html.TextBoxFor(model => model.worksdatalist.RevisedEstimatedAmount, new { @id = "txtRevisedEstimatedAmount", @placeholder = "Enter Revised Estimated Amount", @autocomplete = "off", @class = "width-100 form-control txt_with", @tabindex = "5" })

                                        @Html.ValidationMessageFor(model => model.worksdatalist.RevisedEstimatedAmount)
                                    </div>
                                    <div class="col-md-3">
                                        <label for="inputinfo" class="control-label lbl_txt">Start Date</label>

                                        @Html.TextBoxFor(model => model.worksdatalist.SStartDate, "{0:dd/MM/yyyy}", new { @Id = "txtstartDate", @placeholder = "DD/MM/YYYY", @type = "text", @class = "form-control datepicker", @tabindex = "6", @autocomplete = "off" })
                                        @Html.HiddenFor(model => model.worksdatalist.SStartDate, new { @Id = "startDate" })
                                    </div>
                                    <div class="col-md-3">
                                        <label for="inputinfo" class="control-label lbl_txt">End Date </label>
                                        @Html.TextBoxFor(model => model.worksdatalist.SEndDate, "{0:dd/MM/yyyy}", new { @Id = "txtendDate", @placeholder = "DD/MM/YYYY", @type = "text", @class = "form-control datepicker", @tabindex = "7", @autocomplete = "off" })
                                    </div>
                                </div>
                                <div id="divEditDetails" style="display:block">
                                    <div class="row mrgn_tp mt-2">
                                        <div class="col-md-3">
                                            <label for="inputinfo" class="control-label lbl_txt"> Fund Released <b style="color:red"> &nbsp; (in lakhs)</b> </label>
                                            @Html.TextBoxFor(model => model.worksdatalist.FundReleased, new { @id = "FundReleased", @placeholder = "Enter Released Fund Amount", @autocomplete = "off", @class = "width-100 form-control txt_with", @tabindex = "8" })
                                        </div>

                                        <div class="col-md-3">
                                            <label for="inputinfo" class="control-label lbl_txt"> Expenditure Amount <b style="color:red">  &nbsp; (in lakhs)</b> </label>
                                            @Html.TextBoxFor(model => model.worksdatalist.Expenditure, new { @id = "Expenditure", @placeholder = "Enter Expenditure Amount", @autocomplete = "off", @class = "width-100 form-control txt_with", @tabindex = "9" })

                                        </div>

                                        <div class="col-md-3">
                                            <label for="inputinfo" class="control-label lbl_txt"> Physical Progress <b style="color:red">  &nbsp; (in %)</b> </label>
                                            @Html.TextBoxFor(model => model.worksdatalist.PhysicalProgress, new { @id = "PhysicalProgress", @placeholder = "Enter Physical Progress", @autocomplete = "off", @class = "width-100 form-control txt_with", @tabindex = "10" })
                                        </div>

                                        <div class="col-md-3">
                                            <label for="inputinfo" class="control-label lbl_txt"> Work Status </label>
                                            @Html.DropDownListFor(model => model.worksdatalist.ProjectStatusId, Model.ProjectStatusTypeList, new { @id = "ddlWorkStatus", @class = "width-100 form-control drop_txt", @tabindex = "11" })
                                        </div>
                                    </div>
                                    @*<div class="row mrgn_tp mt-2">
                                            <div class="col-md-3">
                                                <label for="inputinfo" class="control-label lbl_txt"> Status </label>
                                                @Html.DropDownListFor(model => model.worksdatalist.isActive, Model.StatusTypeList, new { @class = "width-100 form-control drop_txt", @tabindex = "12" })
                                            </div>
                                        </div>*@
                                </div>
                                @*<div class="row mrgn_tp mt-2">
                                        <div class="col-md-3">
                                            <label for="inputinfo" class="control-label lbl_txt"> Constituency </label>
                                            @Html.DropDownListFor(model => model.mWorkConstituencyList, new SelectList(Model.mProjectConstituencyList, "Value", "Text"), new { @id = "ddlConstituencyId", @class = "form-control width-100", @style = "height:30px", @tabindex = "3", @multiple = "multiple" })
                                            @Html.ValidationMessageFor(model => model.ConstituencyId)
                                            @Html.HiddenFor(m => m.cdid, new { @id = "cdid" })
                                        </div>
                                    </div>*@
                                <div class="row mrgn_tp mt-2">
                                    <div class="col-md-12">
                                        <label for="inputinfo" class="control-label lbl_txt">Work Description </label>

                                        <div class="wysiwyg-editor wysiwyg-style2 dtl_l_box" id="editor-eng"></div>

                                        @Html.TextAreaFor(model => model.worksdatalist.Remark, new { @id = "Remark", @class = "hide form-control", @placeholder = "Description", @autocomplete = "off", @tabindex = "13" })
                                        <div class="help-block col-xs-12 col-sm-reset inline">
                                            @Html.ValidationMessageFor(model => model.worksdatalist.Remark)
                                        </div>
                                    </div>
                                </div>
                                <div class="row mrgn_tp pt-3">
                                    <div class="col-md-12">
                                        <div class="pull-right c_btn">
                                            <button id="saveWorkbtn" class="loader btn btn-sm btn-success" onclick="SaveWorkDetails();return false;">
                                                <i class="ace-icon fa fa-floppy-o bigger-125"></i>
                                                Save
                                            </button>
                                            <button type="reset" class="loader btn btn-sm btn-danger" onclick="resetFields();">
                                                <i class="ace-icon fa fa-times bigger-125"></i>
                                                Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<link href="~/Scripts/MultiSelectBox/multi-select.min.css" rel="stylesheet" />
<link href="~/Content/multiple-select.css" rel="stylesheet" />
<script src="~/Scripts/MultiSelectBox/multi-select.min.js"></script>
<script src="~/Scripts/tinymce/tinymce.min.js"></script>
<script>
    $("#closework").on("click", function () {
        $("#modalWorks").hide();
    });
    function loadImagesPopup() {
        $("#loader-wrapper").show();
        var workID = $('#hdnConstWorkId').val();
        var ProjectId = $('#hdnConstProjectId').val();
        var DeptId = $('#hdnConstDeptId').val();
        var path = $('#hdnPath').val();
        $('#modalImagesbody').html('');
        $.ajax({
            type: "GET",
            url: '@Url.Action("openImageView", "PriorityProjects")',
            async: true,
            data: { ProjectId: ProjectId, DeptId: DeptId, workID: workID, path: path },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                // //debugger;
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();

                if (data) {
                    $("#modalImages").css("display", "block");
                    $('#modalImagesbody').html(data);
                    loadImages();
                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
                $("#loader-wrapper").hide();
            },
            complete: function (results) {
                $('#loader-wrapper').hide();

            }
        });
    }
    function loadWorkConstituencies(ProjectId, DeptId, workID) {
        $('#modalAddConstituencyBody').html('');
        $("#loader-wrapper").show();
        $.ajax({
            type: "GET",
            url: '@Url.Action("ViewConstituencies", "PriorityProjects")',
            async: true,
            data: { ProjectId: ProjectId, deptID: DeptId, workID: workID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();

                if (data) {
                    $("#modalAddConstituency").css("display", "block");
                    $('#modalAddConstituencyBody').html(data);
                    loadConstituency();
                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
                $("#loader-wrapper").hide();
            },
            complete: function (results) {
                $('#loader-wrapper').hide();

            }
        });
    }
    function loadWorkDocuments(ProjectId, DeptId, workID) {
        $('#modalAddDocumentBody').html('');
        $("#loader-wrapper").show();
        $.ajax({
            type: "GET",
            url: '@Url.Action("ViewDocuments", "PriorityProjects")',
            async: true,
            data: { promiseid: ProjectId, deptID: DeptId, workID: workID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();

                if (data) {
                    $("#modalAddDocument").css("display", "block");
                    $('#modalAddDocumentBody').html(data);
                    loadDocuments();
                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
                $("#loader-wrapper").hide();
            },
            complete: function (results) {
                $('#loader-wrapper').hide();

            }
        });
    }
    function loadConstituency() {
        $("#loader-wrapper").show();
        var workID = $('#hdnConstWorkId').val();
        var ProjectId = $('#hdnConstProjectId').val();
        var DeptId = $('#hdnConstDeptId').val();
        var html = '';
        $.ajax({
            type: 'GET',
            url: '@Url.Action("getProjectConstituency", "PriorityProjects")',
            data: { workId: workID },
            success: function (data) {
                if (data.length > 0) {
                    $.each(data, function (i, item) {
                        html += "<tr role='row'><td> <span>" + item.Text + "</span </td><td><a class='loader text-danger mr-1' style='font-size: 10pt; padding: 2px 5px;' title='Delete' id='btnDeletConst' href='/PriorityProjects/DeleteProjectConstituency?ProjectId=" + ProjectId + "&deptID=" + DeptId + "&workID=" + workID + "&contituencyId=" + item.Value + "'><i class='fa fa-times'></i></a></td></tr >";

                        $('#tbodyWorkConstituency').append(html);
                    });
                }
                else {
                    html = "<tr role='row'><td colspan='2'>" +
                        "No Record Available" +
                        "</td>'</tr > ";
                    $('#tbodyWorkConstituency').append(html);
                }
                closePopup();
                $("#modalWorks").modal('show');
                $("#modalAddConstituency").modal('show');
                $("#loader-wrapper").hide();
            },
            error: function () {
                html = "<tr role='row'><td colspan='2'>" +
                    "No Record Available" +
                    "</td>'</tr > ";
                $('#tbodyWorkConstituency').append(html);
                $("#loader-wrapper").hide();
            }
        });
    }
    function loadDocuments() {
        $("#loader-wrapper").show();
        var workID = $('#hdnDocWorkId').val();
        var html = '';
        $.ajax({
            type: 'GET',
            url: '@Url.Action("getWorkDocuments", "PriorityProjects")',
            data: { workId: workID },
            success: function (data) {
                $('#tblDocuments').html('');
                if (data.length > 0) {
                    $.each(data, function (i, item) {
                        html = "<tr><td>" +
                            "<a class='loader' href='@url/mlaDiary/" + item.DocumentLocation + "' target='_blank'>" + item.DocumentTitle + "</a>" +
                            "</td><td style='padding-left: 10px;'>" +
