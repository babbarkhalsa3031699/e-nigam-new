<script>
    function SaveWorkDetails() {
        try {
            var engdata = tinymce.activeEditor.getContent();
            $("#Remark").val(engdata);

            var workName = $("#txtWorkName").val();
            var startDate = $("#txtstartDate").val();
            var endDate = $("#txtendDate").val();
            var workCategory = $("#ddlworkCategory").val();
            var status = $("#ddlWorkStatus").val();
            if (workName === '') {
                alert("Enter Work Name");
                return;
            }
            if (workCategory === '') {
                alert("Select Work Category");
                return;
            }
            if (status === '') {
                alert("Select Work Status");
                return;
            }
            if (startDate === '') {
                alert("Enter Start Date");
                return;
            }
            if (confirm("Are you sure you want to save ?")) {
                $("#loader-wrapper").show();
                var action = $("#PriorityProjectWorks").attr("action");
                if ($("#PriorityProjectWorks").attr("enctype") == "multipart/form-data") {
                    var dataString = new FormData($("#PriorityProjectWorks").get(0));
                    processData = false;
                }
                $.ajax({
                    type: "POST",
                    url: action,
                    async: true,
                    data: dataString,
                    dataType: "json", //change to your own, else read my note above on enabling the JsonValueProviderFactory in MVC
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        console.log("data" + data);
                        $("#loader-wrapper").hide();
                        if (data == "1") {
                            var stepno = $("#hdnStepNo").val();
                            if (stepno == "1") {
                                loadProjects();
                            }
                            else {
                                var CurrDeptID = $('#hdnSelectedCurrDeptID').val();
                                var deptId = $('#hdnSelectedDeptID').val();
                                var projectId = $('#hdnSelectedProjectid').val();
                                var statusId = $('#hdnSelectedStatusid').val();
                                if (stepno == "2") {
                                    loadDeptWiseProjectWorkStatus(projectId);
                                }
                                else if (stepno == "3") {
                                    loadDeptOfficeProjectStatus(projectId, CurrDeptID);
                                }
                                else if (stepno == "4") {
                                    loadProjectWiseWorkStatus(CurrDeptID, deptId);
                                }
                                else if (stepno == "5") {
                                    loadProjectDeptWiseWorkStatus();
                                }
                                else if (stepno == "6") {
                                    loadProjectDeptworkStatus(projectId);
                                }
                                getSummaryProjectsList(CurrDeptID, projectId, deptId, statusId);
                            }
                            $('#modalWorks').hide();
                            alert("Work Details Saved successfully");
                            return false;
                        }
                        else {
                            $('#modalWorks').modal({ backdrop: 'static', keyboard: false }, 'show');
                            alert("Some error occurred,please try again");
                            return false;
                            e.preventDefault();
                        }
                        $("#loader-wrapper").hide();
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        $("#loader-wrapper").hide();
                        $('#modalWorks').modal({ backdrop: 'static', keyboard: false }, 'show');
                        alert("Some error occurred,please try again" + errorThrown);
                    },
                });
            }
        }
        catch (ex) {
            alert("Some error occurred,please try again" + ex.message);
            window.location.reload(true);
        }
    }
