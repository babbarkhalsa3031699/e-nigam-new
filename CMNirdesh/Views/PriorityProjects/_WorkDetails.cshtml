    });
    function adjustCarouselSize() {
        var container = $('#imgcarousel');
        var itemWidth = $('.carousel-item').outerWidth(true);
        var numItems = $('.carousel-item').length;

        if (numItems === 1) {
            container.width(itemWidth);
        } else {
            container.width(itemWidth * numItems);
        }
    }
