        <section class="form_dsign">
            <div class="container-fluid">
                  <div class="inr_frm_dsgn">
                            <div class="Tab_hdr p-2" style="display:flex;">
                                <div class="col-md-6">
                                    <h2>Project List</h2>
                                </div>
                                <div class="col-md-6 text-right txt_rit">
                                    <button style="font-size:14px;" class="btn  btn-sm btn-primary" onclick="javascript:window.location.href='/PriorityProjects/CreatePriorityProject';">
