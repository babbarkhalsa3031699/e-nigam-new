                                    </button>
                                </div>

                            </div>
                            <div class="form_lyot">

                                @if (Model != null)
                                {
                                    if (Model.Count() > 0)
                                    {
                                        <div class="tab_parent table-responsive table_rsponsv">
                                            <table id="example" class="table table-hover table-bordered ">
                                                <thead>
                                                    <tr class="table-heading">
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Sr No.</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Promise Name</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Project Name</span></th>
                                                        <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Firm Name</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Category Name</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Date</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Status</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                                        @*<th class="td-heading">Add</th>*@
                                                    </tr>
                                                </thead>
                                                <tbody role="alert" aria-live="polite" aria-relevant="all">
                                                    @foreach (var item in Model)
                                                    {
                                                        count = count + 1;

                                                        <tr>
                                                            <td class="center td-data" style="font-size:13px; padding: 14px 4px !important">
                                                                @count
                                                            </td>
                                                            <td class="center td-data" style="font-size:13px; padding: 14px 4px !important">
                                                                @item.PromiseName
                                                            </td>

                                                            <td class="center td-data" style="font-size:13px; padding: 14px 4px !important">
                                                                @item.ProjectName
                                                            </td>



                                                            <td class="center td-data" style="font-size:13px; padding: 14px 4px !important">@item.FirmName</td>
                                                            <td class="center td-data" style="font-size:13px; padding: 14px 4px !important">@item.CategoryName</td>
                                                            <td class="center td-data" style="font-size:13px; padding: 14px 4px !important">@item.StartDate.ToString("dd/MM/yyyy") To @item.EndDate.ToString("dd/MM/yyyy") </td>

                                                            <td class="hidden-480 center td-data " style="font-size:13px; padding: 14px 4px !important">
                                                                @if (item.isActive == true)
                                                                {
                                                                    <span class="label label-sm label-primary">Published</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="label label-sm label-warning">Unpublished</span>
                                                                }

                                                            </td>

                                                            <td class="center td-data" style="font-size:13px; padding: 14px 4px !important">
                                                                <div class="hidden-sm hidden-xs action-buttons">


                                                                    <a data-rel="tooltip" class="tooltip-primary" title="Edit" href="@Url.Action("EditProjectDetails", "PriorityProjects", new { Id = CMNirdesh.Models.EncryptionUtility.Encrypt(item.ProjectId.ToString()) })">
                                                                        <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                    </a>
                                                                    <a data-rel="tooltip" class="red tooltip-error" title="Delete" id="DeleteLink" href="@Url.Action("DeleteProject", "PriorityProjects", new { Id = CMNirdesh.Models.EncryptionUtility.Encrypt(item.ProjectId.ToString()) })">
                                                                        <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                                    </a>
                                                                </div>

                                                                @*<div class="hidden-md hidden-lg">
                                                                        <div class="inline position-relative">
                                                                            <button class="btn btn-minier btn-yellow dropdown-toggle" data-toggle="dropdown" data-position="auto">
                                                                                <i class="ace-icon fa fa-caret-down icon-only bigger-120"></i>
                                                                            </button>

                                                                            <ul class="dropdown-menu dropdown-only-icon dropdown-yellow dropdown-menu-right dropdown-caret dropdown-close">


                                                                                <li>
                                                                                    <a href="@Url.Action("EditProjectDetails", "PriorityProjects", new { Id = CMNirdesh.Models.EncryptionUtility.Encrypt(item.ProjectId.ToString()) })" class="tooltip-primary" data-rel="tooltip" title="Edit">
                                                                                        <span>
                                                                                            <i class="ace-icon fa fa-pencil bigger-120"></i>
                                                                                        </span>
                                                                                    </a>
                                                                                </li>

                                                                                <li>
                                                                                    <a href="@Url.Action("DeleteProject", "PriorityProjects", new { Id =  CMNirdesh.Models.EncryptionUtility.Encrypt(item.ProjectId.ToString()) })" class="tooltip-error DeleteContentLink" data-rel="tooltip" title="Delete">
                                                                                        <span class="red">
                                                                                            <i class="ace-icon fa fa-trash-o bigger-120"></i>
                                                                                        </span>
                                                                                    </a>

                                                                                </li>
                                                                            </ul>
                                                                        </div>
                                                                    </div>*@
                                                            </td>

                                                            @*<td class="td-data">
