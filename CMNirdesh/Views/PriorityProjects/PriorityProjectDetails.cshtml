            <div class="modal " id="ImageModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">Image title</h5>
                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        @using (Html.BeginForm("SaveProjectImage", "PriorityProjects", FormMethod.Post, new { @class = "form-horizontal", @role = "form", @id = "ProjectDoc" }))
                        {
                            @Html.AntiForgeryToken()


                            <div class="modal-body">
                                <div class="row">
                                    <div class="form-group col-sm-6 col-md-4 col-lg-4">
