@model  IEnumerable<CMNirdesh.Models.ImageViewModel>

@{
    ViewBag.Title = "ImageList";
    int count = 0;
}


<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
<script src="~/Scripts/datatables/jszip.min.js"></script>
<script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
<script src="~/Scripts/datatables/vfs-fonts.js"></script>
<script src="~/Scripts/datatables/buttons.print.min.js"></script>
<script src="~/Scripts/datatables/buttons.html5.min.js"></script>

<link href="~/Content/style_ms.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />

@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

@{
    var FileSettings = CMNirdesh.Models.FileSetting.GetSecureFileSettingLocation();

}

<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
              <div class="inr_frm_dsgn">


                            <div class="Tab_hdr p-2" style="display:flex;">
                                <div class="col-md-6">
                                    <h2>Images List</h2>
                                </div>
                                <div class="col-md-6 text-right txt_rit">
                                    <button style="font-size:14px;" class="btn  btn-sm btn-primary" onclick="window.location.href ='@Url.Action("CreateImage", "PriorityProjects")'">
                                        <i class="ace-icon fa fa-pencil-square-o bigger-150"></i>
                                        <span class="bigger-110">Add Image</span>
                                    </button>
                                </div>
                            </div>
                            <div class="form_lyot">

                                @if (Model != null)
                                {
                                    if (Model.Count() > 0)
                                    {
                                        <div class="tab_parent table-responsive table_rsponsv">
                                            <table id="example" class="table table-hover table-bordered ">
                                                <thead>
                                                    <tr class="table-heading">
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Sr No.</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Image Title</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Project Name</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Project Image</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Date</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Status</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Action</span></th>
                                                    </tr>
                                                </thead>
                                                <tbody role="alert" aria-live="polite" aria-relevant="all">
                                                    @foreach (var item in Model)
                                                    {
                                                        count = count + 1;

                                                        <tr>
                                                            <td class="center td-data" style="padding: 13px 4px !important">
                                                                @count
                                                            </td>


                                                            <td class="center td-data" style="padding: 13px 4px !important">@item.ImageTitle</td>
                                                            <td class="center td-data" style="padding: 13px 4px !important">@item.ProjectName</td>
                                                            <td class="center td-data" style="padding: 13px 4px !important">
                                                                <a href="@Url.Content("~/MlaDiary/"+item.ImageLocation)" target="_blank"><img src="@Url.Content("~/MlaDiary/"+item.ImageLocation)" height="35" width="35" /> </a>
                                                            </td>
                                                            <td class="center td-data" style="padding: 13px 4px !important">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                                            <td class="center td-data hidden-480" style="font-size:13px; padding: 13px 4px !important">
                                                                @if (item.IsActive == 1)
                                                                {
                                                                    <span class="label label-sm label-primary">Published</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="label label-sm label-warning">Unpublished</span>
                                                                }

                                                            </td>

                                                            <td class="center td-data" style="padding: 13px 4px !important">
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <a data-rel="tooltip" class=" tooltip-primary" title="Edit" href="@Url.Action("EditImage", "PriorityProjects", new { Id = CMNirdesh.Models.EncryptionUtility.Encrypt(item.ProgrammeImageId.ToString()) })">
                                                                        <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                    </a>
                                                                    <a data-rel="tooltip" class="red tooltip-error " title="Delete" id="DeleteLink" href="@Url.Action("DeleteImage", "PriorityProjects", new { Id = CMNirdesh.Models.EncryptionUtility.Encrypt(item.ProgrammeImageId.ToString()) })">
                                                                        <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                                    </a>
                                                                </div>


                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <div class="alert alert-info">

                                                    <strong>There are no record found</strong><br />


                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>
                        </div>
        </section>

        <a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
            <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
        </a>
    </div>
</div>





<script type="text/javascript">

    $(document).ready(function () {
        $('#example').DataTable();
            //$('#sample-table-2')
            //    //.wrap("<div class='dataTables_borderWrap' />")   //if you are applying horizontal scrolling (sScrollX)
            //    .dataTable({
            //        bAutoWidth: true,
            //        "aoColumns": [
            //            { "bSortable": false },
            //            null, null, null, null, null, null, null,
            //            { "bSortable": false }
            //        ]
            //        //,
            //        //"sScrollY": "200px",
            //        //"bPaginate": false,

            //        //"sScrollX": "100%",
            //        //"sScrollXInner": "120%",
            //        //"bScrollCollapse": true,
            //        //Note: if you are applying horizontal scrolling (sScrollX) on a ".table-bordered"
            //        //you may want to wrap the table inside a "div.dataTables_borderWrap" element

            //        //"iDisplayLength": 50
            //    });
            $('[data-rel="tooltip"]').tooltip({ placement: tooltip_placement });
        $("#Projectmain").addClass("active open");
        $("#Projectsub").addClass("nav-show").css("display", "block");
        $("#imagelist").addClass("active");
    });


    $(".DeleteContentLink").on('click', function (e) {

        e.preventDefault();
        var url = $(this).attr('href');

        bootbox.confirm("Are you sure to Delete Project?", function (result) {

            if (result) {

                window.location.href = url;
            }
            else {


            }

        })
    });


    function tooltip_placement(context, source) {
        var $source = $(source);
        var $parent = $source.closest('table')
        var off1 = $parent.offset();
        var w1 = $parent.width();

        var off2 = $source.offset();
        //var w2 = $source.width();

        if (parseInt(off2.left) < parseInt(off1.left) + parseInt(w1 / 2)) return 'right';
        return 'left';
    }



</script>
<style>

    .inr_frm_dsgn {
        margin-top: 20px;
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .inr_frm_dsgn {
        margin-top: 20px;
    }

    .form_lyot {
        padding: 10px;
    }

