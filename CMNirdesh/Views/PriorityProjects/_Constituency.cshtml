<script>
    function closePopup() {
        $("#modalAddDocument").hide();
        $("#modalImages").hide();
        $("#modalAddConstituency").hide();
        $("#myImgModal").hide();
        loadWorkConstituencyList();
    }
</script>
<script>
    $(document).ready(function () {
        $('input:checkbox').change(function () {
            if ($(this).is(':checked')) {
                $("#loader-wrapper").show();
                var contituencyId = $(this).val();
                var workID = $('#hdnConstWorkId').val();
                var ProjectId = $('#hdnConstProjectId').val();
                var DeptId = $('#hdnConstDeptId').val();
                try {
                    $.ajax({
                        type: "GET",
                        url: '@Url.Action("SaveProjectConstituency", "PriorityProjects")',
                        async: true,
                        data: { ProjectId: ProjectId, deptID: DeptId, workID: workID, contituencyId: contituencyId },
                        beforeSend: function () {
                            $('#loader-wrapper').show();
                        },
                        success: function (data) {
                            $("#loader-wrapper").hide();
                            if (data == "1") {
                                $('#tbodyWorkConstituency').html('');
                                loadWorkConstituencies();
                                return false;
                            }
                            else {
                                $('#modalWorks').modal({ backdrop: 'static', keyboard: false }, 'show');
                                alert("Some error occurred,please try again");
                                return false;
                                e.preventDefault();
                            }
                        },
                        error: function (jqXHR, textStatus, errorThrown) {
                            $("#loader-wrapper").hide();
                            alert("Some error occurred,please try again2");
                        },
                    });

                }
                catch (ex) {
                    alert("Some error occurred,please try again3");
                }
            }
        });
    });
    function DeleteConstituencyBtn(contituencyId) {
        try {
            $("#loader-wrapper").show();
            var workID = $('#hdnConstWorkId').val();
            var ProjectId = $('#hdnConstProjectId').val();
            var DeptId = $('#hdnConstDeptId').val();

            $.ajax({
                type: "GET",
                url: '@Url.Action("DeleteProjectConstituency", "PriorityProjects")',
                async: true,
                data: { ProjectId: ProjectId, deptID: DeptId, workID: workID, contituencyId: contituencyId },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {
                    $("#loader-wrapper").hide();
                    if (data == "1") {
                        //alert("Constituency has been deleted successfully");
                        $('#tbodyWorkConstituency').html('');
                        loadWorkConstituencies();
                        return false;
                    }
                    else {
                        $('#modalWorks').modal({ backdrop: 'static', keyboard: false }, 'show');
                        alert("Some error occurred,please try again");
                        return false;
                        e.preventDefault();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    $("#loader-wrapper").hide();
                    $('#modalWorks').modal({ backdrop: 'static', keyboard: false }, 'show');
                    alert("Some error occurred,please try again");
                    //// window.location.reload(true);
                },
            });
        }
        catch (ex) {
            alert("Some error occurred,please try again");
            window.location.reload(true);
        }
    }
    function loadWorkConstituencies() {
        $("#loader-wrapper").show();
        $('#modalAddConstituencyBody').html('');
        var workID = $('#hdnConstWorkId').val();
        var ProjectId = $('#hdnConstProjectId').val();
        var DeptId = $('#hdnConstDeptId').val();

        $.ajax({
            type: "GET",
            url: '@Url.Action("ViewConstituencies", "PriorityProjects")',
            async: true,
            data: { ProjectId: ProjectId, deptID: DeptId, workID: workID },
            beforeSend: function () {
                $('#loader-wrapper').show();
            },
            success: function (data) {
                var options = {
                    "backdrop": "static",
                    keyboard: true
                };
                $("#loader-wrapper").hide();

                if (data) {
                    $("#modalAddConstituency").css("display", "block");
                    $('#modalAddConstituencyBody').html(data);
                    loadConstituency();
                } else { alert("error"); }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                alert(xhr.responseText);
                alert(thrownError);
                $("#loader-wrapper").hide();
            },
            complete: function (results) {
                $('#loader-wrapper').hide();

            }
        });
    }

    function loadConstituency() {
        $("#loader-wrapper").show();
        var workID = $('#hdnConstWorkId').val();
        var ProjectId = $('#hdnConstProjectId').val();
        var DeptId = $('#hdnConstDeptId').val();
        var html = '';
        $.ajax({
            type: 'GET',
            url: '@Url.Action("getProjectConstituency", "PriorityProjects")',
            data: { workId: workID },
            success: function (data) {
                if (data.length > 0) {
                    $.each(data, function (i, item) {
                        html = "<tr role='row'><td>" +
                            "<span>" + item.Text + "</span" +
                            "</td><td>" +
                            "<a class='text-danger mr-1' style='font-size: 10pt; padding: 2px 5px;' title='Delete' id='btnDeletConst' onclick='DeleteConstituencyBtn(" + item.Value+"); return false;'><i class='fa fa-times'></i></a>" +
                            "</td></tr > ";
                        $('#tbodyWorkConstituency').append(html);
                    });
                }
                else {
                    html = "<tr role='row'><td colspan='2'>" +
                        "No Record Found" +
                        "</td>'</tr > ";
                    $('#tbodyWorkConstituency').append(html);
                }
                $("#loader-wrapper").hide();
            },
            error: function () {
                html = "<tr role='row'><td colspan='2'>" +
                    "No Record Found" +
                    "</td>'</tr > ";
                $('#tbodyWorkConstituency').append(html);
                $("#loader-wrapper").hide();
            }
        });
    }
    function loadWorkConstituencyList() {
        $("#loader-wrapper").show();
        var workID = $('#hdnConstWorkId').val();
        $('#constituencyList').html('');
        var html = '';
        $.ajax({
            type: 'GET',
            url: '@Url.Action("getProjectConstituency", "PriorityProjects")',
            data: { workId: workID },
            success: function (data) {
                if (data.length > 0) {
                    $.each(data, function (i, item) {
                        html = "<li>" +
                            "<span>" + item.Text + "</span>" +
                            "<a class='loader text-danger' style = 'float:right' title = 'Delete' id = 'btnDeleteDept' onclick='DeleteConstituency(" + item.Value + "); return false;' })' > " +
                            "<i class='fa fa-times' style = 'font-weight: 700;' ></i > " +
                            "</a > " +
                            "</li > ";
                        $('#constituencyList').append(html);
                    });
                    /**/
                }
                else {
                    html = "<tr role='row'><td colspan='2'>" +
                        "No Record Found" +
                        "</td>'</tr > ";
                    $('#constituencyList').append(html);
                }
                $("#loader-wrapper").hide();
            },
            error: function () {
                html = "<tr role='row'><td colspan='2'>" +
                    "No Record Found" +
                    "</td>'</tr > ";
                $('#constituencyList').append(html);
                $("#loader-wrapper").hide();
            }
        });
    }
</script>
