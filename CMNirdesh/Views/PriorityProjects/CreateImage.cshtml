@model  CMNirdesh.Models.ImageViewModel
@{
    ViewBag.Title = "CreateImages";


}

@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@
<script src="~/assets/js/bootbox.min.js"></script>

<link href="~/Content/style_ms.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class="main-content" id="main=content">
    <!-- #section:basics/content.breadcrumbs -->
    <div>


        <ul class="breadcrumb" style="font-size: large; color: #555; padding: 0 3px 0 3px;">
            <li>
                <i class="ace-icon fa fa-home home-icon"></i>
                <a href="@Url.Action("ImageList", "PriorityProjects")">Priority Projects >> </a>
            </li>
            <li>
                <a href="@Url.Action("ImageList", "PriorityProjects")">Images</a>
            </li>
        </ul>
    </div>

    <section class="form_dsign Create_priority_project cm_sec_container form_setting">
        <div class="container-fluid">



            <div class="row">
                <div class="col-md-12">
                    <div class=" inr_frm_dsgn">
                        @if (Model.Mode == "Add")
                        {
                            <h4 class="widget-title lighter fom_titl">Add Image</h4>
                        }
                        else
                        {
                            <h4 class="widget-title lighter fom_titl">Edit Image</h4>
                        }


                        <div class="form_lyot">
                            @using (Html.BeginForm("SaveImage", "PriorityProjects", FormMethod.Post, new { @class = "form-horizontal", @role = "form", @id = "ProjectImage" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(model => model.ProgrammeImageId)
                                @Html.HiddenFor(model => model.Mode)

                                <div class="card">
                                    <div class="card-body">
                                        <fieldset class="fieldset_box personal_fild comn_field fild_btn">
                                            <legend class="leg_box">Image Details:</legend>
                                            <div class="row">
                                                <div class="col-lg-2">
                                                </div>
                                                <div class="col-md-6 col-lg-4">
                                                    <label for="inputinfo" class="control-label lbl_txt">Project</label>
                                                    @Html.DropDownListFor(a => a.ProjectId, Model.ProjectList, new { @class = "width-100", @tabindex = "1" })
                                                    @Html.ValidationMessageFor(model => model.ProjectId)
                                                </div>

                                                <div class="col-md-6 col-lg-4">
                                                    <label for="inputinfo" class="control-label lbl_txt"> Image Title </label>
                                                    @Html.TextBoxFor(model => model.ImageTitle, new { @class = "width-100", @placeholder = "Image Title", @autocomplete = "off", @tabindex = "2" })

                                                    @Html.ValidationMessageFor(model => model.ImageTitle)

                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-lg-2">
                                                </div>
                                                <div class="col-md-6 col-lg-4">
                                                    <label for="inputinfo" class="control-label lbl_txt"> Upload Image </label>
                                                    <input type="file" style="margin-left: 40px;" name="projectDoc" id="projectDoc" accept=".jpg,.jpeg,.bmp,.png,.gif" />
                                                    @Html.HiddenFor(model => model.ImageLocation)
                                                    <input type="hidden" id="projectDochdn" />
                                                    @Html.HiddenFor(model => model.ImageFileName)
                                                    @if (Model.Mode == "Add")
                                                    {
                                                        <img id="adocLoc" src="" style="display:none;" />

                                                    }
                                                    else
                                                    {
                                                        <img id="adocLoc"  src="@Url.Content("~/MlaDiary/"+Model.ImageLocation)"  width="50" height="50" />

                                                    }
                                                </div>

                                                <div class="col-md-6 col-lg-4">
                                                    <label for="inputinfo" class="control-label lbl_txt"> Publishing Status </label>
                                                    @Html.DropDownListFor(model => model.IsActive, Model.StatusTypeList, new { @class = "width-100", @tabindex = "13" })

                                                </div>


                                            </div>
                                            <div class="row">
                                                <div class="col-lg-8">
                                                </div>
                                                <div class="col-md-6 col-lg-2" style="margin-top:30px; text-align:right;">
                                                    <label for="inputinfo" class="control-label lbl_txt"> </label>
                                                    <button type="reset" class="btn btn-sm btn-danger" onclick="resetFields();">
                                                        <i class="ace-icon fa fa-times bigger-125"></i>
                                                        Reset
                                                    </button>
                                                    <button type="submit" id="savebtn" class="btn btn-sm btn-primary ">
                                                        <i class="ace-icon fa fa-floppy-o bigger-125"></i>
                                                        Save
                                                    </button>
                                                </div>
                                            </div>
                                        </fieldset>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


</div>


<link href="~/Content/responsive_ms.css" rel="stylesheet" />
<link href="~/Content/style_ms.css" rel="stylesheet" />
<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
<script src="~/Scripts/datatables/jszip.min.js"></script>
<script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
<script src="~/Scripts/datatables/vfs-fonts.js"></script>
<script src="~/Scripts/datatables/buttons.print.min.js"></script>
<script src="~/Scripts/datatables/buttons.html5.min.js"></script>
<script src="~/Scripts/bootstrap-wysiwyg.min.js"></script>
<script src="~/Scripts/jquery.hotkeys.min.js"></script>

<script>
    
    $("#projectDoc").change(function () {
        CheckImage("#projectDoc", "projectDoc");
    });

    $("#savebtn").click(function () {
        var engdata = $("div#editor-eng").html();
        $("#ImageDescription").val(engdata);
    });

    function CheckImage(input, name) {

        var sizeInKB = $(input)[0].files[0].size / 1024;
        var filename = $(input)[0].files[0].name;
        var dots = $(input).val().split(".").length - 1;
        var sizeLimit = 2048;

        if ($(input).val().length > 0 && !(/\.(jpg|jpeg|bmp|png|gif)$/i).test($(input).val())) {
            toastr.error('You must select file in format of jpg,jpeg,bmp,png,gif .');
            $('#Photo').val('');
            $('#Photo').focus();
        }

        else if (dots > 1) {
            toastr.error('Invalid file Format.');
            $(input).val('');
            $(input).focus();
            $(input + "hdn").val('');
            $("#ImageLocation").val('');
        }


        else {
            var inpt = "input[name=" + name + "]";

            var inputElement1 = $(inpt);

            readImage(inputElement1).done(function (base64Data) {
                $(input + "hdn").val(base64Data);
                $("#ImageLocation").val(base64Data);
                $("#ImageFileName").val(filename);
                $("#adocLoc").hide();
            });
        }

    }
    function readImage(inputElement) {
        var deferred = $.Deferred();
        var files = inputElement.get(0).files;
        if (files && files[0]) {
            var fr = new FileReader();
            fr.onload = function (e) {
                deferred.resolve(e.target.result);
            };
            fr.readAsDataURL(files[0]);
        } else {
            deferred.resolve(undefined);
        }
        return deferred.promise();
    }

    $(document).ready(function () {
        $("#Title").focus();
        $("#Projectmain").addClass("active open");
        $("#Projectsub").addClass("nav-show").css("display", "block");
        $("#imagelist").addClass("active");
        initEditor();
    });



    function resetFields() {
        $(".field-validation-error").empty();
        $("#Title").focus();
    }


    function initEditor() {
        $('#editor-eng').ace_wysiwyg({
            toolbar:
                [
                    {
                        name: 'font',
                        title: 'Custom tooltip',
                        values: ['Some Font!', 'Arial', 'Verdana', 'Comic Sans MS', 'Custom Font!']
                    },
                    null,
                    {
                        name: 'fontSize',
                        title: 'Custom tooltip',
                        values: { 1: 'Size#1 Text', 2: 'Size#1 Text', 3: 'Size#3 Text', 4: 'Size#4 Text', 5: 'Size#5 Text' }
                    },
                    null,
                    { name: 'bold', title: 'Custom tooltip' },
                    { name: 'italic', title: 'Custom tooltip' },
                    { name: 'strikethrough', title: 'Custom tooltip' },
                    { name: 'underline', title: 'Custom tooltip' },
                    null,
                    'insertunorderedlist',
                    'insertorderedlist',
                    'outdent',
                    'indent',
                    null,
                    { name: 'justifyleft' },
                    { name: 'justifycenter' },
                    { name: 'justifyright' },
                    { name: 'justifyfull' },
                    null,
                    {
                        name: 'createLink',
                        placeholder: 'Custom PlaceHolder Text',
                        button_class: 'btn-purple',
                        button_text: 'Custom TEXT'
                    },
                    { name: 'unlink' },
                    null,
                    {
                        name: 'insertImage',
                        placeholder: 'Custom PlaceHolder Text',
                        button_class: 'btn-inverse',
                        button_text: 'Set choose_file:false to hide this',
                        button_insert_class: 'btn-pink',
                        button_insert: 'Insert Image'
                    },
                    null,
                    {
                        name: 'foreColor',
                        title: 'Custom Colors',
                        values: ['red', 'green', 'blue', 'navy', 'orange'],
                    },

                    null,
                    { name: 'undo' },
                    { name: 'redo' },
                    null,
                    'viewSource'
                ],

            'wysiwyg': {
                hotKeys: {} //disable hotkeys
            }

        }).prev().addClass('wysiwyg-style2');
    }


    var engdata = $("#ImageDescription").val();
    $("div#editor-eng").html(engdata);


</script>
