<script>
    $(document).ready(function () {
        $('#example').DataTable({
            "language": {
                "search": "Search:"
            }
        });

        function syncToolbarSearch() {
            var $wrapper = $('#example_wrapper');
            if ($wrapper.length) {
                var $filter = $wrapper.find('> .dataTables_filter, .dataTables_filter');
                if ($filter.length && !$('#toolbarSearchSlot').children().length) {
                    $('#toolbarSearchSlot').empty().append($filter);
                }
            }
        }
        syncToolbarSearch();
        $(document).on('init.dt draw.dt', '#example', function () {
            syncToolbarSearch();
        });

        // Real-time clearing of validation highlights when user types
        $('#ZoneName').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#ZoneNameError').removeClass('show');
            }
        });

        $('#ZoneNameLocal').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#ZoneNameLocalError').removeClass('show');
            }
        });
    });

    function validate() {
        var isValid = true;
        var firstInvalid = null;

        var zoneName = $('#ZoneName').val();
        if (!zoneName || zoneName.trim() === '') {
            $('#ZoneName').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#ZoneNameError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#ZoneName');
        } else {
            $('#ZoneName').removeClass('is-invalid').css('background-color', 'white');
            $('#ZoneNameError').removeClass('show');
        }

        var zoneNameLocal = $('#ZoneNameLocal').val();
        if (!zoneNameLocal || zoneNameLocal.trim() === '') {
            $('#ZoneNameLocal').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#ZoneNameLocalError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#ZoneNameLocal');
        } else {
            $('#ZoneNameLocal').removeClass('is-invalid').css('background-color', 'white');
            $('#ZoneNameLocalError').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }

    function handleSuccess(response) {
        if (response.success) {
            alert("Form submitted successfully!");
            window.location.href = "@Url.Action("Index", "Zone")";
        } else {
            var errorsHtml = "<ul>";
            $.each(response.errors, function (index, error) {
                errorsHtml += "<li>" + error + "</li>";
            });
            errorsHtml += "</ul>";
            $("#validationErrors").html(errorsHtml);
        }
    }

    function handleFailure(response) {
        $("#validationErrors").html("An error occurred while processing your request.");
    }

    function AddNew() {
        clearTextBox();
        $('#myModal').modal('show');
        $("#mode").val('Add');
        $("#ZoneID").val("0");
    }

    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {
        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("UpdateStatusZone", "Zone")' + '?ZoneId=' + i,
            success: function (result) {
                alert("Updated Successfully");
            }
        });
    }

    function ToggleZoneStatus(checkbox) {
        var zoneId = $(checkbox).data("zoneid");
        var isActive = checkbox.checked ? 1 : 0;
        alert(zoneId);
        alert(isActive);

        $.ajax({
            url: '@Url.Action("UpdateStatusZone", "Zone")',
            type: 'POST',
            data: {
                ZoneId: zoneId,
                Active: isActive
            },
            success: function (response) {
                if (response.success) {
                    var msg = isActive === 1
                        ? "Zone activated successfully."
                        : "Zone deactivated successfully.";
                    alert(msg);
                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error updating zone status:", error);
                alert("Something went wrong while updating the status.");
            }
        });
    }

    function getbyID(ZoneID) {
        clearTextBox();
        $("#myModalLabel").html("Update Zone Record");
        $("#btnUpdate").show();
        $("#btnSave").hide();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditZone", "Zone")' + '?ZoneID=' + ZoneID,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                var obj = JSON.parse(data);
                var data = obj.Zoneslist[0];
                $('#myModal').modal('show');
                $("#mode").val('Edit');
                $("#ZoneID").val(data.ZoneID);
                $("#ZoneName").val(data.ZoneName);
                $('#ZoneNameLocal').val(data.ZoneNameLocal);
                $("#btnSave").hide();
            }
        });
    }

    function clearTextBox() {
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#ZoneName').css('background-color', 'white').val("");
        $('#ZoneNameLocal').css('background-color', 'white').val("");
        $('#ZoneID').val("0");
        $('#mode').val("Add");
        $("#validationErrors").html("");
        $("#myModalLabel").html("Add Zone Details");
        $("#btnSave").show();
        $("#btnUpdate").hide();
    }
</script>
