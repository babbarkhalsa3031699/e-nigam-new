@model CMNirdesh.Models.Zone


<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
</head>

<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Zone List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="AddNew()"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add Zone</button>
                            </div>
                        </div>
                    </div>

                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model.Zoneslist.Count > 0)
                            {
                                <div class=" table-responsive">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Zone Name</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Zone Name Local</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Created date</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model.Zoneslist)
                                            {

                                                <tr>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@items.ZoneName</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.ZoneNameLocal)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.CreatedDate)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        <div class="d-flex align-items-center gap-2">

                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.ZoneID')" value="@items.ZoneID" />
                                                            </div>
                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.ZoneID')" value="@items.ZoneID" />
                                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.ZoneID')">
                                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                </a>

                                                                <label class="toggle mb-0">
                                                                    @*<input type="checkbox" onclick="DeleteDepartmentRecord('@items.ZoneID')" @(Convert.ToBoolean(items.Active) == true ? "checked='checked'" : string.Empty)>*@
                                                                    <input type="checkbox"
                                                                           data-zoneid="@items.ZoneID"
                                                                           @(Convert.ToBoolean(items.Active) ? "checked" : "")
                                                                           onchange="ToggleZoneStatus(this)" />
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>
                                                        </div>

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>


                </div>
            </div>
            <div class="coman_modal dispatch_modal addnew_modal modal zone-record-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">

                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Zone Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            @using (Ajax.BeginForm("Create", "Zone", null, new AjaxOptions { HttpMethod = "POST", OnSuccess = "handleSuccess", OnFailure = "handleFailure", OnBegin = "validate" }, new { id = "zoneForm", onsubmit = "return validate();" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true)
                                @Html.HiddenFor(model => model.ZoneID, new { id = "ZoneID", Value = "0" })
                                @Html.HiddenFor(model => model.Mode, new { id = "mode" })

                                <!-- Section: Zone Information -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-map-marker"></i> Zone Information</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <label for="ZoneName" class="profile-info-name fotm_lbl">Zone Name:</label>
                                            @Html.TextBoxFor(model => model.ZoneName, new { @class = "form-control", id = "ZoneName", placeholder = "Enter Zone Name" })
                                            <span id="ZoneNameError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Zone Name is required</span>
                                        </div>

                                        <div class="form-group">
                                            <label for="ZoneNameLocal" class="profile-info-name fotm_lbl">Zone Name (Punjabi):</label>
                                            @Html.TextBoxFor(model => model.ZoneNameLocal, new { @class = "form-control", id = "ZoneNameLocal", placeholder = "ਜ਼ੋਨ ਦਾ ਨਾਮ (ਪੰਜਾਬੀ)" })
                                            <span id="ZoneNameLocalError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Zone Name (Punjabi) is required</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-check"></i> Save</button>
                                    <button type="submit" class="btn btn-primary" id="btnUpdate" style="display:none;"><i class="fa fa-pencil-square-o"></i> Update</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</button>
                                </div>
                            }
                        </div>
                        <div id="validationErrors" style="color:red; padding: 0 24px 12px 24px;"></div>

                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>
    /* ==========================================================================
       ZONE RECORD MODAL (SaaS Clean Modern Design)
       ========================================================================== */

    /* 1. Modal Reset & Container */
    .zone-record-modal.addnew_modal {
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .zone-record-modal.modal {
        padding: 0 !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans Gurmukhi", "Raavi", sans-serif;
    }

    .zone-record-modal .modal-dialog {
        display: flex;
        align-items: center;
        justify-content: center;
