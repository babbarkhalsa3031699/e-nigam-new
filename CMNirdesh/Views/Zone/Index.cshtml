    }

    .zone-record-modal .form-section-title i {
        color: #2563eb;
        font-size: 13px !important;
    }

    /* 5. 2-Column Responsive Layout */
    .zone-record-modal .form-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 18px;
        align-items: start;
    }

    @@media (max-width: 767px) {
        .zone-record-modal .modal-dialog {
            margin: 0.75rem auto;
            width: calc(100% - 1.5rem);
        }

        .zone-record-modal .form-card-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .zone-record-modal .modal-footer {
            padding: 12px 16px !important;
        }

        .zone-record-modal .modal-footer .btn {
            flex: 1 1 auto;
        }
    }

    .zone-record-modal .col-full {
        grid-column: 1 / -1;
    }

    /* 6. Form Groups & Field Labels */
    .zone-record-modal .form-group {
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
    }

    .zone-record-modal .fotm_lbl,
    .zone-record-modal .profile-info-name.fotm_lbl,
    .zone-record-modal label.fotm_lbl {
        font-size: 12px !important;
        font-weight: 600 !important;
        letter-spacing: normal !important;
        color: #334155 !important;
        margin-bottom: 6px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between;
        width: 100% !important;
        text-align: left !important;
        float: none !important;
        padding-left: 0 !important;
    }

    /* 7. Inputs & Form Controls */
    .zone-record-modal input[type="text"],
    .zone-record-modal .form-control {
        width: 100% !important;
        height: 38px !important;
        min-height: 38px !important;
        padding: 6px 12px !important;
        font-size: 13px !important;
        font-weight: 400 !important;
        line-height: normal !important;
        color: #0f172a !important;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out, background-color 0.15s ease-in-out !important;
        box-sizing: border-box !important;
    }

    /* Validation Error Highlighting (Clean & Prominent) */
    .zone-record-modal .form-control.is-invalid,
    .zone-record-modal input[type="text"].is-invalid {
        border: 1.5px solid #ef4444 !important;
        background-color: #fef2f2 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.18) !important;
    }

    .zone-record-modal .field-val-msg {
        display: none;
        font-size: 11.5px !important;
        font-weight: 600 !important;
        color: #dc2626 !important;
        margin-top: 5px !important;
        align-items: center;
        gap: 4px;
    }

    .zone-record-modal .field-val-msg.show {
        display: flex !important;
    }

    .zone-record-modal input[type="text"]:hover {
        border-color: #94a3b8 !important;
    }

    .zone-record-modal input[type="text"]:focus {
        border-color: #2563eb !important;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
