<style>
    /* ==========================================================================
       DASHBOARD VISUALS FOR ZONE
       Matches: Proceedings >> Proceeding Resolutions & Analytics Dashboard
       ========================================================================== */

    /* Main Container */
    .main-office-container {
        padding: 8px 14px 24px 14px;
    }

    /* 1. Compact Breadcrumb Bar */
