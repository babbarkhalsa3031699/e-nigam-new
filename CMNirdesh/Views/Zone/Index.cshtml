@model CMNirdesh.Models.Zone


<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
</head>

<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Zone List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="AddNew()"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add Zone</button>
                            </div>
                        </div>
                    </div>

                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model.Zoneslist.Count > 0)
                            {
                                <div class=" table-responsive">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Zone Name</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Zone Name Local</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Created date</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model.Zoneslist)
                                            {

                                                <tr>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@items.ZoneName</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.ZoneNameLocal)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.CreatedDate)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        <div class="d-flex align-items-center gap-2">

                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.ZoneID')" value="@items.ZoneID" />
                                                            </div>
                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.ZoneID')" value="@items.ZoneID" />
                                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.ZoneID')">
                                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                </a>

                                                                <label class="toggle mb-0">
                                                                    @*<input type="checkbox" onclick="DeleteDepartmentRecord('@items.ZoneID')" @(Convert.ToBoolean(items.Active) == true ? "checked='checked'" : string.Empty)>*@
                                                                    <input type="checkbox"
                                                                           data-zoneid="@items.ZoneID"
                                                                           @(Convert.ToBoolean(items.Active) ? "checked" : "")
                                                                           onchange="ToggleZoneStatus(this)" />
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>
                                                        </div>

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>


                </div>
            </div>
            <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">

                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Zone Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">



                            @using (Ajax.BeginForm("Create", "Zone", null, new AjaxOptions { HttpMethod = "POST", OnSuccess = "handleSuccess", OnFailure = "handleFailure" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true)
                                @Html.HiddenFor(model => model.ZoneID)
                                @Html.HiddenFor(model => model.Mode, new { id = "mode" })

                                <div class="form-group">
                                    @Html.Label("Zone Name")
                                    @Html.EditorFor(model => model.ZoneName)
                                    @Html.ValidationMessageFor(model => model.ZoneName)
                                </div>

                                <div class="form-group">
                                    @Html.Label("Zone Name(Punjabi)")
                                    @Html.EditorFor(model => model.ZoneNameLocal)
                                    @Html.ValidationMessageFor(model => model.ZoneNameLocal)
                                </div>

                                <div class="modal-footer" style="background-color:white;">
                                    <button type="submit" class="btn btn-primary" id="btnSave">Save</button>
                                    <button type="submit" class="btn btn-primary" id="btnUpdate">Update</button>
                                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                                </div>
                            }
                        </div>
                        <div id="validationErrors" style="color:red"></div>

                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>


    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<script>


    $(document).ready(function () {
        $('#example').DataTable({
        });
    });

    function handleSuccess(response) {
        if (response.success) {
            alert("Form submitted successfully!");
             window.location.href =  "@Url.Action("Index", "Zone")";
        } else {

            var errorsHtml = "<ul>";
            $.each(response.errors, function (index, error) {
                errorsHtml += "<li>" + error + "</li>";
            });
            errorsHtml += "</ul>";
            $("#validationErrors").html(errorsHtml);
        }
    }

    function handleFailure(response) {
        $("#validationErrors").html("An error occurred while processing your request.");
    }
    function AddNew() {
        clearTextBox();
        $('#myModal').modal('show');
        $("#mode").val('Add');
    }



        var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {
        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("UpdateStatusZone", "Zone")' + '?ZoneId=' + i,
            success: function (result) {
                alert("Updated Successfully");
               // window.location.href =  "@Url.Action("Index", "Assembly")";
            }
        });
    }


 
    function ToggleZoneStatus(checkbox) {
        var zoneId = $(checkbox).data("zoneid");
        var isActive = checkbox.checked ? 1 : 0;
        alert(zoneId);
        alert(isActive);

        $.ajax({
            url: '@Url.Action("UpdateStatusZone", "Zone")', // ✅ MVC URL helper
            type: 'POST',
            data: {
                ZoneId: zoneId,
                Active: isActive
            },
            success: function (response) {
                if (response.success) {
                    var msg = isActive === 1
                        ? "Zone activated successfully."
                        : "Zone deactivated successfully.";
                    alert(msg); // You can replace with SweetAlert or toast later
                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error updating zone status:", error);
                alert("Something went wrong while updating the status.");
            }
        });
    }











    function getbyID(ZoneID) {

          clearTextBox();
        $("#myModalLabel").html("Update Zone Record");
        $("#btnUpdate").show();
        $("#btnSave").hide();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditZone", "Zone")' + '?ZoneID=' + ZoneID,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
            var obj = JSON.parse(data);
            var data = obj.Zoneslist[0];
            $('#myModal').modal('show');
            $("#mode").val('Edit');
            $("#ZoneID").val(data.ZoneID);
            $("#ZoneName").val(data.ZoneName);
            $('#ZoneNameLocal').val(data.ZoneNameLocal);
            $("#btnSave").hide();

            }
            });
            }

            function clearTextBox() {
            $('#ZoneName').val("");
            $('#ZoneNameLocal').val("");
            $("#btnSave").show();
            $("#btnUpdate").hide();
            $("#btnSave").show();
            }


            </script>
