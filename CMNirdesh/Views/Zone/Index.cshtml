    }

    .zone-record-modal .modal-body::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }

    .zone-record-modal .modal-body::-webkit-scrollbar-thumb:hover {
        background-color: #94a3b8;
    }

    /* 4. Form Section Cards */
    .zone-record-modal .form-section-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .zone-record-modal .form-section-title {
        font-size: 11px !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
