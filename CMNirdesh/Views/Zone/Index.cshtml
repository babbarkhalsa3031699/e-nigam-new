    /* 8. Sticky Footer & Actions */
    .zone-record-modal .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 20;
        display: flex !important;
        justify-content: flex-end !important;
        align-items: center !important;
        gap: 12px !important;
        padding: 16px 24px !important;
        background: #ffffff !important;
        border-top: 1px solid #e2e8f0 !important;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
    }

    .zone-record-modal button#btnSave,
    .zone-record-modal button#btnUpdate {
        background-color: #2563eb !important;
        border: 1px solid #1d4ed8 !important;
        color: #ffffff !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        padding: 8px 24px !important;
        border-radius: 6px !important;
        box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25) !important;
        transition: all 0.15s ease !important;
        display: inline-flex;
        align-items: center !important;
        gap: 8px !important;
        cursor: pointer !important;
        height: 38px !important;
    }

    .zone-record-modal button#btnSave[style*="display: none"],
    .zone-record-modal button#btnSave[style*="display:none"],
    .zone-record-modal button#btnUpdate[style*="display: none"],
    .zone-record-modal button#btnUpdate[style*="display:none"] {
        display: none !important;
    }

    .zone-record-modal button#btnSave:hover,
    .zone-record-modal button#btnUpdate:hover {
        background-color: #1d4ed8 !important;
        border-color: #1e40af !important;
        box-shadow: 0 4px 6px rgba(37, 99, 235, 0.35) !important;
        transform: translateY(-1px);
    }

    .zone-record-modal button#btnSave:active,
    .zone-record-modal button#btnUpdate:active {
        transform: translateY(0);
    }

    .zone-record-modal .modal-footer .btn-secondary,
    .zone-record-modal .modal-footer .btn-danger {
        background-color: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        color: #334155 !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        padding: 8px 20px !important;
        border-radius: 6px !important;
        transition: all 0.15s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        cursor: pointer !important;
        height: 38px !important;
    }

    .zone-record-modal .modal-footer .btn-secondary:hover,
    .zone-record-modal .modal-footer .btn-danger:hover {
        background-color: #f1f5f9 !important;
        border-color: #94a3b8 !important;
        color: #0f172a !important;
    }


    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<script>
    $(document).ready(function () {
        $('#example').DataTable({
        });

        // Real-time clearing of validation highlights when user types
        $('#ZoneName').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#ZoneNameError').removeClass('show');
            }
        });

        $('#ZoneNameLocal').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#ZoneNameLocalError').removeClass('show');
            }
        });
    });

    function validate() {
        var isValid = true;
        var firstInvalid = null;

        var zoneName = $('#ZoneName').val();
        if (!zoneName || zoneName.trim() === '') {
            $('#ZoneName').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#ZoneNameError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#ZoneName');
        } else {
            $('#ZoneName').removeClass('is-invalid').css('background-color', 'white');
            $('#ZoneNameError').removeClass('show');
        }

        var zoneNameLocal = $('#ZoneNameLocal').val();
        if (!zoneNameLocal || zoneNameLocal.trim() === '') {
            $('#ZoneNameLocal').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#ZoneNameLocalError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#ZoneNameLocal');
        } else {
            $('#ZoneNameLocal').removeClass('is-invalid').css('background-color', 'white');
            $('#ZoneNameLocalError').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }

    function handleSuccess(response) {
        if (response.success) {
            alert("Form submitted successfully!");
            window.location.href = "@Url.Action("Index", "Zone")";
        } else {
            var errorsHtml = "<ul>";
            $.each(response.errors, function (index, error) {
                errorsHtml += "<li>" + error + "</li>";
            });
            errorsHtml += "</ul>";
            $("#validationErrors").html(errorsHtml);
        }
    }

    function handleFailure(response) {
        $("#validationErrors").html("An error occurred while processing your request.");
    }

    function AddNew() {
        clearTextBox();
        $('#myModal').modal('show');
        $("#mode").val('Add');
        $("#ZoneID").val("0");
    }

    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {
        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("UpdateStatusZone", "Zone")' + '?ZoneId=' + i,
            success: function (result) {
                alert("Updated Successfully");
            }
        });
    }

    function ToggleZoneStatus(checkbox) {
        var zoneId = $(checkbox).data("zoneid");
        var isActive = checkbox.checked ? 1 : 0;
        alert(zoneId);
        alert(isActive);

        $.ajax({
            url: '@Url.Action("UpdateStatusZone", "Zone")',
            type: 'POST',
            data: {
                ZoneId: zoneId,
                Active: isActive
            },
            success: function (response) {
                if (response.success) {
                    var msg = isActive === 1
                        ? "Zone activated successfully."
                        : "Zone deactivated successfully.";
                    alert(msg);
                } else {
                    alert("Error: " + response.message);
                }
            },
            error: function (xhr, status, error) {
                console.error("Error updating zone status:", error);
                alert("Something went wrong while updating the status.");
            }
        });
    }

    function getbyID(ZoneID) {
        clearTextBox();
        $("#myModalLabel").html("Update Zone Record");
        $("#btnUpdate").show();
        $("#btnSave").hide();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditZone", "Zone")' + '?ZoneID=' + ZoneID,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                var obj = JSON.parse(data);
                var data = obj.Zoneslist[0];
                $('#myModal').modal('show');
                $("#mode").val('Edit');
                $("#ZoneID").val(data.ZoneID);
                $("#ZoneName").val(data.ZoneName);
                $('#ZoneNameLocal').val(data.ZoneNameLocal);
                $("#btnSave").hide();
            }
        });
    }

    function clearTextBox() {
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#ZoneName').css('background-color', 'white').val("");
        $('#ZoneNameLocal').css('background-color', 'white').val("");
        $('#ZoneID').val("0");
        $('#mode').val("Add");
        $("#validationErrors").html("");
        $("#myModalLabel").html("Add Zone Details");
        $("#btnSave").show();
        $("#btnUpdate").hide();
    }
</script>
