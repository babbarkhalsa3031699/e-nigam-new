@model CMNirdesh.Models.NevaStarredQuestion


@*@model CMNirdesh.Models.Diaries.MlaDiaryData*@


@{
    ViewBag.Title = "StarredQuestionandReply";
}
<head>
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/owl_item.carousel.min.js"></script>
</head>

<div id="main-content">
    <div class="main-content">
        <section class="honbl_sec h3_heading">
            <div class="container-fluid">


                <div class="asembly_box shadow_box">
                    <h3 class="asembly_box_header">Starred Questions and Reply</h3>
                    <div class="row members-list">


                        <div class="col-md-4 col-sm-6 col-xs-12 col-12">
                            <label for="inputState" class=" fotm_lbl ">Assembly:</label>
                            @Html.DropDownListFor(m => m.AssemblyCode, Model.AssemblyList, "Select", new { @onchange = "changeAssembly()", @id = "Assembly" })

                        </div>

                        <div class="col-md-4 col-sm-6 col-xs-12 col-12">
                            <label for="inputState" class=" fotm_lbl ">Session:</label>
                            @Html.DropDownListFor(m => m.SessionCode, Model.SessionList, "Select", new { @onchange = "changeSession()", @id = "Session" })

                        </div>



                        <div class="col-md-4 col-sm-6 col-xs-12 col-12">
                            <label for="inputState" class="fotm_lbl">Session Date:</label>
                            @Html.DropDownListFor(m => m.Id, Model.SessDatelist, "Select", new { @id = "Date" })
                        </div>






                        @*<div class="col-xl-2 col-lg-3 col-md-6 col-sm-12 col-12 p-3">
                            <select class="form-control" id="Assembly" name="Assembly" onchange="changeAssembly()">
                                <option>Select Assembly</option>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-6 col-sm-12 col-12 p-3">
                            <select class="form-control" id="Session" name="Session" onchange="changeSession()">
                                <option>Select Session</option>

                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-6 col-sm-12 col-12 p-3">
                            <select class="form-control" id="Date" name="Date">
                                <option>Select Date</option>

                            </select>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 p-3">
                            <div class="row">
                                <div class="col-md-8 d-flex align-items-center">

                                    <img href="javascript:void(0);" src="@Url.Action("GetCaptchaImage", "Account", new { area = "" })" id="captchaImg" />      <a id="refresh1" class="pull-left" href="javascript:void(0);"><span class="fa fa-refresh" style="font-size: 17px;"></span></a>

                                </div>
                                <div class="col-md-4"> <input type="text" class="form-control" name="CaptchaText" id="CaptchaText" value="" placeholder="Captcha Value" maxlength="6" /></div>
                            </div>


                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 p-3">
                            <input type="button" id="btnDetail" class="btn btn-success" value="Get Detail" onclick="changeSessionDate()" />
                        </div>*@
                        <div class="col-12">




                            @if (Model.mQuestiionList != null)
                            {
                                int i = 1;
                                <div class=" table-responsive">
                                    <table class="table table-bordered display" id="introbillstbl">
                                        <thead>
                                            <tr>
                                                <th class="txtSrNo">
                                                    Sr. No
                                                </th>
                                                <th class="txtQuestionNo">
                                                    Question No
                                                </th>
                                                <th class="txtSubject">
                                                    Subject
                                                </th>
                                                <th class="txtAskedBy">
                                                    AskedBy
                                                </th>
                                                <th class="txtQuestionDtl">
                                                    Question Details
                                                </th>
                                                <th class="txtDate">
                                                    Date
                                                </th>

                                                <th class="txtReply">
                                                    Reply
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.mQuestiionList)
                                            {

                                                <tr>
                                                    <td>
                                                        @i
                                                    </td>
                                                    <td>
                                                        @item.QuestionNumber
                                                    </td>
                                                    <td>
                                                        @Html.Raw(item.Subject)
                                                    </td>
                                                    <td>
                                                        @item.AskedBy
                                                    </td>
                                                    <td>
                                                        @Html.Raw(item.MainQuestion)
                                                    </td>
                                                    <td>
                                                        @item.SessionDate
                                                    </td>
                                                    <td>
                                                        <a href="@Url.Content(item.ReplyPDF)" target="_blank" class="btn btn-success">Reply</a>


                                                    </td>

                                                </tr>

                                                i = i + 1;
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="p-3">
                                    <p>No Records Found</p>
                                </div>

                            }
                        </div>
                    </div>

                </div>


            </div>
        </section>

    </div>
</div>



<link rel="stylesheet" href="~/assets/css/jquery.dataTables.min.css" />
<script src="~/assets/js/jquery-3.7.0.js"></script>
