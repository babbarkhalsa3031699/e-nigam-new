@if (ViewBag.ErrorMessage != null)
{
    <script>
                    $(document).ready(function () {
                        alert('@Html.Raw(ViewBag.ErrorMessage)')

                    });
    </script>
}
<script>
        $("#refresh1").click(function () {
          img = $("#captchaImg");
          img.attr('src', '@Url.Action("GetCaptchaImage", "Account")');

      });
    $('#introbillstbl').DataTable({
        paging: true,
        searching: true,
        bInfo: true,
        dom: 'Bfrtip',
        buttons: [
            'excel', 'pdf'
        ]
    });

</script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadAssemblyData();
        LoadSessionData();
       // LoadSessionDatesData();

        var selctdlang = localStorage.getItem("SelectedLang");
            var dfltLang = '@System.Configuration.ConfigurationManager.AppSettings["DefaultLanguage"]';
if (selctdlang == null) { selctdlang = dfltLang; localStorage.setItem("SelectedLang", selctdlang); }
$('#drpLang').val(selctdlang);
        if (selctdlang == "1") {
    document.getElementsByClassName('asembly_box_header')[0].innerHTML = "Starred Questions and Reply";
    document.getElementsByClassName('txtSrNo')[0].innerHTML = "Sr No.";
    document.getElementsByClassName('txtQuestionNo')[0].innerHTML = "Question No";
    document.getElementsByClassName('txtSubject')[0].innerHTML = "Subject";
    document.getElementsByClassName('txtAskedBy')[0].innerHTML = "AskedBy";
    document.getElementsByClassName('txtQuestionDtl')[0].innerHTML = "Question Details";
    document.getElementsByClassName('txtDate')[0].innerHTML = "Date";
            document.getElementsByClassName('txtReply')[0].innerHTML = "Reply";
            $('#btnDetail').val('Get Detail');
}
else {
            document.getElementsByClassName('asembly_box_header')[0].innerHTML = "ਨਿਸ਼ਾਨ ਵਾਲੇ ਪ੍ਰਸ਼ਨਾਂ ਦੇ ਜਵਾਬ";
            document.getElementsByClassName('txtSrNo')[0].innerHTML = "ਲੜੀ ਨੰ.";
            document.getElementsByClassName('txtQuestionNo')[0].innerHTML = "ਸਵਾਲ ਨੰ";
            document.getElementsByClassName('txtSubject')[0].innerHTML = "ਵਿਸ਼ਾ";
            document.getElementsByClassName('txtAskedBy')[0].innerHTML = "ਵੱਲੋਂ ਪੁੱਛਿਆ ਗਿਆ";
            document.getElementsByClassName('txtQuestionDtl')[0].innerHTML = "ਪ੍ਰਸ਼ਨ ਵੇਰਵੇ";
            document.getElementsByClassName('txtDate')[0].innerHTML = "ਤਾਰੀਖ਼";
            document.getElementsByClassName('txtReply')[0].innerHTML = "ਜਵਾਬ";
            $('#btnDetail').val('ਵੇਰਵੇ ਪ੍ਰਾਪਤ ਕਰੋ');
        }

    });
    $("#drpLang").change(function () {
        var selectedLang = document.getElementById('drpLang').value;
        localStorage.setItem("SelectedLang", selectedLang);
        $('#drpLang').val(selectedLang);
        if (selectedLang == "1") {
            document.getElementsByClassName('asembly_box_header')[0].innerHTML = "Starred Questions and Reply";
            document.getElementsByClassName('txtSrNo')[0].innerHTML = "Sr No.";
            document.getElementsByClassName('txtQuestionNo')[0].innerHTML = "Question No";
            document.getElementsByClassName('txtSubject')[0].innerHTML = "Subject";
            document.getElementsByClassName('txtAskedBy')[0].innerHTML = "AskedBy";
            document.getElementsByClassName('txtQuestionDtl')[0].innerHTML = "Question Details";
            document.getElementsByClassName('txtDate')[0].innerHTML = "Date";
            document.getElementsByClassName('txtReply')[0].innerHTML = "Reply";
            $('#btnDetail').val('Get Detail');
        }
        else {
            document.getElementsByClassName('asembly_box_header')[0].innerHTML = "ਨਿਸ਼ਾਨ ਵਾਲੇ ਪ੍ਰਸ਼ਨਾਂ ਦੇ ਜਵਾਬ";
            document.getElementsByClassName('txtSrNo')[0].innerHTML = "ਲੜੀ ਨੰ.";
            document.getElementsByClassName('txtQuestionNo')[0].innerHTML = "ਸਵਾਲ ਨੰ";
            document.getElementsByClassName('txtSubject')[0].innerHTML = "ਵਿਸ਼ਾ";
            document.getElementsByClassName('txtAskedBy')[0].innerHTML = "ਵੱਲੋਂ ਪੁੱਛਿਆ ਗਿਆ";
            document.getElementsByClassName('txtQuestionDtl')[0].innerHTML = "ਪ੍ਰਸ਼ਨ ਵੇਰਵੇ";
            document.getElementsByClassName('txtDate')[0].innerHTML = "ਤਾਰੀਖ਼";
            document.getElementsByClassName('txtReply')[0].innerHTML = "ਜਵਾਬ";
            $('#btnDetail').val('ਵੇਰਵੇ ਪ੍ਰਾਪਤ ਕਰੋ');
        }
        gotoHomePage(selectedLang)
    });

    function gotoHomePage(lang) {
        window.location.href = "/Questions/StarredQuestionandReply?SelectedLang=" + lang;
    }
    function LoadAssemblyData() {

        $('#Assembly').empty();
        $.ajax({
            type: 'GET',

            url: "@Url.Action("GetAssembly", "NevaQuestion")",
           // url: '/NevaQuestion/GetAssembly',
            dataType: 'json',
            /*   data: { id: '' },*/
            success: function (data) {
                var items = '';
                $.each(data, function (i, item) {
                    var rows = "<option value='" + item.AssemblyCode + "'>" + item.AssemblyName + "</option>";
                    $('#Assembly').append(rows);
                });
            },
            error: function (ex) {

            }
        });
        return false;
    }

    function LoadSessionData() {
        //var assmblycode = $('#Assembly :selected').val();
        $('#Session').empty();
        $.ajax({
            type: 'GET',
            url: "@Url.Action("GetSession", "NevaQuestion")",
            //url: '/NevaQuestion/GetSession',
            dataType: 'json',
            //data: { AssemblyCode: assmblycode },
            success: function (data) {

                var items = '';
                $.each(data, function (i, item) {
                    var rows = "<option value='" + item.SessionCode + "'>" + item.SessionName + "</option>";
                    $('#Session').append(rows);
                });
            },
            error: function (ex) {

            }
        });
        return false;
    }

    function LoadSessionDatesData() {
        $('#Date').empty();
        $.ajax({
            type: 'GET',
             url: "@Url.Action("GetSessionDates", "NevaQuestion")",
           // url: '/NevaQuestion/GetSessionDates',
            dataType: 'json',
            //data: { AssemblyCode: assmblycode, SessionCode: sessioncode },
            success: function (data) {
                var items = '';
                $.each(data, function (i, item) {
                    var rows = "<option value='" + item.ID + "'>" + item.SessionDate + "</option>";
                    $('#Date').append(rows);
                });
            },
            error: function (ex) {

            }
        });
        return false;
    }
    function changeAssembly() {
        $('#Session').empty();
        $('#Date').empty();
        var assmblycode = $('#Assembly :selected').val();
        $.ajax({
            type: 'GET',
            url: "@Url.Action("GetSessionByAssemblyId", "NevaQuestion")",
            //url: '/Questions/GetSessionByAssemblyId',
            dataType: 'json',
            data: { AssemblyCode: assmblycode },
            success: function (data) {
                var items = '';
                $.each(data, function (i, item) {
                    var rows = "<option value='" + item.SessionCode + "'>" + item.SessionName + "</option>";
                    $('#Session').append(rows);
                });
            },
            error: function (ex) {

            }
        });
        return false;
    }

    function changeSession() {
        $('#Date').empty();
        var assmblycode = $('#Assembly :selected').val();
        var sessioncode = $('#Session :selected').val();
     
        $.ajax({
            type: 'GET',
             url: "@Url.Action("GetSessionDateByAssemblyId", "NevaQuestion")",
        
            dataType: 'json',
            data: { AssemblyCode: assmblycode, SessionCode: sessioncode },
            success: function (data) {
                var items = '';
                $.each(data, function (i, item) {
                    var rows = "<option value='" + item.ID + "'>" + item.SessionDate + "</option>";
                    $('#Date').append(rows);
                });
            },
            error: function (ex) {

            }
        });
        return false;
    }

    function changeSessionDate() {
        $('#introbillstbl tbody').empty();
        var assmblycode = $('#Assembly :selected').val();
        var sessionid = $('#Session :selected').val();
        var sessionDateId = $('#Date :selected').val();
        var captcha = $('#CaptchaText').val();
        if (captcha == "") {

            alert("Please Enter Captcha.");
            return false;
        }
        $.ajax({
            type: 'GET',
            url: '/Questions/GetStarredQuestionsdetailsByAssemblyId',
            dataType: 'json',
            data: { AssemblyCode: assmblycode, Sessioncode: sessionid, sessionDateID: sessionDateId, Captcha: captcha },
            success: function (data) {
                var items = '';
                if (data.length != 0) {
                    $.each(data, function (i, item) {
                        i = i + 1;
                        if (item.Errormsg != "" && item.Errormsg != null)
                        {
                            alert(item.Errormsg);
                            var rows = "<tr><td> No records found1...</td></tr>";
                            $('#introbillstbl').append(rows);
                        }
                        else {
                            var rows = "<tr>"
                                + "<td>" + i + "</td>"
                                + "<td>" + item.QuestionNumber + "</td>"
                                + "<td>" + item.Subject + "</td>"
                                + "<td>" + item.AskedBy + "</td>"
                                + "<td>" + item.MainQuestion + "</td>"
                                + "<td>" + item.SessionDate + "</td>"
                                + "<td><a href='" + item.AnswerAttachLocation + "' target='_blank' class='btn btn-success'>Reply</a></td>"
                                + "</tr>";
                            $("#introbillstbl").append(rows);
                        }
                    });
                }
                else {
                    var rows = "<tr><td> No records found2...</td></tr>";
                    $('#introbillstbl').append(rows);
                }
            },
            error: function (ex) {

            }
        });
        return false;
    }







</script>