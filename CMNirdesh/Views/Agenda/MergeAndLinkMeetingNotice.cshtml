    function loadVenueList() {
        $.ajax({
            url: '@Url.Action("getVanueList", "Agenda")' ,  // Replace with the correct controller and action URL
            type: 'GET',
            success: function (data) {
                var venueDropdown = $('#venue');
                venueDropdown.empty();  // Clear any existing options
                venueDropdown.append('<option value="0">-Select-</option>');  // Default option

                // Check if data is returned and is an array
                if (Array.isArray(data) && data.length > 0) {
                    // Loop through the data and append each venue as an option
                    $.each(data, function (index, venue) {
                        venueDropdown.append('<option value="' + venue.VenueId + '">' + venue.VenueName + '</option>');
                    });
                } else {
                    // Optionally handle if no venues are returned (e.g., add a "No venues available" option)
                    venueDropdown.append('<option value="0">No venues available</option>');
                }
            },
            error: function () {
                alert("Error loading venue list.");
            }
        });
    }


