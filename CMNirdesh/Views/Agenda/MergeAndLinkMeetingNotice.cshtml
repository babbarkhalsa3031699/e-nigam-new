   <script>
//SMS functions
    function SendSMS(agendaid, meetingdate) {
    $('#ulCouncillors').html('');
    $("#loader-wrapper").show();
    $("#hdnMeetingDate").val(meetingdate);
    $.ajax({
    type: "GET",
    // url: pathurl,
    url: '@Url.Action("getDeptWiseCouncillorslist", "Agenda")',
    async: true,
    data: { agendaid: agendaid },
    beforeSend: function () {
        $('#loader-wrapper').show();
    },
    success: function (data) {
        var options = {
            "backdrop": "static",
            keyboard: true
        };
        $("#loader-wrapper").hide();

        if (data) {
            $("#mySMSModal").css("display", "block");
            if (data.length > 0) {
                //console.log(data);
                $.each(data, function (i, item) {

                    html = "<li class='col-4'>";
                    html += "<input type='checkbox' id='ddlChkCouncillors' class='parent-checkbox checkboxItem' name='SelectedCouncillors' value=" + item.MobileNo + " /> " + item.councillorname;
                    html += "</li>";

                    $('#ulCouncillors').append(html);
                });
            }
            else {
                html = "<tr role='row'><td colspan='2'>" +
                    "Data not available" +
                    "</td>'</tr > ";
                $('#ulCouncillors').append(html);
            }

        } else { alert("error"); }
        $("#loader-wrapper").hide();
    },
    error: function (xhr, ajaxOptions, thrownError) {
        alert(xhr.responseText);
        alert(thrownError);
        $("#loader-wrapper").hide();
    },
    complete: function (results) {
        $('#loader-wrapper').hide();

    }
});
}
$(document).ready(function(){
    $("#btnSendSms").click(function () {
        var selectedMembers = [];
        $('input[name="SelectedCouncillors"]:checked').each(function () {
            var checkboxValue = $(this).val();
            var checkboxText = $(this).closest('li').text().trim();
            var meetingdate = $("#hdnMeetingDate").val();

            var concatenatedString = checkboxValue + ' - ' + checkboxText + '-' + meetingdate;
            selectedMembers.push(concatenatedString);

           // selectedMembers.push($(this).closest('label').text().trim() + '-' +$(this).val());
        });

        if (selectedMembers.length < 1) {
            alert("Select Atleast 1 Member");
            return;
        }
        $.ajax({
            url: '@Url.Action("SendMeetingSMS", "Agenda")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(selectedMembers),
            success: function (response) {
                alert("SMS Sent Successfully");
                $("#mySMSModal").modal('hide');
                //$('#result').html(response);
            },
            error: function (xhr, status, error) {
                alert("Error while sending SMS");
                console.error(xhr.responseText);
            }
        });
    });
});
    $('#txtSearch').keyup(function () {
        var searchText = $(this).val().toLowerCase();

        $('#ulCouncillors li').each(function () {
            var text = $(this).text().toLowerCase();
            var match = text.indexOf(searchText) > -1;
            $(this).toggle(match);
        });
    });
    // Select all functionality
    $('#selectAll').click(function () {
        $('.checkboxItem').prop('checked', $(this).prop('checked'));
    });

    // Update "Select All" checkbox state when individual checkboxes are clicked
    $(document).on('click', '.checkboxItem', function () {
        if ($('input[name="SelectedCouncillors"]:checked').length === $('.checkboxItem').length) {
            $('#selectAll').prop('checked', true);
        } else {
            $('#selectAll').prop('checked', false);
        }
    });

    function ClosePopUp() {
       $('#myModal').hide();
    }
    </script>
