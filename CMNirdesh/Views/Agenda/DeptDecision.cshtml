            var term = $("#DispatchTerm").val();
            var priority = $("#DispatchPriority").val();
            var type = $("#DispatchDocument").val();
            var radiovalue = document.querySelector('input[name="radio_list"]:checked').value;
            if (radiovalue == "List") {

                if (since != "" || deptid != "" || status != "10" || term != "" || priority != "" || type != "") {
                    GetDataForDispatchN();
                }
                else {
                    GetDataForDispatch();
                }

                $("#listdiv").css("display", "block");
                $("#statusdiv").css("display", "none");
            }
            else {
                if (since != "" || deptid != "" || status != "10" || term != "" || priority != "" || type != "") {
                    GetDataForDispatchStatusN();
                }
                else {
                    GetDataForDispatchStatus();
                }
                $("#statusdiv").css("display", "block");
                $("#listdiv").css("display", "none");
            }
