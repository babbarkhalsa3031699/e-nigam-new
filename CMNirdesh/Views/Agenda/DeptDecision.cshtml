    function GetDataForDispatchStatus() {
      //  $('#DocumentTypeDIdHdn').val(type);

        var status = '10';
        var deptid = '';
        var officeid = '';
        var term = '';
        var priority = '';
        var type = '';



        $.ajax({
            type: "GET",
              url: '@Url.Action("GetDataForDiaryDashboardStatusorder", "Agenda")',
            datatype: "Json",
                contentType: "application/json; charset=utf-8",
            data: { DocumentType: type, status: status, deptid: deptid, officeid: officeid, term: term, priority: priority },
            success: function (result) {


                if (result.length > 0) {

                    //$("#MeetingTable").html(result);
                    $("#loader-wrapper").hide();
                    $("#MeetingTable").DataTable({
                        "bLengthChange": false,
                        dom: 'Bfrtip',
                        buttons: [
                            'excelHtml5',
                            'csvHtml5',
                            'pdfHtml5'
                        ],
                     
                        columnDefs: [
                            {
                                target: 0,
                                visible: false,
                                searchable: false,
                            }
                        ],
                        order: [[0, 'desc']]
                    });
                    $("#MeetingTable").removeClass("dataTable");

                }
                else {
                    $("#MeetingTable").DataTable();
                    $("#MeetingTable").html("No Data Found");
                    $("#loader-wrapper").hide();
                }
            },
            error: function (result) {
                $("#loader-wrapper").hide();
            }

        });
        showdepartmentD();
        GetAgendaDateD();
        DispatchDocument();
    }

