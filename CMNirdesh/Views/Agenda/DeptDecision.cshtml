    function ResetD() {
            $("#StatusListMlaD").prop("disabled", false);
            $("#sincefilterdispatch").prop("disabled", false);
            $("#DispatchDepartment").prop("disabled", false);
            $("#DispatchoffId").prop("disabled", false);
            $("#DispatchTerm").prop("disabled", false);
