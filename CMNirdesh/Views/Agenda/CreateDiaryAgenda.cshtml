@model  CMNirdesh.Models.AgendaModel

@{
    var FileSettings = CMNirdesh.Models.FileSetting.GetSecureFileSettingLocation();
    string path = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"] + "/MlaDiary/TempFile/";
}

<style>
    .btn.add_btn {
        margin-top: 21px;
    }
</style>
<body>
    @Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")

    <div class="main-content cm_fund fund_rcipt">
        @using (Html.BeginForm("SaveDiaryAgenda", "Agenda", FormMethod.Post, new { @id = "formAgenda", enctype = "multipart/form-data" }))
        {
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Create Diary Agenda</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">

                                <div class="form-group col-sm-6 col-md-3 col-lg-3">
                                    <label for="inputEmail4" class="txt_label">Agenda Name:</label>
                                    @Html.TextBoxFor(m => m.AgendaName, new { @id = "txtAgendaName", @tabindex = "1", @class = "form-control txt_design", @required = "required" })
                                </div>

                                <div class="form-group col-sm-6 col-md-3 col-lg-3">
                                    <label for="inputPassword4" class="txt_label">Agenda Date:</label>
                                    @Html.TextBoxFor(m => m.AgendaDate, new { @type = "Date", @id = "txtallocationdate", @tabindex = "3", @class = "form-control txt_design", @required = "required" })
                                    @*<input type="date" class="form-control" id="txtdate" placeholder="AllocationDate">*@
                                </div>

                                <div class="form-group col-sm-6 col-md-3 col-lg-3">
                                    <label for="inputPassword4" class="txt_label">Remarks:</label>
                                    @Html.TextBoxFor(m => m.Remarks, new { @type = "text", @id = "txtremarks", @tabindex = "5", @class = "form-control txt_design", @required = "required" })
                                </div>

                                <div class="form-group col-sm-12 col-md-3 col-lg-3">
                                    <input type="submit" value="Add Agenda" class="btn add_btn" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                @{Html.RenderPartial("~/Views/Agenda/_AgendaList.cshtml", Model);}
            </div>
        }
    </div>
</body>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Agenda</title>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
