    function ShowSD(id) {
        $("#SD_" + id).toggle();
        $(".LG_" + id).toggle();
        var IC = $("#Icon_" + id).attr('class');

        if (IC == 'fa fa-plus-square') {
            $("#Icon_" + id).removeClass("fa fa-plus-square");
            $("#Icon_" + id).addClass("fa fa-minus-square");
        } else {
            $("#Icon_" + id).removeClass("fa fa-minus-square");
            $("#Icon_" + id).addClass("fa fa-plus-square");
        }

        var sbhtml = $("#IncludeSB_" + id).val();
        tinymce.remove("#IncludeSB_" + id);

        tinyMCE.init({
            selector: "#IncludeSB_" + id,
            mode: "textarea",
            branding: false,
            menubar: true,
            readonly: true,
            toolbar: '',
            menubar: '',
            plugins: 'autoresize',
            content_style:
                "body {  font-size: 16px; font-family: Poppins, sans-serif ; }",
            init_instance_callback(editor) {
                editor.setContent(sbhtml);
            }
        });

    }

