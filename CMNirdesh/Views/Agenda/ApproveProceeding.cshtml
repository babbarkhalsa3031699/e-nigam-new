<style>
    .dt-rowReorder-moving td:first-child .fa-arrow-up {
        color: green;
    }

    .dt-rowReorder-moving td:first-child .fa-arrow-down {
        color: red;
    }

    .serial {
        width: 4%;
    }

    .grab {
        cursor: grab;
    }

    /*.main-content.cm_fund table.table thead tr th, .main-content .cm_fund table.table thead tr th {
        background-color: #ccd1dd !important;
    }*/

    body.dragging, body.dragging * {
        cursor: move !important;
    }

    .dragged {
        position: absolute;
        opacity: 0.5;
        top: 0;
        z-index: 2000;
    }

    .sorted_table tr.placeholder {
        display: block;
        background: red;
        position: relative;
        margin: 0;
        padding: 0;
        border: none;
    }

    .sorted_table tr {
        cursor: pointer;
    }

        .sorted_table tr.placeholder::before {
            content: "";
            position: absolute;
            width: 0;
            height: 0;
            border: 5px solid transparent;
            border-right-color: transparent;
            border-right-style: solid;
            border-right-width: 5px;
            border-left-color: transparent;
            border-left-color: red;
            margin-top: -5px;
            left: -5px;
            border-right: none;
        }

    .dragged {
        background-color: black !important;
    }

    #btnaddref {
        float: right;
    }

    #includedivbutton {
        float: right;
    }

    .voteyes {
        color: green;
        font-size: 28px !important
    }

    .voteno {
        color: grey !important;
        font-size: 28px !important;
        margin-left: 10px
    }

    .generate {
        color: green !important;
        cursor: pointer;
    }

    
    .SDHide {
        display: none;
    }
    .grey-extra-notes {
        margin-top: 10px;
        border-radius:0.5rem;
        /*background: lightgray;*/
        border: 1px solid lightgrey;
        padding: 15px;
    }
    .hand{
        cursor:pointer;
    }
    .noadded {
        background-color: #b5b5b5 !important;
    }
</style>

