        $("#loader-wrapper").hide();

        if (data) {
            $("#mySMSModal").css("display", "block");
            if (data.length > 0) {
                //console.log(data);
                $.each(data, function (i, item) {

                    html = "<li class='col-4'>";
                    html += "<input type='checkbox' id='ddlChkCouncillors' class='parent-checkbox checkboxItem' name='SelectedCouncillors' value=" + item.MobileNo + " /> " + item.councillorname;
                    html += "</li>";

                    $('#ulCouncillors').append(html);
                });
            }
            else {
                html = "<tr role='row'><td colspan='2'>" +
                    "Data not available" +
                    "</td>'</tr > ";
                $('#ulCouncillors').append(html);
            }

        } else { alert("error"); }
        $("#loader-wrapper").hide();
    },
    error: function (xhr, ajaxOptions, thrownError) {
        alert(xhr.responseText);
        alert(thrownError);
        $("#loader-wrapper").hide();
    },
    complete: function (results) {
        $('#loader-wrapper').hide();

    }
});
}
