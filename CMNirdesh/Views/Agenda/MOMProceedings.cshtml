       function loadContacts(agendaId) {
        $.ajax({
            url: '@Url.Action("GetCirculationContacts", "Agenda")',
            type: 'GET',
            data: {
                Department: agendaId
            },
            success: function (data) {
                let grouped = groupBy(data, 'OfficeType');
                let html = '';

                for (let officeType in grouped) {
                    html += `
                        <tr class="group-header table-primary" data-group="${officeType.trim()}">
                          <td colspan="4" class="fw-bold">
                            <i class="fa fa-landmark me-2 text-primary"></i> ${officeType}
                          </td>
                          <td class="text-end">
                            <label class="form-check-label me-2" for="selectAll-${officeType.trim()}"></label>
                            <input type="checkbox"
                                   class="form-check-input select-all-group"
                                   id="selectAll-${officeType.trim()}"
                                   data-group="${officeType.trim()}"
                                   title="Select All in ${officeType}" />
                          </td>
                        </tr>
                        `;
                    grouped[officeType].forEach(function (item) {
                        html += `
                            <tr>
                                <td>${item.Name}</td>
                                <td>${item.Designation}</td>
                                <td>${item.MobileNo}</td>
                                <td>${item.EmailId}</td>
                                <td>
                                    <div class="form-check d-flex align-items-center gap-2">
                                        <input class="form-check-input" type="checkbox" value="${item.MobileNo}">
                                        <span class="delete-icon" style="cursor: pointer;" onclick="removeRow(this)">❌</span>
                                    </div>
                                </td>
                            </tr>`;
                    });
                }

                $('#contactBody').html(html);
            }
        });
        }

