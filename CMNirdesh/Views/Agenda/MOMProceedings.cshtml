       function saveManualRow(btn) {
            const row = $(btn).closest('tr');
            const inputs = row.find('input');
            const userType = row.find('.usertype-select').val().trim();
            const name = inputs.eq(0).val().trim();
            const designation = inputs.eq(1).val().trim();
            const mobile = inputs.eq(2).val().trim();
            const email = inputs.eq(3).val().trim();

            if (!name || !designation || !mobile || !userType) {
                alert("All fields are required.");
                return;
            }
            const normalizedUserType = userType;
            const groupIcon = normalizedUserType === 'House' ? '🏠' : '🏛️';
            let $existingHeader = null;
            $('#contactBody .group-header').each(function () {
                const val = $(this).data('group');
                if (val && val.toString().trim() === normalizedUserType) {
                    $existingHeader = $(this);
                    return false;
                }
            });
            const newRowHtml = `
            <tr>
            <td>${name}</td>
            <td>${designation}</td>
            <td>${mobile}</td>
            <td>${email}</td>
            <td>
                <div class="form-check d-flex align-items-center gap-2">
                    <input class="form-check-input" type="checkbox" value="${mobile}">
                  <span class="delete-icon" style="cursor: pointer;" onclick="removeRow(this)">❌</span>
                </div>
            </td>
            </tr>`;

            if ($existingHeader) {
                const $groupRows = $existingHeader.nextUntil('.group-header');
                if ($groupRows.length > 0) {
                    $groupRows.last().after(newRowHtml);
                } else {
                    $existingHeader.after(newRowHtml);
                }
            } else {
                const newHeader = `<tr class="group-header" data-group="${userType.trim()}"><td colspan="5">${groupIcon} ${userType}</td></tr>`;
                $('#contactBody').append(newHeader + newRowHtml);
            }
            row.remove();
            alert("Saved successfully");

            // Remove the manual input header and row if no other manual rows exist
            $('.manual-header').remove();
        }

