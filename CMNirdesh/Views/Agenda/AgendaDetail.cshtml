                                            <div id="refdiv" style="display:none">
                                                <div class="row">
                                                    <div class="form-group col-sm-12 col-md-12 col-lg-12">
                                                        <label for="inputEmail4" class="txt_label">Letter Number:</label>
                                                      @Html.TextBoxFor(m=> m.NewLetterNo, new { @id = "txtletterno", @tabindex = "1", @class = "form-control txt_design", @required = "required" })
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group col-sm-12 col-md-12 col-lg-12">
                                                        <label for="inputEmail4" class="txt_label">Subject:</label>
                                                        @Html.TextAreaFor(m => m.NewSubject, new { @id = "txtsubject", @tabindex = "1", @class = "form-control txt_design", @required = "required" })
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group col-sm-6 col-md-3 col-lg-3">
                                                        <label for="inputattach" class="txt_label">Attachment:</label>
                                                        <div id="divAcfile" class="file_btn_width">
                                                            <div class="input-group">
                                                                <label class="lbl_file">
                                                                    <span class="fileinput-button file_btn">
                                                                        <span>Choose file</span>
                                                                        <input id="fileupload1" type="file" name="fileupload1" accept=".pdf" tabindex="6" style="display:none">
                                                                    </span>
                                                                </label>
                                                            </div>
                                                            @Html.HiddenFor(m => m.IsFile)

                                                            <a href="#" id="afile_nameEn" target="_blank" class="pdf_link">  <span id="file_nameEn" class="file_nameEn"></span></a>
                                                            <span class="file_sizeEn"></span>
                                                            <div style="width: 100%;" id="fileuploadcontant1">
                                                                <div style="width: 100%;">
                                                                    <span id="removefileupload1" onclick="removefileupload()" class="fa fa-close" style="color: red; float: left; display: none; margin-left: 125px; cursor:pointer;"></span>

                                                                </div>
                                                                <div style="width: 100%;">
                                                                    <div class="show_hide">
                                                                        <div class="progress12" style="height: 10px; width: 100%">
                                                                            <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="5" style="width: 0%;">
                                                                                <span class="sr-only">0% complete</span>
                                                                            </div>

                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="form-group col-sm-12 col-md-12 col-lg-12">
                                                        @Html.EditorFor(m => m.NewSubjectDetails, new { @id = "txtSubjectDetails", @tabindex = "7" })
                                                        @*@Html.Raw(Model.NewSubjectDetails)*@
                                                        @Html.HiddenFor(m => m.HdnAgendaId, new { @id = "hdnAgendaId" })

                                                    </div>
                                                </div>


                                            </div>
                                        </div>

                                        <div class="modal-footer">
                                            <button id="btnadd" type="submit" class="btn btn-primary">Add</button>
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>


                </div>
</body>


