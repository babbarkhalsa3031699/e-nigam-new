                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                @using (Html.BeginForm("AddNewRef", "Agenda", FormMethod.Post, new { @id = "formAgenda", enctype = "multipart/form-data" }))
                                {
                                    if (Model.IsOpen)
                                    {
