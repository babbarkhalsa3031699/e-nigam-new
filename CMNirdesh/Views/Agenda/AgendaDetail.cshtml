    function Getdata() {

        var userid = $("#ddlagenda").val();

        if (userid != "") {

            $('#btngetagenda').click();
        } else {

            $('.AgendaRefDetail').hide();
            $('#refdiv').hide();
        }
    }


    function showdiv() {

        $('#NewAgendaModal').modal('show');
        $('#refdiv').show();
        var aid = $('#ddlagenda').val();
        $('#hdnAgendaId').val(aid);
        return false;
    }

    function ViewSB(refid) {
        var sb = $('textarea#sb_' + refid).val();
        var sb = "<div style='padding: 40px;'>" + sb + "</div>";

        $('#SubjectDetailBody').html(sb);
        $('#SubjectDetailModel').modal('show');

    }

    function SendtoLOB() {

        var agendid = $("#ddlagenda").val();

        if (agendid != "") {
            var categories = [];
            var roworder = "";
            $('#tableRef').DataTable().rows().every(function (rowIdx, tableLoop, rowLoop) {
                categories.push(this.data().at(1));
                roworder = roworder + this.data().at(1) + ","
            });
            var n = roworder.lastIndexOf(",");
            roworder = roworder.substring(0, n);
            console.log(roworder);

            var pathurl = '/Agenda/FreezeAgenda';
            $.ajax({
                type: "GET",
                url: pathurl,
                async: true,
                data: { AID: agendid, RowOrder: roworder  },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {

                    $("#loader-wrapper").hide();

                    if (data) {
                        alert("Data Saved Successfully.");

                    } else { alert("error"); }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();
                }
            });


        } else {


        }
    }


    function Delete (id){

        if (id != "") {

            var pathurl = '/Agenda/DeleteAgendaDetail';

            $.ajax({
                type: "GET",
                url: pathurl,
                async: true,
                data: { AgendaDetailId: id },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {

                    $("#loader-wrapper").hide();

                    if (data) {
                        $("#tr_"+id).hide();

                    } else { alert("error"); }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();
                }
            });
        }

    }

</script>


