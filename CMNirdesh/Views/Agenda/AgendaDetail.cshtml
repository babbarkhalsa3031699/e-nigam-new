                                                    <th class="center " style="background-color: rgb(206, 107, 48); color: white; ">Letter Number</th>
                                                    <th class="center " style="background-color: rgb(206, 107, 48); color: white; ">Subject</th>
                                                    <th class="center " style="background-color: rgb(193, 33, 33); color: white; ">Attatched File</th>
                                                    <th class="center " style="background-color: rgb(193, 33, 33); color: white; ">Subject Details</th>
                                                    <th class="center " style="background-color: rgb(193, 33, 33); color: white; ">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{int a = 1;}
                                                @foreach (var mdl in Model._LstReferences)
                                                {

                                                    <tr id="tr_@mdl.Id">
                                                        <td>@a</td>
                                                        <td>@mdl.Id</td>
                                                        <td>@mdl.RefId</td>
                                                        <td>@mdl.LetterNo</td>
                                                        <td>@mdl.Subject</td>
                                                        <td>
                                                            @{

                                                                string Enpath1 = System.Web.Configuration.WebConfigurationManager.AppSettings["Site"] + @mdl.attachedfile; }
                                                            @if (!string.IsNullOrEmpty(@mdl.attachedfile))
                                                            {
                                                                <a href="@Enpath1" target="_blank">
                                                                    <img src="~/Assets/Home_Images/PDF.png" alt="Download" title="Download Enclosure" width="24" height="24" />
                                                                </a>
                                                            }
                                                            else
