                   if (id != "") {

            //var pathurl = '/Agenda/DeleteAgendaDetail';

            $.ajax({
                type: "GET",
                url: '@Url.Action("DeleteAgendaDetail", "Agenda")',

                async: true,
                data: { AgendaDetailId: id },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {

                    $("#loader-wrapper").hide();

                    if (data) {
                        $("#tr_"+id).hide();

                    } else { alert("error"); }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();
                }
            });
        }
        }


    }


    function voting(id, isvote) {
        if (id != "") {

            //var pathurl = '/Agenda/LockUnlockAgenda';

            $.ajax({
                type: "GET",
                 url: '@Url.Action("VotingAgenda", "Agenda")',
                async: true,
                data: { AgdId: id, IsVote: isvote },
                beforeSend: function () {
                    $('#loader-wrapper').show();
                },
                success: function (data) {

                    $("#loader-wrapper").hide();

                    if (data) {
                        if (isvote) {
                            $("#unf_" + id).show();
                            $("#fr_" + id).hide();
                        } else {
                            $("#unf_" + id).hide();
                            $("#fr_" + id).show();
                        }
                        // $("#tr_" + id).hide();

                    } else { alert("error"); }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(xhr.responseText);
                    alert(thrownError);
                },
                complete: function (results) {
                    $('#loader-wrapper').hide();
                }
            });
        }

    }

