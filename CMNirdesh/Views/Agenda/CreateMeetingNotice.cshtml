                $('.timepicker').timepicker({
                    timeFormat: 'h:mm p',
                    interval: 30,
                    minTime: '0:00am',
                    maxTime: '11:30pm',
                    defaultTime: '12:00am',
                    startTime: '12:00am',
                    dynamic: false,
                    dropdown: true,
                    scrollbar: true,
                    showMeridian: true
                }).keydown(function (event) {
                    // Allow: backspace, delete, tab, escape, enter, and punctuation keys
                    if (
                        event.keyCode === 46 ||
                        event.keyCode === 8 ||
                        event.keyCode === 9 ||
                        event.keyCode === 27 ||
                        event.keyCode === 13 ||
                        (event.keyCode === 65 && event.ctrlKey === true) ||
                        (event.keyCode >= 35 && event.keyCode <= 39)
                    ) {
                        return;
                    } else {
                        // Ensure only valid time characters are entered (0-9, :, AM, PM)
                        var input = String.fromCharCode(event.keyCode);
                        var isValidInput = /^[0-9:\sAaPpMm]+$/.test(input);
                        if (!isValidInput) {
                            event.preventDefault();
                        }
                        if (event.key.toLowerCase() === 'a' || event.key.toLowerCase() === 'm') {
                            event.preventDefault();
                        }
                    }
                });

