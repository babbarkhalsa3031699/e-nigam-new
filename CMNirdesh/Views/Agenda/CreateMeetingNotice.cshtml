    var userid;
    function GetById(UserId) {
    clearTextBox();
    userid = UserId;

    $.ajax({
        type: "GET",
        url: '@Url.Action("EditAgendaMeeting", "Agenda")' + '?id=' + UserId,
        contentType: "application/json;charset=utf-8",
