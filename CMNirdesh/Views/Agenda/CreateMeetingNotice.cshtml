                $("#agendaStatus").val(data[0].Status);
                $("#agendaStatus").change();
                $("#AgendaID").val(UserId);
                $("#Header").val(data[0].Header);
                $("#meetingdate").val(data[0].MeetingDate);
                $("#starttime").val(data[0].StartTime);
                $("#lasttime").val(data[0].EndTime);
            }
        },
        error: function () {
            alert("Error fetching agenda details.");
        }
    });
}

