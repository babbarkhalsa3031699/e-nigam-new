    function Update() {
        ///alert(userid);
        var empObj = {
            AgendaId: userid,
            AgendaDate: $('#meetingdate').val(),
            AgendaName: $('#meetingname').val(),
            StartTime: $('#starttime').val(),
            EndTime: $('#lasttime').val(),
            Status: $('#agendaStatus').val(),
            Venue: $('#venue').val(),
            Header: $('#Header').val()
        };
        $.ajax({
            url: '@Url.Action("UpdateMeetingNotice", "Agenda")',
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                alert("Updated Successfully");
                $('#myModal').modal('hide');
                location.reload();

            },
            error: function (errormessage) {
                alert("Not Updated");
                $('#myModal').modal('hide');
                location.reload();
            }
        });
    }


