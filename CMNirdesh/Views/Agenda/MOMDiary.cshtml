    <style>
        .btn-attractive-add {
            background: linear-gradient(135deg, #00c851, #007e33); /* green gradient */
            color: #fff;
            padding: 10px 20px;
            font-size: 15px;
            font-weight: bold;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .btn-attractive-add:hover {
                background: linear-gradient(135deg, #28a745, #1e7e34);
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
            }

            .btn-attractive-add:active {
                transform: scale(0.98);
                box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
            }
        .select-all-group {
            float: right;
            transform: scale(1.3);
            cursor: pointer;
        }

        .group-header {
            background-color: #e3f2fd;
            font-size: 1rem;
        }

        .covering-letter-cell {
            white-space: nowrap;
        }

        .covering-letter-entry {
            gap: 0.5rem;
        }

        .covering-letter-btn {
            background-color: #dc3545; /* Bootstrap danger */
            color: white;
            padding: 6px 12px;
            font-size: 0.875rem;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

            .covering-letter-btn:hover {
                background-color: #bd2130;
                text-decoration: none;
                color: white;
            }
    </style>

