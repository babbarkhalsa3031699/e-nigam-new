        var selectedCoveringPdfPaths = [];

        function UpdateCoveringLetterStatus(obj) {
            var pdfPath = $(obj).attr('pdfpath'); // attribute name is case-sensitive

            if (!pdfPath) return;

            const path = pdfPath.trim();

            if ($(obj).prop("checked")) {
                if (!selectedCoveringPdfPaths.includes(path)) {
                    selectedCoveringPdfPaths.push(path);
                }
            } else {
                selectedCoveringPdfPaths = selectedCoveringPdfPaths.filter(p => p !== path);
            }



            // Update hidden field if needed
            $("#SelectedCoveringLetters").val(selectedCoveringPdfPaths.join(','));
           // alert(selectedCoveringPdfPaths);

        }
