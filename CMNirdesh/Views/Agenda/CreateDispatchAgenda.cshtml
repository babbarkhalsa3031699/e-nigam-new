     var userid;
    function GetById(UserId) {

        clearTextBox();
        userid = UserId;

        $.ajax({
            type: "GET",
            url: '@Url.Action("Edit", "Agenda")' + '?id=' + UserId,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                $('#DisplayModal').show();

                var agendaData = JSON.parse([data]); // Parse the JSON string into an object

                //var date = new Date(agendaData[0].AgendaDate);
                //var formattedDate = date.toLocaleDateString("en-GB");  // Format the date as "dd/MM/yyyy"

                //$("#meetingdate").val(formattedDate);

                var now = new Date(agendaData[0].AgendaDate);

                var day = ("0" + now.getDate()).slice(-2);
                var month = ("0" + (now.getMonth() + 1)).slice(-2);
                var today = now.getFullYear() + "-" + (month) + "-" + (day);
                $("#meetingdate").val(today);

                $("#meetingname").val(agendaData[0].AgendaName);
                /*$("#meetingdate").val(agendaData[0].AgendaDate);*/
                $("#Proceedingfirstpageheader").val(agendaData[0].Header);
                $("#proceedinglastpageheader").val(agendaData[0].Footer);
                $("#starttime").val(agendaData[0].StartTime);
                $("#lasttime").val(agendaData[0].EndTime);
                $("#agendatype").val(agendaData[0].Agendatype);
                $("#agendaStatus").val(agendaData[0].Status); 
                const headerElement = document.getElementById('header');
                headerElement.innerText = agendaData[0].Header;

                const footerElement = document.getElementById('footer');
                footerElement.innerText = agendaData[0].Footer;

            }


        });
    }





