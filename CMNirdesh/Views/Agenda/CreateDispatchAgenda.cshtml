     function validateForm() {

        // Get the form inputs

            // Get the form inputs
            var meetingname = document.getElementById('meetingname');
        var meetingdate = document.getElementById('meetingdate');

        var header = document.getElementById('Proceedingfirstpageheader');
        var footer = document.getElementById('proceedinglastpageheader');
            var starttime = document.getElementById('starttime');
            var lasttime = document.getElementById('lasttime');
            var agendatype = document.getElementById('agendatype');

            // Check if any of the required inputs are empty
            if (meetingname.value === '' || meetingdate.value === '' || header.value === '' || footer.value === '' || starttime.value === '' ||  agendatype.value === '') {
                alert('Please fill in all the required fields.');
                return;
            }

            // All required fields are filled, proceed with the form submission
            Update();

        }



    function Update() {

        var empObj = {
            AgendaId: userid,
            AgendaDate: $('#meetingdate').val(),
            AgendaName: $('#meetingname').val(),
            Header: $('#Proceedingfirstpageheader').val(),
            Footer: $('#proceedinglastpageheader').val(),
            StartTime: $('#starttime').val(),
            EndTime: $('#lasttime').val(),
            Agendatype: $('#agendatype').val(),
            Status:$("#agendaStatus").val() 
        };

        $.ajax({
            url: '@Url.Action("Update", "Agenda")',
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                // loadData();
                alert("Updated Successfully");
                $('#myModal').modal('hide');
                location.reload();

            },
            error: function (errormessage) {
                alert("Not Updated");
                $('#myModal').modal('hide');
                location.reload();
            }
        });
    }
