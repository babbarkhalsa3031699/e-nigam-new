@model CMNirdesh.Models.MCHouse.HomeDashBoard
@using CMNirdesh;

@{
    ViewBag.Title = "Index";

}

<script src="~/Scripts/tinymce/tinymce.min.js"></script>
<script src="~/Scripts/jquery.ui.widget.js"></script>
<script src="~/Scripts/jquery.fileupload.js"></script>
<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
@*<link href="~/Content/style_ms.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />*@
<script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>


<div id="main-content">

    <div class="main-content">

        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Home DashBoard </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" style="font-size:14px;" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i>Add Home DashBoard Items</button>
                            </div>
                        </div>
                    </div>

                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model._LstHomeDashBoard.Count() > 0)
                            {
                                <div class="table-responsive">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">MC Name</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Houses</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Councilors</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">HouseMeetings</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Departments</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">FCCMeetings</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Employees</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._LstHomeDashBoard)
                                            {

                                                <tr>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.MCName, "--")</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Houses, "--")</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Councilors, "--")</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.HouseMeetings, "--")</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Departments, "--")</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.FCCMeetings, "--")</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Employees, "--")</td>

                                                    <td class="center td-data edit-1" style="font-size:14px; padding: 14px 4px !important">
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <input type="hidden" id="mcid" value="@items.MCId" />


                                                        </div>
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MCId')" value="@items.MCId" />
                                                            <label class="toggle mb-0">
                                                                <input type="checkbox" onclick="DeleteDepartmentRecord('@items.MCId')" @(Convert.ToBoolean(items.IsDeleted) == true ? "checked='checked'" : string.Empty)>
                                                                <span class="slider"></span>
                                                                <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>

                </div>
                
            </div>

            <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add HomeDashBoard Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            <div class="form-group" id="StateName">
                                <div class="profile-info-name fotm_lbl">MC:</div>
                                <select id="StatesDropDown">
                                    <option value="select" class="form-control txt_design" id="SelectId" placeholder="State Name"></option>
                                </select>
                            </div>
                        
                        </div>
                        <div class="modal-footer" style="background-color:white;">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

        </section>

    </div>

</div>
<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
    <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
</a>


<style>


    .inr_frm_dsgn {
        /*margin-top: 20px;*/
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>





<script>

    $(document).ready(function () {
        $('#example').DataTable({
        });
    });

    //var s = {};


    var s = $("#StatesDropDown");
    s.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
    $.ajax({
        type: "POST",
        url: '@Url.Action("StatesDropDown", "HomeDashboard")',
        data: '{}',
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            s.empty().append('<option selected="selected" value="0">Please select</option>');
            $.each(response, function () {
                s.append($("<option></option>").val(this['Value']).html(this['Text']));
            });
        },
        failure: function (response) {
            alert(response.responseText);
        },
        error: function (response) {
            alert(response.responseText);
        }
    });






    function validate() {
        var isValid = true;
        if ($('#StatesDropDown').val() == 0) {
            $('#StatesDropDown').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#StateDropDown').css('background-color', 'white');
        }
       
        return isValid;
    }

    function Add() {
        debugger

        var res = validate();
        if (res == false) {
            return false;
        }

       
        $('#StatesDropDown').css('background-color', '#ffffff');
       

        var empObj = {
            MCId: $('#StatesDropDown').val(),
           
        };

        $.ajax({
            url: '@Url.Action("Create", "HomeDashboard")',
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                if (result === 0) {
                    alert("Updated Successfully");
                    $('#myModal').hide();
                    location.reload();
                }
                else if (result == 1) {
                    alert("State already existing");

                }
                else {
                    alert("State already existing");
                }
            }
        });
    }
    

  
    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {

        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("Delete", "HomeDashboard")' + '?Id=' + i,
            success: function (result) {
                alert("Updated Successfully");
            }
        });
    }
    function clearTextBox() {
        debugger
        $('#myModal').data({ backdrop: 'static', keyboard: false });
        $('#StatesDropDown').css('background-color', 'white');
       
        $('#btnUpdate').hide();
        $("#myModalLabel").html("Add Record");
        $('#btnSave').show();
        $("#StatesDropDown").val(0);
     
    }

</script>
