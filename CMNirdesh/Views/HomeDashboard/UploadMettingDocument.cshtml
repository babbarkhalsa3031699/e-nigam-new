
@model  CMNirdesh.Models.HouseMeetingsDocuments

@{
    ViewBag.Title = "Upload House Meeting Document";
}

<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/responsive.bootstrap.min.css" rel="stylesheet" />

<script src="~/Scripts/jquery-3.4.1.js"></script>

<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
<script src="~/Scripts/datatables/jszip.min.js"></script>
<script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
<script src="~/Scripts/datatables/vfs-fonts.js"></script>
<script src="~/Scripts/datatables/buttons.print.min.js"></script>
<script src="~/Scripts/datatables/buttons.html5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#example').DataTable({
            order: [[0, 'desc']]
        });

        // Real-time clearing of validation errors
        $('#ddlhno').on('change', function () {
            var val = $(this).val();
            if (val && val.toString().trim() !== "" && val.toString().trim() !== "0" && val.toString().trim() !== "Select House Number") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#ddlhnoError').removeClass('show');
            }
        });

        $('#title').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#titleError').removeClass('show');
            }
        });

        $('#MeetingDate').on('change input', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#MeetingDateError').removeClass('show');
            }
        });

        $('#MeetingType').on('change', function () {
            var val = $(this).val();
            if (val && val.toString().trim() !== "" && val.toString().trim() !== "0" && val.toString().trim() !== "Select Meeting Type") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#MeetingTypeError').removeClass('show');
            }
        });

        $('#file1').on('change', function () {
            var file = this.files && this.files[0];
            if (file) {
                var ext = file.name.substr(file.name.lastIndexOf('.')).toLowerCase();
                if (ext === ".pdf") {
                    $('#uploadCard').removeClass('is-invalid');
                    $('#file1Error').removeClass('show');
                } else {
                    $('#uploadCard').addClass('is-invalid');
                    $('#file1Error').html('<i class="fa fa-exclamation-circle"></i> Only .pdf files are allowed').addClass('show');
                }
            }
        });

        clearTextBox();
        $("#btnUpdate").hide();
        $("#btnSave").show();
    });

    function validate() {
        var isValid = true;
        var firstInvalid = null;

        // 1. House Number
        var hnoVal = $('#ddlhno').val();
        if (!hnoVal || hnoVal.toString().trim() === "" || hnoVal.toString().trim() === "0" || hnoVal.toString().trim() === "Select House Number") {
            $('#ddlhno').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#ddlhnoError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#ddlhno');
        } else {
            $('#ddlhno').removeClass('is-invalid').css('background-color', 'white');
            $('#ddlhnoError').removeClass('show');
        }

        // 2. Title
        var titleVal = $('#title').val();
        if (!titleVal || titleVal.trim() === "") {
            $('#title').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#titleError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#title');
        } else {
            $('#title').removeClass('is-invalid').css('background-color', 'white');
            $('#titleError').removeClass('show');
        }

        // 3. Meeting Date
        var dateVal = $('#MeetingDate').val();
        if (!dateVal || dateVal.trim() === "") {
            $('#MeetingDate').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#MeetingDateError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#MeetingDate');
        } else {
            $('#MeetingDate').removeClass('is-invalid').css('background-color', 'white');
            $('#MeetingDateError').removeClass('show');
        }

        // 4. Meeting Type
        var mtVal = $('#MeetingType').val();
        if (!mtVal || mtVal.toString().trim() === "" || mtVal.toString().trim() === "0" || mtVal.toString().trim() === "Select Meeting Type") {
            $('#MeetingType').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#MeetingTypeError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#MeetingType');
        } else {
            $('#MeetingType').removeClass('is-invalid').css('background-color', 'white');
            $('#MeetingTypeError').removeClass('show');
        }

        // 5. PDF File (required on Add; on Edit required only if no existing file is attached and no file selected)
        var isEdit = ($('#mode').val() === 'Edit');
        var hasExisting = ($('#myLink').attr('href') && $('#myLink').attr('href').trim() !== "");
        var fileUpload = $("#file1").get(0);
        var files = fileUpload ? fileUpload.files : null;

        if (files && files.length > 0) {
            var fileName = files[0].name;
            var ext = fileName.substr(fileName.lastIndexOf('.')).toLowerCase();
            if (ext !== ".pdf") {
                $('#uploadCard').addClass('is-invalid');
                $('#file1Error').html('<i class="fa fa-exclamation-circle"></i> Only .pdf files are allowed').addClass('show');
                isValid = false;
                if (!firstInvalid) firstInvalid = $('#file1');
            } else {
                $('#uploadCard').removeClass('is-invalid');
                $('#file1Error').removeClass('show');
            }
        } else if (!isEdit || !hasExisting) {
            $('#uploadCard').addClass('is-invalid');
            $('#file1Error').html('<i class="fa fa-exclamation-circle"></i> Please choose a PDF file').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#file1');
        } else {
            $('#uploadCard').removeClass('is-invalid');
            $('#file1Error').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }

    function DeleteID(id) {
        if (confirm("Are you sure you want to delete this item?")) {
            var id = id;
            $.ajax({
                url: '@Url.Action("DeleteMettingDocument", "HomeDashboard")',
                type: 'POST',
                data: { id: id },
                success: function (result) {
                    if (result.success) {
                        alert("Document deleted successfully");
                        window.location.href = '@Url.Action("UploadMettingDocument", "HomeDashboard")';
                    } else {
                        alert("Failed to delete item");
                    }
                },
                error: function () {
                    alert("Error occurred while deleting the item");
                }
            });
        }
    }

    function getbyID(MeetingId) {
        clearTextBox();
        $("#myModalLabel").html("Update Document Record");
        $("#btnUpdate").show();
        $("#btnSave").hide();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditMettingDocument", "HomeDashboard")' + '?MeetingId=' + MeetingId,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                var obj = JSON.parse(data);
                var data = obj._houseDocumentsbyId[0];
                $('#myModal').modal('show'); 
                $("#mode").val('Edit');
                $("#ddlhno").val(data.HouseNo);
                var formattedDate = data.MeetingDate ? data.MeetingDate.replace(/\//g, '-') : '';
                $('#MeetingDate').val(formattedDate);
                $("#title").val(data.Title);
                $("#MeetingType").val(data.MeetingType);
                $("#DocuemtName").val(data.DocuemtName);
                $("#MCID").val(data.MCID);
                $("#mID").val(MeetingId);
                $("#btnSave").hide();
                if (data.FullPath) {
                    $('#myLink').attr('href', data.FullPath);
                    $('#myLinkText').text('View Attached File');
                    $('#existingFileWrap').show();
                } else {
                    $('#existingFileWrap').hide();
                }
            }
        });
    }

    function clearTextBox() {
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#uploadCard').removeClass('is-invalid');

        $('#ddlhno').css('background-color', 'white').val("");
        $('#MeetingDate').css('background-color', 'white').val("");
        $('#title').css('background-color', 'white').val("");
        $('#MeetingType').css('background-color', 'white').val("");
        $('#DocuemtName').val("");
        $('#MCID').val("");
        $('#mID').val("0");
        $('#mode').val("Add");
        $('#file1').val("");

        $('#myLink').attr('href', '');
        $('#myLinkText').text('');
        $('#existingFileWrap').hide();

        $("#myModalLabel").html("Upload Proceeding");
        $("#btnSave").show();
        $("#btnUpdate").hide();
    }
</script>

