    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<div id="main-content">
     <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> House Proceeding </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" style="font-size:14px;float:right" onclick="clearTextBox();">
                                    <i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New Proceeding Document
                                </button>
                            </div>
                        </div>
                    </div>


                    


                    <div class="form_lyot" style="padding-top:5px">

                        @if (Model != null)
                        {
                            if (Model._houseDocuments.Count() > 0)
                            {


                                <div class="table-responsive">
                                    <table id="example" class="table table-bordered  dataTable">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width: 32%; display:none"><span class="font-weight-bold">MettingId</span></th>
                                                <th class="td-heading" style="width: 32%"><span class="font-weight-bold">Title</span></th>
                                                <th class="td-heading" style="width: 15%"><span class="font-weight-bold">Meeting Date</span></th>
                                                <th class="td-heading" style="width: 15%"><span class="font-weight-bold">Document Type</span></th>
                                                <th class="td-heading" style="width: 15%"><span class="font-weight-bold">File</span></th>
                                                <th class="td-heading" style="width: 12%"><span class="font-weight-bold">Action</span></th>

                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._houseDocuments)
                                            {
                                                <tr>
                                                    <td class="td-data border" style="display: none">@Html.DisplayFor(modelItem => items.MeetingID)</td>
                                                    <td class="td-data border" style="">@Html.DisplayFor(modelItem => items.Title)</td>
                                                    <td class="td-data border">@Html.DisplayFor(modelItem => items.MeetingDate)</td>
                                                    <td class="td-data border">@Html.DisplayFor(modelItem => items.DocumentName)</td>
                                                    <td class="td-data border">
                                                        <a href="@Url.Content(Model.fileacessingUrl  +"/"+ items.FilePath)" target="_blank" style="padding-right: 1px; font-size: 25px; vertical-align: top" class="pdf-link">
                                                            <img src="~/Assets/Home_Images/PDF.png" alt="Download" title="Download Proceeding File" width="24" height="24" />
                                                        </a>
                                                    </td>
                                                    <td class="center td-data border" style="font-size: 18px; text-align: center; border-right: 1px solid gray; border-bottom: 1px solid gray; vertical-align: top; padding: 14px 4px !important ">
                                                        <div>

                                                            <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.MeetingID')">
                                                                <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                            </a>
                                                            <a data-rel="tooltip" class="red tooltip-primary" onclick="DeleteID('@items.MeetingID')">
                                                              <i class="fas fa-trash-alt" style="width:24px; height:24px; font-size:25px"></i>
                                                            </a>

                                                        </div>
                                                    </td>


                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>

            </div>



            <div class="coman_modal dispatch_modal modal proceeding-record-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Upload Proceeding</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            @using (Html.BeginForm("UploadDocument", "HomeDashBoard", FormMethod.Post, new { enctype = "multipart/form-data", id = "proceedingForm", onsubmit = "return validate();" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.MCID, new { @id = "MCID" })
                                @Html.HiddenFor(m => m.MeetingID, new { @id = "mID", Value = "0" })
                                @Html.HiddenFor(m => m.Mode, new { @id = "mode", Value = "Add" })

                                <!-- Section 1: Meeting & Proceeding Details -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-info-circle"></i> Meeting &amp; Proceeding Details</div>
                                    <div class="form-card-grid">
                                        <div class="form-group col-full">
                                            <label for="ddlhno" class="profile-info-name fotm_lbl">House Number:</label>
                                            @Html.DropDownListFor(m => m.HouseNo, Model.HouseList, "Select House Number", new { @id = "ddlhno", @tabindex = "1", @class = "form-control" })
                                            <span id="ddlhnoError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Please select House Number</span>
                                        </div>

                                        <div class="form-group col-full">
                                            <label for="title" class="profile-info-name fotm_lbl">Title:</label>
                                            @Html.TextAreaFor(model => model.Title, new { @class = "form-control", @id = "title", @rows = "3", @placeholder = "Enter Proceeding Title" })
                                            <span id="titleError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Title is required</span>
                                        </div>

                                        <div class="form-group">
                                            <label for="MeetingDate" class="profile-info-name fotm_lbl">Meeting Date:</label>
                                            @Html.TextBoxFor(model => model.MeetingDate, new { @type = "Date", @id = "MeetingDate", @tabindex = "3", @class = "form-control" })
                                            <span id="MeetingDateError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Meeting Date is required</span>
                                        </div>

                                        <div class="form-group">
                                            <label for="MeetingType" class="profile-info-name fotm_lbl">Meeting Type:</label>
                                            @Html.DropDownListFor(model => model.MeetingType, Model.MeetingTypesList, "Select Meeting Type", new { @class = "form-control", @id = "MeetingType" })
                                            <span id="MeetingTypeError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Please select Meeting Type</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 2: Proceeding Document File (PDF) -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-file-pdf-o"></i> Proceeding Document File</div>
                                    <div class="odm-upload-card" id="uploadCard">
                                        <div class="odm-upload-preview">
                                            <div class="pdf-preview-badge">
                                                <i class="fa fa-file-pdf-o"></i>
                                                <span>PDF</span>
                                            </div>
                                        </div>
                                        <div class="odm-upload-input-wrap">
                                            <div class="profile-info-name fotm_lbl mb-1">Select PDF File:</div>
                                            <input id="file1" type="file" name="file" class="form-control" accept=".pdf" />
                                            <span id="file1Error" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Please choose a PDF file</span>
                                            <span class="odm-upload-hint">Accepted format: .pdf (Max size: 10MB)</span>
                                            <div id="existingFileWrap" style="display: none; margin-top: 8px;">
                                                <span class="text-muted" style="font-size: 12px;">Attached File: </span>
                                                <a id="myLink" target="_blank" class="badge-attached-file" href="">
                                                    <i class="fa fa-file-pdf-o text-danger"></i> <span id="myLinkText">View Attached File</span>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-check"></i> Save</button>
                                    <button type="submit" class="btn btn-primary" id="btnUpdate" style="display:none;"><i class="fa fa-pencil-square-o"></i> Update</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>



        </section>
    </div>

