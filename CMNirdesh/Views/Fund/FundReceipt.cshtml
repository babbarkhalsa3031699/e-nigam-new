@model  CMNirdesh.Models.LstFundsReceipt

@{
    var FileSettings = CMNirdesh.Models.FileSetting.GetSecureFileSettingLocation();
    string path = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"] + "/MlaDiary/TempFile/";
}

<body>
  
    <div id="main-content" class="main-content">
        <div class=" cm_fund fund_rcipt">
            @using (Html.BeginForm("SaveFundReceipt", "Fund", FormMethod.Post, new { @id = "formActionFund", enctype = "multipart/form-data" }))
            {
                
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">CM Fund Allocation</h3>
                            </div>
                            <div class="card-body">
                                <div class="row">

                                    <div class="form-group col-sm-6 col-md-4 col-lg-4 col-12">
                                        <label for="inputEmail4" class="txt_label">Fund Type:</label>
                                        @Html.DropDownListFor(m => m.DocTypeId, Model._Lstdoc, "Select", new { @id = "DdlFundType", @tabindex = "1", @class = "form-control txt_design", @required = "required" })
                                    </div>
                                    <div class="form-group col-sm-6 col-md-4 col-lg-4 col-12">
                                        <label for="inputEmail4" class="txt_label">Financial Year:</label>
                                        @*@Html.DropDownListFor(m => m.FinYear, new List<SelectListItem>{
                                                      new SelectListItem{Text="2022-2023"},

                                        }, "Select Year", new { @id = "Ddlyear", @tabindex = "2", @class = "form-control txt_design" })*@
                                        @Html.DropDownListFor(m => m.FinYear, Model.FinYearList,

                                    "Select Year", new { @id = "Ddlyear", @tabindex = "2", @class = "form-control txt_design" })
                                    </div>
                                    <div class="form-group col-sm-6 col-md-4 col-lg-4 col-12">
                                        <label for="inputPassword4" class="txt_label">Allocation Date:</label>
                                        @Html.TextBoxFor(m => m.AllocationDate, new { @type = "Date", @id = "txtallocationdate", @tabindex = "3", @class = "form-control txt_design", @required = "required" })
                                        @*<input type="date" class="form-control" id="txtdate" placeholder="AllocationDate">*@
                                    </div>

                                    <div class="form-group col-sm-6 col-md-4 col-lg-4 col-12">
                                        <label for="inputPassword4" class="txt_label">Amount (In Rs.):</label>
                                        @Html.TextBoxFor(m => m.FundAmount, new { @id = "txtfundamount", @tabindex = "4", @class = "form-control txt_design", @required = "required" })
                                        @*<input type="text" class="form-control" id="txtamount" placeholder="Amount">*@
                                    </div>


                                    <div class="form-group col-sm-6 col-md-4 col-lg-4 col-12">
                                        <label for="inputPassword4" class="txt_label">Remarks:</label>
                                        @Html.TextBoxFor(m => m.Remarks, new { @type = "text", @id = "txtremarks", @tabindex = "5", @class = "form-control txt_design", @required = "required" })
                                    </div>

                                    <div class="form-group col-sm-6 col-md-4 col-lg-4 col-12">
                                        <label for="inputattach" class="txt_label">Attachment:</label>
                                        <div id="divAcfile" class="file_btn_width">
                                            <div class="input-group">
                                                <label class="lbl_file">
                                                    <span class="fileinput-button file_btn">
                                                        <span>Choose file</span>
                                                        <input id="fileupload1" type="file" name="fileupload1" accept=".pdf" tabindex="6">
                                                    </span>
                                                </label>
                                            </div>
                                            @Html.HiddenFor(m => m.IsFile)

                                            <a href="#" id="afile_nameEn" target="_blank" class="pdf_link">  <span id="file_nameEn" class="file_nameEn"></span></a>
                                            <span class="file_sizeEn"></span>
                                            <div style="width: 100%;" id="fileuploadcontant1">
                                                <div style="width: 100%;">
                                                    <span id="removefileupload1" onclick="removefileupload()" class="glyphicon glyphicon-remove" style="color: red; float: left; display: none; margin-left: 125px; cursor:pointer;"></span>

                                                </div>
                                                <div style="width: 100%;">
                                                    <div class="show_hide">
                                                        <div class="progress12" style="height: 10px; width: 100%">
                                                            <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="5" style="width: 0%;">
                                                                <span class="sr-only">0% complete</span>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group col-sm-12 col-md-12 col-lg-12 col-12">
                                        <input type="submit" value="Add Fund" class="btn add_btn" />
                                    </div>
                                </div>
                            </div>
                        </div>
                  
                <div class="row">
                    @{Html.RenderPartial("~/Views/Fund/_Funds.cshtml", Model);}
                </div>
            }
        </div>
    </div>
    
</body>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>FundReport</title>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jszip.min.js"></script>
    <script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
    <script src="~/Scripts/datatables/vfs-fonts.js"></script>
    <script src="~/Scripts/datatables/buttons.print.min.js"></script>
    <script src="~/Scripts/datatables/buttons.html5.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>


    <script>
        $(function () {
            $('[type="date"]').prop('max', function () {
                return new Date().toJSON().split('T')[0];
            });
            $('#txtfundamount').val('');

        });
        $("#fileupload1").click(function (event) {
            $('#Actionfile').text('No');
            $('#IsFile').val("N");

            $('#fileupload1').fileupload({

                dataType: 'json',
                async: true,
                url: "/eFile/UploadFundFiles",
                autoUpload: true,

                done: function (e, data) {
                 var sim = setTimeout("hidevalueAction()", 1000);
                  $('.file_nameEn').html(data.result.name);
                $('#afile_nameEn').attr("href", "@path" + data.result.name);
                    $('#removefileupload1').show();
                }
            }).on('fileuploadprogressall', function (e, data) {
                var progress = parseInt(data.loaded / data.total * 100, 10);
                $('.progress12 .progress-bar').css('width', progress + '%');
                $('#removefileupload1').css('display', 'none');
            });

        });



        function hidevalueForwd() {
            $('.progress1 .progress-bar').fadeOut(500);
            var sim = setTimeout("hidevalueForwd()", 3000);
        }

        function hidevalueAction() {
            $('.progress12 .progress-bar').fadeOut(500);
            var sim = setTimeout("hidevalueAction()", 3000);
        }

        function hidevalueActionEnclosure() {
            $('.progressEnclosure .progress-bar').fadeOut(500);
            var sim = setTimeout("hidevalueActionEnclosure()", 3000);
        }

        function RemoveActionEnclosureFiles() {

            $('.file_nameEn').html('');
            $('.file_sizeEn').html('');
            $('.progressEnclosure .progress-bar').css('width', '0%');
            $("#removeUploadEnclosure").hide();
            $('#fileuploadcontantEnclosure').css('border', '0px solid rgb(244, 239, 239)');
            $.post("/eFile/RemoveActionEnclosureFiles",
                {
                },
                function (data) {
                });

        }

     

        function removefileupload() { //ActionFile
            $('.file_nameEn').html('');
            $('.file_size1').html('');
            $('.progress12 .progress-bar').css('width', '0%');
            $("#removefileupload1").hide();
            $('#fileuploadcontant1').css('border', '0px solid rgb(244, 239, 239)');
            //$.post("/eFile/RemoveMlaForwardFiles",
            //    {
            //    },
            //    function (data) {
            //    });

        }


    </script>
</head>
