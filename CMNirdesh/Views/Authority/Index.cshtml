    $.ajax({
        url: '@Url.Action("Update", "Authority")',
        type: "POST",
        data: fileData,
        contentType: false,
        processData: false,
        success: function (result) {
            if (result == 1 || result.success === true) {
                alert("Updated Successfully");
                $('#myModal').modal("hide");
                location.reload();
            } else {
                alert("Update Failed");
            }
        },
        error: function (xhr, status, error) {
            console.error("AJAX Error:", {
                status: status,
                error: error,
                responseText: xhr.responseText
            });

            let errorMessage = "Error while updating.";

            // Try to extract more meaningful information from the server response
            if (xhr.responseJSON && xhr.responseJSON.message) {
                errorMessage += "\nDetails: " + xhr.responseJSON.message;
            } else if (xhr.responseText) {
                errorMessage += "\nDetails: " + xhr.responseText;
            }

            alert(errorMessage);
            $('#myModal').modal("hide");
        }
    });
}
