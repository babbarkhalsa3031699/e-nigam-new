@model CMNirdesh.Models.AuthorityList

@{
    ViewBag.Title = "Index";
    var roleid = CMNirdesh.Models.CurrentSession.RoleID;
}
<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>

    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
   <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
</head>
<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class="">Local Govt. Authority Listing & Order Management</h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger"  data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New Authority</button>
                            </div>
                        </div>
                    </div>

                    @*<p class="text-muted">Drag and drop the Authority below to change their order.</p>*@
                    <div class="alert alert-info" style="margin-bottom:15px;">
                        <strong>Note:</strong> You can change the order of Authorities by dragging and dropping the rows. The updated order will be saved automatically.
                    </div>
                    <div class="form_lyot">
                        @if (Model != null && Model._LstAuthority != null && Model._LstAuthority.Count() > 0)
                        {
                            <div class="table-responsive">
                                <table id="authorityTable" class="table table-bordered table-striped" style="font-size: 14px;">
                                    <thead>
                                        <tr class="table-heading">
                                            <th>Order</th>
                                            <th>Photo</th>
                                            <th>Prefix</th>
                                            <th>Authority Name</th>
                                            <th>Name</th>
                                            <th>Name (Local)</th>
                                            <th>Designation</th>
                                            <th>Designation (Local)</th>
                                            <th>Date of Birth</th>
                                            <th>Marital Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="sortable">
                                        @foreach (var items in Model._LstAuthority)
                                        {
                                            <tr data-id="@items.AuthorityId">
                                                @{
                                                    var imageUrl = string.IsNullOrEmpty(items.FilePath) || string.IsNullOrEmpty(items.FileName)
                                                        ? "/Images/no-image.png"
                                                        : Url.Content(Model.fileacessingUrl + "/" + items.FilePath + items.FileName);
                                                }
                                                <td>@items.Order</td>
                                                <td>
                                                    <img src="@imageUrl" alt="Photo" width="80" height="80"
                                                         onerror="this.onerror=null;this.src='/Images/no-image.png';" />
                                                </td>

                                                <td>@items.PriFixName</td>
                                                <td>@items.AuthorityName</td>
                                                <td>@items.Name</td>
                                                <td>@items.Name_Local</td>
                                                <td>@Html.Raw(items.Designation)</td>
                                                <td>@items.Designation_Local</td>
                                                <td>@items.DateOfBirth</td>
                                                <td>@items.MaritalStatus</td>

                                                <td class="center td-data" style="padding: 14px 4px !important">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="hidden-sm hidden-xs action-buttons">

                                                            <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.AuthorityId')">
                                                                <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                            </a>

                                                        </div>
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.AuthorityId')" value="@items.AuthorityId" />
                                                        </div>
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.AuthorityId')" value="@items.AuthorityId" />
                                                            <label class="toggle mb-0">
                                                                <input type="checkbox" onclick="DeleteDepartmentRecord('@items.AuthorityId')" @(Convert.ToBoolean(items.IsActive) == true ? "checked='checked'" : string.Empty)>
                                                                <span class="slider"></span>
                                                                <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                            </label>
                                                        </div>
                                                    </div>

                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <strong>No records found.</strong>
                            </div>
                        }
                    </div>


                </div>
            </div>
            <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Authority</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body">
                            <form id="authorityForm" enctype="multipart/form-data">
                                <input type="hidden" id="AuthorityId" />

                                <div class="form-group row">
                                    @*<input type="hidden" id="AuthorityId" />*@
                                    <div class="col-6">
                                        <label>Authority Name</label>
                                        <select id="AuthorityTypeId" class="form-control"></select>
                                    </div>
                                    <div class="col-6">
                                        <label>Prefix</label>
                                        <input type="text" class="form-control" id="PriFixName" />
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-6">
                                        <label>Name</label>
                                        <input type="text" class="form-control" id="Name" />
                                    </div>
                                    <div class="col-6">
                                        <label>Name (Punjabi)</label>
                                        <input type="text" class="form-control" id="Name_Local" />
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-6">
                                        <label>Designation</label>
                                        <input type="text" class="form-control" id="Designation" />
                                    </div>
                                    <div class="col-6">
                                        <label>Designation (Punjabi)</label>
                                        <input type="text" class="form-control" id="Designation_Local" />
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-6">
                                        <label>Date of Birth</label>
                                        <input type="date" class="form-control" id="DateOfBirth" />
                                    </div>
                                    <div class="col-6">
                                        <label>Marital Status</label>
                                        <select class="form-control" id="MaritalStatus">
                                            <option value="">Select</option>
                                            <option value="Married">Married</option>
                                            <option value="Unmarried">Unmarried</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-6">
                                        <label>Spouse Name</label>
                                        <input type="text" class="form-control" id="SpouseName" />
                                    </div>
                                    <div class="col-6">
                                        <label>Spouse Name (Punjabi)</label>
                                        <input type="text" class="form-control" id="SpouseName_Local" />
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-6">
                                        <label>Date of Marriage</label>
                                        <input type="date" class="form-control" id="DateofMarriage" />
                                    </div>
                                    <div class="col-6">
                                        <label>Educational Qualification</label>
                                        <input type="text" class="form-control" id="EducationalQualification" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Present Address</label>
                                    <input type="text" class="form-control" id="PresentAddress" />
                                </div>

                                <div class="form-group">
                                    <label>Permanent Address</label>
                                    <input type="text" class="form-control" id="PermanentAddress" />
                                </div>

                                <div class="form-group">
                                    <label>Postings</label>
                                    <input type="text" class="form-control" id="Postings" />
                                </div>

                                <div class="form-group">
                                    <label>Training</label>
                                    <input type="text" class="form-control" id="Training" />
                                </div>

                                <div class="form-group">
                                    <label>Countries Visited</label>
                                    <input type="text" class="form-control" id="CountriesVisited" />
                                </div>

                                <div class="form-group">
                                    <label>Special Interests</label>
                                    <input type="text" class="form-control" id="SpecialInterest" />
                                </div>

                                <div class="form-group">
                                    <label>Meetings Attended</label>
                                    <input type="text" class="form-control" id="MeetingsAttended" />
                                </div>

                                <div class="form-group">
                                    <label>Designation Descriptions</label>
                                    <textarea class="form-control" id="DesignationDescriptions"></textarea>
                                </div>

                                <div class="form-group row">
                                    <div class="col-6">
                                        <label>Email</label>
                                        <input type="email" class="form-control" id="Email" />
                                    </div>
                                    <div class="col-6">
                                        <label>Mobile</label>
                                        <input type="text" class="form-control" id="Mobile" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Photo</label>
                                    <input type="file" class="form-control" id="Photo" accept=".jpg,.jpeg,.png,.gif" />
                                    <img id="imgPreview" style="width:100px;height:100px;" />
                                    <input type="hidden" id="FileName" />
                                    <input type="hidden" id="ThumbName" />
                                    <input type="hidden" id="FilePath" />
                                </div>

                                <div class="form-group row">
                                    <div class="col-6">
                                        <label>Is Active</label>
                                        <select class="form-control" id="IsActive">
                                            <option value="true">Yes</option>
                                            <option value="false">No</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label>Is Deleted</label>
                                        <select class="form-control" id="IsDeleted">
                                            <option value="false">No</option>
                                            <option value="true">Yes</option>
                                        </select>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="modal-footer">
                            <button type="button" id="savebtn" style="display:none;" class="btn btn-primary" onclick="AddAuthority();">Save</button>
                            <button type="button" style="display:none" id="updatebtn" class="btn btn-primary" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>


    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<!-- Include jQuery and jQuery UI -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://code.jquery.com/ui/1.13.0/jquery-ui.min.js"></script>

<script>
    $(function () {
        $("#sortable").sortable({
            update: function (event, ui) {
                var orderedItems = [];
                $("#sortable tr").each(function (index) {
                    var id = $(this).data("id");
                    $(this).find("td:eq(0)").text(index + 1);

                    orderedItems.push({
                        AuthorityId: id,
                        Order: index + 1
                    });
                });

                // Send AJAX request to update order
                $.ajax({
                    url: '@Url.Action("SaveOrder", "Authority")',
                    type: 'POST',
                    data: JSON.stringify(orderedItems),
                    contentType: 'application/json; charset=utf-8',
                    success: function (response) {
                        if (response.success) {
                            alert("Order saved successfully");
                        } else {
                            alert("Error: " + response.message);
                        }
                    }
                });
            }
        });
    });
</script>




<script>

    $(document).ready(function () {
        loadAuthorityTypesDropdown('#AuthorityTypeId'); // or any selector
        $('#authorityTable').DataTable({
            order: [[0, 'asc']],
            paging: false,
            info: false,
            searching: false
        });
        $('#myModalLabel').on('click', function () {
            alert(0);

            $('#savebtn').show();
        });
      });

    $('#myModal').on('hidden.bs.modal', function () {
        $('#savebtn').hide();
    });

    function loadAuthorityTypesDropdown(dropdownSelector) {
        var url = '@Url.Action("GetAuthorityTypes", "Authority")';
        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                var dropdown = $(dropdownSelector);
                dropdown.empty();
                dropdown.append($('<option></option>').val('').html('Select Authority Type'));

                $.each(data, function (i, item) {
                    dropdown.append($('<option></option>').val(item.Value).html(item.Text));
                });
            },
            error: function () {
                alert('Failed to load authority types.');
            }
        });
    }




    var s = {};
    function getbyID(EmpID) {
    clearTextBox();

    var url = '@Url.Action("Edit", "Authority")' + '?id=' + EmpID;
    $("#myModalLabel").html("Update Authority Record");
        $("#MemberCodeField").hide();
        //document.getElementById('updatebtn').style.display = 'inline-block';
        $("#updatebtn").show();
        $("#savebtn").hide();

    $.ajax({
        type: "GET",
        url: url,
        contentType: "application/json;charset=utf-8",
        dataType: "json",
        success: function (data) {
            var obj = JSON.parse(data);
            var data = obj._LstAuthority[0];
            $("#myModal").modal();
            $("#AuthorityId").val(data.AuthorityId);
            $("#AuthorityTypeId").val(data.AuthorityName);
            $("#PriFixName").val(data.PriFixName);
            $("#Name").val(data.Name);
            $("#Name_Local").val(data.Name_Local);
            $("#Designation").val(data.Designation);
            $("#Designation_Local").val(data.Designation_Local);
            $("#DateOfBirth").val(data.DateOfBirth);
            $("#MaritalStatus").val(data.MaritalStatus);
            $("#SpouseName").val(data.SpouseName);
            $("#SpouseName_Local").val(data.SpouseName_Local);
            $("#EducationalQualification").val(data.EducationalQualification);
            $("#PresentAddress").val(data.PresentAddress);
            $("#PermanentAddress").val(data.PermanentAddress);
            $("#Postings").val(data.Postings);
            $("#Training").val(data.Training);
            $("#CountriesVisited").val(data.CountriesVisited);
            $("#SpecialInterest").val(data.SpecialInterest);
            $("#MeetingsAttended").val(data.MeetingsAttended);
            $("#DesignationDescriptions").val(data.DesignationDescriptions);
            $("#DateofMarriage").val(data.DateofMarriage);
            $("#Email").val(data.Email);
            $("#Mobile").val(data.Mobile);
            $("#SecretoryId").val(data.SecretoryId);
            $("#Officetype").val(data.Officetype);
            $("#FileName").val(data.FileName);
            $("#ThumbName").val(data.ThumbName);
            $("#FilePath").val(data.FilePath);
            $("#IsActive").val(data.IsActive ? "true" : "false");
            $("#IsDeleted").val(data.IsDeleted ? "true" : "false");
            if (data.Photo) {
                $("#imgPreview").attr("src", "@Model.fileacessingUrl" + data.FilePath + "/" + data.FileName).show();
            } else {
                $("#imgPreview").hide();
            }
            $("#btnSave").hide();
        }
    });
}



    function validateAuthority() {
        var isValid = true;

        const requiredFields = [
            '#AuthorityTypeId',
            '#Name',
            '#Name_Local',
            '#Designation',
            '#Designation_Local',
            '#DateOfBirth',
            '#MaritalStatus',
            '#SpouseName',
            '#EducationalQualification',
            '#PresentAddress',
            '#PermanentAddress',
            '#Email',
            '#Mobile'
        ];

        requiredFields.forEach(function (selector) {
            const input = $(selector);
            if (input.val().trim() === "") {
                input.css('background-color', '#ff56564d');
                isValid = false;
            } else {
                input.css('background-color', 'white');
            }
        });

        return isValid;
    }
    function clearTextBox() {

        $('#myModal').data({ backdrop: 'static', keyboard: false });
        $('#savebtn').show();
        $('#updatebtn').hide();
        $("#myModalLabel").html("Add Authority");

        $('#AuthorityId').val("");
        $('#AuthorityName').val("");
        $('#PriFixName').val("");
        $('#Name').val("");
        $('#Name_Local').val("");
        $('#Designation').val("");
        $('#Designation_Local').val("");
        $('#DateOfBirth').val("");
        $('#MaritalStatus').val("");
        $('#SpouseName').val("");
        $('#SpouseName_Local').val("");
        $('#EducationalQualification').val("");
        $('#PresentAddress').val("");
        $('#PermanentAddress').val("");
        $('#Postings').val("");
        $('#Training').val("");
        $('#CountriesVisited').val("");
        $('#SpecialInterest').val("");
        $('#MeetingsAttended').val("");
        $('#DesignationDescriptions').val("");
        $('#DateofMarriage').val("");
        $('#Email').val("");
        $('#Mobile').val("");
        $('#FileName').val("");
        $('#ThumbName').val("");
        $('#FilePath').val("");
        $('#SecretoryId').val("");
        $('#Officetype').val("0");
        $('#Photo').val("");
        $('#IsActive').val("true");
        $('#IsDeleted').val("false");

        // Reset input styles and messages
        $('#Name').css('background-color', 'white');
        $('#Name_Local').css('background-color', 'white');
        $('#EmailValidation').hide();
        $('#MobileValidation').hide();

        // Reset preview image
        $("#imgPreview").attr('src', 'https://placehold.jp/100x100.png');
    }
    function AddAuthority() {

    var res = validateAuthority();
    if (res == false) {
        return false;
    }

    if (window.FormData !== undefined) {
        var fileUpload = $("#Photo").get(0);
        var files = fileUpload.files;
        var fileData = new FormData();

        for (var i = 0; i < files.length; i++) {
            fileData.append("Photo", files[i]); // key should match model
        }

        const authorityDto = {
            AuthorityId: $('#AuthorityId').val(),
            AuthorityName: $('#AuthorityTypeId').val(),
            PriFixName: $('#PriFixName').val(),
            Name: $('#Name').val(),
            Name_Local: $('#Name_Local').val(),
            Designation: $('#Designation').val(),
            Designation_Local: $('#Designation_Local').val(),
            DateOfBirth: $('#DateOfBirth').val(),
            MaritalStatus: $('#MaritalStatus').val(),
            SpouseName: $('#SpouseName').val(),
            SpouseName_Local: $('#SpouseName_Local').val(),
            EducationalQualification: $('#EducationalQualification').val(),
            PresentAddress: $('#PresentAddress').val(),
            PermanentAddress: $('#PermanentAddress').val(),
            Postings: $('#Postings').val(),
            Training: $('#Training').val(),
            CountriesVisited: $('#CountriesVisited').val(),
            SpecialInterest: $('#SpecialInterest').val(),
            MeetingsAttended: $('#MeetingsAttended').val(),
            DesignationDescriptions: $('#DesignationDescriptions').val(),
            DateofMarriage: $('#DateofMarriage').val(),
            Email: $('#Email').val(),
            Mobile: $('#Mobile').val(),
            SecretoryId: $('#SecretoryId').val(),
            Officetype: $('#Officetype').val(),
            FileName: $('#FileName').val(),
            ThumbName: $('#ThumbName').val(),
            FilePath: $('#FilePath').val(),
            IsActive: $('#IsActive').val(),
            IsDeleted: $('#IsDeleted').val()
        };

        Object.entries(authorityDto).forEach(([key, value]) => {
            fileData.append(key, value);
        });

        $.ajax({
            url: '@Url.Action("Create", "Authority")',
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            success: function (result) {
                if (result.success) {
                    alert("Authority saved successfully.");
                    $('#myModal').hide();
                    location.reload();
                } else {
                    alert(result.message || "Error saving authority.");
                }
            },
            error: function () {
                alert("Error occurred while saving.");
                $('#myModal').hide();
            }
        });
    } else {
        alert("Your browser does not support file upload.");
    }
}
    function Update() {
    /*if (!validate()) return false;*/

    var fileData = new FormData();

    var fileUpload = $("#Photo").get(0);
    if (fileUpload.files.length > 0) {
        fileData.append("Photo", fileUpload.files[0]);
    }

    // Append Authority model values
    fileData.append("AuthorityId", $("#AuthorityId").val());
    fileData.append("AuthorityName", $("#AuthorityTypeId").val());
    fileData.append("PriFixName", $("#PriFixName").val());
    fileData.append("Name", $("#Name").val());
    fileData.append("Name_Local", $("#Name_Local").val());
    fileData.append("Designation", $("#Designation").val());
