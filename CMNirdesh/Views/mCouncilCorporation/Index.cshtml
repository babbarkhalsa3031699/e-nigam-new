    }

    .office-details-modal .odm-upload-hint {
        font-size: 12px !important;
        font-style: italic !important;
        color: #64748b;
    }

    /* 11. Sticky Footer & Actions */
    .office-details-modal .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 20;
        display: flex !important;
        justify-content: flex-end !important;
        align-items: center !important;
