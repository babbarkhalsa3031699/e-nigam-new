        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("Delete", "mCouncilCorporation")' + '?id=' + i,
            success: function (result) {
                alert("Updated Successfully");
            }
        });
    }
    document.getElementById('HeadPhotoFile').onchange = function (e) {
        const [file] = HeadPhotoFile.files;
        if (file) {
            $("#HeadPhotoIcon").attr('src', URL.createObjectURL(file));
        }
    };
    document.getElementById('MCLogoFile').onchange = function (e) {
        const [file] = MCLogoFile.files;
        if (file) {
            $("#MCLogoIcon").attr('src', URL.createObjectURL(file));
        }
    };
    document.getElementById('SubHeadingPhotoFile').onchange = function (e) {
        const [file] = SubHeadingPhotoFile.files;
        if (file) {
            $("#SubHeadPhotoIcon").attr('src', URL.createObjectURL(file));
        }
    };
</script>