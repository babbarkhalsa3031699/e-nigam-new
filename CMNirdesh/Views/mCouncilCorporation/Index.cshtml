    function getbyID(EmpID) {

        clearTextBox();

        var url = '@Url.Action("Edit", "mCouncilCorporation")' + '?id=' + EmpID;
        $("#myModalLabel").html("Update Office Details");
        $("#btnUpdate").show();
        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {

                var obj = JSON.parse(data);
                var data = obj._ListMCModel[0];
                $('#myModal').modal();
                //   $('#MCLogoFile').val(data.MClogo);
                $('#MCSelect').val(data.IsMC);
                $('#selectedId').val(data.Id);
                // $("#MCNameDropDown").attr('value',data.MCName);
                $("#MCLocalName").val(data.MCName_local);
                $("#MCName").val(data.MCName);
                $("#AboutMC").val(data.AboutMC);
                $("#AboutMCLocal").val(data.AboutMCLocal);
                $("#Address").val(data.Address);
                $("#AddressLocal").val(data.AddressLocal);
                $("#Email").val(data.Email);
                $("#Phone").val(data.Phone);
                $("#HeadName").val(data.HeadName);
                $("#HeadMessage").val(data.HeadMessage);
                $("#HeadDesignation").val(data.HeadDesignation);
                // $("#HeadPhotoFile").val(data.HeadPhoto);
                $("#SubHeadName").val(data.SubHeadName);
                //     $("#SubHeadingPhotoFile").val(data.SubHeadPhoto);
                $("#SubHeadDesignation").val(data.SubHeadDesignation);
                $("#SubHeadMessage").val(data.SubHeadMessage);
                $("#MCLogoIcon").attr('src',  data.MClogo);
                $("#HeadPhotoIcon").attr('src',  data.HeadPhoto);
                $("#SubHeadPhotoIcon").attr('src',  data.SubHeadPhoto);

                $('#HeadNamePunjabi').val(data.HeadNameLocal),
                    $('#HeadMessagePunjabi').val(data.HeadMessageLocal),
                    $('#HeadDesignationPunjabi').val(data.HeadDesignationLocal),
                    $('#SubHeadNamePunjabi').val(data.SubHeadNameLocal),
                    $('#SubHeadDesignationPunjabi').val(data.SubHeadDesignationLocal),
                    $('#SubHeadMessagePunjabi').val(data.SubHeadMessageLocal),
                    $("#btnSave").hide();
            }
        });
    }

    function validate() {

        var isValid = true;
        if ($('#MCSelect').val().trim() === "0") {
            $('#MCSelect').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#MCSelect').css('background-color', 'white');
        }
        if ($('#MCLocalName').val().trim() === "") {
            $('#MCLocalName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#MCLocalName').css('background-color', 'white');
        }
        if ($('#MCName').val().trim() === "") {
            $('#MCName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#MCName').css('background-color', 'white');
        }



        return isValid;
    }

    function clearTextBox() {

        $("#myModalLabel").html("Add Office Details");
        $('#MCSelect').css('background-color', 'white');
        $('#MCName').css('background-color', 'white');
        $('#MCLocalName').css('background-color', 'white');
        $('#MCSelect').val(0);
        $('#MCName').val('');
        $('#MCLocalName').val('');
        $('#MCLogoFile').val("");
        $('#HeadName').val("");
        $('#HeadMessage').val("");
        $('#HeadDesignation').val("");
        $('#HeadPhotoFile').val("");
        $('#SubHeadName').val("");
        $('#SubHeadingPhotoFile').val("");
        $('#SubHeadDesignation').val("");
        $('#SubHeadMessage').val("");
        $('#HeadNamePunjabi').val("");
        $('#HeadMessagePunjabi').val("");
        $('#HeadDesignationPunjabi').val("");
        $('#SubHeadNamePunjabi').val("");
        $('#SubHeadDesignationPunjabi').val("");
        $('#SubHeadMessagePunjabi').val("");
        $('#btnSave').show();
        $("#MCLogoIcon").attr('src', 'https://placehold.jp/100x100.png');
        $("#HeadPhotoIcon").attr('src', 'https://placehold.jp/100x100.png');
        $("#SubHeadPhotoIcon").attr('src', 'https://placehold.jp/100x100.png');
        $('#btnUpdate').hide();
    }


    function Add() {

        var res = validate();
        if (res == false) {
            return false;
        }
        if (window.FormData !== undefined) {

            var fileUpload = $("#MCLogoFile").get(0);
            var fileUpload1 = $("#HeadPhotoFile").get(0);
            var fileUpload2 = $("#SubHeadingPhotoFile").get(0);

            var files = fileUpload.files;
            var files2 = fileUpload1.files;
            var files3 = fileUpload2.files;

            var fileData = new FormData();
            for (var i = 0; i < files.length; i++) {

                fileData.append('mc_logo', files[i], 'mc_logo.' + files[i].name.split('.').pop());
                var s = 'mc_logo.' + files[i].name.split('.').pop();

            }
            for (var i = 0; i < files2.length; i++) {

                fileData.append('head_photo', files2[i], 'head_photo.' + files2[i].name.split('.').pop());
                var t = 'head_photo.' + files2[i].name.split('.').pop();

            }
            for (var i = 0; i < files3.length; i++) {

                fileData.append('sub_heading_photo', files3[i], 'sub_head_photo.' + files3[i].name.split('.').pop());
                var u = 'sub_head_photo.' + files3[i].name.split('.').pop();

            }
            const courseDto = {

                IsMC: $('#MCSelect').val(),
                MCName: $('#MCName').val(),
                MCName_local: $('#MCLocalName').val(),
                MClogo: s,
                HeadName: $('#HeadName').val(),
                HeadMessage: $('#HeadMessage').val(),
                HeadDesignation: $('#HeadDesignation').val(),
                HeadPhoto: t,
                SubHeadName: $('#SubHeadName').val(),
                SubHeadPhoto: u,
                SubHeadDesignation: $('#SubHeadDesignation').val(),
                SubHeadMessage: $('#SubHeadMessage').val(),
                HeadNameLocal: $('#HeadNamePunjabi').val(),
                HeadMessageLocal: $('#HeadMessagePunjabi').val(),
                HeadDesignationLocal: $('#HeadDesignationPunjabi').val(),
                SubHeadNameLocal: $('#SubHeadNamePunjabi').val(),
                SubHeadDesignationLocal: $('#SubHeadDesignationPunjabi').val(),
                SubHeadMessageLocal: $('#SubHeadMessagePunjabi').val(),
                AboutMC: $('#AboutMC').val(),
                AboutMCLocal: $('#AboutMCLocal').val(),
                Address: $('#Address').val(),
                AddressLocal: $('#AddressLocal').val(),
                Email: $('#Email').val(),
                Phone: $('#Phone').val(),
              }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );

            $.ajax({
                url: '@Url.Action("Create", "mCouncilCorporation")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {

                    alert("Updated Successfully");
                    $('#myModal').hide();
                    location.reload();
                },
                error: function (err) {

                    alert("Not Updated");
                    $('#myModal').hide();
                    location.reload();
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
    function Update() {
    var res = validate();
    if (!res) return false;

    if (window.FormData !== undefined) {
        var fileData = new FormData();

        // Get file inputs
        var mcLogo = $("#MCLogoFile").get(0).files;
        var headPhoto = $("#HeadPhotoFile").get(0).files;
        var subHeadPhoto = $("#SubHeadingPhotoFile").get(0).files;

        // Append each file if present
        if (mcLogo.length > 0) {
            fileData.append("MCLogoFile", mcLogo[0]);
        }
        if (headPhoto.length > 0) {
            fileData.append("HeadPhotoFile", headPhoto[0]);
        }
        if (subHeadPhoto.length > 0) {
            fileData.append("SubHeadingPhotoFile", subHeadPhoto[0]);
        }

        // Append normal DTO values
        const courseDto = {
            Id: $('#selectedId').val(),
            IsMC: $('#MCSelect').val(),
            MCName: $('#MCName').val(),
            AboutMC: $('#AboutMC').val(),
            AboutMCLocal: $('#AboutMCLocal').val(),
            Address: $('#Address').val(),
            AddressLocal: $('#AddressLocal').val(),
            Email: $('#Email').val(),
            Phone: $('#Phone').val(),
            MCName_local: $('#MCLocalName').val(),
            HeadName: $('#HeadName').val(),
            HeadMessage: $('#HeadMessage').val(),
            HeadDesignation: $('#HeadDesignation').val(),
            SubHeadName: $('#SubHeadName').val(),
            SubHeadDesignation: $('#SubHeadDesignation').val(),
            SubHeadMessage: $('#SubHeadMessage').val(),
            HeadNameLocal: $('#HeadNamePunjabi').val(),
            HeadMessageLocal: $('#HeadMessagePunjabi').val(),
            HeadDesignationLocal: $('#HeadDesignationPunjabi').val(),
            SubHeadNameLocal: $('#SubHeadNamePunjabi').val(),
            SubHeadDesignationLocal: $('#SubHeadDesignationPunjabi').val(),
            SubHeadMessageLocal: $('#SubHeadMessagePunjabi').val(),
        };

        Object.entries(courseDto).forEach(([key, value]) =>
            fileData.append(key, value)
        );

        $.ajax({
            url: '@Url.Action("Update", "mCouncilCorporation")',
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            success: function (result) {
                alert("Updated Successfully");
                $('#myModal').hide();
                location.reload();
            },
            error: function () {
                alert("Not Updated");
                $('#myModal').hide();
                location.reload();
            }
        });
    } else {
        alert("FormData is not supported.");
    }
}




