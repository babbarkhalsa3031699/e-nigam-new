                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => items.HeadNameLocal)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => items.HeadDesignation)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => items.HeadDesignationLocal)
                                        </td>
                                        <td class="text-center">
                                            <div class="avatar-thumb-frame" title="@items.HeadName">
                                                <img src="@Url.Content(@Model.fileacessingUrl + "/" + items.HeadPhoto)" class="avatar-thumb-img" alt="Head" onerror="this.onerror=null; this.src='/Assets/Home_Images/user.png';" />
                                            </div>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => items.SubHeadName)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => items.SubHeadNameLocal)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => items.SubHeadDesignation)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => items.SubHeadDesignationLocal)
                                        </td>
                                        <td class="text-center">
                                            <div class="avatar-thumb-frame" title="@items.SubHeadName">
                                                <img src="@Url.Content(@Model.fileacessingUrl + "/" + items.SubHeadPhoto)" class="avatar-thumb-img" alt="SubHead" onerror="this.onerror=null; this.src='/Assets/Home_Images/user.png';" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="analytics-empty-state">
                        <i class="fa fa-folder-open fa-3x"></i>
                        <div class="analytics-empty-title">No Records Found</div>
                        <div class="analytics-empty-desc">There are currently no office records available in the directory.</div>
                    </div>
                }
            }
        </div>
    </div>
</div>


