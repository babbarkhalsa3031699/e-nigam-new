@model  IEnumerable<CMNirdesh.Models.RptDiary>


@{
    ViewBag.Title = "RptDairy";

    int count = 0;
}
<style>

    .Tab_hdr {
        background-color: #4c67a1;
        padding: 1px;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
        color: #ffffff;
    }

    .inr_frm_dsgn {
        margin-top: 20px;
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .inr_frm_dsgn {
        margin-top: 20px;
    }

    .form_lyot {
        padding: 10px;
    }

    .Tab_hdr h2 {
        font-size: 23px;
        font-weight: 500;
        margin-top: 5px;
        margin-bottom: 5px;
    }
</style>

@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")


<div class="main-content">

    <section class="form_dsign">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="inr_frm_dsgn">


                        <div class="Tab_hdr" style="display:flex;">
                            <div class="col-md-12">
                                <h2>Dispatch Action Data</h2>
                            </div>


                        </div>
                        <div class="form_lyot">
                            @if (Model != null)
                            {
                                if (Model.Count() > 0)
                                {
                                    <table id="example" class="table table-hover table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th style="text-align: center; width:30%;"><span class="font-weight-bold">To office</span></th>
                                                <th style="text-align: center; width:30%;"><span class="font-weight-bold">Total</span></th>
                                                <th style="text-align: center; width:30%;"><span class="font-weight-bold">Sanctioned</span></th>
                                                <th style="text-align: center; width:30%;"><span class="font-weight-bold">Under Implemented</span></th>
                                                <th style="text-align: center; width:30%;"><span class="font-weight-bold">Not Implemented</span></th>


                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var item in Model)
                                            {

                                            <tr>
                                                <td class="center" style="font-size:13px; padding: 14px 4px !important">
                                                    @item.deptname
                                                </td>
                                                <td class="center" style="font-size:13px; padding: 14px 4px !important">
                                                    @item.Total
                                                </td>
                                                <td class="center" style="font-size:13px; padding: 14px 4px !important">
                                                    @item.Sanctioned
                                                </td>
                                                <td class="center" style="font-size:13px; padding: 14px 4px !important">
                                                    @item.UnderImplementation
                                                </td>
                                                <td class="center" style="font-size:13px; padding: 14px 4px !important">
                                                    @item.NotImplemented
                                                </td>
                                            </tr>
                                            }
                                        </tbody>
                                    </table>

                                }
                                else
                                {
                                    <div class="row">
                                        <div class="col-xs-12">
                                            <div class="alert alert-info">

                                                <strong>No record found</strong><br />


                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>
    <div class="footer">
        <div class="footer-inner">
            <!-- #section:basics/footer -->
            <div class="footer-content">


            </div>

            <!-- /section:basics/footer -->
        </div>
    </div>

    <a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
        <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
    </a>
</div>
