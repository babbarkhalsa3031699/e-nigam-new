<div class="main-content">
    <!-- #section:basics/content.breadcrumbs -->
    <div class="breadcrumbs" id="breadcrumbs">
        <script type="text/javascript">
            try { ace.settings.check('breadcrumbs', 'fixed') } catch (e) { }
        </script>
    </div>
    <section class="form_dsign">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="inr_frm_dsgn">
                        <div class="Tab_hdr row">
                            <div class="col-md-6">
                                <h2 style="font-size:18px">Menu List</h2>
                            </div>
                            <div class="col-md-6 text-right txt_rit">
                                <p>
                                    <button type="button" class="btn btn-primary" style="font-size:18px" data-toggle="modal" data-target="#myModal" onclick="clearTextBox();">Add Menu List&nbsp;<i class="ace-icon fa fa-pencil-square-o bigger-150"></i></button>
                                    <br />
                                    <br />
                                </p>
                            </div>

                        </div>
                        <div>
                            <div class="form_lyot col-md-12 col-lg-12 col-xl-12">
                                @if (Model != null)
                                {
                                    if (Model._LstMenu.Count() > 0)
                                    {
                                        <div class="tab_parent table-responsive table_rsponsv">
                                            <table id="example" class="table table-hover table-striped table-bordered " style="font-size:20px;">
                                                <thead>
                                                    <tr>
                                                        <th class="center">Menu Id</th>
                                                        <th class="center">Menu Name</th>
                                                        <th class="center">Menu Icon</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                                <tbody role="alert" aria-live="polite" aria-relevant="all">
                                                    @foreach (var items in Model._LstMenu)
                                                    {

                                                        <tr>
                                                            <td class="center">@Html.DisplayFor(modelItem => items.MenuId)</td>
                                                            <td class="center">@Html.DisplayFor(modelItem => items.MenuName)</td>

                                                            @*<td>@Html.DisplayFor(modelItem => items.AppIcon)</td>*@
                                                            <td class="center"><a href="@Url.Content("~/" + items.icon)" target="_blank"><img src="@Url.Content("~/" + items.icon)" height="50" width="50" /> </a></td>
                                                            <td class="center">
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="imageurl" value="@Url.Content("~/" + items.icon)" />

                                                                    <a data-rel="tooltip" class="tooltip-primary" data-target="#myModal" onclick="getbyID('@items.MenuId')">

                                                                        <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                    </a>
                                                                    <a data-rel="tooltip" class="red tooltip-error" onclick="DeleteDepartmentRecord('@items.MenuId')">

                                                                        <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                                    </a>
                                                                </div>
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MenuId')" value="@items.MenuId" />
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>
                                        </div>

                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <div class="alert alert-info">
                                                    <strong>There are no record found</strong><br />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="modal" id="DeleteConfirmation">
            <div class="modal-dialog">

                <div class="modal-content">
                    <div class="modal header">
                        <a href="#" class="close" data-dismiss="modal">&times;</a>
                    </div>
                    <div class="modal-body">
                        <h3>Are you sure? You want to Delete this record.</h3>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-primary" data-dismiss="modal">Cancel</a>
                            <a href="#" class="btn btn-danger" id="Delete" onclick="ConfirmDelete()">Confirm</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal coman_modal dispatch_modal" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
            <div class="widget-box sblFullScreen">
                <div class="widget-header widget-header-flat border_none">
                    <div class="modal-header">

                        <h4 class="widget-title modal_heading" id="myModalLabel">Add Menu Options</h4>
                        <button type="button" class="close" data-dismiss="modal">×</button>
                    </div>
                    <div class="modal-body">
                        <form id="fileUpload" enctype="multipart/form-data">
                            <div class="form-group" id="MenuOption">
                                <div class="profile-info-name fotm_lbl">Menu Id:</div>
                                <input type="text" class="form-control" id="MenuId" placeholder="Menu Id" />
                            </div>
                            <div class="form-group">
                                <div class="profile-info-name fotm_lbl">
                                    Menu Name:
                                </div>
                                <input type="text" class="form-control" id="MenuName" placeholder="Menu Name" />
                            </div>
                            <div class="form-group">
                                <div class="profile-info-name fotm_lbl">
                                    Menu Icon:
                                </div>
                                <input type="file" name="file" class="form-control" id="MenuIcon" placeholder="Menu Icon" accept=".jpg,.jpeg,.bmp,.png,.gif" />

                                <input type="hidden" id="DocumentIconName" />



                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                    </div>
                </div>
            </div>
        </div>

    </section>

</div>

<br />
<br />
<br />



<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
