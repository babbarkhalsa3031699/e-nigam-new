    function getbyID(EmpID) {
        debugger
        clearTextBox();
        var url = "/mMenu/Edit?id=" + EmpID;

        $("#myModalLabel").html("Update Menu Options");

        $("#btnUpdate").show();
        $("#btnSave").hide();


        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                debugger
                var obj = JSON.parse(data);

                var data = obj._LstMenu[0];
                $('#myModal').modal();
                $("#MenuId").val(data.MenuId);
                $("#MenuId").attr("disabled", "disabled");
                $("#MenuName").val(data.MenuName);

                /**/

                /**/
                /*  alert($("#DocumentIconImage").attr("src").val());*/



                $("#btnSave").hide();
            }
        });
    }




    //Function for clearing the textboxes

    //Valdidation using jquery
    function validate() {
        debugger;
        var isValid = true;
        if ($('#MenuName').val() == "") {
            $('#MenuName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#MenuName').css('background-color', 'white');
        }

        return isValid;
    }


    function clearTextBox() {
        $('#MenuId').val("");
        $('#MenuName').val("");
        $('#MenuName').css('background-color', 'white');
        $('#MenuIcon').val("");

        $('#btnUpdate').hide();
        $("#MenuId").removeAttr("disabled", "disabled");
        $("#myModalLabel").html("Add Menu Options");
        $("#MenuOption").hide();
        $('#btnSave').show();

    }
    function Add() {
        debugger
        var res = validate();
        if (res == false) {
            return false;
        }
        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#MenuIcon").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }


            const courseDto = {
                MenuName: $('#MenuName').val(),

            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );



            // Adding one more key to FormData object



            $.ajax({
                url: '/mMenu/Create',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {

                    $('#myModal').hide
                    alert("Updated Successfully");
                    location.reload();

                },
                error: function (err) {
                    $('#myModal').hide();
                    alert("Not Updated");
                    location.reload();

                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }


    function Update() {

        var res = validate();
        if (res == false) {
            return false;
        }
        debugger


        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#MenuIcon").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }


            const courseDto = {
                MenuId: $('#MenuId').val(),
                MenuName: $('#MenuName').val(),


            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );



            // Adding one more key to FormData object



            $.ajax({
                url: '/mMenu/Update',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {

                    $('#myModal').hide();
                    alert("Updated Successfully");
                    location.reload();
                },
                error: function (err) {
                    $('#myModal').hide();
                    alert("Not Updated");
                    location.reload();
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        debugger

        $('#DeleteConfirmation').modal("show");
        MyApp = xyz;

    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {

        debugger
        var i = MyApp;


        $.ajax({
            type: "Post",
            url: "/mMenu/Delete?id=" + i,
            success: function (result) {
                $("#DeleteConfirmation").modal("hide");
                alert("Deleted Successfully");
                location.reload();

            }
        });
    }



