<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>

<!-- Initialize Swiper -->
<script>

     


    function SetLanguage() {

        var langid = $("#ddllang").val();

        if (langid == 'pb') {
            $(".English").hide();
            $(".Punjabi").show();
        } else {
            $(".English").show();
            $(".Punjabi").hide();
        }

        if (langid != "") {
            $('#btnlang').click();
        }

    }

    var swiper = new Swiper(".MC-Swiper", {
        slidesPerView: 4,
        grid: {
            rows: 4,
        },
        spaceBetween: 30,
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
        },

        breakpoints: {
            320: {
                slidesPerView: 1,
                spaceBetween: 20,
                grid: {
                    rows: 6,
                },
            },
            575: {
                slidesPerView: 1,
                spaceBetween: 20,
                grid: {
                    rows: 6,
                },
            },
            640: {
                slidesPerView: 2,
                spaceBetween: 20,
                grid: {
                    rows: 6,
                },
            },
            768: {
                slidesPerView: 2,
                spaceBetween: 40,
                grid: {
                    rows: 8,
                },
