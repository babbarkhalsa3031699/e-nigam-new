                                <ul class="list-unstyled mb-0">
                                    ${pivotColumnsHtml}
                                </ul>
                            </div>
                        </div>
                    </div>
                `);
                }
            },
            error: function (error) {
                console.log('An error occurred:', error);
            }
        });
    }
