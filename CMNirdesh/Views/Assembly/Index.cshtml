@model CMNirdesh.Models.mAssembly
<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
</head>

<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> House List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="AddNew();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add House</button>
                            </div>
                        </div>
                    </div>

                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model.Houselist.Count() > 0)
                            {
                                <div class=" table-responsive">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:5%;"><span class="font-weight-bold">House</span></th>
                                                <th class="td-heading" style="width:20%;"><span class="font-weight-bold">House Name</span></th>
                                                <th class="td-heading" style="width:20%;"><span class="font-weight-bold">House Name (Punjabi)</span></th>
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">House Start Date</span></th>
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">House End Date</span></th>
                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold">House Period</span></th>
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Action</span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model.Houselist)
                                            {

                                                <tr>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@items.AssemblyID</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.AssemblyName)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.AssemblyNameLocal)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.AssemblyStartDate)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.AssemblyEndDate)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Period)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        <div class="d-flex align-items-center gap-2">

                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.AssemblyID')" value="@items.AssemblyID" />
                                                            </div>
                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.AssemblyID')" value="@items.AssemblyID" />

                                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.AssemblyID', '@items.DeptId')">
                                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                </a>
                                                                <label class="toggle mb-0">
                                                                    <input type="checkbox" onclick="DeleteDepartmentRecord('@items.AssemblyID', '@items.Active')" @(Convert.ToBoolean(items.Active) == true ? "checked='checked'" : string.Empty)>
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>
                                                        </div>

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>


                </div>
            </div>
            <div class="coman_modal dispatch_modal addnew_modal modal house-record-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">

                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add House Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            @using (Ajax.BeginForm("Create", "Assembly", null, new AjaxOptions { HttpMethod = "POST", OnSuccess = "handleSuccess", OnFailure = "handleFailure", OnBegin = "validate" }, new { id = "houseForm", onsubmit = "return validate();" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true)

                                @Html.HiddenFor(model => model.AssemblyCode, new { id = "AssemblyCode", Value = "0" })
                                @Html.HiddenFor(model => model.Mode, new { id = "mode", Value = "Add" })

                                <!-- Section 1: House Information -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-home"></i> House Information</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <label for="AssemblyName" class="profile-info-name fotm_lbl">House Name:</label>
                                            @Html.TextBoxFor(model => model.AssemblyName, new { @class = "form-control", id = "AssemblyName", placeholder = "Enter House Name" })
                                            <span id="AssemblyNameError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> House Name is required</span>
                                        </div>

                                        <div class="form-group">
                                            <label for="AssemblyNameLocal" class="profile-info-name fotm_lbl">House Name (Punjabi):</label>
                                            @Html.TextBoxFor(model => model.AssemblyNameLocal, new { @class = "form-control", id = "AssemblyNameLocal", placeholder = "ਸਦਨ ਦਾ ਨਾਮ (ਪੰਜਾਬੀ)" })
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 2: Tenure & Schedule -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-calendar"></i> Tenure &amp; Schedule</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <label for="assemblyStartDate" class="profile-info-name fotm_lbl">Start Date:</label>
                                            @Html.TextBoxFor(model => model.AssemblyStartDate, new { @type = "date", @class = "form-control", placeholder = "Pick Start Date", id = "assemblyStartDate" })
                                        </div>

                                        <div class="form-group">
                                            <label for="assemblyEndDate" class="profile-info-name fotm_lbl">End Date:</label>
                                            @Html.TextBoxFor(model => model.AssemblyEndDate, new { @type = "date", @class = "form-control", placeholder = "Pick End Date", id = "assemblyEndDate" })
                                        </div>

                                        <div class="form-group col-full">
                                            <label for="period" class="profile-info-name fotm_lbl">Period:</label>
                                            @Html.TextBoxFor(model => model.Period, new { @class = "form-control", placeholder = "Enter Period e.g (2XXX- 2XXX)", id = "period" })
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-check"></i> Save</button>
                                    <button type="submit" class="btn btn-primary" id="btnUpdate" style="display:none;"><i class="fa fa-pencil-square-o"></i> Update</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</button>
                                </div>
                            }
                        </div>
                        <div id="validationErrors" style="color:red; padding: 0 24px 12px 24px;"></div>

                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>
    /* ==========================================================================
       HOUSE RECORD MODAL (SaaS Clean Modern Design)
       ========================================================================== */

    /* 1. Modal Reset & Container */
    .house-record-modal.addnew_modal {
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .house-record-modal.modal {
        padding: 0 !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans Gurmukhi", "Raavi", sans-serif;
    }

    .house-record-modal .modal-dialog {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 800px;
        width: calc(100% - 2rem);
        margin: 1.5rem auto;
        min-height: calc(100% - 3rem);
    }

    .house-record-modal .modal-content {
        border: 1px solid #e2e8f0 !important;
        border-radius: 12px !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
        background-color: #f8fafc !important;
        overflow: hidden !important;
    }

    /* 2. Modal Header & Accent Bar */
    .house-record-modal .modal-header {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 16px 24px !important;
        background: #ffffff !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }

    .house-record-modal .modal-header .modal-title {
        font-size: 17px !important;
        font-weight: 700 !important;
        letter-spacing: -0.01em !important;
        color: #0f172a !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
    }

    .house-record-modal .modal-header .modal-title::before {
        content: "";
        display: inline-block;
        width: 4px;
        height: 18px;
        background: #2563eb;
        border-radius: 2px;
    }

    .house-record-modal .modal-header .btn-close {
        padding: 8px !important;
        margin: 0 !important;
        opacity: 0.55 !important;
        transition: all 0.15s ease !important;
        border-radius: 6px !important;
    }

    .house-record-modal .modal-header .btn-close:hover {
        opacity: 1 !important;
        background-color: #f1f5f9 !important;
        transform: scale(1.05) !important;
    }

    /* 3. Modal Body & Custom Scrollbar */
    .house-record-modal .modal-body {
        padding: 20px 24px !important;
        background-color: #f8fafc !important;
        scrollbar-width: thin !important;
        scrollbar-color: #cbd5e1 transparent !important;
        max-height: calc(85vh - 70px) !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }

    .house-record-modal .modal-body::-webkit-scrollbar {
        width: 6px;
    }

    .house-record-modal .modal-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .house-record-modal .modal-body::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }

    .house-record-modal .modal-body::-webkit-scrollbar-thumb:hover {
        background-color: #94a3b8;
    }

    /* 4. Form Section Cards */
    .house-record-modal .form-section-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .house-record-modal .form-section-title {
        font-size: 11px !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        color: #475569;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 8px;
        border-bottom: 1px solid #f1f5f9;
    }

    .house-record-modal .form-section-title i {
        color: #2563eb;
        font-size: 13px !important;
    }

    /* 5. 2-Column Responsive Layout */
    .house-record-modal .form-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 18px;
        align-items: start;
    }

    .house-record-modal .col-full {
        grid-column: 1 / -1;
    }

    @@media (max-width: 767px) {
        .house-record-modal .modal-dialog {
            margin: 0.75rem auto;
            width: calc(100% - 1.5rem);
        }

        .house-record-modal .form-card-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .house-record-modal .modal-body {
            padding: 14px 16px !important;
        }

        .house-record-modal .modal-footer {
            padding: 12px 16px !important;
        }

        .house-record-modal .modal-footer .btn {
            flex: 1 1 auto;
        }
    }

    /* 6. Form Groups & Field Labels */
    .house-record-modal .form-group {
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
    }

    .house-record-modal .fotm_lbl,
    .house-record-modal .profile-info-name.fotm_lbl,
    .house-record-modal label.fotm_lbl {
        font-size: 12px !important;
        font-weight: 600 !important;
        letter-spacing: normal !important;
        color: #334155 !important;
        margin-bottom: 6px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between;
        width: 100% !important;
        text-align: left !important;
        float: none !important;
        padding-left: 0 !important;
    }

    /* 7. Inputs & Form Controls */
    .house-record-modal input[type="text"],
    .house-record-modal input[type="date"],
    .house-record-modal .form-control {
        width: 100% !important;
        height: 38px !important;
        min-height: 38px !important;
        padding: 6px 12px !important;
        font-size: 13px !important;
        font-weight: 400 !important;
        line-height: normal !important;
        color: #0f172a !important;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out, background-color 0.15s ease-in-out !important;
        box-sizing: border-box !important;
    }

    .house-record-modal input[type="text"]:focus,
    .house-record-modal input[type="date"]:focus,
    .house-record-modal .form-control:focus {
        border-color: #2563eb !important;
        background-color: #ffffff !important;
        outline: 0 !important;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    }

    .house-record-modal input::placeholder,
    .house-record-modal .form-control::placeholder {
        color: #94a3b8;
        font-size: 12.5px;
    }

    /* 8. Validation Highlighting */
    .house-record-modal .form-control.is-invalid,
    .house-record-modal input[type="date"].is-invalid,
    .house-record-modal input[type="text"].is-invalid {
        border: 1.5px solid #ef4444 !important;
        background-color: #fef2f2 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.18) !important;
    }

    .house-record-modal .field-val-msg {
        display: none;
        color: #dc2626;
        font-size: 11px;
        font-weight: 500;
        margin-top: 4px;
        line-height: 1.3;
    }

    .house-record-modal .field-val-msg.show {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* 9. Sticky Footer & Actions */
    .house-record-modal .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 20;
        display: flex !important;
        justify-content: flex-end !important;
        align-items: center !important;
        gap: 12px !important;
        padding: 16px 24px !important;
        background: #ffffff !important;
        border-top: 1px solid #e2e8f0 !important;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
    }

    .house-record-modal button#btnSave,
    .house-record-modal button#btnUpdate {
        background-color: #2563eb !important;
        border: 1px solid #1d4ed8 !important;
        color: #ffffff !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        padding: 8px 24px !important;
        border-radius: 6px !important;
        box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25) !important;
        transition: all 0.15s ease !important;
        display: inline-flex;
        align-items: center !important;
        gap: 8px !important;
        cursor: pointer !important;
        height: 38px !important;
    }

    .house-record-modal button#btnSave[style*="display: none"],
    .house-record-modal button#btnSave[style*="display:none"],
    .house-record-modal button#btnUpdate[style*="display: none"],
    .house-record-modal button#btnUpdate[style*="display:none"] {
        display: none !important;
    }

    .house-record-modal button#btnSave:hover,
    .house-record-modal button#btnUpdate:hover {
        background-color: #1d4ed8 !important;
        border-color: #1e40af !important;
        box-shadow: 0 4px 6px rgba(37, 99, 235, 0.35) !important;
        transform: translateY(-1px);
    }

    .house-record-modal button#btnSave:active,
    .house-record-modal button#btnUpdate:active {
        transform: translateY(0);
    }

    .house-record-modal .modal-footer .btn-secondary,
    .house-record-modal .modal-footer .btn-danger {
        background-color: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        color: #334155 !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        padding: 8px 20px !important;
        border-radius: 6px !important;
        transition: all 0.15s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        cursor: pointer !important;
        height: 38px !important;
    }

    .house-record-modal .modal-footer .btn-secondary:hover,
    .house-record-modal .modal-footer .btn-danger:hover {
        background-color: #f1f5f9 !important;
        border-color: #94a3b8 !important;
        color: #0f172a !important;
    }

    /* 10. Table & Toggle Layout */
    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }

    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<script>
    $(document).ready(function () {
        $('#example').DataTable();

        // Real-time clearing of validation highlights when user types in House Name
        $('#AssemblyName').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#AssemblyNameError').removeClass('show');
            }
        });
    });

    function validate() {
        var isValid = true;
        var firstInvalid = null;

        // Validate ONLY House Name
        var houseName = $('#AssemblyName').val();
        if (!houseName || houseName.trim() === '') {
            $('#AssemblyName').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#AssemblyNameError').html('<i class="fa fa-exclamation-circle"></i> House Name is required').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#AssemblyName');
        } else {
            $('#AssemblyName').removeClass('is-invalid').css('background-color', 'white');
            $('#AssemblyNameError').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }

    function handleSuccess(response) {
        if (response.success) {
            alert("Form submitted successfully!");
            window.location.href = "@Url.Action("Index", "Assembly")";
        } else {
            var errorsHtml = "<ul>";
            $.each(response.errors, function (index, error) {
                errorsHtml += "<li>" + error + "</li>";
            });
            errorsHtml += "</ul>";
            $("#validationErrors").html(errorsHtml);
        }
    }

    function handleFailure(response) {
        $("#validationErrors").html("An error occurred while processing your request.");
    }

    function AddNew() {
        clearTextBox();
        $('#myModal').modal('show');
        $("#mode").val('Add');
        $("#AssemblyCode").val('0');
    }

    function parseJsonDate(val) {
        if (!val) return null;
        if (typeof val === 'string' && val.indexOf('/Date(') !== -1) {
            return new Date(parseInt(val.substr(6)));
        }
        if (typeof val === 'string' && /^\d{4}-\d{2}-\d{2}/.test(val)) {
            var parts = val.substring(0, 10).split('-');
            return new Date(parts[0], parts[1] - 1, parts[2]);
        }
        var parsed = new Date(val);
        return isNaN(parsed.getTime()) ? null : parsed;
    }

    function formatDate(date) {
        if (!date || isNaN(date.getTime())) return "";
        var day = date.getDate();
        var month = date.getMonth() + 1;
        var year = date.getFullYear();

        if (day < 10) {
            day = '0' + day;
        }
        if (month < 10) {
            month = '0' + month;
        }
        return year + "-" + month + "-" + day;
    }

    function getbyID(AssemblyId, DeptId) {
        clearTextBox();
        $("#myModalLabel").html("Update House Record");
        $("#btnUpdate").show();
        $("#btnSave").hide();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditHouse", "Assembly")' + '?AssemblyCode=' + AssemblyId,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                var obj = JSON.parse(data);
                var data = obj.Houselist[0];
                $('#myModal').modal('show');
                $("#mode").val('Edit');
                $("#AssemblyCode").val(data.AssemblyCode);
                $("#AssemblyName").val(data.AssemblyName);
                $('#AssemblyNameLocal').val(data.AssemblyNameLocal);
                var sDate = parseJsonDate(data.AssemblyStartDate);
                if (sDate) {
                    $("#assemblyStartDate").val(formatDate(sDate));
                }
                var eDate = parseJsonDate(data.AssemblyEndDate);
                if (eDate) {
                    $("#assemblyEndDate").val(formatDate(eDate));
                }
                $("#period").val(data.Period);
                $("#btnSave").hide();
                $("#btnUpdate").show();
            }
        });
    }

    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {
        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("UpdateStatusHouse", "Assembly")' + '?AssemblyCode=' + i,
            success: function (result) {
                alert("Updated Successfully");
                window.location.href = "@Url.Action("Index", "Assembly")";
            }
        });
    }

    function clearTextBox() {
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#AssemblyName').css('background-color', 'white').val("");
        $('#AssemblyNameLocal').css('background-color', 'white').val("");
        $('#assemblyStartDate').css('background-color', 'white').val("");
        $('#assemblyEndDate').css('background-color', 'white').val("");
        $('#period').css('background-color', 'white').val("");
        $('#AssemblyCode').val("0");
        $('#mode').val("Add");
        $("#validationErrors").html("");
        $("#myModalLabel").html("Add House Details");
        $("#btnSave").show();
        $("#btnUpdate").hide();
    }
</script>
