@model CMNirdesh.Models.mAssembly
<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
</head>

<div class="main-office-container">
    <div class="compact-breadcrumb-bar">
        <span class="crumb-root">Office Administration</span>
        <span class="crumb-sep">&gt;&gt;</span>
        <span class="crumb-current">House Creation</span>
    </div>

    <div class="source-heading">
        <h4>House Creation</h4>
        <button type="button" class="btn-toolbar-add" data-bs-toggle="modal" data-bs-target="#myModal" onclick="AddNew();">
            <i class="fa fa-plus"></i> Add House
        </button>
    </div>

    <div class="table-outer">
        <div class="unified-table-toolbar">
            <div style="font-size: 12px; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 6px;">
                <i class="fa fa-list text-primary"></i>
                <span>House Records</span>
            </div>
            <div class="toolbar-search-slot" id="toolbarSearchSlot"></div>
        </div>

        @if (Model != null)
        {
            if (Model.Houselist.Count() > 0)
            {
                <div class="table-responsive table-cus">
                    <table id="example" class="table table-bordered dataTable">
                        <thead>
                            <tr class="table-heading">
                                <th style="width:6%; text-align: center;">House</th>
                                <th style="width:20%;">House Name</th>
                                <th style="width:20%;">House Name (Punjabi)</th>
                                <th style="width:14%;">House Start Date</th>
                                <th style="width:14%;">House End Date</th>
                                <th style="width:10%;">House Period</th>
                                <th style="width:16%; text-align: center;">Action</th>
                            </tr>
                        </thead>
                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                            @foreach (var items in Model.Houselist)
                            {
                                <tr>
                                    <td style="text-align: center;">@items.AssemblyID</td>
                                    <td>@Html.DisplayFor(modelItem => items.AssemblyName)</td>
                                    <td>@Html.DisplayFor(modelItem => items.AssemblyNameLocal)</td>
                                    <td>@Html.DisplayFor(modelItem => items.AssemblyStartDate)</td>
                                    <td>@Html.DisplayFor(modelItem => items.AssemblyEndDate)</td>
                                    <td>@Html.DisplayFor(modelItem => items.Period)</td>
                                    <td style="text-align: center;">
                                        <div class="action-cell-wrap">
                                            <a class="btn-action-edit" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.AssemblyID', '@items.DeptId')" title="Edit">
                                                <i class="fa fa-pencil"></i>
                                            </a>
                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.AssemblyID')" value="@items.AssemblyID" />
                                            <label class="toggle mb-0">
                                                <input type="checkbox" onclick="DeleteDepartmentRecord('@items.AssemblyID', '@items.Active')" @(Convert.ToBoolean(items.Active) == true ? "checked='checked'" : string.Empty)>
                                                <span class="slider"></span>
                                                <span class="labels" data-on="Active" data-off="DeActive"></span>
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="analytics-empty-state">
                    <i class="fa fa-folder-open-o" style="font-size: 32px; color: #94a3b8; margin-bottom: 8px;"></i>
                    <div class="analytics-empty-title">No House Records Found</div>
                    <div class="analytics-empty-desc">Click "Add House" to create the first entry.</div>
                </div>
            }
        }
    </div>
</div>

<div class="coman_modal dispatch_modal addnew_modal modal house-record-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">

                <div class="modal-dialog modal-lg modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add House Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">

                            @using (Ajax.BeginForm("Create", "Assembly", null, new AjaxOptions { HttpMethod = "POST", OnSuccess = "handleSuccess", OnFailure = "handleFailure", OnBegin = "validate" }, new { id = "houseForm", onsubmit = "return validate();" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.ValidationSummary(true)

                                @Html.HiddenFor(model => model.AssemblyCode, new { id = "AssemblyCode", Value = "0" })
                                @Html.HiddenFor(model => model.Mode, new { id = "mode", Value = "Add" })

                                <!-- Section 1: House Information -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-home"></i> House Information</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <label for="AssemblyName" class="profile-info-name fotm_lbl">House Name:</label>
                                            @Html.TextBoxFor(model => model.AssemblyName, new { @class = "form-control", id = "AssemblyName", placeholder = "Enter House Name" })
                                            <span id="AssemblyNameError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> House Name is required</span>
                                        </div>

                                        <div class="form-group">
                                            <label for="AssemblyNameLocal" class="profile-info-name fotm_lbl">House Name (Punjabi):</label>
                                            @Html.TextBoxFor(model => model.AssemblyNameLocal, new { @class = "form-control", id = "AssemblyNameLocal", placeholder = "ਸਦਨ ਦਾ ਨਾਮ (ਪੰਜਾਬੀ)" })
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 2: Tenure & Schedule -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-calendar"></i> Tenure &amp; Schedule</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <label for="assemblyStartDate" class="profile-info-name fotm_lbl">Start Date:</label>
                                            @Html.TextBoxFor(model => model.AssemblyStartDate, new { @type = "date", @class = "form-control", placeholder = "Pick Start Date", id = "assemblyStartDate" })
                                        </div>

                                        <div class="form-group">
                                            <label for="assemblyEndDate" class="profile-info-name fotm_lbl">End Date:</label>
                                            @Html.TextBoxFor(model => model.AssemblyEndDate, new { @type = "date", @class = "form-control", placeholder = "Pick End Date", id = "assemblyEndDate" })
                                        </div>

                                        <div class="form-group col-full">
                                            <label for="period" class="profile-info-name fotm_lbl">Period:</label>
                                            @Html.TextBoxFor(model => model.Period, new { @class = "form-control", placeholder = "Enter Period e.g (2XXX- 2XXX)", id = "period" })
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-primary" id="btnSave"><i class="fa fa-check"></i> Save</button>
                                    <button type="submit" class="btn btn-primary" id="btnUpdate" style="display:none;"><i class="fa fa-pencil-square-o"></i> Update</button>
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</button>
                                </div>
                            }
                        </div>
                        <div id="validationErrors" style="color:red; padding: 0 24px 12px 24px;"></div>

                    </div>
                </div>
            </div>

<style>
    /* ==========================================================================
       HOUSE RECORD MODAL (SaaS Clean Modern Design)
       ========================================================================== */

    /* 1. Modal Reset & Container */
    .house-record-modal.addnew_modal {
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
    }

    .house-record-modal.modal {
        padding: 0 !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans Gurmukhi", "Raavi", sans-serif;
    }

    .house-record-modal .modal-dialog {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 800px;
        width: calc(100% - 2rem);
        margin: 1.5rem auto;
        min-height: calc(100% - 3rem);
    }

    .house-record-modal .modal-content {
        border: 1px solid #e2e8f0 !important;
        border-radius: 12px !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
        background-color: #f8fafc !important;
        overflow: hidden !important;
    }

    /* 2. Modal Header & Accent Bar */
    .house-record-modal .modal-header {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 16px 24px !important;
        background: #ffffff !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }

    .house-record-modal .modal-header .modal-title {
        font-size: 17px !important;
        font-weight: 700 !important;
        letter-spacing: -0.01em !important;
        color: #0f172a !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
    }

    .house-record-modal .modal-header .modal-title::before {
        content: "";
        display: inline-block;
        width: 4px;
        height: 18px;
        background: #2563eb;
        border-radius: 2px;
    }

    .house-record-modal .modal-header .btn-close {
        padding: 8px !important;
        margin: 0 !important;
        opacity: 0.55 !important;
        transition: all 0.15s ease !important;
        border-radius: 6px !important;
    }

    .house-record-modal .modal-header .btn-close:hover {
        opacity: 1 !important;
        background-color: #f1f5f9 !important;
        transform: scale(1.05) !important;
    }

    /* 3. Modal Body & Custom Scrollbar */
    .house-record-modal .modal-body {
        padding: 20px 24px !important;
        background-color: #f8fafc !important;
        scrollbar-width: thin !important;
        scrollbar-color: #cbd5e1 transparent !important;
        max-height: calc(85vh - 70px) !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }

    .house-record-modal .modal-body::-webkit-scrollbar {
        width: 6px;
    }

    .house-record-modal .modal-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .house-record-modal .modal-body::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }

    .house-record-modal .modal-body::-webkit-scrollbar-thumb:hover {
        background-color: #94a3b8;
    }

    /* 4. Form Section Cards */
    .house-record-modal .form-section-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .house-record-modal .form-section-title {
        font-size: 11px !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        color: #475569;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 8px;
        border-bottom: 1px solid #f1f5f9;
    }

    .house-record-modal .form-section-title i {
        color: #2563eb;
        font-size: 13px !important;
    }

    /* 5. 2-Column Responsive Layout */
    .house-record-modal .form-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 18px;
        align-items: start;
    }

    .house-record-modal .col-full {
        grid-column: 1 / -1;
    }

    @@media (max-width: 767px) {
        .house-record-modal .modal-dialog {
            margin: 0.75rem auto;
            width: calc(100% - 1.5rem);
        }

        .house-record-modal .form-card-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .house-record-modal .modal-body {
            padding: 14px 16px !important;
        }

        .house-record-modal .modal-footer {
            padding: 12px 16px !important;
        }

        .house-record-modal .modal-footer .btn {
            flex: 1 1 auto;
        }
    }

    /* 6. Form Groups & Field Labels */
    .house-record-modal .form-group {
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
    }

    .house-record-modal .fotm_lbl,
    .house-record-modal .profile-info-name.fotm_lbl,
    .house-record-modal label.fotm_lbl {
        font-size: 12px !important;
        font-weight: 600 !important;
        letter-spacing: normal !important;
        color: #334155 !important;
        margin-bottom: 6px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between;
        width: 100% !important;
        text-align: left !important;
        float: none !important;
        padding-left: 0 !important;
    }

    /* 7. Inputs & Form Controls */
    .house-record-modal input[type="text"],
    .house-record-modal input[type="date"],
    .house-record-modal .form-control {
        width: 100% !important;
        height: 38px !important;
        min-height: 38px !important;
        padding: 6px 12px !important;
        font-size: 13px !important;
        font-weight: 400 !important;
        line-height: normal !important;
        color: #0f172a !important;
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out, background-color 0.15s ease-in-out !important;
        box-sizing: border-box !important;
    }

    .house-record-modal input[type="text"]:focus,
    .house-record-modal input[type="date"]:focus,
    .house-record-modal .form-control:focus {
        border-color: #2563eb !important;
        background-color: #ffffff !important;
        outline: 0 !important;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    }

    .house-record-modal input::placeholder,
    .house-record-modal .form-control::placeholder {
        color: #94a3b8;
        font-size: 12.5px;
    }

    /* 8. Validation Highlighting */
    .house-record-modal .form-control.is-invalid,
    .house-record-modal input[type="date"].is-invalid,
    .house-record-modal input[type="text"].is-invalid {
        border: 1.5px solid #ef4444 !important;
        background-color: #fef2f2 !important;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.18) !important;
    }

    .house-record-modal .field-val-msg {
        display: none;
        color: #dc2626;
        font-size: 11px;
        font-weight: 500;
        margin-top: 4px;
        line-height: 1.3;
    }

    .house-record-modal .field-val-msg.show {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* 9. Sticky Footer & Actions */
    .house-record-modal .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 20;
        display: flex !important;
        justify-content: flex-end !important;
        align-items: center !important;
        gap: 12px !important;
        padding: 16px 24px !important;
        background: #ffffff !important;
        border-top: 1px solid #e2e8f0 !important;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
    }

    .house-record-modal button#btnSave,
    .house-record-modal button#btnUpdate {
        background-color: #2563eb !important;
        border: 1px solid #1d4ed8 !important;
        color: #ffffff !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        padding: 8px 24px !important;
        border-radius: 6px !important;
        box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25) !important;
        transition: all 0.15s ease !important;
        display: inline-flex;
        align-items: center !important;
        gap: 8px !important;
        cursor: pointer !important;
        height: 38px !important;
    }

    .house-record-modal button#btnSave[style*="display: none"],
    .house-record-modal button#btnSave[style*="display:none"],
    .house-record-modal button#btnUpdate[style*="display: none"],
    .house-record-modal button#btnUpdate[style*="display:none"] {
        display: none !important;
    }

    .house-record-modal button#btnSave:hover,
    .house-record-modal button#btnUpdate:hover {
        background-color: #1d4ed8 !important;
        border-color: #1e40af !important;
        box-shadow: 0 4px 6px rgba(37, 99, 235, 0.35) !important;
        transform: translateY(-1px);
    }

    .house-record-modal button#btnSave:active,
    .house-record-modal button#btnUpdate:active {
        transform: translateY(0);
    }

    .house-record-modal .modal-footer .btn-secondary,
    .house-record-modal .modal-footer .btn-danger {
        background-color: #ffffff !important;
        border: 1px solid #cbd5e1 !important;
        color: #334155 !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        padding: 8px 20px !important;
        border-radius: 6px !important;
        transition: all 0.15s ease !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        cursor: pointer !important;
        height: 38px !important;
    }

    .house-record-modal .modal-footer .btn-secondary:hover,
    .house-record-modal .modal-footer .btn-danger:hover {
        background-color: #f1f5f9 !important;
        border-color: #94a3b8 !important;
        color: #0f172a !important;
    }

    /* 10. Table & Toggle Layout */
    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }

    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    /* Civic Suite Layout & Table Styles */
    .main-office-container {
        padding: 4px 10px 10px 10px !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
        background-color: #f8fafc !important;
        min-height: calc(100vh - 80px) !important;
    }

    .compact-breadcrumb-bar {
        font-size: 11.5px !important;
        font-weight: 600 !important;
        color: #64748b !important;
        margin-bottom: 4px !important;
        display: flex !important;
        align-items: center !important;
    }

    .compact-breadcrumb-bar .crumb-root {
        color: #475569 !important;
    }

    .compact-breadcrumb-bar .crumb-current {
        color: #2563eb !important;
        font-weight: 700 !important;
    }

    .compact-breadcrumb-bar .crumb-sep {
        color: #94a3b8 !important;
        margin: 0 6px !important;
        font-weight: normal !important;
    }

    /* Section Header */
    .source-heading {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        margin-bottom: 8px !important;
        padding-bottom: 4px !important;
    }

    .source-heading h4 {
        font-size: 14.5px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }

    .source-heading h4::before {
        content: '' !important;
        display: inline-block !important;
        width: 3px !important;
        height: 14px !important;
        background: #2563eb !important;
        border-radius: 2px !important;
    }

    /* Table Outer Container */
    .table-outer {
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        background: #ffffff !important;
        overflow: hidden !important;
        box-shadow: none !important;
        width: 100% !important;
        padding: 8px 10px !important;
        box-sizing: border-box !important;
    }

    /* Unified Single-Line Toolbar */
    .unified-table-toolbar {
        background: #f8fafc !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 6px !important;
        padding: 6px 10px !important;
        margin-bottom: 8px !important;
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 8px 12px !important;
        width: 100% !important;
        box-sizing: border-box !important;
    }

    .btn-toolbar-add {
        background: #2563eb !important;
        border: 1px solid #1d4ed8 !important;
        color: #ffffff !important;
        font-weight: 600 !important;
        font-size: 12px !important;
        height: 30px !important;
        padding: 0 14px !important;
        border-radius: 5px !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        cursor: pointer !important;
        transition: all 0.15s ease !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05) !important;
        text-decoration: none !important;
    }

    .btn-toolbar-add:hover {
        background: #1d4ed8 !important;
        border-color: #1e40af !important;
        color: #ffffff !important;
        transform: translateY(-1px);
        box-shadow: 0 3px 6px rgba(37, 99, 235, 0.25) !important;
    }

    .toolbar-search-slot {
        display: inline-flex !important;
        align-items: center !important;
        flex-shrink: 0 !important;
        margin-left: auto !important;
    }

    .toolbar-search-slot .dataTables_filter {
        float: none !important;
        display: inline-flex !important;
        align-items: center !important;
        margin: 0 !important;
    }

    .toolbar-search-slot .dataTables_filter label {
        font-weight: 600 !important;
        font-size: 12px !important;
        color: #475569 !important;
        margin-bottom: 0 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        white-space: nowrap !important;
    }

    .toolbar-search-slot .dataTables_filter input {
        height: 30px !important;
        border-radius: 5px !important;
        border: 1px solid #cbd5e1 !important;
        padding: 2px 8px !important;
        font-size: 12px !important;
        background: #ffffff !important;
        width: 170px !important;
        min-width: 120px !important;
        margin: 0 !important;
        outline: none !important;
    }

    .toolbar-search-slot .dataTables_filter input:focus {
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15) !important;
    }

    #example_wrapper > .dataTables_filter {
        display: none !important;
    }

    .table-responsive.table-cus {
        margin-top: 4px !important;
        width: 100% !important;
