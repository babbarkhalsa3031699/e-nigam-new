    <section class="reg_sec">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="login_form_box">
                        <div class="reg_box">
                            <div class="inr_reg">
                                <div class="inr_reg_tab">
                                    <div class="emblem-halo">
                                        <img src="~/Assets/Home_Images/govt_of_ind_logo_white_106px.png" alt="Government of India" class="ind_gov_logo">
                                    </div>
                                    <img src="~/Assets/Home_Images/nic_180.png" alt="NIC Logo" class="nic_logo">

                                    <div class="sso-badge-wrap">
                                        <span class="sso-pill">National SSO Service</span>
                                    </div>

                                    <h2 class="h2 parichay-title">Parichay</h2>
                                    <p class="parichay-desc mb-4">Users can also login through NIC Single Sign-On</p>

                                    <button class="btn btn_regst" onclick="LoginWithParichay();" type="button">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                            <polyline points="10 17 15 12 10 7"></polyline>
                                            <line x1="15" y1="12" x2="3" y2="12"></line>
                                        </svg>
                                        Login with Parichay
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="login_box login_form">
                            <div class="login_form_child">
                                <div class="crest-badge-wrap">
                                    <img src="~/Assets/Home_Images/punjab-logo.png" alt="Municipal Corporation Chandigarh Crest">
                                </div>

                                <h4 class="form-title">Portal Login</h4>
                                <p class="form-subtitle">Enter your official credentials to access the system</p>

                                @Html.TextBoxFor(m => m.UserName, new { autocomplete = "off", @class = "loginUsername txt_login form-control", @placeholder = "User Id", oncopy = "return false", onpaste = "return true", onblur = "OnChangeTextBox(this);", @maxlength = "100" })
                                <p><span class="field-validation-error" id="UsernameValidation"></span></p>

                                <input type="hidden" name="MCId" value="1001" />

                                <div style="position:relative;">
                                    @Html.PasswordFor(m => m.Password, new
                                    {
                                        autocomplete = "off",
                                        @placeholder = "Password",
                                        @class = "txt_login form-control",
                                        id = "Password",
                                        oncopy = "return false",
                                        onpaste = "return false",
                                        onblur = "OnChangeTextBox(this);",
                                        @maxlength = "20"
                                    })

                                    <span class="toggle-password"
                                          data-target="Password"
                                          title="Show/Hide Password">
                                        <i class="fa fa-eye"></i>
                                    </span>
                                </div>

                                <span class="field-validation-error" id="PasswordValidation"></span>

                                @using (Html.BeginForm("LoginCMNirdesh", "Account", new { area = "", }, FormMethod.Post, new { onsubmit = "return SubmitForm();", @id = "LoginForm", autocomplete = "off" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="saveUserName" id="saveUserNamehidden" value="@Model.RememberMe" />
                                    @Html.HiddenFor(m => m.ActualPassword)
                                    @Html.HiddenFor(m => m.UserName, new { @id = "hdnUserName" })
                                    @Html.Hidden("AuthVerify", new Guid().ToString())
                                    @Html.HiddenFor(m => m.returnUrl, new { ViewBag.returnUrl })

                                    <div class="form_cph" id="captchacontainer">
                                        <div class="editor-field edt_flt">
                                            <input type="text" class="txt_login form-control txt_cpha_input" placeholder="Captcha" name="CaptchaText" id="CaptchaText" value="@ViewBag.CaptchaText" maxlength="6" autocomplete="new-password" autocorrect="off" autocapitalize="off" spellcheck="false" />
                                        </div>

                                        <div class="editor-field edt_cpha">
                                            <img id="captchaImage" src="@Url.Action("GetCaptchaImage", "Account")" alt="Captcha" />
                                            <a id="refreshCaptcha" tabindex="6" class="ref_sign" href="javascript:void(0);" title="Refresh Captcha">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="23 4 23 10 17 10"></polyline>
                                                    <polyline points="1 20 1 14 7 14"></polyline>
                                                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                                                </svg>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="captcha-error-container">
                                        <span class="field-validation-error" id="CaptchaValidation"></span>
                                        @if (Model.ErrorMessage != null)
                                        {
                                            <p class="field-validation-error captchaMsg" id="CaptchaServerError">@Model.ErrorMessage</p>
                                        }
                                    </div>

                                    <div class="form-group">
                                        <input type="submit" name="submit" value="Login" class="btn_login red_hover">
                                    </div>
                                }

                            </div>

                            <div id="formFooter">
                                <a class="underlineHover" href='@Url.Action("ChangePassword", "Account")'>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                    <span>Forgot Password?</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Executive Civic Loader Overlay -->
    <div id="loader-wrapper" style="display: none;">
        <div class="portal-loader-card">
            <div class="portal-loader-spinner-box">
                <div class="portal-loader-orbit-outer"></div>
                <div class="portal-loader-orbit-middle"></div>
                <div id="loader" class="portal-loader-core"></div>
                <div class="portal-loader-emblem-badge">
                    <img src="~/Assets/Home_Images/punjab-logo.png" alt="Chandigarh Administration" class="portal-loader-emblem-img" />
                </div>
            </div>
            <div class="portal-loader-info">
                <h5 class="portal-loader-title">Digital MC House</h5>
                <p class="portal-loader-subtitle">Municipal Corporation Chandigarh <br>Chandigarh Administration</p>
                <div class="portal-loader-status">
                    <span class="portal-loader-status-dot"></span>
                    <span class="portal-loader-status-text">Processing request, please wait...</span>
                </div>
                <div class="portal-loader-progress-track">
                    <div class="portal-loader-progress-indicator"></div>
                </div>
            </div>
        </div>
    </div>

</body>

<script>
    $(document).on("click", ".toggle-password", function () {
        var input = $("#" + $(this).data("target"));
        var icon = $(this).find("i");

        if (input.attr("type") === "password") {
            input.attr("type", "text");
            icon.removeClass("fa-eye").addClass("fa-eye-slash");
        } else {
            input.attr("type", "password");
            icon.removeClass("fa-eye-slash").addClass("fa-eye");
        }
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var refreshButton = document.getElementById('refreshCaptcha');
        var captchaImage = document.getElementById('captchaImage');
        var captchaInput = document.getElementById('CaptchaText');

        refreshButton.addEventListener('click', function () {
            if (captchaInput) {
                captchaInput.value = '';
            }
            var clientErr = document.getElementById('CaptchaValidation');
            if (clientErr) { clientErr.innerText = ''; }
            var srvErr = document.getElementById('CaptchaServerError');
            if (srvErr) { srvErr.style.display = 'none'; }

            if (captchaImage) {
                var newSrc = '@Url.Action("GetCaptchaImage", "Account")' + '?t=' + new Date().getTime();
                captchaImage.src = newSrc;
            }
        });
    });
</script>
