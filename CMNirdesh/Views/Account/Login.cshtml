    <script>
        $(document).ready(function () {
            $("#saveUserNamehidden").val("False");

            $('#CaptchaText').on('input', function () {
                this.value = this.value.toUpperCase();
                $('#CaptchaValidation').html('');
                $('#CaptchaServerError').hide();
            });

            $('#UserName, #Password, #CaptchaText').off('keydown').on('keydown', function (e) {
                if (e.keyCode === 13 || e.which === 13) {
                    e.preventDefault();
                    $('.btn_login').click();
                }
            });
        });



    function LoginWithParichay() {
        $('#loader-wrapper').show();
        $.ajax({
            type: "GET",
            url: '@Url.Action("LoginButtonClik", "ParichayLogin")',
            datatype: "Json",
            contentType: "application/json; charset=utf-8",
            data: { },
            success: function (response) {
                if (response != null) {
                    window.location = response;
                }
                else {
                    $('#loader-wrapper').hide();
                    alert("Login Failed..");
                }
            },
            error: function (error) {
                $('#loader-wrapper').hide();
            }
        });
    }

    function changepassword() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("ChangePassword", "Account")',
            datatype: "Json",
            contentType: "application/json; charset=utf-8",
            data: { },
            success: function (response) {
            },
            error: function (error) {
            }
        });
    }

    window.addEventListener('pageshow', function (event) {
        $('#loader-wrapper').hide();
    });

    function SubmitForm() {
        var username = document.getElementById("UserName");
        var password = document.getElementById("Password");
        var Captcha = document.getElementById("CaptchaText");
        document.getElementById("hdnUserName").value = encodeURI(username.value);
        var hashedPassword = $("#Password").val();
        var randomSalt = generateRandomSalt();
        document.getElementById("ActualPassword").value = generateSHA256Hash(hashedPassword) +  generateSHA256Hash(randomSalt);
        var isValid = true;
        if (username.value == "") {
            $('#UsernameValidation').html('Username required');
            isValid = false;
        }
        else {
            $('#UsernameValidation').html('');
            if (isValid != false) {
                isValid = true;
            }
        }
        if (password.value == "") {
            $('#PasswordValidation').html('Password required');
            isValid = false;
        }
        else {
            $('#PasswordValidation').html('');
            if (isValid != false) {
                isValid = true;
            }
        }
        if (Captcha.value == "") {
            $('#CaptchaValidation').html('Captcha required');
            isValid = false;
        }
        else {
            $('#CaptchaValidation').html('');
            if (isValid != false) {
                isValid = true;
            }
        }
        if (isValid) {
            if (Captcha && Captcha.value) {
                Captcha.value = Captcha.value.trim().toUpperCase();
            }
            $('#loader-wrapper').show();
            setTimeout(function () {
                var pwd = document.getElementById("Password");
                var usr = document.getElementById("UserName");
                if (pwd) pwd.value = "";
                if (usr) usr.value = "";
            }, 100);
            return true;
        }
        else {
            return false;
        }
    }

        function generateRandomSalt() {
            var salt = '';
            var array = new Uint8Array(32);
            window.crypto.getRandomValues(array);

            for (var i = 0; i < array.length; i++) {
                salt += (array[i] < 16 ? '0' : '') + array[i].toString(16);
            }

            return salt;
        }

        function generateSHA256Hash(data) {
            return CryptoJS.SHA256(data).toString(CryptoJS.enc.Hex);
        }

        function HashKey(salt) {
            var str = encodeURI($("#Password").val());
            var strCode1 = toHex(salt);
            var strCode2 = toHex(CryptoJS.enc.Latin1.parse(str).toString(Crypto.enc.Base64));
            var key = encodeCodes(strCode1, strCode2);
            //var Key = CryptoJS.PBKDF2(str, salt, { keySize: 256 / 24, iterations: 1000 });
            //Key = Key.toString(CryptoJS.enc.Base64);
            return key;
        }
        $("#saveUserNamehidden").val("true");
        function toHex(str) {
            var hex = '';
            for (var i = 0; i < str.length; i++) {
                hex += '' + str.charCodeAt(i).toString(16);
            }
            return hex;
        }

        function encodeCodes(str1, str2) {
            var strEncoded = '';
            var limit = str2.length;
            if (str2.length > str1.length) limit = str1.length;
            for (var i = 0; i < str2.length; i++) {
                if (i > str1.length)
                    strEncoded += '' + Math.floor(Math.random() * (9 - 1 + 1) + 1).toString() + str2.charAt(i);
                else
                    strEncoded += '' + str1.charAt(i) + str2.charAt(i);
            }
            return strEncoded;
        }

    </script>



