@model CMNirdesh.Models.UpdatePasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Update Password | MC-House </title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Existing project CSS -->
    <link href="~/Content/style_ms.css" rel="stylesheet" />
    <link href="~/Content/responsive_ms.css" rel="stylesheet" />
    <link href="~/Content/font-awesome_ms.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #ffffff;
            font-family: Arial, Helvetica, sans-serif;
            color: #000;
        }

        /* Outer bordered container (e-Nigam style) */
        .page-wrapper {
            width: 100%;
            max-width: 360px;
            margin: 90px auto;
            padding: 18px;
            border: 1px solid #cfcfcf;
            background: #fff;
        }

        h4 {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 4px;
        }

        .subtitle {
            font-size: 13px;
            color: #444;
            margin-bottom: 18px;
        }

        .form-group {
            margin-bottom: 14px;
        }

        /* Bootstrap-like input (NIC safe) */
        .form-control-nic {
            display: block;
            width: 100%;
            height: 36px;
            padding: 6px 30px 6px 8px; /* left start, right for eye */
            font-size: 13px;
            line-height: 1.42857143;
            color: #000;
            background-color: #fff;
            border: 1px solid #999;
            border-radius: 4px;
            box-sizing: border-box;
            text-align: left;
        }

            .form-control-nic:focus {
                border-color: #1a73e8;
                outline: none;
            }

        /* Password eye icon */
        .input-group-nic {
            position: relative;
        }

        .toggle-password {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #555;
        }

        /* Button (Bootstrap-like) */
        .btn-nic {
            width: 100%;
            height: 36px;
            margin-top: 6px;
            font-size: 13px;
            font-weight: bold;
            background: #1a73e8;
            border: 1px solid #1a73e8;
            color: #fff;
            border-radius: 4px;
            cursor: pointer;
        }

            .btn-nic:hover {
                background: #1558b0;
            }

        /* Validation */
        .field-validation-error {
            display: block;
            font-size: 12px;
            color: #c00;
            margin-top: 3px;
        }

        .password-hint {
            font-size: 11px;
            color: #555;
            margin-top: 4px;
        }

        /* Footer */
        .footer-note {
            margin-top: 18px;
            font-size: 11px;
            color: #666;
            text-align: center;
            border-top: 1px solid #ddd;
            padding-top: 8px;
        }
    </style>
</head>

<body>
    <section class="reg_sec">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="login_form_box">
                        <div class="page-wrapper">

                            <h4>Update Password</h4>
                            <div class="subtitle">
                                Please change your following details to continue.
                            </div>

                            @using (Html.BeginForm("UpdatePassword", "Account", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.HiddenFor(m => m.ChangeType)

                                <!-- Email -->
                                <div class="form-group">
                                    @Html.TextBoxFor(m => m.Email,
                                             new
                                             {
                                                 @class = "form-control-nic",
                                                 placeholder = "Enter Email",
                                                 autocomplete = "off"
                                             })
                                    @Html.ValidationMessageFor(m => m.Email)
                                </div>

                                <!-- Mobile -->
                                <div class="form-group">
                                    @Html.TextBoxFor(m => m.Mobile,
                                             new
                                             {
                                                 @class = "form-control-nic",
                                                 placeholder = "Enter Mobile Number",
                                                 autocomplete = "off",
                                                 maxlength = "10"
                                             })
                                    @Html.ValidationMessageFor(m => m.Mobile)
                                   
                                </div>

                                <!-- Current Password -->
                                <div class="form-group">
                                    @Html.PasswordFor(m => m.ActualPassword,
                                             new
                                             {
                                                 @class = "form-control-nic",
                                                 placeholder = "Current Password",
                                                 autocomplete = "off"
                                             })
                                    @Html.ValidationMessageFor(m => m.ActualPassword)
                                </div>

                                <!-- New Password -->
                                <div class="form-group">
                                    <div class="input-group-nic">
                                        @Html.PasswordFor(m => m.Password,
                                                 new
                                                 {
                                                     @class = "form-control-nic",
                                                     placeholder = "New Password",
                                                     autocomplete = "off",
                                                     id = "Password"
                                                 })
                                        <span class="toggle-password" data-target="Password">
                                            <i class="fa fa-eye"></i>
                                        </span>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Password)

                                    <div class="password-hint">
                                        Minimum 8 characters with uppercase, lowercase, number & symbol.
                                    </div>
                                </div>

                                <!-- Confirm Password -->
                                <div class="form-group">
                                    <div class="input-group-nic">
                                        @Html.PasswordFor(m => m.confirmPassword,
                                                 new
                                                 {
                                                     @class = "form-control-nic",
                                                     placeholder = "Confirm New Password",
                                                     autocomplete = "off",
                                                     id = "ConfirmPassword"
                                                 })
                                        <span class="toggle-password" data-target="ConfirmPassword">
                                            <i class="fa fa-eye"></i>
                                        </span>
                                    </div>
                                    @Html.ValidationMessageFor(m => m.confirmPassword)
                                </div>

                                <input type="submit"
                                       value="Update Password"
                                       class="btn-nic" />
                            }


                            <div class="footer-note">
                                © Municipal Corporation Chandigarh, Chandigarh Administration · e-Nigam Secure Portal
                            </div>

                        </div>
                        </div></div></div></div></section>
                        @Scripts.Render("~/bundles/jquery")
                        @Scripts.Render("~/bundles/jqueryval")

                        <script>
                            $(document).on("click", ".toggle-password", function () {
                                var input = $("#" + $(this).data("target"));
                                var icon = $(this).find("i");

                                if (input.attr("type") === "password") {
                                    input.attr("type", "text");
                                    icon.removeClass("fa-eye").addClass("fa-eye-slash");
                                } else {
                                    input.attr("type", "password");
                                    icon.removeClass("fa-eye-slash").addClass("fa-eye");
                                }
                            });
                        </script>

</body>
</html>
