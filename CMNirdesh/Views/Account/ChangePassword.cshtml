@model CMNirdesh.Models.LoginModel

@using CaptchaMvc.HtmlHelpers
@{
    ViewBag.Title = "Login";
    string sPath = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"];

}
@if (TempData["ChngPwdSucessMsg"] != null)
{
    <script>
    $(document).ready(function () {
        var msg = '@TempData["ChngPwdSucessMsg"]';
        alert(msg);
    });
    </script>
}
<head>

    @Scripts.Render("~/bundles/LoginJs")
    <link href="~/Content/style_ms.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/responsive_ms.css" rel="stylesheet" />
    <link href="~/Content/font-awesome_ms.min.css" rel="stylesheet" />

    <title>CMNirdeshPunjab</title>
    <script src="~/Scripts/jquery-3.6.4.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    @*<script src="~/Scripts/CryptoJSv3.1.2/rollups/pbkdf2.js"></script>
        <script src="~/Scripts/CryptoJSv3.1.2/components/enc-base64.js"></script>
        <script src="~/Scripts/CryptoJSv3.1.2/components/enc-base64-min.js"></script>*@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.2.0/crypto-js.min.js"></script>
    <script>
        $('#CaptchaText').keydown(function (e) {
            alert(1);
            if (e.keyCode == 13 || e.which == 13) {

                SubmitForm();

            }
        });

        $(document).ready(function () {
            $("#saveUserNamehidden").val("False");

        });

        function SubmitForm() {
            var username = document.getElementById("UserName");
            var Captcha = document.getElementById("CaptchaText");
            document.getElementById("hdnUserName").value = encodeURI(username.value);
            var path = '@sPath';

            $.ajaxSetup({cache: false });
            $.ajax({
                url:path+'/Account/GetGeneratedSalt',
			    type: 'Post',
                success: function (result) {
                    if (result != "" && result != null) {

                        var isValid = true;
                        if (username.value == "") {
                             $('#UsernameValidation').html('Username required');
			                isValid = false;
			            }
			            else {
                             $('#UsernameValidation').html('');
			                if (isValid != false) {
                             isValid = true;
			                }
                        }
			            if (Captcha.value == "") {
                            $('#CaptchaValidation').html('Captcha required')
			                event.preventDefault();
			                isValid = false;
			            }
			            else {
                            $('#CaptchaValidation').html('');
			                if (isValid != false) {
                                isValid = true;

			                }
                        }
                        if (isValid) {
                          $('#LoginForm').submit();
			                return true;
			            }
                        else {
                             event.preventDefault();
			                return false;
			            }
			        }
			        else {
                    }
			    },
			    error: function (xhr, ajaxOptions, thrownError) {
			        return false;
			    }
			});

        }
        function SubmitOTPVerifyForm() {
            var userOTP = document.getElementById("userOTP");
            var Captcha = document.getElementById("CaptchaText");
            var isValid = true;
            if (userOTP.value == "") {
                $('#userOTP').html('OTP required');
                isValid = false;
            }
            if (Captcha.value == "") {
                $('#CaptchaValidation').html('Captcha required')
                event.preventDefault();
                isValid = false;
            }
            else {
                $('#CaptchaValidation').html('');
                if (isValid != false) {
                isValid = true;
            }
            }
            if (isValid) {
                $('#LoginForm').submit();
                return true;
            }
            else {
                event.preventDefault();
                return false;
            }

        }
         function SubmitNewPwdForm() {
 var Captcha = $("#CaptchaText");
             var password = $("#Password").val();
             var confirmpassword = $("#confirmPassword").val();
             var pswlen = password.length;

             //var randomSalt = generateRandomSalt();
             //alert(randomSalt);
             //alert(generateSHA256Hash(password));
             //document.getElementById("ActualPassword").value = generateSHA256Hash(password) + generateSHA256Hash(randomSalt);
             //alert($("#ActualPassword").val());

 var path = '@sPath';
 $.ajaxSetup({cache: false });
 $.ajax({
     url:path+'/Account/GetGeneratedSalt',
	    type: 'Post',
     success: function (result) {
         if (result != "" && result != null) {
             var isValid = true;
             if (password == "") {
                 $('#PasswordValidation').html('New Password required');
                 isValid = false;
                 e.preventDefault();
                 return false;
             }
             else {
                 $('#PasswordValidation').html('');
                 if (isValid != false) {
                     isValid = true;
                 }
             }
             if (confirmpassword == "") {
                 $('#confirmpasswordValidation').html('Confirm Password required');
                 isValid = false;
                 e.preventDefault();
                 return false;
             }
             else {
                 $('#confirmpasswordValidation').html('');
                 if (isValid != false) {
                     isValid = true;
                 }
             }
	            if (Captcha.value == "") {
                 $('#CaptchaValidation').html('Captcha required')
                 isValid = false;
                 e.preventDefault();
                 return false;
	            }
	            else {
                 $('#CaptchaValidation').html('');
	                if (isValid != false) {
                     isValid = true;
	                }
             }
             if (isValid) {
                 if (pswlen < 8) {
                     alert('Password length should be minimum 8 characters')
                     e.preventDefault();
                     return false;
                 }
                 else if (password != confirmpassword) {
                     alert('Password and confirm password doesnot match');
                     e.preventDefault();
                     return false;
                 }
                 else if (checkPasswordFormat(password) == false) {
                     alert('Password format is invalid.');
                     e.preventDefault();
                     return false;
                 }
                 else {
                   
                     var randomSalt = generateRandomSalt();
                     document.getElementById("Password").value = generateSHA256Hash1(password) + generateSHA256Hash1(randomSalt);
                     document.getElementById('LoginForm').submit();
                     return true;
                 }
             }
	            else {
                  e.preventDefault();
	                return false;
	            }
	        }
	        else {
         }
	    },
	    error: function (xhr, ajaxOptions, thrownError) {
	        return false;
	    }
	});

        }


        function generateRandomSalt() {
            var salt = '';
            var array = new Uint8Array(32);
            window.crypto.getRandomValues(array);

            for (var i = 0; i < array.length; i++) {
                salt += (array[i] < 16 ? '0' : '') + array[i].toString(16);
            }

            return salt;
        }

        function generateSHA256Hash1(data) {
            return CryptoJS.SHA256(data).toString(CryptoJS.enc.Hex);
        }



        function HashKey(salt) {
            var str = encodeURI($("#Password").val());
            var strCode1 = toHex(salt);
            var strCode2 = toHex(CryptoJS.enc.Latin1.parse(str).toString(Crypto.enc.Base64));
            var key = encodeCodes(strCode1, strCode2);
            //var Key = CryptoJS.PBKDF2(str, salt, { keySize: 256 / 24, iterations: 1000 });
            //Key = Key.toString(CryptoJS.enc.Base64);
            return key;
        }
        $("#saveUserNamehidden").val("true");
        function toHex(str) {
            var hex = '';
            for (var i = 0; i < str.length; i++) {
                hex += '' + str.charCodeAt(i).toString(16);
            }
            return hex;
        }

        function encodeCodes(str1, str2) {
            var strEncoded = '';
            var limit = str2.length;
            if (str2.length > str1.length) limit = str1.length;
            for (var i = 0; i < str2.length; i++) {
                if (i > str1.length)
                    strEncoded += '' + Math.floor(Math.random() * (9 - 1 + 1) + 1).toString() + str2.charAt(i);
                else
                    strEncoded += '' + str1.charAt(i) + str2.charAt(i);
            }
            return strEncoded;
        }
        function checkPasswordFormat(password) {
            var regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
            return regex.test(password);
        }
    </script>

</head>
<body>
    <section class="reg_sec">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="login_form_box">
                        <div class="reg_box">
                            <div class="inr_reg ">
                                <div class="inr_reg_tab">
                                    <img src="~/Assets/Home_Images/govt_of_ind_logo_white_106px.png" alt="" class="ind_gov_logo"><br />
                                    <img src="~/Assets/Home_Images/nic_180.png" alt="" class="nic_logo">
                                    <h2 class="h2">Parichay</h2>
                                    <p class="mb-2">Users can also login through NIC Single Sign-On</p>
                                    <button class="btn btn_regst" onclick="LoginWithParichay();">
                                        Login with Parichay
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="login_box login_form">
                            @if (CMNirdesh.Models.CurrentSession.CurrentAction == "userpass")
                            {
                                <div class="login_form_child">
                                    <img src="~/assets/home_images/punjab_logo.jpg" alt="">
                                    <h4 class="mb-3 mt-0">Verify OTP</h4>


                                    @using (Html.BeginForm("verifyOTP", "Account", new { area = "", }, FormMethod.Post, new { onkeypress = "if(e.keyCode==13 || e.which == 13) {return SubmitOTPVerifyForm();}", @id = "LoginForm", autocomplete = "off" }))
                                    {
                                        @Html.PasswordFor(m => m.userOTP, new { autocomplete = "off", @class = "loginUsername txt_login form-control", @placeholder = "Enter OTP", @maxlength = "5" })
                                        <p><span class="field-validation-error" id="UserOTPValidation"></span></p>

                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="saveUserName" id="saveUserOTPhidden" value="@Model.RememberMe" />
                                        @Html.HiddenFor(m => m.ActualPassword)
                                        @Html.HiddenFor(m => m.UserName, new { @id = "hdnUserName" })
                                        @Html.Hidden("AuthVerify", new Guid().ToString())
                                        @Html.HiddenFor(m => m.returnUrl, new { ViewBag.returnUrl })

                                        <div class="form_cph" id="captchacontainer">

                                            <div class="editor-field edt_flt">
                                                <input type="text" class="txt_login form-control txt_cpha_input" placeholder="Captcha" name="CaptchaText" id="CaptchaText" value="@ViewBag.CaptchaText" maxlength="6" />
                                                <p><span class="field-validation-error" id="CaptchaValidation"></span></p>

                                            </div>
                                            <div class="editor-field edt_cpha">
                                                <img src="@Url.Action("GetCaptchaImage", "Account", new { area = "" })" />
                                                <a id="refresh1" tabindex="6" class="ref_sign" href="@Url.Action("ChangePassword", "Account", new { area = "" })"><span class="fa fa-refresh" style="font-size: 17px;"></span></a>
                                            </div>
                                            @if (Model.ErrorMessage != null)
                                            {
                                                <p class="field-validation-error captchaMsg" id="CaptchaServerError">@Model.ErrorMessage </p>
                                            }

                                        </div>

                                    }
                                    <div class="form-group">
                                        <input type="button" name="submit" value="Verify" onclick="return SubmitOTPVerifyForm();" class="btn_login red_hover"><br /><br />
                                        <p style="font-size: 9pt;">Didn't Receive code?  <a id="refresh1" tabindex="6" class="ref_sign" href="@Url.Action("ResendOtp", "Account", new { area = "" })">Resend OTP</a></p>
                                    </div>
                                    @*</form>*@

                                </div>

                                <div id="formFooter">
                                    <a class="underlineHover" style="font-size:18px;" href='@Url.Action("Login", "Account")'>Login</a><br>
                                </div>
                            }
                            else if (CMNirdesh.Models.CurrentSession.CurrentAction == "otppass")
                            {
                        <div class="login_form_child">
                            @*<form class="login_form">*@
                            <img src="~/assets/home_images/punjab_logo.jpg" alt="">
                            @*   <h4>ਮੁੱਖ ਮੰਤਰੀ ਨਿਰਦੇਸ਼ - ਪੰਜਾਬ</h4>
                            <h5>CM NIRDESH - Punjab</h5>*@

                            <h4 class="mb-3 mt-0">Change Password</h4>
                            @using (Html.BeginForm("SaveUserNewPassword", "Account", new { area = "", }, FormMethod.Post, new { onkeypress = "if(e.keyCode==13 || e.which == 13) {return SubmitNewPwdForm();}", @id = "LoginForm", autocomplete = "off" }))
                            {


                                @Html.PasswordFor(m => m.Password, new { autocomplete = "off", @class = "loginUsername txt_login form-control", @placeholder = "New Password", onblur = "OnChangeTextBox(this);", @maxlength = "15" })
