
@model CMNirdesh.Models.MCHouse.FlashNews.LstFlashNewsModel
@using CMNirdesh;

@{
    ViewBag.Title = "Index";
    int count = 0;
}


@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

<div id="main-content">
<div class="main-content">


    <section class="form_dsign">
        <div class="container-fluid p-0">
            <div class="inr_frm_dsgn">

                <div class="widget-box " id="divAction">
                    <div class="widget-header widget-header-flat rounded-top rounded-0">
                        <h4 class=""> Flash News </h4>
                        <div class="widget-toolbar no-border">
                            <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" style="font-size:14px;" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add News</button>
                        </div>
                    </div>
                </div>

                <div class="form_lyot">

                    @if (Model != null)
                    {
                        if (Model._LstFlashNews.Count() > 0)
                        {
                            <div class="table-responsive">
                                <table id="example" class="table table-hover table-bordered">
                                    <thead>
                                        <tr class="table-heading">
                                            <th class="td-heading" style="width:10%"><span class="font-weight-bold">MC Name</span></th>
                                            <th class="td-heading" style="width:10%"><span class="font-weight-bold">FlashNews Text</span></th>
                                            <th class="td-heading" style="width:10%"><span class="font-weight-bold">FlashNews Text_local</span></th>
                                            <th class="td-heading" style="width:10%"><span class="font-weight-bold">FlashNews File</span></th>
                                            <th class="td-heading" style="width:10%"><span class="font-weight-bold">Action</span></th>
                                        </tr>
                                    </thead>
                                    <tbody role="alert" aria-live="polite" aria-relevant="all">
                                        @foreach (var items in Model._LstFlashNews)
                                        {
                                            <tr>
                                                <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.MCName)</td>
                                                <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.FlashNewsText)</td>
                                                <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.FlashNewsText_local)</td>
                                                <td class="center td-data" style="padding: 14px 4px !important"><a href="@Url.Content(@Model.fileacessingUrl+"/" + items.FlashNewsFile)" target="_blank"><img src="~/Assets/pdficon.jpg" height="35" width="30" /> </a></td>

                                                <td class="center d-flex align-items-center gap-2" style=" padding:20px 4px !important">
                                                    <div class="hidden-sm hidden-xs action-buttons">


                                                        <a data-rel="tooltip" class="tooltip-primary text-decoration-none" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.FlashNewsID')">

                                                            <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                        </a>
                                                        @*<a data-rel="tooltip" class="red tooltip-error" onclick="DeleteDepartmentRecord('@items.FlashNewsID')">

                                                    <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                </a>*@
                                                    </div>
                                                    <div class="hidden-sm hidden-xs action-buttons">
                                                        <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.FlashNewsID')" value="@items.FlashNewsID" />
                                                    </div>
                                                    <div class="hidden-sm hidden-xs action-buttons">
                                                        <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.FlashNewsID')" value="@items.FlashNewsID" />
                                                        <label class="toggle mb-0">
                                                            <input type="checkbox" onclick="DeleteDepartmentRecord('@items.FlashNewsID')" @(Convert.ToBoolean(items.Status) == true ? "checked='checked'" : string.Empty)>
                                                            <span class="slider"></span>
                                                            <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                        </label>
                                                    </div>
                                                </td>

                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="alert alert-info">
                                        <strong>There are no record found</strong><br />
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>

        <div class="coman_modal dispatch_modal addnew_modal modal flashnews-details-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fs-5" id="myModalLabel">Add FlashNews Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="frmFlashNewsDetails">
                            <input type="hidden" id="selectedId" />

                            <!-- Section 1: FlashNews Information & Content -->
                            <div class="form-section-card">
                                <div class="form-section-title"><i class="fa fa-info-circle"></i> FlashNews Information &amp; Content</div>
                                <div class="form-card-grid">
                                    <div class="form-group col-full" id="MenuDropdown">
                                        <label for="MCSelect" class="profile-info-name fotm_lbl">MC Name:</label>
                                        <select id="MCSelect" class="form-control">
                                            <option value="select" class="form-control txt_design" id="SelectId" placeholder="MC Name">Please select</option>
                                        </select>
                                        <span id="MCSelectError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Please select MC Name</span>
                                    </div>
                                    <div class="form-group">
                                        <label for="FlashNewsText" class="profile-info-name fotm_lbl">FlashNews:</label>
                                        <input type="text" class="form-control" id="FlashNewsText" placeholder="Enter FlashNews Text" />
                                        <span id="FlashNewsTextError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> FlashNews text is required</span>
                                    </div>
                                    <div class="form-group">
                                        <label for="FlashNewsText_local" class="profile-info-name fotm_lbl">FlashNews (Punjabi):</label>
                                        <input type="text" class="form-control" id="FlashNewsText_local" placeholder="ਫਲੈਸ਼ ਨਿਊਜ਼ ਟੈਕਸਟ (ਪੰਜਾਬੀ)" />
                                    </div>
                                </div>
                                <input type="hidden" class="form-control" id="FlashNewsID" placeholder="FlashNews Text" />
                            </div>

                            <!-- Section 2: Attachment / PDF Document -->
                            <div class="form-section-card">
                                <div class="form-section-title"><i class="fa fa-file-pdf-o"></i> FlashNews Attachment</div>
                                <div class="odm-upload-card" id="uploadCard">
                                    <div class="odm-upload-preview">
                                        <div class="pdf-icon-preview">
                                            <i class="fa fa-file-pdf-o"></i>
                                        </div>
                                    </div>
                                    <div class="odm-upload-input-wrap">
                                        <div class="profile-info-name fotm_lbl mb-1">
                                            Select FlashNews PDF File:
                                        </div>
                                        <input type="file" name="file" class="form-control" id="FlashNewsFile" placeholder="FlashNews File" accept=".pdf" />
                                        <input type="hidden" id="DocumentIconName" />
                                        <span id="FlashNewsFileError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Please choose a PDF file</span>
                                        <span class="odm-upload-hint">Accepted format: .pdf (Max size: 10MB)</span>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();"><i class="fa fa-check"></i> Save</button>
                        <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();" style="display:none;"><i class="fa fa-pencil-square-o"></i> Update</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fa fa-times"></i> Close</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

</div>


<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
    <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
</a>
<script src="~/Scripts/tinymce/tinymce.min.js"></script>
<script src="~/Scripts/jquery.ui.widget.js"></script>
<script src="~/Scripts/jquery.fileupload.js"></script>
<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
<link href="~/Content/style_ms.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
