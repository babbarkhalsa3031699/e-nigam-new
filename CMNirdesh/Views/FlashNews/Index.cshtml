    function getbyID(EmpID) {
        debugger
        clearTextBox();

        var url = '@Url.Action("Edit", "FlashNews")' + '?id=' + EmpID;
        $("#myModalLabel").html("Update Flash News Details");
        $("#btnUpdate").show();
        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                var obj = JSON.parse(result);
                var data = obj._LstFlashNews[0];
                $('#myModal').modal();
                $('#MCSelect').val(data.MCId);
                $('#FlashNewsText').val(data.FlashNewsText);
                $("#FlashNewsText_local").val(data.FlashNewsText_local);
                $("#FlashNewsID").val(data.FlashNewsID);
                $("#btnSave").hide();
            }
        });
