    //Function for clearing the textboxes
    //Valdidation using jquery
    function validate() {
        var isValid = true;
        var firstInvalid = null;

        // Validate MC Name
        var mcVal = $('#MCSelect').val();
        if (!mcVal || mcVal.toString().trim() === "0" || mcVal.toString().trim() === "select" || mcVal.toString().trim() === "") {
            $('#MCSelect').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#MCSelectError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#MCSelect');
        } else {
            $('#MCSelect').removeClass('is-invalid').css('background-color', 'white');
            $('#MCSelectError').removeClass('show');
        }

        // Validate FlashNews Text
        var textVal = $('#FlashNewsText').val();
        if (!textVal || textVal.trim() === "") {
            $('#FlashNewsText').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#FlashNewsTextError').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#FlashNewsText');
        } else {
            $('#FlashNewsText').removeClass('is-invalid').css('background-color', 'white');
            $('#FlashNewsTextError').removeClass('show');
        }

        // Validate File (required on Add, format check always)
        var isNew = !$('#FlashNewsID').val() || $('#FlashNewsID').val().trim() === "" || $('#FlashNewsID').val().trim() === "0";
        var fileUpload = $("#FlashNewsFile").get(0);
        var files = fileUpload ? fileUpload.files : null;

        if (files && files.length > 0) {
            var fileName = files[0].name;
            var ext = fileName.substr(fileName.lastIndexOf('.')).toLowerCase();
            if (ext !== ".pdf") {
                $('#uploadCard').addClass('is-invalid');
                $('#FlashNewsFileError').html('<i class="fa fa-exclamation-circle"></i> Only .pdf files are allowed').addClass('show');
                isValid = false;
                if (!firstInvalid) firstInvalid = $('#FlashNewsFile');
            } else {
                $('#uploadCard').removeClass('is-invalid');
                $('#FlashNewsFileError').removeClass('show');
            }
        } else if (isNew) {
            $('#uploadCard').addClass('is-invalid');
            $('#FlashNewsFileError').html('<i class="fa fa-exclamation-circle"></i> Please choose a PDF file').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#FlashNewsFile');
        } else {
            $('#uploadCard').removeClass('is-invalid');
            $('#FlashNewsFileError').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }


    function clearTextBox() {
        $('#myModal').data({ backdrop: 'static', keyboard: false });
        $("#myModalLabel").html("Add FlashNews Details");
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#MCSelect').css('background-color', 'white').val(0);
        $('#FlashNewsText').css('background-color', 'white').val('');
        $('#FlashNewsText_local').css('background-color', 'white').val('');
        $('#FlashNewsFile').val("");
        $('#uploadCard').removeClass('is-invalid');
        $('#btnSave').show();
        $('#btnUpdate').hide();
        $('#FlashNewsID').val('');
    }



    function Add() {
        debugger
        var res = validate();
        if (res == false) {
            return false;
        }
        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#FlashNewsFile").get(0);
            var files = fileUpload.files;
            // Create FormData object
            var fileData = new FormData();

            //var today = new Date();
            //var dd = String(today.getDate()).padStart(2, '0');
            //var mm = String(today.getMonth() + 1).padStart(2, '0'); //January is 0!
            //var yyyy = today.getFullYear();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {

                fileData.append(files.name, files[i]);


            }


            const courseDto = {
                //  MCName: $("#MCNameDropDown option:selected").text(),
                //  MCName_local: $("#MCLocalNameDropDown option:selected").text(),

                FlashNewsText: $('#FlashNewsText').val(),
                FlashNewsText_local: $('#FlashNewsText_local').val(),
                FlashNewsFile: $('#FlashNewsFile').val().split('\\').pop().split('/').pop(),
                MCId: $('#MCSelect').val(),
                MCName: $("#MCSelect option:selected").text(),

            };
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            // Adding one more key to FormData object
            $.ajax({
                url: '@Url.Action("Create", "FlashNews")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    if (result == 1) {
                        alert("Added Successfully");
                        $('#myModal').hide();
                        location.reload();
                    }
                    else {
                        alert("FlashNews Order No. Already Present NotUpdated!");
                    }
                },
                error: function (err) {
                    if (err) {
                        alert("Not Updated");
                        $('#myModal').hide();
                        location.reload();
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }

