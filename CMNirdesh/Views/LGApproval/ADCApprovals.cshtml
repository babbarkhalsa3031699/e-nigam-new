<div id="main-content">
    <div class="main-content">
        <div class="agenda-page-container">

            <!-- Compact Page Header -->
            <div class="col-12 p-0 mb-2">
                <h4 id="lblmenuname" class="compact-breadcrumb-bar">
                    Orders <span class="crumb-sep">&gt;&gt;</span> @pageTitle
                </h4>
            </div>

            <!-- Compact Metrics Overview Strip -->
            <div class="col-12 p-0 mb-2">
                <div class="adc-metrics-strip d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="adc-metric-badge adc-metric-ulb" title="Municipal Councils with recorded approvals">
                            <i class="fa fa-university me-1.5 text-primary"></i> Councils: <strong class="ms-1">@totalMCs</strong>
                        </span>
                        <span class="adc-metric-badge adc-metric-meetings" title="Total meetings recorded">
                            <i class="fa fa-calendar-check-o me-1.5 text-success"></i> Meetings: <strong class="ms-1">@totalMeetings</strong>
                        </span>
                        <span class="adc-metric-badge adc-metric-approvals" title="Total approval entries">
                            <i class="fa fa-stamp me-1.5 text-purple" style="color:#7e22ce;"></i> Approvals: <strong class="ms-1">@totalApprovals</strong>
                        </span>
                    </div>
                    <div class="d-flex align-items-center text-muted small">
                        <span class="d-inline-block rounded-circle bg-success me-1.5" style="width: 7px; height: 7px;"></span>
                        <span style="font-size: 11px; font-weight: 600;">Live Sanctions &amp; Approvals</span>
                    </div>
                </div>
            </div>

            <!-- Compact Table Card Container -->
            <div class="col-md-12 col-lg-12 col-xl-12 p-0 mt-1" id="statusdiv">
                <div class="agenda-table-card">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle agenda-modern-table" id="MeetingTable" aria-describedby="sample-table-3_info" style="width:100%">
                            <thead>
                                <tr class="table-header-agenda">
                                    <th class="text-start" style="width:24%;" id="tdULB">ULB / Municipal Council</th>
                                    <th class="center text-center" style="width:14%;" id="tdDate">Meeting Date</th>
                                    <th class="text-start" style="width:42%;" id="tdTitle">Meeting Title</th>
                                    <th class="center text-center" style="width:20%;" id="tdApprovals">Approvals</th>
                                </tr>
                            </thead>

                            <tbody role="alert" aria-live="polite" aria-relevant="all" id="tbodyType">
                                @if (Model.LGApprovalList != null && Model.LGApprovalList.Count > 0)
                                {
                                    foreach (var items in Model.LGApprovalList)
                                    {
                                        <tr>
                                            <td class="text-start">
                                                <span class="ulb-badge">
                                                    <i class="fa fa-university me-1.5 text-primary"></i>@items.MCName
                                                </span>
                                            </td>
                                            <td class="center text-center" data-order="@(items.MeetingDate != null ? Convert.ToDateTime(items.MeetingDate).ToString("yyyy-MM-dd") : "")">
                                                <span class="meeting-date-box">
                                                    <i class="fa fa-calendar-o me-1 text-secondary"></i>@(items.MeetingDate != null ? Convert.ToDateTime(items.MeetingDate).ToString("dd-MM-yyyy") : "-")
                                                </span>
                                            </td>
                                            <td class="text-start">
                                                <div class="meeting-title-text gurmukhi-text">
                                                    @items.MeetingTitle
                                                </div>
                                            </td>
                                            <td class="center text-center">
                                                <div class="d-inline-flex flex-wrap align-items-center justify-content-center gap-1">
                                                    @Html.Raw(items.ApprovedDate)
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center p-4 text-muted">
                                            <i class="fa fa-folder-open-o fa-2x mb-2 d-block"></i>
                                            No ADC Approval Records Found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
