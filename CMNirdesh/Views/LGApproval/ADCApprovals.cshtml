@model CMNirdesh.Models.LGApproval

@{
    int totalApprovals = Model.LGApprovalList != null ? Model.LGApprovalList.Count : 0;
    int totalMCs = Model.LGApprovalList != null ? Model.LGApprovalList.Select(x => x.MCName).Distinct().Count() : 0;
    int totalMeetings = Model.LGApprovalList != null ? Model.LGApprovalList.Select(x => x.MeetingDate).Distinct().Count() : 0;
    string pageTitle = !string.IsNullOrEmpty(Model.RefMenuName) ? Model.RefMenuName : "ADC Approvals";
}

<head>
    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
    <script src="~/Scripts/datatables/jszip.min.js"></script>
    <script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
    <script src="~/Scripts/datatables/vfs-fonts.js"></script>
    <script src="~/Scripts/datatables/vfs-fonts-punjabi.js"></script>
    <script src="~/Scripts/datatables/buttons.print.min.js"></script>
    <script src="~/Scripts/datatables/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function () {
            initializeADCTable();
        });

        function initializeADCTable() {
            if ($.fn.DataTable.isDataTable('#MeetingTable')) {
                $('#MeetingTable').DataTable().destroy();
            }

            var exportFormatting = {
                body: function (data, rowIdx, colIdx, node) {
                    var rawText = (data || '').toString();
                    var clean = rawText.replace(/<[^>]*>?/gm, '').trim();

                    // ULB (Col 0)
                    if (colIdx === 0) {
                        return clean;
                    }
                    // Meeting Date (Col 1)
                    if (colIdx === 1) {
                        return clean;
                    }
                    // Meeting Title (Col 2)
                    if (colIdx === 2) {
                        return clean.replace(/\s+/g, ' ');
                    }
                    // Approvals (Col 3) - extract dates and remove "More.."
                    if (colIdx === 3) {
                        clean = clean.replace(/More\.\./gi, '').trim();
                        return clean || '-';
                    }
                    return clean;
                }
            };

            $('#MeetingTable').DataTable({
                "bLengthChange": false,
                "pageLength": 10,
                dom: '<"dt-toolbar-modern d-flex flex-wrap align-items-center justify-content-between mb-2"<"dt-buttons-slot"B><"dt-search-slot"f>>rt<"dt-footer-modern d-flex flex-wrap align-items-center justify-content-between mt-2"<"dt-info-slot"i><"dt-paging-slot"p>>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fa fa-file-excel-o me-1"></i> Excel',
                        className: 'dt-btn-action dt-btn-excel',
                        title: 'Orders_ADC_Approvals',
                        exportOptions: {
                            columns: [0, 1, 2, 3],
                            format: exportFormatting
                        }
                    },
                    {
                        extend: 'csvHtml5',
                        text: '<i class="fa fa-file-text-o me-1"></i> CSV',
                        className: 'dt-btn-action dt-btn-csv',
                        title: 'Orders_ADC_Approvals',
                        exportOptions: {
                            columns: [0, 1, 2, 3],
                            format: exportFormatting
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="fa fa-file-pdf-o me-1"></i> PDF',
                        className: 'dt-btn-action dt-btn-pdf',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        title: null,
                        filename: 'Orders_ADC_Approvals',
                        exportOptions: {
                            columns: [0, 1, 2, 3],
                            format: exportFormatting
                        },
                        customize: function (doc) {
                            try {
                                var selectedFont = null;
                                var pdfObj = window.pdfMake || (typeof pdfMake !== 'undefined' ? pdfMake : null);
                                if (pdfObj && pdfObj.vfs && pdfObj.vfs['Raavi-Regular.ttf']) {
                                    pdfObj.fonts = pdfObj.fonts || {};
                                    pdfObj.fonts.Raavi = {
                                        normal: 'Raavi-Regular.ttf',
                                        bold: pdfObj.vfs['Raavi-Bold.ttf'] ? 'Raavi-Bold.ttf' : 'Raavi-Regular.ttf',
                                        italics: 'Raavi-Regular.ttf',
                                        bolditalics: pdfObj.vfs['Raavi-Bold.ttf'] ? 'Raavi-Bold.ttf' : 'Raavi-Regular.ttf'
                                    };
                                    selectedFont = 'Raavi';
                                }

                                doc.defaultStyle = doc.defaultStyle || {};
                                if (selectedFont) {
                                    doc.defaultStyle.font = selectedFont;
                                }
                                doc.defaultStyle.fontSize = 8.5;
                                doc.pageMargins = [18, 18, 18, 18];

                                doc.content = doc.content || [];
                                doc.content.unshift({
                                    text: 'Orders >> ADC Approvals — Sanctioned Proceedings & Orders',
                                    fontSize: 13,
                                    bold: true,
                                    color: '#1e3a8a',
                                    margin: [0, 0, 0, 9],
                                    font: selectedFont || undefined
                                });

                                var tableNode = null;
                                for (var i = 0; i < doc.content.length; i++) {
                                    if (doc.content[i] && doc.content[i].table) {
                                        tableNode = doc.content[i];
                                        break;
                                    }
                                }

                                if (tableNode && tableNode.table && tableNode.table.body && tableNode.table.body.length > 0) {
                                    var table = tableNode.table;
                                    table.headerRows = 1;
                                    table.dontBreakRows = true;
                                    table.widths = [130, 80, '*', 110];

                                    for (var r = 0; r < table.body.length; r++) {
                                        var row = table.body[r];
                                        for (var c = 0; c < row.length; c++) {
                                            var cell = row[c];
                                            if (typeof cell !== 'object' || cell === null) {
                                                cell = { text: String(cell || '') };
                                                row[c] = cell;
                                            }
                                            if (selectedFont) {
                                                cell.font = selectedFont;
                                            }

                                            if (r === 0) {
                                                cell.fillColor = '#1e3a8a';
                                                cell.color = '#ffffff';
                                                cell.bold = true;
                                                cell.fontSize = 9;
                                                cell.alignment = 'center';
                                            } else {
                                                cell.fontSize = 8;
                                                cell.color = '#1e293b';
                                                cell.fillColor = (r % 2 === 0) ? '#f8fafc' : '#ffffff';

                                                if (c === 0 || c === 2) {
                                                    cell.alignment = 'left';
                                                } else {
                                                    cell.alignment = 'center';
                                                }
                                            }
                                        }
                                    }

                                    tableNode.layout = {
                                        hLineWidth: function (idx, node) {
                                            return (idx === 0 || idx === 1 || idx === node.table.body.length) ? 0.8 : 0.4;
                                        },
                                        vLineWidth: function () { return 0.4; },
                                        hLineColor: function (idx, node) {
                                            return (idx === 0 || idx === 1 || idx === node.table.body.length) ? '#1e3a8a' : '#cbd5e1';
                                        },
                                        vLineColor: function () { return '#cbd5e1'; },
                                        paddingLeft: function () { return 6; },
                                        paddingRight: function () { return 6; },
                                        paddingTop: function (idx) { return idx === 0 ? 5 : 4; },
                                        paddingBottom: function (idx) { return idx === 0 ? 5 : 4; }
                                    };
                                }

                                doc.footer = function (currentPage, pageCount) {
                                    return {
                                        columns: [
                                            {
                                                text: 'Printed on: ' + new Date().toLocaleDateString('en-GB') + ' ' + new Date().toLocaleTimeString(),
                                                alignment: 'left',
                                                fontSize: 7.5,
                                                color: '#64748b',
                                                margin: [18, 0, 0, 0]
                                            },
                                            {
                                                text: 'Page ' + currentPage.toString() + ' of ' + pageCount,
                                                alignment: 'right',
                                                fontSize: 7.5,
                                                color: '#64748b',
                                                margin: [0, 0, 18, 0]
                                            }
                                        ],
                                        font: selectedFont || undefined
                                    };
                                };
                            } catch (err) {
                                console.warn('PDF export customization error: ', err);
                            }
                        }
                    }
                ],
                order: [[1, 'desc']],
                columnDefs: [
                    { targets: 1, type: 'date' }
                ]
            });
            $("#MeetingTable").removeClass("dataTable");
        }

        function SeeApproval(agendaId) {
            if (!agendaId) {
                alert("Agenda ID is missing. Please try again.");
                return;
            }
            var url = '@Url.Action("FileApprovals", "LGApproval")';

            $('#loader-wrapper').show();
            $("#ShowApproval").html("<div class='text-center py-4'><i class='fa fa-spinner fa-spin fa-2x text-primary mb-2'></i><p class='text-muted'>Loading approval details, please wait...</p></div>");
            $.ajax({
                url: url,
                type: 'GET',
                data: { AgendaID: agendaId },
                success: function (data) {
                    $('#loader-wrapper').hide();
                    $('#ApprovalModal').modal('show');
                    $("#ShowApproval").html(data);
                },
                error: function (xhr, status, error) {
                    console.error(`Error: ${status} - ${error}`);
                    $('#loader-wrapper').hide();
                    $('#ApprovalModal').modal('show');
                    $("#ShowApproval").html(
                        "<div class='alert alert-danger m-2'><i class='fa fa-exclamation-triangle me-1'></i> An error occurred while fetching approval details. Please try again later.</div>"
                    );
                }
            });
        }
    </script>

