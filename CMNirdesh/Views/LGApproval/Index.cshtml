</style>

<script>
    $(document).ready(function () {
        // Toggle Individual Council Accordion
        $(document).on('click', '.lg-mc-header', function () {
            var targetId = $(this).data('target');
            var card = $(this).closest('.lg-mc-card');
            var body = $('#' + targetId);

            body.slideToggle(200, function () {
                card.toggleClass('is-open', body.is(':visible'));
            });
        });

        // Expand All
        $('#btnExpandAll').on('click', function () {
            $('.lg-mc-body').slideDown(180);
            $('.lg-mc-card').addClass('is-open');
        });

        // Collapse All
        $('#btnCollapseAll').on('click', function () {
            $('.lg-mc-body').slideUp(180);
            $('.lg-mc-card').removeClass('is-open');
        });

        // Live Search Filter
        $('#mcSearchInput').on('input', function () {
            var query = $(this).val().toLowerCase().trim();

            if (query.length > 0) {
                $('#btnSearchClear').show();
            } else {
                $('#btnSearchClear').hide();
            }

            if (!query) {
                $('.lg-mc-card').show();
                $('.lg-meeting-item').show();
                $('#noSearchResult').hide();
                return;
            }

            var visibleCount = 0;

            $('.lg-mc-card').each(function () {
                var mcName = ($(this).data('mc-name') || '').toString();
                var matchesMC = mcName.indexOf(query) > -1;
                var matchingMeetings = 0;

                $(this).find('.lg-meeting-item').each(function () {
                    var title = ($(this).data('meeting-title') || '').toString();
                    var date = ($(this).data('meeting-date') || '').toString();

                    if (matchesMC || title.indexOf(query) > -1 || date.indexOf(query) > -1) {
                        $(this).show();
                        matchingMeetings++;
                    } else {
                        $(this).hide();
                    }
                });

                if (matchesMC || matchingMeetings > 0) {
                    $(this).show();
                    $(this).find('.lg-mc-body').slideDown(150);
                    $(this).addClass('is-open');
                    visibleCount++;
                } else {
                    $(this).hide();
                }
            });

            if (visibleCount === 0) {
                $('#noSearchResult').show();
            } else {
                $('#noSearchResult').hide();
            }
        });

        // Clear Search Button
        $('#btnSearchClear').on('click', function () {
            $('#mcSearchInput').val('').trigger('input').focus();
        });
    });

    // Global Approval Details AJAX Function
    function SeeApproval(agendaId) {
        if (!agendaId) {
            alert("Agenda ID is missing.");
            return;
        }

        var url = '@Url.Action("FileApprovals", "LGApproval")';

        $("#ShowApproval").html(
            '<div class="text-center py-4">' +
            '  <div class="spinner-border text-primary" style="width: 2rem; height: 2rem;" role="status"></div>' +
            '  <div class="mt-2 fw-semibold text-secondary small">Loading Approval Details...</div>' +
            '</div>'
        );

        var modalEl = document.getElementById('ApprovalModal');
        var myModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        myModal.show();

        $.ajax({
            url: url,
            type: 'GET',
            data: { AgendaID: agendaId },
            success: function (data) {
                $("#ShowApproval").html(data);
            },
            error: function () {
                $("#ShowApproval").html(
                    '<div class="alert alert-danger d-flex align-items-center m-2 py-2 px-3">' +
                    '  <i class="fas fa-circle-exclamation me-2 fs-6"></i>' +
                    '  <div class="small">Unable to load approval details. Please try again.</div>' +
                    '</div>'
                );
            }
        });
    }
</script>
