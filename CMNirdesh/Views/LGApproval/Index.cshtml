        .lg-meeting-table tbody,
        .lg-meeting-table tr,
        .lg-meeting-table td {
            display: block;
            width: 100% !important;
        }
        .lg-meeting-table tbody td {
            padding: 5px 10px;
            border-bottom: none;
        }
        .lg-meeting-table tbody tr {
            border-bottom: 1px solid #E2E8F0;
            padding: 6px 0;
        }
