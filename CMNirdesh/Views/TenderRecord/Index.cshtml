<link href="~/Content/bootstrap.css" rel="stylesheet" />*@
<script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>


<style>


    .inr_frm_dsgn {
       /* margin-top: 20px;*/
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>


<script>

    $(document).ready(function () {
        $('#example').DataTable({
        });
    });

    var id = "";
    function getbyID(EmpID) {
        debugger
        clearTextBox();

        $("#myModalLabel").html("Update Tender Record");
        $("#btnUpdate").show();
        $("#btnSave").hide();
        $.ajax({
            type: "GET",
            url: '@Url.Action("Edit", "TenderRecord")' + '?id=' + EmpID,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                debugger
                var obj = JSON.parse(data);
                var data = obj._LstTenderRecord[0];
                $('#myModal').modal();
                id = EmpID;
                $('#tendername').val(data.TenderName);
                $("#tendernamepunjabi").val(data.TenderName_local);
                $("#startdate").val(data.StartDate);
                $("#enddate").val(data.EndDate);
                $("#StatusDropDown").val(data.StatusID);
                $("#StateDropDown").val(data.StateId);
              /* $("#newsimage").val(data.Images);*/
                var pdfUrl = '/SecureFileStructure/Mohali/Tender/' + data.TenderFileName;

                $("#imgPreview").attr('src', '/Assets/pdficon.jpg');
                $("#imgPreview").attr('title', data.TenderFileName);

                // Wrap the <img> element with an <a> tag and set the href attribute
                $("#imgPreview").wrap('<a href="' + pdfUrl + '" target="_blank"></a>');
              
                $("#btnSave").hide();
            }
        });
    }

    var s = $("#StateDropDown");
    s.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
    $.ajax({
        type: "POST",
        url: '@Url.Action("StateDropDown", "TenderRecord")',
        data: '{}',
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            s.empty().append('<option selected="selected" value="0">Please select</option>');
            $.each(response, function () {
                s.append($("<option></option>").val(this['Value']).html(this['Text']));
            });
        },
        failure: function (response) {
            alert(response.responseText);
        },
        error: function (response) {
            alert(response.responseText);
        }
    });

    var d = $("#StatusDropDown");
    d.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
    $.ajax({
        type: "POST",
        url: '@Url.Action("StatusDropDown", "TenderRecord")',
        data: '{}',
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (response) {
            d.empty().append('<option selected="selected" value="0">Please select</option>');
            $.each(response, function () {
                d.append($("<option></option>").val(this['Value']).html(this['Text']));
            });
        },
        failure: function (response) {
            alert(response.responseText);
        },
        error: function (response) {
            alert(response.responseText);
        }
    });
    function validate() {
        var isValid = true;
        if ($('#tendername').val() == 0) {
            $('#tendername').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#tendername').css('background-color', 'white');
        }
      
        if ($('#startdate').val() == "") {
            $('#startdate').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#startdate').css('background-color', 'white');
        }

        if ($('#enddate').val() == "") {
            $('#enddate').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#enddate').css('background-color', 'white');
        }
        if ($('#StateDropDown').val() == 0) {
            $('#StateDropDown').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#StateDropDown').css('background-color', 'white');
        }
        if ($('#StatusDropDown').val() == 0) {
            $('#StatusDropDown').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#StatusDropDown').css('background-color', 'white');
        }
        return isValid;
    }
    function clearTextBox() {
        $('#myModal').data({backdrop: 'static', keyboard: false });
        $('#tendername').val("");
        $('#tenderfile').val("");
        $('#tendername').css('background-color', 'white');
        $('#tendernamepunjabi').css('background-color', 'white');
        $('#startdate').css('background-color', 'white');
        $('#enddate').css('background-color', 'white');
        $('#StateDropDown').css('background-color', 'white');
        $('#StatusDropDown').css('background-color', 'white');
        $('#tendernamepunjabi').val("");
        $('#startdate').val("");
        $('#enddate').val("");
        $('#StateDropDown').val(0);
        $('#StatusDropDown').val(0);
        $('#btnUpdate').hide();
        $("#myModalLabel").html("Add Tender Record");
        $('#btnSave').show();
        $("#imgPreview").attr('src', 'https://placehold.jp/100x100.png');
    }
    function Add() {

        var res = validate();
        if (res === false) {
            return false;
        }
        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#tenderfile").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }
            debugger
            const courseDto = {
                StateID: $("#StateDropDown").val(),
                TenderName: $('#tendername').val(),
                TenderName_local: $('#tendernamepunjabi').val(),
                StartDate: $('#startdate').val(),
                EndDate: $('#enddate').val(),
                TenderFileName: $('#tenderfile').val(),
                StatusID: $('#StatusDropDown').val(),
                StateName: $('#StateDropDown option:selected').text(),
              
            };
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            // Adding one more key to FormData object
            $.ajax({
                url: '@Url.Action("Create", "TenderRecord")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    if (result === 0) {
                        alert("Updated Successfully");
                        $('#myModal').hide();
                        location.reload();
                    }
                    else {
                        alert("Not Updated");
                    }
                }
            });
        }
    }





    function Update() {
        var res = validate();
        if (res == false) {
            return false;
        }
        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#tenderfile").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }


            const courseDto = {
                StateID: $("#StateDropDown").val(),
                TenderName: $('#tendername').val(),
                TenderName_local: $('#tendernamepunjabi').val(),
                StartDate: $('#startdate').val(),
                EndDate: $('#enddate').val(),
                TenderFileName: $('#tenderfile').val(),
                StatusID: $('#StatusDropDown').val(),
                Id: id,
                StateName: $('#StateDropDown option:selected').text(),



            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            // Adding one more key to FormData object
            $.ajax({
                url:'@Url.Action("Update", "TenderRecord")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    if (result === 0) {
                        alert("Updated Successfully");
                        $('#myModal').hide();
                        location.reload();
                    }
                    else if (result == 1) {
                        alert("Order Id already existing");

                    }
                    else {
                        alert("Not Updated");
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {

        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("Delete", "TenderRecord")' + '?id=' + i,
            success: function (result) {
            alert("Updated Successfully");
            }
        });
    }
    function showimage() {
        var s = $("#tenderfile").val();
        $(location).attr("~/" + s);
    }
    document.getElementById('tenderfile').onchange = function (e) {
        const [file] = tenderfile.files;

        if (file) {
            const fileExtension = file.name.split('.').pop().toLowerCase();
            if (fileExtension === 'pdf') {
                $("#imgPreview").attr('src', '/Assets/pdficon.jpg');    
                const pdfUrl = URL.createObjectURL(file);
               
                $("#imgPreview").parent('a').attr('href', pdfUrl);
                $("#imgPreview").attr('title', file.name);
            } else {
                $("#tenderfile").val('');
                alert("Please select a PDF file.");
                $("#imgPreview").attr('src', '/Assets/pdficon.jpg');
               
            }
        }
    };


</script>