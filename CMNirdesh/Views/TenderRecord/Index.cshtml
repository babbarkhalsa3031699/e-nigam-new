@model CMNirdesh.Models.MCHouse.TenderRecord
@using CMNirdesh;

@{
    ViewBag.Title = "Index";

}


@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

<div id="main-content">

    <div class="main-content">

        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="row">
                    <div class="col-md-12">
                        <div class="inr_frm_dsgn">

                            <div class="widget-box " id="divAction">
                                <div class="widget-header widget-header-flat rounded-top rounded-0">
                                    <h4 class=""> Add Tender </h4>
                                    <div class="widget-toolbar no-border">
                                        <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" style="font-size:14px;" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i>Add New Tender</button>
                                    </div>
                                </div>
                            </div>


                            <div class="form_lyot">
                                @if (Model != null)
                                {
                                    if (Model._LstTenderRecord.Count() > 0)
                                    {
                                        <div class="table-responsive">
                                            <table id="example" class="table table-hover table-bordered" style="font-size:20px;">
                                                <thead>
                                                    <tr class="table-heading">
                                                        <th class="td-heading" style="width:5%;"><span class="font-weight-bold">Id</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">StateName</span></th>
                                                        <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Tender Name</span></th>
                                                        <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Tender Name(Punjabi)</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">TenderFile</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">StartDate</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">EndDate</span></th>
                                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Status(Stage)</span></th>
                                                        <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Action</span></th>
                                                    </tr>
                                                </thead>
                                                <tbody role="alert" aria-live="polite" aria-relevant="all">
                                                    @foreach (var items in Model._LstTenderRecord)
                                                    {
                                                        <tr>
                                                            <td class="center td-data">@Html.DisplayFor(modelItem => items.Id)</td>
                                                            <td class="center td-data">@Html.DisplayFor(modelItem => items.StateName)</td>
                                                            <td class="center td-data">@Html.DisplayFor(modelItem => items.TenderName)</td>
                                                            <td class="center td-data">@Html.DisplayFor(modelItem => items.TenderName_local)</td>
                                                            <td class="center td-data"><a target="_blank" href="@Url.Content(@Model.fileacessingUrl + "/" + items.TenderFileName)"><img src="/Assets/pdficon.jpg" height="25" width="25" /></a></td>
                                                            <td class="center td-data">@Html.DisplayFor(modelItem => items.StartDate)</td>
                                                            <td class="center td-data">@Html.DisplayFor(modelItem => items.EndDate)</td>
                                                            <td class="center td-data">@Html.DisplayFor(modelItem => items.Status)</td>

                                                            @*<td>@Html.DisplayFor(modelItem => items.AppIcon)</td>*@


                                                            <td class="center td-data " style="font-size:14px; padding: 14px 4px !important">
                                                                <div class="edit-1">
                                                                    <div class="hidden-sm hidden-xs action-buttons">
                                                                        <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.Id')">
                                                                            <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                        </a>
                                                                    </div>
                                                                    <div class="hidden-sm hidden-xs action-buttons">
                                                                        <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.Id')" value="@items.Id" />
                                                                        <label class="toggle mb-0">
                                                                            <input type="checkbox" onclick="DeleteDepartmentRecord('@items.Id')" @(Convert.ToBoolean(items.Active) == true ? "checked='checked'" : string.Empty)>
                                                                            <span class="slider"></span>
                                                                            <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                        </label>
                                                                    </div>
                                                                </div>

                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row">
                                            <div class="col-xs-12">
                                                <div class="alert alert-info">
                                                    <strong>There are no record found</strong><br />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <div class="coman_modal dispatch_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add New Record</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form class="row" id="fileUpload" enctype="multipart/form-data">
                                <div class="col-md-6 col-sm-12 col-12 form-group" id="StateName">
                                    <div class="profile-info-name fotm_lbl">State Name:</div>
                                    <select id="StateDropDown">
                                        <option value="select" class="form-control txt_design" id="SelectId" placeholder="State Name"></option>
                                    </select>

                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group" id="DocumentTypeId1">

                                    <div class="profile-info-name fotm_lbl">Tender Name</div>
                                    <input type="text" class="form-control" id="tendername" placeholder="Tender Name" />
                                    <input type="hidden" class="form-control" id="newsid" placeholder="News Title" />
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <div class="profile-info-name fotm_lbl">
                                        Tender Name(Punjabi):
                                    </div>
                                    <input type="text" class="form-control" id="tendernamepunjabi" placeholder="Tender Name(Punjabi)" />
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <div class="profile-info-name fotm_lbl">Tender File:</div>
                                    <input type="file" name="file" class="form-control" id="tenderfile" placeholder="Document Icon" accept="application/pdf" />
                                  
                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <img src="https://placehold.jp/100x100.png" id="imgPreview" class="form-control" style="width:100px; height:100px !important; border:1px solid red;" alt="Load Image" />
                                    <input type="hidden" id="DocumentIconName" />
                                </div>

                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <div class="profile-info-name fotm_lbl">StartDate:</div>
                                    <input type="date" class="form-control" id="startdate" placeholder="Start Date" />

                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group">
                                    <div class="profile-info-name fotm_lbl">EndDate:</div>
                                    <input type="date" class="form-control" id="enddate" placeholder="End Date" />

                                </div>
                                <div class="col-md-6 col-sm-12 col-12 form-group" id="StateName">
                                    <div class="profile-info-name fotm_lbl">Status Stage:</div>
                                    <select id="StatusDropDown">
                                        <option value="select" class="form-control txt_design" id="SelectId" placeholder="State Name"></option>
                                    </select>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer" style="background-color:white;">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

        </section>

    </div>

</div>
<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
    <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
</a>

<script src="~/Scripts/tinymce/tinymce.min.js"></script>
<script src="~/Scripts/jquery.ui.widget.js"></script>
<script src="~/Scripts/jquery.fileupload.js"></script>
<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
