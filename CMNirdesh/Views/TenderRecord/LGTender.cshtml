
@model CMNirdesh.Models.DataViewModelTenderList
@{
    int count = 1;
    var path = Model.fileacessingUrl;
}


<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="row">
                    <div class="col-md-12">
                        <div class="inr_frm_dsgn">

                            <!-- Header + Add Button -->
                            <div class="widget-box" id="divAction">
                                <div class="widget-header widget-header-flat rounded-top rounded-0">
                                    <h4>Add Tender</h4>
                                    <div class="widget-toolbar no-border">
                                        <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();" style="font-size:14px;">
                                            <i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New Tender
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Tender Table -->
                            <div class="form_lyot">
                                @if (Model.lgTenders.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover table-bordered" style="font-size:18px;">
                                            <thead>
                                                <tr class="table-heading">
                                                    <th style="width:5%;">Sr.No</th>
                                                    <th style="width:20%;">Tender Name</th>
                                                    <th style="width:20%;">Tender Name (Punjabi)</th>
                                                    <th style="width:10%;">Tender File</th>
                                                    <th style="width:10%;">Start Date</th>
                                                    <th style="width:10%;">End Date</th>
                                                    <th style="width:10%;">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.lgTenders)
                                                {
                                                    <tr>
                                                        <td>@count</td>

                                                        <td>@item.TenderTitle</td>
                                                        <td>@item.TenderTitle_Punjabi</td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.TenderDocumentPath))
                                                            {
                                                                <a href="@Url.Content(Model.fileacessingUrl + "/" + item.TenderDocumentPath)" target="_blank">
                                                                    <img src="/Assets/pdficon.jpg" width="25" height="25" />
                                                                </a>
                                                            }
                                                        </td>
                                                        <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                                                        <td>@item.EndDate.ToString("dd/MM/yyyy")</td>

                                                        <td>
                                                            <div class="d-flex gap-2 align-items-center">
                                                                <a data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@item.TenderId')" title="Edit">
                                                                    <i class="fa fa-pencil text-primary"></i>
                                                                </a>
                                                                <label class="toggle">
                                                                    <input type="checkbox" onclick="DeleteDepartmentRecord('@item.TenderId')" @(item.IsActive ? "checked='checked'" : "") />
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    {
                                                        count++;
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                }
                                else
                                {
                                    <div class="alert alert-info mt-3">
                                        <strong>No tender records found.</strong>
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Add/Edit Modal -->
            <div class="modal fade" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Add New Tender</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-body">
                            <form class="row" id="fileUpload" enctype="multipart/form-data">
                                <input type="hidden" id="TenderId" />



                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Tender Name</label>
                                    <input type="text" id="TenderTitle" class="form-control" placeholder="Tender Name" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Tender Name (Punjabi)</label>
                                    <input type="text" id="TenderTitle_Punjabi" class="form-control" placeholder="Tender Name (Punjabi)" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Tender File (PDF only)</label>
                                    <input type="file" id="tenderfile" class="form-control" accept="application/pdf" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label d-block">File Preview</label>
                                     <a id="Preview"
                                       target="_blank"
                                       href="#"
                                       style="display: none; width: 140px; height: 40px; background-color: #007bff; color: white; text-align: center; line-height: 40px; border-radius: 8px; text-decoration: none; font-weight: bold; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: background-color 0.3s ease;"
                                       onmouseover="this.style.backgroundColor='#0056b3';"
                                       onmouseout="this.style.backgroundColor='#007bff';">
                                        📎 Attached File
                                    </a>
                                    <input type="hidden" id="TenderDocumentPath" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Start Date</label>
                                    <input type="date" id="StartDate" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">End Date</label>
                                    <input type="date" id="EndDate" class="form-control" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <div class="col-6">
                                        <label class="form-label">IsActive</label>
                                        <select class="form-control" id="IsActive">
                                            <option value="true">Yes</option>
                                            <option value="false">No</option>
                                        </select>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="saveTender();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

        </section>
    </div>
</div>



<style>


    .inr_frm_dsgn {
        /*margin-top: 20px;*/
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<script>
    $(document).ready(function () {
        $('#example').DataTable({
        });

    });
    var id = '';
    function getbyID(EmpID) {
      clearTextBox();
      $("#myModalLabel").html("Update LG Tender Details");
        $("#btnUpdate").show();
        $.ajax({
            type: "GET",
            url: '@Url.Action("EditLGTender", "TenderRecord")' + '?Id=' + EmpID,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                var obj = JSON.parse(data);
                var data = obj.lgTenders[0];
                $('#myModal').modal();
                id = EmpID;
                $("#TenderId").val(id);
                $("#TenderTitle").val(data.TenderTitle);
                $('#Preview').show();
                if (data.TenderDocumentPath && data.TenderDocumentPath.trim() !== "") {
                     var basePath = '@Url.Content(path)'; 
                     $('#Preview').attr('href', basePath + '/' + data.TenderDocumentPath);
                     $('#Preview').show(); 
                    } else {
                    $('#Preview').hide(); 
                 }
                $('#TenderDocumentPath').val(data.TenderDocumentPath);
                $("#TenderTitle_Punjabi").val(data.TenderTitle_Punjabi);
                let startdateOnly = data.StartDate.split('T')[0];
                $("#StartDate").val(startdateOnly);
                let enddateOnly = data.EndDate.split('T')[0];
                $("#EndDate").val(enddateOnly);
                $("#IsActive").val(data.IsActive ? "true" : "false");
                $("#btnSave").hide();
            }
        });
    }

    function validate() {
        var isValid = true;
        if ($('#TenderTitle').val().trim() === "") {
            $("#TenderTitle").css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $("#TenderTitle").css('background-color', '');
            isValid = true;
        }

        if ($('#StartDate').val().trim() === "") {
            $("#StartDate").css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $("#StartDate").css('background-color', '');
            isValid = true;
        }

        if ($('#EndDate').val().trim() === "") {
            $("#EndDate").css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $("#EndDate").css('background-color', '');
            isValid = true;
        }

        return isValid;
    }
    function clearTextBox() {
        $('#TenderTitle').val("");
        $('#TenderTitle_Punjabi').val("");
        $('#StartDate').val("");
        $('#EndDate').val("");
        $('#btnSave').show();
        $('#btnUpdate').hide();
        $('#Preview').hide();
    }

    function saveTender() {
            var res = validate();
            if (res == false) {
                return false;
            }
            var formData = new FormData();
            formData.append("TenderTitle", $('#TenderTitle').val());
            formData.append("TenderTitle_Punjabi", $('#TenderTitle_Punjabi').val());
            formData.append("StartDate", $('#StartDate').val());
            formData.append("EndDate", $('#EndDate').val());
            formData.append("IsActive", $('#IsActive').val());
            var fileInput = $('#tenderfile')[0];
            if (fileInput && fileInput.files.length > 0) {
                formData.append("TenderFile", fileInput.files[0]);
            }
            $.ajax({
                url: '@Url.Action("SaveLGTender", "TenderRecord")',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res== 0) {
                        alert("Saved successfully.");
                        location.reload();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error:", error);
                    console.log("Details:", xhr.responseText);
                    alert("An error occurred while saving.");
                }
            });
     }

    function Update() {
        var res = validate();
        if (res == false) {
            return false;
        }
    var formData = new FormData();
    formData.append("TenderId", $('#TenderId').val());
    formData.append("TenderTitle", $('#TenderTitle').val());
    formData.append("TenderTitle_Punjabi", $('#TenderTitle_Punjabi').val());
    formData.append("StartDate", $('#StartDate').val());
    formData.append("EndDate", $('#EndDate').val());
    formData.append("IsActive", $('#IsActive').val());
    formData.append("TenderDocumentPath", $('#TenderDocumentPath').val());

        var fileInput = $('#tenderfile')[0];
    if (fileInput && fileInput.files.length > 0) {
        formData.append("TenderFile", fileInput.files[0]);
    }

    $.ajax({
        url: '@Url.Action("UpdateLGTender", "TenderRecord")',
        type: "POST",
        data: formData,
        processData: false,         // Important!
        contentType: false,         // Important!
        success: function (result) {
             alert("Updated Successfully");
             $('#myModal').modal('hide');
             location.reload();
        },
        error: function (xhr, status, error) {
            alert("Error: " + error);
        }
    });
}



    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {
        debugger
        var i = MyApp
        $.ajax({
            type: "Post",
            url: '@Url.Action("DeleteLGTender", "TenderRecord")' + '?id=' + i,
            success: function (result) {
                alert("Updated Successfully");
             }
        });
    }
</script>
