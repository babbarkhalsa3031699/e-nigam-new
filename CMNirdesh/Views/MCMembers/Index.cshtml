    function Add() {

        var res = validate();
        var MCName = $('#ddlMc option:selected').text();
        if (res == false) {
            return false;
        }

        if (window.FormData !== undefined) {

            var fileUpload = $("#DocumentIcon").get(0);
            var files = fileUpload.files;

            var fileData = new FormData();

            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);
            }

            const courseDto = {
                Name: $('#Name').val(),
                Name_local: $('#Name_local').val(),
                PermanentAddress: $('#PermanentAddress').val(),
                PermanentAddress_local: $('#PermanentAddress_local').val(),
                Designation: $('#Designation option:selected').text(),
                Designation_local: $('#Designation_local option:selected').text(),
                Mobile: $('#Mobile').val(),
                Email: $('#Email').val(),
                Prefix: $('#PrefixDropDown').val(),
                Prefix_local: $('#PrefixDropDown_local').val(),
                MemberCode: $('#MemberCode').val(),
                Gender: $('#Gender').val(),
                memberDOB: $('#memberDOB').val(),
                Description: $('#Description').val(),
                MCCode: $('#ddlMc').val(),
                MCName: MCName,
                Ward: $('#ddlWard').val(),
                Party: $('#ddlParty').val(),
                OfficePhoneNo: $('#OfficePhoneNo').val(),
                State: $('#ddlState').val(),
                District: $('#ddlDistrict').val(),
                //IsAlive: $('#ddlIsAlive').val(),
                committeeType: $('#hiddenCommitteeType').val(),

            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            // Adding one more key to FormData object
            $.ajax({
                url: '@Url.Action("Create", "MCMembers")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    if (result == 1) {
                        alert("Updated Successfully");
                        $('#myModal').hide();
                        location.reload();
                    }
                    else {
                        alert("Member Code Already Present NotUpdated!");
                    }
                },
                error: function (err) {
                    if (err) {
                        alert("Not Updated");
                        $('#myModal').hide();
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
