    function validate() {
        var isValid = true;
        var firstInvalid = null;

        function checkField(selector, errorSelector, condition) {
            var $el = $(selector);
            var $err = $(errorSelector);
            if (condition) {
                $el.addClass('is-invalid').css('background-color', '#fef2f2');
                $err.addClass('show').show();
                isValid = false;
                if (!firstInvalid) firstInvalid = $el;
            } else {
                $el.removeClass('is-invalid').css('background-color', 'white');
                $err.removeClass('show').hide();
            }
        }

        // 1. Name
        checkField('#Name', '#NameValidation', $('#Name').val().trim() === "");

        // 2. Name Punjabi
        checkField('#Name_local', '#NameLocalValidation', $('#Name_local').val().trim() === "");

        // 3. Gender
        checkField('#Gender', '#GenderValidation', $('#Gender').val() === "" || $('#Gender').val() === "0" || $('#Gender').val() === null);

        // 4. Mobile
        var mobVal = $('#Mobile').val().trim();
        var mobInvalid = mobVal === "" || mobVal.length < 10;
        checkField('#Mobile', '#MobileValidation', mobInvalid);

        // 5. Permanent Address
        checkField('#PermanentAddress', '#PermanentAddressValidation', $('#PermanentAddress').val().trim() === "");

        // 6. Permanent Address Punjabi
        checkField('#PermanentAddress_local', '#PermanentAddressLocalValidation', $('#PermanentAddress_local').val().trim() === "");

        // 7. Designation
        var desigVal = $('#Designation').val();
        checkField('#Designation', '#DesignationValidation', !desigVal || desigVal === "" || desigVal === "0" || desigVal.indexOf("Select") >= 0);

        // 8. Designation Punjabi
        var desigLocalVal = $('#Designation_local').val();
        checkField('#Designation_local', '#DesignationLocalValidation', !desigLocalVal || desigLocalVal === "" || desigLocalVal === "0" || desigLocalVal.indexOf("Select") >= 0);

        // 9. MC
