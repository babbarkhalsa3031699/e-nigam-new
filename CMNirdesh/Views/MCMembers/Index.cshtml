@model CMNirdesh.Models.MCHouse.LstMembers

@{
    ViewBag.Title = "Index";
    var roleid = CMNirdesh.Models.CurrentSession.RoleID;
}
<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>

    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>


    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
</head>
<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Members List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New Member</button>
                            </div>
                        </div>
                        <div class="adjust-label adjust-label-house">
                            <div class="d-flex align-items-center gap-2">
                                <label>House:</label>                                
                                <div class="dropdown-arrow">
                                    <select class="form-control" id="mcNav" name="mcNav">
                                        <option value="">-- All (Active) --</option>
                                        @foreach (var item in Model.Houses)
                                        {
                                            <option value="@item.AssemblyID">@item.AssemblyName</option>
                                        }
                                    </select>
                                    <i class=" fas fa-chevron-down"></i>
                                </div>
                                
                            </div>
                            <span id="depcount" class="bubble blink" style="display: none;"></span>
                        </div>
                    </div>


                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            <div class=" table-responsive">
                                <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                    <thead>
                                        <tr class="table-heading">
                                            <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Name</span></th>
                                            <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Name(Punjabi)</span></th>
                                            <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Permanent Address</span></th>
                                            <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Permanent Address(Punjabi)</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Mobile</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Email</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Designation</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Designation(Punjabi)</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Ward</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Member Code</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Icon</span></th>
                                            <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                        </tr>
                                    </thead>
                                    <tbody role="alert" aria-live="polite" aria-relevant="all">
                                        @if (Model._LstMembers.Count() > 0)
                                        {
                                            foreach (var items in Model._LstMembers)
                                            {
                                                string iconsource = !string.IsNullOrEmpty(items.Icon) ? Url.Content("~/" + items.Icon) : string.Empty;
                                                <tr>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Name)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Name_local)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.PermanentAddress)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.PermanentAddress_local)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Mobile)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Email)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Designation)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Designation_local)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.WardName)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.MemberCode)</td>

                                                    <td class="center td-data" style="padding: 14px 4px !important"><img src="@Url.Content(@Model.fileacessingUrl +"/" + items.Icon)" height="100" width="100" /></td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        @if (items.IsHouseActive && items.IsWardActive)
                                                        {
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="imageurl" value="@iconsource" />
                                                                    <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.MemberID')">
                                                                        <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                    </a>

                                                                </div>
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MemberID')" value="@items.MemberID" />
                                                                </div>
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MemberID')" value="@items.MemberID" />
                                                                    <label class="toggle mb-0">
                                                                        <input type="checkbox" onclick="DeleteDepartmentRecord('@items.MemberID')" @(Convert.ToBoolean(items.Active) == true ? "checked='checked'" : string.Empty)>
                                                                        <span class="slider"></span>
                                                                        <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <p>-</p>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                </div>
            </div>
            <div class="coman_modal dispatch_modal addnew_modal modal member-record-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Member Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="fileUpload" enctype="multipart/form-data">
                                <input type="hidden" class="form-control" id="id" />

                                <!-- Section 1: Personal Details -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-user"></i> Personal Details</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Prefix:</div>
                                            <select id="PrefixDropDown">
                                                <option value="0" class="form-control txt_design">Please select</option>
                                                <option value="Sh." class="form-control txt_design">Sh.</option>
                                                <option value="Smt." class="form-control txt_design">Smt.</option>
                                                <option value="Smt." class="form-control txt_design">Miss</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Prefix(Punjabi):</div>
                                            <select id="PrefixDropDown_local">
                                                <option value="0" class="form-control txt_design">Please select</option>
                                                <option value="ਸ਼੍ਰੀ" class="form-control txt_design">ਸ਼੍ਰੀ</option>
                                                <option value="ਸ਼੍ਰੀਮਤੀ" class="form-control txt_design">ਸ਼੍ਰੀਮਤੀ</option>
                                                <option value="ਸ਼੍ਰੀਮਤੀ" class="form-control txt_design">ਮਿਸ</option>
                                            </select>
                                        </div>

                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Name:</div>
                                            <input type="text" class="form-control" id="Name" placeholder="Name" />
                                            <span id="NameValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Name is required</span>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Name(Punjabi):</div>
                                            <input type="text" class="form-control" id="Name_local" placeholder="Name(Punjabi)" />
                                            <span id="NameLocalValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Name (Punjabi) is required</span>
                                        </div>

                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Gender</div>
                                            <select id="Gender" name="Gender">
                                                <option value="">Select</option>
                                                <option value="M">Male</option>
                                                <option value="F">Female</option>
                                                <option value="O">Other</option>
                                            </select>
                                            <span id="GenderValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Please select Gender</span>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Member DOB</div>
                                            <input type="date" class="form-control" id="memberDOB" placeholder="DOB" />
                                        </div>

                                        <div class="form-group col-full" id="MemberCodeField" style="margin: 0; padding: 0;">
                                            @Html.HiddenFor(model => model.MemberCodeOld, new { id = "MemberCode" })
                                            <input type="hidden" id="MemberID" name="MemberID" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 2: Contact Details & Address -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-address-card-o"></i> Contact Details &amp; Address</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Mobile (Max. 10 Digit)</div>
                                            <input type="text" class="form-control" id="Mobile" placeholder="Mobile" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                            <span id="MobileValidation" class="member-val-msg">MOBILE NUMBER SHOULD BE 10 DIGITS</span>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Email</div>
                                            <input type="text" class="form-control" id="Email" placeholder="Email" />
                                            <span id="EmailValidation" class="member-val-msg">EMAIL FORMAT INVALID</span>
                                        </div>

                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Permanent Address</div>
                                            <input type="text" class="form-control" id="PermanentAddress" placeholder="Permanent Address" />
                                            <span id="PermanentAddressValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Permanent Address is required</span>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Permanent Address(Punjabi)</div>
                                            <input type="text" class="form-control" id="PermanentAddress_local" placeholder="Permanent Address(Punjabi)" />
                                            <span id="PermanentAddressLocalValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Permanent Address (Punjabi) is required</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 3: Designation & Representation -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-id-badge"></i> Designation &amp; Representation</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Designation</div>
                                            @Html.DropDownList(
                                                 "Designation",
                                                 Model._LstDesignation,
                                                 "-------- Select Designation ---------",
                                                 new { @class = "form-control", required = "required" }
                                             )
                                            <span id="DesignationValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Please select Designation</span>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Designation(Punjabi)</div>
                                            @Html.DropDownList("Designation_local", Model._LstDesignationlocal, "--------  Select Designation -------- ", new { @class = "form-control", required = "required" })
                                            <span id="DesignationLocalValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Please select Designation (Punjabi)</span>
                                        </div>

                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">MC</div>
                                            <select id="ddlMc">
                                                <option value="select" class="form-control txt_design"></option>
                                            </select>
                                            <span id="McValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Please select MC</span>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Ward</div>
                                            <select id="ddlWard" required="required">
                                                <option value="select" class="form-control txt_design"></option>
                                            </select>
                                            <span id="WardValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Please select Ward</span>
                                        </div>

                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Party</div>
                                            <select id="ddlParty">
                                                <option value="select" class="form-control txt_design"></option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">Office Phone No.</div>
                                            <input type="text" class="form-control" id="OfficePhoneNo" placeholder="Office Phone No." />
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 4: Location Details -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-globe"></i> Location Details</div>
                                    <div class="form-card-grid">
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">State</div>
                                            <select id="ddlState">
                                                <option value="select" class="form-control txt_design" id="SelectId"></option>
                                            </select>
                                            <span id="StateValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Please select State</span>
                                        </div>
                                        <div class="form-group">
                                            <div class="profile-info-name fotm_lbl">District</div>
                                            <select id="ddlDistrict">
                                                <option value="select" class="form-control txt_design"></option>
                                            </select>
                                            <span id="DistrictValidation" class="member-val-msg"><i class="fa fa-exclamation-circle"></i> Please select District</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Section 5: Member Photo -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-picture-o"></i> Member Photo</div>
                                    <div class="form-group">
                                        <div class="profile-info-name fotm_lbl">Member Icon:</div>
                                        <div class="odm-upload-card">
                                            <div class="odm-upload-preview">
                                                <img src="https://placehold.jp/100x100.png" id="imgPreview" class="form-control" alt="Load Image" />
                                            </div>
                                            <div class="odm-upload-input-wrap">
                                                <input type="file" name="file" class="form-control" id="DocumentIcon" placeholder="Document Icon" accept=".jpg,.jpeg,.bmp,.png,.gif" />
                                                <span class="odm-upload-hint">Accepted formats: JPG, PNG, GIF, BMP</span>
                                            </div>
                                        </div>
                                        <input type="hidden" id="DocumentIconName" />
                                    </div>
                                </div>

                                <!-- Section 6: Committee Member Type -->
                                <div class="form-section-card">
                                    <div class="form-section-title"><i class="fa fa-users"></i> Committee Member Type</div>
                                    <div class="form-group">
                                        <div class="member-committee-chips">
                                            @foreach (var item in Model._CommitteeType)
                                            {
                                                <label class="member-committee-item" for="@item.Value">
                                                    <input type="checkbox" id="@item.Value" name="ChkStatusFilter" value="@item.Value" onclick="StatusFilter1(this, this.value)" />
                                                    <span class="lbltxt">@item.Text</span>
                                                </label>
                                            }
                                        </div>
                                        <input type="hidden" id="hiddenCommitteeType" name="HiddenCommitteeType" value="" />
                                        <input type="hidden" id="hdnmeetingtype" />
                                    </div>
                                </div>

                            </form>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>




<style>

    /* ==========================================================================
       DESIGN SYSTEM FOR ADD / UPDATE MEMBER RECORD MODAL
       Derived directly from the "Add Proposal" Modal Reference System
       Scoped strictly under: .member-record-modal
       ========================================================================== */

    /* 1. Modal Dialog & Viewport Containment */
    .modal.member-record-modal.addnew_modal,
    .modal.member-record-modal.coman_modal,
    .modal.member-record-modal.dispatch_modal {
        padding: 0 !important;
    }

    .member-record-modal.modal {
        padding: 0 !important;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans Gurmukhi", "Raavi", sans-serif;
    }

    .member-record-modal .modal-dialog {
        display: flex;
        align-items: center;
        justify-content: center;
        max-width: 920px;
        width: calc(100% - 2rem);
        margin: 1.5rem auto;
        min-height: calc(100% - 3rem);
    }

    .member-record-modal .modal-content {
        border: 1px solid #e2e8f0 !important;
        border-radius: 12px !important;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05) !important;
        background-color: #f8fafc !important;
        overflow: hidden !important;
    }

    /* 2. Modal Header & Accent Bar */
    .member-record-modal .modal-header {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 16px 24px !important;
        background: #ffffff !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }

    .member-record-modal .modal-header .modal-title {
        font-size: 17px !important;
        font-weight: 700 !important;
        letter-spacing: -0.01em !important;
        color: #0f172a !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
    }

    .member-record-modal .modal-header .modal-title::before {
        content: "";
        display: inline-block;
        width: 4px;
        height: 18px;
        background: #2563eb;
        border-radius: 2px;
    }

    .member-record-modal .modal-header .btn-close {
        padding: 8px !important;
        margin: 0 !important;
        opacity: 0.55 !important;
        transition: all 0.15s ease !important;
        border-radius: 6px !important;
    }

    .member-record-modal .modal-header .btn-close:hover {
        opacity: 1 !important;
        background-color: #f1f5f9 !important;
        transform: scale(1.05) !important;
    }

    /* 3. Modal Body & Custom Scrollbar */
    .member-record-modal .modal-body {
        padding: 20px 24px !important;
        background-color: #f8fafc !important;
        scrollbar-width: thin !important;
        scrollbar-color: #cbd5e1 transparent !important;
        max-height: calc(85vh - 70px) !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }

    .member-record-modal .modal-body::-webkit-scrollbar {
        width: 6px;
    }

    .member-record-modal .modal-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .member-record-modal .modal-body::-webkit-scrollbar-thumb {
        background-color: #cbd5e1;
        border-radius: 4px;
    }

    .member-record-modal .modal-body::-webkit-scrollbar-thumb:hover {
        background-color: #94a3b8;
    }

    /* 4. Form Section Cards */
    .member-record-modal .form-section-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 16px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .member-record-modal .form-section-title {
        font-size: 11px !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        color: #475569;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding-bottom: 8px;
        border-bottom: 1px solid #f1f5f9;
    }

    .member-record-modal .form-section-title i {
        color: #2563eb;
        font-size: 13px !important;
    }

    /* 5. 2-Column Responsive Layout */
    .member-record-modal .form-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px 18px;
        align-items: start;
    }

    @@media (max-width: 767px) {
        .member-record-modal .modal-dialog {
            margin: 0.75rem auto;
            width: calc(100% - 1.5rem);
        }

        .member-record-modal .form-card-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .member-record-modal .modal-footer {
            padding: 12px 16px !important;
        }

        .member-record-modal .modal-footer .btn {
            flex: 1 1 auto;
        }
    }

    .member-record-modal .col-full {
        grid-column: 1 / -1;
    }

    /* 6. Form Groups & Field Labels */
    .member-record-modal .form-group {
        margin-bottom: 0;
        display: flex;
        flex-direction: column;
    }

    .member-record-modal .fotm_lbl,
    .member-record-modal .profile-info-name.fotm_lbl,
    .member-record-modal label.fotm_lbl {
        font-size: 12px !important;
        font-weight: 600 !important;
        letter-spacing: normal !important;
        color: #334155 !important;
        margin-bottom: 6px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between;
        width: 100% !important;
        text-align: left !important;
        float: none !important;
        padding-left: 0 !important;
    }

    /* 7. Inputs, Selects & Date Controls */
    .member-record-modal input[type="text"],
    .member-record-modal input[type="date"],
    .member-record-modal select,
    .member-record-modal .form-control {
        width: 100% !important;
        height: 38px !important;
        min-height: 38px !important;
        padding: 6px 12px !important;
        font-size: 13px !important;
        font-weight: 400 !important;
        line-height: normal !important;
        color: #0f172a !important;
        background-color: #ffffff;
