                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <div class="profile-info-name fotm_lbl">District</div>
                                        <select id="ddlDistrict">
                                            <option value="select" class="form-control txt_design"></option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    @*<div class="col-6">
                                        <div class="profile-info-name fotm_lbl">Is Alive</div>
                                        <select id="ddlIsAlive" name="Gender">
                                            <option value="Y" selected>Yes</option>
                                            <option value="N">No</option>
                                        </select>
                                    </div>*@
                                    <div class="col-6">
                                        <div class="profile-info-name fotm_lbl">
                                            Member Icon:
                                        </div>
                                        <input type="file" name="file" class="form-control" id="DocumentIcon" placeholder="Document Icon" accept=".jpg,.jpeg,.bmp,.png,.gif" />
                                        <img src="https://placehold.jp/100x100.png" id="imgPreview" class="form-control" style="width:100px; height:100px; border:1px solid red;" alt="Load Image" />
                                        <input type="hidden" id="DocumentIconName" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="profile-info-name fotm_lbl col-12 pl-3" style="display: flex;">
                                        Commitee Member Type:
                                    </div>
                                    <div class="col-12">
                                        <p class="pera_txt_design">

                                            @foreach (var item in Model._CommitteeType)
                                            {
                                                <div class="checkbox" style="display: inline;">
                                                    <input type="checkbox" id="@item.Value" name="ChkStatusFilter" value="@item.Value" onclick="StatusFilter1(this, this.value)" />
                                                    <label for="@item.Value" class="lbltxt">@item.Text</label>
                                                </div>
                                            }
                                            <input type="hidden" id="hiddenCommitteeType" name="HiddenCommitteeType" value="" />
                                            <input type="hidden" id="hdnmeetingtype" />
                                        </p>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="modal-footer" style="background-color:white;">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>




<style>


    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }


    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }

    .adjust-label-house {
        color: #1974d2 !important;
        padding: 10px 10px 0px 10px;
        justify-content: end;
    }

    .adjust-label-house .dropdown-arrow select.form-control {
        color: #1974d2 !important;
        border: 1px solid #1974d2 !important;
    }

    .adjust-hidde-active-div{
        text-align:center;
    }

    .dropdown-relative
    {
        position: relative;
    }
</style>

<script>
    memberData = null;

    function StatusFilter1(checkbox, value) {
        // Uncheck all checkboxes except the one that was just checked
        var checkboxes = document.querySelectorAll('input[type="checkbox"][name="ChkStatusFilter"]');
        checkboxes.forEach(function (cb) {
            if (cb !== checkbox && cb.checked) {
                cb.checked = false;
            }
        });
       var hiddenInput = document.getElementById('hiddenCommitteeType');
        if (checkbox.checked) {
            hiddenInput.value = value;
        } else {
            hiddenInput.value = '';
        }
    }
    $(document).ready(function () {
        $('#example').DataTable({
        });

        $('#mcNav').on('change', function () {
            var assemblyId = $(this).val();
            $("#loader-wrapper").show();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CallSearchedMCMembers", "MCMembers")',
                data: { assemblyId: assemblyId },
                success: function (response) {
                    debugger
                    var obj = JSON.parse(response);
                    var members = obj.members;
                    var fileacessingUrl = obj.fileacessingUrl;
                    var table = $('#example').DataTable();
                    table.clear().destroy();
                    
                    var tbody = $('#example tbody');
                    tbody.empty();
                    
                    if (members && members.length > 0) {
                        $.each(members, function (index, item) {
                            var activeChecked = item.Active ? 'checked="checked"' : '';
                            var imgSrc = fileacessingUrl + '/' + item.Icon;
                            var iconSource = item.Icon ? ('/' + item.Icon) : '';
                            
                            var row = '<tr>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.Name || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.Name_local || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.PermanentAddress || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.PermanentAddress_local || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.Mobile || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.Email || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.Designation || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.Designation_local || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.WardName || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' + (item.MemberCode || '') + '</td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important"><img src="' + imgSrc + '" height="100" width="100" /></td>' +
                                '<td class="center td-data" style="padding: 14px 4px !important">' +
                                (
                                    (item.IsWardActive && item.IsHouseActive) ?
                                    '<div class="d-flex align-items-center gap-2">' +
                                        '<div class="hidden-sm hidden-xs action-buttons">' +
                                            '<input type="hidden" id="imageurl" value="' + iconSource + '" />' +
                                            '<a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID(\'' + item.MemberID + '\')">' +
                                                '<i class="ace-icon fa fa-pencil bigger-130"></i>' +
                                            '</a>' +
