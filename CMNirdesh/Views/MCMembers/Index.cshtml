    function setDesignationByText(text) {
        if (!text) return;

        $("#Designation option").each(function () {
            if ($(this).text().trim().toLowerCase() === text.trim().toLowerCase()) {
                $(this).prop("selected", true);
                return false; // break loop
            }
        });

        $("#Designation").trigger("change");
    }

    function setDesignationByTextLocal(text) {
        if (!text) return;

