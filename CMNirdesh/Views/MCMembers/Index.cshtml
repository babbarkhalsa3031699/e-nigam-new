                                                        @if (items.IsHouseActive && items.IsWardActive)
                                                        {
                                                            <div class="d-flex align-items-center gap-2">
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="imageurl" value="@iconsource" />
                                                                    <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.MemberID')">
                                                                        <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                    </a>

                                                                </div>
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MemberID')" value="@items.MemberID" />
                                                                </div>
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MemberID')" value="@items.MemberID" />
