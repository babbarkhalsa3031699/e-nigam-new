<style>

    
    .inr_frm_dsgn {
        margin-top: 20px;
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .inr_frm_dsgn {
        margin-top: 20px;
    }

    .form_lyot {
        padding: 10px;
    }

    

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
    
</style>

<script>
    $(document).ready(function () {
        $('#example').DataTable({
        });
    });


    function getbyID(EmpID) {

        clearTextBox();

        var url = "/mVenueMeeting/Edit?id=" + EmpID;



        $("#myModalLabel").html("Update Menu Options");

        $("#btnUpdate").show();
        $("#btnSave").hide();


        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {

                var obj = JSON.parse(data);
                console.log(obj);
             
                var data = obj._MeetingVenueList[0];

                console.log(data);


                $('#myModal').modal();
                $("#MeetingId").val(data.MeetingVenueId);
                $("#MeetingVenueName").val(data.MeetingVenueName);
                $("#MeetingVenueLocalName").val(data.MeetingVenueNameLocal);

                /**/

                /**/
                /*  alert($("#DocumentIconImage").attr("src").val());*/



                $("#btnSave").hide();
            }
        });
    }




    //Function for clearing the textboxes

    //Valdidation using jquery
    function validate() {

        var isValid = true;
        if ($('#MeetingVenueName').val() == "") {
            $('#MeetingVenueName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#MeetingVenueName').css('background-color', 'white');
            
        }


        if ($('#MeetingVenueLocalName').val() == "") {
            $('#MeetingVenueLocalName').css('background-color', '#ff56564d');
            isValid = false;
        }

        else {
          
            $('#MeetingVenueLocalName').css('background-color', 'white');
        }

        return isValid;
    }


    function clearTextBox() {

        $('#MeetingId').val("");
        $('#MeetingVenueName').val("");
        $('#MeetingVenueLocalName').val("");
        $('#MeetingVenueName').css('background-color', 'white');
        $('#MeetingVenueLocalName').css('background-color', 'white');



        $('#btnUpdate').hide();
        $("#MeetingId").removeAttr("disabled", "disabled");
        $("#myModalLabel").html("Add Menu Options");
        $("#MenuOption").hide();
        $('#btnSave').show();


    }

    function Add() {


        var res = validate();
