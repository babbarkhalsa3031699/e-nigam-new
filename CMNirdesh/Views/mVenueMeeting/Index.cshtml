<div id="main-content">

<div class="main-content">
    <!-- #section:basics/content.breadcrumbs -->

    <section class="form_dsign">
        <div class="container-fluid">
            
            <div class="inr_frm_dsgn">
                <div class="Tab_hdr p-2 d-flex flex-wrap align-items-center" >
                    <div class="col-md-6 col-sm-6 col-xs-12 p-2">
                        <h2>Meeting Venue List</h2>
                    </div>
                    <div class="col-md-6 col-sm-6 col-xs-12 p-2 text-end txt_rit">
                        <p>
                            <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New Meeting Venue</button>

                        </p>
                    </div>

                </div>

                <div class="form_lyot">
                    @if (Model != null)
                    {
                        if (Model._MeetingVenueList.Count() > 0)
                        {
                            <div class="table-responsive ">
                                <table id="example" class="table table-hover table-bordered ">
                                    <thead>
                                        <tr class="table-heading">
                                            <th class="td-heading" style="width:20%;"><span class="font-weight-bold">Meeting Venue Id</span></th>
                                            <th class="td-heading" style="width:35%;"><span class="font-weight-bold">Meeting Venue Name</span></th>
                                            <th class="td-heading" style="width:35%;"><span class="font-weight-bold">Meeting Venue Name Local</span></th>
                                            <th class="td-heading" style="width:35%;"><span class="font-weight-bold">Edit Meeting Venue</span></th>


                                        </tr>
                                    </thead>
                                    <tbody role="alert" aria-live="polite" aria-relevant="all">
