                                        {

                                            <tr>
                                                <td class="center td-data" style="font-size:14px;">@Html.DisplayFor(modelItem => items.MeetingVenueId)</td>
                                                <td class="center td-data" style="font-size:14px;">@Html.DisplayFor(modelItem => items.MeetingVenueName)</td>
                                                <td class="center td-data" style="font-size:14px;">@Html.DisplayFor(modelItem => items.MeetingVenueNameLocal)</td>

                                                <td class="center td-data edit-1" style="font-size:14px;">
            <div class="hidden-sm hidden-xs action-buttons">


                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.MeetingVenueId')">

                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                </a>

            </div>

            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MeetingVenueId')" value="@items.MeetingVenueId" />
            <div class="hidden-sm hidden-xs action-buttons">
                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.MeetingVenueId')" value="@items.MeetingVenueId" />
                <label class="toggle mb-0">
                    <input type="checkbox" onclick="DeleteDepartmentRecord('@items.MeetingVenueId')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                    <span class="slider"></span>
                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                </label>
            </div>

        </td>
                                            </tr>
                                        }
                                    </tbody>

                                </table>
                            </div>

                        }
                        else
                        {
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="alert alert-info">
                                        <strong>There are no record found</strong><br />
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
          
        </div>

        <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fs-5" id="myModalLabel">Add Meeting Options</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="fileUpload" enctype="multipart/form-data">


                            <div class="form-group">
                                <div class="profile-info-name fotm_lbl">Meeting Venue Id:</div>
                                <input type="text" class="form-control" id="MeetingId" placeholder="Meeting Id" />
                            </div>


                            <div class="form-group">
                                <div class="profile-info-name fotm_lbl">
                                    Meeting Venue Name:
                                </div>
                                <input type="text" class="form-control" id="MeetingVenueName" placeholder="Meeting Venue Name" />
                            </div>

                            <div class="form-group">
                                <div class="profile-info-name fotm_lbl">
                                    Meeting Venue Local Name:
                                </div>
                                <input type="text" class="form-control" id="MeetingVenueLocalName" placeholder="Meeting Venue Local Name" />
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer" style="background-color:white;">
                        <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                        <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    </div>

</div>

