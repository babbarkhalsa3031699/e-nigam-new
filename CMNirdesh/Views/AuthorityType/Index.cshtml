@model CMNirdesh.Models.AuthorityTypeList
@{
    ViewBag.Title = "Authority Type List";
}

<head>
    <script src="~/Scripts/tinymce/tinymce.min.js"></script>
    <script src="~/Scripts/jquery.ui.widget.js"></script>
    <script src="~/Scripts/jquery.fileupload.js"></script>

    <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
    <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
    <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>


    <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
</head>
<div id="main-content">
    <div class="main-content">
        <div class="container mt-4">

            <!-- Add Form -->
            <div class="card mb-4">
                <div class="card-header">Add New Authority Type</div>
                <div class="card-body">
                    <form id="createAuthorityTypeForm">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="AuthorityTypeName">Authority Type Name</label>
                                <input type="text" class="form-control" id="AuthorityTypeName" name="AuthorityTypeName" required />
                            </div>
                            <div class="col-md-3 mt-4">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="IsActive" name="IsActive" checked />
                                    <label class="form-check-label" for="IsActive">Is Active</label>
                                </div>
                            </div>
                            <div class="col-md-3 mt-4">
                                <button type="submit" class="btn btn-success">Save</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class='form_lyot'>
                <h5 class="mb-4">Authority Type List</h5>

                <!-- Table Listing -->
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Sr No.</th>
                            <th>Authority Type Name</th>
                            <th>Is Active</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model._LstAuthorityType != null && Model._LstAuthorityType.Count > 0)
                        {
                            int i = 1;
                            foreach (var item in Model._LstAuthorityType)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>@item.AuthorityTypeName</td>
                                    <td>@(item.IsActive ? "Yes" : "No")</td>
                                   
                                    <td class="center td-data" style="padding: 14px 4px !important">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="hidden-sm hidden-xs action-buttons">

                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="editAuthorityType('@item.AuthorityTypeId')">
                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                </a>

                                            </div>

                                            <div class="hidden-sm hidden-xs action-buttons">

                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="deleteAuthorityType('@item.AuthorityTypeId')">
                                                    <i class="ace-icon fa fa-trash bigger-130" aria-hidden="true"></i>
                                                </a>

                                            </div>

                                        </div>

                                    </td>

                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center">No records found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Edit Modal -->
        <div class="modal fade" id="editAuthorityTypeModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form id="updateAuthorityTypeForm">
                        <div class="modal-header">
                            <h5 class="modal-title">Edit Authority Type</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="EditAuthorityTypeId" name="AuthorityTypeId" />
                            <div class="mb-3">
                                <label for="EditAuthorityTypeName" class="form-label">Authority Type Name</label>
                                <input type="text" class="form-control" id="EditAuthorityTypeName" name="AuthorityTypeName" required />
                            </div>
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="EditIsActive" name="IsActive" />
                                <label class="form-check-label" for="EditIsActive">Is Active</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Update</button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            // Create
            $('#createAuthorityTypeForm').submit(function (e) {
                e.preventDefault();

                var formData = {
                    AuthorityTypeName: $('#AuthorityTypeName').val(),
                    IsActive: $('#IsActive').is(':checked'),
                    CreatedDate: new Date().toISOString(),
                    IsDeleted: false
                };

                $.ajax({
                    url: '@Url.Action("Create", "AuthorityType")',
                    type: 'POST',
                    data: formData,
                    success: function (res) {
                        if (res > 0) {
                            alert("Authority Type saved successfully.");
                            location.reload();
                        } else {
                            alert("Save failed.");
                        }
                    },
                    error: function () {
                        alert("Error occurred while saving.");
                    }
                });
            });

            // Update
            $('#updateAuthorityTypeForm').submit(function (e) {
                e.preventDefault();

                var updateData = {
                    AuthorityTypeId: $('#EditAuthorityTypeId').val(),
                    AuthorityTypeName: $('#EditAuthorityTypeName').val(),
                    IsActive: $('#EditIsActive').is(':checked'),
                    ModifiedDate: new Date().toISOString()
                };

                $.ajax({
                    url: '@Url.Action("Update", "AuthorityType")',
                    type: 'POST',
                    data: updateData,
                    success: function (res) {
                        if (res > 0) {
                            alert("Authority Type updated successfully.");
                            $('#editAuthorityTypeModal').modal('hide');
                            location.reload();
                        } else {
                            alert("Update failed.");
                        }
                    },
                    error: function () {
                        alert("Error occurred while updating.");
                    }
                });
            });
        });

        function editAuthorityType(id) {
            $.ajax({
                url: '@Url.Action("Edit", "AuthorityType")',
                type: 'GET',
                data: { id: id },
                success: function (authority) {
                    var obj = JSON.parse(authority);
                    $('#EditAuthorityTypeId').val(obj.AuthorityTypeId);
                    $('#EditAuthorityTypeName').val(obj.AuthorityTypeName);
                    $('#EditIsActive').prop('checked', obj.IsActive);

                    $('#editAuthorityTypeModal').modal('show');
                },
                error: function () {
                    alert("Failed to load authority type.");
                }
            });
        }

        function deleteAuthorityType(id) {
            if (confirm('Are you sure you want to delete this authority type?')) {
                $.ajax({
                    url: '@Url.Action("Delete", "AuthorityType")',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res > 0) {
                            alert("Deleted successfully.");
                            location.reload();
                        } else {
                            alert("Delete failed.");
                        }
                    },
                    error: function () {
                        alert("Error occurred while deleting.");
                    }
                });
            }
        }
    </script>
}
