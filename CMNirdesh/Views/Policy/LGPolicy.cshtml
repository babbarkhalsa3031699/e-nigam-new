@model CMNirdesh.Models.DataViewModelPolicyList
@{
    ViewBag.Title = "Manage LG Policies";
}
@using CMNirdesh;

<div id="main-content">

    <div class="main-content">
    

            <section class="form_dsign">
                <div class="container-fluid p-0">

                    <div class="inr_frm_dsgn">

                        <div class="widget-box " id="divAction">
                            <div class="widget-header widget-header-flat rounded-top rounded-0">
                                <h4 class=""> Local Govorment Policies </h4>
                                <div class="widget-toolbar no-border">
                                    <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" style="font-size:14px;" onclick="clearForm();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i>Add New Policy</button>
                                </div>
                            </div>
                        </div>



                        <div class="form_lyot">

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover" id="tblPolicies">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>#</th>
                                            <th>Policy Title</th>
                                            <th>Title (Punjabi)</th>
                                            <th>Category</th>
                                            <th>Start Date</th>
                                            <th>End Date</th>
                                            <th>Document</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.lgPolicies != null)
                                        {
                                            int i = 1;
                                            foreach (var item in Model.lgPolicies)
                                            {
                                                <tr>
                                                    <td>@(i++)</td>
                                                    <td>@item.PolicyTitle</td>
                                                    <td>@item.PolicyTitle_Punjabi</td>
                                                    <td>@item.CategoryName</td>
                                                    <td>@(item.StartDate.HasValue ? item.StartDate.Value.ToString("dd-MM-yyyy") : "")</td>
                                                    <td>@(item.EndDate.HasValue ? item.EndDate.Value.ToString("dd-MM-yyyy") : "")</td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(item.PolicyDocumentPath))
                                                        {
                                                          <a target="_blank" href="@Url.Content(@Model.fileacessingUrl + "/" + item.PolicyDocumentPath)"><img src="/Assets/pdficon.jpg" height="25" width="25" /></a>
                                                        }
                                                        </td>
                                                        <td>
                                                            @if (item.IsActive)
                                                            {
                                                                <span>Active</span>
                                                            }
                                                            else
                                                            {
                                                                <span>Inactive</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @*<button class="btn btn-sm btn-info" onclick="editPolicy(@item.PolicyId)">Edit</button>*@
                                                            <div class="edit-1">
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="editPolicy('@item.PolicyId')">
                                                                        <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                    </a>
                                                                </div>
                                                                <div class="hidden-sm hidden-xs action-buttons">
                                                                    <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@item.PolicyId')" value="@item.PolicyId" />
                                                                    <label class="toggle mb-0">
                                                                        <input type="checkbox" onclick="deletePolicy('@item.PolicyId')" @(Convert.ToBoolean(item.IsActive) == true ? "checked='checked'" : string.Empty)>
                                                                        <span class="slider"></span>
                                                                        <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                    </label>
                                                                </div>
                                                            </div>
                                                                
                                                        </td>
                                                    </tr>
                                            }
                                        }
                                    </tbody>
                                </table>

                            </div>

                        </div>


                    </div>

                </div>

                <!-- Modal -->
                <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-xl">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title fs-5" id="myModalLabel">Add New Policy</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data", id = "policyForm" }))
                                {
                                    @Html.Hidden("PolicyId")
                                    <div class="mb-3">
                                        <label>Policy Title</label>
                                        <input type="text" class="form-control" name="PolicyTitle" required />
                                    </div>
                                    <div class="mb-3">
                                        <label>Policy Title (Punjabi)</label>
                                        <input type="text" class="form-control" name="PolicyTitle_Punjabi" />
                                    </div>
                                    <div class="mb-3">
                                        <label>Category</label>
                                        <select name="CategoryId" class="form-select" required id="ddlCategory"></select>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label>Start Date</label>
                                            <input type="date" class="form-control" name="StartDate" required />
                                        </div>
                                        <div class="col-md-6">
                                            <label>End Date</label>
                                            <input type="date" class="form-control" name="EndDate" required />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label>Upload Document</label>
                                        <input type="file" name="PolicyDocument" class="form-control" />
                                        <input type="hidden" name="PolicyDocumentPath" id="PolicyDocumentPath"  />

                                    </div>
                                    <div class="form-check mb-3">
                                        @*<input type="hidden" name="IsActive" value="false" />*@
                                        <input type="checkbox" class="form-check-input" name="IsActive" id="IsActive" value="true" checked />
                                        <label class="form-check-label" for="IsActive">Active</label>
                                    </div>
                                }
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" onclick="savePolicy()">Save</button>

                            </div>
                        </div>
                    </div>
                </div>

            </section>
        </div>
    </div>
        <script src="~/Scripts/tinymce/tinymce.min.js"></script>
        <script src="~/Scripts/jquery.ui.widget.js"></script>
        <script src="~/Scripts/jquery.fileupload.js"></script>
        <link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
        <link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
        <script src="~/Scripts/datatables/jquery.dataTables.js"></script>
        <script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
        <script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>


        <style>


            .inr_frm_dsgn {
                /*margin-top: 20px;*/
                box-shadow: 0px 0px 4px 1px #ccc;
                border-top-left-radius: 5px;
                border-top-right-radius: 5px;
            }

            .form_lyot {
                padding: 10px;
            }


            .addnew_modal {
                padding-right: 300px !important;
                padding-left: 300px;
                padding-top: 94px;
                padding-bottom: 94px;
            }

            .toggle {
                --width: 80px;
                --height: calc(var(--width) / 3);
                position: relative;
                display: inline-block;
                width: var(--width);
                height: var(--height);
                border-radius: var(--height);
                cursor: pointer;
            }

                .toggle input {
                    display: none;
                }

                .toggle .slider {
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    border-radius: var(--height);
                    border: 2px solid #969696;
                    box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
                    transition: all 0.4s ease-in-out;
                }

                    .toggle .slider::before {
                        content: "";
                        position: absolute;
                        top: 3.5px;
                        left: 2px;
                        width: calc(var(--height)*0.6);
                        height: calc(var(--height)*0.6);
                        border-radius: calc(var(--height) / 2);
                        border: 3px solid #969696;
                        background-color: #dbdbdb;
                        box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                        transition: all 0.4s ease-in-out;
                    }

                .toggle input:checked + .slider {
                    border-color: #2196F3;
                }

                    .toggle input:checked + .slider::before {
                        border-color: #2196F3;
                        background-color: #c6e5ff;
                        transform: translateX(calc(var(--width) - var(--height)));
                    }

                .toggle .labels {
                    position: absolute;
                    top: 4.5px;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    color: #4d4d4d;
                    font-size: 12px;
                    font-family: sans-serif;
                    transition: all 0.4s ease-in-out;
                }

                    .toggle .labels::after {
                        content: attr(data-off);
                        position: absolute;
                        right: 5px;
                        opacity: 1;
                        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                        transition: all 0.4s ease-in-out;
                    }

                    .toggle .labels::before {
                        content: attr(data-on);
                        position: absolute;
                        left: 5px;
                        opacity: 0;
                        text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                        transition: all 0.4s ease-in-out;
                    }

                .toggle input:checked ~ .labels::after {
                    opacity: 0;
                }

                .toggle input:checked ~ .labels::before {
                    opacity: 1;
                }

            .pencil-class {
                font-size: 15px;
            }

            .edit-1 {
                display: flex;
                align-items: center;
                gap: 10px;
                border: none;
            }
        </style>

        <script>

            $(function () {
                loadCategories();
            });

            function loadCategories() {
                $.getJSON('/Policy/GetPolicyCategories', function (data) {
                    var ddl = $('#ddlCategory');
                    ddl.empty().append('<option value="">-- Select Category --</option>');
                    $.each(data, function (i, item) {
                        ddl.append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });
                });
            }

            function clearForm() {
                $('#policyForm')[0].reset();
                $('#PolicyId').val('');
                $('#PolicyDocument').val('');
            }

            function savePolicy() {
                var form = $('#policyForm')[0];
                var formData = new FormData(form);
                var id = $('#PolicyId').val();
                var url = id ? '/Policy/UpdateLGPolicy' : '/Policy/SaveLGPolicy';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        alert("Policy Entered Successfully");
                        location.reload();
                    },
                    error: function (xhr, status, error) {
                        // Build a meaningful message
                        var errorMessage = "Error: " + xhr.status + " - " + xhr.statusText;
                        if (xhr.responseText) {
                            errorMessage += "\nDetails: " + xhr.responseText;
                        }
                        alert(errorMessage);
                    }
                });
            }


            function editPolicy(id) {
                clearForm();
                $.getJSON('/Policy/EditLGPolicy', { Id: id }, function (res) {
                    var data = JSON.parse(res);
                    var item = data.lgPolicies[0];
                    $('#PolicyId').val(item.PolicyId);
                    $('#PolicyDocumentPath').val(item.PolicyDocumentPath);
                    $('input[name="PolicyTitle"]').val(item.PolicyTitle);
                    $('input[name="PolicyTitle_Punjabi"]').val(item.PolicyTitle_Punjabi);
                    $('#ddlCategory').val(item.CategoryId);
                    $('input[name="StartDate"]').val(item.StartDate.split('T')[0]);
                    $('input[name="EndDate"]').val(item.EndDate.split('T')[0]);
                    $('#IsActive').prop('checked', item.IsActive);
                    $('#policyModal').modal('show');
                });
            }

            function deletePolicy(id) {
                if (confirm("Are you sure you want to delete this policy?")) {
                    $.post('/Policy/DeleteLGPolicy', { Id: id }, function (res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            alert("Delete failed");
                        }
                    });
                }
            }

        </script>

