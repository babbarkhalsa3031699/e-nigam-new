@model CMNirdesh.Models.LstReferencePriority
@using CMNirdesh;

@{
    ViewBag.Title = "Index";

}


@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

<div id="main-content">

<div class="main-content">


    <section class="form_dsign">
        <div class="container-fluid p-0">
            <div class="inr_frm_dsgn">

                <div class="widget-box " id="divAction">
                    <div class="widget-header widget-header-flat rounded-top rounded-0">
                        <h4 class=""> Reference Priority List </h4>
                        <div class="widget-toolbar no-border">
                            <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();">
                                <i class="ace-icon fa fa-pencil-square-o bigger-150"></i>
                                Add New Reference
                            </button>
                            
                        </div>
                    </div>
                </div>

                <div class="form_lyot">

                    @if (Model != null)
                    {
                        if (Model._LstReferencePriority.Count() > 0)
                        {
                            <div class="table-responsive">
                                <table id="example" class="table table-hover table-bordered ">
                                    <thead>
                                        <tr>
                                            <th style="text-align: center; width:30%;" ><span class="font-weight-bold">Reference Id</span></th>
                                            <th style="text-align: center; width:30%;" ><span class="font-weight-bold">Priority Type</span></th>
                                            <th style="text-align: center; width:30%;" ><span class="font-weight-bold">Description</span></th>
                                            <th style="text-align: center; width:10%;" ><span class="font-weight-bold"></span></th>
                                        </tr>
                                    </thead>
                                    <tbody role="alert" aria-live="polite" aria-relevant="all">
                                        @foreach (var items in Model._LstReferencePriority)
                                        {
                                            <tr>
                                                <td class="center border" style="font-size:13px; padding: 14px 4px !important" >@Html.DisplayFor(modelItem => items.Id)</td>
                                                <td class="center border" style="font-size:13px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.PriorityType)</td>
                                                @*<td>@Html.DisplayFor(modelItem => items.AppIcon)</td>*@

                                                <td class="center border" style="font-size:13px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Description)</td>

                                                <td class="center border edit-1" style="font-size:13px; padding: 14px 4px !important">
                                                    <div class="hidden-sm hidden-xs action-buttons">
                                                        <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.Id')">
                                                            <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                        </a>
                                                        @*<a data-rel="tooltip" class="red tooltip-error" onclick="DeleteActionRecord('@items.Id')">
                                                    <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                </a>*@
                                                    </div>
                                                    <div class="hidden-sm hidden-xs action-buttons">
                                                        <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.Id')" value="@items.Id" />
                                                        <label class="toggle mb-0">
                                                            <input type="checkbox" onclick="DeleteActionRecord('@items.Id')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                                                            <span class="slider"></span>
                                                            <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                        </label>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="alert alert-info">
                                        <strong>There are no record found</strong><br />
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
            
        </div>
    
        <div class="coman_modal dispatch_modal addnew_modal modal"  id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fs-5" id="myModalLabel">Add Reference Priority Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form>
                            <div class="form-group" id="ReferenceIDLabel">
                                <div class="profile-info-name fotm_lbl">
                                    Reference Id:
                                </div>
                                <input type="text" class="form-control" id="ReferenceId" placeholder="Reference Id" />
                            </div>
                            <div class="form-group">
                                <div class="profile-info-name fotm_lbl">
                                    Priority Type:
                                </div>
                                <input type="text" class="form-control" id="PriorityType" placeholder="Priority Type" />
                            </div>

                            <div class="form-group">
                                <div class="profile-info-name fotm_lbl">
                                    Description:
                                </div>
                                <input type="text" class="form-control" id="Description" placeholder="Description" />
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                        <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>


    </section>

</div>
</div>





<head>
<script src="~/Scripts/tinymce/tinymce.min.js"></script>
<script src="~/Scripts/jquery.ui.widget.js"></script>
<script src="~/Scripts/jquery.fileupload.js"></script>
<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
@*<link href="~/Content/style_ms.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />*@
<script src="~/Scripts/datatables/jquery.dataTables.min.js"></script>
    </head>

<style>

    .Tab_hdr {
        background-color: #4c67a1;
        padding: 1px;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
        color: #fff;
    }

    .inr_frm_dsgn {
        /*margin-top: 20px;*/
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }


    .form_lyot {
        padding: 10px;
    }

    .Tab_hdr h2 {
        font-size: 23px;
        font-weight: 500;
        margin-top: 5px;
        margin-bottom: 5px;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>


<script>
    $(document).ready(function () {
        $('#example').DataTable({
        });
    });

    function validate() {
        
        var isValid = true;




        if ($('#PriorityType').val().trim() === "") {
            $('#PriorityType').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#PriorityType').css('background-color', 'white');
        }

        if ($('#Description').val().trim() === "") {
            $('#Description').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#Description').css('background-color', 'white');
        }

        return isValid;
    }
    function clearTextBox() {
        
        $('#btnUpdate').hide();
        $('#ReferenceId').val("");

        $('#PriorityType').val("");
        $('#Description').val("");

        $("#myModalLabel").html("Add Reference Priority Details");
        $('#btnSave').show();
        $('#ReferenceIDLabel').hide();
        $('#PriorityType').css('background-color', 'white');
        $('#Description').css('background-color', 'white');
        
        $('#myModal').attr( 'data-bs-backdrop: static' );
    }
    function Add() {

        
        var res = validate();
        if (res == false) {
            return false;
        }

        var empObj = {

            PriorityType: $('#PriorityType').val(),
            Description: $('#Description').val()
        };
        $('#ReferenceIDLabel').hide();

        $.ajax({


            url: "/ReferencePriority/Create",
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",

            success: function (result) {

                alert("Updated Successfully");
                $('#myModal').modal('hide');
                location.reload();
            },
            error: function (errormessage) {
                alert("Not Updated");
                $('#myModal').modal('hide');
                location.reload();
            }
        });
    }
    function Update() {
        var res = validate();
        if (res == false) {
            return false;
        }
        var url = "/ReferencePriority/Update";
        
        var empObj = {
            Id: $('#ReferenceId').val(),

            PriorityType: $('#PriorityType').val(),
            Description: $('#Description').val()

        };

        $.ajax({
            url: url,
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                // loadData();

                $('#myModal').modal('hide');
                alert("Updated Successfully");
                location.reload();

            },
            error: function (errormessage) {

                $('#myModal').modal('hide');
                alert("Not Updated");
                location.reload();
            }
        });
    }
    var MyApp = {};

    function DeleteActionRecord(xyz) {

     
        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }

    function DeleteID() {
        
        var i = MyApp;

        $.ajax({
            type: "Post",
            url: "/ReferencePriority/Delete?id=" + i,
            success: function (result) {
                alert("Updated Successfully");
               }
        });
    }
    function getbyID(EmpID) {
        debugger
        clearTextBox();
        var url = "/ReferencePriority/Edit?id=" + EmpID;
        $("#myModalLabel").html("Update ReferencePriority Record");

        $("#btnUpdate").show();

        $('#ReferenceIDLabel').show();
        $("#ReferenceId").attr("disabled", "disabled");

        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {

                var obj = JSON.parse(data);
                var data = obj._LstReferencePriority[0];
                $('#myModal').modal();
                $("#ReferenceId").val(data.Id);
                $("#PriorityType").val(data.PriorityType);
                $("#Description").val(data.Description);
                $("#btnSave").hide();
            }
        });
    }
</script>
