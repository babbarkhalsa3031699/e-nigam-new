<style>


    .inr_frm_dsgn {
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }



    .form_lyot {
        padding: 10px;
    }

    .form-group input[type="number"].txt_design {
        border-radius: 4px !important;
        height: 41px !important;
        width: 100%;
        max-width: 100%;
    }

    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<script>

    $(document).ready(function () {
        var s = $("#ch_user1");
        s.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
        $.ajax({
            type: "POST",
            url: '@Url.Action("MenuDropDown", "MCSubMenu")',
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                s.empty().append('<option selected="selected" value="0">Please select</option>');
                $.each(response, function () {
                    s.append($("<option></option>").val(this['Value']).html(this['Text']));
                });
            },
            failure: function (response) {
                alert(response.responseText);
            },
            error: function (response) {
                alert(response.responseText);
            }
        });

    });
    $('#example').DataTable({
    });
    function getbyID(EmpID) {

        clearTextBox();

        var url = '@Url.Action("Edit", "MCSubMenu")' + '?id=' + EmpID;
        $("#myModalLabel").html("Update Sub-Menu Items");
        $("#SubMenuIcon2").empty();
        $("#btnUpdate").show();
        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {

                var obj = JSON.parse(data);

                var data = obj._LstSubMenu2[0];
                var src = data.icon;
                $("#SubMenuId").attr("disabled", "disabled");
                $('#myModal').modal();
                $("#SubMenuId").val(data.SubMenuId);
                $("#ch_user1").val(data.MenuId);
                $("#SubMenuName").val(data.SubMenuName);
                $("#ControllerName").val(data.ControllerName);
                $("#ActionName").val(data.ActionName);
                $("#Type").val(data.Type);
                $("#SrNo").val(data.SrNo);
                $("#btnSave").hide();


                $("#imgPreview").attr('src','/'+data.icon);
            }

        });

    }

    //Function for clearing the textboxes

    //Valdidation using jquery
    function validate() {

        var isValid = true;

        //if ($('#OfficeId').val().trim() === "") {
        //    $('#OfficeId').css('background-color', 'Red');


        //    isValid = false;
        //}
        //else {
        $('#OfficeIdLabel').hide();
        //}
        if ($('#ch_user1').val().trim() === "0") {
            $('#ch_user1').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#ch_user1').css('background-color', 'white');
        }
        if ($('#SubMenuName').val().trim() === "") {
            $('#SubMenuName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#SubMenuName').css('background-color', 'white');
        }
        if ($('#ControllerName').val().trim() === "") {
            $('#ControllerName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#ControllerName').css('background-color', 'white');
        }
        if ($('#ActionName').val().trim() === "") {
            $('#ActionName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#ActionName').css('background-color', 'white');
        }
        if ($('#Type').val().trim() === "") {
            $('#Type').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#Type').css('background-color', 'white');
        }
        if ($('#SrNo').val().trim() === "") {
            $('#SrNo').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#SrNo').css('background-color', 'white');
        }
        return isValid;
    }
    function clearTextBox() {
   debugger
        $('#SubMenuId').val("");
        $('#ch_user1').val("0");
        $("#SubMenuIdLabel").hide();
        $('#SubMenuName').val("");
        $('#ControllerName').val("");
        $('#ActionName').val("");
        $('#btnUpdate').hide();
        $("#SubMenuId").removeAttr("disabled", "disabled");
        $("#myModalLabel").html("Add SubMenu Items");
        $('#btnSave').show();
        $('#ch_user1').css('background-color', 'white');
        $('#SubMenuName').css('background-color', 'white');
        $('#ControllerName').css('background-color', 'white');
        $('#ActionName').css('background-color', 'white');
        $('#Type').css('background-color', 'white');
        $('#SrNo').css('background-color', 'white');
        $('#Type').val("0");
        $('#SrNo').val("0");
        $("#imgPreview").attr('src', 'https://placehold.jp/100x100.png');
    }
    function Add() {
        var res = validate();
        if (res == false) {
            return false;
        }

        if (window.FormData !== undefined) {

            var fileUpload = $("#SubMenuIcon").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }
                const courseDto = {
                MenuId: $('#ch_user1').val(),
                SubMenuName: $('#SubMenuName').val(),
                ControllerName: $('#ControllerName').val(),
                ActionName: $('#ActionName').val(),
                icon: $('#SubMenuIcon').val(),
                Type: $('#Type').val(),
                SrNo: $('#SrNo').val()
            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            $.ajax({
                url: '@Url.Action("Create", "MCSubMenu")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    {
                        if (result != 0) {
                            alert("Updated Successfully");
                            $('#myModal').hide();
                            location.reload();
                        }
                        else {
                            alert("Not Updated SrNo Already Existing");
                        }
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
    function Update() {
        var res = validate();
        if (res == false) {
            return false;
        }
        $("#SubMenuId").removeAttr("disabled", "disabled");

        if (window.FormData !== undefined) {

            var fileUpload = $("#SubMenuIcon").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }


            const courseDto = {
                SubMenuId: $('#SubMenuId').val(),
                SubMenuName: $('#SubMenuName').val(),
                ControllerName: $('#ControllerName').val(),
                ActionName: $('#ActionName').val(),
                MenuId: $('#ch_user1').val(),
                icon: $('#SubMenuIcon').val(),
                Type: $('#Type').val(),
                SrNo: $('#SrNo').val()

            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            $.ajax({
                url: '@Url.Action("Update", "MCSubMenu")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    {
                        debugger
                        if (result != 0) {
                            alert("Updated Successfully");
                            $('#myModal').hide();
                            location.reload();
                        }
                        else {
                            alert("Not Updated SrNo Already Existing");
                        }
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
    var MyApp = {};

    function GetMaxSerial(menu_id) {
        var url = '@Url.Action("Max", "SubMenu")' + '?Id=' + menu_id;

       // debugger
        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {

                var obj = JSON.parse(data);

                data = obj._LstSubMenu2[0];


                $("#SrNo").val(data.SrNo);

            }

        });

    }


    function DeleteDepartmentRecord(xyz) {


        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }

    function DeleteID() {
        debugger
        var i = MyApp;

        $.ajax({
            type: "Post",
            url: '@Url.Action("Delete", "MCSubMenu")' + '?id=' + i,
            success: function (result) {
                if (result == 1) {

                    alert("Updated Successfully");
                }
                else {
                    alert("Not Updated");
                }
            }
        });
    }

    document.getElementById('SubMenuIcon').onchange = function (e) {
        const [file] = SubMenuIcon.files;
        debugger
        if (file) {
            $("#imgPreview").attr('src', URL.createObjectURL(file));
        }


    };



</script>

