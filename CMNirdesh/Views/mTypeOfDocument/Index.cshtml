    //Function for clearing the textboxes

    //Valdidation using jquery
    function validate() {
        var isValid = true;
        if ($('#DocumentTypeName').val() == "") {
            $('#DocumentTypeName').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#DocumentTypeName').css('background-color', 'white');
        }
        if ($('#DocumentTypeNameLocal').val() == "") {
            $('#DocumentTypeNameLocal').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#DocumentTypeNameLocal').css('background-color', 'white');
        }
        if ($('#DocumentType').val() == "") {
            $('#DocumentType').css('background-color', '#ff56564d');
            isValid = false;
        }
        return isValid;
    }


    function clearTextBox() {
        $('#myModal').data({ backdrop: 'static', keyboard: false });
        $('#DocumentTypeId').val("");
        $('#DocumentTypeName').val("");
        $('#DocumentNameLocal').val("");
        $('#DocumentTypeName').css('background-color', 'white');
        $('#DocumentTypeNameLocal').css('background-color', 'white');
        $('#DocumentIcon').val("");
        $('#DocumentType').val("");

        $('#btnUpdate').hide();
        $("#DocumentTypeId").removeAttr("disabled", "disabled");
        $("#myModalLabel").html("Add Document Record");
        $("#DocumentTypeId1").hide();
        $('#btnSave').show();
        $("#imgPreview").attr('src', 'https://placehold.jp/100x100.png');


    }
    function Add() {

        var res = validate();
        if (res == false) {
            return false;
        }
        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#DocumentIcon").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }


            const courseDto = {
                DocumentTypeName: $('#DocumentTypeName').val(),
                DocumentTypeNameLocal: $('#DocumentTypeNameLocal').val(),
                DocumentType: $('#DocumentType').val(),
                DeptId: $('#DdlDepartment').val(),
                OfficeId: $('#DdlOffice').val(),

            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );



            // Adding one more key to FormData object


            $.ajax({
                 url: '@Url.Action("Create", "mTypeOfDocument")',
                //url: '/mTypeOfDocument/Create',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    if (result == 1) {
                        alert("Updated Successfully");
                        $('#myModal').hide();
                        location.reload();
                    }
                },
                error: function (err) {
                    if (err) {
                        alert("Not Updated");
                        $('#myModal').hide();
                        location.reload();
                    }
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }

    function Update() {
        var res = validate();
        if (res == false) {
            return false;
        }
        // $('#DocumentIconName').val() = $('#DocumentIcon').val();
        if (window.FormData !== undefined) {

            var fileUpload = $("#DocumentIcon").get(0);
            var files = fileUpload.files;

            // Create FormData object
            var fileData = new FormData();

            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append(files[i].name, files[i]);

            }


            const courseDto = {
                DocumentTypeId: $('#DocumentTypeId').val(),
                DocumentTypeName: $('#DocumentTypeName').val(),
                DocumentTypeNameLocal: $('#DocumentTypeNameLocal').val(),
                DocumentType: $('#DocumentType').val(),
                DeptId: $('#DdlDepartment').val(),
                OfficeId: $('#DdlOffice').val(),
            }
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );



            // Adding one more key to FormData object



            $.ajax({
                url: '@Url.Action("Update", "mTypeOfDocument")',
                //url: '/mTypeOfDocument/Update',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {

                    $('#myModal').hide();
                    alert("Updated Successfully");
                    location.reload();
                },
                error: function (err) {
                    $('#myModal').hide();
                    alert("Not Updated");
                    location.reload();
                }
            });
        } else {
            alert("FormData is not supported.");
        }
    }
    var MyApp = {};
    function DeleteDepartmentRecord(xyz) {



        MyApp = xyz;
        DeleteID();
    }
    function ConfirmDelete() {
        DeleteID();
    }
    function DeleteID() {


        var i = MyApp;


        $.ajax({
            type: "Post",
            url: "/mTypeOfDocument/Delete?id=" + i,
            success: function (result) {

                alert("Updated Successfully");


            }
        });
    }
    function showimage() {
        var s = $("#DocumentIcon").val();
        $(location).attr("~/" + s);
    }
    document.getElementById('DocumentIcon').onchange = function (e) {
        const [file] = DocumentIcon.files;

        if (file) {
            $("#imgPreview").attr('src', URL.createObjectURL(file));
        }


    };
    function GetDeptWiseOffice(deptid) {
        var id = $("#DdlDepartment").val();
        $('#DdlOffice').empty().append('<option value="0">-Select-</option>');


        $.ajax({
            type: "GET",
            url: '@Url.Action("GetOfficebyDepartmentId", "User")',
            datatype: "Json",
            data: { deptid: id },
            success: function (data) {
                $.each(data, function (index, value) {
                    $('#DdlOffice').append('<option value="' + value.id + '">' + value.name + '</option>');
                });
                if (deptid == 0) {
                    // Set the selected index of the dropdown list to 0
                    $('#DdlOffice').prop('selectedIndex', 0);
                }
                else {
                    $("#DdlOffice").val(deptid);
                }
            }
        });
    }
