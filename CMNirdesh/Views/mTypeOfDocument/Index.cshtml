    function getbyID(EmpID) {

        clearTextBox();
        var url = "/mTypeOfDocument/Edit?id=" + EmpID;

        $("#myModalLabel").html("Update Document Record");

        $("#btnUpdate").show();
        $("#btnSave").hide();


        $.ajax({
            type: "GET",
            url: '@Url.Action("Edit", "mTypeOfDocument")',
            data: { id: EmpID },
            //url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {

                var obj = JSON.parse(data);
                var data = obj._ListTypeOfDocumentModel[0];
                console.log(data);
                $('#myModal').modal();
                $("#DocumentTypeId").val(data.DocumentTypeId);
                $("#DocumentTypeId").attr("disabled", "disabled");
                $("#DocumentTypeName").val(data.DocumentTypeName);
                $("#DocumentTypeNameLocal").val(data.DocumentTypeNameLocal);
                $("#DocumentType").val(data.DocumentType);
                $("#DdlDepartment").val(data.DeptId);
                if (data.DeptId == 0) {
                    // Set the selected index of the dropdown list to 0
                    $('#DdlDepartment').prop('selectedIndex', 0);
                }
                GetDeptWiseOffice(data.OfficeId);
               // $("#DdlOffice").val(data.OfficeId);

