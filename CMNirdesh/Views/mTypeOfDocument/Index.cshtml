@{
    ViewBag.Title = "Index";
    var url = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"];
}


@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

<div id="main-content">

    <div class="main-content">

        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Reference List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" style="font-size:14px;" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i> Add New Reference</button>
                            </div>
                        </div>
                    </div>


                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model._ListTypeOfDocumentModel.Count() > 0)
                            {
                                <div class="table-responsive ">
                                    <table id="example" class="table table-hover table-bordered " style="font-size:20px;">
                                        <thead>
                                            <tr class="table-heading">
                                                <th class="td-heading" style="width:15%;"><span class="font-weight-bold">Reference Id</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">ReferenceType Name</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">ReferenceType Name Local</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Office</span></th>
                                                <th class="td-heading" style="width:25%;"><span class="font-weight-bold">Reference Icon</span></th>

                                                <th class="td-heading" style="width:10%;"><span class="font-weight-bold"></span></th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._ListTypeOfDocumentModel)
                                            {

                                                <tr>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.DocumentTypeId)</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.DocumentTypeName)</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.DocumentTypeNameLocal)</td>
                                                    <td class="text-center td-data" style="font-size:14px; padding: 14px 4px !important">@Html.DisplayFor(modelItem => items.Office)</td>
                                                    <td class="center td-data" style="font-size:14px; padding: 14px 4px !important">
                                                        @if (!string.IsNullOrWhiteSpace(items.AppIcon))
                                                        {
                                                            <img src="@Url.Content(@Model.fileacessingUrl + "/" + items.AppIcon)" height="25" width="25" />
                                                        }
                                                    </td>
                                                    <td class="center td-data edit-1" style="font-size:14px; padding: 14px 4px !important">
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <input type="hidden" id="imageurl" value="@Url.Content("~/" + items.AppIcon)" />

                                                            <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.DocumentTypeId')">

                                                                <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                            </a>
                                                            @*<a data-rel="tooltip" class="red tooltip-error" onclick="DeleteDepartmentRecord('@items.DocumentTypeId')">

                                                                    <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                                </a>*@
                                                        </div>
                                                        <div class="hidden-sm hidden-xs action-buttons">
                                                            <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.DocumentTypeId')" value="@items.DocumentTypeId" />
                                                            <label class="toggle mb-0">
                                                                <input type="checkbox" onclick="DeleteDepartmentRecord('@items.DocumentTypeId')" @(Convert.ToBoolean(items.IsDeleted) == false ? "checked='checked'" : string.Empty)>
                                                                <span class="slider"></span>
                                                                <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>

                </div>

            </div>

            <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title fs-5" id="myModalLabel">Add Document Type Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="fileUpload" enctype="multipart/form-data">
                                @if (CMNirdesh.Models.CurrentSession.RoleID == "18")
                                {
                                    <div class="form-group">
                                        <div class="profile-info-name fotm_lbl">Department:</div>
                                        @Html.DropDownListFor(m => m.DeptId, Model.mDepartmentList, "Select", new { @id = "DdlDepartment", @tabindex = "1", @class = "form-control txt_design", @required = "required", @Onchange = "GetDeptWiseOffice('0');" })
                                    </div>
                                    <div class="form-group">
                                        <div class="profile-info-name fotm_lbl">Office:</div>
                                        @Html.DropDownListFor(m => m.OfficeId, Model.OfficeList, "Select", new { @id = "DdlOffice", @tabindex = "2", @class = "form-control txt_design", @required = "required" })
                                    </div>
                                }
                                <div class="form-group" id="DocumentTypeId1">
                                    <div class="profile-info-name fotm_lbl">ReferenceType Id:</div>
                                    <input type="text" class="form-control" id="DocumentTypeId" placeholder="Document Type Id" />
                                </div>
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">
                                        Reference Type Name:
                                    </div>
                                    <input type="text" class="form-control" id="DocumentTypeName" placeholder="Document Type Name" />
                                </div>
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">ReferenceType Local Name:</div>
                                    <input type="text" class="form-control" id="DocumentTypeNameLocal" placeholder="Document Type Local Name" />

                                </div>
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">Document Type:</div>
                                    <select id="DocumentType" name="DocumentType">
                                        <option value="">Select</option>
                                        <option value="R">Reference</option>
                                        <option value="F">File</option>
                                    </select>

                                </div>
                                <div class="form-group">
                                    <div class="profile-info-name fotm_lbl">
                                        Reference Icon:
                                    </div>
                                    <input type="file" name="file" class="form-control" id="DocumentIcon" placeholder="Document Icon" accept=".jpg,.jpeg,.bmp,.png,.gif" />
                                    <img src="https://placehold.jp/100x100.png" id="imgPreview" class="form-control" style="width:100px; height:100px; border:1px solid red;" alt="Load Image" />
                                    <input type="hidden" id="DocumentIconName" />



                                </div>
                            </form>
                        </div>
                        <div class="modal-footer" style="background-color:white;">
                            <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                            <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                            <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>

        </section>

    </div>

</div>



