<script>



    $(window).on('load', function () {
        console.log("window loaded");
        LoginWithParichay();
    });


    function LoginWithParichay() {
      
            $.ajax({
            type: "GET",
              url: '@Url.Action("LoginButton", "ParichayLogin")',
                datatype: "Json",
                contentType: "application/json; charset=utf-8",
                data: { },
                success: function (response) {
                    if (response != null) {
                        window.location = response;
                    }
                    else {
                        alert("Login Failed..");
                    }
                },
                error: function (error) {
                }
              });
        }
</script>