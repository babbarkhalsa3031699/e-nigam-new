@model CMNirdesh.Models.UserMenu
@using CMNirdesh.Models

<div class="portal-sidebar-wrapper">
    <!-- Top Header Bar with Navigation Label and Collapse/Expand Toggle Button -->
    <div class="portal-sidebar-header">
        <div class="portal-sidebar-title-container">
            <span class="portal-sidebar-header-badge">
                <i class="fas fa-layer-group portal-sidebar-header-icon"></i>
            </span>
            <span class="portal-sidebar-header-title">Navigation</span>
        </div>
        <button type="button"
                class="portal-sidebar-toggle-button"
                id="portalSidebarToggleBtn"
                onclick="toggleSidebarNav();"
                title="Collapse / Expand Menu">
            <i class="fas fa-bars portal-sidebar-toggle-icon" id="portalSidebarToggleIcon"></i>
        </button>
    </div>

    <!-- Legacy Compatibility Anchors -->
    <a class="closebtn" id="closebtn" onclick="closeNav()" style="display:none !important;"><i class="fas fa-bars"></i></a>
    <a class="" id="openbtn" onclick="openNav()" style="display:none !important;"><i class="fas fa-bars"></i></a>

    <!-- Scrollable Navigation Menu List -->
    <div class="portal-sidebar-scrollable">
        <ul class="list-unstyled portal-sidebar-nav-list mb-0">
            @if (Model != null && Model.MenuList != null)
            {
                foreach (CMNirdesh.Models.MenuModel menu in Model.MenuList)
                {
                    var menuKey = "portal_sub_" + menu.MenuId + "_" + (menu.MenuName ?? "").Replace(" ", "").Replace("/", "").Replace("-", "");
                    var hasSubmenu = menu._LstSubmenu != null && menu._LstSubmenu.Count > 0;

                    <li class="portal-sidebar-nav-item"
                        id="@menu.MenuId"
                        label="@menu.MenuName"
                        data-bs-toggle="tooltip"
                        data-bs-placement="right"
                        title="@menu.MenuName">

                        <a class="portal-sidebar-nav-link align-items-center"
                           data-bs-toggle="collapse"
                           data-bs-target="#@menuKey"
                           aria-expanded="false"
                           aria-controls="@menuKey"
                           onclick="onSidebarMenuClick(this);">

                            <span class="portal-sidebar-icon-box">
                                <img class="portal-sidebar-menu-icon" src="@Url.Content("~/" + menu.icon)" alt="@menu.MenuName" />
                                @if (menu.MenuCount > 0)
                                {
                                    <span class="portal-sidebar-mini-dot"></span>
                                }
                            </span>

                            <span class="portal-sidebar-item-label">@menu.MenuName</span>

                            @if (menu.MenuCount > 0)
                            {
                                <span class="portal-sidebar-item-badge">@menu.MenuCount</span>
                            }

                            @if (hasSubmenu)
                            {
                                <i class="fas fa-chevron-right portal-sidebar-arrow-chevron"></i>
                            }
                        </a>

                        @if (hasSubmenu)
                        {
                            <div class="collapse portal-sidebar-submenu-collapse" id="@menuKey">
                                <ul class="list-unstyled portal-sidebar-submenu-list" id="menu_@menuKey">
                                    @foreach (CMNirdesh.Models.SubMenuModel submenu in menu._LstSubmenu)
                                    {
                                        <li class="portal-sidebar-submenu-item" value='@submenu.SubMenuId'>
                                            <a class="portal-sidebar-submenu-link" href="@Url.Action(submenu.ActionName, submenu.ControllerName, new { type = submenu.Type })">
                                                <span class="portal-sidebar-submenu-bullet"></span>
                                                <span class="portal-sidebar-submenu-label">@submenu.SubMenuName</span>
                                                @if (submenu.Count > 0)
                                                {
                                                    <span class="portal-sidebar-submenu-badge">@submenu.Count</span>
                                                }
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </li>
                }
            }
        </ul>
    </div>
</div>

<script>
    function onSidebarMenuClick(el) {
        var isCollapsed = document.body.classList.contains('portal-sidebar-is-collapsed') ||
            (document.getElementById('mySidebar') && document.getElementById('mySidebar').classList.contains('portal-sidebar-collapsed'));

        if (isCollapsed) {
            if (typeof setSidebarState === 'function') {
                setSidebarState(true);
            }
        }
    }

    $(document).ready(function () {
        if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
            var tooltipElements = document.querySelectorAll('.portal-sidebar-nav-item[data-bs-toggle="tooltip"]');
            tooltipElements.forEach(function (el) {
                new bootstrap.Tooltip(el, {
                    boundary: document.body,
                    fallbackPlacements: ['right', 'top']
                });
            });
        }
    });
</script>
