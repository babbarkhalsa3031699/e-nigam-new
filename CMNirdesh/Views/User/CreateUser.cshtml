        function Update() {

        if (window.FormData !== undefined) {

            var fileUpload = $("#profilephoto").get(0);
            var fileUpload1 = $("#signaturephoto").get(0);
            var files = fileUpload.files;
            var files2 = fileUpload1.files;
            // Create FormData object
            var fileData = new FormData();
            // Looping over all files and add it to FormData object
            for (var i = 0; i < files.length; i++) {
                fileData.append("file", files[i]);
            }
            for (var j = 0; j < files2.length; j++) {
                fileData.append("file2", files2[j]);
            }
            const courseDto = {
                //  MCName: $("#MCNameDropDown option:selected").text(),
                //  MCName_local: $("#MCLocalNameDropDown option:selected").text(),
                username: $('#username').val(),
                //password: $('#password').val(),
                email: $('#email').val(),
                MobileNo: $('#mobile').val(),
                PhotoFileName: $('#profilephoto').val().split('\\').pop().split('/').pop(),
                designation: $('#designation').val(),
                DeptId: $('#department').val(),
                name: $('#name').val(),
                SignFileName: $('#signaturephoto').val().split('\\').pop().split('/').pop(),
                OfficeId: $('#office').val(),
                RoleId: $('#Role').val(),
                UserId: $('#UserId').val(),
                Apex: $("#IsApex").prop("checked"),
            };
            Object.entries(courseDto).map(([key, value]) =>
                fileData.append(key, value)
            );
            debugger
            // Adding one more key to FormData object
            $.ajax({
                url: '@Url.Action("UpdateUser", "User")',
                type: "POST",
                contentType: false, // Not to set any content header
                processData: false, // Not to process data
                data: fileData,
                success: function (result) {
                    if (result == 1) {
                        alert("Updated Successfully");
                        $('#myModal').hide();
                        location.reload();
                    }
                    else {


                        var errorMessage = "Something Went Wrong";
                        // Handle the error message here
                        alert(errorMessage);
                        $('#myModal').hide();
                        location.reload();


                    }
                },

            });
        } else {
            alert("FormData is not supported.");
        }
    }
        function validateForm() {
            // Get the form inputs
            var department = document.getElementById('department');
            var office = document.getElementById('office');
            var role = document.getElementById('Role');
            var name = document.getElementById('name');
            var designation = document.getElementById('designation');
            var mobile = document.getElementById('mobile');
            var email = document.getElementById('email');
            var username = document.getElementById('username');
            //var password = document.getElementById('password');

            // Check if any of the inputs are empty
            if (department.value === '' || office.value === '' || role.value==='' || name.value === '' || designation.value === '' ||
                mobile.value === '' || email.value === '' || username.value === '') {
                alert('Please fill in all the fields.');
                return;

            }
            else {
                Update();
            }
        }

