<!-- Floating Real-Time Feedback Toast -->
<div id="rbacToast">
    <i class="fas fa-check-circle" style="color: #4ade80;"></i>
    <span>Permission updated successfully</span>
</div>

<script src="~/Scripts/MultiSelectBox/multi-select.min.js"></script>

<script>
    // Live Toast Feedback Helper
    function showRbacToast(msg, isSuccess) {
        var toast = $('#rbacToast');
        var icon = isSuccess !== false ? '<i class="fas fa-check-circle" style="color: #4ade80;"></i>' : '<i class="fas fa-exclamation-circle" style="color: #f87171;"></i>';
        toast.html(icon + '<span>' + (msg || 'Permission updated successfully') + '</span>');
        toast.addClass('show');
        clearTimeout(window.rbacToastTimer);
        window.rbacToastTimer = setTimeout(function () {
            toast.removeClass('show');
        }, 2200);
    }

    $(document).ready(function () {
        $('#ddlmenu').multipleSelect({
            columns: 1,
            selectAll: false,
            animate: 'slide',
            maxHeight: 320,
            width: '100%',
            placeholder: 'Search & select menus...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var menuid = view.value;
                var menuname = view.text;
                var checked = view.selected;
                addremovemenu(usertypeid, menuid, checked, menuname);
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var menuid = view.children[i].value;
                    var menuname = view.children[i].text;
                    var checked = view.children[i].selected;
                    addremovemenu(usertypeid, menuid, checked, menuname);
                });
            }
        });

        $('#ddlstatusdiary').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select actions...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var Actionid = view.value;
                var checked = view.selected;
                var menuname = view.text;
                addremoveAction(usertypeid, Actionid, menuname, checked, "Diary");
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var Actionid = view.children[i].value;
                    var checked = view.children[i].selected;
                    var menuname = view.children[i].text;
                    addremoveAction(usertypeid, Actionid, menuname, checked, "Diary");
                });
            }
        });

        $('#ddladdupdatestatusDiary').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select controls...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var Actionid = view.value;
                var checked = view.selected;
                addremoveStatusButton(usertypeid, Actionid, checked, "Diary");
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var Actionid = view.children[i].value;
                    var checked = view.children[i].selected;
                    addremoveStatusButton(usertypeid, Actionid, checked, "Diary");
                });
            }
        });

        $('#ddladdupdatestatusDispatch').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select controls...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var Actionid = view.value;
                var checked = view.selected;
                addremoveStatusButton(usertypeid, Actionid, checked, "Dispatch");
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var Buttonid = view.children[i].value;
                    var checked = view.children[i].selected;
                    addremoveStatusButton(usertypeid, Buttonid, checked, "Dispatch");
                });
            }
        });

        $('#ddlstatusdispatch').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select actions...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var Actionid = view.value;
                var checked = view.selected;
                var menuname = view.text;
                addremoveAction(usertypeid, Actionid, menuname, checked, "Dispatch");
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var Actionid = view.children[i].value;
                    var checked = view.children[i].selected;
                    var menuname = view.children[i].text;
                    addremoveAction(usertypeid, Actionid, menuname, checked, "Dispatch");
                });
            }
        });

        $('#ddladdupdate').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select controls...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var userid = $('#ddluser').val();
                var Buttonid = view.value;
                var checked = view.selected;
                addremoveButton(userid, Buttonid, checked);
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var userid = $('#ddluser').val();
                    var Buttonid = view.children[i].value;
                    var checked = view.children[i].selected;
                    addremoveButton(userid, Buttonid, checked);
                });
            }
        });

        $('#ddlref').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select references...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var docid = view.value;
                var checked = view.selected;
                addremoveDoc(usertypeid, docid, checked, "Diary");
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var docid = view.children[i].value;
                    var checked = view.children[i].selected;
                    addremoveDoc(usertypeid, docid, checked, "Diary");
                });
            }
        });

        $('#ddlrefdispatch').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select references...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var docid = view.value;
                var checked = view.selected;
                addremoveDoc(usertypeid, docid, checked, "Dispatch");
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var docid = view.children[i].value;
                    var checked = view.children[i].selected;
                    addremoveDoc(usertypeid, docid, checked, "Dispatch");
                });
            }
        });

        $('#ddlProjectAction').multipleSelect({
            columns: 1,
            selectAll: false,
            maxHeight: 320,
            animate: 'slide',
            width: '100%',
            placeholder: 'Search & select actions...',
            filter: true,
            isOpen: true,
            keepOpen: true,
            multiple: false,
            onClick: function (view) {
                var usertypeid = $('#ddluser').val();
                var Actionid = view.value;
                var checked = view.selected;
                var menuname = view.text;
                addremoveAction(usertypeid, Actionid, menuname, checked, "Project");
            },
            onOptgroupClick: function (view) {
                $.each(view.children, function (i, item) {
                    var usertypeid = $('#ddluser').val();
                    var Buttonid = view.children[i].value;
                    var checked = view.children[i].selected;
                    addremoveAction(usertypeid, Buttonid, menuname, checked, "Project");
                });
            }
        });

        var menulist = "@(Model != null ? Model.menuids : "")";
        var diaryactionlist = '@(Model != null ? Model.Diaryactionids : "")';
        var dispatchactionlist = '@(Model != null ? Model.Dispatchactionids : "")';
        var Diaryaddupdateidslist = '@(Model != null ? Model.Diaryaddupdateids : "")';
        var Dispatchaddupdateidslist = '@(Model != null ? Model.Dispatchaddupdateids : "")';
        var reflist = '@(Model != null ? Model.refids : "")';
        var DisReflist = '@(Model != null ? Model.DispatchRefids : "")';
        var projectbuttonlist = '@(Model != null ? Model.Projectaddupdateids : "")';

        var mlarr = new Array();
        var alarr = new Array();
        var disactarr = new Array();
        var aladdupdtarr = new Array();
        var disaddupdtactarr = new Array();
        var dlarr = new Array();
        var disdocarr = new Array();
        var projectblarr = new Array();

        var ml = menulist.toString().split(",");
        for (var i = 0; i < ml.length; i++) {
            if (ml[i]) mlarr.push(ml[i]);
        }
        var al = diaryactionlist.toString().split(",");
        for (var i = 0; i < al.length; i++) {
            if (al[i]) alarr.push(al[i]);
        }
        var disal = dispatchactionlist.toString().split(",");
        for (var i = 0; i < disal.length; i++) {
            if (disal[i]) disactarr.push(disal[i]);
        }
        var diaryaddupdtal = Diaryaddupdateidslist.toString().split(",");
        for (var i = 0; i < diaryaddupdtal.length; i++) {
            if (diaryaddupdtal[i]) aladdupdtarr.push(diaryaddupdtal[i]);
        }
        var disaddupdtal = Dispatchaddupdateidslist.toString().split(",");
        for (var i = 0; i < disaddupdtal.length; i++) {
            if (disaddupdtal[i]) disaddupdtactarr.push(disaddupdtal[i]);
        }
        var dl = reflist.toString().split(",");
        for (var i = 0; i < dl.length; i++) {
            if (dl[i]) dlarr.push(dl[i]);
        }
        var disdl = DisReflist.toString().split(",");
        for (var i = 0; i < disdl.length; i++) {
            if (disdl[i]) disdocarr.push(disdl[i]);
        }
        var projectbl = projectbuttonlist.toString().split(",");
        for (var i = 0; i < projectbl.length; i++) {
            if (projectbl[i]) projectblarr.push(projectbl[i]);
        }

        $('#ddlmenu').multipleSelect('setSelects', mlarr);
        $('#ddlstatusdiary').multipleSelect('setSelects', alarr);
        $('#ddlstatusdispatch').multipleSelect('setSelects', disactarr);
        $('#ddladdupdate').multipleSelect('setSelects', mlarr);
        $('#ddladdupdatestatusDiary').multipleSelect('setSelects', aladdupdtarr);
        $('#ddladdupdatestatusDispatch').multipleSelect('setSelects', disaddupdtactarr);
        $('#ddlref').multipleSelect('setSelects', dlarr);
        $('#ddlrefdispatch').multipleSelect('setSelects', disdocarr);
        $('#ddlProjectAction').multipleSelect('setSelects', projectblarr);
    });

    function addremovemenu(usertypeid, menuid, checked, menuname) {
        var pathurl = '';
        if (checked == 1) {
            pathurl = '@Url.Action("AddUserTypeMenu", "User")';
            var opt = '<optgroup id=grp_' + menuname.replace(" ", "") + ' label="' + menuname + '"><option id=sub_' + menuid + ' value="' + menuid + '">' + menuname + '</option></optgroup>';
            $('#ddladdupdate').append(opt).multipleSelect('refresh');
        } else {
            pathurl = '@Url.Action("RemoveUserTypeMenu", "User")';
            $("#ddladdupdate #sub_" + menuid).remove();
            $('#ddladdupdate').multipleSelect('refresh');
        }

        $.ajax({
            url: pathurl,
            type: 'GET',
            data: { UserTypeId: usertypeid, MenuId: menuid },
            success: function (result) {
                showRbacToast('Menu permission updated', true);
            },
            error: function () {
                showRbacToast('Failed to update permission', false);
            }
        });
        $("#ddladdupdate #grp_" + menuname.replace(" ", "").replace(".", "")).remove();
    }

    function addremoveAction(usertypeid, Actionid, menuname, checked, type) {
        var pathurl = '';
        if (checked == 1) {
            var opt = '<option id=sub_' + Actionid + ' value="' + Actionid + '">' + menuname + '</option>';
            $('#ddladdupdatestatus' + type).append(opt).multipleSelect('refresh');
            pathurl = '@Url.Action("AddUserTypeAction", "User")';
        } else {
            var ddlid = "#ddladdupdatestatus" + type + " option[value = '" + Actionid + "']";
            $(ddlid).remove();
            $('#ddladdupdatestatus' + type).multipleSelect('refresh');
            pathurl = '@Url.Action("RemoveUserTypeAction", "User")';
        }

        $.ajax({
            url: pathurl,
            type: 'GET',
            data: { UserTypeId: usertypeid, ActionId: Actionid, type: type },
            success: function (result) {
                showRbacToast('Action status updated', true);
            },
            error: function () {
                showRbacToast('Failed to update action', false);
            }
        });
    }

    function addremoveButton(userid, Buttonid, checked) {
        var pathurl = '';
        if (checked == 1) {
            pathurl = '@Url.Action("AddButton", "User")';
        } else {
            pathurl = '@Url.Action("RemoveButton", "User")';
        }

        $.ajax({
            url: pathurl,
            type: 'GET',
            data: { UserId: userid, ButtonId: Buttonid },
            success: function (result) {
                showRbacToast('Button permission updated', true);
            },
            error: function () {
                showRbacToast('Failed to update button', false);
            }
        });
    }

    function addremoveStatusButton(usertypeid, Actionid, checked, type) {
        var pathurl = '';
        if (checked == 1) {
            pathurl = '@Url.Action("AddUserTypeAddUpdateAction", "User")';
        } else {
            pathurl = '@Url.Action("RemoveUserTypeAddUpdateAction", "User")';
        }

        $.ajax({
            url: pathurl,
            type: 'GET',
            data: { UserTypeId: usertypeid, ActionId: Actionid, type: type },
            success: function (result) {
                showRbacToast('Add/Update control updated', true);
            },
            error: function () {
                showRbacToast('Failed to update control', false);
            }
        });
    }

    function addremoveDoc(UserTypeId, docid, checked, type) {
        var pathurl = '';
        if (checked == 1) {
            pathurl = '@Url.Action("AddUserTypeRefAction", "User")';
        } else {
            pathurl = '@Url.Action("RemoveUserTypeRefAction", "User")';
        }

        $.ajax({
            url: pathurl,
            type: 'GET',
            data: { UserTypeId: UserTypeId, DocTypeId: docid, type: type },
            success: function (result) {
                showRbacToast('Reference type updated', true);
            },
            error: function () {
                showRbacToast('Failed to update reference type', false);
            }
        });
    }

    function Getdata() {
        var usertypeid = $("#ddluser").val();
        if (usertypeid != "" && usertypeid != "0") {
            $('#btngetuser').click();
        } else {
            $('.permission-matrix').hide();
        }
    }
</script>



