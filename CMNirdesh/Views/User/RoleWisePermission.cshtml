@model  CMNirdesh.Models.PermissionModel

@{
    var FileSettings = CMNirdesh.Models.FileSetting.GetSecureFileSettingLocation();
    string path = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"] + "/MlaDiary/TempFile/";
}


<link href="~/Content/style_ms.css" rel="stylesheet" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<style>
</style>

<body>
    <div id="main-content">


        <div class="main-content cm_fund fund_rcipt">
            <div class="row">

                <div class="card p-0">
                    <div class="card-header">
                        <h3 class="card-title">User Permission</h3>
                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("GetRoleWisePermissionList", "User", FormMethod.Post, new { @id = "formActionUser", enctype = "multipart/form-data" }))
                        {
                            <div class="row align-items-center">
                                <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12 p-3">
                                    <label for="inputEmail4" class="txt_label">User Role:</label>
                                    @Html.DropDownListFor(m => m.UserTypeId, Model.UserList, "Select", new { @id = "ddluser", @tabindex = "1", @class = "txt_design", @required = "required", @Onchange = "Getdata();" })

                                </div>
                                <input id="btngetuser" type="submit" value="Get User" class="btn add_btn" style="display:none" />
                            </div>
                        }

                        @if (Model.IsOpen)
                        {
                            <div class="permission">
                                <div class="row p-3">
                                    <h5>Menu Permissions</h5>
                                    <hr class="dropdown-divider" />
                                    <div class="form-group col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">Menu :</label>
                                        <select id='ddlmenu' multiple='multiple'>
                                            @foreach (CMNirdesh.Models.MenuModel menu in Model.MenuList)
                                            {
                                                <optgroup id="@menu.MenuId" label="@menu.MenuName">
                                                    @foreach (CMNirdesh.Models.SubMenuModel submenu in menu._LstSubmenu)
                                                    {
                                                        <option value='@submenu.SubMenuId'>@submenu.SubMenuName</option>
                                                    }
                                                </optgroup>
                                            }

                                        </select>

                                    </div>

                                    <div class="form-group col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">Add/Update Option on Menu Items:</label>
                                        @*@Html.DropDownListFor(m => m.addupdate, Model.addupdateList, new { @id = "ddladdupdate", @tabindex = "1", @class = "", @required = "required", @multiple = "multiple" })*@
                                        <select id='ddladdupdate' multiple='multiple'>

                                            @foreach (CMNirdesh.Models.MenuModel menu in Model.addupdateList)
                                            {
                                                <optgroup id="grp_@menu.MenuName.Replace(" "," ")" label="@menu.MenuName">
                                                    @foreach (CMNirdesh.Models.SubMenuModel submenu in menu._LstSubmenu)
                                                    {
                                                        <option id="sub_@submenu.SubMenuId" value='@submenu.SubMenuId'>@submenu.SubMenuName</option>
                                                    }
                                                </optgroup>
                                            }
                                        </select>
                                    </div>
                                </div>


                                <div class="row p-3" id="diarydiv">
                                    <h5>LG/UDD Permissions</h5>
                                    <hr class="dropdown-divider" />
                                    <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">References Type:</label>
                                        <select id='ddlref' multiple='multiple'>

                                            <optgroup id="1" label="References">
                                                @foreach (SelectListItem submenu in Model.References)
                                                {
                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                            <optgroup id="2" label="File">
                                                @foreach (SelectListItem submenu in Model.FundReferences)
                                                {
                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                        </select>

                                    </div>

                                    <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">Action Status:</label>
                                        <select id='ddlstatusdiary' multiple='multiple'>

                                            <optgroup id="1" label="References">
                                                @foreach (SelectListItem submenu in Model.Actions)
                                                {

                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                            <optgroup id="2" label="File">
                                                @foreach (SelectListItem submenu in Model.ActionFiles)
                                                {
                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                        </select>
                                        @*@Html.DropDownListFor(m => m.ActionId, Model.Actions, new { @id = "ddlstatusdiary", @tabindex = "1", @class = "", @required = "required", @multiple = "multiple" })*@


                                    </div>

                                    <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">Add/Update (User Wise):</label>
                                        @Html.DropDownListFor(m => m.ActionId, Model.DiaryButton, new { @id = "ddladdupdatestatusDiary", @tabindex = "1", @class = "", @required = "required", @multiple = "multiple" })

                                    </div>

                                </div>

                                <div class="row p-3" id="dispatch">
                                    <h5>MC Permissions</h5>
                                    <hr class="dropdown-divider" />
                                    <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">References Type:</label>

                                        <select id='ddlrefdispatch' multiple='multiple'>


                                            <optgroup id="1" label="References">
                                                @foreach (SelectListItem submenu in Model.References)
                                                {
                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                            <optgroup id="2" label="File">
                                                @foreach (SelectListItem submenu in Model.FundReferences)
                                                {
                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                        </select>

                                    </div>

                                    <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">Action Status:</label>

                                        <select id='ddlstatusdispatch' multiple='multiple'>

                                            <optgroup id="1" label="References">
                                                @foreach (SelectListItem submenu in Model.ActionsDispatch)
                                                {

                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                            <optgroup id="2" label="File">
                                                @foreach (SelectListItem submenu in Model.ActionsFileDispatch)
                                                {
                                                    <option value='@submenu.Value'>@submenu.Text</option>
                                                }
                                            </optgroup>

                                        </select>

                                        @*@Html.DropDownListFor(m => m.ActionId, Model.ActionsDispatch, new { @id = "ddlstatusdispatch", @tabindex = "1", @class = "", @required = "required", @multiple = "multiple" })*@

                                    </div>





                                    <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">Add/Update (User Wise):</label>
                                      
                                        @Html.DropDownListFor(m => m.ActionId, Model.DispatchButton, new { @id = "ddladdupdatestatusDispatch", @tabindex = "1", @class = "", @required = "required", @multiple = "multiple" })

                                    </div>
                                </div>


                                <div class="row p-3" id="dispatch">
                                    <h5>Project Permissions</h5>
                                    <hr class="dropdown-divider" />

                                    <div class="form-group col-xl-3 col-lg-4 col-md-6 col-sm-12 col-12 p-3">
                                        <label for="inputEmail4" class="txt_label">Action Status:</label>
                                        @Html.DropDownListFor(m => m.ActionId, Model.ProjectActions, new { @id = "ddlProjectAction", @tabindex = "1", @class = "", @required = "required", @multiple = "multiple" })

                                    </div>
                                </div>
                            </div>
                        }



                    </div>


                </div>


            </div>


        </div>
    </div>
</body>

