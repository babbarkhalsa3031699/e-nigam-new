        function CheckImage(input, name, hdnfileloc, hdnfilename,photoid) {


            //let img = new Image()
            //img.src = window.URL.createObjectURL($(input)[0].files[0])
            //img.onload = () => {
            //    alert(img.width + " " + img.height);
            //}

            var sizeInKB = $(input)[0].files[0].size / 1024;
            var filename = $(input)[0].files[0].name;
            var dots = $(input).val().split(".").length - 1;
            var sizeLimit = 2048;


            if ($(input).val().length > 0 && !(/\.(jpg|jpeg|bmp|png|gif)$/i).test($(input).val())) {
                toastr.error('You must select file in format of jpg,jpeg,bmp,png,gif .');
                $('#Photo').val('');
                $('#Photo').focus();
            }

            else if (dots > 1) {
                toastr.error('Invalid file Format.');
                $(input).val('');
                $(input).focus();
                $(input + "hdn").val('');
                $(input).val('');
            }


            else {
                var inpt = "input[name=" + name + "]";

                var inputElement1 = $(inpt);

                readImage(inputElement1).done(function (base64Data) {

                    $(input + "hdn").val(base64Data);
                    $(hdnfileloc).val(base64Data);
                    $(hdnfilename).val(filename);
                    $(photoid).attr("src", base64Data);
                    $(photoid).show();
                });
            }

        }
        function readImage(inputElement) {
            var deferred = $.Deferred();
            var files = inputElement.get(0).files;
            if (files && files[0]) {
                var fr = new FileReader();
                fr.onload = function (e) {
                    deferred.resolve(e.target.result);
                };
                fr.readAsDataURL(files[0]);
            } else {
                deferred.resolve(undefined);
            }
            return deferred.promise();
        }


