<head>
    <meta name="viewport" content="width=device-width" />
    <title>Change User Password</title>
    @* @Scripts.Render("~/bundles/LoginJs")*@

    <link href="~/Content/style_ms.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/responsive_ms.css" rel="stylesheet" />
    <link href="~/Content/font-awesome_ms.min.css" rel="stylesheet" />


    <script src="~/Scripts/jquery-3.6.4.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/CryptoJSv3.1.2/rollups/pbkdf2.js"></script>
    <script src="~/Scripts/CryptoJSv3.1.2/components/enc-base64.js"></script>
    <script src="~/Scripts/CryptoJSv3.1.2/components/enc-base64-min.js"></script>
    <script src="~/Scripts/crypto-js.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script>
        $('#CaptchaText').keydown(function (e) {
            if (e.keyCode == 13 || e.which == 13) {

                SubmitForm();

            }
        });

        $(document).ready(function () {
            $("#saveUserNamehidden").val("False");

        });


        function generateRandomSalt() {
            var salt = '';
            var array = new Uint8Array(32);
            window.crypto.getRandomValues(array);

            for (var i = 0; i < array.length; i++) {
                salt += (array[i] < 16 ? '0' : '') + array[i].toString(16);
            }

            return salt;
        }

        function generateSHA256Hash(data) {
            return CryptoJS.SHA256(data).toString(CryptoJS.enc.Hex);
        }


        function checkPasswordFormat(password) {
            var regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
            return regex.test(password);
        }

        function SubmitForm() {
            var oldpassword = $("#ActualPassword").val();
            var password = $("#Password").val();
            var confirmpassword = $("#confirmpassword").val();
            var Captcha = $("#CaptchaText");
            var pswlen = password.length;
            var isValid = true;
            if (oldpassword == "") {
                $('#OldPasswordValidation').html('Old Password required');
                $('#ActualPassword').val('');
                $('#Password').val('');
                $('#confirmpassword').val('');
                $('input[type="password"]').val('');
                isValid = false;
            }

            else if (password == "") {
                $('#PasswordValidation').html('New Password required');
                $('#ActualPassword').val("");
                $('#Password').val("");
                $('#confirmpassword').val("");
                $('input[type="password"]').val('');
                isValid = false;
            }

            else if (password == oldpassword) {
                $('#PasswordValidation').html('New Password can not be Old Password, Please try password');
                $('#ActualPassword').val("");
                $('#Password').val("");
                $('#confirmpassword').val("");
                $('input[type="password"]').val('');
                isValid = false;
            }

            else if (confirmpassword == "") {
                $('#confirmpasswordValidation').html('Confirm Password required');
                $('#ActualPassword').val("");
                $('#Password').val("");
                $('#confirmpassword').val("");
                $('input[type="password"]').val('');
                isValid = false;
            }

            else if (Captcha.value == "") {
                $('#CaptchaValidation').html('Captcha required')
                $('#ActualPassword').val("");
                $('#Password').val("");
                $('#confirmpassword').val("");
                $('input[type="password"]').val('');
                isValid = false;
            }

            else if (pswlen < 8) {
                alert('Password length should be minmum 8 characters')
                $('#ActualPassword').val('');
                $('#Password').val('');
                $('#confirmpassword').val('');
                $('input[type="password"]').val('');
                isValid = false;
            }

            else if (password != confirmpassword) {
                alert('Password and confirm password doesnot match');
                $('#ActualPassword').val("");
                $('#Password').val("");
                $('#confirmpassword').val("");
                $('input[type="password"]').val('');
                isValid = false;

            }
            else if (checkPasswordFormat(password) == false) {
                alert('Password format is invalid.At least one digit. At least one lowercase letter. At least one uppercase letter. At least one special character, The total length of the password must be at least 8 characters.');
                $('#ActualPassword').val("");
                $('#Password').val("");
                $('#confirmpassword').val("");
                $('input[type="password"]').val('');
                isValid = false;
            }
            else if (isPasswordValid(password) == false) {
                alert('Password format is invalid.At least one digit. At least one lowercase letter. At least one uppercase letter. At least one special character, The total length of the password must be at least 8 characters.');
                $('#ActualPassword').val("");
                $('#Password').val("");
                $('#confirmpassword').val("");
                $('input[type="password"]').val('');
                isValid = false;
            }
            else {
                isValid = true;
            }
            if (isValid) {

                ConfirmFunction();
                $('#LoginForm').submit();
                return true;
            }
            else {
                //event.preventDefault();
                return false;
            }
        }


        //function SubmitForm() {
        //    document.getElementById('LoginForm').submit();
        //}


        function isPasswordValid(password) {
            // Check length
            if (password.length < 8) {
                return false;
            }

            // Check for at least one digit
            if (!/\d/.test(password)) {
                return false;
            }

            // Check for at least one lowercase letter
            if (!/[a-z]/.test(password)) {
                return false;
            }

            // Check for at least one uppercase letter
            if (!/[A-Z]/.test(password)) {
                return false;
            }

            // Check for at least one special character
            var specialCharacters = /[`!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?~]/;
            if (!specialCharacters.test(password)) {
                return false;
            }

            return true;
        }




        function ConfirmFunction() {


            var hashedPassword = $("#ActualPassword").val();
            var randomSalt = generateRandomSalt();
            document.getElementById("ActualPassword").value = generateSHA256Hash(hashedPassword) + generateSHA256Hash(randomSalt);


            var hashedPassword1 = $("#Password").val();
            var randomSalt1 = generateRandomSalt();
            document.getElementById("Password").value = generateSHA256Hash(hashedPassword1) + generateSHA256Hash(randomSalt1);


            var hashedPassword2 = $("#confirmpassword").val();
            var randomSalt2 = generateRandomSalt();
            document.getElementById("confirmpassword").value = generateSHA256Hash(hashedPassword2) + generateSHA256Hash(randomSalt2);

        }

        function HashKey(salt) {
            var str = encodeURI($("#Password").val());
            var strCode1 = toHex(salt);
            var strCode2 = toHex(CryptoJS.enc.Latin1.parse(str).toString(Crypto.enc.Base64));
            var key = encodeCodes(strCode1, strCode2);
            //var Key = CryptoJS.PBKDF2(str, salt, { keySize: 256 / 24, iterations: 1000 });
            //Key = Key.toString(CryptoJS.enc.Base64);
            return key;
        }
        $("#saveUserNamehidden").val("true");
        function toHex(str) {
            var hex = '';
            for (var i = 0; i < str.length; i++) {
                hex += '' + str.charCodeAt(i).toString(16);
            }
            return hex;
        }

        function encodeCodes(str1, str2) {
            var strEncoded = '';
            var limit = str2.length;
            if (str2.length > str1.length) limit = str1.length;
            for (var i = 0; i < str2.length; i++) {
                if (i > str1.length)
                    strEncoded += '' + Math.floor(Math.random() * (9 - 1 + 1) + 1).toString() + str2.charAt(i);
                else
                    strEncoded += '' + str1.charAt(i) + str2.charAt(i);
            }
            return strEncoded;
        }

    </script>
</head>
<body>
    <div id="main-content">
        <div class="main-content cm_fund fund_rcipt">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Change User Password</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-6" style="border-right:1px solid #eee">

                                    @using (Html.BeginForm("SaveUserNewPassword", "User", new { area = "", }, FormMethod.Post, new { onkeypress = "if(event.keyCode==13 || event.which == 13) {return SubmitForm();}", @id = "LoginForm", autocomplete = "off" }))
                                    {
                                        <div class="row">
                                            <div class="form-group offset-3 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 ">
                                                <label for="inputEmail4" class="txt_label">Old Password:</label>
                                                @Html.PasswordFor(m => m.ActualPassword, new { autocomplete = "off", @class = "loginUsername form-control", @placeholder = "Enter Old Password", @maxlength = "100", @required= "required"})
                                                <p><span class="field-validation-error" id="OldPasswordValidation"></span></p>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group offset-3 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 ">
                                                <label for="inputEmail4" class="txt_label">New Password:</label>
                                                @Html.PasswordFor(m => m.Password, new { autocomplete = "off", @class = "loginUsername form-control", @placeholder = "Enter New Password", @maxlength = "100", @required = "required" })
                                                <p><span class="field-validation-error" id="PasswordValidation"></span></p>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group offset-3 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 ">
                                                <label for="inputEmail4" class="txt_label">Confirm New Password:</label>
                                                @Html.PasswordFor(m => m.confirmPassword, new { @id = "confirmpassword", autocomplete = "off", @class = "loginUsername form-control", @placeholder = "Enter Confirm Password", @required = "required", @maxlength = "100" })
                                                <p><span class="field-validation-error" id="confirmpasswordValidation"></span></p>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="form-group offset-3 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 ">
                                                <label for="inputEmail4" class="txt_label">Captcha Code:</label>
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="saveUserName" id="saveUserNamehidden" value="@Model.RememberMe" />
                                                @*@Html.HiddenFor(m => m.ActuallPassword);*@

                                                @*@Html.HiddenFor(m => m.Password)*@
                                                @Html.Hidden("AuthVerify", new Guid().ToString())
                                                @Html.HiddenFor(m => m.returnUrl, new { ViewBag.returnUrl })

                                                <div class="form_cph" id="captchacontainer">
                                                    <div class="editor-field edt_flt" style="display: inline;">
                                                        <input type="text" class="form-control txt_cpha_input" placeholder="Captcha" name="CaptchaText" id="CaptchaText" value="@ViewBag.CaptchaText" maxlength="5" />
                                                        <p><span class="field-validation-error" id="CaptchaValidation"></span></p>

                                                    </div>
                                                    <div class="editor-field edt_cpha">
                                                        <img src="@Url.Action("GetCaptchaImage", "User", new { area = "" })" />
                                                        <a id="refresh1" tabindex="6" class="ref_sign" href="@Url.Action("ChangePassword", "Account", new { })"><span class="fa fa-refresh" style="font-size: 17px;"></span></a>
                                                    </div>
                                                    @if (Model.ErrorMessage != null)
                                                    {
                                                        <p class="field-validation-error captchaMsg" id="CaptchaServerError">@Model.ErrorMessage </p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <div class="row">
                                        <div class="form-group offset-3 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 ">
                                            <input type="button" name="submit" value="Change Password" onclick="return SubmitForm();" class="btn btn-primary">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <p for="inputEmail4" class="txt_label">Please Note:</p>
                                    <p style="font-size: 10pt;">
                                        Password must contain-
                                    </p>
                                    <ul style="font-size: 10pt;">
                                        <li>At least one digit</li>
                                        <li>At least one lowercase letter</li>
                                        <li>At least one uppercase letter </li>
                                        <li>At least one special character from the set [@@$!%*?&].</li>
                                        <li>The total length of the password must be at least 8 characters.</li>
                                    </ul>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>


