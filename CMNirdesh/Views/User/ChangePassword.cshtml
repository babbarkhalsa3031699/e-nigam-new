@model CMNirdesh.Models.LoginModel

@{
    ViewBag.Title = "Change User Password";
    var FileSettings = CMNirdesh.Models.FileSetting.GetSecureFileSettingLocation();
    string sPath = System.Web.Configuration.WebConfigurationManager.AppSettings["SiteUrl"];
}

<!-- Cryptographic Libraries -->
<script src="~/Scripts/CryptoJSv3.1.2/rollups/sha256.js"></script>
<script src="~/Scripts/CryptoJSv3.1.2/rollups/pbkdf2.js"></script>
<script src="~/Scripts/CryptoJSv3.1.2/components/enc-base64-min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>

<style>
    /* Compact Executive Civic Styling */
    .cp-page-wrapper {
        padding: 12px 14px 24px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    .cp-container {
        max-width: 820px;
        margin: 0 auto;
    }

    /* Compact Breadcrumb */
    .cp-breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #64748b;
        margin-bottom: 10px;
        padding: 0 2px;
    }

    .cp-breadcrumb a {
        color: #0a3871;
        text-decoration: none;
        font-weight: 500;
    }

    .cp-breadcrumb a:hover {
        text-decoration: underline;
    }

    .cp-breadcrumb-sep {
        color: #cbd5e1;
        font-size: 10px;
    }

    /* Main Compact Civic Card */
    .cp-card {
        background: #ffffff;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 16px -2px rgba(10, 56, 113, 0.07);
        overflow: hidden;
    }

    /* Top Tricolor Strip */
    .cp-accent-bar {
        height: 3px;
        background: linear-gradient(90deg, #FF9933 0%, #FF9933 33.3%, #0A3871 33.3%, #0A3871 66.6%, #138808 66.6%, #138808 100%);
        width: 100%;
    }

    /* Compact Card Header */
    .cp-card-header {
        padding: 12px 18px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fafbfc;
    }

    .cp-header-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: linear-gradient(135deg, #0A3871 0%, #1e40af 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(10, 56, 113, 0.2);
        flex-shrink: 0;
    }

    .cp-header-text h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.2;
    }

    .cp-header-text p {
        margin: 2px 0 0;
        font-size: 11.5px;
        color: #64748b;
        line-height: 1.2;
    }

    /* Card Body */
    .cp-card-body {
        padding: 16px 18px;
    }

    .cp-grid {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -12px;
    }

    .cp-col-form {
        flex: 0 0 58%;
        max-width: 58%;
        padding: 0 16px 0 12px;
        border-right: 1px solid #f1f5f9;
    }

    .cp-col-policy {
        flex: 0 0 42%;
        max-width: 42%;
        padding: 0 12px 0 16px;
    }

    /* Compact Form Elements */
    .cp-form-group {
        margin-bottom: 11px;
        position: relative;
    }

    .cp-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 11.5px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 4px;
    }

    .cp-label-left {
        display: inline-flex;
        align-items: center;
    }

    .cp-label .required-star {
        color: #ef4444;
        margin-left: 2px;
    }

    .cp-input-group {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
    }

    .cp-input-icon {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 13px;
        pointer-events: none;
        z-index: 2;
    }

    .cp-input {
        width: 100%;
        height: 36px;
        padding: 6px 36px 6px 32px !important;
        font-size: 13px;
        color: #1e293b;
        background-color: #ffffff;
        border: 1.2px solid #cbd5e1;
        border-radius: 6px !important;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
        transition: border-color 0.15s, box-shadow 0.15s;
    }

    .cp-input:focus {
        border-color: #0a3871;
        box-shadow: 0 0 0 2.5px rgba(10, 56, 113, 0.12);
        outline: none;
    }

    .cp-input.is-invalid {
        border-color: #ef4444 !important;
        background-color: #fef2f2;
    }

    /* Show/Hide eye button */
    .cp-toggle-pwd {
        position: absolute;
        right: 4px;
        top: 50%;
        transform: translateY(-50%);
        height: 28px;
        width: 28px;
        border: none;
        background: transparent;
        color: #64748b;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 3;
        font-size: 13px;
        transition: background-color 0.15s, color 0.15s;
    }

    .cp-toggle-pwd:hover {
        color: #0a3871;
        background-color: #f1f5f9;
    }

    .cp-validation-msg {
        display: block;
        min-height: 15px;
        margin-top: 2px;
        font-size: 11px;
        color: #dc2626;
        font-weight: 500;
        line-height: 1.2;
    }

    /* Compact Strength Meter */
    .cp-strength-wrapper {
        margin-top: 4px;
    }

    .cp-strength-bar-bg {
        height: 3px;
        background: #e2e8f0;
        border-radius: 2px;
        overflow: hidden;
        margin-bottom: 3px;
    }

    .cp-strength-bar-fill {
        height: 100%;
        width: 0%;
        border-radius: 2px;
        transition: width 0.25s ease, background-color 0.25s ease;
    }

    .cp-strength-label {
        font-size: 10.5px;
        font-weight: 600;
        color: #64748b;
        display: flex;
        justify-content: space-between;
    }

    /* Compact Captcha Row */
    .cp-captcha-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cp-captcha-input-wrap {
        flex: 1;
        min-width: 100px;
    }

    .cp-captcha-input {
        letter-spacing: 2px;
        font-weight: 600;
        font-family: monospace, sans-serif;
        text-transform: uppercase;
        padding-left: 10px !important;
        height: 36px;
    }

    .cp-captcha-display {
        display: flex;
        align-items: center;
        background: #f8fafc;
        border: 1.2px solid #cbd5e1;
        border-radius: 6px;
        padding: 2px 4px;
        gap: 4px;
    }

    .cp-captcha-img {
        height: 30px;
        border-radius: 3px;
        display: block;
    }

    .cp-refresh-btn {
        width: 30px;
        height: 30px;
        border-radius: 4px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #0a3871;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 13px;
        transition: all 0.15s ease;
    }

    .cp-refresh-btn:hover {
        background: #0a3871;
        color: #ffffff;
        border-color: #0a3871;
    }

    /* Compact Submit Button */
    .cp-submit-btn {
        width: 100%;
        height: 38px;
        background: linear-gradient(135deg, #0A3871 0%, #1e40af 100%);
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-size: 13.5px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(10, 56, 113, 0.2);
        transition: all 0.15s ease;
        margin-top: 6px;
    }

    .cp-submit-btn:hover {
        background: linear-gradient(135deg, #082852 0%, #173594 100%);
        box-shadow: 0 4px 12px rgba(10, 56, 113, 0.3);
        color: #ffffff;
    }

    .cp-submit-btn:active {
        box-shadow: 0 1px 4px rgba(10, 56, 113, 0.2);
    }

    /* Compact Policy Checklist */
    .cp-policy-card {
        background: #f8fafc;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 12px 14px;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .cp-policy-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 4px;
    }

    .cp-policy-title i {
        color: #0a3871;
        font-size: 13px;
    }

    .cp-policy-desc {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 10px;
        line-height: 1.35;
    }

    .cp-policy-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .cp-policy-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 11.5px;
        color: #475569;
        margin-bottom: 6px;
        padding: 4px 8px;
        border-radius: 5px;
        background: #ffffff;
        border: 1px solid #f1f5f9;
        transition: all 0.15s ease;
    }

    .cp-policy-item .rule-icon {
        font-size: 12px;
        color: #94a3b8;
        flex-shrink: 0;
        transition: all 0.15s ease;
    }

    .cp-policy-item.is-valid {
        border-color: #bbf7d0;
        background-color: #f0fdf4;
        color: #166534;
        font-weight: 500;
    }

    .cp-policy-item.is-valid .rule-icon {
        color: #16a34a;
    }

    .cp-policy-tip {
        margin-top: auto;
        padding: 8px 10px;
        border-radius: 6px;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        font-size: 11px;
        color: #1e40af;
        display: flex;
        gap: 6px;
        line-height: 1.35;
    }

    .cp-policy-tip i {
        font-size: 12px;
        margin-top: 1px;
        flex-shrink: 0;
    }

    /* Compact Alert Banners */
    .cp-alert {
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        line-height: 1.3;
    }

    .cp-alert-danger {
        background-color: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .cp-alert-success {
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
    }

    .cp-alert i {
        font-size: 14px;
        flex-shrink: 0;
    }

    /* Responsive Breakdown */
    @@media (max-width: 768px) {
        .cp-col-form {
            flex: 0 0 100%;
            max-width: 100%;
            padding: 0;
            border-right: none;
            margin-bottom: 16px;
        }

        .cp-col-policy {
            flex: 0 0 100%;
            max-width: 100%;
            padding: 0;
        }

        .cp-card-body {
            padding: 14px;
        }
    }

    @@media (max-width: 480px) {
        .cp-page-wrapper {
            padding: 8px 6px 20px;
        }

        .cp-card-header {
            padding: 10px 12px;
        }

        .cp-captcha-row {
            flex-direction: column;
            align-items: stretch;
            gap: 6px;
        }

        .cp-captcha-display {
            justify-content: space-between;
        }

        .cp-input {
            font-size: 16px !important; /* Prevents auto-zoom on mobile */
        }
    }
</style>

<div class="cp-page-wrapper">
    <div class="cp-container">

        <!-- Breadcrumb -->
        <div class="cp-breadcrumb">
            <i class="fa fa-user-circle"></i>
            <a href="javascript:void(0);">User Management</a>
            <span class="cp-breadcrumb-sep"><i class="fa fa-chevron-right"></i></span>
            <span>Change Password</span>
        </div>

        <!-- Main Card Container -->
        <div class="cp-card">
            <!-- Tricolor Accent -->
            <div class="cp-accent-bar"></div>

            <!-- Card Header -->
            <div class="cp-card-header">
                <div class="cp-header-icon">
                    <i class="fa fa-key"></i>
                </div>
                <div class="cp-header-text">
                    <h2>Change User Password</h2>
                    <p>Update your credentials with a strong, secure password.</p>
                </div>
            </div>

            <!-- Card Body -->
            <div class="cp-card-body">

                <!-- Server Side Messages -->
                @if (Model != null && !string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="cp-alert cp-alert-danger" id="CaptchaServerError">
                        <i class="fa fa-exclamation-triangle"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                @if (TempData["ChngPwdSucessMsg"] != null)
                {
                    <div class="cp-alert cp-alert-success">
                        <i class="fa fa-check-circle"></i>
                        <div>@TempData["ChngPwdSucessMsg"]</div>
                    </div>
                }

                <!-- Client Side Validation Alert -->
                <div class="cp-alert cp-alert-danger" id="clientValidationAlert" style="display: none;">
                    <i class="fa fa-exclamation-circle"></i>
                    <div id="clientValidationText">Please resolve the indicated errors.</div>
                </div>

                <div class="cp-grid">
                    <!-- Left: Password Form -->
                    <div class="cp-col-form">
                        @using (Html.BeginForm("SaveUserNewPassword", "User", new { area = "" }, FormMethod.Post, new { onkeypress = "if(event.keyCode==13 || event.which == 13) {return SubmitForm();}", @id = "LoginForm", autocomplete = "off" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="saveUserName" id="saveUserNamehidden" value="@(Model != null ? Model.RememberMe : false)" />
                            @Html.Hidden("AuthVerify", Guid.NewGuid().ToString())
                            @Html.HiddenFor(m => m.returnUrl, new { ViewBag.returnUrl })

                            <!-- Old Password Field -->
                            <div class="cp-form-group">
                                <label for="ActualPassword" class="cp-label">
                                    <span class="cp-label-left">Current Password <span class="required-star">*</span></span>
                                </label>
                                <div class="cp-input-group">
                                    <i class="fa fa-lock cp-input-icon"></i>
                                    @Html.PasswordFor(m => m.ActualPassword, new { autocomplete = "off", @class = "form-control cp-input", @placeholder = "Enter current password", @maxlength = "100", @required = "required", @id = "ActualPassword" })
                                    <button type="button" class="cp-toggle-pwd" onclick="togglePasswordVisibility('ActualPassword', this)" title="Show / Hide Password" tabindex="-1">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                                <span class="cp-validation-msg" id="OldPasswordValidation"></span>
                            </div>

                            <!-- New Password Field -->
                            <div class="cp-form-group">
                                <label for="Password" class="cp-label">
                                    <span class="cp-label-left">New Password <span class="required-star">*</span></span>
                                </label>
                                <div class="cp-input-group">
                                    <i class="fa fa-key cp-input-icon"></i>
                                    @Html.PasswordFor(m => m.Password, new { autocomplete = "new-password", @class = "form-control cp-input", @placeholder = "Enter new secure password", @maxlength = "100", @required = "required", @id = "Password" })
                                    <button type="button" class="cp-toggle-pwd" onclick="togglePasswordVisibility('Password', this)" title="Show / Hide Password" tabindex="-1">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                                <!-- Password Strength Bar -->
                                <div class="cp-strength-wrapper">
                                    <div class="cp-strength-bar-bg">
                                        <div class="cp-strength-bar-fill" id="strengthBar"></div>
                                    </div>
                                    <div class="cp-strength-label">
                                        <span>Strength</span>
                                        <span id="strengthText" style="color: #94a3b8;">Not entered</span>
                                    </div>
                                </div>
                                <span class="cp-validation-msg" id="PasswordValidation"></span>
                            </div>

                            <!-- Confirm New Password Field -->
                            <div class="cp-form-group">
                                <label for="confirmpassword" class="cp-label">
                                    <span class="cp-label-left">Confirm New Password <span class="required-star">*</span></span>
                                </label>
                                <div class="cp-input-group">
                                    <i class="fa fa-check-square-o cp-input-icon"></i>
                                    @Html.PasswordFor(m => m.confirmPassword, new { @id = "confirmpassword", autocomplete = "new-password", @class = "form-control cp-input", @placeholder = "Re-enter new password", @required = "required", @maxlength = "100" })
                                    <button type="button" class="cp-toggle-pwd" onclick="togglePasswordVisibility('confirmpassword', this)" title="Show / Hide Password" tabindex="-1">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                                <span class="cp-validation-msg" id="confirmpasswordValidation"></span>
                            </div>

                            <!-- Captcha Verification Field -->
                            <div class="cp-form-group">
                                <label for="CaptchaText" class="cp-label">
                                    <span class="cp-label-left">Verification Code <span class="required-star">*</span></span>
                                </label>
                                <div class="cp-captcha-row">
                                    <div class="cp-captcha-input-wrap">
                                        <input type="text" class="form-control cp-input cp-captcha-input" placeholder="Captcha" name="CaptchaText" id="CaptchaText" value="@ViewBag.CaptchaText" maxlength="5" autocomplete="off" />
                                    </div>
                                    <div class="cp-captcha-display">
                                        <img id="imgCaptcha" src="@Url.Action("GetCaptchaImage", "User", new { area = "" })" alt="Captcha" class="cp-captcha-img" />
                                        <button type="button" id="refreshCaptchaBtn" class="cp-refresh-btn" onclick="refreshCaptcha();" title="Refresh Captcha">
                                            <i class="fa fa-refresh" id="refreshIcon"></i>
                                        </button>
                                    </div>
                                </div>
                                <span class="cp-validation-msg" id="CaptchaValidation"></span>
                            </div>

                            <!-- Submit Action Button -->
                            <div class="cp-form-group" style="margin-top: 14px;">
                                <button type="button" id="btnsubmit" name="submit" onclick="return SubmitForm();" class="cp-submit-btn">
                                    <i class="fa fa-shield"></i>
                                    <span>Update Password</span>
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Right: Compact Security Policy Card -->
                    <div class="cp-col-policy">
                        <div class="cp-policy-card">
                            <h3 class="cp-policy-title">
                                <i class="fa fa-shield"></i>
                                <span>Password Policy</span>
                            </h3>
                            <p class="cp-policy-desc">
                                Your new password must meet all criteria below:
                            </p>

                            <ul class="cp-policy-list">
                                <li class="cp-policy-item" id="rule-length">
                                    <i class="fa fa-circle-o rule-icon"></i>
                                    <span>At least <strong>8 characters</strong></span>
                                </li>
                                <li class="cp-policy-item" id="rule-lower">
                                    <i class="fa fa-circle-o rule-icon"></i>
                                    <span>One <strong>lowercase letter</strong> (a-z)</span>
                                </li>
                                <li class="cp-policy-item" id="rule-upper">
                                    <i class="fa fa-circle-o rule-icon"></i>
                                    <span>One <strong>uppercase letter</strong> (A-Z)</span>
                                </li>
                                <li class="cp-policy-item" id="rule-digit">
                                    <i class="fa fa-circle-o rule-icon"></i>
                                    <span>At least one <strong>number</strong> (0-9)</span>
                                </li>
                                <li class="cp-policy-item" id="rule-special">
                                    <i class="fa fa-circle-o rule-icon"></i>
                                    <span>One <strong>special symbol</strong> (@@$!%*?&)</span>
                                </li>
                                <li class="cp-policy-item" id="rule-match">
                                    <i class="fa fa-circle-o rule-icon"></i>
                                    <span>Passwords must <strong>match</strong></span>
                                </li>
                            </ul>

                            <div class="cp-policy-tip">
                                <i class="fa fa-lightbulb-o"></i>
                                <div>
                                    <strong>Tip:</strong> Avoid using common words or previous passwords.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#saveUserNamehidden").val("False");

        // Real-time password validation & checklist
        $('#Password').on('input', function () {
            validatePasswordRules();
        });

        $('#confirmpassword').on('input', function () {
            validatePasswordRules();
        });

        $('#ActualPassword').on('input', function () {
            if ($(this).val().trim() !== '') {
                $('#OldPasswordValidation').text('');
                $(this).removeClass('is-invalid');
            }
        });

        $('#CaptchaText').on('input', function () {
            if ($(this).val().trim() !== '') {
                $('#CaptchaValidation').text('');
                $(this).removeClass('is-invalid');
            }
        });

        $('#CaptchaText').keydown(function (e) {
            if (e.keyCode == 13 || e.which == 13) {
                e.preventDefault();
                SubmitForm();
            }
        });
    });

    // Toggle Show/Hide Password
    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        if (!input) return;
        var icon = $(btn).find('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.removeClass('fa-eye').addClass('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.removeClass('fa-eye-slash').addClass('fa-eye');
        }
    }

    // Refresh Captcha Image dynamically
    function refreshCaptcha() {
        var $icon = $('#refreshIcon');
        $icon.addClass('fa-spin');
        var newSrc = '@Url.Action("GetCaptchaImage", "User", new { area = "" })' + '?t=' + new Date().getTime();
        $('#imgCaptcha').attr('src', newSrc);
        setTimeout(function () {
            $icon.removeClass('fa-spin');
        }, 600);
    }

    // Dynamic Live Password Validation & Strength Evaluator
    function validatePasswordRules() {
        var pwd = $('#Password').val() || '';
        var cpwd = $('#confirmpassword').val() || '';

        var hasLength = pwd.length >= 8;
        var hasLower = /[a-z]/.test(pwd);
        var hasUpper = /[A-Z]/.test(pwd);
        var hasDigit = /\d/.test(pwd);
        var hasSpecial = /[`!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?~]/.test(pwd);
        var isMatch = (pwd.length > 0 && cpwd.length > 0 && pwd === cpwd);

        updateRuleUI('#rule-length', hasLength);
        updateRuleUI('#rule-lower', hasLower);
        updateRuleUI('#rule-upper', hasUpper);
        updateRuleUI('#rule-digit', hasDigit);
        updateRuleUI('#rule-special', hasSpecial);
        updateRuleUI('#rule-match', isMatch);

        // Strength Calculation
        if (pwd.length === 0) {
            $('#strengthBar').css({ width: '0%', backgroundColor: '#e2e8f0' });
            $('#strengthText').text('Not entered').css('color', '#94a3b8');
            return;
        }

        var score = 0;
        if (hasLength) score++;
        if (hasLower) score++;
        if (hasUpper) score++;
        if (hasDigit) score++;
        if (hasSpecial) score++;

        var bar = $('#strengthBar');
        var text = $('#strengthText');

        if (score <= 2) {
            bar.css({ width: '30%', backgroundColor: '#ef4444' });
            text.text('Weak').css('color', '#ef4444');
        } else if (score <= 4) {
            bar.css({ width: '65%', backgroundColor: '#f59e0b' });
            text.text('Moderate').css('color', '#f59e0b');
        } else {
            bar.css({ width: '100%', backgroundColor: '#10b981' });
            text.text('Strong').css('color', '#10b981');
        }

        if (hasLength && hasLower && hasUpper && hasDigit && hasSpecial) {
            $('#PasswordValidation').text('');
            $('#Password').removeClass('is-invalid');
        }

        if (isMatch) {
            $('#confirmpasswordValidation').text('');
            $('#confirmpassword').removeClass('is-invalid');
        }
    }

    function updateRuleUI(selector, isValid) {
        var $el = $(selector);
        var $icon = $el.find('.rule-icon');
        if (isValid) {
            $el.addClass('is-valid');
            $icon.removeClass('fa-circle-o').addClass('fa-check-circle');
        } else {
            $el.removeClass('is-valid');
            $icon.removeClass('fa-check-circle').addClass('fa-circle-o');
        }
    }

    // Cryptographic Helpers
    function generateRandomSalt() {
        var salt = '';
        var array = new Uint8Array(32);
        window.crypto.getRandomValues(array);
        for (var i = 0; i < array.length; i++) {
            salt += (array[i] < 16 ? '0' : '') + array[i].toString(16);
        }
        return salt;
    }

    function generateSHA256Hash(data) {
        return CryptoJS.SHA256(data).toString(CryptoJS.enc.Hex);
    }

    function checkPasswordFormat(password) {
        var regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@@$!%*?&])[A-Za-z\d@@$!%*?&]{8,}$/;
        return regex.test(password);
    }

    function isPasswordValid(password) {
        if (password.length < 8) return false;
        if (!/\d/.test(password)) return false;
        if (!/[a-z]/.test(password)) return false;
        if (!/[A-Z]/.test(password)) return false;
        var specialCharacters = /[`!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?~]/;
        if (!specialCharacters.test(password)) return false;
        return true;
    }

    // Hash values before sending
    function ConfirmFunction() {
        var actualPwd = $("#ActualPassword").val();
        var saltActual = generateRandomSalt();
        document.getElementById("ActualPassword").value = generateSHA256Hash(actualPwd) + generateSHA256Hash(saltActual);

        var newPwd = $("#Password").val();
        var saltNew = generateRandomSalt();
        document.getElementById("Password").value = generateSHA256Hash(newPwd) + generateSHA256Hash(saltNew);

        var confirmPwd = $("#confirmpassword").val();
        var saltConfirm = generateRandomSalt();
        document.getElementById("confirmpassword").value = generateSHA256Hash(confirmPwd) + generateSHA256Hash(saltConfirm);
    }

    // Form Submission & Validation
    function SubmitForm() {
        var oldpassword = $("#ActualPassword").val() || "";
        var password = $("#Password").val() || "";
        var confirmpassword = $("#confirmpassword").val() || "";
        var captcha = $("#CaptchaText").val() ? $("#CaptchaText").val().trim() : "";

        // Reset error messages and alerts
        $('.cp-validation-msg').text('');
        $('.cp-input').removeClass('is-invalid');
        $('#clientValidationAlert').hide();

        var isValid = true;

        if (oldpassword === "") {
            $('#OldPasswordValidation').text('Please enter your current password.');
            $('#ActualPassword').addClass('is-invalid').focus();
            isValid = false;
        } else if (password === "") {
            $('#PasswordValidation').text('Please enter a new password.');
            $('#Password').addClass('is-invalid').focus();
            isValid = false;
        } else if (password === oldpassword) {
            $('#PasswordValidation').text('New password cannot be the same as your current password.');
            $('#Password').addClass('is-invalid').focus();
            isValid = false;
        } else if (confirmpassword === "") {
            $('#confirmpasswordValidation').text('Please confirm your new password.');
            $('#confirmpassword').addClass('is-invalid').focus();
            isValid = false;
        } else if (password !== confirmpassword) {
            $('#confirmpasswordValidation').text('New password and confirm password do not match.');
            $('#confirmpassword').addClass('is-invalid').focus();
            isValid = false;
        } else if (!checkPasswordFormat(password) || !isPasswordValid(password)) {
            $('#PasswordValidation').text('Password does not meet all policy requirements (8+ chars, uppercase, lowercase, digit, special symbol).');
            $('#Password').addClass('is-invalid').focus();
            isValid = false;
        } else if (captcha === "") {
            $('#CaptchaValidation').text('Please enter the security captcha code.');
            $('#CaptchaText').addClass('is-invalid').focus();
            isValid = false;
        }

        if (isValid) {
            // Display loading state on button
            var $btn = $('#btnsubmit');
            $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> <span>Updating...</span>');

            // Apply cryptographic hash transformation
            ConfirmFunction();

            // Submit form
            document.getElementById('LoginForm').submit();
            return true;
        } else {
            return false;
        }
    }
</script>
