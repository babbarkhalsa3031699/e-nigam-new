        //Function for clearing the textboxes
        //Valdidation using jquery
        function validate() {
            var isValid = true;
            var firstInvalid = null;

            // Validate Title
            var titleVal = $('#Title').val();
            if (!titleVal || titleVal.trim() === "") {
                $('#Title').addClass('is-invalid').css('background-color', '#fef2f2');
                $('#TitleError').addClass('show');
                isValid = false;
                if (!firstInvalid) firstInvalid = $('#Title');
            } else {
                $('#Title').removeClass('is-invalid').css('background-color', 'white');
                $('#TitleError').removeClass('show');
            }

            // Validate MC Name
            var mcVal = $('#MCIDDropDown').val();
            if (!mcVal || mcVal.toString().trim() === "0" || mcVal.toString().trim() === "") {
                $('#MCIDDropDown').addClass('is-invalid').css('background-color', '#fef2f2');
                $('#MCIDDropDownError').addClass('show');
                isValid = false;
                if (!firstInvalid) firstInvalid = $('#MCIDDropDown');
            } else {
                $('#MCIDDropDown').removeClass('is-invalid').css('background-color', 'white');
                $('#MCIDDropDownError').removeClass('show');
            }

            // Validate Image (required when creating new gallery item)
            var isNew = !$('#selectedId').val() || $('#selectedId').val().trim() === "" || $('#selectedId').val().trim() === "0";
            var fileUpload = $("#ImagePath").get(0);
            var files = fileUpload ? fileUpload.files : null;
            if (isNew && (!files || files.length === 0)) {
                $('#uploadCard').addClass('is-invalid');
                $('#ImagePathError').addClass('show');
                isValid = false;
                if (!firstInvalid) firstInvalid = $('#ImagePath');
            } else {
                $('#uploadCard').removeClass('is-invalid');
                $('#ImagePathError').removeClass('show');
            }

            if (firstInvalid) {
                firstInvalid.focus();
            }

            return isValid;
        }

