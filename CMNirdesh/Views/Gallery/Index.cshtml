        pointer-events: none;
        transition: all 0.3s ease;
    }

    .toggle .labels::after {
        content: "DeActive";
        position: absolute;
        right: 6px;
        color: #64748b;
        opacity: 1;
    }

    .toggle .labels::before {
        content: "Active";
        position: absolute;
        left: 6px;
        color: #ffffff;
        opacity: 0;
    }

    .toggle input:checked ~ .labels::after {
        opacity: 0;
    }

    .toggle input:checked ~ .labels::before {
        opacity: 1;
    }

