        function getbyID(EmpID) {
            debugger
            clearTextBox();

           var url = '@Url.Action("Edit", "Gallery")' + "?id=" + EmpID;

            $("#myModalLabel").html("Update Gallery Details");
            $("#btnUpdate").show();
            $("#btnSave").hide();
            $.ajax({
                type: "GET",
                url: url,
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    var obj = JSON.parse(result);
                    var data = obj._LstHomeGallery[0];
                    $('#myModal').modal();

                    $('#selectedId').val(data.Id);
                    $("#Title").val(data.Title);
                    $("#TitlePunjabi").val(data.TitlePunjabi);
                    $("#Description").val(data.Description);
                    $("#DescriptionPunjabi").val(data.DescriptionPunjabi);
                    $("#MCIDDropDown").val(data.MCId);
                    $("#imgPreview").attr('src', '/HomeGallery/' + data.ImagePath);
                    $("#btnSave").hide();
                }
            });
        }

        //Function for clearing the textboxes
        //Valdidation using jquery
        function validate() {

            var isValid = true;
            if ($('#Title').val().trim() === "") {
                $('#Title').css('background-color', '#ff56564d');
                isValid = false;
            }
            else {
                $('#Title').css('background-color', 'white');
            }
            if ($('#MCIDDropDown').val().trim() === "0") {
                $('#MCIDDropDown').css('background-color', '#ff56564d');
                isValid = false;
            }
            else {
                $('#MCIDDropDown').css('background-color', 'white');
            }
            return isValid;
        }


    function clearTextBox() {
