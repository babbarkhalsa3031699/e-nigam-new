        function getbyID(EmpID) {
            debugger
            clearTextBox();

           var url = '@Url.Action("Edit", "Gallery")' + "?id=" + EmpID;

            $("#myModalLabel").html("Update Gallery Details");
            $("#btnUpdate").show();
            $("#btnSave").hide();
            $.ajax({
                type: "GET",
                url: url,
                contentType: "application/json;charset=utf-8",
