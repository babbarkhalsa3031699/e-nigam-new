        max-width: 100%;
        margin-bottom: 10px;
    }
</style>

<script>
    $(document).ready(function () {

        $('#example').DataTable({
        });
        var s = $("#MCIDDropDown");
        var url = '@Url.Action("MCDropDown", "McMenu")';
        debugger
        s.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
        $.ajax({
            type: "POST",
            url: url,
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                s.empty().append('<option selected="selected" value="0">Please select</option>');
