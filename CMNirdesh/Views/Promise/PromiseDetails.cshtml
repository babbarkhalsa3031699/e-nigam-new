@model  IEnumerable<CMNirdesh.Models.Promise>

@{
    ViewBag.Title = "PromiseList";

    int count = 0;
}
<style>

    .inr_frm_dsgn {
        margin-top: 20px;
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .inr_frm_dsgn {
        margin-top: 20px;
    }

    .form_lyot {
        padding: 10px;
    }
</style>

@*@Html.Partial("~/Views/References/_LeftNavigationMenu.cshtml")*@

<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="inr_frm_dsgn">
                <div class="Tab_hdr p-2" style="display:flex;">
                    <div class="col-md-6">
                        <h2>Promise List</h2>
                    </div>
                    <div class="col-md-6 text-end txt_rit">
                        <button class="btn  btn-sm btn-primary" style="font-size:14px;" onclick="javascript:window.location.href='/Promise/CreatePromise';">
                            <i class="ace-icon fa fa-pencil-square-o bigger-150"></i>
                            <span class="bigger-110">New Promise</span>
                        </button>
                    </div>

                </div>
                <div class="form_lyot">

                    @if (Model != null)
                    {
                        if (Model.Count() > 0)
                        {
                            <table id="example" class="table table-hover table-bordered">
                                <thead>
                                    <tr class="table-heading">
                                        <th class="td-heading" style="width:30%;"><span class="font-weight-bold">Sr no.</span></th>
                                        <th class="td-heading" style="width:30%;"><span class="font-weight-bold">Promise Name</span></th>
                                        <th class="td-heading" style="width:30%;"><span class="font-weight-bold">Status</span></th>
                                        <th class="td-heading" style="width:10%;"><span class="font-weight-bold">Action</span></th>
                                    </tr>
                                </thead>
                                <tbody role="alert" aria-live="polite" aria-relevant="all">
                                    @foreach (var item in Model)
                                    {
                                        count = count + 1;

                                        <tr>
                                            <td class="center td-data" >
                                                @count
                                            </td>
                                            <td class="center td-data">
                                                @item.PromiseName
                                            </td>




                                            <td class="hidden-480 center td-data">
                                                @if (item.isActive == true)
                                                {
                                                    <span class="label label-sm label-primary">Published</span>
                                                }
                                                else
                                                {
                                                    <span class="label label-sm label-warning">Unpublished</span>
                                                }

                                            </td>

                                            <td class="center td-data">
                                                <div class="hidden-sm hidden-xs action-buttons">


                                                    <a data-rel="tooltip" class="green tooltip-primary" title="Edit" href="@Url.Action("EditPromise", "Promise", new { Id = CMNirdesh.Models.EncryptionUtility.Encrypt(item.PromiseId.ToString()) })">
                                                        <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                    </a>
                                                    <a data-rel="tooltip" class="red tooltip-error" title="Delete" id="DeleteLink" href="@Url.Action("DeletePromise", "Promise", new { Id = CMNirdesh.Models.EncryptionUtility.Encrypt(item.PromiseId.ToString()) })">
                                                        <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                    </a>
                                                </div>


                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        }
                        else
                        {
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="alert alert-info">
                                        <strong>There are no record found</strong><br />

                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>

        </section>




        <div class="footer">
            <div class="footer-inner">
                <!-- #section:basics/footer -->
                <div class="footer-content">


                </div>

                <!-- /section:basics/footer -->
            </div>
        </div>

        <a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
            <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
        </a>
    </div>


    <div id="dialog-confirm" class="hide">
        <div id="DialogMessage" class="alert alert-info bigger-110">
            Are You Sure Want to Delete.
        </div>

        <div class="space-6"></div>
    </div>

</div>

