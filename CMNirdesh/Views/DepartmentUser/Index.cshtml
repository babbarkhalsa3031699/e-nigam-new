@model CMNirdesh.Models.UpdateUserDetailModel
@{
    ViewBag.Title = "Update Department User";
}

<meta name="viewport" content="width=device-width" />

<link href="~/Scripts/datatables/datatable.min.css" rel="stylesheet" />
<link href="~/Scripts/datatables/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/datatables/jquery.dataTables.js"></script>
<script src="~/Scripts/datatables/dataTables.buttons.min.js"></script>
<script src="~/Scripts/datatables/jszip.min.js"></script>
<script src="~/Scripts/datatables/pdfmake.min.js.js"></script>
<script src="~/Scripts/datatables/vfs-fonts.js"></script>
<script src="~/Scripts/datatables/buttons.print.min.js"></script>
<script src="~/Scripts/datatables/buttons.html5.min.js"></script>
<script src="~/Scripts/jquery.ui.widget.js"></script>
<script src="~/Scripts/jquery.fileupload.js"></script>


<script>

    $(document).ready(function () {

        var table = $('#fundreport').DataTable({
            "bLengthChange": false,
            "pageLength": 10,
            "searching": true,
            order: [[0, 'desc']],
            dom: 'Bfrtip',
            buttons: [
                'excelHtml5',
                'csvHtml5',

                {
                    extend: 'pdfHtml5',
                    orientation: 'landscape',
                    customize: function (doc) {
                        /* here I am aligning text in a column to the right */
                        rowCount = table.rows({ search: 'applied' }).count() + 1;

                        for (i = 0; i < rowCount; i++) {

                            //doc.content[1].table.body[i][3].alignment = 'right';
                            doc.content[1].table.body[i][3].alignment = 'right';
                        };
                        doc.content[1].table.widths = ['20%', '20%', '20%', '20%', '20%'];
                    },

                    exportOptions: {
                        columns: [1, 2, 3, 4, 5]
                    }
                }
            ]
            //bFilter: false,

        });


    });
</script>
<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">
                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> User List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i>Update Department User</button>
                            </div>
                        </div>
                    </div>

                    <div class="form_lyot">
                        <div class="coman_modal dispatch_modal addnew_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">

                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title fs-5" id="myModalLabel">Update User Details</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">

                                        @* SUCCESS MESSAGE *@
                                        @if (TempData["Success"] != null)
                                        {
                                            <div class="alert alert-success alert-dismissible fade show">
                                                @TempData["Success"]
                                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                            </div>
                                        }

                                        @if (TempData["Error"] != null)
                                        {
                                            <div class="alert alert-danger alert-dismissible fade show">
                                                @TempData["Error"]
                                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                            </div>
                                        }

                                        @using (Html.BeginForm("UpdateUser", "DepartmentUser", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()

                                            <div class="card">


                                                <div class="card-body">

                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                                    <!-- USER DROPDOWN -->
                                                    <div class="form-group">
                                                        <label>Select User</label>
                                                        @Html.DropDownListFor(
                                                                                                              m => m.UserId,
                                                                                                              new SelectList(Model.Users, "UserId", "UserName"),
                                                                                                              "-- Select User --",
                                                                                                              new { @class = "form-control", @id = "ddlUser", }
                                                                                                          )
                                                        @Html.ValidationMessageFor(m => m.UserId, "", new { @class = "text-danger" })
                                                    </div>

                                                    <!-- NAME -->
                                                    <div class="form-group">
                                                        <label>Name</label>
                                                        @Html.TextBoxFor(
                                                                                                              m => m.Name,
                                                                                                              new { @id = "txtName", @class = "form-control" }
                                                                                                          )
                                                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                                                    </div>

                                                    <!-- EMAIL -->
                                                    <div class="form-group">
                                                        <label>Email</label>
                                                        @Html.TextBoxFor(
                                                                                                              m => m.Email,
                                                                                                              new { @class = "form-control", @id = "txtEmail" }
                                                                                                          )
                                                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                                    </div>

                                                    <!-- MOBILE -->
                                                    <div class="form-group">
                                                        <label>Mobile</label>
                                                        @Html.TextBoxFor(
                                                                                                              m => m.Mobile,
                                                                                                              new { @class = "form-control", maxlength = "10", @id = "txtMobile" }
                                                                                                          )
                                                        @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "text-danger" })
                                                    </div>

                                                    <!-- VALID FROM -->
                                                    <div class="form-group">
                                                        <label>Valid From</label>
                                                        @Html.TextBoxFor(
                                                                                                              m => m.ValidFrom,
                                                                                                              new { @class = "form-control", type = "date", @id = "txtValidFrom" }
                                                                                                          )
                                                        @Html.ValidationMessageFor(m => m.ValidFrom, "", new { @class = "text-danger" })
                                                    </div>

                                                    <!-- VALID TO -->
                                                    <div class="form-group">
                                                        <label>Valid To (Optional)</label>
                                                        @Html.TextBoxFor(
                                                                                                              m => m.ValidTo,
                                                                                                              new { @class = "form-control", type = "date", @id = "txtValidTo" }
                                                                                                          )
                                                        @Html.ValidationMessageFor(m => m.ValidTo, "", new { @class = "text-danger" })
                                                    </div>

                                                    <!-- SUBMIT -->
                                                    <div class="form-group">
                                                        <button type="submit" class="btn btn-primary">
                                                            Update User
                                                        </button>
                                                    </div>

                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <div class="col-lg-12">
        <!-- BAR CHART -->
        <div class="card card-success">

            <div class="card-body">
                <div class="row" id="filter">


                </div>
                <div class="table-responsive">
                    <table id="fundreport" class="table table-bordered  dataTable">
                        <thead>
                            <tr>
                                <th class="center td-heading">User Name</th>
                                <th class="center td-heading">Name</th>
                                <th class="center td-heading">Designation</th>
                                <th class="center td-heading">Email</th>
                                <th class="center td-heading">Mobile</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var mdl in Model._LstUser)
                            {
                                <tr id="row_@mdl.UserId">
                                    <td>@mdl.UserName</td>
                                    <td>@mdl.Name</td>
                                    <td>@mdl.Designation</td>
                                    <td>@mdl.Email</td>
                                    <td>@mdl.MobileNo</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /.card-body -->
        </div>
        <!-- /.card -->

    </div>


</div>


<script>

        $('#ddlUser').change(function () {
            var userId = $(this).val();

            if (!userId) {
                clearFields();
                return;
            }

            $.getJSON('@Url.Action("GetUserDetails", "DepartmentUser")',
                { userId: userId },
                function (data) {
                      if (data) {
                        $('#txtName').val(data.Name);
                        $('#txtEmail').val(data.Email);
                        $('#txtMobile').val(data.Mobile);

                         //OPTIONAL (only if you return dates)
                         $('#txtValidFrom').val(data.ValidFrom);
                         $('#txtValidTo').val(data.ValidTo);
                    }
                }
            );
        });

        function clearFields() {
            $('#txtName').val('');
            $('#txtEmail').val('');
            $('#txtMobile').val('');
            $('#txtValidFrom').val('');
            $('#txtValidTo').val('');
        }

</script>


