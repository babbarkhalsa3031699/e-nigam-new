<script>
    $('#ddlUser').change(function () {
        var userId = $(this).val();

        if (!userId) {
            clearFields();
            return;
        }

        $.getJSON('@Url.Action("GetUserDetails", "DepartmentUser")',
            { userId: userId },
            function (data) {
                if (data) {
                    $('#txtName').val(data.Name || '');
                    $('#txtEmail').val(data.Email || '');
                    $('#txtMobile').val(data.Mobile || '');

                    if (data.ValidFrom) {
                        var sDate = parseJsonDate(data.ValidFrom);
                        if (sDate) $('#txtValidFrom').val(formatDate(sDate));
                    }
                    if (data.ValidTo) {
                        var eDate = parseJsonDate(data.ValidTo);
                        if (eDate) $('#txtValidTo').val(formatDate(eDate));
                    }

                    $('#txtName, #txtEmail, #txtMobile').removeClass('is-invalid').css('background-color', 'white');
                    $('#txtNameError, #txtEmailError, #txtMobileError').removeClass('show');
                }
            }
        );
    });

    function parseJsonDate(val) {
        if (!val) return null;
        if (typeof val === 'string' && val.indexOf('/Date(') !== -1) {
            return new Date(parseInt(val.substr(6)));
        }
        if (typeof val === 'string' && /^\d{4}-\d{2}-\d{2}/.test(val)) {
            var parts = val.substring(0, 10).split('-');
            return new Date(parts[0], parts[1] - 1, parts[2]);
        }
        var parsed = new Date(val);
        return isNaN(parsed.getTime()) ? null : parsed;
    }

    function formatDate(date) {
        if (!date || isNaN(date.getTime())) return "";
        var day = date.getDate();
        var month = date.getMonth() + 1;
        var year = date.getFullYear();

        if (day < 10) day = '0' + day;
        if (month < 10) month = '0' + month;
        return year + "-" + month + "-" + day;
    }

    function clearTextBox() {
        clearFields();
        $('#ddlUser').val('');
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#ddlUser, #txtName, #txtEmail, #txtMobile, #txtValidFrom, #txtValidTo').css('background-color', 'white');
    }

    function clearFields() {
        $('#txtName').val('');
        $('#txtEmail').val('');
        $('#txtMobile').val('');
        $('#txtValidFrom').val('');
        $('#txtValidTo').val('');
        $('.is-invalid').removeClass('is-invalid');
        $('.field-val-msg').removeClass('show');
        $('#txtName, #txtEmail, #txtMobile, #txtValidFrom, #txtValidTo').css('background-color', 'white');
    }
</script>
