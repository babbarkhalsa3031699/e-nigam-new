<script>
    $(document).ready(function () {
        var table = $('#fundreport').DataTable({
            "bLengthChange": false,
            "pageLength": 10,
            "searching": true,
            order: [[0, 'desc']],
            dom: 'Bfrtip',
            "language": {
                "search": "Search:"
            },
            buttons: [
                'excelHtml5',
                'csvHtml5',
                {
                    extend: 'pdfHtml5',
                    orientation: 'landscape',
                    customize: function (doc) {
                        rowCount = table.rows({ search: 'applied' }).count() + 1;
                        for (i = 0; i < rowCount; i++) {
                            doc.content[1].table.body[i][3].alignment = 'right';
                        }
                        doc.content[1].table.widths = ['20%', '20%', '20%', '20%', '20%'];
                    },
                    exportOptions: {
                        columns: [1, 2, 3, 4, 5]
                    }
                }
            ]
        });

        function syncToolbarSearch() {
            var $wrapper = $('#fundreport_wrapper');
            if ($wrapper.length) {
                var $filter = $wrapper.find('> .dataTables_filter, .dataTables_filter');
                if ($filter.length && !$('#toolbarSearchSlot').children().length) {
                    $('#toolbarSearchSlot').empty().append($filter);
                }
            }
        }
        syncToolbarSearch();
        $(document).on('init.dt draw.dt', '#fundreport', function () {
            syncToolbarSearch();
        });

        // Real-time clearing of validation highlights
        $('#ddlUser').on('change', function () {
            if ($(this).val()) {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#ddlUserError').removeClass('show');
            }
        });

        $('#txtName').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#txtNameError').removeClass('show');
            }
        });

        $('#txtEmail').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#txtEmailError').removeClass('show');
            }
        });

        $('#txtMobile').on('input keyup change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#txtMobileError').removeClass('show');
            }
        });

        $('#txtValidFrom').on('input change', function () {
            if ($(this).val().trim() !== "") {
                $(this).removeClass('is-invalid').css('background-color', 'white');
                $('#txtValidFromError').removeClass('show');
            }
        });

        $('#txtValidTo').on('input change', function () {
            $(this).removeClass('is-invalid').css('background-color', 'white');
            $('#txtValidToError').removeClass('show');
        });
    });

    function validate() {
        var isValid = true;
        var firstInvalid = null;

        // 1. User Dropdown
        var userId = $('#ddlUser').val();
        if (!userId || userId.trim() === '') {
            $('#ddlUser').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#ddlUserError').html('<i class="fa fa-exclamation-circle"></i> Please select a User').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#ddlUser');
        } else {
            $('#ddlUser').removeClass('is-invalid').css('background-color', 'white');
            $('#ddlUserError').removeClass('show');
        }

        // 2. Name
        var name = $('#txtName').val();
        var nameRegex = /^[A-Za-z ]+$/;
        if (!name || name.trim() === '') {
            $('#txtName').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtNameError').html('<i class="fa fa-exclamation-circle"></i> Name is required').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtName');
        } else if (name.trim().length < 3) {
            $('#txtName').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtNameError').html('<i class="fa fa-exclamation-circle"></i> Name must be at least 3 characters').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtName');
        } else if (!nameRegex.test(name.trim())) {
            $('#txtName').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtNameError').html('<i class="fa fa-exclamation-circle"></i> Only letters and spaces allowed').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtName');
        } else {
            $('#txtName').removeClass('is-invalid').css('background-color', 'white');
            $('#txtNameError').removeClass('show');
        }

        // 3. Email
        var email = $('#txtEmail').val();
        var atSym = String.fromCharCode(64);
        var emailRegex = new RegExp('^[^\\s' + atSym + ']+' + atSym + '[^\\s' + atSym + ']+\\.[^\\s' + atSym + ']+$');
        if (!email || email.trim() === '') {
            $('#txtEmail').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtEmailError').html('<i class="fa fa-exclamation-circle"></i> Email is required').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtEmail');
        } else if (!emailRegex.test(email.trim())) {
            $('#txtEmail').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtEmailError').html('<i class="fa fa-exclamation-circle"></i> Please enter a valid email address').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtEmail');
        } else {
            $('#txtEmail').removeClass('is-invalid').css('background-color', 'white');
            $('#txtEmailError').removeClass('show');
        }

        // 4. Mobile
        var mobile = $('#txtMobile').val();
        var mobileRegex = /^[6-9]\d{9}$/;
        if (!mobile || mobile.trim() === '') {
            $('#txtMobile').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtMobileError').html('<i class="fa fa-exclamation-circle"></i> Mobile number is required').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtMobile');
        } else if (!mobileRegex.test(mobile.trim())) {
            $('#txtMobile').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtMobileError').html('<i class="fa fa-exclamation-circle"></i> Enter valid 10-digit mobile number starting with 6-9').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtMobile');
        } else {
            $('#txtMobile').removeClass('is-invalid').css('background-color', 'white');
            $('#txtMobileError').removeClass('show');
        }

        // 5. Valid From
        var validFrom = $('#txtValidFrom').val();
        if (!validFrom || validFrom.trim() === '') {
            $('#txtValidFrom').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtValidFromError').html('<i class="fa fa-exclamation-circle"></i> Valid From date is required').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtValidFrom');
        } else {
            $('#txtValidFrom').removeClass('is-invalid').css('background-color', 'white');
            $('#txtValidFromError').removeClass('show');
        }

        // 6. Valid To (Optional)
        var validTo = $('#txtValidTo').val();
        if (validFrom && validTo && new Date(validTo) < new Date(validFrom)) {
            $('#txtValidTo').addClass('is-invalid').css('background-color', '#fef2f2');
            $('#txtValidToError').html('<i class="fa fa-exclamation-circle"></i> Valid To date cannot be earlier than Valid From').addClass('show');
            isValid = false;
            if (!firstInvalid) firstInvalid = $('#txtValidTo');
        } else {
            $('#txtValidTo').removeClass('is-invalid').css('background-color', 'white');
            $('#txtValidToError').removeClass('show');
        }

        if (firstInvalid) {
            firstInvalid.focus();
        }

        return isValid;
    }
</script>

<div class="main-office-container">
    <div class="compact-breadcrumb-bar">
        <span class="crumb-root">Office Administration</span>
        <span class="crumb-sep">&gt;&gt;</span>
        <span class="crumb-current">Update User's Detail</span>
    </div>

    <div class="source-heading">
        <h4>Update User's Detail</h4>
        <button type="button" class="btn-toolbar-add" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();">
            <i class="fa fa-pencil-square-o"></i> Update Department User
        </button>
    </div>

    <div class="table-outer">
        <div class="unified-table-toolbar">
            <div style="font-size: 12px; font-weight: 600; color: #475569; display: flex; align-items: center; gap: 6px;">
                <i class="fa fa-users text-primary"></i>
                <span>Department Users List</span>
            </div>
            <div class="toolbar-search-slot" id="toolbarSearchSlot"></div>
        </div>

        <div class="table-responsive table-cus">
            <table id="fundreport" class="table table-bordered dataTable">
                <thead>
                    <tr class="table-heading">
                        <th style="width: 20%;">User Name</th>
                        <th style="width: 20%;">Name</th>
                        <th style="width: 20%;">Designation</th>
                        <th style="width: 25%;">Email</th>
                        <th style="width: 15%;">Mobile</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mdl in Model._LstUser)
                    {
                        <tr id="row_@mdl.UserId">
                            <td>@mdl.UserName</td>
                            <td>@mdl.Name</td>
                            <td>@mdl.Designation</td>
                            <td>@mdl.Email</td>
                            <td>@mdl.MobileNo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="coman_modal dispatch_modal addnew_modal modal user-detail-modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">

                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title fs-5" id="myModalLabel">Update User Details</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">

                                        @* SUCCESS MESSAGE *@
                                        @if (TempData["Success"] != null)
                                        {
                                            <div class="alert alert-success alert-dismissible fade show">
                                                @TempData["Success"]
                                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                            </div>
                                        }

                                        @if (TempData["Error"] != null)
                                        {
                                            <div class="alert alert-danger alert-dismissible fade show">
                                                @TempData["Error"]
                                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                            </div>
                                        }

                                        @using (Html.BeginForm("UpdateUser", "DepartmentUser", FormMethod.Post, new { id = "updateUserForm", onsubmit = "return validate();" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                            <!-- Section 1: User Account Selection -->
                                            <div class="form-section-card">
                                                <div class="form-section-title"><i class="fa fa-user-circle"></i> User Account Selection</div>
                                                <div class="form-group">
                                                    <label for="ddlUser" class="profile-info-name fotm_lbl">Select User:</label>
                                                    @Html.DropDownListFor(
                                                        m => m.UserId,
                                                        new SelectList(Model.Users, "UserId", "UserName"),
                                                        "-- Select User --",
                                                        new { @class = "form-control", @id = "ddlUser" }
                                                    )
                                                    <span id="ddlUserError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Please select a User</span>
                                                </div>
                                            </div>

                                            <!-- Section 2: Personal & Contact Information -->
                                            <div class="form-section-card">
                                                <div class="form-section-title"><i class="fa fa-id-card"></i> Personal &amp; Contact Information</div>
                                                <div class="form-card-grid">
                                                    <div class="form-group col-full">
                                                        <label for="txtName" class="profile-info-name fotm_lbl">Full Name:</label>
                                                        @Html.TextBoxFor(
                                                            m => m.Name,
                                                            new { @id = "txtName", @class = "form-control", placeholder = "Enter Full Name" }
                                                        )
                                                        <span id="txtNameError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Name is required</span>
                                                    </div>

                                                    <div class="form-group">
                                                        <label for="txtEmail" class="profile-info-name fotm_lbl">Email Address:</label>
                                                        @Html.TextBoxFor(
                                                            m => m.Email,
                                                            new { @class = "form-control", @id = "txtEmail", placeholder = "Enter Email Address" }
                                                        )
                                                        <span id="txtEmailError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Valid email address is required</span>
                                                    </div>

                                                    <div class="form-group">
                                                        <label for="txtMobile" class="profile-info-name fotm_lbl">Mobile Number:</label>
                                                        @Html.TextBoxFor(
                                                            m => m.Mobile,
                                                            new { @class = "form-control", maxlength = "10", @id = "txtMobile", placeholder = "10-digit mobile number" }
                                                        )
                                                        <span id="txtMobileError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Valid mobile number is required</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Section 3: Validity Period -->
                                            <div class="form-section-card">
                                                <div class="form-section-title"><i class="fa fa-calendar"></i> Validity Schedule</div>
                                                <div class="form-card-grid">
                                                    <div class="form-group">
                                                        <label for="txtValidFrom" class="profile-info-name fotm_lbl">Valid From:</label>
                                                        @Html.TextBoxFor(
                                                            m => m.ValidFrom,
                                                            new { @class = "form-control", type = "date", @id = "txtValidFrom" }
                                                        )
                                                        <span id="txtValidFromError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Valid From date is required</span>
                                                    </div>

                                                    <div class="form-group">
                                                        <label for="txtValidTo" class="profile-info-name fotm_lbl">Valid To (Optional):</label>
                                                        @Html.TextBoxFor(
                                                            m => m.ValidTo,
                                                            new { @class = "form-control", type = "date", @id = "txtValidTo" }
                                                        )
                                                        <span id="txtValidToError" class="field-val-msg"><i class="fa fa-exclamation-circle"></i> Valid To date cannot be earlier than Valid From</span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="submit" class="btn btn-primary" id="btnUpdateUser">
                                                    <i class="fa fa-check"></i> Update User
                                                </button>
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <i class="fa fa-times"></i> Close
                                                </button>
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>

