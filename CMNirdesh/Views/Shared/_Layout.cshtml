            margin-left: 68px !important;
            width: auto !important;
        }

        /* CRITICAL: Force reset margin-left on internal content wrappers so there is ZERO double-indentation gap! */
        #main-content,
        .main-content,
        div#body #main-content,
        div#body .main-content,
        div#body > .main-content,
        #main {
            margin-left: 0 !important;
            padding-left: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        /* ==========================================================================
           EXECUTIVE CIVIC FOOTER DESIGN SYSTEM
           ========================================================================== */
        footer.footer_sec,
        footer.footer_sec.p_fixd,
        footer.footer_sec.p_fixd.bg_light_rd,
        .footer_sec.logn_fotr,
        .bg_light_rd {
