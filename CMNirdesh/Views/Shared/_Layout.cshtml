<script>
    $('#frmEditProfile').submit(function (e) {
        e.preventDefault();

        var formData = new FormData(this);

        $.ajax({
            url: '@Url.Action("UpdateProfile", "User")',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function () {
                alert('Profile updated successfully');
                location.reload();
            },
            error: function () {
                alert('Error while saving profile');
            }
        });
    });


      function GetSwitchUser() {
          let accountList = $('#accountList');
          accountList.html(''); // clear
         $.ajax({
                 type: "GET",
                 url: '@Url.Action("GetSwitchUser", "References")',
                 datatype: "Json",
                 data: {},
                 success: function (data) {
                     if (data.length > 0) {
                         $('#sucount').html(data.length);
                         //var offcanvas = bootstrap.Offcanvas.getOrCreateInstance(
                         //    document.getElementById('SwitchUser')
                         //);
                         //offcanvas.show();
                     } else {
                         $('#sucount').hide();
                         $('#Switchbutton').hide();
                         
                     }

                     $.each(data, function (i, user) {

                         let activeClass = user.active == 1
                             ? 'bg-primary bg-opacity-10'
                             : '';

                         let html = `
                                <div class="d-flex align-items-center p-3 mb-3 border rounded account-item ${activeClass} hand"
                                     data-id="${user.UserId}" onclick="SetUser('${user.UserName}')"">

