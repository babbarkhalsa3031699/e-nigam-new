            body.portal-user-logged-in.portal-sidebar-is-expanded footer.portal-footer,
            body.portal-user-logged-in.portal-sidebar-is-expanded .portal-footer,
            body.portal-user-logged-in:not(.portal-sidebar-is-expanded) footer.portal-footer,
            body.portal-user-logged-in:not(.portal-sidebar-is-expanded) .portal-footer,
            footer.footer_sec,
            footer.footer_sec.p_fixd,
            footer.footer_sec.p_fixd.bg_light_rd,
            #portalFooter {
                margin-left: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
                left: 0 !important;
                right: 0 !important;
                position: relative !important;
                bottom: auto !important;
                clear: both !important;
                display: block !important;
            }

