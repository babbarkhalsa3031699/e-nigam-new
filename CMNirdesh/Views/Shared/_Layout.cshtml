        function adjustSidebarLayout() {
            var isMobile = window.innerWidth < 992;
            var header = document.querySelector('.portal-header');
            var sidebar = document.getElementById('mySidebar');
            var bodyDiv = document.getElementById('body');
            var isUserLoggedIn = document.body.classList.contains('portal-user-logged-in');
            var isLoginPage = document.body.classList.contains('portal-login-page') || 
                              window.location.pathname.toLowerCase().indexOf('/account/login') !== -1;
            var isExpanded = document.body.classList.contains('portal-sidebar-is-expanded') ||
                             document.body.classList.contains('menu-open');

            var headerHeight = 0;
            if (header) {
                headerHeight = header.offsetHeight;
            }
            if (!headerHeight || headerHeight < 30) {
                headerHeight = isUserLoggedIn ? (isMobile ? 220 : 115) : 0;
            }

            if (sidebar && isUserLoggedIn) {
                if (isMobile) {
                    sidebar.style.setProperty('top', '0px', 'important');
                    sidebar.style.setProperty('height', '100vh', 'important');
                    sidebar.style.setProperty('left', '0px', 'important');
                    sidebar.style.setProperty('transform', isExpanded ? 'translate3d(0, 0, 0)' : 'translate3d(-100%, 0, 0)', 'important');
                    sidebar.style.setProperty('-webkit-transform', isExpanded ? 'translate3d(0, 0, 0)' : 'translate3d(-100%, 0, 0)', 'important');
                } else {
                    sidebar.style.removeProperty('transform');
                    sidebar.style.removeProperty('-webkit-transform');
                    sidebar.style.removeProperty('left');
                    sidebar.style.removeProperty('z-index');
                    sidebar.style.setProperty('top', headerHeight + 'px', 'important');
                    sidebar.style.setProperty('height', 'calc(100vh - ' + headerHeight + 'px)', 'important');
                }
            }

            if (bodyDiv) {
                if (isUserLoggedIn && !isLoginPage) {
                    var finalMarginTop = isMobile ? Math.max(headerHeight, 140) : Math.max(headerHeight, 115);
                    bodyDiv.style.setProperty('margin-top', finalMarginTop + 'px', 'important');
                } else {
                    bodyDiv.style.setProperty('margin-top', '0px', 'important');
                }

                if (!sidebar || !isUserLoggedIn || isLoginPage || isMobile) {
                    bodyDiv.style.setProperty('margin-left', '0px', 'important');
                } else {
                    bodyDiv.style.setProperty('margin-left', isExpanded ? '260px' : '68px', 'important');
                }

                if (isLoginPage) {
                    bodyDiv.style.setProperty('padding', '0px', 'important');
                }
            }

            var footer = document.getElementById('portalFooter');
            if (footer) {
                if (!sidebar || !isUserLoggedIn || isLoginPage || isMobile) {
                    footer.style.setProperty('margin-left', '0px', 'important');
                    footer.style.setProperty('width', '100%', 'important');
                } else {
                    footer.style.setProperty('margin-left', isExpanded ? '260px' : '68px', 'important');
                    footer.style.setProperty('width', isExpanded ? 'calc(100% - 260px)' : 'calc(100% - 68px)', 'important');
                }
            }
        }
        window.addEventListener('load', adjustSidebarLayout);
        window.addEventListener('DOMContentLoaded', adjustSidebarLayout);
        window.addEventListener('resize', adjustSidebarLayout);
        if (window.ResizeObserver) {
            var ro = new ResizeObserver(function() {
                adjustSidebarLayout();
            });
            window.addEventListener('DOMContentLoaded', function() {
                var h = document.querySelector('.portal-header');
                if (h) ro.observe(h);
            });
        }

        /* Portal Sidebar State Management (Desktop: Collapsed 68px/Expanded 260px; Mobile: Responsive Drawer) */
        function setSidebarState(expand) {
            var sidebar = document.getElementById('mySidebar');
            var toggleIcon = document.getElementById('portalSidebarToggleIcon');
            var toggleBtn = document.getElementById('portalSidebarToggleBtn');
            var bodyDiv = document.getElementById("body");
            var mainContent = document.getElementById("main-content");
            var isUserLoggedIn = document.body.classList.contains('portal-user-logged-in');
            var isMobile = window.innerWidth < 992;

            var footer = document.getElementById('portalFooter');

            if (!sidebar || !isUserLoggedIn) {
                document.body.classList.remove('portal-sidebar-is-expanded', 'portal-sidebar-is-collapsed', 'menu-open');
                if (bodyDiv) bodyDiv.style.setProperty('margin-left', '0px', 'important');
                if (mainContent) mainContent.style.setProperty('margin-left', '0px', 'important');
                if (footer) {
                    footer.style.setProperty('margin-left', '0px', 'important');
                    footer.style.setProperty('width', '100%', 'important');
                }
                return;
            }

            if (expand) {
                document.body.classList.remove('portal-sidebar-is-collapsed');
                document.body.classList.add('portal-sidebar-is-expanded', 'menu-open');
                sidebar.classList.remove('portal-sidebar-collapsed');
                sidebar.classList.add('portal-sidebar-expanded');
                sidebar.style.width = "";

                if (isMobile) {
                    sidebar.style.setProperty('left', '0px', 'important');
                    sidebar.style.setProperty('transform', 'translate3d(0, 0, 0)', 'important');
                    sidebar.style.setProperty('-webkit-transform', 'translate3d(0, 0, 0)', 'important');
                    sidebar.style.setProperty('z-index', '1060', 'important');
                    sidebar.style.setProperty('display', 'block', 'important');
                    sidebar.style.setProperty('visibility', 'visible', 'important');
                    if (footer) {
                        footer.style.setProperty('margin-left', '0px', 'important');
                        footer.style.setProperty('width', '100%', 'important');
                    }
                } else {
                    sidebar.style.removeProperty('transform');
                    sidebar.style.removeProperty('-webkit-transform');
                    sidebar.style.removeProperty('left');
                    sidebar.style.removeProperty('z-index');
                    if (bodyDiv) bodyDiv.style.setProperty('margin-left', '260px', 'important');
                    if (footer) {
                        footer.style.setProperty('margin-left', '260px', 'important');
                        footer.style.setProperty('width', 'calc(100% - 260px)', 'important');
                    }
                }

                if (toggleIcon) toggleIcon.className = isMobile ? 'fas fa-times portal-sidebar-toggle-icon' : 'fas fa-bars portal-sidebar-toggle-icon';
                if (toggleBtn) toggleBtn.setAttribute('title', isMobile ? 'Close Menu' : 'Collapse Panel (Icon Only)');
                if (!isMobile) {
                    try { localStorage.setItem('portal_sidebar_state', 'expanded'); } catch (e) { }
                }
            } else {
                document.body.classList.remove('portal-sidebar-is-expanded', 'menu-open');
                document.body.classList.add('portal-sidebar-is-collapsed');
                sidebar.classList.remove('portal-sidebar-expanded');
                sidebar.classList.add('portal-sidebar-collapsed');
                sidebar.style.width = "";

                if (isMobile) {
                    sidebar.style.setProperty('transform', 'translate3d(-100%, 0, 0)', 'important');
                    sidebar.style.setProperty('-webkit-transform', 'translate3d(-100%, 0, 0)', 'important');
                    if (footer) {
                        footer.style.setProperty('margin-left', '0px', 'important');
                        footer.style.setProperty('width', '100%', 'important');
                    }
                } else {
                    sidebar.style.removeProperty('transform');
                    sidebar.style.removeProperty('-webkit-transform');
                    sidebar.style.removeProperty('left');
                    sidebar.style.removeProperty('z-index');
                    if (bodyDiv) bodyDiv.style.setProperty('margin-left', '68px', 'important');
                    if (footer) {
                        footer.style.setProperty('margin-left', '68px', 'important');
                        footer.style.setProperty('width', 'calc(100% - 68px)', 'important');
                    }
                }

                try {
                    var openSubmenus = document.querySelectorAll('.portal-sidebar-submenu-collapse.show');
                    openSubmenus.forEach(function (submenu) {
                        if (typeof bootstrap !== 'undefined' && bootstrap.Collapse) {
                            var bsCollapse = bootstrap.Collapse.getInstance(submenu) || new bootstrap.Collapse(submenu, { toggle: false });
                            if (bsCollapse && typeof bsCollapse.hide === 'function') {
                                bsCollapse.hide();
                            } else {
                                submenu.classList.remove('show');
                            }
                        } else if (typeof $ !== 'undefined' && $.fn && typeof $.fn.collapse === 'function') {
                            $(submenu).collapse('hide');
                        } else {
                            submenu.classList.remove('show');
                        }
                    });
                } catch (err) { }

                if (toggleIcon) toggleIcon.className = 'fas fa-bars portal-sidebar-toggle-icon';
                if (toggleBtn) toggleBtn.setAttribute('title', isMobile ? 'Open Menu' : 'Expand Panel (Icon with Name)');
                if (!isMobile) {
                    try { localStorage.setItem('portal_sidebar_state', 'collapsed'); } catch (e) { }
                }
            }
            if (!isMobile) {
                adjustSidebarLayout();
            }
        }

        function openNav() {
            setSidebarState(true);
        }

        function closeNav() {
            setSidebarState(false);
        }

        function toggleSidebarNav() {
            var isCollapsed = document.body.classList.contains('portal-sidebar-is-collapsed') ||
                (document.getElementById('mySidebar') && document.getElementById('mySidebar').classList.contains('portal-sidebar-collapsed'));
            setSidebarState(isCollapsed);
        }

        window.setSidebarState = setSidebarState;
        window.openNav = openNav;
        window.closeNav = closeNav;
        window.toggleSidebarNav = toggleSidebarNav;

        // Restore user's preferred sidebar state on page load
        document.addEventListener("DOMContentLoaded", function () {
            var sidebar = document.getElementById('mySidebar');
            var isUserLoggedIn = document.body.classList.contains('portal-user-logged-in');

            if (!sidebar || !isUserLoggedIn) {
                document.body.classList.remove('portal-sidebar-is-expanded', 'portal-sidebar-is-collapsed');
                var bodyDiv = document.getElementById("body");
                if (bodyDiv) {
                    bodyDiv.style.setProperty('margin-left', '0px', 'important');
                }
                adjustSidebarLayout();
                return;
            }

            var isMobile = window.innerWidth < 992;
            var savedState = null;
            try { savedState = localStorage.getItem('portal_sidebar_state'); } catch (e) { }
            // On mobile view: always default to closed
            if (isMobile) {
                setSidebarState(false);
            } else if (savedState === 'expanded') {
                setSidebarState(true);
            } else {
                setSidebarState(false);
            }
            setTimeout(adjustSidebarLayout, 100);
            setTimeout(adjustSidebarLayout, 500);
        });

        // Close mobile drawer on Escape key
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && document.body.classList.contains('portal-sidebar-is-expanded')) {
                closeNav();
            }
        });
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

    </script>

