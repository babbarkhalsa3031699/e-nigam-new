                                                            string.IsNullOrEmpty(CurrentSession.UserPicPath)
                                                            ? Url.Content("~/Assets/Home_Images/user.png")
                                                            : "https://enigambackuprestore.blob.core.windows.net/securefilestructure/" + CurrentSession.UserPicPath
                                                        )" class="rounded-circle profile-pic portal-menu-avatar-img" alt="User Photo">
