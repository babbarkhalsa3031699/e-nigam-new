        /* When logged in on desktop: adjust margin-left and width so it aligns with content and NEVER overlaps with the sidebar */
        body.portal-user-logged-in.portal-sidebar-is-expanded footer.portal-footer,
        body.portal-user-logged-in.portal-sidebar-is-expanded .portal-footer {
            margin-left: 260px !important;
            width: calc(100% - 260px) !important;
