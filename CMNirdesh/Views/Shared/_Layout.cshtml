@{
    bool isUserLoggedIn = !string.IsNullOrEmpty(CurrentSession.UserID);
    string currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    string currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";
    bool isLoginPage = (currentController.Equals("Account", StringComparison.OrdinalIgnoreCase) && 
                        currentAction.Equals("Login", StringComparison.OrdinalIgnoreCase)) ||
                       (Request.Url != null && Request.Url.AbsolutePath.IndexOf("/Account/Login", StringComparison.OrdinalIgnoreCase) >= 0);
}
</head>
<body class="@(isUserLoggedIn ? "portal-user-logged-in" : "portal-user-logged-out") @(isLoginPage ? "portal-login-page" : "")">





