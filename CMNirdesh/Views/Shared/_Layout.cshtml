        body.portal-user-logged-in.portal-sidebar-is-collapsed footer.portal-footer,
        body.portal-user-logged-in.portal-sidebar-is-collapsed .portal-footer,
        body.portal-user-logged-in:not(.portal-sidebar-is-expanded) footer.portal-footer,
        body.portal-user-logged-in:not(.portal-sidebar-is-expanded) .portal-footer {
            margin-left: 68px !important;
            width: calc(100% - 68px) !important;
        }

        /* Mobile & Tablet: Footer is always strictly 100% full width with 0px margin-left, never overlapping content */
        @@media (max-width: 991px) {
            body footer.portal-footer,
            body .portal-footer,
            body.portal-user-logged-in footer.portal-footer,
            body.portal-user-logged-in .portal-footer,
            body.portal-user-logged-in.portal-sidebar-is-collapsed footer.portal-footer,
