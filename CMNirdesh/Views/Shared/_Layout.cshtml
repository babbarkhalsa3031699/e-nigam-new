      function showclock() {
      const pageTitle = '@Html.Raw(ViewBag.Title)';
  // If the page title is "Login," set userId to true
      const userId = (pageTitle === 'Login');
      // If on the "otherpage.html," proceed with the timer functionality
      if (!userId) {
          // Check if the timer state is stored in sessionStorage
          //let remainingSeconds = sessionStorage.getItem('remainingSeconds');
          //// If no state found in sessionStorage, set the initial time to 30 minutes (30:00)
          //if (remainingSeconds === null) {
          //    remainingSeconds = 30 * 60;
          //} else {
          //    // Parse the value to an integer
          //    //remainingSeconds = parseInt(remainingSeconds);
          //    remainingSeconds = 30 * 60;
          //}
           let remainingSeconds = (typeof IDLE_TIMEOUT_MS !== 'undefined') ? Math.floor(IDLE_TIMEOUT_MS / 1000) : 30 * 60;

           window.resetUIClock = function () {
               remainingSeconds = (typeof IDLE_TIMEOUT_MS !== 'undefined') ? Math.floor(IDLE_TIMEOUT_MS / 1000) : 30 * 60;
               updateClock();
           };

           let intervalId;


          // Update the clock every second
     //const intervalId = setInterval(updateClock, 1000);
          function updateClock() {
              // Calculate minutes and seconds
              const minutes = Math.floor(remainingSeconds / 60);
              const seconds = remainingSeconds % 60;
              // Display the time in the format 00:00
              const formattedTime = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
              document.getElementById('clock').innerText = formattedTime;
              document.getElementById('clock1').innerText = formattedTime;
              // Decrease remaining seconds
              remainingSeconds--;
              // Store the updated timer state in sessionStorage
              sessionStorage.setItem('remainingSeconds', remainingSeconds.toString());
               // Stop the clock when it reaches 0 and trigger 30-sec idle warning modal
               if (remainingSeconds < 0) {
                   clearInterval(intervalId);
                   document.getElementById('clock').innerText = '00:00';
                   document.getElementById('clock1').innerText = '00:00';
                   sessionStorage.removeItem('remainingSeconds');
                   if (typeof showIdleWarningModal === 'function') {
                       showIdleWarningModal();
                   } else {
                       window.location.href = '@Url.Action("LogOff", "Account")';
                   }
               }
          }

              function startTimer() {
                  clearInterval(intervalId); // Clear existing interval if any
                  intervalId = setInterval(updateClock, 1000);
              }

              function RefreshSession() {
                   $.ajax({
                      url: '@Url.Action("RefreshSession", "Account")',
                      type: 'POST',
                      success: function() { console.log('Session refreshed'); }
                  });
              }

                startTimer();

              function resetTimer() {
                  remainingSeconds = 30 * 60;
                  sessionStorage.setItem('remainingSeconds', remainingSeconds);
                  updateClock();
                  startTimer();
                  RefreshSession();
              }
              const refreshBtn = document.getElementById('refreshTimerBtn');

              refreshBtn.addEventListener('click', () => {
                  remainingSeconds = 30 * 60; // Reset to 30 minutes
                  sessionStorage.setItem('remainingSeconds', remainingSeconds.toString());
                  updateClock(); // Update immediately on refresh
                  startTimer();   // Restart interval
                  RefreshSession();
              });

               const refreshBtn2 = document.getElementById('PopRefresh');
               //console.log(refreshBtn2);
                refreshBtn2.addEventListener('click', () => {
                   remainingSeconds = 30 * 60; // Reset to 30 minutes
                   sessionStorage.setItem('remainingSeconds', remainingSeconds.toString());
                   updateClock(); // Update immediately on refresh
                   startTimer();   // Restart interval
                   RefreshSession();
               });

      }
      else {
          // If not on the "otherpage.html," hide the clock
          document.getElementById('clock').style.display = 'none';
          document.getElementById('clock1').style.display = 'none';
          document.getElementById('clockllabel').style.display = 'none';
          sessionStorage.removeItem('remainingSeconds');
      }



  }

