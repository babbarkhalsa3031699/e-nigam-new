                                            <i class="far fa-envelope header-action-icon"></i>
                                            <span id="Observationcount" class="notification-count header-action-badge header-advice-badge"></span>
                                        </a>

                                        <a title="Notifications, Circulars & Approvals" class="header-action-icon-btn header-alert-btn position-relative" data-bs-toggle="offcanvas" href="#offcanvasExample" role="button" aria-controls="offcanvasExample">
                                            <i class="far fa-bell header-action-icon"></i>
                                            <span id="alertcount" class="notification-count header-action-badge header-alert-badge"></span>
