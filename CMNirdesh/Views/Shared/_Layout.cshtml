        /* When user is NOT logged in and not on login page: NO margin-top */
        body.portal-user-logged-out div#body,
        body.portal-login-page div#body,
        body:not(.portal-user-logged-in) div#body {
            margin-top: 0 !important;
            margin-left: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        body.portal-user-logged-out #mySidebar,
        body.portal-user-logged-out .portal-sidebar,
        body:not(.portal-user-logged-in) #mySidebar,
        body:not(.portal-user-logged-in) .portal-sidebar {
            display: none !important;
        }

        /* ONLY when user is logged in AND sidebar exists: adjust margin-left */
        body.portal-user-logged-in.portal-sidebar-is-expanded div#body {
            margin-left: 260px !important;
            width: auto !important;
        }

        body.portal-user-logged-in.portal-sidebar-is-collapsed div#body {
            margin-left: 68px !important;
            width: auto !important;
        }

