            background-color: #f8fafc !important;
            padding: 0 !important;
        }

        /* ==========================================================================
           FULL-BLEED LOGIN PAGE (ZERO HEADER GAP, ZERO SIDE GAPS, 100% FULL SCREEN)
           ========================================================================== */
        body.portal-login-page {
            overflow-x: hidden !important;
            background-color: #f1f5f9 !important;
        }

        body.portal-login-page .data-section,
        body.portal-login-page section.data-section,
