<!-- Session Idle Warning Modal -->
<div id="sessionIdleWarning" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; z-index:999999; background:rgba(0,0,0,0.65); backdrop-filter:blur(3px); align-items:center; justify-content:center;">
    <div style="background:#ffffff; width:420px; max-width:90%; padding:25px; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,0.4); text-align:center; font-family:inherit;">
        <div style="width:55px; height:55px; border-radius:50%; background:#fff3cd; color:#856404; display:inline-flex; align-items:center; justify-content:center; margin:0 auto 15px auto;">
            <i class="fa fa-exclamation-triangle" style="font-size:26px;"></i>
        </div>
        <h4 style="margin:0 0 10px 0; color:#222; font-weight:700;">Session Expiration Warning</h4>
        <p style="color:#555; font-size:14px; margin-bottom:20px; line-height:1.5;">
            You have been inactive. Your session will expire in <strong id="idleCountdownText" style="color:#d9534f; font-size:16px;">30</strong> seconds.
            <br />Click <strong>Stay Logged In</strong> to refresh your session.
        </p>
        <div style="display:flex; gap:12px; justify-content:center;">
            <button type="button" id="btnRefreshSession" style="background:#0d6efd; color:#fff; border:none; padding:10px 22px; border-radius:6px; font-weight:600; font-size:14px; cursor:pointer; box-shadow:0 2px 6px rgba(13,110,253,0.3);">
                <i class="fa fa-refresh" style="margin-right:6px;"></i> Stay Logged In
            </button>
            <button type="button" id="btnLogoutSession" style="background:#6c757d; color:#fff; border:none; padding:10px 18px; border-radius:6px; font-weight:600; font-size:14px; cursor:pointer;">
                Logout
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        var isLoggedIn = '@(Session["LoggedIn"] != null && Session["LoggedIn"].ToString() == "yes" ? "true" : "false")';
        if (isLoggedIn !== 'true') return;

        var IDLE_TIMEOUT_MS = 30 * 60 * 1000; // 30 minutes idle limit (PRODUCTION MODE)
        var KEEP_ALIVE_INTERVAL_MS = 5 * 60 * 1000; // 5 minutes auto-renew interval for active users
        var WARNING_COUNTDOWN_SEC = 30; // 30 seconds warning modal countdown

        var lastActivityTime = Date.now();
        var lastKeepAliveTime = Date.now();
        var isModalShowing = false;
        var countdownTimerId = null;

        // Record activity timestamp without spamming clock resets on every mouse pixel movement
        function resetActivity() {
            if (isModalShowing) return;
            lastActivityTime = Date.now();
        }

        var activityEvents = ['mousemove', 'mousedown', 'keypress', 'scroll', 'touchstart', 'click'];
        for (var i = 0; i < activityEvents.length; i++) {
            window.addEventListener(activityEvents[i], resetActivity, { passive: true });
        }

        // Show warning modal with countdown
        function showIdleWarningModal() {
            isModalShowing = true;
            var remainingSec = WARNING_COUNTDOWN_SEC;
            var countdownText = document.getElementById("idleCountdownText");
            var warningModal = document.getElementById("sessionIdleWarning");

            if (countdownText) countdownText.innerText = remainingSec;
            if (warningModal) warningModal.style.display = "flex";

            countdownTimerId = setInterval(function () {
                remainingSec--;
                if (countdownText) countdownText.innerText = remainingSec;

                if (remainingSec <= 0) {
                    clearInterval(countdownTimerId);
                    window.location.href = '@Url.Action("LogOff", "Account")';
                }
            }, 1000);
        }
        window.showIdleWarningModal = showIdleWarningModal;

        // Renew session when user clicks "Stay Logged In" or active auto-renew
        function renewSession(userAction) {
            if (countdownTimerId) clearInterval(countdownTimerId);
            isModalShowing = false;

            var warningModal = document.getElementById("sessionIdleWarning");
            if (warningModal) warningModal.style.display = "none";

            if (userAction) {
                lastActivityTime = Date.now();
            }
            lastKeepAliveTime = Date.now();

            if (typeof window.resetUIClock === 'function') {
                window.resetUIClock();
            }

            $.ajax({
                url: '@Url.Action("RefreshSession", "Account")',
                type: 'POST',
                cache: false,
                success: function (res) {
                    console.log("[SESSION REFRESHED]", res);
                }
            });
        }

        // Attach click handlers to modal buttons
        document.addEventListener("DOMContentLoaded", function () {
            var btnRefresh = document.getElementById("btnRefreshSession");
            var btnLogout = document.getElementById("btnLogoutSession");

            if (btnRefresh) {
                btnRefresh.addEventListener("click", function () {
                    renewSession(true);
                });
            }
            if (btnLogout) {
                btnLogout.addEventListener("click", function () {
                    window.location.href = '@Url.Action("LogOff", "Account")';
                });
            }
        });

        // Background Monitor loop (runs every 1 second)
        setInterval(function () {
            if (isModalShowing) return;

            var now = Date.now();
            var idleTime = now - lastActivityTime;

            if (idleTime >= IDLE_TIMEOUT_MS) {
                showIdleWarningModal();
                return;
            }

            // Auto-renew session ONLY if user is actively working (not idle)
            if (idleTime < KEEP_ALIVE_INTERVAL_MS) {
                if (now - lastKeepAliveTime >= KEEP_ALIVE_INTERVAL_MS) {
                    renewSession(false);
                }
            }
        }, 1000);
    })();
</script>

