<script>
     function GetDepartmentNav() {
        var depttNav = $("#depttNav");
        var id = $("#depttNav").val();
         //alert(depttNav);

        $.ajax({
            type: "GET",
            url: '@Url.Action("GetDepartmentsNav", "References")',
            datatype: "Json",
            data: {},
            success: function (data) {
                //depttNav.empty().append('<option value=""> -- select --</option>');
                $.each(data, function () {
                    depttNav.append($("<option></option>").val(this['id']).html(this['name']));
                });
                $("#depttNav").val('@CurrentSession.DeptID');//OfficeName
                Getofficenav('@CurrentSession.DeptID','@CurrentSession.MapId');

            }
        });
    }

    $("#depttNav").change(function () {

        var depid = $("#depttNav").val();
        Getofficenav(depid, '');
    });

    function Getofficenav(deptttid, officeid) {

         $('#offIdNav').empty();
        $('#offId').empty();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetOfficebyDepartmentIdNav", "References")',
            datatype: "Json",
            data: { deptid: deptttid },
            success: function (data) {

                if (data.length == 1) {
                   // $('#offIdNav').append('<option value="0" selected >All</option>');
                }
                $('#offIdNav').append('<option value="0" selected >-Select-</option>');
                if (data.length >= 1) {

                    $('#officecount').append(data.length);
                }else{
                    $('#officecount').hide();
                }



                $.each(data, function (index, value) {
                    var selected = '';
                    if (value.id == officeid) {
                        selected = 'selected';

                    } else {
                        selected = '';
                    }
                    $('#offIdNav').append('<option value="' + value.id + '" ' + selected +'>' + value.name + '</option>');

                });
                $('#offIdNav').multipleSelect('refresh');
            }

        });


    }



    $("#offIdNav").change(function () {

        var depid = $("#depttNav").val();
        var officeid = $("#offIdNav").val();
          $.ajax({
            type: "GET",
            url: '@Url.Action("SetOffice", "References")',
            datatype: "Json",
              data: { deptid:depid,officeid: officeid },
            success: function (data) {
                setTimeout(window.location.reload(), 2000);
            }

          });
        //alert("Office Changed Successfully");


    })
