@model CMNirdesh.Models.MCHouse.GetZones
@using CMNirdesh;

@{
    ViewBag.Title = "Index";

}


<div id="main-content">
    <div class="main-content">
        <section class="form_dsign">
            <div class="container-fluid p-0">
                <div class="inr_frm_dsgn">

                    <div class="widget-box " id="divAction">
                        <div class="widget-header widget-header-flat rounded-top rounded-0">
                            <h4 class=""> Zone List </h4>
                            <div class="widget-toolbar no-border">
                                <button type="button" class="btn btn-xs btn-primary bigger" data-bs-toggle="modal" data-bs-target="#myModal" onclick="clearTextBox();"><i class="ace-icon fa fa-pencil-square-o bigger-150"></i>Add New Zone</button>
                            </div>
                        </div>
                    </div>


                    <div class="form_lyot">
                        @if (Model != null)
                        {
                            if (Model._ListZonesModel.Count() > 0)
                            {
                                <div class="table-responsive ">
                                    <table id="example" class="table table-hover table-bordered">
                                        <thead>
                                            <tr class="center">
                                                <th class="center">Zone Name</th>
                                                <th class="center">Zone Name(Punjabi)</th>
                                                <th class="center">District Name</th>
                                                <th class="center">Zone Region</th>
                                                <th class="center">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody role="alert" aria-live="polite" aria-relevant="all">
                                            @foreach (var items in Model._ListZonesModel)
                                            {
                                                <tr>
                                                    <td class="center">@Html.DisplayFor(modelItem => items.WardName)</td>
                                                    <td class="center">@Html.DisplayFor(modelItem => items.WardName_local)</td>
                                                    <td class="center">@Html.DisplayFor(modelItem => items.DistrictName)</td>
                                                    <td class="center">@Html.DisplayFor(modelItem => items.ZoneName)</td>
                                                    <td class="center td-data" style="padding: 14px 4px !important">
                                                        <div class="edit-1">


                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <a data-rel="tooltip" class="tooltip-primary" data-bs-toggle="modal" data-bs-target="#myModal" onclick="getbyID('@items.id')">
                                                                    <i class="ace-icon fa fa-pencil bigger-130"></i>
                                                                </a>
                                                                @*<a data-rel="tooltip" id="DeleteCheck" class="red tooltip-error" onclick="DeleteOfficeRecord('@items.OfficeId')" value="@items.OfficeId">
                                                                    <i class="ace-icon fa fa-trash-o bigger-130"></i>
                                                                    <input type="hidden" id="DeleteConfirmFinal" value='@items.OfficeId' class="DeleteConfirm" />
                                                                </a>*@
                                                            </div>

                                                            <div class="hidden-sm hidden-xs action-buttons">
                                                                <input type="hidden" id="DeleteConfirmFinal" onclick="DeleteID('@items.id')" value="@items.id" />
                                                                <label class="toggle mb-0">
                                                                    <input type="checkbox" onclick="DeleteOfficeRecord('@items.id')" @(Convert.ToBoolean(items.Active) == true ? "checked='checked'" : string.Empty)>
                                                                    <span class="slider"></span>
                                                                    <span class="labels" data-on="Active" data-off="DeActive"></span>
                                                                </label>
                                                            </div>

                                                        </div>

                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-xs-12">
                                        <div class="alert alert-info">
                                            <strong>There are no record found</strong><br />
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>
        </section>
    </div>
    <div class="coman_modal dispatch_modal modal" id="myModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fs-5" id="myModalLabel">Add Zone Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="row">
                        <div class="col-md-6 col-sm-12 col-12 form-group" id="ZonesDropdown">
                            <div class="profile-info-name fotm_lbl">Zone Region:</div>
                            <select id="ch_user1">
                                <option value="select" class="form-control txt_design" id="SelectId"></option>
                            </select>
                        </div>
                        <div class="col-md-6 col-sm-12 col-12 form-group" id="DistrictDropdown">
                            <div class="profile-info-name fotm_lbl">District Name:</div>
                            <select id="ch_user2">
                                <option value="select" class="form-control txt_design" id="SelectId"></option>
                            </select>
                        </div>
                        <div class="col-md-6 col-sm-12 col-12 form-group" id="SubMenuIdLabel">
                            <div class="profile-info-name fotm_lbl">Zone Name:</div>
                            <input type="text" class="form-control txt_design" id="zonename" placeholder="Zone Name" />
                        </div>
                        <div class="col-md-6 col-sm-12 col-12 form-group" id="SubMenuIdLabel">
                            <div class="profile-info-name fotm_lbl">Zone Name(Punjabi):</div>
                            <input type="text" class="form-control txt_design" id="zonenamepunjabi" placeholder="Zone Name(Punjabi)" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="btnSave" onclick="Add();">Save</button>
                    <button type="button" class="btn btn-primary" id="btnUpdate" onclick="Update();">Update</button>
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    

</div>

<br />

<a href="#" id="btn-scroll-up" class="btn-scroll-up btn btn-sm btn-inverse">
    <i class="ace-icon fa fa-angle-double-up icon-only bigger-110"></i>
</a>

