<style>

    .inr_frm_dsgn {
        /*margin-top: 20px;*/
        box-shadow: 0px 0px 4px 1px #ccc;
        border-top-left-radius: 5px;
        border-top-right-radius: 5px;
    }

    .form_lyot {
        padding: 10px;
    }



    .addnew_modal {
        padding-right: 300px !important;
        padding-left: 300px;
        padding-top: 94px;
        padding-bottom: 94px;
    }

    .toggle {
        --width: 80px;
        --height: calc(var(--width) / 3);
        position: relative;
        display: inline-block;
        width: var(--width);
        height: var(--height);
        border-radius: var(--height);
        cursor: pointer;
    }

        .toggle input {
            display: none;
        }

        .toggle .slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: var(--height);
            border: 2px solid #969696;
            box-shadow: 2px 2px 5px rgba(0, 0, 0, 0.3);
            transition: all 0.4s ease-in-out;
        }

            .toggle .slider::before {
                content: "";
                position: absolute;
                top: 3.5px;
                left: 2px;
                width: calc(var(--height)*0.6);
                height: calc(var(--height)*0.6);
                border-radius: calc(var(--height) / 2);
                border: 3px solid #969696;
                background-color: #dbdbdb;
                box-shadow: 0px 1px 3px rgba(0, 0, 0, 0.3);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked + .slider {
            border-color: #2196F3;
        }

            .toggle input:checked + .slider::before {
                border-color: #2196F3;
                background-color: #c6e5ff;
                transform: translateX(calc(var(--width) - var(--height)));
            }

        .toggle .labels {
            position: absolute;
            top: 4.5px;
            left: 0;
            width: 100%;
            height: 100%;
            color: #4d4d4d;
            font-size: 12px;
            font-family: sans-serif;
            transition: all 0.4s ease-in-out;
        }

            .toggle .labels::after {
                content: attr(data-off);
                position: absolute;
                right: 5px;
                opacity: 1;
                text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.4);
                transition: all 0.4s ease-in-out;
            }

            .toggle .labels::before {
                content: attr(data-on);
                position: absolute;
                left: 5px;
                opacity: 0;
                text-shadow: 1px 1px 2px rgba(255, 255, 255, 0.4);
                transition: all 0.4s ease-in-out;
            }

        .toggle input:checked ~ .labels::after {
            opacity: 0;
        }

        .toggle input:checked ~ .labels::before {
            opacity: 1;
        }

    .pencil-class {
        font-size: 15px;
    }

    .edit-1 {
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
    }
</style>

<script>
    $(document).ready(function () {
        var s = $("#ch_user2");
        s.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
        $.ajax({
            type: "POST",
            url: '@Url.Action("DistrictDropDown", "GetZones")',
           // url: "/GetZones/DistrictDropDown",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                s.empty().append('<option selected="selected" value="0">Please select</option>');
                $.each(response, function () {
                    s.append($("<option></option>").val(this['Value']).html(this['Text']));
                });
            },
            failure: function (response) {
                alert(response.responseText);
            },
            error: function (response) {
                alert(response.responseText);
            }
        });
        var d = $("#ch_user1");
        d.empty().append('<option selected="selected" value="0" disabled = "disabled">Loading.....</option>');
        $.ajax({
            type: "POST",
             url: '@Url.Action("ZoneDropDown", "GetZones")',
            //url: "/GetZones/ZoneDropDown",
            data: '{}',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                d.empty().append('<option selected="selected" value="0">Please select</option>');
                $.each(response, function () {
                    d.append($("<option></option>").val(this['Value']).html(this['Text']));
                });
            },
            failure: function (response) {
                alert(response.responseText);
            },
            error: function (response) {
                alert(response.responseText);
            }
        });

    });
    $('#example').DataTable({
    });

    var id = '';
    function getbyID(EmpID) {
        clearTextBox();
        id = EmpID;
          var url = '@Url.Action("Edit", "GetZones")' + "?id=" + EmpID;
      //  var url = "/GetZones/Edit?id=" + EmpID;
        $("#myModalLabel").html("Update Zone Items");
        $("#btnUpdate").show();
        $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (data) {
                var obj = JSON.parse(data);
                var data = obj._ListZonesModel[0];
                $('#myModal').modal();
                $("#zonename").val(data.WardName);
                $("#ch_user2").val(data.DistrictCode);
                $("#ch_user1").val(data.Zones);
                $("#zonenamepunjabi").val(data.WardName_local);
                $("#btnSave").hide();
            }
        });
    }

    //Function for clearing the textboxes

    //Valdidation using jquery
    function validate() {
        var isValid = true;
        $('#OfficeIdLabel').hide();
        if ($('#ch_user1').val().trim() === "0") {
            $('#ch_user1').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#ch_user1').css('background-color', 'white');
        }
        if ($('#ch_user2').val().trim() === "0") {
            $('#ch_user2').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#ch_user2').css('background-color', 'white');
        }

        if ($('#zonename').val().trim() === "") {
            $('#zonename').css('background-color', '#ff56564d');
            isValid = false;
        }
        else {
            $('#zonename').css('background-color', 'white');
        }
        return isValid;
    }
    function clearTextBox() {
        $('#ch_user1').val("0");
        $('#ch_user2').val("0");
        $('#zonename').val("");
        $('#zonenamepunjabi').val("");
        $('#btnUpdate').hide();
        $("#myModalLabel").html("Add Zone Items");
        $('#btnSave').show();
        $('#ch_user1').css('background-color', 'white');
        $('#ch_user2').css('background-color', 'white');
        $('#zonename').css('background-color', 'white');
        $('#zonenamepunjabi').css('background-color', 'white');
    }
    function Add() {
        var res = validate();
        if (res == false) {
            return false;
        }
        var empObj = {
            Zones: $('#ch_user1').val(),
            DistrictCode: $('#ch_user2').val(),
            WardName: $('#zonename').val(),
            WardName_local: $('#zonenamepunjabi').val()
        };
        $.ajax({
              url: '@Url.Action("Create", "GetZones")',
            //url: "/GetZones/Create",
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                alert("Updated Successfully");
                $('#myModal').modal('hide');
                location.reload();
            },
            error: function (errormessage) {
                alert("Not Updated");
                $('#myModal').modal('hide');
                location.reload();
            }
        });
    }
    function Update() {
        var res = validate();
        if (res == false) {
            return false;
        }
        $("#SubMenuId").removeAttr("disabled", "disabled");
        var empObj = {
            Id: id,
            Zones: $('#ch_user1').val(),
            DistrictCode: $('#ch_user2').val(),
            WardName: $('#zonename').val(),
            WardName_local: $('#zonenamepunjabi').val()
        };
        $.ajax({
           // url: "/GetZones/Update",
             url: '@Url.Action("Update", "GetZones")',
            data: JSON.stringify(empObj),
            type: "POST",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                alert("Updated Successfully");
                $('#myModal').modal('hide');
                location.reload();
            },
            error: function (errormessage) {
                alert("Not Updated");
                $('#myModal').modal('hide');
                location.reload();
            }
        });
    }
    var MyApp = {};
    function DeleteOfficeRecord(xyz) {


        MyApp = xyz;
        DeleteID();
    }

    function DeleteID(){
        debugger
        var i = MyApp;
        $.ajax({
            type: "Post",
            url: '@Url.Action("Delete", "GetZones")' + "?id=" + i,
            success: function (result) {
                $("#DeleteConfirmation").modal("hide");
                alert("Updated Successfully");

            }
        });
    }
</script>

