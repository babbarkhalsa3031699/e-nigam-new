<script>


    $(document).ready(function () {
        
        var headers = $('#accordion .accordion-header');
        var contentAreas = $('#accordion .ui-accordion-content ').hide();


        //// add the accordion functionality
        headers.click(function () {
            var panel = $(this).next();
            var isOpen = panel.is(':visible');

            // open or close as necessary
            panel[isOpen ? 'slideUp' : 'slideDown']()
                // trigger the correct custom event
                .trigger(isOpen ? 'hide' : 'show');

            // stop the link from causing a pagescroll
            return false;
        });

        // hook up the expand/collapse all
        //expandLink.click(function () {
        //    $(".ui-accordion-content").show();
        //});

        //$("#EmployeeDiv").hide();
        var type = '@Model.Type';
        var dt=$('#example').DataTable({
            rowReorder: true,
            paging: true,
            searching: true,
            pageLength: 100,
            "bLengthChange": false,
           //columnDefs: [{ visible: false, targets: [4,5] }]
        });
        if (type == "1") {
            dt.columns([2, 4, 5]).visible(false);
            $('#lbloff').html("Development Works");
        } else if (type == "2") {
            dt.columns([2, 3, 5]).visible(false);
            $('#lbloff').html("Beneficiaries");
        } else if (type == "3") {
            dt.columns([3, 4]).visible(false);
            $('#lbloff').html("Offices");
        }
        $('#Employee').DataTable({
            rowReorder: true,
            paging: true,
            searching: true,
            pageLength: 100,
            "bLengthChange": false,
        });

        var empopen = '@Model.EmpOpen';
        if (empopen == 'True') {
            $("#OfficeDiv").hide();
            $("#EmployeeDiv").show();
        } else {
            $("#EmployeeDiv").hide();
            $("#EmpCard").hide();
        }
    });





    function flaged(officeid,cid) {
        if ($("#heart_" + officeid).hasClass("liked")) {
            $("#heart_" + officeid).html('<i class="far fa-flag dot" aria-hidden="true"  onclick="flaged('+officeid+','+cid+')"></i>');
            $("#heart_" + officeid).removeClass("liked");
            var isSup = "0";
        } else {
            $("#heart_" + officeid).html('<i class="fa fa-flag dot" aria-hidden="true"  onclick="flaged('+officeid+','+cid+')"></i>');
            $("#heart_" + officeid).addClass("liked");
            var isSup = "1";
        }

        var ConstituencyId = '@Model.ConstituencyId';

        $.ajax({
            type: "GET",
            url: '@Url.Action("UpdateFlag", "API")',
            datatype: "Json",
            data: { ConstituencyId: ConstituencyId, OfficeId: officeid, IsFlag: isSup },
            success: function (data) {
               //alert("Office Flagged");
            }
        });
    }



    function GetEmp(dept, office) {

        if (dept != "" && office != "") {
            $("#hdnClicked").val(1);
            $("#hdnDept").val(dept);
            $("#hdnOffice").val(office);
            $('#btngetuser').click();

        }




        //$("#OfficeDiv").hide();
        //$("#lblEmpDept").html("Department : " + dept);
        //$("#lblEmpOff").html("Office : " + office);
        //$("#EmployeeDiv").show();

    }


    function openmap(long, lat) {
        window.open('http://maps.google.com/?q=' + lat+','+long, '_blank');
    }
    function Goback() {
        $("#OfficeDiv").show();
        $("#EmpCard").hide();
        $("#EmployeeDiv").hide();
        $("#hdnClicked").val(0);
    }

